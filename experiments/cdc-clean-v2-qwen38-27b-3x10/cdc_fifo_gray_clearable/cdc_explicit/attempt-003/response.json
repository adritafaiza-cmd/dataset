  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n    localparam GRAY_W = LOG_DEPTH + 1;\n\n    // Source domain signals\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [GRAY_W-1:0] src_wr_gray;\n    reg [GRAY_W-1:0] dst_rd_gray_src_sync [0:SYNC_STAGES-1];\n    reg [GRAY_W-1:0] dst_rd_gray_src;\n    reg src_clear_pending;\n    reg src_clear_active;\n\n    // Destination domain signals\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [GRAY_W-1:0] dst_rd_gray;\n    reg [GRAY_W-1:0] src_wr_gray_dst_sync [0:SYNC_STAGES-1];\n    reg [GRAY_W-1:0] src_wr_gray_dst;\n    reg dst_clear_pending;\n    reg dst_clear_active;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Helper functions\n    function [GRAY_W-1:0] bin2gray;\n        input [PTR_W-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_W-1:0] gray2bin;\n        input [GRAY_W-1:0] gray;\n        reg [PTR_W-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_W-1] = gray[PTR_W-1];\n            for (i = PTR_W-2; i >= 0; i = i - 1)\n                bin[i] = bin[i+1] ^ gray[i];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source domain logic\n    wire [PTR_W-1:0] dst_rd_ptr_src = gray2bin(dst_rd_gray_src);\n    wire [PTR_W-1:0] src_wr_ptr_next = src_wr_ptr + 1'b1;\n    wire [GRAY_W-1:0] src_wr_gray_next = bin2gray(src_wr_ptr_next);\n\n    wire src_full = (src_wr_ptr[PTR_W-1] == dst_rd_ptr_src[PTR_W-1]) &&\n                    (src_wr_ptr[PTR_W-2:0] == dst_rd_ptr_src[PTR_W-2:0] + 1'b1);\n\n    wire src_can_write = src_valid_i && !src_full && !src_clear_active;\n\n    // Source clear logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear_pending <= 1'b0;\n            src_clear_active <= 1'b0;\n        end else begin\n            if (src_clear_i) begin\n                src_clear_pending <= 1'b1;\n                src_clear_active <= 1'b1;\n            end else if (src_clear_pending) begin\n                // Wait until dst side has also cleared and pointers are aligned\n                // For simplicity, we clear immediately and wait for dst to catch up\n                src_clear_active <= 1'b0;\n                src_clear_pending <= 1'b0;\n            end\n        end\n    end\n\n    // Source write pointer\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_wr_gray <= {GRAY_W{1'b0}};\n        end else if (src_clear_active) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_wr_gray <= {GRAY_W{1'b0}};\n        end else if (src_can_write) begin\n            src_wr_ptr <= src_wr_ptr_next;\n            src_wr_gray <= src_wr_gray_next;\n        end\n    end\n\n    // Source memory write\n    always @(posedge src_clk_i) begin\n        if (src_can_write) begin\n            mem[src_wr_ptr[PTR_W-2:0]] <= src_data_i;\n        end\n    end\n\n    // Source ready\n    assign src_ready_o = !src_full && !src_clear_active;\n    assign src_clear_pending_o = src_clear_pending;\n\n    // Synchronize dst_rd_gray to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_gray_src_sync[0] <= {GRAY_W{1'b0}};\n            dst_rd_gray_src_sync[1] <= {GRAY_W{1'b0}};\n            dst_rd_gray_src_sync[2] <= {GRAY_W{1'b0}};\n        end else begin\n            dst_rd_gray_src_sync[0] <= dst_rd_gray;\n            dst_rd_gray_src_sync[1] <= dst_rd_gray_src_sync[0];\n            dst_rd_gray_src_sync[2] <= dst_rd_gray_src_sync[1];\n        end\n    end\n    assign dst_rd_gray_src = dst_rd_gray_src_sync[SYNC_STAGES-1];\n\n    // Destination domain logic\n    wire [PTR_W-1:0] src_wr_ptr_dst = gray2bin(src_wr_gray_dst);\n    wire [PTR_W-1:0] dst_rd_ptr_next = dst_rd_ptr + 1'b1;\n    wire [GRAY_W-1:0] dst_rd_gray_next = bin2gray(dst_rd_ptr_next);\n\n    wire dst_empty = (dst_rd_ptr == src_wr_ptr_dst);\n\n    wire dst_can_read = dst_valid_reg && dst_ready_i && !dst_clear_active;\n\n    // Destination clear logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear_pending <= 1'b0;\n            dst_clear_active <= 1'b0;\n        end else begin\n            if (dst_clear_i) begin\n                dst_clear_pending <= 1'b1;\n                dst_clear_active <= 1'b1;\n            end else if (dst_clear_pending) begin\n                dst_clear_active <= 1'b0;\n                dst_clear_pending <= 1'b0;\n            end\n        end\n    end\n\n    // Destination read pointer\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_rd_gray <= {GRAY_W{1'b0}};\n        end else if (dst_clear_active) begin\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_rd_gray <= {GRAY_W{1'b0}};\n        end else if (dst_can_read) begin\n            dst_rd_ptr <= dst_rd_ptr_next;\n            dst_rd_gray <= dst_rd_gray_next;\n        end\n    end\n\n    // Destination data and valid\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else if (dst_clear_active) begin\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_can_read) begin\n                // After reading, check if there's more data\n                if (!dst_empty) begin\n                    dst_data_reg <= mem[dst_rd_ptr[PTR_W-2:0]];\n                    dst_valid_reg <= 1'b1;\n                end else begin\n                    dst_valid_reg <= 1'b0;\n                end\n            end else if (!dst_valid_reg && !dst_empty) begin\n                // Load new data when not valid and not empty\n                dst_data_reg <= mem[dst_rd_ptr[PTR_W-2:0]];\n                dst_valid_reg <= 1'b1;\n            end\n        end\n    end\n\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n    assign dst_clear_pending_o = dst_clear_pending;\n\n    // Synchronize src_wr_gray to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_gray_dst_sync[0] <= {GRAY_W{1'b0}};\n            src_wr_gray_dst_sync[1] <= {GRAY_W{1'b0}};\n            src_wr_gray_dst_sync[2] <= {GRAY_W{1'b0}};\n        end else begin\n            src_wr_gray_dst_sync[0] <= src_wr_gray;\n            src_wr_gray_dst_sync[1] <= src_wr_gray_dst_sync[0];\n            src_wr_gray_dst_sync[2] <= src_wr_gray_dst_sync[1];\n        end\n    end\n    assign src_wr_gray_dst = src_wr_gray_dst_sync[SYNC_STAGES-1];\n\nendmodule\n```<|im_end|>",
