  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n    localparam GRAY_W = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [GRAY_W-1:0] src_wr_ptr_gray;\n    reg [GRAY_W-1:0] src_rd_ptr_gray_synced;\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg src_clear_pending;\n    reg src_clear_active;\n\n    // Destination domain\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [GRAY_W-1:0] dst_rd_ptr_gray;\n    reg [GRAY_W-1:0] dst_wr_ptr_gray_synced;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n    reg dst_clear_pending;\n    reg dst_clear_active;\n\n    // Synchronizer registers for source read pointer gray\n    reg [GRAY_W-1:0] src_rd_ptr_gray_sync [0:SYNC_STAGES-1];\n\n    // Synchronizer registers for destination write pointer gray\n    reg [GRAY_W-1:0] dst_wr_ptr_gray_sync [0:SYNC_STAGES-1];\n\n    // Clear synchronizers: src_clear to dst, dst_clear to src\n    reg [SYNC_STAGES-1:0] src_clear_sync;\n    reg [SYNC_STAGES-1:0] dst_clear_sync;\n\n    // Convert binary to gray\n    function [GRAY_W-1:0] bin2gray;\n        input [PTR_W-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Convert gray to binary\n    function [PTR_W-1:0] gray2bin;\n        input [GRAY_W-1:0] gray;\n        integer i;\n        begin\n            gray2bin[GRAY_W-1] = gray[GRAY_W-1];\n            for (i = GRAY_W-2; i >= 0; i = i - 1)\n                gray2bin[i] = gray2bin[i+1] ^ gray[i];\n        end\n    endfunction\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_wr_ptr_gray <= {GRAY_W{1'b0}};\n            src_clear_pending <= 1'b0;\n            src_clear_active <= 1'b0;\n        end else begin\n            if (src_clear_i) begin\n                src_clear_active <= 1'b1;\n                src_clear_pending <= 1'b1;\n            end\n\n            if (src_clear_active) begin\n                // Wait for dst to acknowledge clear\n                if (dst_clear_sync[SYNC_STAGES-1]) begin\n                    src_clear_active <= 1'b0;\n                    src_clear_pending <= 1'b0;\n                    src_wr_ptr <= {PTR_W{1'b0}};\n                    src_wr_ptr_gray <= {GRAY_W{1'b0}};\n                end\n            end else begin\n                if (src_valid_i && src_ready_o) begin\n                    mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n                    src_wr_ptr <= src_wr_ptr + 1'b1;\n                    src_wr_ptr_gray <= bin2gray(src_wr_ptr + 1'b1);\n                end\n            end\n        end\n    end\n\n    // Source ready: FIFO not full and not clearing\n    wire src_full = (src_wr_ptr_gray == src_rd_ptr_gray_synced) && \n                    (src_wr_ptr[LOG_DEPTH] != src_rd_ptr_gray_synced[LOG_DEPTH]);\n    // Actually, full condition for gray pointers:\n    // Full when gray write pointer equals gray read pointer and MSB differs\n    // Let me recalculate:\n    // For a FIFO of depth 2^LOG_DEPTH, with pointers of width LOG_DEPTH+1:\n    // Empty: gray_wr == gray_rd\n    // Full: gray_wr == gray_rd ^ (1 << LOG_DEPTH) i.e., MSB differs, rest same\n\n    wire src_empty = (src_wr_ptr_gray == src_rd_ptr_gray_synced);\n    wire src_full = (src_wr_ptr_gray == (src_rd_ptr_gray_synced ^ (1 << LOG_DEPTH)));\n\n    assign src_ready_o = !src_full && !src_clear_active;\n    assign src_clear_pending_o = src_clear_pending;\n\n    // Synchronize src_rd_ptr_gray to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_rd_ptr_gray_sync[0] <= {GRAY_W{1'b0}};\n            src_rd_ptr_gray_sync[1] <= {GRAY_W{1'b0}};\n            src_rd_ptr_gray_sync[2] <= {GRAY_W{1'b0}};\n        end else begin\n            src_rd_ptr_gray_sync[0] <= dst_rd_ptr_gray;\n            src_rd_ptr_gray_sync[1] <= src_rd_ptr_gray_sync[0];\n            src_rd_ptr_gray_sync[2] <= src_rd_ptr_gray_sync[1];\n        end\n    end\n\n    assign src_rd_ptr_gray_synced = src_rd_ptr_gray_sync[SYNC_STAGES-1];\n\n    // Synchronize src_clear to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            src_clear_sync[0] <= src_clear_i;\n            src_clear_sync[1] <= src_clear_sync[0];\n            src_clear_sync[2] <= src_clear_sync[1];\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_rd_ptr_gray <= {GRAY_W{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n            dst_clear_pending <= 1'b0;\n            dst_clear_active <= 1'b0;\n        end else begin\n            if (dst_clear_i) begin\n                dst_clear_active <= 1'b1;\n                dst_clear_pending <= 1'b1;\n            end\n\n            if (dst_clear_active) begin\n                // Wait for src to acknowledge clear\n                if (dst_clear_sync[SYNC_STAGES-1]) begin\n                    dst_clear_active <= 1'b0;\n                    dst_clear_pending <= 1'b0;\n                    dst_rd_ptr <= {PTR_W{1'b0}};\n                    dst_rd_ptr_gray <= {GRAY_W{1'b0}};\n                    dst_data_reg <= {WIDTH{1'b0}};\n                    dst_valid_reg <= 1'b0;\n                end\n            end else begin\n                if (dst_valid_reg && dst_ready_i) begin\n                    dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                    dst_rd_ptr_gray <= bin2gray(dst_rd_ptr + 1'b1);\n                    dst_valid_reg <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // Destination empty/full check\n    wire dst_empty = (dst_rd_ptr_gray == dst_wr_ptr_gray_synced);\n    wire dst_full = (dst_rd_ptr_gray == (dst_wr_ptr_gray_synced ^ (1 << LOG_DEPTH)));\n\n    // Read from memory when valid and ready\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_clear_active) begin\n                dst_data_reg <= {WIDTH{1'b0}};\n                dst_valid_reg <= 1'b0;\n            end else begin\n                if (!dst_empty && !dst_valid_reg) begin\n                    dst_data_reg <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n                    dst_valid_reg <= 1'b1;\n                end\n            end\n        end\n    end\n\n    assign dst_valid_o = dst_valid_reg && !dst_clear_active;\n    assign dst_data_o = dst_data_reg;\n    assign dst_clear_pending_o = dst_clear_pending;\n\n    // Synchronize dst_rd_ptr_gray to destination domain (for src to see)\n    // Actually, dst_rd_ptr_gray is in dst domain, needs to go to src domain\n    // That's already handled by src_rd_ptr_gray_sync above\n\n    // Synchronize dst_wr_ptr_gray to destination domain (for dst to see)\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_wr_ptr_gray_sync[0] <= {GRAY_W{1'b0}};\n            dst_wr_ptr_gray_sync[1] <= {GRAY_W{1'b0}};\n            dst_wr_ptr_gray_sync[2] <= {GRAY_W{1'b0}};\n        end else begin\n            dst_wr_ptr_gray_sync[0] <= src_wr_ptr_gray;\n            dst_wr_ptr_gray_sync[1] <= dst_wr_ptr_gray_sync[0];\n            dst_wr_ptr_gray_sync[2] <= dst_wr_ptr_gray_sync[1];\n        end\n    end\n\n    assign dst_wr_ptr_gray_synced = dst_wr_ptr_gray_sync[SYNC_STAGES-1];\n\n    // Synchronize dst_clear to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            dst_clear_sync[0] <= dst_clear_i;\n            dst_clear_sync[1] <= dst_clear_sync[0];\n            dst_clear_sync[2] <= dst_clear_sync[1];\n        end\n    end\n\nendmodule\n```<|im_end|>",
