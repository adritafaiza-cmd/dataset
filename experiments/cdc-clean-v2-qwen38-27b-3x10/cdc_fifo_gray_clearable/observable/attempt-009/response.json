  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n    localparam GRAY_W = PTR_W;\n\n    // Gray code conversion\n    function [GRAY_W-1:0] bin2gray;\n        input [PTR_W-1:0] bin;\n        begin\n            bin2gray = (bin ^ (bin >> 1));\n        end\n    endfunction\n\n    // Source domain\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [GRAY_W-1:0] src_wr_gray;\n    reg [GRAY_W-1:0] src_rd_gray_sync;\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg src_clear_pending;\n\n    // Destination domain\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [GRAY_W-1:0] dst_rd_gray;\n    reg [GRAY_W-1:0] dst_wr_gray_sync;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n    reg dst_clear_pending;\n\n    // Synchronizer for src_wr_gray -> dst domain\n    reg [SYNC_STAGES-1:0] src_wr_gray_sync;\n    // Synchronizer for dst_rd_gray -> src domain\n    reg [SYNC_STAGES-1:0] dst_rd_gray_sync;\n\n    // Clear synchronization: src_clear -> dst domain\n    reg [SYNC_STAGES-1:0] src_clear_sync;\n    // Clear synchronization: dst_clear -> src domain\n    reg [SYNC_STAGES-1:0] dst_clear_sync;\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_wr_gray <= {GRAY_W{1'b0}};\n            src_clear_pending <= 1'b0;\n        end else begin\n            // Handle clear from dst domain\n            if (dst_clear_sync[SYNC_STAGES-1]) begin\n                src_wr_ptr <= {PTR_W{1'b0}};\n                src_wr_gray <= {GRAY_W{1'b0}};\n                src_clear_pending <= 1'b1;\n            end else begin\n                if (src_clear_i) begin\n                    src_wr_ptr <= {PTR_W{1'b0}};\n                    src_wr_gray <= {GRAY_W{1'b0}};\n                    src_clear_pending <= 1'b1;\n                end else if (src_clear_pending) begin\n                    src_clear_pending <= 1'b0;\n                end\n            end\n\n            // Write data\n            if (src_valid_i && src_ready_o && !src_clear_pending && !dst_clear_sync[SYNC_STAGES-1]) begin\n                mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n                src_wr_ptr <= src_wr_ptr + 1'b1;\n                src_wr_gray <= bin2gray(src_wr_ptr + 1'b1);\n            end\n        end\n    end\n\n    // Source ready: FIFO not full and not in clear\n    wire src_full = (src_wr_gray == src_rd_gray_sync[SYNC_STAGES-1]) &&\n                    (src_wr_ptr[LOG_DEPTH] != src_rd_gray_sync[SYNC_STAGES-1][LOG_DEPTH]);\n    assign src_ready_o = !src_full && !src_clear_pending && !dst_clear_sync[SYNC_STAGES-1];\n\n    // Synchronizers\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_gray_sync <= {SYNC_STAGES{1'b0}};\n            dst_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            dst_rd_gray_sync <= {dst_rd_gray_sync[SYNC_STAGES-2:0], dst_rd_gray};\n            dst_clear_sync <= {dst_clear_sync[SYNC_STAGES-2:0], dst_clear_i};\n        end\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_gray_sync <= {SYNC_STAGES{1'b0}};\n            src_clear_sync <= {SYNC_STA