  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n    localparam GRAY_W = PTR_W;\n\n    // Gray code conversion\n    function [GRAY_W-1:0] bin2gray;\n        input [PTR_W-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Source domain\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [GRAY_W-1:0] src_wr_gray;\n    reg [GRAY_W-1:0] src_rd_gray_synced;\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Destination domain\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [GRAY_W-1:0] dst_rd_gray;\n    reg [GRAY_W-1:0] dst_wr_gray_synced;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Clear pending signals\n    reg src_clear_pending;\n    reg dst_clear_pending;\n\n    // Synchronizer for src_wr_gray to dst domain\n    reg [SYNC_STAGES-1:0] src_wr_gray_sync;\n    // Synchronizer for dst_rd_gray to src domain\n    reg [SYNC_STAGES-1:1] dst_rd_gray_sync;\n\n    // Clear synchronizers\n    reg [SYNC_STAGES-1:0] src_clear_sync;\n    reg [SYNC_STAGES-1:0] dst_clear_sync;\n\n    // Source domain logic\n    wire [PTR_W-1:0] src_wr_ptr_next;\n    wire src_full;\n    wire src_can_write;\n\n    // Destination domain logic\n    wire [PTR_W-1:0] dst_rd_ptr_next;\n    wire dst_empty;\n    wire dst_can_read;\n\n    // Source full: compare src_wr_gray with src_rd_gray_synced\n    // Full when the two MSBs differ and the rest are equal\n    assign src_full = (src_wr_gray == {~src_rd_gray_synced[GRAY_W-1:GRAY_W-2], src_rd_gray_synced[GRAY_W-3:0]}) & (src_wr_gray[GRAY_W-1:GRAY_W-2] != src_rd_gray_synced[GRAY_W-1:GRAY_W-2]);\n\n    // Destination empty: compare dst_rd_gray with dst_wr_gray_synced\n    assign dst_empty = (dst_rd_gray == dst_wr_gray_synced);\n\n    // Clear pending logic\n    // src_clear_pending is high when src_clear_i is asserted or when dst_clear has propagated\n    // dst_clear_pending is high when dst_clear_i is asserted or when src_clear has propagated\n\n    // Synchronizers\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_gray_sync <= {SYNC_STAGES{1'b0}};\n            src_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            src_wr_gray_sync <= {src_wr_gray_sync[SYNC_STAGES-2:0], dst_rd_gray};\n            src_clear_sync <= {src_clear_sync[SYNC_STAGES-2:0], dst_clear_sync[SYNC_STAGES-1]};\n        end\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_gray_sync <= {SYNC_STAGES{1'b0}};\n            dst_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            dst_rd_gray_sync <= {dst_rd_gray_sync[SYNC_STAGES-2:0], src_wr_gray};\n            dst_clear_sync <= {dst_clear_sync[SYNC_STAGES-2:0], src_clear_sync[SYNC_STAGES-1]};\n        end\n    end\n\n    // Clear pending outputs\n    assign src_clear_pending_o = src_clear_i | src_clear_sync[SYNC_STAGES-1];\n    assign dst_clear_pending_o = dst_clear_i | dst_clear_sync[SYNC_STAGES-1];\n\n    // Source write logic\n    assign src_can_write = src_valid_i & ~src_full & ~src_clear_pending_o;\n    assign src_ready_o = ~src_full & ~src_clear_pending_o;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_wr_gray <= {GRAY_W{1'b0}};\n        end else if (src_clear_i | src_clear_sync[SYNC_STAGES-1]) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_wr_gray <= {GRAY_W{1'b0}};\n        end else if (src_can_write) begin\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n            src_wr_gray <= bin2gray(src_wr_ptr + 1'b1);\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n        end\n    end\n\n    // Destination read logic\n    assign dst_can_read = ~dst_empty & dst_ready_i & ~dst_clear_pending_o;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_rd_gray <= {GRAY_W{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else if (dst_clear_i | dst_clear_sync[SYNC_STAGES-1]) begin\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_rd_gray <= {GRAY_W{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_can_read) begin\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                dst_rd_gray <= bin2gray(dst_rd_ptr + 1'b1);\n                dst_valid_reg <= 1'b0;\n            end\n            if (~dst_empty) begin\n                dst_data_reg <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n                dst_valid_reg <= 1'b1;\n            end\n        end\n    end\n\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
