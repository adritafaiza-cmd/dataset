  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire src_req;\n  wire dst_ack;\n  wire dst_req;\n  wire src_ack;\n\n  // Source domain: request generation\n  reg src_req_reg;\n  reg src_ack_reg;\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_valid_reg;\n  reg src_clear_pending_reg;\n\n  // Destination domain: acknowledge generation\n  reg dst_ack_reg;\n  reg dst_req_reg;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n  reg dst_clear_pending_reg;\n\n  // Synchronizers for request (src -> dst)\n  reg [SYNC_STAGES-1:0] req_sync;\n  wire req_synced = req_sync[SYNC_STAGES-1];\n\n  // Synchronizers for acknowledge (dst -> src)\n  reg [SYNC_STAGES-1:0] ack_sync;\n  wire ack_synced = ack_sync[SYNC_STAGES-1];\n\n  // Synchronizers for destination request (dst -> src)\n  reg [SYNC_STAGES-1:0] dst_req_sync;\n  wire dst_req_synced = dst_req_sync[SYNC_STAGES-1];\n\n  // Synchronizers for source acknowledge (src -> dst)\n  reg [SYNC_STAGES-1:0] src_ack_sync;\n  wire src_ack_synced = src_ack_sync[SYNC_STAGES-1];\n\n  // Data synchronizers (src -> dst)\n  reg [SYNC_STAGES-1:0][WIDTH-1:0] data_sync;\n  wire [WIDTH-1:0] data_synced = data_sync[SYNC_STAGES-1];\n\n  // Data synchronizers (dst -> src) - not needed for data, but for clear coordination\n  // Actually, we don't need to sync data back.\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_req_reg <= 1'b0;\n      src_ack_reg <= 1'b0;\n      src_data_reg <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_clear_pending_reg <= 1'b0;\n    end else begin\n      // Handle clear\n      if (src_clear_i && !src_clear_pending_reg) begin\n        src_clear_pending_reg <= 1'b1;\n        src_req_reg <= 1'b0;\n        src_ack_reg <= 1'b0;\n        src_valid_reg <= 1'b0;\n      end else if (src_clear_pending_reg) begin\n        // Wait for destination to acknowledge the clear\n        if (dst_req_synced) begin\n          src_clear_pending_reg <= 1'b0;\n        end\n      end else begin\n        // Normal operation\n        if (src_valid_i && src_ready_o) begin\n          src_data_reg <= src_data_i;\n          src_valid_reg <= 1'b1;\n          src_req_reg <= 1'b1;\n        end else if (src_req_reg && ack_synced) begin\n          // Transfer complete\n          src_req_reg <= 1'b0;\n          src_valid_reg <= 1'b0;\n        end\n      end\n    end\n  end\n\n  assign src_req = src_req_reg;\n  assign src_ack = src_ack_reg;\n  assign src_ready_o = !src_clear_pending_reg && (!src_req_reg || ack_synced);\n  assign src_clear_pending_o = src_clear_pending_reg;\n\n  // Synchronize request from src to dst\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      req_sync <= {req_sync[SYNC_STAGES-2:0], src_req};\n    end\n  end\n\n  // Synchronize acknowledge from dst to src\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      ack_sync <= {ack_sync[SYNC_STAGES-2:0], dst_ack};\n    end\n  end\n\n  // Synchronize dst_req from dst to src\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_req_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      dst_req_sync <= {dst_req_sync[SYNC_STAGES-2:0], dst_req};\n    end\n  end\n\n  // Synchronize src_ack from src to dst\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_ack_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      src_ack_sync <= {src_ack_sync[SYNC_STAGES-2:0], src_ack};\n    end\n  end\n\n  // Synchronize data from src to dst\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      data_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      data_sync <= {data_sync[SYNC_STAGES-2:0], src_data_reg};\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_ack_reg <= 1'b0;\n      dst_req_reg <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_clear_pending_reg <= 1'b0;\n    end else begin\n      // Handle clear\n      if (dst_clear_i && !dst_clear_pending_reg) begin\n        dst_clear_pending_reg <= 1'b1;\n        dst_ack_reg <= 1'b0;\n        dst_req_reg <= 1'b0;\n        dst_valid_reg <= 1'b0;\n      end else if (dst_clear_pending_reg) begin\n        // Wait for source to acknowledge the clear\n        if (src_ack_synced) begin\n          dst_clear_pending_reg <= 1'b0;\n        end\n      end else begin\n        // Normal operation\n        if (req_synced && !dst_ack_reg) begin\n          // Capture data and acknowledge\n          dst_data_reg <= data_synced;\n          dst_valid_reg <= 1'b1;\n          dst_ack_reg <= 1'b1;\n        end else if (dst_valid_reg && dst_ready_i) begin\n          // Transfer complete\n          dst_valid_reg <= 1'b0;\n          dst_ack_reg <= 1'b0;\n        end\n      end\n    end\n  end\n\n  assign dst_ack = dst_ack_reg;\n  assign dst_req = dst_req_reg;\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_clear_pending_o = dst_clear_pending_reg;\n\nendmodule\n```<|im_end|>",
