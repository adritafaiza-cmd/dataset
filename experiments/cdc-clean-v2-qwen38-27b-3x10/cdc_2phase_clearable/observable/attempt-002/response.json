{
  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // ========================================================================\n  // Source-side state\n  // ========================================================================\n  reg src_has_data;\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_clear_pending;\n\n  // ========================================================================\n  // Destination-side state\n  // ========================================================================\n  reg dst_has_data;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_clear_pending;\n\n  // ========================================================================\n  // CDC synchronizers\n  // ========================================================================\n  // src_has_data -> dst domain\n  reg [SYNC_STAGES-1:0] src_has_data_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_has_data_sync <= {SYNC_STAGES{1'b0}};\n    else\n      src_has_data_sync <= {src_has_data_sync[SYNC_STAGES-2:0], src_has_data};\n  end\n  wire src_has_data_dst = src_has_data_sync[SYNC_STAGES-1];\n\n  // dst_has_data -> src domain\n  reg [SYNC_STAGES-1:0] dst_has_data_sync;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_has_data_sync <= {SYNC_STAGES{1'b0}};\n    else\n      dst_has_data_sync <= {dst_has_data_sync[SYNC_STAGES-2:0], dst_has_data};\n  end\n  wire dst_has_data_src = dst_has_data_sync[SYNC_STAGES-1];\n\n  // dst_clear_pending -> src domain\n  reg [SYNC_STAGES-1:0] dst_clear_pending_sync;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_clear_pending_sync <= {SYNC_STAGES{1'b0}};\n    else\n      dst_clear_pending_sync <= {dst_clear_pending_sync[SYNC_STAGES-2:0], dst_clear_pending};\n  end\n  wire dst_clear_pending_src = dst_clear_pending_sync[SYNC_STAGES-1];\n\n  // src_clear_pending -> dst domain\n  reg [SYNC_STAGES-1:0] src_clear_pending_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_clear_pending_sync <= {SYNC_STAGES{1'b0}};\n    else\n      src_clear_pending_sync <= {src_clear_pending_sync[SYNC_STAGES-2:0], src_clear_pending};\n  end\n  wire src_clear_pending_dst = src_clear_pending_sync[SYNC_STAGES-1];\n\n  // ========================================================================\n  // Source-side logic\n  // ========================================================================\n  // src_ready: can accept new data if we don't have data and no clear is pending\n  assign src_ready_o = !src_has_data && !src_clear_pending;\n\n  // src_clear_pending output\n  assign src_clear_pending_o = src_clear_pending;\n\n  // Source state machine\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_has_data      <= 1'b0;\n      src_data_reg      <= {WIDTH{1'b0}};\n      src_clear_pending <= 1'b0;\n    end else begin\n      // Handle clear request\n      if (src_clear_i) begin\n        src_clear_pending <= 1'b1;\n        // Drop any outstanding data\n        src_has_data <= 1'b0;\n      end else if (src_clear_pending) begin\n        // Wait for dst to acknowledge the clear\n        if (dst_clear_pending_src) begin\n          // Clear acknowledged, return to idle\n          src_clear_pending <= 1'b0;\n        end\n      end else begin\n        // Normal operation\n        if (src_valid_i && src_ready_o) begin\n          src_has_data <= 1'b1;\n          src_data_reg <= src_data_i;\n        end else if (src_has_data && !dst_has_data_src) begin\n          // Data has been consumed by destination\n          src_has_data <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // ========================================================================\n  // Destination-side logic\n  // ========================================================================\n  // dst_valid: we have data to present\n  assign dst_valid_o = dst_has_data;\n\n  // dst_data output\n  assign dst_data_o = dst_data_reg;\n\n  // dst_clear_pending output\n  assign dst_clear_pending_o = dst_clear_pending;\n\n  // Destination state machine\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_has_data      <= 1'b0;\n      dst_data_reg      <= {WIDTH{1'b0}};\n      dst_clear_pending <= 1'b0;\n    end else begin\n      // Handle clear request\n      if (dst_clear_i) begin\n        dst_clear_pending <= 1'b1;\n        // Drop any outstanding data\n        dst_has_data <= 1'b0;\n      end else if (dst_clear_pending) begin\n        // Wait for src to acknowledge the clear\n        if (src_clear_pending_dst) begin\n          // Clear acknowledged, return to idle\n          dst_clear_pending <= 1'b0;\n        end\n      end else begin\n        // Normal operation\n        if (!dst_has_data && src_has_data_dst) begin\n          // Source has data, accept it\n          dst_has_data <= 1'b1;\n          dst_data_reg <= src_data_reg;\n        end else if (dst_has_data && dst_ready_i) begin\n          // Data consumed by receiver\n          dst_has_data <= 1'b0;\n        end\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>",
