  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire src_req;\n  wire dst_ack;\n  wire dst_req;\n  wire src_ack;\n\n  // Source domain: request generation\n  reg src_req_reg;\n  reg src_ack_reg;\n  reg src_clear_pending_reg;\n  reg src_isolated_reg;\n\n  // Destination domain: acknowledge generation\n  reg dst_ack_reg;\n  reg dst_req_reg;\n  reg dst_ack_reg_next;\n  reg dst_clear_pending_reg;\n  reg dst_isolated_reg;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n\n  // Synchronizers\n  wire [SYNC_STAGES-1:0] src_req_sync;\n  wire [SYNC_STAGES-1:0] dst_ack_sync;\n  wire [SYNC_STAGES-1:0] dst_req_sync;\n  wire [SYNC_STAGES-1:0] src_ack_sync;\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_req_reg <= 1'b0;\n      src_ack_reg <= 1'b0;\n      src_clear_pending_reg <= 1'b0;\n      src_isolated_reg <= 1'b0;\n    end else begin\n      // Clear handling\n      if (src_clear_i && !src_isolated_reg) begin\n        src_isolated_reg <= 1'b1;\n        src_clear_pending_reg <= 1'b1;\n      end\n\n      // Clear completion: when dst_ack is deasserted (synced back)\n      if (src_isolated_reg && !dst_ack_sync[SYNC_STAGES-1]) begin\n        src_isolated_reg <= 1'b0;\n        src_clear_pending_reg <= 1'b0;\n        src_req_reg <= 1'b0;\n        src_ack_reg <= 1'b0;\n      end\n\n      // Normal operation\n      if (!src_isolated_reg) begin\n        // Two-phase handshake: request toggles when valid and ready\n        // Ready is high when not in flight (ack matches req)\n        if (src_valid_i && (src_ack_reg == src_req_reg)) begin\n          src_req_reg <= ~src_req_reg;\n        end\n        // Acknowledge from destination\n        src_ack_reg <= dst_ack_sync[SYNC_STAGES-1];\n      end\n    end\n  end\n\n  assign src_req = src_req_reg;\n  assign src_ready_o = !src_isolated_reg && (src_ack_reg == src_req_reg);\n  assign src_clear_pending_o = src_clear_pending_reg;\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_ack_reg <= 1'b0;\n      dst_req_reg <= 1'b0;\n      dst_clear_pending_reg <= 1'b0;\n      dst_isolated_reg <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n    end else begin\n      // Clear handling\n      if (dst_clear_i && !dst_isolated_reg) begin\n        dst_isolated_reg <= 1'b1;\n        dst_clear_pending_reg <= 1'b1;\n      end\n\n      // Clear completion: when src_req is deasserted (synced back)\n      if (dst_isolated_reg && !src_req_sync[SYNC_STAGES-1]) begin\n        dst_isolated_reg <= 1'b0;\n        dst_clear_pending_reg <= 1'b0;\n        dst_ack_reg <= 1'b0;\n        dst_req_reg <= 1'b0;\n        dst_valid_reg <= 1'b0;\n      end\n\n      // Normal operation\n      if (!dst_isolated_reg) begin\n        // Capture data on request edge\n        if (src_req_sync[SYNC_STAGES-1] != dst_req_reg) begin\n          dst_req_reg <= src_req_sync[SYNC_STAGES-1];\n          dst_data_reg <= src_data_i; // Data is stable during transfer\n          dst_valid_reg <= 1'b1;\n        end\n\n        // Acknowledge when ready\n        if (dst_valid_reg && dst_ready_i) begin\n          dst_ack_reg <= ~dst_ack_reg;\n          dst_valid_reg <= 1'b0;\n        end\n      end\n    end\n  end\n\n  assign dst_ack = dst_ack_reg;\n  assign dst_req = dst_req_reg;\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_clear_pending_o = dst_clear_pending_reg;\n\n  // Synchronizers: src_req to dst domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_req_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      src_req_sync <= {src_req_sync[SYNC_STAGES-2:0], src_req};\n    end\n  end\n\n  // Synchronizers: dst_ack to src domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_ack_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      dst_ack_sync <= {dst_ack_sync[SYNC_STAGES-2:0], dst_ack};\n    end\n  end\n\n  // Synchronizers: dst_req to src domain (not directly used but for completeness)\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_req_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      dst_req_sync <= {dst_req_sync[SYNC_STAGES-2:0], dst_req};\n    end\n  end\n\n  // Synchronizers: src_ack to dst domain (not directly used but for completeness)\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_ack_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      src_ack_sync <= {src_ack_sync[SYNC_STAGES-2:0], src_ack_reg};\n    end\n  end\n\nendmodule\n```<|im_end|>",
