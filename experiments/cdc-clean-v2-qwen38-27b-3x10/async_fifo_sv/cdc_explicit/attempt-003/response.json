{
  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n\n    // Write domain\n    reg [PTR_WIDTH-1:0] wptr;\n    reg [PTR_WIDTH-1:0] wptr_sync; // synchronized read pointer (in write domain)\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Read domain\n    reg [PTR_WIDTH-1:0] rptr;\n    reg [PTR_WIDTH-1:0] rptr_sync; // synchronized write pointer (in read domain)\n    reg [DATA_WIDTH-1:0] rdata_reg;\n    reg rdata_valid;\n\n    // Synchronization registers\n    reg [PTR_WIDTH-1:0] wptr_sync_r [0:SYNC_STAGES-1];\n    reg [PTR_WIDTH-1:0] rptr_sync_w [0:SYNC_STAGES-1];\n\n    // Full and empty flags\n    assign wfull = (wptr == wptr_sync);\n    assign rempty = (rptr == rptr_sync);\n\n    // Debug pointer outputs\n    assign waddr = wptr;\n    assign raddr = rptr;\n\n    // Write pointer increment\n    wire winc_eff = winc & ~wfull;\n    wire rinc_eff = rinc & ~rempty;\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {PTR_WIDTH{1'b0}};\n        end else if (winc_eff) begin\n            wptr <= wptr + 1'b1;\n        end\n    end\n\n    // Read pointer increment\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {PTR_WIDTH{1'b0}};\n        end else if (rinc_eff) begin\n            rptr <= rptr + 1'b1;\n        end\n    end\n\n    // Synchronize write pointer to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            for (int i = 0; i < SYNC_STAGES; i = i + 1)\n                wptr_sync_r[i] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            wptr_sync_r[0] <= wptr;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                wptr_sync_r[i] <= wptr_sync_r[i-1];\n        end\n    end\n    assign wptr_sync = wptr_sync_r[SYNC_STAGES-1];\n\n    // Synchronize read pointer to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            for (int i = 0; i < SYNC_STAGES; i = i + 1)\n                rptr_sync_w[i] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            rptr_sync_w[0] <= rptr;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                rptr_sync_w[i] <= rptr_sync_w[i-1];\n        end\n    end\n    assign rptr_sync = rptr_sync_w[SYNC_STAGES-1];\n\n    // Write data to memory\n    always @(posedge wclk) begin\n        if (winc_eff) begin\n            mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n        end\n    end\n\n    // Read data from memory with two-stage pipeline for CDC safety\n    // Stage 1: capture data and address on read clock when read is accepted\n    // Stage 2: present data as valid\n\n    reg [DATA_WIDTH-1:0] rdata_stage1;\n    reg rdata_stage1_valid;\n    reg [ADDR_WIDTH-1:0] raddr_stage1;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata_stage1 <= {DATA_WIDTH{1'b0}};\n            rdata_stage1_valid <= 1'b0;\n            raddr_stage1 <= {ADDR_WIDTH{1'b0}};\n        end else begin\n            if (rinc_eff) begin\n                rdata_stage1 <= mem[rptr[ADDR_WIDTH-1:0]];\n                rdata_stage1_valid <= 1'b1;\n                raddr_stage1 <= rptr[ADDR_WIDTH-1:0];\n            end else begin\n                rdata_stage1_valid <= 1'b0;\n            end\n        end\n    end\n\n    // Stage 2: final output\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata_reg <= {DATA_WIDTH{1'b0}};\n            rdata_valid <= 1'b0;\n        end else begin\n            rdata_reg <= rdata_stage1;\n            rdata_valid <= rdata_stage1_valid;\n        end\n    end\n\n    assign rdata = rdata_reg;\n\nendmodule\n```<|im_end|>",
