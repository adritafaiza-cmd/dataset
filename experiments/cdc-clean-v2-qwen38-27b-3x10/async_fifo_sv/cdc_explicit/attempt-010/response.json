{
  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n\n    // Write domain\n    reg [PTR_WIDTH-1:0] wptr;\n    reg [PTR_WIDTH-1:0] rptr_w;\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Read domain\n    reg [PTR_WIDTH-1:0] rptr;\n    reg [PTR_WIDTH-1:0] wptr_r;\n    reg [DATA_WIDTH-1:0] rdata_reg;\n\n    // Synchronizer for write pointer to read domain\n    reg [PTR_WIDTH-1:0] wptr_sync [0:SYNC_STAGES-1];\n\n    // Synchronizer for read pointer to write domain\n    reg [PTR_WIDTH-1:0] rptr_sync [0:SYNC_STAGES-1];\n\n    // Full/Empty flags\n    wire wfull_int;\n    wire rempty_int;\n\n    // Write enable\n    wire wvalid = winc & ~wfull_int;\n\n    // Read enable\n    wire rvalid = rinc & ~rempty_int;\n\n    // Write pointer update\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr <= {PTR_WIDTH{1'b0}};\n        else if (wvalid)\n            wptr <= wptr + 1'b1;\n    end\n\n    // Read pointer update\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr <= {PTR_WIDTH{1'b0}};\n        else if (rvalid)\n            rptr <= rptr + 1'b1;\n    end\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (wvalid)\n            mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n    end\n\n    // Memory read\n    always @(posedge rclk) begin\n        if (rvalid)\n            rdata_reg <= mem[rptr[ADDR_WIDTH-1:0]];\n    end\n\n    // Synchronize write pointer to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            for (int i = 0; i < SYNC_STAGES; i = i + 1)\n                wptr_sync[i] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            wptr_sync[0] <= wptr;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                wptr_sync[i] <= wptr_sync[i-1];\n        end\n    end\n\n    // Synchronize read pointer to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            for (int i = 0; i < SYNC_STAGES; i = i + 1)\n                rptr_sync[i] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            rptr_sync[0] <= rptr;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                rptr_sync[i] <= rptr_sync[i-1];\n        end\n    end\n\n    // Full flag: write pointer has lapped read pointer by DEPTH\n    assign wfull_int = (wptr[PTR_WIDTH-1] != rptr_sync[SYNC_STAGES-1][PTR_WIDTH-1]) &&\n                       (wptr[ADDR_WIDTH-1:0] == rptr_sync[SYNC_STAGES-1][ADDR_WIDTH-1:0]);\n\n    // Empty flag: write pointer equals read pointer\n    assign rempty_int = (wptr_sync[SYNC_STAGES-1] == rptr);\n\n    // Outputs\n    assign wfull  = wfull_int;\n    assign waddr  = wptr;\n    assign rdata  = rdata_reg;\n    assign rempty = rempty_int;\n    assign raddr  = rptr;\n\nendmodule\n```<|im_end|>",
