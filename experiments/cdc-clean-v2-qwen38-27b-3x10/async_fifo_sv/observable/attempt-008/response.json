{
  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n\n    // Write domain\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_WIDTH-1:0]  wptr;\n    reg [PTR_WIDTH-1:0]  rptr_wsync; // read pointer synchronized to write domain\n\n    // Read domain\n    reg [PTR_WIDTH-1:0]  rptr;\n    reg [PTR_WIDTH-1:0]  wptr_rsync; // write pointer synchronized to read domain\n\n    // Synchronizer registers\n    reg [PTR_WIDTH-1:0] wptr_sync [0:SYNC_STAGES-1];\n    reg [PTR_WIDTH-1:0] rptr_sync [0:SYNC_STAGES-1];\n\n    // Write clock domain logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {PTR_WIDTH{1'b0}};\n        end else if (winc && !wfull) begin\n            mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n            wptr <= wptr + 1'b1;\n        end\n    end\n\n    // Synchronize read pointer to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_sync[0] <= {PTR_WIDTH{1'b0}};\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                rptr_sync[i] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            rptr_sync[0] <= rptr;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                rptr_sync[i] <= rptr_sync[i-1];\n        end\n    end\n\n    assign rptr_wsync = rptr_sync[SYNC_STAGES-1];\n\n    // Write full: write pointer has lapped read pointer by DEPTH\n    assign wfull = (wptr[ADDR_WIDTH-1:0] == rptr_wsync[ADDR_WIDTH-1:0]) &&\n                   (wptr[ADDR_WIDTH] != rptr_wsync[ADDR_WIDTH]);\n\n    assign waddr = wptr;\n\n    // Read clock domain logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {PTR_WIDTH{1'b0}};\n        end else if (rinc && !rempty) begin\n            rptr <= rptr + 1'b1;\n        end\n    end\n\n    // Synchronize write pointer to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_sync[0] <= {PTR_WIDTH{1'b0}};\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                wptr_sync[i] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            wptr_sync[0] <= wptr;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                wptr_sync[i] <= wptr_sync[i-1];\n        end\n    end\n\n    assign wptr_rsync = wptr_sync[SYNC_STAGES-1];\n\n    // Read empty: read pointer equals write pointer\n    assign rempty = (rptr == wptr_rsync);\n\n    assign rdata = mem[rptr[ADDR_WIDTH-1:0]];\n    assign raddr = rptr;\n\nendmodule\n```<|im_end|>",
