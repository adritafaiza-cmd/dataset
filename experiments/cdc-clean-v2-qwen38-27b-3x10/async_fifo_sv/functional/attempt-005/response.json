{
  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n\n    // Write domain\n    reg [PTR_WIDTH-1:0] wptr;\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Read domain\n    reg [PTR_WIDTH-1:0] rptr;\n    reg [DATA_WIDTH-1:0] rdata_reg;\n\n    // Gray code pointers\n    wire [ADDR_WIDTH:0] wptr_gray = wptr ^ (wptr >> 1);\n    wire [ADDR_WIDTH:0] rptr_gray = rptr ^ (rptr >> 1);\n\n    // Synchronizers\n    reg [ADDR_WIDTH:0] rptr_gray_sync [0:SYNC_STAGES-1];\n    reg [ADDR_WIDTH:0] wptr_gray_sync [0:SYNC_STAGES-1];\n\n    // Write domain: synchronize read pointer gray\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_sync[0] <= {ADDR_WIDTH+1{1'b0}};\n            rptr_gray_sync[1] <= {ADDR_WIDTH+1{1'b0}};\n            for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                rptr_gray_sync[i] <= {ADDR_WIDTH+1{1'b0}};\n        end else begin\n            rptr_gray_sync[0] <= rptr_gray;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                rptr_gray_sync[i] <= rptr_gray_sync[i-1];\n        end\n    end\n\n    // Read domain: synchronize write pointer gray\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_sync[0] <= {ADDR_WIDTH+1{1'b0}};\n            wptr_gray_sync[1] <= {ADDR_WIDTH+1{1'b0}};\n            for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                wptr_gray_sync[i] <= {ADDR_WIDTH+1{1'b0}};\n        end else begin\n            wptr_gray_sync[0] <= wptr_gray;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                wptr_gray_sync[i] <= wptr_gray_sync[i-1];\n        end\n    end\n\n    // Convert synchronized gray to binary\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        reg [ADDR_WIDTH:0] bin;\n        begin\n            bin[ADDR_WIDTH] = gray[ADDR_WIDTH];\n            for (int i = ADDR_WIDTH-1; i >= 0; i = i - 1)\n                bin[i] = bin[i+1] ^ gray[i];\n            gray_to_bin = bin;\n        end\n    endfunction\n\n    wire [ADDR_WIDTH:0] rptr_gray_sync_bin = gray_to_bin(rptr_gray_sync[SYNC_STAGES-1]);\n    wire [ADDR_WIDTH:0] wptr_gray_sync_bin = gray_to_bin(wptr_gray_sync[SYNC_STAGES-1]);\n\n    // Full and empty flags\n    assign wfull = (wptr[ADDR_WIDTH] == rptr_gray_sync_bin[ADDR_WIDTH]) &&\n                   (wptr[ADDR_WIDTH-1:0] == rptr_gray_sync_bin[ADDR_WIDTH-1:0]) &&\n                   (wptr[ADDR_WIDTH] != rptr_gray_sync_bin[ADDR_WIDTH]);\n    \n    // Correct full condition: MSB differs, lower bits same\n    assign wfull = (wptr[ADDR_WIDTH] != rptr_gray_sync_bin[ADDR_WIDTH]) &&\n                   (wptr[ADDR_WIDTH-1:0] == rptr_gray_sync_bin[ADDR_WIDTH-1:0]);\n\n    assign rempty = (rptr == wptr_gray_sync_bin);\n\n    // Write logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {PTR_WIDTH{1'b0}};\n        end else if (winc && !wfull) begin\n            mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n            wptr <= wptr + 1'b1;\n        end\n    end\n\n    // Read logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {PTR_WIDTH{1'b0}};\n            rdata_reg <= {DATA_WIDTH{1'b0}};\n        end else if (rinc && !rempty) begin\n            rdata_reg <= mem[rptr[ADDR_WIDTH-1:0]];\n            rptr <= rptr + 1'b1;\n        end\n    end\n\n    assign rdata = rdata_reg;\n    assign waddr = wptr;\n    assign raddr = rptr;\n\nendmodule\n```<|im_end|>",
