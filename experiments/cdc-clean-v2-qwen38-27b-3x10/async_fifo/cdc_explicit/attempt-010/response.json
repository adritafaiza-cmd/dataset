{
  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWFULL_THRESH = DEPTH - 2;\n    localparam AEMPTY_THRESH = 2;\n\n    // Write domain\n    reg [ASIZE:0] wptr;\n    reg [ASIZE:0] rptr_w;\n    reg [ASIZE:0] rptr_w_sync1;\n    reg [ASIZE:0] rptr_w_sync2;\n\n    // Read domain\n    reg [ASIZE:0] rptr;\n    reg [ASIZE:0] wptr_r;\n    reg [ASIZE:0] wptr_r_sync1;\n    reg [ASIZE:0] wptr_r_sync2;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Read data pipeline\n    reg [DSIZE-1:0] rdata_pipe1;\n    reg [DSIZE-1:0] rdata_pipe2;\n    reg             rdata_valid1;\n    reg             rdata_valid2;\n\n    // Write enable\n    wire wvalid = winc & ~wfull;\n\n    // Read enable\n    wire rvalid = rinc & ~rempty;\n\n    // Write pointer increment\n    wire wptr_inc = wvalid;\n\n    // Read pointer increment\n    wire rptr_inc = rvalid;\n\n    // Write domain logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {1'b0, {ASIZE{1'b0}}};\n            rptr_w <= {1'b0, {ASIZE{1'b0}}};\n            rptr_w_sync1 <= {1'b0, {ASIZE{1'b0}}};\n            rptr_w_sync2 <= {1'b0, {ASIZE{1'b0}}};\n        end else begin\n            if (wptr_inc)\n                wptr <= wptr + 1'b1;\n            rptr_w_sync1 <= rptr_w;\n            rptr_w_sync2 <= rptr_w_sync1;\n        end\n    end\n\n    // Read domain logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {1'b0, {ASIZE{1'b0}}};\n            wptr_r <= {1'b0, {ASIZE{1'b0}}};\n            wptr_r_sync1 <= {1'b0, {ASIZE{1'b0}}};\n            wptr_r_sync2 <= {1'b0, {ASIZE{1'b0}}};\n            rdata_pipe1 <= {DSIZE{1'b0}};\n            rdata_pipe2 <= {DSIZE{1'b0}};\n            rdata_valid1 <= 1'b0;\n            rdata_valid2 <= 1'b0;\n        end else begin\n            if (rptr_inc)\n                rptr <= rptr + 1'b1;\n            wptr_r_sync1 <= wptr_r;\n            wptr_r_sync2 <= wptr_r_sync1;\n\n            // Pipeline data\n            if (rvalid) begin\n                rdata_pipe1 <= mem[rptr[ASIZE-1:0]];\n                rdata_valid1 <= 1'b1;\n            end else begin\n                rdata_valid1 <= 1'b0;\n            end\n\n            if (rdata_valid1) begin\n                rdata_pipe2 <= rdata_pipe1;\n                rdata_valid2 <= 1'b1;\n            end else begin\n                rdata_valid2 <= 1'b0;\n            end\n        end\n    end\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (wvalid)\n            mem[wptr[ASIZE-1:0]] <= wdata;\n    end\n\n    // Full and empty flags\n    assign wfull = (wptr - rptr_w_sync2) == DEPTH;\n    assign rempty = (rptr - wptr_r_sync2) == 0;\n\n    // Almost full and almost empty\n    assign awfull = (wptr - rptr_w_sync2) >= AWFULL_THRESH;\n    assign arempty = (rptr - wptr_r_sync2) <= AEMPTY_THRESH;\n\n    // Output data\n    assign rdata = rdata_pipe2;\n\nendmodule\n```<|im_end|>",
