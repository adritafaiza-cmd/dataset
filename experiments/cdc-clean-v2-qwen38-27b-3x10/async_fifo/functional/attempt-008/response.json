  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWIDTH = ASIZE + 1;\n    localparam FULL_THRESH = DEPTH - 1;\n    localparam EMPTY_THRESH = 1;\n\n    wire [AWIDTH-1:0] wptr;\n    wire [AWIDTH-1:0] rptr;\n\n    wire [AWIDTH-1:0] wptr_gray;\n    wire [AWIDTH-1:0] rptr_gray;\n\n    wire [AWIDTH-1:0] rptr_gray_wclk;\n    wire [AWIDTH-1:0] wptr_gray_rclk;\n\n    wire winc_eff;\n    wire rinc_eff;\n\n    wire wfull_int;\n    wire rempty_int;\n\n    wire [AWIDTH-1:0] wptr_gray_sync1;\n    wire [AWIDTH-1:0] wptr_gray_sync2;\n    wire [AWIDTH-1:0] rptr_gray_sync1;\n    wire [AWIDTH-1:0] rptr_gray_sync2;\n\n    // Write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {AWIDTH{1'b0}};\n        end else if (winc_eff) begin\n            wptr <= wptr + 1'b1;\n        end\n    end\n\n    assign wptr_gray = wptr ^ (wptr >> 1);\n\n    // Read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {AWIDTH{1'b0}};\n        end else if (rinc_eff) begin\n            rptr <= rptr + 1'b1;\n        end\n    end\n\n    assign rptr_gray = rptr ^ (rptr >> 1);\n\n    // Synchronize rptr_gray to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_wclk <= {AWIDTH{1'b0}};\n        end else begin\n            rptr_gray_wclk <= rptr_gray;\n        end\n    end\n\n    // Synchronize wptr_gray to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_rclk <= {AWIDTH{1'b0}};\n        end else begin\n            wptr_gray_rclk <= wptr_gray;\n        end\n    end\n\n    // Full detection in write domain\n    // Full when wptr_gray == rptr_gray_wclk with MSB different\n    // Actually, full when wptr_gray == rptr_gray_wclk ^ (1 << (AWIDTH-1))\n    // Let's use the standard approach:\n    // wfull when wptr_gray == rptr_gray_wclk and wptr[ASIZE] != rptr_gray_wclk[ASIZE]\n    // More precisely: wfull when wptr_gray == rptr_gray_wclk ^ (1 << (AWIDTH-1))\n    \n    wire [AWIDTH-1:0] rptr_gray_wclk_full_check;\n    assign rptr_gray_wclk_full_check = rptr_gray_wclk ^ (1 << (AWIDTH-1));\n    assign wfull_int = (wptr_gray == rptr_gray_wclk_full_check);\n\n    // Empty detection in read domain\n    // Empty when rptr_gray == wptr_gray_rclk\n    assign rempty_int = (rptr_gray == wptr_gray_rclk);\n\n    // Effective increment signals\n    assign winc_eff = winc & ~wfull_int;\n    assign rinc_eff = rinc & ~rempty_int;\n\n    // Almost full: wptr - rptr >= FULL_THRESH\n    // We need to compute the difference in the write domain\n    // wptr and rptr_gray_wclk are both in write domain (rptr_gray_wclk is synchronized)\n    // But rptr_gray_wclk is gray code, so we need to convert back to binary or compute difference differently\n    \n    // Let's use a different approach: count the number of entries\n    // We can convert rptr_gray_wclk back to binary in the write domain\n    wire [AWIDTH-1:0] rptr_bin_wclk;\n    gray2bin #(.WIDTH(AWIDTH)) u_gray2bin_w (\n        .gray(rptr_gray_wclk),\n        .bin(rptr_bin_wclk)\n    );\n\n    wire [AWIDTH-1:0] wptr_bin_wclk;\n    assign wptr_bin_wclk = wptr;\n\n    wire [AWIDTH:0] wcount;\n    assign wcount = wptr_bin_wclk - rptr_bin_wclk;\n\n    assign awfull = (wcount >= FULL_THRESH);\n\n    // Almost empty: wptr - rptr <= EMPTY_THRESH\n    // In read domain\n    wire [AWIDTH-1:0] wptr_bin_rclk;\n    gray2bin #(.WIDTH(AWIDTH)) u_gray2bin_r (\n        .gray(wptr_gray_rclk),\n        .bin(wptr_bin_rclk)\n    );\n\n    wire [AWIDTH-1:0] rptr_bin_rclk;\n    assign rptr_bin_rclk = rptr;\n\n    wire [AWIDTH:0] rcount;\n    assign rcount = wptr_bin_rclk - rptr_bin_rclk;\n\n    assign arempty = (rcount <= EMPTY_THRESH);\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write to memory\n    always @(posedge wclk) begin\n        if (winc_eff) begin\n            mem[wptr[ASIZE-1:0]] <= wdata;\n        end\n    end\n\n    // Read from memory\n    // For fall-through, we want rdata to present the oldest unread word\n    // when rempty falls, without requiring an additional accepted read.\n    // This means rdata should be the data at rptr[ASIZE-1:0] when not empty.\n    // But the spec says \"rdata is one read-clock sample\" and \"FALLTHROUGH does not select a combinational memory read.\"\n    // So we need to register the read data.\n    \n    // Let's think about this more carefully.\n    // When FALLTHROUGH is TRUE, rdata presents the current oldest unread word once rempty falls.\n    // This suggests that rdata is a registered version of the data at the read pointer.\n    \n    reg [DSIZE-1:0] rdata_reg;\n    reg             rdata_valid;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata_reg <= {DSIZE{1'b0}};\n            rdata_valid <= 1'b0;\n        end else begin\n            if (!rempty_int) begin\n                rdata_reg <= mem[rptr[ASIZE-1:0]];\n                rdata_valid <= 1'b1;\n            end\n        end\n    end\n\n    assign rdata = rdata_reg;\n\n    // Outputs\n    assign wfull = wfull_int;\n    assign rempty = rempty_int;\n\nendmodule\n\nmodule gray2bin\n    #(\n        parameter WIDTH = 4\n    )(\n        input  wire [WIDTH-1:0] gray,\n        output wire [WIDTH-1:0] bin\n    );\n\n    wire [WIDTH-1:0] temp;\n    assign temp = gray ^ (gray >> 1);\n    assign bin = temp ^ (temp >> 1) ^ (temp >> 2) ^ (temp >> 3) ^ (temp >> 4) ^ (temp >> 5) ^ (temp >> 6) ^ (temp >> 7);\n\nendmodule\n```<|im_end|>",
