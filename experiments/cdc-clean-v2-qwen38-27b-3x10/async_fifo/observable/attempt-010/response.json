  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam AWIDTH = ASIZE + 1;\n    localparam DEPTH  = 1 << ASIZE;\n    localparam AWFULL_THRESH = DEPTH - 1;\n    localparam AEMPTY_THRESH = 1;\n\n    // Write domain\n    reg [AWIDTH-1:0] wptr;\n    reg [AWIDTH-1:0] wptr_gray;\n    reg [AWIDTH-1:0] rptr_gray_w;\n    reg [AWIDTH-1:0] rptr_gray_w_d1;\n    reg [AWIDTH-1:0] rptr_gray_w_d2;\n\n    // Read domain\n    reg [AWIDTH-1:0] rptr;\n    reg [AWIDTH-1:0] rptr_gray;\n    reg [AWIDTH-1:0] wptr_gray_r;\n    reg [AWIDTH-1:0] wptr_gray_r_d1;\n    reg [AWIDTH-1:0] wptr_gray_r_d2;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write side: gray code conversion\n    function [AWIDTH-1:0] bin2gray;\n        input [AWIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Read side: gray code conversion\n    function [AWIDTH-1:0] bin2gray_r;\n        input [AWIDTH-1:0] bin;\n        begin\n            bin2gray_r = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Write domain: update write pointer and gray code\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr      <= {AWIDTH{1'b0}};\n            wptr_gray <= {AWIDTH{1'b0}};\n        end else if (winc && !wfull) begin\n            wptr      <= wptr + 1'b1;\n            wptr_gray <= bin2gray(wptr + 1'b1);\n        end\n    end\n\n    // Write domain: synchronize read pointer gray code\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_w_d1 <= {AWIDTH{1'b0}};\n            rptr_gray_w_d2 <= {AWIDTH{1'b0}};\n        end else begin\n            rptr_gray_w_d1 <= rptr_gray;\n            rptr_gray_w_d2 <= rptr_gray_w_d1;\n        end\n    end\n\n    // Write domain: compute full and almost full\n    wire [AWIDTH-1:0] wptr_gray_sync = wptr_gray;\n    wire [AWIDTH-1:0] rptr_gray_sync = rptr_gray_w_d2;\n\n    // Full: write pointer gray equals read pointer gray with MSB different\n    // Actually, full condition: wptr_gray == rptr_gray_sync with the top bit inverted\n    // Standard: full when wptr_gray == rptr_gray_sync ^ (1 << (AWIDTH-1))\n    wire wfull_internal = (wptr_gray == (rptr_gray_sync ^ (1 << (AWIDTH-1))));\n\n    // Almost full: write pointer is one ahead of read pointer in binary\n    // Convert rptr_gray_sync back to binary for comparison\n    function [AWIDTH-1:0] gray2bin;\n        input [AWIDTH-1:0] gray;\n        integer i;\n        begin\n            gray2bin[AWIDTH-1] = gray[AWIDTH-1];\n            for (i = AWIDTH-2; i >= 0; i = i - 1)\n                gray2bin[i] = gray2bin[i+1] ^ gray[i];\n        end\n    endfunction\n\n    wire [AWIDTH-1:0] rptr_bin_sync = gray2bin(rptr_gray_sync);\n    wire [AWIDTH-1:0] wptr_bin      = wptr;\n\n    wire awfull_internal = (wptr_bin - rptr_bin_sync) == AWFULL_THRESH[AWIDTH-1:0];\n\n    assign wfull  = wfull_internal;\n    assign awfull = awfull_internal;\n\n    // Read domain: update read pointer and gray code\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr      <= {AWIDTH{1'b0}};\n            rptr_gray <= {AWIDTH{1'b0}};\n        end else if (rinc && !rempty) begin\n            rptr      <= rptr + 1'b1;\n            rptr_gray <= bin2gray_r(rptr + 1'b1);\n        end\n    end\n\n    // Read domain: synchronize write pointer gray code\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_r_d1 <= {AWIDTH{1'b0}};\n            wptr_gray_r_d2 <= {AWIDTH{1'b0}};\n        end else begin\n            wptr_gray_r_d1 <= wptr_gray;\n            wptr_gray_r_d2 <= wptr_gray_r_d1;\n        end\n    end\n\n    // Read domain: compute empty and almost empty\n    wire [AWIDTH-1:0] wptr_gray_sync_r = wptr_gray_r_d2;\n    wire [AWIDTH-1:0] rptr_gray_sync_r = rptr_gray;\n\n    // Empty: write pointer gray equals read pointer gray\n    wire rempty_internal = (wptr_gray_sync_r == rptr_gray_sync_r);\n\n    // Almost empty: read pointer is one behind write pointer in binary\n    function [AWIDTH-1:0] gray2bin_r;\n        input [AWIDTH-1:0] gray;\n        integer i;\n        begin\n            gray2bin_r[AWIDTH-1] = gray[AWIDTH-1];\n            for (i = AWIDTH-2; i >= 0; i = i - 1)\n                gray2bin_r[i] = gray2bin_r[i+1] ^ gray[i];\n        end\n    endfunction\n\n    wire [AWIDTH-1:0] wptr_bin_sync_r = gray2bin_r(wptr_gray_sync_r);\n    wire [AWIDTH-1:0] rptr_bin_r      = rptr;\n\n    wire arempty_internal = (wptr_bin_sync_r - rptr_bin_r) == AEMPTY_THRESH[AWIDTH-1:0];\n\n    assign rempty  = rempty_internal;\n    assign arempty = arempty_internal;\n\n    // Memory write\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            // No action needed for memory on reset\n        end else if (winc && !wfull) begin\n            mem[wptr[ASIZE-1:0]] <= wdata;\n        end\n    end\n\n    // Memory read\n    assign rdata = mem[rptr[ASIZE-1:0]];\n\nendmodule\n```<|im_end|>",
