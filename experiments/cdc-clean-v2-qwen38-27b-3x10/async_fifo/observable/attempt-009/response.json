  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWIDTH = ASIZE + 1;\n\n    // Write domain\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n    reg [AWIDTH-1:0] wptr;\n    reg [ASIZE-1:0] wptr_gray;\n    reg [ASIZE-1:0] rptr_gray_w;\n\n    // Read domain\n    reg [AWIDTH-1:0] rptr;\n    reg [ASIZE-1:0] rptr_gray;\n    reg [ASIZE-1:0] wptr_gray_r;\n\n    // Gray code conversion\n    function [ASIZE-1:0] bin2gray;\n        input [ASIZE-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Write domain logic\n    wire winc_eff = winc & ~wfull;\n    wire [ASIZE-1:0] wptr_next = wptr[ASIZE-1:0] + 1'b1;\n    wire [ASIZE-1:0] wptr_gray_next = bin2gray(wptr_next);\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {AWIDTH{1'b0}};\n            wptr_gray <= {ASIZE{1'b0}};\n            rptr_gray_w <= {ASIZE{1'b0}};\n        end else begin\n            if (winc_eff) begin\n                mem[wptr[ASIZE-1:0]] <= wdata;\n                wptr <= wptr + 1'b1;\n                wptr_gray <= wptr_gray_next;\n            end\n            rptr_gray_w <= rptr_gray;\n        end\n    end\n\n    // Read domain logic\n    wire rinc_eff = rinc & ~rempty;\n    wire [ASIZE-1:0] rptr_next = rptr[ASIZE-1:0] + 1'b1;\n    wire [ASIZE-1:0] rptr_gray_next = bin2gray(rptr_next);\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {AWIDTH{1'b0}};\n            rptr_gray <= {ASIZE{1'b0}};\n            wptr_gray_r <= {ASIZE{1'b0}};\n        end else begin\n            if (rinc_eff) begin\n                rptr <= rptr + 1'b1;\n                rptr_gray <= rptr_gray_next;\n            end\n            wptr_gray_r <= wptr_gray;\n        end\n    end\n\n    // Status flags\n    // wfull: write pointer has lapped read pointer by DEPTH\n    // Compare wptr_gray with rptr_gray_w (read pointer gray in write domain)\n    // Full when wptr_gray == rptr_gray_w and wptr[ASIZE] != rptr_gray_w[ASIZE-1]... \n    // Actually, for gray code pointers, full condition:\n    // wptr_gray == rptr_gray_w and wptr[ASIZE] != rptr_gray_w[ASIZE-1]\n    // But since we're comparing gray codes, the standard approach:\n    // Full when the MSB of wptr differs from MSB of rptr (in binary) and the lower ASIZE bits of gray match.\n    // Let's use the standard Cummings approach:\n    // wfull = (wptr_gray == rptr_gray_w) && (wptr[ASIZE] != rptr_gray_w[ASIZE-1])\n    // Wait, rptr_gray_w is the gray code of rptr. The MSB of rptr in binary is not directly available.\n    // Standard approach: keep the full pointer in binary with extra bit, convert to gray for crossing.\n    // Let me reconsider.\n\n    // Actually, the standard Cummings FIFO uses:\n    // Write pointer: AWIDTH bits binary, converted to AWIDTH-bit gray for crossing\n    // Read pointer: AWIDTH bits binary, converted to AWIDTH-bit gray for crossing\n    // Full: wptr_gray == rptr_gray_w && wptr[ASIZE] != rptr_gray_w[ASIZE-1]\n    // Empty: rptr_gray == wptr_gray_r && rptr[ASIZE] != wptr_gray_r[ASIZE-1]\n\n    // Let me redo with AWIDTH-bit gray codes.\n\n    // Redo: use AWIDTH-bit gray codes for crossing.\n\n    // Write domain\n    reg [AWIDTH-1:0] wptr_gray_full;\n    reg [AWIDTH-1:0] rptr_gray_w_full;\n\n    // Read domain\n    reg [AWIDTH-1:0] rptr_gray_full;\n    reg [AWIDTH-1:0] wptr_gray_r_full;\n\n    function [AWIDTH-1:0] bin2gray_aw;\n        input [AWIDTH-1:0] bin;\n        begin\n            bin2gray_aw = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Write domain with AWIDTH-bit gray\n    wire [AWIDTH-1:0] wptr_gray_next_full = bin2gray_aw(wptr + 1'b1);\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {AWIDTH{1'b0}};\n            wptr_gray_full <= {AWIDTH{1'b0}};\n            rptr_gray_w_full <= {AWIDTH{1'b0}};\n        end else begin\n            if (winc_eff) begin\n                mem[wptr[ASIZE-1:0]] <= wdata;\n                wptr <= wptr + 1'b1;\n                wptr_gray_full <= wptr_gray_next_full;\n            end\n            rptr_gray_w_full <= rptr_gray_full;\n        end\n    end\n\n    // Read domain with AWIDTH-bit gray\n    wire [AWIDTH-1:0] rptr_gray_next_full = bin2gray_aw(rptr + 1'b1);\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {AWIDTH{1'b0}};\n            rptr_gray_full <= {AWIDTH{1'b0}};\n            wptr_gray_r_full <= {AWIDTH{1'b0}};\n        end else begin\n            if (rinc_eff) begin\n                rptr <= rptr + 1'b1;\n                rptr_gray_full <= rptr_gray_next_full;\n            end\n            wptr_gray_r_full <= wptr_gray_full;\n        end\n    end\n\n    // Full: wptr_gray == rptr_gray_w and MSB differs\n    assign wfull = (wptr_gray_full == rptr_gray_w_full) && (wptr[ASIZE] != rptr_gray_w_full[ASIZE-1]);\n\n    // Empty: rptr_gray == wptr_gray_r and MSB differs\n    assign rempty = (rptr_gray_full == wptr_gray_r_full) && (rptr[ASIZE] != wptr_gray_r_full[ASIZE-1]);\n\n    // Almost full: one less than full\n    // awfull when wptr - rptr == DEPTH - 1\n    // In gray code terms, this is trickier. Let's compute in binary.\n    // We need rptr in write domain. Let's cross rptr binary as well, or compute awfull differently.\n    // Alternative: awfull = wfull | (wptr[ASIZE-1:0] == rptr_gray_w_full[ASIZE-1:0] + 1) ... not straightforward.\n    // Let's cross the read pointer binary to write domain for awfull computation.\n\n    reg [AWIDTH-1:0] rptr_bin_w;\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            rptr_bin_w <= {AWIDTH{1'b0}};\n        else\n            rptr_bin_w <= rptr_gray_w_full; // This is gray, not binary. Need to convert.\n    end\n\n    // Convert gray to binary\n    function [AWIDTH-1:0] gray2bin;\n        input [AWIDTH-1:0] gray;\n        integer i;\n        begin\n            gray2bin[AWIDTH-1] = gray[AWIDTH-1];\n            for (i = AWIDTH-2; i >= 0; i = i - 1)\n                gray2bin[i] = gray2bin[i+1] ^ gray[i];\n        end\n    endfunction\n\n    wire [AWIDTH-1:0] rptr_bin_w_decoded = gray2bin(rptr_gray_w_full);\n    wire [AWIDTH-1:0] wptr_minus_rptr = wptr - rptr_bin_w_decoded;\n    assign awfull = (wptr_minus_rptr == DEPTH - 1);\n\n    // Almost empty: one more than empty\n    reg [AWIDTH-1:0] wptr_bin_r;\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            wptr_bin_r <= {AWIDTH{1'b0}};\n        else\n            wptr_bin_r <= wptr_gray_r_full;\n    end\n\n    wire [AWIDTH-1:0] wptr_bin_r_decoded = gray2bin(wptr_gray_r_full);\n    wire [AWIDTH-1:0] wptr_minus_rptr_r = wptr_bin_r_decoded - rptr;\n    assign arempty = (wptr_minus_rptr_r == 1);\n\n    // Read data\n    assign rdata = mem[rptr[ASIZE-1:0]];\n\nendmodule\n```<|im_end|>",
