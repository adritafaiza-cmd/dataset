{
  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam AWIDTH = ASIZE + 1;\n    localparam DEPTH  = 1 << ASIZE;\n    localparam AWFULL_THRESH = DEPTH - 1;\n    localparam AEMPTY_THRESH = 1;\n\n    // Write domain\n    reg [AWIDTH-1:0] wptr;\n    reg [AWIDTH-1:0] rptr_w;\n    reg [AWIDTH-1:0] rptr_w_sync1;\n    reg [AWIDTH-1:0] rptr_w_sync2;\n    reg [AWIDTH-1:0] rptr_w_sync3;\n\n    // Read domain\n    reg [AWIDTH-1:0] rptr;\n    reg [AWIDTH-1:0] wptr_r;\n    reg [AWIDTH-1:0] wptr_r_sync1;\n    reg [AWIDTH-1:0] wptr_r_sync2;\n    reg [AWIDTH-1:0] wptr_r_sync3;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write side logic\n    wire [AWIDTH-1:0] wptr_next = wptr + 1'b1;\n    wire              winc_eff  = winc & ~wfull;\n\n    // Read side logic\n    wire [AWIDTH-1:0] rptr_next = rptr + 1'b1;\n    wire              rinc_eff  = rinc & ~rempty;\n\n    // Full/Empty flags in write domain\n    wire [AWIDTH-1:0] wptr_minus_rptr_w = wptr - rptr_w_sync3;\n    wire              wfull_int  = (wptr_minus_rptr_w == DEPTH);\n    wire              awfull_int = (wptr_minus_rptr_w == AWFULL_THRESH);\n\n    // Full/Empty flags in read domain\n    wire [AWIDTH-1:0] wptr_r_minus_rptr = wptr_r_sync3 - rptr;\n    wire              rempty_int  = (wptr_r_minus_rptr == 0);\n    wire              arempty_int = (wptr_r_minus_rptr == AEMPTY_THRESH);\n\n    // Outputs\n    assign wfull   = wfull_int;\n    assign awfull  = awfull_int;\n    assign rempty  = rempty_int;\n    assign arempty = arempty_int;\n\n    // Read data output\n    assign rdata = mem[rptr[ASIZE-1:0]];\n\n    // Write clock domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {AWIDTH{1'b0}};\n            rptr_w <= {AWIDTH{1'b0}};\n            rptr_w_sync1 <= {AWIDTH{1'b0}};\n            rptr_w_sync2 <= {AWIDTH{1'b0}};\n            rptr_w_sync3 <= {AWIDTH{1'b0}};\n        end else begin\n            if (winc_eff)\n                mem[wptr[ASIZE-1:0]] <= wdata;\n            if (winc_eff)\n                wptr <= wptr_next;\n            rptr_w_sync1 <= rptr_w;\n            rptr_w_sync2 <= rptr_w_sync1;\n            rptr_w_sync3 <= rptr_w_sync2;\n        end\n    end\n\n    // Read clock domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {AWIDTH{1'b0}};\n            wptr_r <= {AWIDTH{1'b0}};\n            wptr_r_sync1 <= {AWIDTH{1'b0}};\n            wptr_r_sync2 <= {AWIDTH{1'b0}};\n            wptr_r_sync3 <= {AWIDTH{1'b0}};\n        end else begin\n            if (rinc_eff)\n                rptr <= rptr_next;\n            wptr_r_sync1 <= wptr_r;\n            wptr_r_sync2 <= wptr_r_sync1;\n            wptr_r_sync3 <= wptr_r_sync2;\n        end\n    end\n\n    // Cross-domain pointer synchronization\n    // Write pointer to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            wptr_r <= {AWIDTH{1'b0}};\n        else\n            wptr_r <= wptr;\n    end\n\n    // Read pointer to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            rptr_w <= {AWIDTH{1'b0}};\n        else\n            rptr_w <= rptr;\n    end\n\nendmodule\n```<|im_end|>",
