  "text": "```verilog\nmodule axil_cdc #\n(\n    parameter DATA_WIDTH = 32,\n    parameter ADDR_WIDTH = 32,\n    parameter STRB_WIDTH = (DATA_WIDTH/8)\n)\n(\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_awaddr,\n    input  wire [2:0]             s_axil_awprot,\n    input  wire                   s_axil_awvalid,\n    output wire                   s_axil_awready,\n    input  wire [DATA_WIDTH-1:0]  s_axil_wdata,\n    input  wire [STRB_WIDTH-1:0]  s_axil_wstrb,\n    input  wire                   s_axil_wvalid,\n    output wire                   s_axil_wready,\n    output wire [1:0]             s_axil_bresp,\n    output wire                   s_axil_bvalid,\n    input  wire                   s_axil_bready,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_araddr,\n    input  wire [2:0]             s_axil_arprot,\n    input  wire                   s_axil_arvalid,\n    output wire                   s_axil_arready,\n    output wire [DATA_WIDTH-1:0]  s_axil_rdata,\n    output wire [1:0]             s_axil_rresp,\n    output wire                   s_axil_rvalid,\n    input  wire                   s_axil_rready,\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [ADDR_WIDTH-1:0]  m_axil_awaddr,\n    output wire [2:0]             m_axil_awprot,\n    output wire                   m_axil_awvalid,\n    input  wire                   m_axil_awready,\n    output wire [DATA_WIDTH-1:0]  m_axil_wdata,\n    output wire [STRB_WIDTH-1:0]  m_axil_wstrb,\n    output wire                   m_axil_wvalid,\n    input  wire                   m_axil_wready,\n    input  wire [1:0]             m_axil_bresp,\n    input  wire                   m_axil_bvalid,\n    output wire                   m_axil_bready,\n    output wire [ADDR_WIDTH-1:0]  m_axil_araddr,\n    output wire [2:0]             m_axil_arprot,\n    output wire                   m_axil_arvalid,\n    input  wire                   m_axil_arready,\n    input  wire [DATA_WIDTH-1:0]  m_axil_rdata,\n    input  wire [1:0]             m_axil_rresp,\n    input  wire                   m_axil_rvalid,\n    output wire                   m_axil_rready\n);\n\n    // ========================================================================\n    // Synchronous reset synchronizers\n    // ========================================================================\n    reg [1:0] s_rst_sync;\n    reg [1:0] m_rst_sync;\n\n    always @(posedge s_clk) begin\n        s_rst_sync <= {s_rst_sync[0], s_rst};\n    end\n\n    always @(posedge m_clk) begin\n        m_rst_sync <= {m_rst_sync[0], m_rst};\n    end\n\n    wire s_rst_s = s_rst_sync[1];\n    wire m_rst_m = m_rst_sync[1];\n\n    // ========================================================================\n    // Write channel: S-side capture\n    // ========================================================================\n    reg [ADDR_WIDTH-1:0] s_awaddr_reg;\n    reg [2:0]            s_awprot_reg;\n    reg [DATA_WIDTH-1:0] s_wdata_reg;\n    reg [STRB_WIDTH-1:0] s_wstrb_reg;\n    reg                  s_wr_valid;\n\n    wire s_aw_handshake = s_axil_awvalid & s_axil_awready;\n    wire s_w_handshake  = s_axil_wvalid  & s_axil_wready;\n\n    assign s_axil_awready = ~s_wr_valid;\n    assign s_axil_wready  = ~s_wr_valid;\n\n    always @(posedge s_clk) begin\n        if (s_rst_s) begin\n            s_wr_valid   <= 1'b0;\n            s_awaddr_reg <= {ADDR_WIDTH{1'b0}};\n            s_awprot_reg <= 3'b0;\n            s_wdata_reg  <= {DATA_WIDTH{1'b0}};\n            s_wstrb_reg  <= {STRB_WIDTH{1'b0}};\n        end else begin\n            if (s_wr_valid && s_axil_bvalid && s_axil_bready) begin\n                s_wr_valid <= 1'b0;\n            end else if (~s_wr_valid && s_aw_handshake && s_w_handshake) begin\n                s_wr_valid   <= 1'b1;\n                s_awaddr_reg <= s_axil_awaddr;\n                s_awprot_reg <= s_axil_awprot;\n                s_wdata_reg  <= s_axil_wdata;\n                s_wstrb_reg  <= s_axil_wstrb;\n            end\n        end\n    end\n\n    // ========================================================================\n    // Write channel: M-side request generation\n    // ========================================================================\n    reg [ADDR_WIDTH-1:0] m_awaddr_reg;\n    reg [2:0]            m_awprot_reg;\n    reg [DATA_WIDTH-1:0] m_wdata_reg;\n    reg [STRB_WIDTH-1:0] m_wstrb_reg;\n    reg                  m_wr_pending;\n    reg                  m_aw_sent;\n    reg                  m_w_sent;\n\n    // Handshake from S to M for write request\n    reg                  wr_req_pulse;\n    reg                  wr_req_ack;\n\n    always @(posedge s_clk) begin\n        if (s_rst_s) begin\n            wr_req_pulse <= 1'b0;\n        end else begin\n            wr_req_pulse <= (s_wr_valid && ~wr_req_ack);\n        end\n    end\n\n    // 2-FF synchronizer for wr_req_pulse\n    reg [1:0] wr_req_sync;\n    always @(posedge m_clk) begin\n        wr_req_sync <= {wr_req_sync[0], wr_req_pulse};\n    end\n    wire wr_req_m = wr_req_sync[1];\n\n    always @(posedge m_clk) begin\n        if (m_rst_m) begin\n            wr_req_ack   <= 1'b0;\n            m_wr_pending <= 1'b0;\n            m_aw_sent    <= 1'b0;\n            m_w_sent     <= 1'b0;\n            m_awaddr_reg <= {ADDR_WIDTH{1'b0}};\n            m_awprot_reg <= 3'b0;\n            m_wdata_reg  <= {DATA_WIDTH{1'b0}};\n            m_wstrb_reg  <= {STRB_WIDTH{1'b0}};\n        end else begin\n            if (wr_req_m && ~m_wr_pending) begin\n                m_wr_pending <= 1'b1;\n                m_aw_sent    <= 1'b0;\n                m_w_sent     <= 1'b0;\n                m_awaddr_reg <= s_awaddr_reg;\n                m_awprot_reg <= s_awprot_reg;\n                m_wdata_reg  <= s_wdata_reg;\n                m_wstrb_reg  <= s_wstrb_reg;\n            end\n            if (m_wr_pending && m_aw_sent && m_w_sent && m_axil_bvalid) begin\n                m_wr_pending <= 1'b0;\n            end\n        end\n    end\n\n    // Acknowledge back to S side\n    reg [1:0] wr_ack_sync;\n    always @(posedge s_clk) begin\n        wr_ack_sync <= {wr_ack_sync[0], m_wr_pending};\n    end\n    assign wr_req_ack = wr_ack_sync[1];\n\n    // M-side AW channel\n    assign m_axil_awaddr  = m_awaddr_reg;\n    assign m_axil_awprot  = m_awprot_reg;\n    assign m_axil_awvalid = m_wr_pending && ~m_aw_sent;\n\n    always @(posedge m_clk) begin\n        if (m_rst_m) begin\n            m_aw_sent <= 1'b0;\n        end else begin\n            if (m_wr_pending && ~m_aw_sent && m_axil_awvalid && m_axil_awready) begin\n                m_aw_sent <= 1'b1;\n            end\n        end\n    end\n\n    // M-side W channel\n    assign m_axil_wdata  = m_wdata_reg;\n    assign m_axil_wstrb  = m_wstrb_reg;\n    assign m_axil_wvalid = m_wr_pending && ~m_w_sent;\n\n    always @(posedge m_clk) begin\n        if (m_rst_m) begin\n            m_w_sent <= 1'b0;\n        end else begin\n            if (m_wr_pending && ~m_w_sent && m_axil_wvalid && m_axil_wready) begin\n                m_w_sent <= 1'b1;\n            end\n        end\n    end\n\n    // M-side B channel\n    assign m_axil_bready = m_wr_pending && m_aw_sent && m_w_sent;\n\n    // ========================================================================\n    // Write response: M to S\n    // ========================================================================\n    reg [1:0] m_bresp_reg;\n    reg       m_bvalid_reg;\n\n    always @(posedge m_clk) begin\n        if (m_rst_m) begin\n            m_bresp_reg  <= 2'b0;\n            m_bvalid_reg <= 1'b0;\n        end else begin\n            if (m_axil_bvalid) begin\n                m_bresp_reg  <= m_axil_bresp;\n                m_bvalid_reg <= 1'b1;\n            end else if (m_bvalid_reg && m_axil_bready) begin\n                m_bvalid_reg <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronize bvalid and bresp to S side\n    reg [1:0] bvalid_sync;\n    always @(posedge s_clk) begin\n        bvalid_sync <= {bvalid_sync[0], m_bvalid_reg};\n    end\n    wire bvalid_s = bvalid_sync[1];\n\n    reg [1:0] bresp_sync;\n    always @(posedge s_clk) begin\n        if (bvalid_s) begin\n            bresp_sync <= m_bresp_reg;\n        end\n    end\n\n    assign s_axil_bresp  = bresp_sync;\n    assign s_axil_bvalid = bvalid_s;\n\n    // ========================================================================\n    // Read channel: S-side capture\n    // ========================================================================\n    reg [ADDR_WIDTH-1:0] s_araddr_reg;\n    reg [2:0]            s_arprot_reg;\n    reg                  s_rd_valid;\n\n    wire s_ar_handshake = s_axil_arvalid & s_axil_arready;\n\n    assign s_axil_arready = ~s_rd_valid;\n\n    always @(posedge s_clk) begin\n        if (s_rst_s) begin\n            s_rd_valid   <= 1'b0;\n            s_araddr_reg <= {ADDR_WIDTH{1'b0}};\n            s_arprot_reg <= 3'b0;\n        end else begin\n            if (s_rd_valid && s_axil_rvalid && s_axil_rready) begin\n                s_rd_valid <= 1'b0;\n            end else if (~s_rd_valid && s_ar_handshake) begin\n                s_rd_valid   <= 1'b1;\n                s_araddr_reg <= s_axil_araddr;\n                s_arprot_reg <= s_axil_arprot;\n            end\n        end\n    end\n\n    // ========================================================================\n    // Read channel: M-side request generation\n    // ========================================================================\n    reg [ADDR_WIDTH-1:0] m_araddr_reg;\n    reg [2:0]            m_arprot_reg;\n    reg                  m_rd_pending;\n    reg                  m_ar_sent;\n\n    // Handshake from S to M for read request\n    reg       rd_req_pulse;\n    reg       rd_req_ack;\n\n    always @(posedge s_clk) begin\n        if (s_rst_s) begin\n            rd_req_pulse <= 1'b0;\n        end else begin\n            rd_req_pulse <= (s_rd_valid && ~rd_req_ack);\n        end\n    end\n\n    reg [1:0] rd_req_sync;\n    always @(posedge m_clk) begin\n        rd_req_sync <= {rd_req_sync[0], rd_req_pulse};\n    end\n    wire rd_req_m = rd_req_sync[1];\n\n    always @(posedge m_clk) begin\n        if (m_rst_m) begin\n            rd_req_ack   <= 1'b0;\n            m_rd_pending <= 1'b0;\n            m_ar_sent    <= 1'b0;\n            m_araddr_reg <= {ADDR_WIDTH{1'b0}};\n            m_arprot_reg <= 3'b0;\n        end else begin\n            if (rd_req_m && ~m_rd_pending) begin\n                m_rd_pending <= 1'b1;\n                m_ar_sent    <= 1'b0;\n                m_araddr_reg <= s_araddr_reg;\n                m_arprot_reg <= s_arprot_reg;\n            end\n            if (m_rd_pending && m_ar_sent && m_axil_rvalid) begin\n                m_rd_pending <= 1'b0;\n            end\n        end\n    end\n\n    reg [1:0] rd_ack_sync;\n    always @(posedge s_clk) begin\n        rd_ack_sync <= {rd_ack_sync[0], m_rd_pending};\n    end\n    assign rd_req_ack = rd_ack_sync[1];\n\n    // M-side AR channel\n    assign m_axil_araddr  = m_araddr_reg;\n    assign m_axil_arprot  = m_arprot_reg;\n    assign m_axil_arvalid = m_rd_pending && ~m_ar_sent;\n\n    always @(posedge m_clk) begin\n        if (m_rst_m) begin\n            m_ar_sent <= 1'b0;\n        end else begin\n            if (m_rd_pending && ~m_ar_sent && m_axil_arvalid && m_axil_arready) begin\n                m_ar_sent <= 1'b1;\n            end\n        end\n    end\n\n    // M-side R channel\n    assign m_axil_rready = m_rd_pending && m_ar_sent;\n\n    // ========================================================================\n    // Read response: M to S\n    // ========================================================================\n    reg [DATA_WIDTH-1:0] m_rdata_reg;\n    reg [1:0]            m_rresp_reg;\n    reg                  m_rvalid_reg;\n\n    always @(posedge m_clk) begin\n        if (m_rst_m) begin\n            m_rdata_reg  <= {DATA_WIDTH{1'b0}};\n            m_rresp_reg  <= 2'b0;\n            m_rvalid_reg <= 1'b0;\n        end else begin\n            if (m_axil_rvalid) begin\n                m_rdata_reg  <= m_axil_rdata;\n                m_rresp_reg  <= m_axil_rresp;\n                m_rvalid_reg <= 1'b1;\n            end else if (m_rvalid_reg && m_axil_rready) begin\n                m_rvalid_reg <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronize rvalid and rdata/rresp to S side\n    reg [1:0] rvalid_sync;\n    always @(posedge s_clk) begin\n        rvalid_sync <= {rvalid_sync[0], m_rvalid_reg};\n    end\n    wire rvalid_s = rvalid_sync[1];\n\n    reg [DATA_WIDTH-1:0] rdata_sync;\n    reg [1:0]            rresp_sync;\n    always @(posedge s_clk) begin\n        if (rvalid_s) begin\n            rdata_sync <= m_rdata_reg;\n            rresp_sync <= m_rresp_reg;\n        end\n    end\n\n    assign s_axil_rdata  = rdata_sync;\n    assign s_axil_rresp  = rresp_sync;\n    assign s_axil_rvalid = rvalid_s;\n\nendmodule\n```<|im_end|>",
