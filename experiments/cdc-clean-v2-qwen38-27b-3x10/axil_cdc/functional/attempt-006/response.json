  "text": "```verilog\nmodule axil_cdc #\n(\n    parameter DATA_WIDTH = 32,\n    parameter ADDR_WIDTH = 32,\n    parameter STRB_WIDTH = (DATA_WIDTH/8)\n)\n(\n    /*\n     * AXI lite slave interface\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_awaddr,\n    input  wire [2:0]             s_axil_awprot,\n    input  wire                   s_axil_awvalid,\n    output wire                   s_axil_awready,\n    input  wire [DATA_WIDTH-1:0]  s_axil_wdata,\n    input  wire [STRB_WIDTH-1:0]  s_axil_wstrb,\n    input  wire                   s_axil_wvalid,\n    output wire                   s_axil_wready,\n    output wire [1:0]             s_axil_bresp,\n    output wire                   s_axil_bvalid,\n    input  wire                   s_axil_bready,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_araddr,\n    input  wire [2:0]             s_axil_arprot,\n    input  wire                   s_axil_arvalid,\n    output wire                   s_axil_arready,\n    output wire [DATA_WIDTH-1:0]  s_axil_rdata,\n    output wire [1:0]             s_axil_rresp,\n    output wire                   s_axil_rvalid,\n    input  wire                   s_axil_rready,\n    /*\n     * AXI lite master interface\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [ADDR_WIDTH-1:0]  m_axil_awaddr,\n    output wire [2:0]             m_axil_awprot,\n    output wire                   m_axil_awvalid,\n    input  wire                   m_axil_awready,\n    output wire [DATA_WIDTH-1:0]  m_axil_wdata,\n    output wire [STRB_WIDTH-1:0]  m_axil_wstrb,\n    output wire                   m_axil_wvalid,\n    input  wire                   m_axil_wready,\n    input  wire [1:0]             m_axil_bresp,\n    input  wire                   m_axil_bvalid,\n    output wire                   m_axil_bready,\n    output wire [ADDR_WIDTH-1:0]  m_axil_araddr,\n    output wire [2:0]             m_axil_arprot,\n    output wire                   m_axil_arvalid,\n    input  wire                   m_axil_arready,\n    input  wire [DATA_WIDTH-1:0]  m_axil_rdata,\n    input  wire [1:0]             m_axil_rresp,\n    input  wire                   m_axil_rvalid,\n    output wire                   m_axil_rready\n);\n\n    // ========================================================================\n    // Write Address Channel (AW) - Slave to Master\n    // ========================================================================\n    reg [ADDR_WIDTH-1:0] aw_addr_reg;\n    reg [2:0]            aw_prot_reg;\n    reg                  aw_valid_reg;\n    reg                  aw_ready_reg;\n\n    // 2-FF synchronizer for aw_valid\n    reg [1:0] aw_valid_sync;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            aw_valid_sync <= 2'b00;\n        else\n            aw_valid_sync <= {aw_valid_sync[0], aw_valid_reg};\n    end\n\n    // 2-FF synchronizer for aw_ready\n    reg [1:0] aw_ready_sync;\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            aw_ready_sync <= 2'b00;\n        else\n            aw_ready_sync <= {aw_ready_sync[0], aw_ready_reg};\n    end\n\n    // Master side AW logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            aw_valid_reg <= 1'b0;\n            aw_ready_reg <= 1'b0;\n            aw_addr_reg  <= {ADDR_WIDTH{1'b0}};\n            aw_prot_reg  <= 3'b000;\n        end else begin\n            if (aw_valid_sync[1] && m_axil_awready) begin\n                aw_valid_reg <= 1'b0;\n            end else if (!aw_valid_reg) begin\n                // Capture from slave side when slave indicates valid\n                // We need to know when slave has valid AW\n                // Use a separate mechanism: slave sets aw_valid_reg via a pulse\n                // Actually, let's use a different approach:\n                // Slave side captures AW when s_axil_awvalid && s_axil_awready\n                // Then sets a flag that gets synchronized to master\n            end\n        end\n    end\n\n    // Let me redesign this more carefully.\n    // \n    // Strategy:\n    // 1. Slave side: When s_axil_awvalid && s_axil_awready, capture AW data and set a \"pending\" flag.\n    //    s_axil_awready is high when no transaction is in flight (i.e., master hasn't accepted yet).\n    // 2. The pending flag is synchronized to master clock domain.\n    // 3. Master side: When pending flag is high, drive m_axil_awvalid. When m_axil_awready, clear pending.\n    // 4. Similarly for W, B, AR, R channels.\n    //\n    // For simplicity and correctness, I'll use a simple handshake with synchronizers.\n\n    // Let me restart with a cleaner design.\n\n    // ========================================================================\n    // AW Channel: Slave -> Master\n    // ========================================================================\n    // Slave side: capture AW when valid && ready\n    // aw_ready is high when we're not in the middle of forwarding an AW transaction\n    \n    reg aw_pending;  // Set when slave captures AW, cleared when master accepts\n    \n    // Slave side AW ready: high when not pending\n    assign s_axil_awready = ~aw_pending;\n    \n    // Capture AW data on slave clock\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            aw_pending  <= 1'b0;\n            aw_addr_reg <= {ADDR_WIDTH{1'b0}};\n            aw_prot_reg <= 3'b000;\n        end else if (s_axil_awvalid && s_axil_awready) begin\n            aw_pending  <= 1'b1;\n            aw_addr_reg <= s_axil_awaddr;\n            aw_prot_reg <= s_axil_awprot;\n        end\n    end\n    \n    // Synchronize aw_pending to master clock\n    reg [1:0] aw_pending_sync;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            aw_pending_sync <= 2'b00;\n        else\n            aw_pending_sync <= {aw_pending_sync[0], aw_pending};\n    end\n    \n    // Master side: drive AW when pending is synchronized\n    assign m_axil_awvalid = aw_pending_sync[1];\n    assign m_axil_awaddr  = aw_addr_reg;\n    assign m_axil_awprot  = aw_prot_reg;\n    \n    // Clear pending when master accepts\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            aw_pending <= 1'b0;\n        else if (aw_pending_sync[1] && m_axil_awready)\n            aw_pending <= 1'b0;\n    end\n\n    // ========================================================================\n    // W Channel: Slave -> Master\n    // ========================================================================\n    reg w_pending;\n    \n    assign s_axil_wready = ~w_pending;\n    \n    reg [DATA_WIDTH-1:0] w_data_reg;\n    reg [STRB_WIDTH-1:0] w_strb_reg;\n    \n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_pending  <= 1'b0;\n            w_data_reg <= {DATA_WIDTH{1'b0}};\n            w_strb_reg <= {STRB_WIDTH{1'b0}};\n        end else if (s_axil_wvalid && s_axil_wready) begin\n            w_pending  <= 1'b1;\n            w_data_reg <= s_axil_wdata;\n            w_strb_reg <= s_axil_wstrb;\n        end\n    end\n    \n    reg [1:0] w_pending_sync;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            w_pending_sync <= 2'b00;\n        else\n            w_pending_sync <= {w_pending_sync[0], w_pending};\n    end\n    \n    assign m_axil_wvalid = w_pending_sync[1];\n    assign m_axil_wdata  = w_data_reg;\n    assign m_axil_wstrb  = w_strb_reg;\n    \n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            w_pending <= 1'b0;\n        else if (w_pending_sync[1] && m_axil_wready)\n            w_pending <= 1'b0;\n    end\n\n    // ========================================================================\n    // B Channel: Master -> Slave\n    // ========================================================================\n    reg b_pending;\n    \n    // Master side: capture B when valid && ready\n    // m_axil_bready is high when we're ready to accept B response\n    assign m_axil_bready = ~b_pending;\n    \n    reg [1:0] b_resp_reg;\n    \n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            b_pending  <= 1'b0;\n            b_resp_reg <= 2'b00;\n        end else if (m_axil_bvalid && m_axil_bready) begin\n            b_pending  <= 1'b1;\n            b_resp_reg <= m_axil_bresp;\n        end\n    end\n    \n    // Synchronize b_pending to slave clock\n    reg [1:0] b_pending_sync;\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            b_pending_sync <= 2'b00;\n        else\n            b_pending_sync <= {b_pending_sync[0], b_pending};\n    end\n    \n    assign s_axil_bvalid = b_pending_sync[1];\n    assign s_axil_bresp  = b_resp_reg;\n    \n    // Clear pending when slave accepts\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            b_pending <= 1'b0;\n        else if (b_pending_sync[1] && s_axil_bready)\n            b_pending <= 1'b0;\n    end\n\n    // ========================================================================\n    // AR Channel: Slave -> Master\n    // ========================================================================\n    reg ar_pending;\n    \n    assign s_axil_arready = ~ar_pending;\n    \n    reg [ADDR_WIDTH-1:0] ar_addr_reg;\n    reg [2:0]            ar_prot_reg;\n    \n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            ar_pending  <= 1'b0;\n            ar_addr_reg <= {ADDR_WIDTH{1'b0}};\n            ar_prot_reg <= 3'b000;\n        end else if (s_axil_arvalid && s_axil_arready) begin\n            ar_pending  <= 1'b1;\n            ar_addr_reg <= s_axil_araddr;\n            ar_prot_reg <= s_axil_arprot;\n        end\n    end\n    \n    reg [1:0] ar_pending_sync;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            ar_pending_sync <= 2'b00;\n        else\n            ar_pending_sync <= {ar_pending_sync[0], ar_pending};\n    end\n    \n    assign m_axil_arvalid = ar_pending_sync[1];\n    assign m_axil_araddr  = ar_addr_reg;\n    assign m_axil_arprot  = ar_prot_reg;\n    \n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            ar_pending <= 1'b0;\n        else if (ar_pending_sync[1] && m_axil_arready)\n            ar_pending <= 1'b0;\n    end\n\n    // ========================================================================\n    // R Channel: Master -> Slave\n    // ========================================================================\n    reg r_pending;\n    \n    assign m_axil_rready = ~r_pending;\n    \n    reg [DATA_WIDTH-1:0] r_data_reg;\n    reg [1:0]            r_resp_reg;\n    \n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_pending  <= 1'b0;\n            r_data_reg <= {DATA_WIDTH{1'b0}};\n            r_resp_reg <= 2'b00;\n        end else if (m_axil_rvalid && m_axil_rready) begin\n            r_pending  <= 1'b1;\n            r_data_reg <= m_axil_rdata;\n            r_resp_reg <= m_axil_rresp;\n        end\n    end\n    \n    reg [1:0] r_pending_sync;\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            r_pending_sync <= 2'b00;\n        else\n            r_pending_sync <= {r_pending_sync[0], r_pending};\n    end\n    \n    assign s_axil_rvalid = r_pending_sync[1];\n    assign s_axil_rdata  = r_data_reg;\n    assign s_axil_rresp  = r_resp_reg;\n    \n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            r_pending <= 1'b0;\n        else if (r_pending_sync[1] && s_axil_rready)\n            r_pending <= 1'b0;\n    end\n\nendmodule\n```<|im_end|>",
