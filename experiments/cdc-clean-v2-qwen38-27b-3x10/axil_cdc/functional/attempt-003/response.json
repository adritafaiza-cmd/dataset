  "text": "```verilog\nmodule axil_cdc #\n(\n    parameter DATA_WIDTH = 32,\n    parameter ADDR_WIDTH = 32,\n    parameter STRB_WIDTH = (DATA_WIDTH/8)\n)\n(\n    /*\n     * AXI lite slave interface\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_awaddr,\n    input  wire [2:0]             s_axil_awprot,\n    input  wire                   s_axil_awvalid,\n    output wire                   s_axil_awready,\n    input  wire [DATA_WIDTH-1:0]  s_axil_wdata,\n    input  wire [STRB_WIDTH-1:0]  s_axil_wstrb,\n    input  wire                   s_axil_wvalid,\n    output wire                   s_axil_wready,\n    output wire [1:0]             s_axil_bresp,\n    output wire                   s_axil_bvalid,\n    input  wire                   s_axil_bready,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_araddr,\n    input  wire [2:0]             s_axil_arprot,\n    input  wire                   s_axil_arvalid,\n    output wire                   s_axil_arready,\n    output wire [DATA_WIDTH-1:0]  s_axil_rdata,\n    output wire [1:0]             s_axil_rresp,\n    output wire                   s_axil_rvalid,\n    input  wire                   s_axil_rready,\n    /*\n     * AXI lite master interface\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [ADDR_WIDTH-1:0]  m_axil_awaddr,\n    output wire [2:0]             m_axil_awprot,\n    output wire                   m_axil_awvalid,\n    input  wire                   m_axil_awready,\n    output wire [DATA_WIDTH-1:0]  m_axil_wdata,\n    output wire [STRB_WIDTH-1:0]  m_axil_wstrb,\n    output wire                   m_axil_wvalid,\n    input  wire                   m_axil_wready,\n    input  wire [1:0]             m_axil_bresp,\n    input  wire                   m_axil_bvalid,\n    output wire                   m_axil_bready,\n    output wire [ADDR_WIDTH-1:0]  m_axil_araddr,\n    output wire [2:0]             m_axil_arprot,\n    output wire                   m_axil_arvalid,\n    input  wire                   m_axil_arready,\n    input  wire [DATA_WIDTH-1:0]  m_axil_rdata,\n    input  wire [1:0]             m_axil_rresp,\n    input  wire                   m_axil_rvalid,\n    output wire                   m_axil_rready\n);\n\n    // ========================================================================\n    // Write Address Channel (AW) - Slave to Master\n    // ========================================================================\n    // Slave side: capture AW when valid and ready\n    reg  [ADDR_WIDTH-1:0] s_awaddr_reg;\n    reg  [2:0]            s_awprot_reg;\n    reg                   s_aw_valid_reg;\n    reg                   s_aw_ready_reg;\n\n    // Master side: register AW data\n    reg  [ADDR_WIDTH-1:0] m_awaddr_reg;\n    reg  [2:0]            m_awprot_reg;\n    reg                   m_aw_valid_reg;\n    reg                   m_aw_ready_reg;\n\n    // Handshake signals\n    wire s_aw_handshake = s_axil_awvalid & s_axil_awready;\n    wire m_aw_handshake = m_axil_awvalid & m_axil_awready;\n\n    // Slave side AW logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_aw_valid_reg <= 1'b0;\n            s_aw_ready_reg <= 1'b1;\n        end else begin\n            if (s_aw_handshake) begin\n                s_awaddr_reg <= s_axil_awaddr;\n                s_awprot_reg <= s_axil_awprot;\n                s_aw_valid_reg <= 1'b1;\n                s_aw_ready_reg <= 1'b0;\n            end else if (s_aw_ready_reg == 1'b0 && m_aw_ready_reg == 1'b1) begin\n                s_aw_ready_reg <= 1'b1;\n            end\n        end\n    end\n\n    assign s_axil_awready = s_aw_ready_reg;\n\n    // Master side AW logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_aw_valid_reg <= 1'b0;\n            m_aw_ready_reg <= 1'b1;\n        end else begin\n            if (m_aw_handshake) begin\n                m_aw_valid_reg <= 1'b0;\n                m_aw_ready_reg <= 1'b1;\n            end else if (m_aw_valid_reg == 1'b0 && s_aw_valid_reg == 1'b1) begin\n                m_awaddr_reg <= s_awaddr_reg;\n                m_awprot_reg <= s_awprot_reg;\n                m_aw_valid_reg <= 1'b1;\n                m_aw_ready_reg <= 1'b0;\n            end\n        end\n    end\n\n    assign m_axil_awaddr  = m_awaddr_reg;\n    assign m_axil_awprot  = m_awprot_reg;\n    assign m_axil_awvalid = m_aw_valid_reg;\n\n    // ========================================================================\n    // Write Data Channel (W) - Slave to Master\n    // ========================================================================\n    // Slave side: capture W when valid and ready\n    reg  [DATA_WIDTH-1:0] s_wdata_reg;\n    reg  [STRB_WIDTH-1:0] s_wstrb_reg;\n    reg                   s_w_valid_reg;\n    reg                   s_w_ready_reg;\n\n    // Master side: register W data\n    reg  [DATA_WIDTH-1:0] m_wdata_reg;\n    reg  [STRB_WIDTH-1:0] m_wstrb_reg;\n    reg                   m_w_valid_reg;\n    reg                   m_w_ready_reg;\n\n    // Handshake signals\n    wire s_w_handshake = s_axil_wvalid & s_axil_wready;\n    wire m_w_handshake = m_axil_wvalid & m_axil_wready;\n\n    // Slave side W logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_w_valid_reg <= 1'b0;\n            s_w_ready_reg <= 1'b1;\n        end else begin\n            if (s_w_handshake) begin\n                s_wdata_reg <= s_axil_wdata;\n                s_wstrb_reg <= s_axil_wstrb;\n                s_w_valid_reg <= 1'b1;\n                s_w_ready_reg <= 1'b0;\n            end else if (s_w_ready_reg == 1'b0 && m_w_ready_reg == 1'b1) begin\n                s_w_ready_reg <= 1'b1;\n            end\n        end\n    end\n\n    assign s_axil_wready = s_w_ready_reg;\n\n    // Master side W logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_w_valid_reg <= 1'b0;\n            m_w_ready_reg <= 1'b1;\n        end else begin\n            if (m_w_handshake) begin\n                m_w_valid_reg <= 1'b0;\n                m_w_ready_reg <= 1'b1;\n            end else if (m_w_valid_reg == 1'b0 && s_w_valid_reg == 1'b1) begin\n                m_wdata_reg <= s_wdata_reg;\n                m_wstrb_reg <= s_wstrb_reg;\n                m_w_valid_reg <= 1'b1;\n                m_w_ready_reg <= 1'b0;\n            end\n        end\n    end\n\n    assign m_axil_wdata  = m_wdata_reg;\n    assign m_axil_wstrb  = m_wstrb_reg;\n    assign m_axil_wvalid = m_w_valid_reg;\n\n    // ========================================================================\n    // Write Response Channel (B) - Master to Slave\n    // ========================================================================\n    // Master side: capture B when valid and ready\n    reg  [1:0] m_bresp_reg;\n    reg        m_b_valid_reg;\n    reg        m_b_ready_reg;\n\n    // Slave side: register B data\n    reg  [1:0] s_bresp_reg;\n    reg        s_b_valid_reg;\n    reg        s_b_ready_reg;\n\n    // Handshake signals\n    wire m_b_handshake = m_axil_bvalid & m_axil_bready;\n    wire s_b_handshake = s_axil_bvalid & s_axil_bready;\n\n    // Master side B logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_b_valid_reg <= 1'b0;\n            m_b_ready_reg <= 1'b1;\n        end else begin\n            if (m_b_handshake) begin\n                m_bresp_reg <= m_axil_bresp;\n                m_b_valid_reg <= 1'b1;\n                m_b_ready_reg <= 1'b0;\n            end else if (m_b_ready_reg == 1'b0 && s_b_ready_reg == 1'b1) begin\n                m_b_ready_reg <= 1'b1;\n            end\n        end\n    end\n\n    assign m_axil_bready = m_b_ready_reg;\n\n    // Slave side B logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_b_valid_reg <= 1'b0;\n            s_b_ready_reg <= 1'b1;\n        end else begin\n            if (s_b_handshake) begin\n                s_b_valid_reg <= 1'b0;\n                s_b_ready_reg <= 1'b1;\n            end else if (s_b_valid_reg == 1'b0 && m_b_valid_reg == 1'b1) begin\n                s_bresp_reg <= m_bresp_reg;\n                s_b_valid_reg <= 1'b1;\n                s_b_ready_reg <= 1'b0;\n            end\n        end\n    end\n\n    assign s_axil_bresp  = s_bresp_reg;\n    assign s_axil_bvalid = s_b_valid_reg;\n\n    // ========================================================================\n    // Read Address Channel (AR) - Slave to Master\n    // ========================================================================\n    // Slave side: capture AR when valid and ready\n    reg  [ADDR_WIDTH-1:0] s_araddr_reg;\n    reg  [2:0]            s_arprot_reg;\n    reg                   s_ar_valid_reg;\n    reg                   s_ar_ready_reg;\n\n    // Master side: register AR data\n    reg  [ADDR_WIDTH-1:0] m_araddr_reg;\n    reg  [2:0]            m_arprot_reg;\n    reg                   m_ar_valid_reg;\n    reg                   m_ar_ready_reg;\n\n    // Handshake signals\n    wire s_ar_handshake = s_axil_arvalid & s_axil_arready;\n    wire m_ar_handshake = m_axil_arvalid & m_axil_arready;\n\n    // Slave side AR logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_ar_valid_reg <= 1'b0;\n            s_ar_ready_reg <= 1'b1;\n        end else begin\n            if (s_ar_handshake) begin\n                s_araddr_reg <= s_axil_araddr;\n                s_arprot_reg <= s_axil_arprot;\n                s_ar_valid_reg <= 1'b1;\n                s_ar_ready_reg <= 1'b0;\n            end else if (s_ar_ready_reg == 1'b0 && m_ar_ready_reg == 1'b1) begin\n                s_ar_ready_reg <= 1'b1;\n            end\n        end\n    end\n\n    assign s_axil_arready = s_ar_ready_reg;\n\n    // Master side AR logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_ar_valid_reg <= 1'b0;\n            m_ar_ready_reg <= 1'b1;\n        end else begin\n            if (m_ar_handshake) begin\n                m_ar_valid_reg <= 1'b0;\n                m_ar_ready_reg <= 1'b1;\n            end else if (m_ar_valid_reg == 1'b0 && s_ar_valid_reg == 1'b1) begin\n                m_araddr_reg <= s_araddr_reg;\n                m_arprot_reg <= s_arprot_reg;\n                m_ar_valid_reg <= 1'b1;\n                m_ar_ready_reg <= 1'b0;\n            end\n        end\n    end\n\n    assign m_axil_araddr  = m_araddr_reg;\n    assign m_axil_arprot  = m_arprot_reg;\n    assign m_axil_arvalid = m_ar_valid_reg;\n\n    // ========================================================================\n    // Read Data Channel (R) - Master to Slave\n    // ========================================================================\n    // Master side: capture R when valid and ready\n    reg  [DATA_WIDTH-1:0] m_rdata_reg;\n    reg  [1:0]            m_rresp_reg;\n    reg                   m_r_valid_reg;\n    reg                   m_r_ready_reg;\n\n    // Slave side: register R data\n    reg  [DATA_WIDTH-1:0] s_rdata_reg;\n    reg  [1:0]            s_rresp_reg;\n    reg                   s_r_valid_reg;\n    reg                   s_r_ready_reg;\n\n    // Handshake signals\n    wire m_r_handshake = m_axil_rvalid & m_axil_rready;\n    wire s_r_handshake = s_axil_rvalid & s_axil_rready;\n\n    // Master side R logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_r_valid_reg <= 1'b0;\n            m_r_ready_reg <= 1'b1;\n        end else begin\n            if (m_r_handshake) begin\n                m_rdata_reg <= m_axil_rdata;\n                m_rresp_reg <= m_axil_rresp;\n                m_r_valid_reg <= 1'b1;\n                m_r_ready_reg <= 1'b0;\n            end else if (m_r_ready_reg == 1'b0 && s_r_ready_reg == 1'b1) begin\n                m_r_ready_reg <= 1'b1;\n            end\n        end\n    end\n\n    assign m_axil_rready = m_r_ready_reg;\n\n    // Slave side R logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_r_valid_reg <= 1'b0;\n            s_r_ready_reg <= 1'b1;\n        end else begin\n            if (s_r_handshake) begin\n                s_r_valid_reg <= 1'b0;\n                s_r_ready_reg <= 1'b1;\n            end else if (s_r_valid_reg == 1'b0 && m_r_valid_reg == 1'b1) begin\n                s_rdata_reg <= m_rdata_reg;\n                s_rresp_reg <= m_rresp_reg;\n                s_r_valid_reg <= 1'b1;\n                s_r_ready_reg <= 1'b0;\n            end\n        end\n    end\n\n    assign s_axil_rdata  = s_rdata_reg;\n    assign s_axil_rresp  = s_rresp_reg;\n    assign s_axil_rvalid = s_r_valid_reg;\n\nendmodule\n```<|im_end|>",
