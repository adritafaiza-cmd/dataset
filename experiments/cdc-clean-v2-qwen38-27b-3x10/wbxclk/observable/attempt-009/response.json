  "text": "```verilog\nmodule\twbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_WIDTH = AW + DW + DW/8 + 1; // addr + data + sel + we\n\tlocalparam CNT_WIDTH  = LGFIFO + 1;\n\n\t// Request FIFO: WB -> XCLK\n\treg [FIFO_WIDTH-1:0] req_fifo [0:FIFO_DEPTH-1];\n\treg [LGFIFO-1:0]     req_wr_ptr, req_rd_ptr;\n\treg [CNT_WIDTH-1:0]  req_count;\n\n\t// Response FIFO: XCLK -> WB\n\treg [DW+1:0] resp_fifo [0:FIFO_DEPTH-1]; // data + err\n\treg [LGFIFO-1:0]     resp_wr_ptr, resp_rd_ptr;\n\treg [CNT_WIDTH-1:0]  resp_count;\n\n\t// Synchronizers for request FIFO pointers\n\treg [LGFIFO-1:0] req_wr_ptr_sync1, req_wr_ptr_sync2;\n\treg [LGFIFO-1:0] req_rd_ptr_sync1, req_rd_ptr_sync2;\n\n\t// Synchronizers for response FIFO pointers\n\treg [LGFIFO-1:0] resp_wr_ptr_sync1, resp_wr_ptr_sync2;\n\treg [LGFIFO-1:0] resp_rd_ptr_sync1, resp_rd_ptr_sync2;\n\n\t// WB-side state\n\treg wb_stall_r;\n\treg wb_ack_r;\n\treg [DW-1:0] wb_data_r;\n\treg wb_err_r;\n\treg wb_resp_valid;\n\n\t// XCLK-side state\n\treg xclk_cyc_r;\n\treg xclk_stb_r;\n\treg xclk_we_r;\n\treg [AW-1:0] xclk_addr_r;\n\treg [DW-1:0] xclk_data_r;\n\treg [DW/8-1:0] xclk_sel_r;\n\treg xclk_req_valid;\n\n\t// Derived signals\n\twire req_full  = (req_count == FIFO_DEPTH[CNT_WIDTH-1:0]);\n\twire req_empty = (req_count == {CNT_WIDTH{1'b0}});\n\twire resp_full  = (resp_count == FIFO_DEPTH[CNT_WIDTH-1:0]);\n\twire resp_empty = (resp_count == {CNT_WIDTH{1'b0}});\n\n\tassign o_wb_stall = wb_stall_r;\n\tassign o_wb_ack   = wb_ack_r;\n\tassign o_wb_data  = wb_data_r;\n\tassign o_wb_err   = wb_err_r;\n\n\tassign o_xclk_cyc  = xclk_cyc_r;\n\tassign o_xclk_stb  = xclk_stb_r;\n\tassign o_xclk_we   = xclk_we_r;\n\tassign o_xclk_addr = xclk_addr_r;\n\tassign o_xclk_data = xclk_data_r;\n\tassign o_xclk_sel  = xclk_sel_r;\n\n\t// WB clock domain: request FIFO write\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr <= {LGFIFO{1'b0}};\n\t\t\treq_count  <= {CNT_WIDTH{1'b0}};\n\t\t\twb_stall_r <= 1'b1;\n\t\t\twb_ack_r   <= 1'b0;\n\t\t\twb_data_r  <= {DW{1'b0}};\n\t\t\twb_err_r   <= 1'b0;\n\t\t\twb_resp_valid <= 1'b0;\n\t\tend else begin\n\t\t\t// Response FIFO read (WB side)\n\t\t\tif (!resp_empty && !wb_resp_valid) begin\n\t\t\t\twb_resp_valid <= 1'b1;\n\t\t\t\twb_data_r     <= resp_fifo[resp_rd_ptr][DW:0];\n\t\t\t\twb_err_r      <= resp_fifo[resp_rd_ptr][DW];\n\t\t\t\tresp_rd_ptr   <= resp_rd_ptr + 1'b1;\n\t\t\t\tresp_count    <= resp_count - 1'b1;\n\t\t\tend else if (wb_resp_valid) begin\n\t\t\t\twb_ack_r      <= 1'b1;\n\t\t\t\twb_resp_valid <= 1'b0;\n\t\t\tend else begin\n\t\t\t\twb_ack_r <= 1'b0;\n\t\t\tend\n\n\t\t\t// Request FIFO write (WB side)\n\t\t\tif (i_wb_cyc && i_wb_stb && !req_full) begin\n\t\t\t\treq_fifo[req_wr_ptr] <= {i_wb_we, i_wb_addr, i_wb_data, i_wb_sel};\n\t\t\t\treq_wr_ptr <= req_wr_ptr + 1'b1;\n\t\t\t\treq_count  <= req_count + 1'b1;\n\t\t\tend\n\n\t\t\t// Stall: full request FIFO or response FIFO full (can't accept new if resp full)\n\t\t\twb_stall_r <= req_full || resp_full;\n\t\tend\n\tend\n\n\t// XCLK clock domain: request FIFO read, response FIFO write\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr   <= {LGFIFO{1'b0}};\n\t\t\tresp_wr_ptr  <= {LGFIFO{1'b0}};\n\t\t\tresp_count   <= {CNT_WIDTH{1'b0}};\n\t\t\txclk_cyc_r   <= 1'b0;\n\t\t\txclk_stb_r   <= 1'b0;\n\t\t\txclk_we_r    <= 1'b0;\n\t\t\txclk_addr_r  <= {AW{1'b0}};\n\t\t\txclk_data_r  <= {DW{1'b0}};\n\t\t\txclk_sel_r   <= {(DW/8){1'b0}};\n\t\t\txclk_req_valid <= 1'b0;\n\t\tend else begin\n\t\t\t// Response FIFO write (XCLK side)\n\t\t\tif (i_xclk_ack && !resp_full) begin\n\t\t\t\tresp_fifo[resp_wr_ptr] <= {i_xclk_err, i_xclk_data};\n\t\t\t\tresp_wr_ptr <= resp_wr_ptr + 1'b1;\n\t\t\t\tresp_count  <= resp_count + 1'b1;\n\t\t\tend\n\n\t\t\t// Request FIFO read (XCLK side)\n\t\t\tif (!req_empty && !xclk_req_valid && !i_xclk_stall) begin\n\t\t\t\txclk_req_valid <= 1'b1;\n\t\t\t\txclk_we_r      <= req_fifo[req_rd_ptr][FIFO_WIDTH-1];\n\t\t\t\txclk_addr_r    <= req_fifo[req_rd_ptr][FIFO_WIDTH-2:FIFO_WIDTH-1-AW];\n\t\t\t\txclk_data_r    <= req_fifo[req_rd_ptr][FIFO_WIDTH-1-AW:FIFO_WIDTH-1-AW-DW];\n\t\t\t\txclk_sel_r     <= req_fifo[req_rd_ptr][FIFO_WIDTH-1-AW-DW-1:0];\n\t\t\t\treq_rd_ptr     <= req_rd_ptr + 1'b1;\n\t\t\t\treq_count      <= req_count - 1'b1;\n\t\t\tend else if (xclk_req_valid && !i_xclk_stall) begin\n\t\t\t\txclk_cyc_r     <= 1'b1;\n\t\t\t\txclk_stb_r     <= 1'b1;\n\t\t\tend else if (xclk_req_valid && i_xclk_ack) begin\n\t\t\t\txclk_req_valid <= 1'b0;\n\t\t\t\txclk_cyc_r     <= 1'b0;\n\t\t\t\txclk_stb_r     <= 1'b0;\n\t\t\tend else if (xclk_req_valid) begin\n\t\t\t\t// Stalled, hold\n\t\t\tend else begin\n\t\t\t\txclk_cyc_r <= 1'b0;\n\t\t\t\txclk_stb_r <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Synchronizers: WB -> XCLK (request write pointer)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr_sync1 <= {LGFIFO{1'b0}};\n\t\t\treq_wr_ptr_sync2 <= {LGFIFO{1'b0}};\n\t\tend else begin\n\t\t\treq_wr_ptr_sync1 <= req_wr_ptr;\n\t\t\treq_wr_ptr_sync2 <= req_wr_ptr_sync1;\n\t\tend\n\tend\n\n\t// Synchronizers: XCLK -> WB (request read pointer)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr_sync1 <= {LGFIFO{1'b0}};\n\t\t\treq_rd_ptr_sync2 <= {LGFIFO{1'b0}};\n\t\tend else begin\n\t\t\treq_rd_ptr_sync1 <= req_rd_ptr;\n\t\t\treq_rd_ptr_sync2 <= req_rd_ptr_sync1;\n\t\tend\n\tend\n\n\t// Synchronizers: XCLK -> WB (response write pointer)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tresp_wr_ptr_sync1 <= {LGFIFO{1'b0}};\n\t\t\tresp_wr_ptr_sync2 <= {LGFIFO{1'b0}};\n\t\tend else begin\n\t\t\tresp_wr_ptr_sync1 <= resp_wr_ptr;\n\t\t\tresp_wr_ptr_sync2 <= resp_wr_ptr_sync1;\n\t\tend\n\tend\n\n\t// Synchronizers: WB -> XCLK (response read pointer)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tresp_rd_ptr_sync1 <= {LGFIFO{1'b0}};\n\t\t\tresp_rd_ptr_sync2 <= {LGFIFO{1'b0}};\n\t\tend else begin\n\t\t\tresp_rd_ptr_sync1 <= resp_rd_ptr;\n\t\t\tresp_rd_ptr_sync2 <= resp_rd_ptr_sync1;\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
