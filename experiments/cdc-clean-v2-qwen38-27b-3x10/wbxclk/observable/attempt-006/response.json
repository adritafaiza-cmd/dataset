  "text": "```verilog\nmodule wbxclk #(\n\tparameter\tAW=32,\n\t\t\tDW=32,\n\t\t\tLGFIFO = 5\n) (\n\tinput\twire\t\t\ti_wb_clk, i_reset,\n\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\toutput\twire\t\t\to_wb_stall,\n\toutput\treg\t\t\to_wb_ack,\n\toutput\treg\t[(DW/8-1):0]\to_wb_data,\n\toutput\treg\t\t\to_wb_err,\n\tinput\twire\t\t\ti_xclk_clk,\n\toutput\treg\t\t\to_xclk_cyc,\n\toutput\treg\t\t\to_xclk_stb,\n\toutput\treg\t\t\to_xclk_we,\n\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\tinput\twire\t\t\ti_xclk_stall,\n\tinput\twire\t\t\ti_xclk_ack,\n\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\tinput\twire\t\t\ti_xclk_err\n);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_WIDTH = AW + DW + (DW/8) + 1; // addr + data + sel + we\n\tlocalparam FIFO_ADDR_W = LGFIFO;\n\n\t// Request FIFO: WB side writes, XCLK side reads\n\treg [FIFO_WIDTH-1:0] req_fifo [0:FIFO_DEPTH-1];\n\treg [FIFO_ADDR_W:0] req_wr_ptr, req_rd_ptr;\n\twire req_full = (req_wr_ptr[FIFO_ADDR_W] != req_rd_ptr[FIFO_ADDR_W]) &&\n\t                 (req_wr_ptr[FIFO_ADDR_W-1:0] == req_rd_ptr[FIFO_ADDR_W-1:0]);\n\twire req_empty = (req_wr_ptr == req_rd_ptr);\n\n\t// Response FIFO: XCLK side writes, WB side reads\n\treg [DW+1:0] rsp_fifo [0:FIFO_DEPTH-1]; // data + err\n\treg [FIFO_ADDR_W:0] rsp_wr_ptr, rsp_rd_ptr;\n\twire rsp_full = (rsp_wr_ptr[FIFO_ADDR_W] != rsp_rd_ptr[FIFO_ADDR_W]) &&\n\t                 (rsp_wr_ptr[FIFO_ADDR_W-1:0] == rsp_rd_ptr[FIFO_ADDR_W-1:0]);\n\twire rsp_empty = (rsp_wr_ptr == rsp_rd_ptr);\n\n\t// WB side: accept request if not full\n\twire wb_accept = i_wb_cyc && i_wb_stb && !req_full;\n\tassign o_wb_stall = req_full;\n\n\t// WB side: write to request FIFO\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr <= 0;\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend else begin\n\t\t\tif (wb_accept) begin\n\t\t\t\treq_fifo[req_wr_ptr[FIFO_ADDR_W-1:0]] <= {i_wb_we, i_wb_addr, i_wb_data, i_wb_sel};\n\t\t\t\treq_wr_ptr <= req_wr_ptr + 1;\n\t\t\tend\n\t\t\t// WB response output\n\t\t\tif (!rsp_empty) begin\n\t\t\t\to_wb_ack <= 1;\n\t\t\t\to_wb_data <= rsp_fifo[rsp_rd_ptr[FIFO_ADDR_W-1:0]][DW:0];\n\t\t\t\to_wb_err <= rsp_fifo[rsp_rd_ptr[FIFO_ADDR_W-1:0]][DW+1];\n\t\t\t\trsp_rd_ptr <= rsp_rd_ptr + 1;\n\t\t\tend else begin\n\t\t\t\to_wb_ack <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// XCLK side: read from request FIFO and drive Wishbone\n\treg xclk_active;\n\treg [FIFO_WIDTH-1:0] xclk_req_reg;\n\treg xclk_req_valid;\n\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr <= 0;\n\t\t\trsp_wr_ptr <= 0;\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\t\txclk_active <= 0;\n\t\t\txclk_req_valid <= 0;\n\t\t\txclk_req_reg <= 0;\n\t\tend else begin\n\t\t\t// If not active and FIFO not empty, load next request\n\t\t\tif (!xclk_active && !req_empty) begin\n\t\t\t\txclk_req_reg <= req_fifo[req_rd_ptr[FIFO_ADDR_W-1:0]];\n\t\t\t\treq_rd_ptr <= req_rd_ptr + 1;\n\t\t\t\txclk_req_valid <= 1;\n\t\t\tend\n\n\t\t\t// Drive Wishbone signals\n\t\t\tif (xclk_req_valid) begin\n\t\t\t\to_xclk_cyc <= 1;\n\t\t\t\to_xclk_stb <= 1;\n\t\t\t\to_xclk_we <= xclk_req_reg[FIFO_WIDTH-1];\n\t\t\t\to_xclk_addr <= xclk_req_reg[FIFO_WIDTH-2:FIFO_WIDTH-1-DW];\n\t\t\t\to_xclk_data <= xclk_req_reg[FIFO_WIDTH-1-DW:FIFO_WIDTH-1-DW-(DW/8)];\n\t\t\t\to_xclk_sel <= xclk_req_reg[FIFO_WIDTH-1-DW-(DW/8)-1:0];\n\t\t\tend else begin\n\t\t\t\to_xclk_cyc <= 0;\n\t\t\t\to_xclk_stb <= 0;\n\t\t\tend\n\n\t\t\t// Handle ACK\n\t\t\tif (xclk_req_valid && i_xclk_ack) begin\n\t\t\t\t// Write response to FIFO\n\t\t\t\tif (!rsp_full) begin\n\t\t\t\t\trsp_fifo[rsp_wr_ptr[FIFO_ADDR_W-1:0]] <= {i_xclk_err, i_xclk_data};\n\t\t\t\t\trsp_wr_ptr <= rsp_wr_ptr + 1;\n\t\t\t\tend\n\t\t\t\txclk_req_valid <= 0;\n\t\t\tend\n\n\t\t\t// Handle error abort: if error and not ack, cancel\n\t\t\tif (xclk_req_valid && i_xclk_err && !i_xclk_ack) begin\n\t\t\t\txclk_req_valid <= 0;\n\t\t\tend\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
