  "text": "```verilog\nmodule wbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_MASK  = FIFO_DEPTH - 1;\n\n\t// ------------------------------------------------------------------\n\t// Reset synchronization\n\t// ------------------------------------------------------------------\n\treg [1:0] rst_sync_wb;\n\treg [1:0] rst_sync_xclk;\n\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\trst_sync_wb <= 2'b00;\n\t\telse\n\t\t\trst_sync_wb <= {rst_sync_wb[0], 1'b1};\n\tend\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (i_reset)\n\t\t\trst_sync_xclk <= 2'b00;\n\t\telse\n\t\t\trst_sync_xclk <= {rst_sync_xclk[0], 1'b1};\n\tend\n\n\twire wb_rst_n = rst_sync_wb[1];\n\twire xclk_rst_n = rst_sync_xclk[1];\n\n\t// ------------------------------------------------------------------\n\t// Request FIFO (wb_clk domain)\n\t// ------------------------------------------------------------------\n\treg [AW-1:0] req_addr_mem [0:FIFO_DEPTH-1];\n\treg [DW-1:0] req_data_mem [0:FIFO_DEPTH-1];\n\treg [DW/8-1:0] req_sel_mem [0:FIFO_DEPTH-1];\n\treg req_we_mem [0:FIFO_DEPTH-1];\n\n\treg [LGFIFO:0] req_wr_ptr;\n\treg [LGFIFO:0] req_rd_ptr;\n\n\treg [LGFIFO:0] req_rd_ptr_sync;\n\treg [LGFIFO:0] req_rd_ptr_sync2;\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (!wb_rst_n) begin\n\t\t\treq_wr_ptr <= 0;\n\t\t\treq_rd_ptr_sync <= 0;\n\t\t\treq_rd_ptr_sync2 <= 0;\n\t\tend else begin\n\t\t\treq_rd_ptr_sync <= req_rd_ptr;\n\t\t\treq_rd_ptr_sync2 <= req_rd_ptr_sync;\n\t\tend\n\tend\n\n\t// Synchronize read pointer to xclk domain\n\treg [LGFIFO:0] req_rd_ptr_xclk;\n\treg [LGFIFO:0] req_rd_ptr_xclk2;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (!xclk_rst_n) begin\n\t\t\treq_rd_ptr_xclk <= 0;\n\t\t\treq_rd_ptr_xclk2 <= 0;\n\t\tend else begin\n\t\t\treq_rd_ptr_xclk <= req_rd_ptr_sync2;\n\t\t\treq_rd_ptr_xclk2 <= req_rd_ptr_xclk;\n\t\tend\n\tend\n\n\twire req_full = (req_wr_ptr - req_rd_ptr_sync2) == FIFO_DEPTH;\n\twire req_empty = (req_wr_ptr == req_rd_ptr_sync2);\n\n\t// Write to request FIFO\n\twire req_wr_en = i_wb_cyc & i_wb_stb & ~req_full;\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (req_wr_en) begin\n\t\t\treq_addr_mem[req_wr_ptr[LGFIFO-1:0]] <= i_wb_addr;\n\t\t\treq_data_mem[req_wr_ptr[LGFIFO-1:0]] <= i_wb_data;\n\t\t\treq_sel_mem[req_wr_ptr[LGFIFO-1:0]] <= i_wb_sel;\n\t\t\treq_we_mem[req_wr_ptr[LGFIFO-1:0]] <= i_wb_we;\n\t\t\treq_wr_ptr <= req_wr_ptr + 1;\n\t\tend\n\tend\n\n\t// ------------------------------------------------------------------\n\t// Response FIFO (xclk_clk domain)\n\t// ------------------------------------------------------------------\n\treg [DW-1:0] rsp_data_mem [0:FIFO_DEPTH-1];\n\treg rsp_err_mem [0:FIFO_DEPTH-1];\n\n\treg [LGFIFO:0] rsp_wr_ptr;\n\treg [LGFIFO:0] rsp_rd_ptr;\n\n\treg [LGFIFO:0] rsp_rd_ptr_sync;\n\treg [LGFIFO:0] rsp_rd_ptr_sync2;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (!xclk_rst_n) begin\n\t\t\trsp_wr_ptr <= 0;\n\t\t\trsp_rd_ptr_sync <= 0;\n\t\t\trsp_rd_ptr_sync2 <= 0;\n\t\tend else begin\n\t\t\trsp_rd_ptr_sync <= rsp_rd_ptr;\n\t\t\trsp_rd_ptr_sync2 <= rsp_rd_ptr_sync;\n\t\tend\n\tend\n\n\t// Synchronize read pointer to wb domain\n\treg [LGFIFO:0] rsp_rd_ptr_wb;\n\treg [LGFIFO:0] rsp_rd_ptr_wb2;\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (!wb_rst_n) begin\n\t\t\trsp_rd_ptr_wb <= 0;\n\t\t\trsp_rd_ptr_wb2 <= 0;\n\t\tend else begin\n\t\t\trsp_rd_ptr_wb <= rsp_rd_ptr_sync2;\n\t\t\trsp_rd_ptr_wb2 <= rsp_rd_ptr_wb;\n\t\tend\n\tend\n\n\twire rsp_full = (rsp_wr_ptr - rsp_rd_ptr_wb2) == FIFO_DEPTH;\n\twire rsp_empty = (rsp_wr_ptr == rsp_rd_ptr_wb2);\n\n\t// ------------------------------------------------------------------\n\t// XCLK side: read from request FIFO, drive xclk bus\n\t// ------------------------------------------------------------------\n\treg xclk_active;\n\treg [LGFIFO-1:0] xclk_rd_addr;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (!xclk_rst_n) begin\n\t\t\txclk_active <= 0;\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend else begin\n\t\t\tif (xclk_active) begin\n\t\t\t\t// Waiting for ack\n\t\t\t\tif (i_xclk_ack) begin\n\t\t\t\t\txclk_active <= 0;\n\t\t\t\t\to_xclk_cyc <= 0;\n\t\t\t\t\to_xclk_stb <= 0;\n\t\t\t\t\t// Write response to FIFO\n\t\t\t\t\tif (!rsp_full) begin\n\t\t\t\t\t\trsp_data_mem[rsp_wr_ptr[LGFIFO-1:0]] <= i_xclk_data;\n\t\t\t\t\t\trsp_err_mem[rsp_wr_ptr[LGFIFO-1:0]] <= i_xclk_err;\n\t\t\t\t\t\trsp_wr_ptr <= rsp_wr_ptr + 1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\t// Check if we can start a new transfer\n\t\t\t\tif (!req_empty && !i_xclk_stall) begin\n\t\t\t\t\txclk_active <= 1;\n\t\t\t\t\to_xclk_cyc <= 1;\n\t\t\t\t\to_xclk_stb <= 1;\n\t\t\t\t\to_xclk_we <= req_we_mem[req_rd_ptr_xclk2[LGFIFO-1:0]];\n\t\t\t\t\to_xclk_addr <= req_addr_mem[req_rd_ptr_xclk2[LGFIFO-1:0]];\n\t\t\t\t\to_xclk_data <= req_data_mem[req_rd_ptr_xclk2[LGFIFO-1:0]];\n\t\t\t\t\to_xclk_sel <= req_sel_mem[req_rd_ptr_xclk2[LGFIFO-1:0]];\n\t\t\t\t\t// Advance read pointer\n\t\t\t\t\treq_rd_ptr <= req_rd_ptr + 1;\n\t\t\t\tend else begin\n\t\t\t\t\to_xclk_cyc <= 0;\n\t\t\t\t\to_xclk_stb <= 0;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// ------------------------------------------------------------------\n\t// WB side: read from response FIFO, drive wb outputs\n\t// ------------------------------------------------------------------\n\talways @(posedge i_wb_clk) begin\n\t\tif (!wb_rst_n) begin\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend else begin\n\t\t\tif (!rsp_empty) begin\n\t\t\t\to_wb_ack <= 1;\n\t\t\t\to_wb_data <= rsp_data_mem[rsp_rd_ptr_wb2[LGFIFO-1:0]];\n\t\t\t\to_wb_err <= rsp_err_mem[rsp_rd_ptr_wb2[LGFIFO-1:0]];\n\t\t\t\trsp_rd_ptr <= rsp_rd_ptr + 1;\n\t\t\tend else begin\n\t\t\t\to_wb_ack <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// ------------------------------------------------------------------\n\t// Stall output\n\t// ------------------------------------------------------------------\n\tassign o_wb_stall = req_full;\n\nendmodule\n```<|im_end|>",
