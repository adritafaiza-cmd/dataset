c\n\twire [FIFO_PTR_W:0] wr_ptr_sync;\n\treg [FIFO_PTR_W:0] wr_ptr_sync_reg;\n\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\twr_ptr_sync_reg <= {(FIFO_PTR_W+1){1'b0}};\n\t\telse\n\t\t\twr_ptr_sync_reg <= wr_ptr;\n\tend\n\n\twire [FIFO_PTR_W:0] rd_ptr_sync;\n\treg [FIFO_PTR_W:0] rd_ptr_sync_reg;\n\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\trd_ptr_sync_reg <= {(FIFO_PTR_W+1){1'b0}};\n\t\telse\n\t\t\trd_ptr_sync_reg <= rd_ptr;\n\tend\n\n\twire fifo_full = (wr_ptr[FIFO_PTR_W] != rd_ptr_sync_reg[FIFO_PTR_W]) &&\n\t\t\t\t\t (wr_ptr[FIFO_PTR_W-1:FIFO_PTR_W-1] == rd_ptr_sync_reg[FIFO_PTR_W-1:FIFO_PTR_W-1]) &&\n\t\t\t\t\t (wr_ptr[FIFO_PTR_W-2:0] == rd_ptr_sync_reg[FIFO_PTR_W-2:0]);\n\n\t// Simplified full check: full when high bits differ and lower bits equal\n\twire fifo_full_simple = (wr_ptr[FIFO_PTR_W] != rd_ptr_sync_reg[FIFO_PTR_W]) &&\n\t\t\t\t\t\t\t(wr_ptr[FIFO_PTR_W-1:0] == rd_ptr_sync_reg[FIFO_PTR_W-1:0]);\n\n\twire fifo_empty = (wr_ptr_sync_reg == rd_ptr);\n\n\t// Stall output\n\tassign o_wb_stall = fifo_full_simple | rst_wb;\n\n\t// Write to FIFO (WB domain)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\twr_ptr <= {(FIFO_PTR_W+1){1'b0}};\n\t\tend else if (wb_write_en) begin\n\t\t\tfifo_data[wr_ptr[FIFO_PTR_W-1:0]] <= i_wb_data;\n\t\t\tfifo_addr[wr_ptr[FIFO_PTR_W-1:0]] <= i_wb_addr;\n\t\t\tfifo_sel[wr_ptr[FIFO_PTR_W-1:0]] <= i_wb_sel;\n\t\t\tfifo_we[wr_ptr[FIFO_PTR_W-1:0]] <= i_wb_we;\n\t\t\twr_ptr <= wr_ptr + 1'b1;\n\t\tend\n\tend\n\n\t// Read from FIFO (XCLK domain)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trd_ptr <= {(FIFO_PTR_W+1){1'b0}};\n\t\t\to_xclk_cyc <= 1'b0;\n\t\t\to_xclk_stb <= 1'b0;\n\t\t\to_xclk_we <= 1'b0;\n\t\t\to_xclk_addr <= {(AW){1'b0}};\n\t\t\to_xclk_data <= {(DW){1'b0}};\n\t\t\to_xclk_sel <= {(DW/8){1'b0}};\n\t\tend else begin\n\t\t\tif (xclk_read_en) begin\n\t\t\t\trd_ptr <= rd_ptr + 1'b1;\n\t\t\tend\n\t\t\tif (!fifo_empty) begin\n\t\t\t\to_xclk_cyc <= 1'b1;\n\t\t\t\to_xclk_stb <= 1'b1;\n\t\t\t\to_xclk_we <= fifo_we[rd_ptr[FIFO_PTR_W-1:0]];\n\t\t\t\to_xclk_addr <= fifo_addr[rd_ptr[FIFO_PTR_W-1:0]];\n\t\t\t\to_xclk_data <= fifo_data[rd_ptr[FIFO_PTR_W-1:0]];\n\t\t\t\to_xclk_sel <= fifo_sel[rd_ptr[FIFO_PTR_W-1:0]];\n\t\t\tend else begin\n\t\t\t\to_xclk_cyc <= 1'b0;\n\t\t\t\to_xclk_stb <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Response FIFO (XCLK to WB)\n\treg [DW-1:0] resp_data [0:FIFO_DEPTH-1];\n\treg resp_err [0:FIFO_DEPTH-1];\n\treg [FIFO_PTR_W:0] resp_wr_ptr;\n\treg [FIFO_PTR_W:0] resp_rd_ptr;\n\n\t// Response write (XCLK domain)\n\twire xclk_resp_write_en = i_xclk_ack & ~rst_xclk;\n\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tresp_wr_ptr <= {(FIFO_PTR_W+1){1'b0}};\n\t\tend else if (xclk_resp_write_en) begin\n\t\t\tresp_data[resp_wr_ptr[FIFO_PTR_W-1:0]] <= i_xclk_data;\n\t\t\tresp_err[resp_wr_ptr[FIFO_PTR_W-1:0]] <= i_xclk_err;\n\t\t\tresp_wr_ptr <= resp_wr_ptr + 1'b1;\n\t\tend\n\tend\n\n\t// Response read (WB domain)\n\twire wb_resp_read_en = o_wb_ack & ~rst_wb;\n\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tresp_rd_ptr <= {(FIFO_PTR_W+1){1'b0}};\n\t\t\to_wb_ack <= 1'b0;\n\t\t\to_wb_data <= {(DW){1'b0}};\n\t\t\to_wb_err <= 1'b0;\n\t\tend else begin\n\t\t\tif (wb_resp_read_en) begin\n\t\t\t\tresp_rd_ptr <= resp_rd_ptr + 1'b1;\n\t\t\tend\n\t\t\tif (resp_rd_ptr != resp_wr_ptr_sync_reg) begin\n\t\t\t\to_wb_ack <= 1'b1;\n\t\t\t\to_wb_data <= resp_data[resp_rd_ptr[FIFO_PTR_W-1:0]];\n\t\t\t\to_wb_err <= resp_err[resp_rd_ptr[FIFO_PTR_W-1:0]];\n\t\t\tend else begin\n\t\t\t\to_wb_ack <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Synchronize resp_wr_ptr to WB domain\n\treg [FIFO_PTR_W:0] resp_wr_ptr_sync_reg;\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\tresp_wr_ptr_sync_reg <= {(FIFO_PTR_W+1){1'b0}};\n\t\telse\n\t\t\tresp_wr_ptr_sync_reg <= resp_wr_ptr;\n\tend\n\nendmodule\n```<|im_end|>",
