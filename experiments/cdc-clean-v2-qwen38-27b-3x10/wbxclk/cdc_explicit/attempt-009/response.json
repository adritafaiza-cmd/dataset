  "text": "```verilog\nmodule wbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_MASK  = FIFO_DEPTH - 1;\n\n\t// Reset synchronizers\n\treg [1:0] rst_sync_wb;\n\treg [1:0] rst_sync_xclk;\n\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\trst_sync_wb <= 2'b00;\n\t\telse\n\t\t\trst_sync_wb <= {rst_sync_wb[0], 1'b1};\n\tend\n\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\trst_sync_xclk <= 2'b00;\n\t\telse\n\t\t\trst_sync_xclk <= {rst_sync_xclk[0], 1'b1};\n\tend\n\n\twire wb_rst_n = rst_sync_wb[1];\n\twire xclk_rst_n = rst_sync_xclk[1];\n\n\t// FIFO storage\n\treg [DW-1:0] data_fifo [0:FIFO_DEPTH-1];\n\treg [AW-1:0] addr_fifo [0:FIFO_DEPTH-1];\n\treg [DW/8-1:0] sel_fifo [0:FIFO_DEPTH-1];\n\treg we_fifo [0:FIFO_DEPTH-1];\n\n\treg [LGFIFO:0] wr_ptr;\n\treg [LGFIFO:0] rd_ptr;\n\n\t// Synchronize write pointer to xclk domain\n\treg [LGFIFO:0] wr_ptr_sync1;\n\treg [LGFIFO:0] wr_ptr_sync2;\n\treg [LGFIFO:0] wr_ptr_sync3;\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (wb_rst_n)\n\t\t\twr_ptr_sync1 <= wr_ptr;\n\tend\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n) begin\n\t\t\twr_ptr_sync2 <= wr_ptr_sync1;\n\t\t\twr_ptr_sync3 <= wr_ptr_sync2;\n\t\tend\n\tend\n\n\t// Synchronize read pointer to wb domain\n\treg [LGFIFO:0] rd_ptr_sync1;\n\treg [LGFIFO:0] rd_ptr_sync2;\n\treg [LGFIFO:0] rd_ptr_sync3;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n)\n\t\t\trd_ptr_sync1 <= rd_ptr;\n\tend\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (wb_rst_n) begin\n\t\t\trd_ptr_sync2 <= rd_ptr_sync1;\n\t\t\trd_ptr_sync3 <= rd_ptr_sync2;\n\t\tend\n\tend\n\n\t// Write side (wb_clk domain)\n\twire wb_write = i_wb_cyc & i_wb_stb & ~o_wb_stall;\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (wb_rst_n) begin\n\t\t\tif (wb_write) begin\n\t\t\t\tdata_fifo[wr_ptr[LGFIFO-1:0]] <= i_wb_data;\n\t\t\t\taddr_fifo[wr_ptr[LGFIFO-1:0]] <= i_wb_addr;\n\t\t\t\tsel_fifo[wr_ptr[LGFIFO-1:0]] <= i_wb_sel;\n\t\t\t\twe_fifo[wr_ptr[LGFIFO-1:0]] <= i_wb_we;\n\t\t\t\twr_ptr <= wr_ptr + 1'b1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Read side (xclk_clk domain)\n\t// Two-stage pipeline: stage 1 reads FIFO, stage 2 drives outputs\n\treg [DW-1:0] stage1_data;\n\treg [AW-1:0] stage1_addr;\n\treg [DW/8-1:0] stage1_sel;\n\treg stage1_we;\n\treg stage1_valid;\n\n\treg [DW-1:0] stage2_data;\n\treg [AW-1:0] stage2_addr;\n\treg [DW/8-1:0] stage2_sel;\n\treg stage2_we;\n\treg stage2_valid;\n\n\twire fifo_empty = (wr_ptr_sync3 == rd_ptr);\n\twire can_read = xclk_rst_n & ~fifo_empty & ~i_xclk_stall;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n) begin\n\t\t\tif (can_read) begin\n\t\t\t\tstage1_data <= data_fifo[rd_ptr[LGFIFO-1:0]];\n\t\t\t\tstage1_addr <= addr_fifo[rd_ptr[LGFIFO-1:0]];\n\t\t\t\tstage1_sel <= sel_fifo[rd_ptr[LGFIFO-1:0]];\n\t\t\t\tstage1_we <= we_fifo[rd_ptr[LGFIFO-1:0]];\n\t\t\t\tstage1_valid <= 1'b1;\n\t\t\t\trd_ptr <= rd_ptr + 1'b1;\n\t\t\tend\n\t\t\telse begin\n\t\t\t\tstage1_valid <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n) begin\n\t\t\tstage2_data <= stage1_data;\n\t\t\tstage2_addr <= stage1_addr;\n\t\t\tstage2_sel <= stage1_sel;\n\t\t\tstage2_we <= stage1_we;\n\t\t\tstage2_valid <= stage1_valid;\n\t\tend\n\tend\n\n\t// Drive xclk outputs\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n) begin\n\t\t\tif (stage2_valid) begin\n\t\t\t\to_xclk_cyc <= 1'b1;\n\t\t\t\to_xclk_stb <= 1'b1;\n\t\t\t\to_xclk_we <= stage2_we;\n\t\t\t\to_xclk_addr <= stage2_addr;\n\t\t\t\to_xclk_data <= stage2_data;\n\t\t\t\to_xclk_sel <= stage2_sel;\n\t\t\tend\n\t\t\telse begin\n\t\t\t\to_xclk_cyc <= 1'b0;\n\t\t\t\to_xclk_stb <= 1'b0;\n\t\t\t\to_xclk_we <= 1'b0;\n\t\t\t\to_xclk_addr <= {AW{1'b0}};\n\t\t\t\to_xclk_data <= {DW{1'b0}};\n\t\t\t\to_xclk_sel <= {(DW/8){1'b0}};\n\t\t\tend\n\t\tend\n\tend\n\n\t// Response FIFO (xclk_clk domain)\n\treg [DW-1:0] resp_data_fifo [0:FIFO_DEPTH-1];\n\treg resp_err_fifo [0:FIFO_DEPTH-1];\n\treg [LGFIFO:0] resp_wr_ptr;\n\treg [LGFIFO:0] resp_rd_ptr;\n\n\t// Synchronize response write pointer to wb domain\n\treg [LGFIFO:0] resp_wr_ptr_sync1;\n\treg [LGFIFO:0] resp_wr_ptr_sync2;\n\treg [LGFIFO:0] resp_wr_ptr_sync3;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n)\n\t\t\tresp_wr_ptr_sync1 <= resp_wr_ptr;\n\tend\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (wb_rst_n) begin\n\t\t\tresp_wr_ptr_sync2 <= resp_wr_ptr_sync1;\n\t\t\tresp_wr_ptr_sync3 <= resp_wr_ptr_sync2;\n\t\tend\n\tend\n\n\t// Synchronize response read pointer to xclk domain\n\treg [LGFIFO:0] resp_rd_ptr_sync1;\n\treg [LGFIFO:0] resp_rd_ptr_sync2;\n\treg [LGFIFO:0] resp_rd_ptr_sync3;\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (wb_rst_n)\n\t\t\tresp_rd_ptr_sync1 <= resp_rd_ptr;\n\tend\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n) begin\n\t\t\tresp_rd_ptr_sync2 <= resp_rd_ptr_sync1;\n\t\t\tresp_rd_ptr_sync3 <= resp_rd_ptr_sync2;\n\t\tend\n\tend\n\n\t// Write response on ack\n\twire resp_write = i_xclk_ack & xclk_rst_n;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n) begin\n\t\tif (resp_write) begin\n\t\t\tresp_data_fifo[resp_wr_ptr[LGFIFO-1:0]] <= i_xclk_data;\n\t\t\tresp_err_fifo[resp_wr_ptr[LGFIFO-1:0]] <= i_xclk_err;\n\t\t\tresp_wr_ptr <= resp_wr_ptr + 1'b1;\n\t\tend\n\tend\n\tend\n\n\t// Read response (wb_clk domain)\n\twire resp_empty = (resp_wr_ptr_sync3 == resp_rd_ptr);\n\twire resp_read = wb_rst_n & ~resp_empty;\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (wb_rst_n) begin\n\t\t\tif (resp_read) begin\n\t\t\t\to_wb_ack <= 1'b1;\n\t\t\t\to_wb_data <= resp_data_fifo[resp_rd_ptr[LGFIFO-1:0]];\n\t\t\t\to_wb_err <= resp_err_fifo[resp_rd_ptr[LGFIFO-1:0]];\n\t\t\t\tresp_rd_ptr <= resp_rd_ptr + 1'b1;\n\t\t\tend\n\t\t\telse begin\n\t\t\t\to_wb_ack <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Stall signal\n\tassign o_wb_stall = (wr_ptr - rd_ptr_sync3) >= (FIFO_DEPTH - 1);\n\nendmodule\n```<|im_end|>",
