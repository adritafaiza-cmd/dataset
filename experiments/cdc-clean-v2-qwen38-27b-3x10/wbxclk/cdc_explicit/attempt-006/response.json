  "text": "```verilog\nmodule wbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_MASK  = FIFO_DEPTH - 1;\n\n\t// ------------------------------------------------------------------\n\t// Reset synchronization\n\t// ------------------------------------------------------------------\n\treg [1:0] rst_sync_wb;\n\treg [1:0] rst_sync_xclk;\n\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\trst_sync_wb <= 2'b00;\n\t\telse\n\t\t\trst_sync_wb <= {rst_sync_wb[0], 1'b1};\n\tend\n\n\talways @(posedge i_xclk_clk) begin\n\t\trst_sync_xclk <= {rst_sync_xclk[0], rst_sync_wb[1]};\n\tend\n\n\twire wb_rst_n = rst_sync_wb[1];\n\twire xclk_rst_n = rst_sync_xclk[1];\n\n\t// ------------------------------------------------------------------\n\t// Request FIFO (wb_clk domain)\n\t// ------------------------------------------------------------------\n\treg [AW-1:0] req_addr_mem [0:FIFO_DEPTH-1];\n\treg [DW-1:0] req_data_mem [0:FIFO_DEPTH-1];\n\treg [DW/8-1:0] req_sel_mem [0:FIFO_DEPTH-1];\n\treg req_we_mem [0:FIFO_DEPTH-1];\n\n\treg [LGFIFO:0] req_wr_ptr;\n\treg [LGFIFO:0] req_rd_ptr;\n\n\twire req_full = (req_wr_ptr == {req_rd_ptr[LGFIFO-1:0], ~req_rd_ptr[LGFIFO]});\n\twire req_empty = (req_wr_ptr == req_rd_ptr);\n\n\t// Write to request FIFO\n\twire req_wr_en = i_wb_cyc & i_wb_stb & wb_rst_n & ~req_full;\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (req_wr_en) begin\n\t\t\treq_addr_mem[req_wr_ptr[LGFIFO-1:0]] <= i_wb_addr;\n\t\t\treq_data_mem[req_wr_ptr[LGFIFO-1:0]] <= i_wb_data;\n\t\t\treq_sel_mem[req_wr_ptr[LGFIFO-1:0]]  <= i_wb_sel;\n\t\t\treq_we_mem[req_wr_ptr[LGFIFO-1:0]]   <= i_wb_we;\n\t\t\treq_wr_ptr <= req_wr_ptr + 1'b1;\n\t\tend\n\tend\n\n\t// ------------------------------------------------------------------\n\t// Response FIFO (xclk_clk domain)\n\t// ------------------------------------------------------------------\n\treg [DW-1:0] rsp_data_mem [0:FIFO_DEPTH-1];\n\treg rsp_err_mem [0:FIFO_DEPTH-1];\n\n\treg [LGFIFO:0] rsp_wr_ptr;\n\treg [LGFIFO:0] rsp_rd_ptr;\n\n\twire rsp_full = (rsp_wr_ptr == {rsp_rd_ptr[LGFIFO-1:0], ~rsp_rd_ptr[LGFIFO]});\n\twire rsp_empty = (rsp_wr_ptr == rsp_rd_ptr);\n\n\t// Write to response FIFO\n\twire rsp_wr_en = i_xclk_ack & xclk_rst_n & ~rsp_full;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (rsp_wr_en) begin\n\t\t\trsp_data_mem[rsp_wr_ptr[LGFIFO-1:0]] <= i_xclk_data;\n\t\t\trsp_err_mem[rsp_wr_ptr[LGFIFO-1:0]]  <= i_xclk_err;\n\t\t\trsp_wr_ptr <= rsp_wr_ptr + 1'b1;\n\t\tend\n\tend\n\n\t// ------------------------------------------------------------------\n\t// CDC: Request FIFO pointers\n\t// ------------------------------------------------------------------\n\t// wb_clk -> xclk_clk: write pointer\n\treg [LGFIFO:0] req_wr_ptr_sync0;\n\treg [LGFIFO:0] req_wr_ptr_sync1;\n\n\talways @(posedge i_xclk_clk) begin\n\t\treq_wr_ptr_sync0 <= req_wr_ptr;\n\t\treq_wr_ptr_sync1 <= req_wr_ptr_sync0;\n\tend\n\n\t// xclk_clk -> wb_clk: read pointer\n\treg [LGFIFO:0] req_rd_ptr_sync0;\n\treg [LGFIFO:0] req_rd_ptr_sync1;\n\n\talways @(posedge i_wb_clk) begin\n\t\treq_rd_ptr_sync0 <= req_rd_ptr;\n\t\treq_rd_ptr_sync1 <= req_rd_ptr_sync0;\n\tend\n\n\t// ------------------------------------------------------------------\n\t// CDC: Response FIFO pointers\n\t// ------------------------------------------------------------------\n\t// xclk_clk -> wb_clk: write pointer\n\treg [LGFIFO:0] rsp_wr_ptr_sync0;\n\treg [LGFIFO:0] rsp_wr_ptr_sync1;\n\n\talways @(posedge i_wb_clk) begin\n\t\trsp_wr_ptr_sync0 <= rsp_wr_ptr;\n\t\trsp_wr_ptr_sync1 <= rsp_wr_ptr_sync0;\n\tend\n\n\t// wb_clk -> xclk_clk: read pointer\n\treg [LGFIFO:0] rsp_rd_ptr_sync0;\n\treg [LGFIFO:0] rsp_rd_ptr_sync1;\n\n\talways @(posedge i_xclk_clk) begin\n\t\trsp_rd_ptr_sync0 <= rsp_rd_ptr;\n\t\trsp_rd_ptr_sync1 <= rsp_rd_ptr_sync0;\n\tend\n\n\t// ------------------------------------------------------------------\n\t// Destination side (xclk_clk domain)\n\t// ------------------------------------------------------------------\n\t// Read from request FIFO\n\twire req_rd_en = ~req_empty & ~i_xclk_stall & xclk_rst_n;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (req_rd_en) begin\n\t\t\treq_rd_ptr <= req_rd_ptr + 1'b1;\n\t\tend\n\tend\n\n\t// Pipeline stages for destination output\n\treg [AW-1:0] pipe_addr_s1, pipe_addr_s2;\n\treg [DW-1:0] pipe_data_s1, pipe_data_s2;\n\treg [DW/8-1:0] pipe_sel_s1, pipe_sel_s2;\n\treg pipe_we_s1, pipe_we_s2;\n\treg pipe_valid_s1, pipe_valid_s2;\n\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n) begin\n\t\t\tpipe_addr_s1 <= req_addr_mem[req_rd_ptr[LGFIFO-1:0]];\n\t\t\tpipe_data_s1 <= req_data_mem[req_rd_ptr[LGFIFO-1:0]];\n\t\t\tpipe_sel_s1  <= req_sel_mem[req_rd_ptr[LGFIFO-1:0]];\n\t\t\tpipe_we_s1   <= req_we_mem[req_rd_ptr[LGFIFO-1:0]];\n\t\t\tpipe_valid_s1 <= req_rd_en;\n\n\t\t\tpipe_addr_s2 <= pipe_addr_s1;\n\t\t\tpipe_data_s2 <= pipe_data_s1;\n\t\t\tpipe_sel_s2  <= pipe_sel_s1;\n\t\t\tpipe_we_s2   <= pipe_we_s1;\n\t\t\tpipe_valid_s2 <= pipe_valid_s1;\n\t\tend else begin\n\t\t\tpipe_valid_s1 <= 1'b0;\n\t\t\tpipe_valid_s2 <= 1'b0;\n\t\tend\n\tend\n\n\t// Destination bus outputs\n\talways @(posedge i_xclk_clk) begin\n\t\tif (xclk_rst_n) begin\n\t\t\to_xclk_cyc <= pipe_valid_s2;\n\t\t\to_xclk_stb <= pipe_valid_s2;\n\t\t\to_xclk_we  <= pipe_we_s2;\n\t\t\to_xclk_addr <= pipe_addr_s2;\n\t\t\to_xclk_data <= pipe_data_s2;\n\t\t\to_xclk_sel  <= pipe_sel_s2;\n\t\tend else begin\n\t\t\to_xclk_cyc <= 1'b0;\n\t\t\to_xclk_stb <= 1'b0;\n\t\t\to_xclk_we  <= 1'b0;\n\t\tend\n\tend\n\n\t// ------------------------------------------------------------------\n\t// Source side (wb_clk domain)\n\t// ------------------------------------------------------------------\n\t// Read from response FIFO\n\twire rsp_rd_en = ~rsp_empty & wb_rst_n;\n\n\talways @(posedge i_wb_clk) begin\n\t\tif (rsp_rd_en) begin\n\t\t\trsp_rd_ptr <= rsp_rd_ptr + 1'b1;\n\t\tend\n\tend\n\n\t// Source bus outputs\n\talways @(posedge i_wb_clk) begin\n\t\tif (wb_rst_n) begin\n\t\t\to_wb_ack   <= rsp_rd_en;\n\t\t\to_wb_data  <= rsp_data_mem[rsp_rd_ptr[LGFIFO-1:0]];\n\t\t\to_wb_err   <= rsp_err_mem[rsp_rd_ptr[LGFIFO-1:0]];\n\t\tend else begin\n\t\t\to_wb_ack   <= 1'b0;\n\t\t\to_wb_err   <= 1'b0;\n\t\tend\n\tend\n\n\t// ------------------------------------------------------------------\n\t// Backpressure\n\t// ------------------------------------------------------------------\n\t// o_wb_stall: high when request FIFO is full\n\tassign o_wb_stall = req_full | ~wb_rst_n;\n\nendmodule\n```<|im_end|>",
