  "text": "```verilog\nmodule wbxclk #(\n\tparameter AW=32,\n\tparameter DW=32,\n\tparameter LGFIFO = 5\n) (\n\tinput\twire\t\t\ti_wb_clk, i_reset,\n\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\toutput\twire\t\t\to_wb_stall,\n\toutput\treg\t\t\to_wb_ack,\n\toutput\treg\t[(DW-1):0]\to_wb_data,\n\toutput\treg\t\t\to_wb_err,\n\tinput\twire\t\t\ti_xclk_clk,\n\toutput\treg\t\t\to_xclk_cyc,\n\toutput\treg\t\t\to_xclk_stb,\n\toutput\treg\t\t\to_xclk_we,\n\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\tinput\twire\t\t\ti_xclk_stall,\n\tinput\twire\t\t\ti_xclk_ack,\n\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\tinput\twire\t\t\ti_xclk_err\n);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_PTR_W = LGFIFO;\n\n\t// Request FIFO (wb -> xclk)\n\treg [DW-1:0] req_fifo_data [0:FIFO_DEPTH-1];\n\treg [AW-1:0] req_fifo_addr [0:FIFO_DEPTH-1];\n\treg [DW/8-1:0] req_fifo_sel [0:FIFO_DEPTH-1];\n\treg req_fifo_we [0:FIFO_DEPTH-1];\n\treg [FIFO_PTR_W-1:0] req_wr_ptr, req_rd_ptr;\n\treg [FIFO_PTR_W:0] req_count;\n\n\t// Response FIFO (xclk -> wb)\n\treg [DW-1:0] rsp_fifo_data [0:FIFO_DEPTH-1];\n\treg rsp_fifo_err [0:FIFO_DEPTH-1];\n\treg [FIFO_PTR_W-1:0] rsp_wr_ptr, rsp_rd_ptr;\n\treg [FIFO_PTR_W:0] rsp_count;\n\n\t// Synchronization signals\n\treg [1:0] req_full_sync, req_empty_sync, rsp_full_sync, rsp_empty_sync;\n\treg req_full, req_empty, rsp_full, rsp_empty;\n\n\t// Request FIFO write (wb clock domain)\n\twire req_wr_en = i_wb_cyc & i_wb_stb & ~o_wb_stall;\n\twire req_full_next = req_count == FIFO_DEPTH;\n\twire req_empty_next = req_count == 0;\n\n\t// Request FIFO read (xclk clock domain)\n\twire req_rd_en = ~req_empty & ~i_xclk_stall;\n\n\t// Response FIFO write (xclk clock domain)\n\twire rsp_wr_en = i_xclk_ack;\n\n\t// Response FIFO read (wb clock domain)\n\twire rsp_rd_en = ~rsp_empty;\n\n\t// o_wb_stall: high when request FIFO is full\n\tassign o_wb_stall = req_full;\n\n\t// Request FIFO write pointer (wb clock)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr <= {FIFO_PTR_W{1'b0}};\n\t\t\treq_count <= {(FIFO_PTR_W+1){1'b0}};\n\t\tend else begin\n\t\t\tif (req_wr_en && !req_rd_en) begin\n\t\t\t\treq_wr_ptr <= req_wr_ptr + 1'b1;\n\t\t\t\treq_count <= req_count + 1'b1;\n\t\t\tend else if (!req_wr_en && req_rd_en) begin\n\t\t\t\treq_wr_ptr <= req_wr_ptr;\n\t\t\t\treq_count <= req_count - 1'b1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Request FIFO read pointer (xclk clock)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr <= {FIFO_PTR_W{1'b0}};\n\t\tend else if (req_rd_en) begin\n\t\t\treq_rd_ptr <= req_rd_ptr + 1'b1;\n\t\tend\n\tend\n\n\t// Request FIFO data write (wb clock)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\t// No need to clear data, but clear control\n\t\tend else if (req_wr_en) begin\n\t\t\treq_fifo_data[req_wr_ptr] <= i_wb_data;\n\t\t\treq_fifo_addr[req_wr_ptr] <= i_wb_addr;\n\t\t\treq_fifo_sel[req_wr_ptr] <= i_wb_sel;\n\t\t\treq_fifo_we[req_wr_ptr] <= i_wb_we;\n\t\tend\n\tend\n\n\t// Response FIFO write pointer (xclk clock)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_wr_ptr <= {FIFO_PTR_W{1'b0}};\n\t\t\trsp_count <= {(FIFO_PTR_W+1){1'b0}};\n\t\tend else begin\n\t\t\tif (rsp_wr_en && !rsp_rd_en) begin\n\t\t\t\trsp_wr_ptr <= rsp_wr_ptr + 1'b1;\n\t\t\t\trsp_count <= rsp_count + 1'b1;\n\t\t\tend else if (!rsp_wr_en && rsp_rd_en) begin\n\t\t\t\trsp_wr_ptr <= rsp_wr_ptr;\n\t\t\t\trsp_count <= rsp_count - 1'b1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Response FIFO read pointer (wb clock)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_rd_ptr <= {FIFO_PTR_W{1'b0}};\n\t\tend else if (rsp_rd_en) begin\n\t\t\trsp_rd_ptr <= rsp_rd_ptr + 1'b1;\n\t\tend\n\tend\n\n\t// Response FIFO data write (xclk clock)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\t// No need to clear data\n\t\tend else if (rsp_wr_en) begin\n\t\t\trsp_fifo_data[rsp_wr_ptr] <= i_xclk_data;\n\t\t\trsp_fifo_err[rsp_wr_ptr] <= i_xclk_err;\n\t\tend\n\tend\n\n\t// Synchronize req_full from wb to xclk\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_full <= 1'b0;\n\t\tend else begin\n\t\t\treq_full <= req_count == FIFO_DEPTH;\n\t\tend\n\tend\n\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_full_sync <= 2'b00;\n\t\tend else begin\n\t\t\treq_full_sync <= {req_full_sync[0], req_full};\n\t\tend\n\tend\n\n\tassign req_full = req_full_sync[1];\n\n\t// Synchronize req_empty from wb to xclk\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_empty <= 1'b1;\n\t\tend else begin\n\t\t\treq_empty <= req_count == 0;\n\t\tend\n\tend\n\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_empty_sync <= 2'b11;\n\t\tend else begin\n\t\t\treq_empty_sync <= {req_empty_sync[0], req_empty};\n\t\tend\n\tend\n\n\tassign req_empty = req_empty_sync[1];\n\n\t// Synchronize rsp_full from xclk to wb\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_full <= 1'b0;\n\t\tend else begin\n\t\t\trsp_full <= rsp_count == FIFO_DEPTH;\n\t\tend\n\tend\n\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_full_sync <= 2'b00;\n\t\tend else begin\n\t\t\trsp_full_sync <= {rsp_full_sync[0], rsp_full};\n\t\tend\n\tend\n\n\tassign rsp_full = rsp_full_sync[1];\n\n\t// Synchronize rsp_empty from xclk to wb\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_empty <= 1'b1;\n\t\tend else begin\n\t\t\trsp_empty <= rsp_count == 0;\n\t\tend\n\tend\n\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_empty_sync <= 2'b11;\n\t\tend else begin\n\t\t\trsp_empty_sync <= {rsp_empty_sync[0], rsp_empty};\n\t\tend\n\tend\n\n\tassign rsp_empty = rsp_empty_sync[1];\n\n\t// xclk side: drive o_xclk_* from request FIFO\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_xclk_cyc <= 1'b0;\n\t\t\to_xclk_stb <= 1'b0;\n\t\t\to_xclk_we <= 1'b0;\n\t\t\to_xclk_addr <= {AW{1'b0}};\n\t\t\to_xclk_data <= {DW{1'b0}};\n\t\t\to_xclk_sel <= {(DW/8){1'b0}};\n\t\tend else if (req_rd_en) begin\n\t\t\to_xclk_cyc <= 1'b1;\n\t\t\to_xclk_stb <= 1'b1;\n\t\t\to_xclk_we <= req_fifo_we[req_rd_ptr];\n\t\t\to_xclk_addr <= req_fifo_addr[req_rd_ptr];\n\t\t\to_xclk_data <= req_fifo_data[req_rd_ptr];\n\t\t\to_xclk_sel <= req_fifo_sel[req_rd_ptr];\n\t\tend else begin\n\t\t\to_xclk_cyc <= 1'b0;\n\t\t\to_xclk_stb <= 1'b0;\n\t\tend\n\tend\n\n\t// wb side: drive o_wb_ack, o_wb_data, o_wb_err from response FIFO\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_wb_ack <= 1'b0;\n\t\t\to_wb_data <= {DW{1'b0}};\n\t\t\to_wb_err <= 1'b0;\n\t\tend else if (rsp_rd_en) begin\n\t\t\to_wb_ack <= 1'b1;\n\t\t\to_wb_data <= rsp_fifo_data[rsp_rd_ptr];\n\t\t\to_wb_err <= rsp_fifo_err[rsp_rd_ptr];\n\t\tend else begin\n\t\t\to_wb_ack <= 1'b0;\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
