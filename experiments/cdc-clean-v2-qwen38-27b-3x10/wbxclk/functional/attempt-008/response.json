  "text": "```verilog\nmodule wbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_WIDTH = AW + DW + DW/8 + 1; // addr + data + sel + we\n\n\t// Request FIFO (wb -> xclk)\n\treg [FIFO_WIDTH-1:0] req_fifo [0:FIFO_DEPTH-1];\n\treg [LGFIFO:0] req_wr_ptr, req_rd_ptr;\n\twire req_full, req_empty;\n\twire req_wr_en, req_rd_en;\n\n\t// Response FIFO (xclk -> wb)\n\treg [DW+1:0] rsp_fifo [0:FIFO_DEPTH-1]; // data + err\n\treg [LGFIFO:0] rsp_wr_ptr, rsp_rd_ptr;\n\twire rsp_full, rsp_empty;\n\twire rsp_wr_en, rsp_rd_en;\n\n\t// Request FIFO full/empty\n\tassign req_full  = (req_wr_ptr[LGFIFO] != req_rd_ptr[LGFIFO]) &&\n\t                   (req_wr_ptr[LGFIFO-1:0] == req_rd_ptr[LGFIFO-1:0]);\n\tassign req_empty = (req_wr_ptr == req_rd_ptr);\n\n\t// Response FIFO full/empty\n\tassign rsp_full  = (rsp_wr_ptr[LGFIFO] != rsp_rd_ptr[LGFIFO]) &&\n\t                   (rsp_wr_ptr[LGFIFO-1:0] == rsp_rd_ptr[LGFIFO-1:0]);\n\tassign rsp_empty = (rsp_wr_ptr == rsp_rd_ptr);\n\n\t// WB side: accept when not full\n\tassign req_wr_en = i_wb_cyc && i_wb_stb && !req_full;\n\tassign o_wb_stall = req_full;\n\n\t// XCLK side: read when not empty and not stalled\n\tassign req_rd_en = !req_empty && !i_xclk_stall;\n\n\t// Response FIFO write from xclk side\n\tassign rsp_wr_en = i_xclk_ack;\n\n\t// Response FIFO read from wb side\n\tassign rsp_rd_en = !rsp_empty;\n\n\t// WB side: write to request FIFO\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr <= 0;\n\t\tend else if (req_wr_en) begin\n\t\t\treq_fifo[req_wr_ptr[LGFIFO-1:0]] <= {i_wb_we, i_wb_addr, i_wb_data, i_wb_sel};\n\t\t\treq_wr_ptr <= req_wr_ptr + 1;\n\t\tend\n\tend\n\n\t// XCLK side: read from request FIFO\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr <= 0;\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we  <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel  <= 0;\n\t\tend else if (req_rd_en) begin\n\t\t\treq_rd_ptr <= req_rd_ptr + 1;\n\t\t\to_xclk_cyc  <= 1;\n\t\t\to_xclk_stb  <= 1;\n\t\t\to_xclk_we   <= req_fifo[req_rd_ptr[LGFIFO-1:0]][FIFO_WIDTH-1];\n\t\t\to_xclk_addr <= req_fifo[req_rd_ptr[LGFIFO-1:0]][FIFO_WIDTH-2:FIFO_WIDTH-1-DW];\n\t\t\to_xclk_data <= req_fifo[req_rd_ptr[LGFIFO-1:0]][FIFO_WIDTH-1-DW:FIFO_WIDTH-1-DW-DW/8];\n\t\t\to_xclk_sel  <= req_fifo[req_rd_ptr[LGFIFO-1:0]][FIFO_WIDTH-1-DW-DW/8:0];\n\t\tend else begin\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\tend\n\tend\n\n\t// XCLK side: write to response FIFO\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_wr_ptr <= 0;\n\t\tend else if (rsp_wr_en) begin\n\t\t\trsp_fifo[rsp_wr_ptr[LGFIFO-1:0]] <= {i_xclk_err, i_xclk_data};\n\t\t\trsp_wr_ptr <= rsp_wr_ptr + 1;\n\t\tend\n\tend\n\n\t// WB side: read from response FIFO\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_rd_ptr <= 0;\n\t\t\to_wb_ack   <= 0;\n\t\t\to_wb_data  <= 0;\n\t\t\to_wb_err   <= 0;\n\t\tend else if (rsp_rd_en) begin\n\t\t\trsp_rd_ptr <= rsp_rd_ptr + 1;\n\t\t\to_wb_ack   <= 1;\n\t\t\to_wb_data  <= rsp_fifo[rsp_rd_ptr[LGFIFO-1:0]][DW:0];\n\t\t\to_wb_err   <= rsp_fifo[rsp_rd_ptr[LGFIFO-1:0]][DW+1];\n\t\tend else begin\n\t\t\to_wb_ack   <= 0;\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
