  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE      = 3'd0;\n    localparam S_ISOLATE   = 3'd1;\n    localparam S_CLEAR     = 3'd2;\n    localparam S_RELEASE   = 3'd3;\n    localparam S_DONE      = 3'd4;\n\n    // A-side state\n    reg [2:0] a_state;\n    reg       a_clear_r;\n    reg       a_isolate_r;\n\n    // B-side state\n    reg [2:0] b_state;\n    reg       b_clear_r;\n    reg       b_isolate_r;\n\n    // A-side: synchronized B-side state\n    reg [2:0] b_state_sync;\n    reg [2:0] b_state_sync_r1;\n    reg [2:0] b_state_sync_r2;\n\n    // B-side: synchronized A-side state\n    reg [2:0] a_state_sync;\n    reg [2:0] a_state_sync_r1;\n    reg [2:0] a_state_sync_r2;\n\n    // A-side: synchronized B-side clear and isolate\n    reg       b_clear_sync;\n    reg       b_clear_sync_r1;\n    reg       b_clear_sync_r2;\n\n    reg       b_isolate_sync;\n    reg       b_isolate_sync_r1;\n    reg       b_isolate_sync_r2;\n\n    // B-side: synchronized A-side clear and isolate\n    reg       a_clear_sync;\n    reg       a_clear_sync_r1;\n    reg       a_clear_sync_r2;\n\n    reg       a_isolate_sync;\n    reg       a_isolate_sync_r1;\n    reg       a_isolate_sync_r2;\n\n    // Synchronize B state to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_state_sync_r1 <= 3'd0;\n            b_state_sync_r2 <= 3'd0;\n            b_state_sync    <= 3'd0;\n        end else begin\n            b_state_sync_r1 <= b_state;\n            b_state_sync_r2 <= b_state_sync_r1;\n            b_state_sync    <= b_state_sync_r2;\n        end\n    end\n\n    // Synchronize A state to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_state_sync_r1 <= 3'd0;\n            a_state_sync_r2 <= 3'd0;\n            a_state_sync    <= 3'd0;\n        end else begin\n            a_state_sync_r1 <= a_state;\n            a_state_sync_r2 <= a_state_sync_r1;\n            a_state_sync    <= a_state_sync_r2;\n        end\n    end\n\n    // Synchronize B clear to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_clear_sync_r1 <= 1'b0;\n            b_clear_sync_r2 <= 1'b0;\n            b_clear_sync    <= 1'b0;\n        end else begin\n            b_clear_sync_r1 <= b_clear_r;\n            b_clear_sync_r2 <= b_clear_sync_r1;\n            b_clear_sync    <= b_clear_sync_r2;\n        end\n    end\n\n    // Synchronize B isolate to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_isolate_sync_r1 <= 1'b0;\n            b_isolate_sync_r2 <= 1'b0;\n            b_isolate_sync    <= 1'b0;\n        end else begin\n            b_isolate_sync_r1 <= b_isolate_r;\n            b_isolate_sync_r2 <= b_isolate_sync_r1;\n            b_isolate_sync    <= b_isolate_sync_r2;\n        end\n    end\n\n    // Synchronize A clear to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_clear_sync_r1 <= 1'b0;\n            a_clear_sync_r2 <= 1'b0;\n            a_clear_sync    <= 1'b0;\n        end else begin\n            a_clear_sync_r1 <= a_clear_r;\n            a_clear_sync_r2 <= a_clear_sync_r1;\n            a_clear_sync    <= a_clear_sync_r2;\n        end\n    end\n\n    // Synchronize A isolate to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_isolate_sync_r1 <= 1'b0;\n            a_isolate_sync_r2 <= 1'b0;\n            a_isolate_sync    <= 1'b0;\n        end else begin\n            a_isolate_sync_r1 <= a_isolate_r;\n            a_isolate_sync_r2 <= a_isolate_sync_r1;\n            a_isolate_sync    <= a_isolate_sync_r2;\n        end\n    end\n\n    // A-side state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state     <= S_IDLE;\n            a_clear_r   <= 1'b0;\n            a_isolate_r <= 1'b0;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    a_clear_r   <= 1'b0;\n                    a_isolate_r <= 1'b0;\n                    if (a_clear_i || b_clear_sync) begin\n                        a_state <= S_ISOLATE;\n                    end\n                end\n\n                S_ISOLATE: begin\n                    a_isolate_r <= 1'b1;\n                    a_clear_r   <= 1'b0;\n                    // Wait for both local and peer isolate acks\n                    if (a_isolate_ack_i && b_isolate_sync) begin\n                        a_state <= S_CLEAR;\n                    end\n                end\n\n                S_CLEAR: begin\n                    a_isolate_r <= 1'b1;\n                    a_clear_r   <= 1'b1;\n                    // Wait for both local and peer clear acks\n                    if (a_clear_ack_i && b_clear_sync) begin\n                        a_state <= S_RELEASE;\n                    end\n                end\n\n                S_RELEASE: begin\n                    a_clear_r   <= 1'b0;\n                    a_isolate_r <= 1'b1;\n                    // Wait for peer to also release clear (peer in S_RELEASE or S_DONE)\n                    if (b_state_sync == S_RELEASE || b_state_sync == S_DONE) begin\n                        a_state <= S_DONE;\n                    end\n                end\n\n                S_DONE: begin\n                    a_clear_r   <= 1'b0;\n                    a_isolate_r <= 1'b0;\n                    // Wait for peer to return to idle\n                    if (b_state_sync == S_IDLE) begin\n                        a_state <= S_IDLE;\n                    end\n                end\n\n                default: begin\n                    a_state     <= S_IDLE;\n                    a_clear_r   <= 1'b0;\n                    a_isolate_r <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // B-side state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state     <= S_IDLE;\n            b_clear_r   <= 1'b0;\n            b_isolate_r <= 1'b0;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    b_clear_r   <= 1'b0;\n                    b_isolate_r <= 1'b0;\n                    if (b_clear_i || a_clear_sync) begin\n                        b_state <= S_ISOLATE;\n                    end\n                end\n\n                S_ISOLATE: begin\n                    b_isolate_r <= 1'b1;\n                    b_clear_r   <= 1'b0;\n                    // Wait for both local and peer isolate acks\n                    if (b_isolate_ack_i && a_isolate_sync) begin\n                        b_state <= S_CLEAR;\n                    end\n                end\n\n                S_CLEAR: begin\n                    b_isolate_r <= 1'b1;\n                    b_clear_r   <= 1'b1;\n                    // Wait for both local and peer clear acks\n                    if (b_clear_ack_i && a_clear_sync) begin\n                        b_state <= S_RELEASE;\n                    end\n                end\n\n                S_RELEASE: begin\n                    b_clear_r   <= 1'b0;\n                    b_isolate_r <= 1'b1;\n                    // Wait for peer to also release clear (peer in S_RELEASE or S_DONE)\n                    if (a_state_sync == S_RELEASE || a_state_sync == S_DONE) begin\n                        b_state <= S_DONE;\n                    end\n                end\n\n                S_DONE: begin\n                    b_clear_r   <= 1'b0;\n                    b_isolate_r <= 1'b0;\n                    // Wait for peer to return to idle\n                    if (a_state_sync == S_IDLE) begin\n                        b_state <= S_IDLE;\n                    end\n                end\n\n                default: begin\n                    b_state     <= S_IDLE;\n                    b_clear_r   <= 1'b0;\n                    b_isolate_r <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // Outputs\n    assign a_clear_o   = a_clear_r;\n    assign a_isolate_o = a_isolate_r;\n    assign b_clear_o   = b_clear_r;\n    assign b_isolate_o = b_isolate_r;\n\nendmodule\n```<|im_end|>",
