  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE       = 4'd0;\n    localparam S_ISOLATE    = 4'd1;\n    localparam S_ISOLATE_W  = 4'd2;\n    localparam S_CLEAR      = 4'd3;\n    localparam S_CLEAR_W    = 4'd4;\n    localparam S_RELEASE    = 4'd5;\n    localparam S_RELEASE_W  = 4'd6;\n\n    // A-side state\n    reg [3:0] a_state;\n    reg       a_isolate_o_r;\n    reg       a_clear_o_r;\n\n    // B-side state\n    reg [3:0] b_state;\n    reg       b_isolate_o_r;\n    reg       b_clear_o_r;\n\n    // Synchronizers for A->B signals\n    reg [SYNC_STAGES-1:0] a_isolate_sync;\n    reg [SYNC_STAGES-1:0] a_clear_sync;\n    reg [SYNC_STAGES-1:0] a_state_sync;\n\n    // Synchronizers for B->A signals\n    reg [SYNC_STAGES-1:0] b_isolate_sync;\n    reg [SYNC_STAGES-1:0] b_clear_sync;\n    reg [SYNC_STAGES-1:0] b_state_sync;\n\n    // Synchronized versions\n    wire a_isolate_synced = a_isolate_sync[SYNC_STAGES-1];\n    wire a_clear_synced   = a_clear_sync[SYNC_STAGES-1];\n    wire a_state_synced   = a_state_sync[SYNC_STAGES-1];\n\n    wire b_isolate_synced = b_isolate_sync[SYNC_STAGES-1];\n    wire b_clear_synced   = b_clear_sync[SYNC_STAGES-1];\n    wire b_state_synced   = b_state_sync[SYNC_STAGES-1];\n\n    // A-side clock domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state       <= S_IDLE;\n            a_isolate_o_r <= 1'b0;\n            a_clear_o_r   <= 1'b0;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r   <= 1'b0;\n                    if (a_clear_i) begin\n                        a_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b0;\n                    if (a_isolate_ack_i) begin\n                        a_state <= S_ISOLATE_W;\n                    end\n                end\n                S_ISOLATE_W: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b0;\n                    if (b_isolate_synced) begin\n                        a_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b1;\n                    if (a_clear_ack_i) begin\n                        a_state <= S_CLEAR_W;\n                    end\n                end\n                S_CLEAR_W: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b1;\n                    if (b_clear_synced) begin\n                        a_state <= S_RELEASE;\n                    end\n                end\n                S_RELEASE: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b0;\n                    if (b_state_synced == S_RELEASE_W) begin\n                        a_state <= S_RELEASE_W;\n                    end\n                end\n                S_RELEASE_W: begin\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r   <= 1'b0;\n                    a_state <= S_IDLE;\n                end\n                default: begin\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r   <= 1'b0;\n                    a_state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // B-side clock domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state       <= S_IDLE;\n            b_isolate_o_r <= 1'b0;\n            b_clear_o_r   <= 1'b0;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r   <= 1'b0;\n                    if (b_clear_i) begin\n                        b_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b0;\n                    if (b_isolate_ack_i) begin\n                        b_state <= S_ISOLATE_W;\n                    end\n                end\n                S_ISOLATE_W: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b0;\n                    if (a_isolate_synced) begin\n                        b_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b1;\n                    if (b_clear_ack_i) begin\n                        b_state <= S_CLEAR_W;\n                    end\n                end\n                S_CLEAR_W: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b1;\n                    if (a_clear_synced) begin\n                        b_state <= S_RELEASE;\n                    end\n                end\n                S_RELEASE: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b0;\n                    if (a_state_synced == S_RELEASE_W) begin\n                        b_state <= S_RELEASE_W;\n                    end\n                end\n                S_RELEASE_W: begin\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r   <= 1'b0;\n                    b_state <= S_IDLE;\n                end\n                default: begin\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r   <= 1'b0;\n                    b_state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // A->B synchronizers\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_isolate_sync <= {SYNC_STAGES{1'b0}};\n            a_clear_sync   <= {SYNC_STAGES{1'b0}};\n            a_state_sync   <= {SYNC_STAGES{4'b0}};\n        end else begin\n            a_isolate_sync <= {a_isolate_sync[SYNC_STAGES-2:0], a_isolate_o_r};\n            a_clear_sync   <= {a_clear_sync[SYNC_STAGES-2:0], a_clear_o_r};\n            a_state_sync   <= {a_state_sync[SYNC_STAGES-2:0], a_state};\n        end\n    end\n\n    // B->A synchronizers\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_isolate_sync <= {SYNC_STAGES{1'b0}};\n            b_clear_sync   <= {SYNC_STAGES{1'b0}};\n            b_state_sync   <= {SYNC_STAGES{4'b0}};\n        end else begin\n            b_isolate_sync <= {b_isolate_sync[SYNC_STAGES-2:0], b_isolate_o_r};\n            b_clear_sync   <= {b_clear_sync[SYNC_STAGES-2:0], b_clear_o_r};\n            b_state_sync   <= {b_state_sync[SYNC_STAGES-2:0], b_state};\n        end\n    end\n\n    // Outputs\n    assign a_isolate_o = a_isolate_o_r;\n    assign a_clear_o   = a_clear_o_r;\n    assign b_isolate_o = b_isolate_o_r;\n    assign b_clear_o   = b_clear_o_r;\n\nendmodule\n```<|im_end|>",
