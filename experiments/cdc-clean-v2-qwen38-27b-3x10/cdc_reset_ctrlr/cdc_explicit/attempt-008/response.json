  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE      = 3'd0;\n    localparam S_ISOLATE   = 3'd1;\n    localparam S_CLEAR     = 3'd2;\n    localparam S_RELEASE   = 3'd3;\n    localparam S_DONE      = 3'd4;\n\n    // Internal signals for domain A\n    reg [2:0] a_state;\n    reg       a_isolate_reg;\n    reg       a_clear_reg;\n    reg       a_peer_isolate_ack;\n    reg       a_peer_clear_ack;\n    reg       a_peer_release;\n    reg       a_req_isolate;\n    reg       a_req_clear;\n    reg       a_req_release;\n\n    // Internal signals for domain B\n    reg [2:0] b_state;\n    reg       b_isolate_reg;\n    reg       b_clear_reg;\n    reg       b_peer_isolate_ack;\n    reg       b_peer_clear_ack;\n    reg       b_peer_release;\n    reg       b_req_isolate;\n    reg       b_req_clear;\n    reg       b_req_release;\n\n    // CDC synchronizers for A->B signals\n    reg [SYNC_STAGES-1:0] a_to_b_isolate_sync;\n    reg [SYNC_STAGES-1:0] a_to_b_clear_sync;\n    reg [SYNC_STAGES-1:0] a_to_b_release_sync;\n\n    // CDC synchronizers for B->A signals\n    reg [SYNC_STAGES-1:0] b_to_a_isolate_sync;\n    reg [SYNC_STAGES-1:0] b_to_a_clear_sync;\n    reg [SYNC_STAGES-1:0] b_to_a_release_sync;\n\n    // Synchronized versions\n    wire a_to_b_isolate_synced = a_to_b_isolate_sync[SYNC_STAGES-1];\n    wire a_to_b_clear_synced   = a_to_b_clear_sync[SYNC_STAGES-1];\n    wire a_to_b_release_synced = a_to_b_release_sync[SYNC_STAGES-1];\n\n    wire b_to_a_isolate_synced = b_to_a_isolate_sync[SYNC_STAGES-1];\n    wire b_to_a_clear_synced   = b_to_a_clear_sync[SYNC_STAGES-1];\n    wire b_to_a_release_synced = b_to_a_release_sync[SYNC_STAGES-1];\n\n    // Synchronizer for A->B isolate\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_to_b_isolate_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_to_b_isolate_sync <= {a_to_b_isolate_sync[SYNC_STAGES-2:0], a_isolate_reg};\n    end\n\n    // Synchronizer for A->B clear\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_to_b_clear_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_to_b_clear_sync <= {a_to_b_clear_sync[SYNC_STAGES-2:0], a_clear_reg};\n    end\n\n    // Synchronizer for A->B release\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_to_b_release_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_to_b_release_sync <= {a_to_b_release_sync[SYNC_STAGES-2:0], a_req_release};\n    end\n\n    // Synchronizer for B->A isolate\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_to_a_isolate_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_to_a_isolate_sync <= {b_to_a_isolate_sync[SYNC_STAGES-2:0], b_isolate_reg};\n    end\n\n    // Synchronizer for B->A clear\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_to_a_clear_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_to_a_clear_sync <= {b_to_a_clear_sync[SYNC_STAGES-2:0], b_clear_reg};\n    end\n\n    // Synchronizer for B->A release\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_to_a_release_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_to_a_release_sync <= {b_to_a_release_sync[SYNC_STAGES-2:0], b_req_release};\n    end\n\n    // Domain A state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state            <= S_IDLE;\n            a_isolate_reg      <= 1'b0;\n            a_clear_reg        <= 1'b0;\n            a_peer_isolate_ack <= 1'b0;\n            a_peer_clear_ack   <= 1'b0;\n            a_peer_release     <= 1'b0;\n            a_req_isolate      <= 1'b0;\n            a_req_clear        <= 1'b0;\n            a_req_release      <= 1'b0;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    a_isolate_reg      <= 1'b0;\n                    a_clear_reg        <= 1'b0;\n                    a_peer_isolate_ack <= 1'b0;\n                    a_peer_clear_ack   <= 1'b0;\n                    a_peer_release     <= 1'b0;\n                    a_req_isolate      <= 1'b0;\n                    a_req_clear        <= 1'b0;\n                    a_req_release      <= 1'b0;\n                    if (a_clear_i) begin\n                        a_state       <= S_ISOLATE;\n                        a_isolate_reg <= 1'b1;\n                        a_req_isolate <= 1'b1;\n                    end\n                end\n\n                S_ISOLATE: begin\n                    a_isolate_reg <= 1'b1;\n                    a_req_isolate <= 1'b1;\n                    // Wait for local isolate ack and peer isolate ack\n                    if (a_isolate_ack_i && b_to_a_isolate_synced) begin\n                        a_state            <= S_CLEAR;\n                        a_clear_reg        <= 1'b1;\n                        a_req_clear        <= 1'b1;\n                        a_peer_isolate_ack <= 1'b1;\n                    end\n                end\n\n                S_CLEAR: begin\n                    a_isolate_reg <= 1'b1;\n                    a_clear_reg   <= 1'b1;\n                    a_req_clear   <= 1'b1;\n                    // Wait for local clear ack and peer clear ack\n                    if (a_clear_ack_i && b_to_a_clear_synced) begin\n                        a_state          <= S_RELEASE;\n                        a_req_release    <= 1'b1;\n                        a_peer_clear_ack <= 1'b1;\n                    end\n                end\n\n                S_RELEASE: begin\n                    a_isolate_reg <= 1'b1;\n                    a_clear_reg   <= 1'b0;\n                    a_req_release <= 1'b1;\n                    // Wait for peer release\n                    if (b_to_a_release_synced) begin\n                        a_state        <= S_DONE;\n                        a_isolate_reg  <= 1'b0;\n                        a_req_release  <= 1'b0;\n                        a_peer_release <= 1'b1;\n                    end\n                end\n\n                S_DONE: begin\n                    a_isolate_reg <= 1'b0;\n                    a_clear_reg   <= 1'b0;\n                    a_req_release <= 1'b0;\n                    a_state       <= S_IDLE;\n                end\n\n                default: begin\n                    a_state       <= S_IDLE;\n                    a_isolate_reg <= 1'b0;\n                    a_clear_reg   <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // Domain B state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state            <= S_IDLE;\n            b_isolate_reg      <= 1'b0;\n            b_clear_reg        <= 1'b0;\n            b_peer_isolate_ack <= 1'b0;\n            b_peer_clear_ack   <= 1'b0;\n            b_peer_release     <= 1'b0;\n            b_req_isolate      <= 1'b0;\n            b_req_clear        <= 1'b0;\n            b_req_release      <= 1'b0;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    b_isolate_reg      <= 1'b0;\n                    b_clear_reg        <= 1'b0;\n                    b_peer_isolate_ack <= 1'b0;\n                    b_peer_clear_ack   <= 1'b0;\n                    b_peer_release     <= 1'b0;\n                    b_req_isolate      <= 1'b0;\n                    b_req_clear        <= 1'b0;\n                    b_req_release      <= 1'b0;\n                    if (b_clear_i) begin\n                        b_state       <= S_ISOLATE;\n                        b_isolate_reg <= 1'b1;\n                        b_req_isolate <= 1'b1;\n                    end\n                end\n\n                S_ISOLATE: begin\n                    b_isolate_reg <= 1'b1;\n                    b_req_isolate <= 1'b1;\n                    // Wait for local isolate ack and peer isolate ack\n                    if (b_isolate_ack_i && a_to_b_isolate_synced) begin\n                        b_state            <= S_CLEAR;\n                        b_clear_reg        <= 1'b1;\n                        b_req_clear        <= 1'b1;\n                        b_peer_isolate_ack <= 1'b1;\n                    end\n                end\n\n                S_CLEAR: begin\n                    b_isolate_reg <= 1'b1;\n                    b_clear_reg   <= 1'b1;\n                    b_req_clear   <= 1'b1;\n                    // Wait for local clear ack and peer clear ack\n                    if (b_clear_ack_i && a_to_b_clear_synced) begin\n                        b_state          <= S_RELEASE;\n                        b_req_release    <= 1'b1;\n                        b_peer_clear_ack <= 1'b1;\n                    end\n                end\n\n                S_RELEASE: begin\n                    b_isolate_reg <= 1'b1;\n                    b_clear_reg   <= 1'b0;\n                    b_req_release <= 1'b1;\n                    // Wait for peer release\n                    if (a_to_b_release_synced) begin\n                        b_state        <= S_DONE;\n                        b_isolate_reg  <= 1'b0;\n                        b_req_release  <= 1'b0;\n                        b_peer_release <= 1'b1;\n                    end\n                end\n\n                S_DONE: begin\n                    b_isolate_reg <= 1'b0;\n                    b_clear_reg   <= 1'b0;\n                    b_req_release <= 1'b0;\n                    b_state       <= S_IDLE;\n                end\n\n                default: begin\n                    b_state       <= S_IDLE;\n                    b_isolate_reg <= 1'b0;\n                    b_clear_reg   <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // Outputs\n    assign a_isolate_o = a_isolate_reg;\n    assign a_clear_o   = a_clear_reg;\n    assign b_isolate_o = b_isolate_reg;\n    assign b_clear_o   = b_clear_reg;\n\nendmodule\n```<|im_end|>",
