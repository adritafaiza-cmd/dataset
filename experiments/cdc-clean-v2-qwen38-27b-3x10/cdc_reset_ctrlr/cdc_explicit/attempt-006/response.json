  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE       = 3'd0;\n    localparam S_ISOLATE    = 3'd1;\n    localparam S_ISOLATE_W  = 3'd2;\n    localparam S_CLEAR      = 3'd3;\n    localparam S_CLEAR_W    = 3'd4;\n    localparam S_RELEASE    = 3'd5;\n    localparam S_RELEASE_W  = 3'd6;\n\n    // Domain A state\n    reg [2:0] a_state;\n    reg       a_isolate_o_r;\n    reg       a_clear_o_r;\n\n    // Domain B state\n    reg [2:0] b_state;\n    reg       b_isolate_o_r;\n    reg       b_clear_o_r;\n\n    // CDC signals: A -> B\n    // a_isolate_req: A requests isolation (goes high when A enters S_ISOLATE)\n    // a_clear_req:   A requests clear (goes high when A enters S_CLEAR)\n    // a_release_req: A requests release (goes high when A enters S_RELEASE)\n    reg a_isolate_req_r;\n    reg a_clear_req_r;\n    reg a_release_req_r;\n\n    // CDC signals: B -> A\n    reg b_isolate_req_r;\n    reg b_clear_req_r;\n    reg b_release_req_r;\n\n    // Synchronizers for A->B signals\n    reg [SYNC_STAGES-1:0] a_isolate_req_sync;\n    reg [SYNC_STAGES-1:0] a_clear_req_sync;\n    reg [SYNC_STAGES-1:0] a_release_req_sync;\n\n    // Synchronizers for B->A signals\n    reg [SYNC_STAGES-1:0] b_isolate_req_sync;\n    reg [SYNC_STAGES-1:0] b_clear_req_sync;\n    reg [SYNC_STAGES-1:0] b_release_req_sync;\n\n    // Synchronized versions\n    wire a_isolate_req_synced = a_isolate_req_sync[SYNC_STAGES-1];\n    wire a_clear_req_synced   = a_clear_req_sync[SYNC_STAGES-1];\n    wire a_release_req_synced = a_release_req_sync[SYNC_STAGES-1];\n\n    wire b_isolate_req_synced = b_isolate_req_sync[SYNC_STAGES-1];\n    wire b_clear_req_synced   = b_clear_req_sync[SYNC_STAGES-1];\n    wire b_release_req_synced = b_release_req_sync[SYNC_STAGES-1];\n\n    // Synchronizers for acks: B acks to A\n    reg [SYNC_STAGES-1:0] b_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] b_clear_ack_sync;\n    reg [SYNC_STAGES-1:0] b_release_ack_sync;\n\n    // Synchronizers for acks: A acks to B\n    reg [SYNC_STAGES-1:0] a_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] a_clear_ack_sync;\n    reg [SYNC_STAGES-1:0] a_release_ack_sync;\n\n    wire b_isolate_ack_synced = b_isolate_ack_sync[SYNC_STAGES-1];\n    wire b_clear_ack_synced   = b_clear_ack_sync[SYNC_STAGES-1];\n    wire b_release_ack_synced = b_release_ack_sync[SYNC_STAGES-1];\n\n    wire a_isolate_ack_synced = a_isolate_ack_sync[SYNC_STAGES-1];\n    wire a_clear_ack_synced   = a_clear_ack_sync[SYNC_STAGES-1];\n    wire a_release_ack_synced = a_release_ack_sync[SYNC_STAGES-1];\n\n    // Synchronizer for local clear request from peer\n    // Actually, the clear request from peer is the *_clear_i input\n    // We need to synchronize the peer's clear request to know when to start\n    // But the behavior says: when either side requests clear, first raise both isolate outputs\n    // So each side independently detects its own clear request and initiates the sequence\n    // The peer's clear request is synchronized to know when the peer has also requested\n\n    // Synchronize peer clear requests\n    reg [SYNC_STAGES-1:0] b_clear_i_sync;\n    reg [SYNC_STAGES-1:0] a_clear_i_sync;\n\n    wire b_clear_i_synced = b_clear_i_sync[SYNC_STAGES-1];\n    wire a_clear_i_synced = a_clear_i_sync[SYNC_STAGES-1];\n\n    // Synchronize peer isolate acks (local acks are already in local domain)\n    // a_isolate_ack_i is in A domain, b_isolate_ack_i is in B domain\n    // We need to synchronize b_isolate_ack_i to A domain and a_isolate_ack_i to B domain\n    // But wait, the acks are generated by the external logic in each domain\n    // a_isolate_ack_i is in A domain, so it's already synchronized for A\n    // b_isolate_ack_i is in B domain, so it's already synchronized for B\n    // We need to synchronize them across domains for the peer to know\n\n    // Actually, let me reconsider the architecture.\n    // Each domain has its own state machine.\n    // The state machine in domain A:\n    // - Detects a_clear_i\n    // - Raises a_isolate_o\n    // - Waits for a_isolate_ack_i (local) AND b_isolate_ack_synced (peer's isolate ack)\n    // - Raises a_clear_o\n    // - Waits for a_clear_ack_i (local) AND b_clear_ack_synced (peer's clear ack)\n    // - Releases a_clear_o\n    // - Waits for b_release_ack_synced (peer's release ack)\n    // - Releases a_isolate_o\n    // - Returns to idle\n\n    // But we also need to synchronize the isolate/clear/release requests to the peer\n    // so the peer knows to do the same.\n\n    // Let me redesign:\n    // Each side has a state machine that goes through the sequence.\n    // The requests (isolate, clear, release) are synchronized to the peer.\n    // The acks (isolate_ack, clear_ack, release_ack) are synchronized to the peer.\n    // Each side waits for both local and peer acks before proceeding.\n\n    // Domain A state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state <= S_IDLE;\n            a_isolate_o_r <= 1'b0;\n            a_clear_o_r <= 1'b0;\n            a_isolate_req_r <= 1'b0;\n            a_clear_req_r <= 1'b0;\n            a_release_req_r <= 1'b0;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r <= 1'b0;\n                    a_isolate_req_r <= 1'b0;\n                    a_clear_req_r <= 1'b0;\n                    a_release_req_r <= 1'b0;\n                    if (a_clear_i) begin\n                        a_state <= S_ISOLATE;\n                        a_isolate_o_r <= 1'b1;\n                        a_isolate_req_r <= 1'b1;\n                    end\n                end\n                S_ISOLATE: begin\n                    // Wait for both local and peer isolate acks\n                    if (a_isolate_ack_i && b_isolate_ack_synced) begin\n                        a_state <= S_CLEAR;\n                        a_clear_o_r <= 1'b1;\n                        a_clear_req_r <= 1'b1;\n                    end\n                end\n                S_CLEAR: begin\n                    // Wait for both local and peer clear acks\n                    if (a_clear_ack_i && b_clear_ack_synced) begin\n                        a_state <= S_RELEASE;\n                        a_clear_o_r <= 1'b0;\n                        a_release_req_r <= 1'b1;\n                    end\n                end\n                S_RELEASE: begin\n                    // Wait for peer release ack\n                    if (b_release_ack_synced) begin\n                        a_state <= S_IDLE;\n                        a_isolate_o_r <= 1'b0;\n                        a_isolate_req_r <= 1'b0;\n                        a_clear_req_r <= 1'b0;\n                        a_release_req_r <= 1'b0;\n                    end\n                end\n                default: begin\n                    a_state <= S_IDLE;\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r <= 1'b0;\n                    a_isolate_req_r <= 1'b0;\n                    a_clear_req_r <= 1'b0;\n                    a_release_req_r <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // Domain B state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state <= S_IDLE;\n            b_isolate_o_r <= 1'b0;\n            b_clear_o_r <= 1'b0;\n            b_isolate_req_r <= 1'b0;\n            b_clear_req_r <= 1'b0;\n            b_release_req_r <= 1'b0;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r <= 1'b0;\n                    b_isolate_req_r <= 1'b0;\n                    b_clear_req_r <= 1'b0;\n                    b_release_req_r <= 1'b0;\n                    if (b_clear_i) begin\n                        b_state <= S_ISOLATE;\n                        b_isolate_o_r <= 1'b1;\n                        b_isolate_req_r <= 1'b1;\n                    end\n                end\n                S_ISOLATE: begin\n                    // Wait for both local and peer isolate acks\n                    if (b_isolate_ack_i && a_isolate_ack_synced) begin\n                        b_state <= S_CLEAR;\n                        b_clear_o_r <= 1'b1;\n                        b_clear_req_r <= 1'b1;\n                    end\n                end\n                S_CLEAR: begin\n                    // Wait for both local and peer clear acks\n                    if (b_clear_ack_i && a_clear_ack_synced) begin\n                        b_state <= S_RELEASE;\n                        b_clear_o_r <= 1'b0;\n                        b_release_req_r <= 1'b1;\n                    end\n                end\n                S_RELEASE: begin\n                    // Wait for peer release ack\n                    if (a_release_ack_synced) begin\n                        b_state <= S_IDLE;\n                        b_isolate_o_r <= 1'b0;\n                        b_isolate_req_r <= 1'b0;\n                        b_clear_req_r <= 1'b0;\n                        b_release_req_r <= 1'b0;\n                    end\n                end\n                default: begin\n                    b_state <= S_IDLE;\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r <= 1'b0;\n                    b_isolate_req_r <= 1'b0;\n                    b_clear_req_r <= 1'b0;\n                    b_release_req_r <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // Synchronizers for A->B signals\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_isolate_req_sync <= {SYNC_STAGES{1'b0}};\n            a_clear_req_sync <= {SYNC_STAGES{1'b0}};\n            a_release_req_sync <= {SYNC_STAGES{1'b0}};\n            a_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n            a_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n            a_release_ack_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_isolate_req_sync <= {a_isolate_req_sync[SYNC_STAGES-2:0], a_isolate_req_r};\n            a_clear_req_sync <= {a_clear_req_sync[SYNC_STAGES-2:0], a_clear_req_r};\n            a_release_req_sync <= {a_release_req_sync[SYNC_STAGES-2:0], a_release_req_r};\n            a_isolate_ack_sync <= {a_isolate_ack_sync[SYNC_STAGES-2:0], a_isolate_ack_i};\n            a_clear_ack_sync <= {a_clear_ack_sync[SYNC_STAGES-2:0], a_clear_ack_i};\n            a_release_ack_sync <= {a_release_ack_sync[SYNC_STAGES-2:0], 1'b1}; // A release ack is implicit when A completes\n        end\n    end\n\n    // Synchronizers for B->A signals\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_isolate_req_sync <= {SYNC_STAGES{1'b0}};\n            b_clear_req_sync <= {SYNC_STAGES{1'b0}};\n            b_release_req_sync <= {SYNC_STAGES{1'b0}};\n            b_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n            b_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n            b_release_ack_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_isolate_req_sync <= {b_isolate_req_sync[SYNC_STAGES-2:0], b_isolate_req_r};\n            b_clear_req_sync <= {b_clear_req_sync[SYNC_STAGES-2:0], b_clear_req_r};\n            b_release_req_sync <= {b_release_req_sync[SYNC_STAGES-2:0], b_release_req_r};\n            b_isolate_ack_sync <= {b_isolate_ack_sync[SYNC_STAGES-2:0], b_isolate_ack_i};\n            b_clear_ack_sync <= {b_clear_ack_sync[SYNC_STAGES-2:0], b_clear_ack_i};\n            b_release_ack_sync <= {b_release_ack_sync[SYNC_STAGES-2:0], 1'b1}; // B release ack is implicit when B completes\n        end\n    end\n\n    // Synchronizers for peer clear requests\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_clear_i_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_clear_i_sync <= {a_clear_i_sync[SYNC_STAGES-2:0], a_clear_i};\n        end\n    end\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_clear_i_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_clear_i_sync <= {b_clear_i_sync[SYNC_STAGES-2:0], b_clear_i};\n        end\n    end\n\n    // Outputs\n    assign a_isolate_o = a_isolate_o_r;\n    assign a_clear_o = a_clear_o_r;\n    assign b_isolate_o = b_isolate_o_r;\n    assign b_clear_o = b_clear_o_r;\n\nendmodule\n```<|im_end|>",
