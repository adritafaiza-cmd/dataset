  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE     = 3'd0;\n    localparam S_ISOLATE  = 3'd1;\n    localparam S_CLEAR    = 3'd2;\n    localparam S_RELEASE  = 3'd3;\n\n    // A-side state\n    reg [2:0] a_state;\n    // B-side state\n    reg [2:0] b_state;\n\n    // A-side outputs\n    assign a_isolate_o = (a_state == S_ISOLATE) || (a_state == S_CLEAR);\n    assign a_clear_o   = (a_state == S_CLEAR);\n\n    // B-side outputs\n    assign b_isolate_o = (b_state == S_ISOLATE) || (b_state == S_CLEAR);\n    assign b_clear_o   = (b_state == S_CLEAR);\n\n    // Synchronizers for A-side signals to B domain\n    reg [SYNC_STAGES-1:0] a_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] a_clear_ack_sync;\n    reg [SYNC_STAGES-1:0] a_state_sync;\n\n    // Synchronizers for B-side signals to A domain\n    reg [SYNC_STAGES-1:0] b_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] b_clear_ack_sync;\n    reg [SYNC_STAGES-1:0] b_state_sync;\n\n    // Synchronize a_isolate_ack_i to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_isolate_ack_sync <= {a_isolate_ack_sync[SYNC_STAGES-2:0], a_isolate_ack_i};\n    end\n\n    // Synchronize a_clear_ack_i to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_clear_ack_sync <= {a_clear_ack_sync[SYNC_STAGES-2:0], a_clear_ack_i};\n    end\n\n    // Synchronize a_state to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_state_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_state_sync <= {a_state_sync[SYNC_STAGES-2:0], a_state[0]};\n    end\n\n    // Synchronize b_isolate_ack_i to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_isolate_ack_sync <= {b_isolate_ack_sync[SYNC_STAGES-2:0], b_isolate_ack_i};\n    end\n\n    // Synchronize b_clear_ack_i to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_clear_ack_sync <= {b_clear_ack_sync[SYNC_STAGES-2:0], b_clear_ack_i};\n    end\n\n    // Synchronize b_state to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_state_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_state_sync <= {b_state_sync[SYNC_STAGES-2:0], b_state[0]};\n    end\n\n    // A-side state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            a_state <= S_IDLE;\n        else begin\n            case (a_state)\n                S_IDLE: begin\n                    if (a_clear_i || b_clear_ack_sync[SYNC_STAGES-1])\n                        a_state <= S_ISOLATE;\n                end\n                S_ISOLATE: begin\n                    if (a_isolate_ack_i && b_isolate_ack_sync[SYNC_STAGES-1])\n                        a_state <= S_CLEAR;\n                end\n                S_CLEAR: begin\n                    if (a_clear_ack_i && b_clear_ack_sync[SYNC_STAGES-1])\n                        a_state <= S_RELEASE;\n                end\n                S_RELEASE: begin\n                    if (b_state_sync[SYNC_STAGES-1] == 1'b0) // peer is idle\n                        a_state <= S_IDLE;\n                end\n                default: a_state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // B-side state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            b_state <= S_IDLE;\n        else begin\n            case (b_state)\n                S_IDLE: begin\n                    if (b_clear_i || a_clear_ack_sync[SYNC_STAGES-1])\n                        b_state <= S_ISOLATE;\n                end\n                S_ISOLATE: begin\n                    if (b_isolate_ack_i && a_isolate_ack_sync[SYNC_STAGES-1])\n                        b_state <= S_CLEAR;\n                end\n                S_CLEAR: begin\n                    if (b_clear_ack_i && a_clear_ack_sync[SYNC_STAGES-1])\n                        b_state <= S_RELEASE;\n                end\n                S_RELEASE: begin\n                    if (a_state_sync[SYNC_STAGES-1] == 1'b0) // peer is idle\n                        b_state <= S_IDLE;\n                end\n                default: b_state <= S_IDLE;\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
