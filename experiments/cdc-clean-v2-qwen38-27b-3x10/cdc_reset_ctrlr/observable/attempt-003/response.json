{
  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE     = 3'd0;\n    localparam S_ISOLATE  = 3'd1;\n    localparam S_CLEAR    = 3'd2;\n    localparam S_RELEASE  = 3'd3;\n\n    // A-side state\n    reg [2:0] a_state;\n    reg       a_isolate_o_r;\n    reg       a_clear_o_r;\n\n    // B-side state\n    reg [2:0] b_state;\n    reg       b_isolate_o_r;\n    reg       b_clear_o_r;\n\n    // A-side synchronized B-side status\n    reg [2:0] b_state_sync_a;\n    reg [2:0] b_state_sync_a_d1;\n    reg [2:0] b_state_sync_a_d2;\n\n    // B-side synchronized A-side status\n    reg [2:0] a_state_sync_b;\n    reg [2:0] a_state_sync_b_d1;\n    reg [2:0] a_state_sync_b_d2;\n\n    // Synchronize B state into A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_state_sync_a_d1 <= 3'd0;\n            b_state_sync_a_d2 <= 3'd0;\n        end else begin\n            b_state_sync_a_d1 <= b_state;\n            b_state_sync_a_d2 <= b_state_sync_a_d1;\n        end\n    end\n    assign b_state_sync_a = b_state_sync_a_d2;\n\n    // Synchronize A state into B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_state_sync_b_d1 <= 3'd0;\n            a_state_sync_b_d2 <= 3'd0;\n        end else begin\n            a_state_sync_b_d1 <= a_state;\n            a_state_sync_b_d2 <= a_state_sync_b_d1;\n        end\n    end\n    assign a_state_sync_b = a_state_sync_b_d2;\n\n    // A-side FSM\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state       <= S_IDLE;\n            a_isolate_o_r <= 1'b0;\n            a_clear_o_r   <= 1'b0;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    if (a_clear_i || b_clear_i) begin\n                        a_state       <= S_ISOLATE;\n                        a_isolate_o_r <= 1'b1;\n                        a_clear_o_r   <= 1'b0;\n                    end\n                end\n                S_ISOLATE: begin\n                    // Wait for both sides to acknowledge isolation\n                    if (a_isolate_ack_i && b_isolate_ack_i) begin\n                        a_state       <= S_CLEAR;\n                        a_isolate_o_r <= 1'b1;\n                        a_clear_o_r   <= 1'b1;\n                    end\n                end\n                S_CLEAR: begin\n                    // Wait for both sides to acknowledge clear\n                    if (a_clear_ack_i && b_clear_ack_i) begin\n                        a_state       <= S_RELEASE;\n                        a_isolate_o_r <= 1'b1;\n                        a_clear_o_r   <= 1'b0;\n                    end\n                end\n                S_RELEASE: begin\n                    // Wait for both sides to acknowledge release\n                    if (a_isolate_ack_i && b_isolate_ack_i) begin\n                        a_state       <= S_IDLE;\n                        a_isolate_o_r <= 1'b0;\n                        a_clear_o_r   <= 1'b0;\n                    end\n                end\n                default: begin\n                    a_state       <= S_IDLE;\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r   <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // B-side FSM\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state       <= S_IDLE;\n            b_isolate_o_r <= 1'b0;\n            b_clear_o_r   <= 1'b0;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    if (a_clear_i || b_clear_i) begin\n                        b_state       <= S_ISOLATE;\n                        b_isolate_o_r <= 1'b1;\n                        b_clear_o_r   <= 1'b0;\n                    end\n                end\n                S_ISOLATE: begin\n                    // Wait for both sides to acknowledge isolation\n                    if (a_isolate_ack_i && b_isolate_ack_i) begin\n                        b_state       <= S_CLEAR;\n                        b_isolate_o_r <= 1'b1;\n                        b_clear_o_r   <= 1'b1;\n                    end\n                end\n                S_CLEAR: begin\n                    // Wait for both sides to acknowledge clear\n                    if (a_clear_ack_i && b_clear_ack_i) begin\n                        b_state       <= S_RELEASE;\n                        b_isolate_o_r <= 1'b1;\n                        b_clear_o_r   <= 1'b0;\n                    end\n                end\n                S_RELEASE: begin\n                    // Wait for both sides to acknowledge release\n                    if (a_isolate_ack_i && b_isolate_ack_i) begin\n                        b_state       <= S_IDLE;\n                        b_isolate_o_r <= 1'b0;\n                        b_clear_o_r   <= 1'b0;\n                    end\n                end\n                default: begin\n                    b_state       <= S_IDLE;\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r   <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    assign a_isolate_o = a_isolate_o_r;\n    assign a_clear_o   = a_clear_o_r;\n    assign b_isolate_o = b_isolate_o_r;\n    assign b_clear_o   = b_clear_o_r;\n\nendmodule\n```<|im_end|>",
