{
  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE      = 3'd0;\n    localparam S_ISOLATE   = 3'd1;\n    localparam S_CLEAR     = 3'd2;\n    localparam S_RELEASE   = 3'd3;\n    localparam S_DEISOLATE = 3'd4;\n\n    // A-side state\n    reg [2:0] a_state;\n    reg       a_isolate_o_r;\n    reg       a_clear_o_r;\n\n    // B-side state\n    reg [2:0] b_state;\n    reg       b_isolate_o_r;\n    reg       b_clear_o_r;\n\n    // CDC: A -> B (A's progress)\n    reg [2:0] a_state_to_b;\n    reg [2:0] a_state_to_b_sync1;\n    reg [2:0] a_state_to_b_sync2;\n\n    // CDC: B -> A (B's progress)\n    reg [2:0] b_state_to_a;\n    reg [2:0] b_state_to_a_sync1;\n    reg [2:0] b_state_to_a_sync2;\n\n    // A-side outputs\n    assign a_isolate_o = a_isolate_o_r;\n    assign a_clear_o   = a_clear_o_r;\n\n    // B-side outputs\n    assign b_isolate_o = b_isolate_o_r;\n    assign b_clear_o   = b_clear_o_r;\n\n    // A-side state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state       <= S_IDLE;\n            a_isolate_o_r <= 1'b0;\n            a_clear_o_r   <= 1'b0;\n            a_state_to_b  <= S_IDLE;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r   <= 1'b0;\n                    if (a_clear_i || b_state_to_a_sync2 != S_IDLE) begin\n                        a_state      <= S_ISOLATE;\n                        a_isolate_o_r <= 1'b1;\n                        a_state_to_b  <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b0;\n                    if (a_isolate_ack_i && b_state_to_a_sync2 == S_ISOLATE) begin\n                        a_state      <= S_CLEAR;\n                        a_clear_o_r  <= 1'b1;\n                        a_state_to_b <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b1;\n                    if (a_clear_ack_i && b_state_to_a_sync2 == S_CLEAR) begin\n                        a_state      <= S_RELEASE;\n                        a_clear_o_r  <= 1'b0;\n                        a_state_to_b <= S_RELEASE;\n                    end\n                end\n                S_RELEASE: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b0;\n                    if (b_state_to_a_sync2 == S_RELEASE) begin\n                        a_state      <= S_DEISOLATE;\n                        a_isolate_o_r <= 1'b0;\n                        a_state_to_b  <= S_DEISOLATE;\n                    end\n                end\n                S_DEISOLATE: begin\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r   <= 1'b0;\n                    if (b_state_to_a_sync2 == S_IDLE) begin\n                        a_state      <= S_IDLE;\n                        a_state_to_b <= S_IDLE;\n                    end\n                end\n                default: begin\n                    a_state       <= S_IDLE;\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r   <= 1'b0;\n                    a_state_to_b  <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // B-side state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state       <= S_IDLE;\n            b_isolate_o_r <= 1'b0;\n            b_clear_o_r   <= 1'b0;\n            b_state_to_a  <= S_IDLE;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r   <= 1'b0;\n                    if (b_clear_i || a_state_to_b_sync2 != S_IDLE) begin\n                        b_state      <= S_ISOLATE;\n                        b_isolate_o_r <= 1'b1;\n                        b_state_to_a  <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b0;\n                    if (b_isolate_ack_i && a_state_to_b_sync2 == S_ISOLATE) begin\n                        b_state      <= S_CLEAR;\n                        b_clear_o_r  <= 1'b1;\n                        b_state_to_a <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b1;\n                    if (b_clear_ack_i && a_state_to_b_sync2 == S_CLEAR) begin\n                        b_state      <= S_RELEASE;\n                        b_clear_o_r  <= 1'b0;\n                        b_state_to_a <= S_RELEASE;\n                    end\n                end\n                S_RELEASE: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b0;\n                    if (a_state_to_b_sync2 == S_RELEASE) begin\n                        b_state      <= S_DEISOLATE;\n                        b_isolate_o_r <= 1'b0;\n                        b_state_to_a  <= S_DEISOLATE;\n                    end\n                end\n                S_DEISOLATE: begin\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r   <= 1'b0;\n                    if (a_state_to_b_sync2 == S_IDLE) begin\n                        b_state      <= S_IDLE;\n                        b_state_to_a <= S_IDLE;\n                    end\n                end\n                default: begin\n                    b_state       <= S_IDLE;\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r   <= 1'b0;\n                    b_state_to_a  <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // CDC synchronizers: A -> B\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_state_to_b_sync1 <= S_IDLE;\n            a_state_to_b_sync2 <= S_IDLE;\n        end else begin\n            a_state_to_b_sync1 <= a_state_to_b;\n            a_state_to_b_sync2 <= a_state_to_b_sync1;\n        end\n    end\n\n    // CDC synchronizers: B -> A\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_state_to_a_sync1 <= S_IDLE;\n            b_state_to_a_sync2 <= S_IDLE;\n        end else begin\n            b_state_to_a_sync1 <= b_state_to_a;\n            b_state_to_a_sync2 <= b_state_to_a_sync1;\n        end\n    end\n\nendmodule\n```<|im_end|>",
