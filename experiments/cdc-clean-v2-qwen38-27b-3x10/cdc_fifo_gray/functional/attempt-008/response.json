  "text": "```verilog\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [PTR_W-1:0] dst_rd_ptr_sync;\n\n    // Destination domain\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [PTR_W-1:0] src_wr_ptr_sync;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Synchronizer for write pointer (src -> dst)\n    reg [PTR_W-1:0] wr_ptr_sync [0:SYNC_STAGES-1];\n    // Synchronizer for read pointer (dst -> src)\n    reg [PTR_W-1:0] rd_ptr_sync [0:SYNC_STAGES-1];\n\n    // Source domain logic\n    wire src_wr_ptr_gray = src_wr_ptr ^ (src_wr_ptr >> 1);\n    wire dst_rd_ptr_gray_sync = dst_rd_ptr_sync ^ (dst_rd_ptr_sync >> 1);\n\n    wire src_full = (src_wr_ptr_gray == dst_rd_ptr_gray_sync) &&\n                    (src_wr_ptr[PTR_W-1] != dst_rd_ptr_sync[PTR_W-1]);\n\n    wire src_can_write = src_valid_i && !src_full;\n\n    assign src_ready_o = !src_full;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n        end else if (src_can_write) begin\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n        end\n    end\n\n    // Synchronize write pointer to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            wr_ptr_sync[0] <= {PTR_W{1'b0}};\n            wr_ptr_sync[1] <= {PTR_W{1'b0}};\n            for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                wr_ptr_sync[i] <= {PTR_W{1'b0}};\n        end else begin\n            wr_ptr_sync[0] <= src_wr_ptr_gray;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                wr_ptr_sync[i] <= wr_ptr_sync[i-1];\n        end\n    end\n\n    // Convert synchronized gray write pointer to binary\n    reg [PTR_W-1:0] src_wr_ptr_sync_gray;\n    assign src_wr_ptr_sync_gray = wr_ptr_sync[SYNC_STAGES-1];\n\n    reg [PTR_W-1:0] src_wr_ptr_sync_bin;\n    integer i;\n    always @* begin\n        src_wr_ptr_sync_bin[PTR_W-1] = src_wr_ptr_sync_gray[PTR_W-1];\n        for (i = PTR_W-2; i >= 0; i = i - 1)\n            src_wr_ptr_sync_bin[i] = src_wr_ptr_sync_bin[i+1] ^ src_wr_ptr_sync_gray[i];\n    end\n\n    // Destination domain logic\n    wire dst_rd_ptr_gray = dst_rd_ptr ^ (dst_rd_ptr >> 1);\n\n    wire dst_empty = (dst_rd_ptr_gray == src_wr_ptr_sync_gray);\n\n    wire dst_can_read = dst_valid_reg && dst_ready_i;\n\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_can_read) begin\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                dst_valid_reg <= 1'b0;\n            end else if (!dst_valid_reg && !dst_empty) begin\n                dst_data_reg <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n                dst_valid_reg <= 1'b1;\n            end\n        end\n    end\n\n    // Synchronize read pointer to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            rd_ptr_sync[0] <= {PTR_W{1'b0}};\n            rd_ptr_sync[1] <= {PTR_W{1'b0}};\n            for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                rd_ptr_sync[i] <= {PTR_W{1'b0}};\n        end else begin\n            rd_ptr_sync[0] <= dst_rd_ptr_gray;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                rd_ptr_sync[i] <= rd_ptr_sync[i-1];\n        end\n    end\n\n    // Convert synchronized gray read pointer to binary\n    reg [PTR_W-1:0] dst_rd_ptr_sync_gray;\n    assign dst_rd_ptr_sync_gray = rd_ptr_sync[SYNC_STAGES-1];\n\n    always @* begin\n        dst_rd_ptr_sync[PTR_W-1] = dst_rd_ptr_sync_gray[PTR_W-1];\n        for (i = PTR_W-2; i >= 0; i = i - 1)\n            dst_rd_ptr_sync[i] = dst_rd_ptr_sync[i+1] ^ dst_rd_ptr_sync_gray[i];\n    end\n\nendmodule\n```<|im_end|>",
