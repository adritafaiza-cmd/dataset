  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH;\n\n    // Source side state\n    reg src_idle;\n    reg src_setup;\n    reg src_access;\n    reg src_done;\n\n    // Destination side state\n    reg dst_idle;\n    reg dst_setup;\n    reg dst_access;\n    reg dst_done;\n\n    // FIFO pointers\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [PTR_W-1:0] dst_rd_ptr;\n\n    // FIFO data storage\n    reg [ADDR_WIDTH-1:0] fifo_addr [0:DEPTH-1];\n    reg [DATA_WIDTH-1:0] fifo_wdata [0:DEPTH-1];\n    reg [DATA_WIDTH/8-1:0] fifo_strb [0:DEPTH-1];\n    reg [2:0] fifo_pprot [0:DEPTH-1];\n    reg fifo_write [0:DEPTH-1];\n\n    // Read data return path\n    reg [DATA_WIDTH-1:0] rdata_reg;\n    reg rslverr_reg;\n    reg rdata_valid;\n\n    // Synchronization signals\n    reg [1:0] src_req_sync;\n    reg [1:0] dst_done_sync;\n\n    // Source side logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_idle <= 1'b1;\n            src_setup <= 1'b0;\n            src_access <= 1'b0;\n            src_done <= 1'b0;\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_req_sync <= 2'b00;\n            rdata_reg <= {DATA_WIDTH{1'b0}};\n            rslverr_reg <= 1'b0;\n            rdata_valid <= 1'b0;\n        end else begin\n            case ({src_idle, src_setup, src_access, src_done})\n                4'b1000: begin // IDLE\n                    if (src_psel_i) begin\n                        src_idle <= 1'b0;\n                        src_setup <= 1'b1;\n                    end\n                end\n                4'b0100: begin // SETUP\n                    if (src_penable_i) begin\n                        src_setup <= 1'b0;\n                        src_access <= 1'b1;\n                        // Write to FIFO\n                        fifo_addr[src_wr_ptr] <= src_paddr_i;\n                        fifo_wdata[src_wr_ptr] <= src_pwdata_i;\n                        fifo_strb[src_wr_ptr] <= src_pstrb_i;\n                        fifo_pprot[src_wr_ptr] <= src_pprot_i;\n                        fifo_write[src_wr_ptr] <= src_pwrite_i;\n                        src_wr_ptr <= src_wr_ptr + 1'b1;\n                        src_req_sync <= 2'b11;\n                    end\n                end\n                4'b0010: begin // ACCESS\n                    if (dst_done_sync[1]) begin\n                        src_access <= 1'b0;\n                        src_done <= 1'b1;\n                        rdata_reg <= dst_prdata_i;\n                        rslverr_reg <= dst_pslverr_i;\n                        rdata_valid <= 1'b1;\n                        src_req_sync <= 2'b00;\n                    end\n                end\n                4'b0001: begin // DONE\n                    src_done <= 1'b0;\n                    src_idle <= 1'b1;\n                    rdata_valid <= 1'b0;\n                end\n                default: begin\n                    src_idle <= 1'b1;\n                    src_setup <= 1'b0;\n                    src_access <= 1'b0;\n                    src_done <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // Destination side logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_idle <= 1'b1;\n            dst_setup <= 1'b0;\n            dst_access <= 1'b0;\n            dst_done <= 1'b0;\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_done_sync <= 2'b00;\n        end else begin\n            case ({dst_idle, dst_setup, dst_access, dst_done})\n                4'b1000: begin // IDLE\n                    if (src_req_sync[1]) begin\n                        dst_idle <= 1'b0;\n                        dst_setup <= 1'b1;\n                    end\n                end\n                4'b0100: begin // SETUP\n                    dst_setup <= 1'b0;\n                    dst_access <= 1'b1;\n                end\n                4'b0010: begin // ACCESS\n                    if (dst_pready_i) begin\n                        dst_access <= 1'b0;\n                        dst_done <= 1'b1;\n                        dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                        dst_done_sync <= 2'b11;\n                    end\n                end\n                4'b0001: begin // DONE\n                    dst_done <= 1'b0;\n                    dst_idle <= 1'b1;\n                    dst_done_sync <= 2'b00;\n                end\n                default: begin\n                    dst_idle <= 1'b1;\n                    dst_setup <= 1'b0;\n                    dst_access <= 1'b0;\n                    dst_done <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // Synchronizers\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            dst_done_sync <= 2'b00;\n        else\n            dst_done_sync <= {dst_done_sync[0], dst_done_sync[1]};\n    end\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            src_req_sync <= 2'b00;\n        else\n            src_req_sync <= {src_req_sync[0], src_req_sync[1]};\n    end\n\n    // Output assignments\n    assign src_pready_o = src_access & dst_done_sync[1];\n    assign src_prdata_o = rdata_reg;\n    assign src_pslverr_o = rslverr_reg;\n\n    assign dst_psel_o = dst_setup | dst_access;\n    assign dst_penable_o = dst_access;\n    assign dst_pwrite_o = fifo_write[dst_rd_ptr];\n    assign dst_paddr_o = fifo_addr[dst_rd_ptr];\n    assign dst_pwdata_o = fifo_wdata[dst_rd_ptr];\n    assign dst_pstrb_o = fifo_strb[dst_rd_ptr];\n    assign dst_pprot_o = fifo_pprot[dst_rd_ptr];\n\nendmodule\n```<|im_end|>",
