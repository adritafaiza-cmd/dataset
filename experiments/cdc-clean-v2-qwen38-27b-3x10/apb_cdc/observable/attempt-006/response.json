  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam AW = LOG_DEPTH;\n\n    // Request FIFO (src -> dst)\n    reg [ADDR_WIDTH-1:0] req_addr [0:DEPTH-1];\n    reg [DATA_WIDTH-1:0] req_wdata [0:DEPTH-1];\n    reg [DATA_WIDTH/8-1:0] req_strb [0:DEPTH-1];\n    reg [2:0] req_prot [0:DEPTH-1];\n    reg req_write [0:DEPTH-1];\n\n    reg [AW:0] req_wr_ptr;\n    reg [AW:0] req_rd_ptr;\n\n    // Response FIFO (dst -> src)\n    reg [DATA_WIDTH-1:0] rsp_data [0:DEPTH-1];\n    reg rsp_err [0:DEPTH-1];\n\n    reg [AW:0] rsp_wr_ptr;\n    reg [AW:0] rsp_rd_ptr;\n\n    // Gray code pointers for CDC\n    wire [AW:0] req_wr_ptr_gray = req_wr_ptr ^ (req_wr_ptr >> 1);\n    wire [AW:0] req_rd_ptr_gray = req_rd_ptr ^ (req_rd_ptr >> 1);\n    wire [AW:0] rsp_wr_ptr_gray = rsp_wr_ptr ^ (rsp_wr_ptr >> 1);\n    wire [AW:0] rsp_rd_ptr_gray = rsp_rd_ptr ^ (rsp_rd_ptr >> 1);\n\n    // Synchronizers for request pointers\n    reg [AW:0] req_wr_ptr_gray_dst_s1;\n    reg [AW:0] req_wr_ptr_gray_dst_s2;\n    reg [AW:0] req_rd_ptr_gray_src_s1;\n    reg [AW:0] req_rd_ptr_gray_src_s2;\n\n    // Synchronizers for response pointers\n    reg [AW:0] rsp_wr_ptr_gray_src_s1;\n    reg [AW:0] rsp_wr_ptr_gray_src_s2;\n    reg [AW:0] rsp_rd_ptr_gray_dst_s1;\n    reg [AW:0] rsp_rd_ptr_gray_dst_s2;\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            req_wr_ptr_gray_dst_s1 <= {AW+1{1'b0}};\n            req_wr_ptr_gray_dst_s2 <= {AW+1{1'b0}};\n        end else begin\n            req_wr_ptr_gray_dst_s1 <= req_wr_ptr_gray;\n            req_wr_ptr_gray_dst_s2 <= req_wr_ptr_gray_dst_s1;\n        end\n    end\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            req_rd_ptr_gray_src_s1 <= {AW+1{1'b0}};\n            req_rd_ptr_gray_src_s2 <= {AW+1{1'b0}};\n        end else begin\n            req_rd_ptr_gray_src_s1 <= req_rd_ptr_gray;\n            req_rd_ptr_gray_src_s2 <= req_rd_ptr_gray_src_s1;\n        end\n    end\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            rsp_wr_ptr_gray_src_s1 <= {AW+1{1'b0}};\n            rsp_wr_ptr_gray_src_s2 <= {AW+1{1'b0}};\n        end else begin\n            rsp_wr_ptr_gray_src_s1 <= rsp_wr_ptr_gray;\n            rsp_wr_ptr_gray_src_s2 <= rsp_wr_ptr_gray_src_s1;\n        end\n    end\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            rsp_rd_ptr_gray_dst_s1 <= {AW+1{1'b0}};\n            rsp_rd_ptr_gray_dst_s2 <= {AW+1{1'b0}};\n        end else begin\n            rsp_rd_ptr_gray_dst_s1 <= rsp_rd_ptr_gray;\n            rsp_rd_ptr_gray_dst_s2 <= rsp_rd_ptr_gray_dst_s1;\n        end\n    end\n\n    // Convert gray to binary\n    function [AW:0] gray2bin;\n        input [AW:0] gray;\n        reg [AW:0] bin;\n        integer i;\n        begin\n            bin[AW] = gray[AW];\n            for (i = AW-1; i >= 0; i = i - 1)\n                bin[i] = bin[i+1] ^ gray[i];\n            gray2bin = bin;\n        end\n    endfunction\n\n    wire [AW:0] req_wr_ptr_dst = gray2bin(req_wr_ptr_gray_dst_s2);\n    wire [AW:0] req_rd_ptr_src = gray2bin(req_rd_ptr_gray_src_s2);\n    wire [AW:0] rsp_wr_ptr_src = gray2bin(rsp_wr_ptr_gray_src_s2);\n    wire [AW:0] rsp_rd_ptr_dst = gray2bin(rsp_rd_ptr_gray_dst_s2);\n\n    // FIFO full/empty conditions\n    wire req_full = (req_wr_ptr[AW] != req_rd_ptr_src[AW]) &&\n                    (req_wr_ptr[AW-1:0] == req_rd_ptr_src[AW-1:0]);\n    wire req_empty = (req_wr_ptr == req_rd_ptr);\n\n    wire rsp_full = (rsp_wr_ptr[AW] != rsp_rd_ptr_dst[AW]) &&\n                    (rsp_wr_ptr[AW-1:0] == rsp_rd_ptr_dst[AW-1:0]);\n    wire rsp_empty = (rsp_wr_ptr == rsp_rd_ptr);\n\n    // Source side: APB slave interface\n    reg src_pready_r;\n    reg [DATA_WIDTH-1:0] src_prdata_r;\n    reg src_pslverr_r;\n\n    // Detect setup phase: PSEL high, PENABLE low\n    wire src_setup = src_psel_i && !src_penable_i;\n    // Detect access phase: PSEL high, PENABLE high\n    wire src_access = src_psel_i && src_penable_i;\n\n    // Can we accept a new request?\n    wire can_accept = src_setup && !req_full;\n\n    // Write to request FIFO\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            req_wr_ptr <= {AW+1{1'b0}};\n        end else if (can_accept) begin\n            req_addr[req_wr_ptr[AW-1:0]] <= src_paddr_i;\n            req_wdata[req_wr_ptr[AW-1:0]] <= src_pwdata_i;\n            req_strb[req_wr_ptr[AW-1:0]] <= src_pstrb_i;\n            req_prot[req_wr_ptr[AW-1:0]] <= src_pprot_i;\n            req_write[req_wr_ptr[AW-1:0]] <= src_pwrite_i;\n            req_wr_ptr <= req_wr_ptr + 1'b1;\n        end\n    end\n\n    // Read from response FIFO\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            rsp_rd_ptr <= {AW+1{1'b0}};\n            src_pready_r <= 1'b0;\n            src_prdata_r <= {DATA_WIDTH{1'b0}};\n            src_pslverr_r <= 1'b0;\n        end else begin\n            if (!rsp_empty) begin\n                src_prdata_r <= rsp_data[rsp_rd_ptr[AW-1:0]];\n                src_pslverr_r <= rsp_err[rsp_rd_ptr[AW-1:0]];\n                rsp_rd_ptr <= rsp_rd_ptr + 1'b1;\n            end\n            // Pready is high when we have a response ready and are in access phase\n            // Actually, pready should be asserted when the response is available\n            // We assert pready when we have a response and the source is in access phase\n            // But we need to be careful: pready should be stable during the access phase\n            // Let's assert pready when rsp is not empty\n            src_pready_r <= !rsp_empty;\n        end\n    end\n\n    assign src_pready_o = src_pready_r;\n    assign src_prdata_o = src_prdata_r;\n    assign src_pslverr_o = src_pslverr_r;\n\n    // Destination side: APB master interface\n    reg dst_psel_r;\n    reg dst_penable_r;\n    reg dst_pwrite_r;\n    reg [ADDR_WIDTH-1:0] dst_paddr_r;\n    reg [DATA_WIDTH-1:0] dst_pwdata_r;\n    reg [DATA_WIDTH/8-1:0] dst_pstrb_r;\n    reg [2:0] dst_pprot_r;\n\n    // State machine for destination APB master\n    // States: IDLE, SETUP, ACCESS\n    localparam S_IDLE = 2'b00;\n    localparam S_SETUP = 2'b01;\n    localparam S_ACCESS = 2'b10;\n\n    reg [1:0] dst_state;\n\n    // Read from request FIFO\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            req_rd_ptr <= {AW+1{1'b0}};\n            dst_state <= S_IDLE;\n            dst_psel_r <= 1'b0;\n            dst_penable_r <= 1'b0;\n            dst_pwrite_r <= 1'b0;\n            dst_paddr_r <= {ADDR_WIDTH{1'b0}};\n            dst_pwdata_r <= {DATA_WIDTH{1'b0}};\n            dst_pstrb_r <= {DATA_WIDTH/8{1'b0}};\n            dst_pprot_r <= 3'b0;\n        end else begin\n            case (dst_state)\n                S_IDLE: begin\n                    dst_psel_r <= 1'b0;\n                    dst_penable_r <= 1'b0;\n                    if (!req_empty) begin\n                        dst_paddr_r <= req_addr[req_rd_ptr[AW-1:0]];\n                        dst_pwdata_r <= req_wdata[req_rd_ptr[AW-1:0]];\n                        dst_pstrb_r <= req_strb[req_rd_ptr[AW-1:0]];\n                        dst_pprot_r <= req_prot[req_rd_ptr[AW-1:0]];\n                        dst_pwrite_r <= req_write[req_rd_ptr[AW-1:0]];\n                        dst_state <= S_SETUP;\n                    end\n                end\n                S_SETUP: begin\n                    dst_psel_r <= 1'b1;\n                    dst_penable_r <= 1'b0;\n                    dst_state <= S_ACCESS;\n                end\n                S_ACCESS: begin\n                    dst_psel_r <= 1'b1;\n                    dst_penable_r <= 1'b1;\n                    if (dst_pready_i) begin\n                        // Write response to FIFO\n                        if (!rsp_full) begin\n                            rsp_data[rsp_wr_ptr[AW-1:0]] <= dst_prdata_i;\n                            rsp_err[rsp_wr_ptr[AW-1:0]] <= dst_pslverr_i;\n                            rsp_wr_ptr <= rsp_wr_ptr + 1'b1;\n                        end\n                        // Advance request read pointer\n                        req_rd_ptr <= req_rd_ptr + 1'b1;\n                        dst_state <= S_IDLE;\n                    end\n                end\n                default: begin\n                    dst_state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    assign dst_psel_o = dst_psel_r;\n    assign dst_penable_o = dst_penable_r;\n    assign dst_pwrite_o = dst_pwrite_r;\n    assign dst_paddr_o = dst_paddr_r;\n    assign dst_pwdata_o = dst_pwdata_r;\n    assign dst_pstrb_o = dst_pstrb_r;\n    assign dst_pprot_o = dst_pprot_r;\n\nendmodule\n```<|im_end|>",
