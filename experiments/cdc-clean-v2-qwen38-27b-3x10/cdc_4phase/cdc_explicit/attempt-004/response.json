  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire [WIDTH-1:0] src_payload;\n  wire src_valid_int;\n  wire src_ready_int;\n  wire dst_valid_int;\n  wire dst_ready_int;\n  wire [WIDTH-1:0] dst_payload;\n\n  // Source domain: capture data and valid when handshake occurs\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_valid_reg;\n  reg src_ready_reg;\n\n  // Destination domain: capture data and valid\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n  reg dst_ready_reg;\n\n  // Synchronization chains for control signals\n  // src_valid -> dst domain\n  reg [2:0] src_valid_sync;\n  // dst_ready -> src domain\n  reg [2:0] dst_ready_sync;\n\n  // Synchronization chains for payload (multi-bit, must be stable during transfer)\n  // We use a 2-stage synchronizer for each bit of the payload, but since the payload\n  // must be stable, we synchronize the entire payload as a multi-bit signal using\n  // a handshake-based approach or by ensuring stability.\n  //\n  // For CDC safety with multi-bit data, we use a 2-phase handshake where the data\n  // is held stable until acknowledged. The standard approach is to use a 2-stage\n  // synchronizer for the control signal and ensure the data is stable.\n  //\n  // Architecture:\n  // - Source captures data and asserts src_valid_reg\n  // - src_valid_reg is synchronized to dst domain (2 stages)\n  // - When dst sees src_valid_sync[2] high, it captures the payload (which has been\n  //   stable since src_valid_reg was asserted) and asserts dst_valid_reg\n  // - dst_valid_reg is synchronized back to src domain (2 stages)\n  // - When src sees dst_valid_sync[2] high, it deasserts src_valid_reg and can accept new data\n  // - dst_ready_reg is synchronized to src domain to indicate when dst can accept new data\n  //\n  // Actually, let's use a simpler 4-phase handshake:\n  // 1. src_valid_reg goes high (with data stable)\n  // 2. dst sees src_valid_sync[2] high, captures data, asserts dst_valid_reg\n  // 3. dst_valid_reg is synchronized to src\n  // 4. src sees dst_valid_sync[2] high, deasserts src_valid_reg\n  // 5. dst sees src_valid_sync[2] low, deasserts dst_valid_reg\n  //\n  // But this is a 4-phase handshake. Let's implement it properly.\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg  <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n    end else begin\n      // If dst has acknowledged (dst_valid_sync[2] high), we can deassert valid\n      // and accept new data\n      if (dst_ready_sync[2]) begin\n        // Destination is ready to accept new data\n        src_valid_reg <= 1'b0;\n        src_ready_reg <= 1'b1;\n        if (src_valid_i) begin\n          src_data_reg  <= src_data_i;\n          src_valid_reg <= 1'b1;\n        end\n      end else if (src_valid_reg) begin\n        // Waiting for destination to acknowledge\n        src_ready_reg <= 1'b0;\n      end else begin\n        // Idle, can accept new data\n        src_ready_reg <= 1'b1;\n        if (src_valid_i) begin\n          src_data_reg  <= src_data_i;\n          src_valid_reg <= 1'b1;\n        end\n      end\n    end\n  end\n\n  // Synchronize src_valid_reg to dst domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_valid_sync <= 3'b000;\n    end else begin\n      src_valid_sync <= {src_valid_sync[1:0], src_valid_reg};\n    end\n  end\n\n  // Synchronize dst_ready_reg to src domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_ready_sync <= 3'b000;\n    end else begin\n      dst_ready_sync <= {dst_ready_sync[1:0], dst_ready_reg};\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b1;\n    end else begin\n      if (src_valid_sync[2]) begin\n        // Source has valid data, capture it\n        dst_data_reg  <= src_data_reg;\n        dst_valid_reg <= 1'b1;\n        dst_ready_reg <= 1'b0;\n      end else if (dst_valid_reg) begin\n        // Waiting for destination to be ready\n        dst_ready_reg <= 1'b0;\n        if (dst_ready_i) begin\n          dst_valid_reg <= 1'b0;\n          dst_ready_reg <= 1'b1;\n        end\n      end else begin\n        // Idle, ready to accept new data\n        dst_ready_reg <= 1'b1;\n      end\n    end\n  end\n\n  // Synchronize dst_valid_reg to src domain (for src to know when to deassert)\n  // Actually, we need to synchronize dst_ready_reg back to src, which we already do.\n  // But we also need to handle the case where dst_valid_reg is high and dst_ready_i is low.\n\n  // Let's reconsider the architecture. The 4-phase handshake should be:\n  // 1. src_valid_reg high, data stable\n  // 2. dst captures data, dst_valid_reg high\n  // 3. dst_ready_i high, dst_valid_reg deasserts\n  // 4. src sees dst_ready_sync[2] high, src_valid_reg deasserts\n  //\n  // But this doesn't quite work because dst_ready_reg is not the same as dst_ready_i.\n  // Let's use a different approach.\n\n  // Actually, let's use a simpler approach with a 2-stage synchronizer for the\n  // control signal and ensure the data is stable.\n\n  // Source domain: capture data and valid\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg  <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n    end else begin\n      if (src_valid_reg) begin\n        // Waiting for destination to acknowledge\n        src_ready_reg <= 1'b0;\n        if (dst_ready_sync[2]) begin\n          // Destination has acknowledged, deassert valid\n          src_valid_reg <= 1'b0;\n          src_ready_reg <= 1'b1;\n          if (src_valid_i) begin\n            src_data_reg  <= src_data_i;\n            src_valid_reg <= 1'b1;\n          end\n        end\n      end else begin\n        // Idle, can accept new data\n        src_ready_reg <= 1'b1;\n        if (src_valid_i) begin\n          src_data_reg  <= src_data_i;\n          src_valid_reg <= 1'b1;\n        end\n      end\n    end\n  end\n\n  // Synchronize src_valid_reg to dst domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_valid_sync <= 3'b000;\n    end else begin\n      src_valid_sync <= {src_valid_sync[1:0], src_valid_reg};\n    end\n  end\n\n  // Synchronize dst_ready_reg to src domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_ready_sync <= 3'b000;\n    end else begin\n      dst_ready_sync <= {dst_ready_sync[1:0], dst_ready_reg};\n    end\n  end\n\n  // Destination domain: capture data and valid\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b1;\n    end else begin\n      if (src_valid_sync[2]) begin\n        // Source has valid data, capture it\n        dst_data_reg  <= src_data_reg;\n        dst_valid_reg <= 1'b1;\n        dst_ready_reg <= 1'b0;\n      end else if (dst_valid_reg) begin\n        // Waiting for destination to be ready\n        dst_ready_reg <= 1'b0;\n        if (dst_ready_i) begin\n          dst_valid_reg <= 1'b0;\n          dst_ready_reg <= 1'b1;\n        end\n      end else begin\n        // Idle, ready to accept new data\n        dst_ready_reg <= 1'b1;\n      end\n    end\n  end\n\n  // Assign outputs\n  assign src_ready_o = src_ready_reg;\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
