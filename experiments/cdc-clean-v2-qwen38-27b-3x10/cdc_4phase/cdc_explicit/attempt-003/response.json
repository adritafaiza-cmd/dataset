  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_valid_reg;\n  reg             src_ready_reg;\n  reg             src_req;\n  reg             src_ack_sync;\n  reg             src_ack_sync2;\n\n  // Destination domain state\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_valid_reg;\n  reg             dst_ack;\n  reg             dst_req_sync;\n  reg             dst_req_sync2;\n\n  // Synchronizers for request (src -> dst)\n  reg req_sync1;\n  reg req_sync2;\n\n  // Synchronizers for acknowledge (dst -> src)\n  reg ack_sync1;\n  reg ack_sync2;\n\n  // Synchronizers for data (src -> dst) - multi-bit, synchronized\n  reg [WIDTH-1:0] data_sync1;\n  reg [WIDTH-1:0] data_sync2;\n\n  // Synchronizers for valid (src -> dst)\n  reg valid_sync1;\n  reg valid_sync2;\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg  <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n      src_req       <= 1'b0;\n      src_ack_sync  <= 1'b0;\n      src_ack_sync2 <= 1'b0;\n    end else begin\n      // Synchronize acknowledge from destination\n      src_ack_sync  <= ack_sync1;\n      src_ack_sync2 <= src_ack_sync;\n\n      // Handle reset message\n      if (SEND_RESET_MSG && !src_valid_reg && src_ready_reg && !src_req) begin\n        // After reset, emit RESET_MSG\n        src_data_reg  <= RESET_MSG;\n        src_valid_reg <= 1'b1;\n        src_ready_reg <= 1'b0;\n        src_req       <= 1'b1;\n      end else if (src_valid_reg && src_ready_reg) begin\n        // Accept new data\n        src_data_reg  <= src_data_i;\n        src_valid_reg <= 1'b1;\n        src_ready_reg <= 1'b0;\n        src_req       <= 1'b1;\n      end else if (src_valid_reg && !src_ready_reg && src_ack_sync2) begin\n        // Acknowledge received, can accept new data\n        src_valid_reg <= 1'b0;\n        src_ready_reg <= 1'b1;\n        src_req       <= 1'b0;\n      end else if (!src_valid_reg && src_ready_reg && src_ack_sync2) begin\n        // Idle, acknowledge received\n        src_ready_reg <= 1'b1;\n        src_req       <= 1'b0;\n      end\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_ack       <= 1'b0;\n      dst_req_sync  <= 1'b0;\n      dst_req_sync2 <= 1'b0;\n    end else begin\n      // Synchronize request from source\n      dst_req_sync  <= req_sync1;\n      dst_req_sync2 <= dst_req_sync;\n\n      // Synchronize data and valid from source\n      data_sync1    <= src_data_reg;\n      data_sync2    <= data_sync1;\n      valid_sync1   <= src_valid_reg;\n      valid_sync2   <= valid_sync1;\n\n      // Handle transfer\n      if (dst_valid_reg && dst_ready_i) begin\n        // Handshake complete\n        dst_valid_reg <= 1'b0;\n        dst_ack       <= 1'b0;\n      end else if (!dst_valid_reg && dst_req_sync2 && valid_sync2) begin\n        // New transfer available\n        dst_data_reg  <= data_sync2;\n        dst_valid_reg <= 1'b1;\n        dst_ack       <= 1'b1;\n      end else if (dst_valid_reg && !dst_ready_i) begin\n        // Hold data stable\n        dst_ack       <= 1'b1;\n      end\n    end\n  end\n\n  // Synchronizer for request (src -> dst)\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync1 <= 1'b0;\n      req_sync2 <= 1'b0;\n    end else begin\n      req_sync1 <= src_req;\n      req_sync2 <= req_sync1;\n    end\n  end\n\n  // Synchronizer for acknowledge (dst -> src)\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync1 <= 1'b0;\n      ack_sync2 <= 1'b0;\n    end else begin\n      ack_sync1 <= dst_ack;\n      ack_sync2 <= ack_sync1;\n    end\n  end\n\n  // Outputs\n  assign src_ready_o = src_ready_reg;\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
