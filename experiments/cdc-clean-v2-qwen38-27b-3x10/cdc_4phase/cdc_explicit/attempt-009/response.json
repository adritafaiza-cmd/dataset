  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire [WIDTH-1:0] src_payload;\n  wire src_req;\n  wire dst_ack;\n  wire dst_req;\n  wire src_ack;\n  wire [WIDTH-1:0] dst_payload;\n\n  // Source domain: capture data and generate request\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_valid_reg;\n  reg src_ready_int;\n  reg src_req_reg;\n\n  // Destination domain: acknowledge and generate request back\n  reg dst_ack_reg;\n  reg dst_req_reg;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n\n  // Synchronizers for control signals\n  // src_req -> dst domain\n  reg [1:0] src_req_sync;\n  // dst_ack -> src domain\n  reg [1:0] dst_ack_sync;\n  // dst_req -> src domain\n  reg [1:0] dst_req_sync;\n  // src_ack -> dst domain\n  reg [1:0] src_ack_sync;\n\n  // Synchronizers for payload (multi-bit, must be stable during transfer)\n  // src_payload -> dst domain\n  reg [WIDTH-1:0] src_payload_sync1;\n  reg [WIDTH-1:0] src_payload_sync2;\n  // dst_payload -> src domain\n  reg [WIDTH-1:0] dst_payload_sync1;\n  reg [WIDTH-1:0] dst_payload_sync2;\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_ready_int <= 1'b1;\n      src_req_reg <= 1'b0;\n    end else begin\n      // Accept data when valid and ready\n      if (src_valid_i && src_ready_int) begin\n        src_data_reg <= src_data_i;\n        src_valid_reg <= 1'b1;\n        src_ready_int <= 1'b0;\n        src_req_reg <= 1'b1;\n      end else if (dst_ack_sync[1]) begin\n        // Acknowledge received from destination\n        src_valid_reg <= 1'b0;\n        src_ready_int <= 1'b1;\n        src_req_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_ack_reg <= 1'b0;\n      dst_req_reg <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n    end else begin\n      // When request from source is detected\n      if (src_req_sync[1] && !dst_ack_reg) begin\n        dst_ack_reg <= 1'b1;\n        dst_data_reg <= src_payload_sync2;\n        dst_valid_reg <= 1'b1;\n      end else if (dst_valid_reg && dst_ready_i) begin\n        // Destination accepts the data\n        dst_valid_reg <= 1'b0;\n        dst_ack_reg <= 1'b0;\n        dst_req_reg <= 1'b1;\n      end else if (src_ack_sync[1]) begin\n        // Acknowledge from source received\n        dst_req_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronizers\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_req_sync <= 2'b00;\n    end else begin\n      src_req_sync <= {src_req_sync[0], src_req_reg};\n    end\n  end\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_ack_sync <= 2'b00;\n    end else begin\n      dst_ack_sync <= {dst_ack_sync[0], dst_ack_reg};\n    end\n  end\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_req_sync <= 2'b00;\n    end else begin\n      dst_req_sync <= {dst_req_sync[0], dst_req_reg};\n    end\n  end\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_ack_sync <= 2'b00;\n    end else begin\n      src_ack_sync <= {src_ack_sync[0], src_req_reg};\n    end\n  end\n\n  // Payload synchronizers - only update when request is active\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_payload_sync1 <= {WIDTH{1'b0}};\n      src_payload_sync2 <= {WIDTH{1'b0}};\n    end else begin\n      if (src_req_sync[0]) begin\n        src_payload_sync1 <= src_data_reg;\n      end\n      src_payload_sync2 <= src_payload_sync1;\n    end\n  end\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_payload_sync1 <= {WIDTH{1'b0}};\n      dst_payload_sync2 <= {WIDTH{1'b0}};\n    end else begin\n      if (dst_req_sync[0]) begin\n        dst_payload_sync1 <= dst_data_reg;\n      end\n      dst_payload_sync2 <= dst_payload_sync1;\n    end\n  end\n\n  // Output assignments\n  assign src_ready_o = src_ready_int;\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
