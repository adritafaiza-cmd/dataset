  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire [WIDTH-1:0] src_payload;\n  wire src_req;\n  wire dst_ack;\n  wire dst_req;\n  wire src_ack;\n  wire [WIDTH-1:0] dst_payload;\n\n  // Source domain: capture data and generate request\n  // Destination domain: acknowledge request and generate new request for next transfer\n\n  // Source side: hold payload stable while request is pending\n  reg [WIDTH-1:0] src_hold_data;\n  reg src_hold_valid;\n  reg src_req_reg;\n\n  // Destination side: hold payload and generate valid\n  reg [WIDTH-1:0] dst_hold_data;\n  reg dst_valid_reg;\n  reg dst_req_reg;\n\n  // Synchronizers for request/acknowledge signals\n  // src_req goes from src to dst\n  reg [1:0] src_req_sync;\n  // dst_ack goes from dst to src\n  reg [1:0] dst_ack_sync;\n  // dst_req goes from dst to src\n  reg [1:0] dst_req_sync;\n  // src_ack goes from src to dst\n  reg [1:0] src_ack_sync;\n\n  // Synchronizers for payload data (multi-bit, must be stable during transfer)\n  // We use a handshake-based approach where payload is held stable\n  // and synchronized through 2 stages after the control signal settles\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_hold_data <= {WIDTH{1'b0}};\n      src_hold_valid <= 1'b0;\n      src_req_reg <= 1'b0;\n    end else begin\n      // If we have a pending request, wait for ack\n      if (src_req_reg) begin\n        if (dst_ack_sync[1]) begin\n          // Ack received, clear request\n          src_req_reg <= 1'b0;\n          src_hold_valid <= 1'b0;\n        end\n      end else begin\n        // No pending request, can accept new data\n        if (src_valid_i && src_ready_o) begin\n          src_hold_data <= src_data_i;\n          src_hold_valid <= 1'b1;\n          src_req_reg <= 1'b1;\n        end\n      end\n    end\n  end\n\n  // Source ready: can accept new data if no pending request\n  // In DECOUPLED mode, we can accept new data before the previous ack returns\n  // But for simplicity and safety, we use a standard 4-phase handshake\n  // where we wait for ack before accepting new data\n  assign src_ready_o = !src_req_reg;\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_hold_data <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_req_reg <= 1'b0;\n    end else begin\n      // If we have a pending valid, wait for ready\n      if (dst_valid_reg) begin\n        if (dst_ready_i) begin\n          // Handshake complete, clear valid\n          dst_valid_reg <= 1'b0;\n          // Generate ack to source\n          dst_req_reg <= 1'b1;\n        end\n      end else begin\n        // No pending valid, check for new request from source\n        if (src_req_sync[1]) begin\n          // New request received, capture payload\n          dst_hold_data <= src_hold_data;\n          dst_valid_reg <= 1'b1;\n          // Clear the request by sending ack\n          dst_req_reg <= 1'b1;\n        end\n      end\n    end\n  end\n\n  // Output signals\n  assign dst_data_o = dst_hold_data;\n  assign dst_valid_o = dst_valid_reg;\n\n  // Synchronizers\n  // src_req: src -> dst\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_req_sync <= 2'b00;\n    else\n      src_req_sync <= {src_req_sync[0], src_req_reg};\n  end\n\n  // dst_ack: dst -> src (dst_req_reg is the ack signal)\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_ack_sync <= 2'b00;\n    else\n      dst_ack_sync <= {dst_ack_sync[0], dst_req_reg};\n  end\n\n  // dst_req: dst -> src (for decoupled mode, but we don't use it in basic mode)\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_req_sync <= 2'b00;\n    else\n      dst_req_sync <= {dst_req_sync[0], dst_req_reg};\n  end\n\n  // src_ack: src -> dst (not used in basic mode)\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_ack_sync <= 2'b00;\n    else\n      src_ack_sync <= {src_ack_sync[0], src_req_reg};\n  end\n\nendmodule\n```<|im_end|>",
