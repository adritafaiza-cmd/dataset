  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_valid_reg;\n  reg             src_ack_reg;\n  reg             src_ack_sync1;\n  reg             src_ack_sync2;\n\n  // Destination domain state\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_valid_reg;\n  reg             dst_req_reg;\n  reg             dst_req_sync1;\n  reg             dst_req_sync2;\n\n  // Synchronized signals\n  wire src_ack_synced = src_ack_sync2;\n  wire dst_req_synced = dst_req_sync2;\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg  <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_ack_reg   <= 1'b0;\n      src_ack_sync1 <= 1'b0;\n      src_ack_sync2 <= 1'b0;\n    end else begin\n      src_ack_sync1 <= src_ack_sync2;\n      src_ack_sync2 <= dst_req_synced;\n\n      if (src_valid_i && src_ready_o) begin\n        src_data_reg  <= src_data_i;\n        src_valid_reg <= 1'b1;\n        src_ack_reg   <= 1'b0;\n      end else if (src_valid_reg && src_ack_synced) begin\n        src_valid_reg <= 1'b0;\n        src_ack_reg   <= 1'b1;\n      end\n    end\n  end\n\n  assign src_ready_o = !src_valid_reg || src_ack_synced;\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_req_reg   <= 1'b0;\n      dst_req_sync1 <= 1'b0;\n      dst_req_sync2 <= 1'b0;\n    end else begin\n      dst_req_sync1 <= dst_req_sync2;\n      dst_req_sync2 <= src_valid_reg;\n\n      if (dst_valid_reg && dst_ready_i) begin\n        dst_valid_reg <= 1'b0;\n        dst_req_reg   <= 1'b1;\n      end else if (!dst_valid_reg && dst_req_synced) begin\n        dst_data_reg  <= src_data_reg;\n        dst_valid_reg <= 1'b1;\n        dst_req_reg   <= 1'b0;\n      end\n    end\n  end\n\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
