  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_valid_reg;\n  reg             src_ready_reg;\n  reg             src_pending;\n\n  // Destination domain state\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_valid_reg;\n  reg             dst_ready_reg;\n\n  // Synchronizers for src_valid to dst domain\n  reg [1:0] src_valid_sync;\n  // Synchronizers for dst_ready to src domain\n  reg [1:0] dst_ready_sync;\n\n  // Synchronizers for src_data to dst domain (only valid when src_valid is high)\n  // We use a simple approach: data is stable while valid is high, so we can\n  // synchronize data along with valid. But to be safe, we'll use a 2-stage\n  // synchronizer for data as well, and only use it when valid is high.\n\n  // Actually, for a 4-phase handshake, the standard approach is:\n  // - src_valid goes high, data is stable\n  // - dst sees valid, captures data\n  // - dst_ready goes high\n  // - src sees ready, deasserts valid\n  // - dst sees valid deasserted, deasserts ready\n  //\n  // For CDC, we need to synchronize the control signals. Data is only\n  // sampled when valid is high, so we can synchronize data with a 2-stage\n  // synchronizer and only use it when the synchronized valid is high.\n\n  // Let's use a simpler approach: synchronize src_valid and dst_ready,\n  // and for data, use a 2-stage synchronizer that is only valid when\n  // the synchronized src_valid is high.\n\n  // Synchronize src_valid to dst domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_valid_sync <= 2'b00;\n    else\n      src_valid_sync <= {src_valid_sync[0], src_valid_reg};\n  end\n\n  // Synchronize dst_ready to src domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_ready_sync <= 2'b00;\n    else\n      dst_ready_sync <= {dst_ready_sync[0], dst_ready_reg};\n  end\n\n  // Synchronize src_data to dst domain\n  // Data is only meaningful when src_valid is high, so we synchronize it\n  // and only use it when src_valid_sync[1] is high.\n  reg [WIDTH-1:0] src_data_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_data_sync <= {WIDTH{1'b0}};\n    else\n      src_data_sync <= src_data_reg;\n  end\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg  <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n      src_pending   <= 1'b0;\n    end else begin\n      if (src_valid_i && src_ready_reg) begin\n        // Accept new data\n        src_data_reg  <= src_data_i;\n        src_valid_reg <= 1'b1;\n        src_ready_reg <= 1'b0;\n        src_pending   <= 1'b1;\n      end else if (src_valid_reg && dst_ready_sync[1]) begin\n        // Destination has acknowledged, deassert valid\n        src_valid_reg <= 1'b0;\n        src_ready_reg <= 1'b1;\n        src_pending   <= 1'b0;\n      end\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b0;\n    end else begin\n      if (src_valid_sync[1] && !dst_valid_reg) begin\n        // New valid from source, capture data\n        dst_data_reg  <= src_data_sync;\n        dst_valid_reg <= 1'b1;\n        dst_ready_reg <= 1'b0;\n      end else if (dst_valid_reg && dst_ready_i) begin\n        // Destination ready, acknowledge\n        dst_valid_reg <= 1'b0;\n        dst_ready_reg <= 1'b1;\n      end else if (!dst_valid_reg && dst_ready_reg && !src_valid_sync[1]) begin\n        // Source has deasserted valid, deassert ready\n        dst_ready_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Outputs\n  assign src_ready_o = src_ready_reg;\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
