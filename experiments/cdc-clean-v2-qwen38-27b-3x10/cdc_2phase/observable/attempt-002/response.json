  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source-side state\n  reg src_pending;\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_sent;\n\n  // Destination-side state\n  reg dst_pending;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_sent;\n\n  // Synchronizers for src_sent (src -> dst)\n  reg src_sent_sync1;\n  reg src_sent_sync2;\n\n  // Synchronizers for dst_sent (dst -> src)\n  reg dst_sent_sync1;\n  reg dst_sent_sync2;\n\n  // Synchronizers for dst_pending (dst -> src)\n  reg dst_pending_sync1;\n  reg dst_pending_sync2;\n\n  // Synchronizers for src_pending (src -> dst)\n  reg src_pending_sync1;\n  reg src_pending_sync2;\n\n  // Source clock domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_pending <= 1'b0;\n      src_data_reg <= {WIDTH{1'b0}};\n      src_sent <= 1'b0;\n    end else begin\n      // If we have a pending item and the destination has consumed the previous one\n      // (dst_sent_sync2 indicates dst has finished with the last item), we can accept new data\n      // Actually, let's think about this differently.\n\n      // The protocol:\n      // 1. Source has data, sets src_pending=1, sends data\n      // 2. Destination sees src_pending=1 (after sync), captures data, sets dst_pending=1\n      // 3. Destination presents dst_valid=1 to its consumer\n      // 4. When dst_ready_i is high, destination accepts the data, sets dst_sent=1\n      // 5. Source sees dst_sent=1 (after sync), clears src_pending, can accept new data\n\n      // Let's use a simpler handshake:\n      // - src_ready_o is high when source can accept new data\n      // - Source accepts data when src_valid_i && src_ready_o\n      // - After accepting, source holds data until destination confirms receipt\n\n      // State machine:\n      // IDLE: src_ready_o=1, waiting for valid data\n      // PENDING: src_ready_o=0, waiting for dst to confirm\n\n      if (src_pending) begin\n        // Waiting for destination to confirm\n        if (dst_sent_sync2) begin\n          // Destination has consumed the data\n          src_pending <= 1'b0;\n          src_sent <= 1'b0;\n        end\n      end else begin\n        // Idle, can accept new data\n        if (src_valid_i) begin\n          src_pending <= 1'b1;\n          src_data_reg <= src_data_i;\n          src_sent <= 1'b1;\n        end\n      end\n    end\n  end\n\n  assign src_ready_o = ~src_pending;\n\n  // Synchronize src_sent to dst domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_sent_sync1 <= 1'b0;\n      src_sent_sync2 <= 1'b0;\n    end else begin\n      src_sent_sync1 <= src_sent;\n      src_sent_sync2 <= src_sent_sync1;\n    end\n  end\n\n  // Synchronize src_pending to dst domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_pending_sync1 <= 1'b0;\n      src_pending_sync2 <= 1'b0;\n    end else begin\n      src_pending_sync1 <= src_pending;\n      src_pending_sync2 <= src_pending_sync1;\n    end\n  end\n\n  // Destination clock domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_pending <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_sent <= 1'b0;\n    end else begin\n      if (dst_pending) begin\n        // Waiting for consumer to accept\n        if (dst_ready_i) begin\n          dst_pending <= 1'b0;\n          dst_sent <= 1'b1;\n        end\n      end else begin\n        // Idle, check if source has new data\n        if (src_pending_sync2) begin\n          dst_pending <= 1'b1;\n          dst_data_reg <= src_data_reg;\n          dst_sent <= 1'b0;\n        end\n      end\n    end\n  end\n\n  assign dst_valid_o = dst_pending;\n  assign dst_data_o = dst_data_reg;\n\n  // Synchronize dst_sent to src domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_sent_sync1 <= 1'b0;\n      dst_sent_sync2 <= 1'b0;\n    end else begin\n      dst_sent_sync1 <= dst_sent;\n      dst_sent_sync2 <= dst_sent_sync1;\n    end\n  end\n\n  // Synchronize dst_pending to src domain (not strictly needed but for completeness)\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_pending_sync1 <= 1'b0;\n      dst_pending_sync2 <= 1'b0;\n    end else begin\n      dst_pending_sync1 <= dst_pending;\n      dst_pending_sync2 <= dst_pending_sync1;\n    end\n  end\n\nendmodule\n```<|im_end|>",
