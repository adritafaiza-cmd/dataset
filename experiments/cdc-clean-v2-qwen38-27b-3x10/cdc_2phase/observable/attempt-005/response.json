  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side: capture data and generate request pulse\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_valid_reg;\n  reg             src_req_pulse;\n\n  // Destination side: receive request and generate response pulse\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_valid_reg;\n  reg             dst_ack_pulse;\n\n  // CDC synchronizers\n  // Request: src -> dst\n  reg [1:0] req_sync;\n  // Ack: dst -> src\n  reg [1:0] ack_sync;\n\n  // Source clock domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg  <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_req_pulse <= 1'b0;\n    end else begin\n      // Generate request pulse when data is accepted\n      if (src_valid_i && src_ready_o) begin\n        src_data_reg  <= src_data_i;\n        src_valid_reg <= 1'b1;\n        src_req_pulse <= 1'b1;\n      end else begin\n        src_req_pulse <= 1'b0;\n      end\n\n      // Clear valid when ack is received\n      if (ack_sync[1] && src_valid_reg) begin\n        src_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Source ready: ready when no pending data\n  assign src_ready_o = ~src_valid_reg;\n\n  // Synchronize request from src to dst\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync <= 2'b00;\n    end else begin\n      req_sync <= {req_sync[0], src_req_pulse};\n    end\n  end\n\n  // Destination clock domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_ack_pulse <= 1'b0;\n    end else begin\n      // Detect rising edge of synchronized request\n      if (req_sync[1] && !req_sync[0]) begin\n        dst_data_reg  <= src_data_reg;\n        dst_valid_reg <= 1'b1;\n        dst_ack_pulse <= 1'b1;\n      end else begin\n        dst_ack_pulse <= 1'b0;\n      end\n\n      // Clear valid when data is accepted by receiver\n      if (dst_valid_reg && dst_ready_i) begin\n        dst_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Destination outputs\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\n  // Synchronize ack from dst to src\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync <= 2'b00;\n    end else begin\n      ack_sync <= {ack_sync[0], dst_ack_pulse};\n    end\n  end\n\nendmodule\n```<|im_end|>",
