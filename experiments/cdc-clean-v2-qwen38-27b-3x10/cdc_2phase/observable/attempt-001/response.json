  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source-side state\n  reg src_valid_r;\n  reg [WIDTH-1:0] src_data_r;\n\n  // Destination-side state\n  reg dst_valid_r;\n  reg [WIDTH-1:0] dst_data_r;\n\n  // Handshake signals\n  // src_to_dst_valid: source has data to send\n  // dst_to_src_ready: destination is ready to accept (i.e., not holding pending data)\n\n  // Source side: track if we have pending data\n  // We use a simple approach:\n  // - src_valid_r indicates we have data to send\n  // - When dst is ready (dst_to_src_ready), we can transfer\n\n  // Let's use a 2-phase handshake with proper CDC\n  // Source side:\n  //   - If src_valid_i and src_ready_o, capture data\n  //   - src_ready_o is high when we don't have pending data OR when dst accepts\n\n  // Actually, let me think about this more carefully.\n  // We need to transfer data from src to dst across clock domains.\n  // The data must be stable while valid.\n\n  // Approach:\n  // 1. Source captures data when src_valid_i && src_ready_o\n  // 2. Source holds the data and asserts a \"valid\" signal to dst domain\n  // 3. Dst domain sees valid, and when dst_ready_i is high, it accepts the data\n  // 4. Dst domain sends back an \"ack\" to src domain\n  // 5. Src domain deasserts valid when it sees ack\n\n  // This is a standard 2-phase handshake CDC.\n\n  // Source side registers\n  reg src_valid_r;\n  reg [WIDTH-1:0] src_data_r;\n\n  // Destination side registers\n  reg dst_valid_r;\n  reg [WIDTH-1:0] dst_data_r;\n\n  // Handshake signals (synchronized)\n  // src_valid_to_dst: source has data\n  // dst_ack_to_src: destination has accepted data\n\n  // Let's define the signals:\n  // src_valid_r: source has pending data\n  // dst_ack_r: destination has acknowledged (in src domain)\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_r <= 1'b0;\n      src_data_r  <= {WIDTH{1'b0}};\n    end else begin\n      if (src_valid_i && src_ready_o) begin\n        src_valid_r <= 1'b1;\n        src_data_r  <= src_data_i;\n      end else if (dst_ack_r) begin\n        src_valid_r <= 1'b0;\n      end\n    end\n  end\n\n  // src_ready_o: high when we can accept new data\n  // We can accept new data if we don't have pending data\n  assign src_ready_o = ~src_valid_r;\n\n  // dst_ack_r: synchronized ack from dst domain\n  reg dst_ack_r;\n  reg dst_ack_sync1;\n  reg dst_ack_sync2;\n\n  // dst_ack from dst domain\n  wire dst_ack;\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_r <= 1'b0;\n      dst_data_r  <= {WIDTH{1'b0}};\n      dst_ack     <= 1'b0;\n    end else begin\n      if (src_valid_sync2) begin\n        dst_valid_r <= 1'b1;\n        dst_data_r  <= src_data_sync2;\n      end else if (dst_valid_r && dst_ready_i) begin\n        dst_valid_r <= 1'b0;\n        dst_ack     <= 1'b1;\n      end else if (!dst_valid_r) begin\n        dst_ack     <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize src_valid and src_data to dst domain\n  reg src_valid_sync1;\n  reg src_valid_sync2;\n  reg [WIDTH-1:0] src_data_sync1;\n  reg [WIDTH-1:0] src_data_sync2;\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_valid_sync1 <= 1'b0;\n      src_valid_sync2 <= 1'b0;\n      src_data_sync1  <= {WIDTH{1'b0}};\n      src_data_sync2  <= {WIDTH{1'b0}};\n    end else begin\n      src_valid_sync1 <= src_valid_r;\n      src_valid_sync2 <= src_valid_sync1;\n      src_data_sync1  <= src_data_r;\n      src_data_sync2  <= src_data_sync1;\n    end\n  end\n\n  // Synchronize dst_ack to src domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_ack_sync1 <= 1'b0;\n      dst_ack_sync2 <= 1'b0;\n      dst_ack_r     <= 1'b0;\n    end else begin\n      dst_ack_sync1 <= dst_ack;\n      dst_ack_sync2 <= dst_ack_sync1;\n      dst_ack_r     <= dst_ack_sync2;\n    end\n  end\n\n  // Outputs\n  assign dst_data_o  = dst_data_r;\n  assign dst_valid_o = dst_valid_r;\n\nendmodule\n```<|im_end|>",
