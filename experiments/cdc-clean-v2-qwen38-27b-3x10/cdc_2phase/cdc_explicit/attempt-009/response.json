  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain: hold the data and generate request\n  reg [WIDTH-1:0] src_data_hold;\n  reg             src_req;\n  wire            src_ack;\n\n  // Destination domain: synchronize request, capture data, generate ack\n  reg             dst_req_sync1;\n  reg             dst_req_sync2;\n  reg             dst_ack;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_valid_reg;\n\n  // Synchronize ack from dst to src\n  reg             src_ack_sync1;\n  reg             src_ack_sync2;\n\n  // Synchronize dst_ready from dst to src (for backpressure)\n  // Actually, we need to know when dst is ready to accept a new item.\n  // The protocol: src sends req, dst captures data, dst sends ack.\n  // src can send next req only after receiving ack.\n  // dst_valid_o is high when dst has a valid item and is waiting for dst_ready_i.\n  // dst_valid_o must remain high until dst_ready_i is high.\n\n  // Let's use a simple handshake:\n  // src: when src_valid_i && src_ready_o, latch src_data_i into src_data_hold, set src_req=1.\n  // src_ready_o = !src_req || src_ack_sync2 (i.e., can accept new if no outstanding req, or previous ack received)\n  // Actually, src_ready_o should be low when src_req is high and ack not yet received.\n  // src_ready_o = !src_req || src_ack_sync2;\n  // But we need to be careful: when src_req is set, we wait for ack.\n  // When ack arrives, we clear src_req and can accept new.\n\n  // dst: when dst_req_sync2 rises, capture src_data_hold (synchronized) into dst_data_reg, set dst_valid_reg=1.\n  // dst_valid_o = dst_valid_reg.\n  // When dst_valid_reg && dst_ready_i, clear dst_valid_reg, set dst_ack=1.\n  // dst_ack is then synchronized back to src.\n  // When src receives ack, clear src_req.\n\n  // But wait: the data must be stable during the request. So src_data_hold must be stable while src_req is high.\n  // The data is synchronized through 2 stages in dst domain.\n\n  // Let's implement:\n\n  // Source domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_hold <= {WIDTH{1'b0}};\n      src_req       <= 1'b0;\n    end else begin\n      if (src_valid_i && src_ready_o) begin\n        src_data_hold <= src_data_i;\n        src_req       <= 1'b1;\n      end else if (src_ack_sync2) begin\n        src_req       <= 1'b0;\n      end\n    end\n  end\n\n  assign src_ready_o = !src_req || src_ack_sync2;\n\n  // Synchronize ack from dst to src\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ack_sync1 <= 1'b0;\n      src_ack_sync2 <= 1'b0;\n    end else begin\n      src_ack_sync1 <= dst_ack;\n      src_ack_sync2 <= src_ack_sync1;\n    end\n  end\n\n  // Destination domain\n  // Synchronize req from src to dst\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_req_sync1 <= 1'b0;\n      dst_req_sync2 <= 1'b0;\n    end else begin\n      dst_req_sync1 <= src_req;\n      dst_req_sync2 <= dst_req_sync1;\n    end\n  end\n\n  // Synchronize data from src to dst (2 stages)\n  reg [WIDTH-1:0] dst_data_sync1;\n  reg [WIDTH-1:0] dst_data_sync2;\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_sync1 <= {WIDTH{1'b0}};\n      dst_data_sync2 <= {WIDTH{1'b0}};\n    end else begin\n      dst_data_sync1 <= src_data_hold;\n      dst_data_sync2 <= dst_data_sync1;\n    end\n  end\n\n  // Detect rising edge of dst_req_sync2\n  wire dst_req_rise = dst_req_sync2 && !dst_req_sync1;\n\n  // Destination logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_ack       <= 1'b0;\n    end else begin\n      if (dst_req_rise) begin\n        dst_data_reg  <= dst_data_sync2;\n        dst_valid_reg <= 1'b1;\n        dst_ack       <= 1'b0;\n      end else if (dst_valid_reg && dst_ready_i) begin\n        dst_valid_reg <= 1'b0;\n        dst_ack       <= 1'b1;\n      end\n    end\n  end\n\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
