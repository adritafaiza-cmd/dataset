  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain: hold data when a transfer is accepted\n  reg [WIDTH-1:0] src_data_hold;\n  reg             src_data_valid;\n  reg             src_ack_sync0;\n  reg             src_ack_sync1;\n\n  // Destination domain: synchronized request and data\n  reg             dst_req_sync0;\n  reg             dst_req_sync1;\n  reg             dst_req_sync2;\n  reg [WIDTH-1:0] dst_data_sync0;\n  reg [WIDTH-1:0] dst_data_sync1;\n  reg [WIDTH-1:0] dst_data_sync2;\n  reg             dst_ack;\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_hold  <= {WIDTH{1'b0}};\n      src_data_valid <= 1'b0;\n      src_ack_sync0  <= 1'b0;\n      src_ack_sync1  <= 1'b0;\n    end else begin\n      // Synchronize ack from destination\n      src_ack_sync0 <= dst_ack;\n      src_ack_sync1 <= src_ack_sync0;\n\n      // Accept new data when valid and ready\n      if (src_valid_i && src_ready_o) begin\n        src_data_hold  <= src_data_i;\n        src_data_valid <= 1'b1;\n      end else if (src_data_valid && src_ack_sync1) begin\n        // Ack received, clear valid\n        src_data_valid <= 1'b0;\n      end\n    end\n  end\n\n  // Source ready: low when we have an outstanding item not yet acked\n  assign src_ready_o = !src_data_valid || src_ack_sync1;\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_req_sync0  <= 1'b0;\n      dst_req_sync1  <= 1'b0;\n      dst_req_sync2  <= 1'b0;\n      dst_data_sync0 <= {WIDTH{1'b0}};\n      dst_data_sync1 <= {WIDTH{1'b0}};\n      dst_data_sync2 <= {WIDTH{1'b0}};\n      dst_ack        <= 1'b0;\n    end else begin\n      // Synchronize request from source\n      dst_req_sync0 <= src_data_valid;\n      dst_req_sync1 <= dst_req_sync0;\n      dst_req_sync2 <= dst_req_sync1;\n\n      // Synchronize data (hold stable during request)\n      dst_data_sync0 <= src_data_hold;\n      dst_data_sync1 <= dst_data_sync0;\n      dst_data_sync2 <= dst_data_sync1;\n\n      // Acknowledge when request is fully synchronized and destination is ready\n      if (dst_req_sync2 && dst_ready_i) begin\n        dst_ack <= 1'b1;\n      end else if (!dst_req_sync2) begin\n        dst_ack <= 1'b0;\n      end\n    end\n  end\n\n  // Destination outputs\n  assign dst_valid_o = dst_req_sync2;\n  assign dst_data_o  = dst_data_sync2;\n\nendmodule\n```<|im_end|>",
