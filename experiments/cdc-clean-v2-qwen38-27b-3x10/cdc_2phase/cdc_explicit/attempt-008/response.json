  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain: hold the payload and issue a request\n  reg [WIDTH-1:0] src_payload_reg;\n  reg             src_req_reg;\n\n  // Destination domain: acknowledge the request\n  reg             dst_ack_reg;\n\n  // Synchronize the request from source to destination\n  reg             req_sync1;\n  reg             req_sync2;\n\n  // Synchronize the acknowledge from destination to source\n  reg             ack_sync1;\n  reg             ack_sync2;\n\n  // Destination domain: hold the payload and synchronize it\n  reg [WIDTH-1:0] dst_payload_sync1;\n  reg [WIDTH-1:0] dst_payload_sync2;\n\n  // Destination domain: valid signal derived from synchronized request\n  reg             dst_valid_reg;\n\n  // Source ready: high when no outstanding request\n  assign src_ready_o = ~src_req_reg;\n\n  // Destination valid: high when a request has been synchronized and not yet acknowledged\n  assign dst_valid_o = dst_valid_reg;\n\n  // Destination data: from the synchronized payload\n  assign dst_data_o = dst_payload_sync2;\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_req_reg     <= 1'b0;\n      src_payload_reg <= {WIDTH{1'b0}};\n    end else begin\n      if (src_valid_i && src_ready_o) begin\n        src_req_reg     <= 1'b1;\n        src_payload_reg <= src_data_i;\n      end else if (src_req_reg && ack_sync2) begin\n        src_req_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize request to destination domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync1 <= 1'b0;\n      req_sync2 <= 1'b0;\n    end else begin\n      req_sync1 <= src_req_reg;\n      req_sync2 <= req_sync1;\n    end\n  end\n\n  // Destination domain: capture payload when request is synchronized\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_payload_sync1 <= {WIDTH{1'b0}};\n      dst_payload_sync2 <= {WIDTH{1'b0}};\n      dst_valid_reg     <= 1'b0;\n      dst_ack_reg       <= 1'b0;\n    end else begin\n      // Capture payload when a new request arrives (req_sync2 rising edge)\n      if (req_sync2 && !req_sync1) begin\n        dst_payload_sync1 <= src_payload_reg;\n        dst_valid_reg     <= 1'b1;\n      end\n\n      // Synchronize payload\n      dst_payload_sync2 <= dst_payload_sync1;\n\n      // Acknowledge when valid and ready\n      if (dst_valid_reg && dst_ready_i) begin\n        dst_ack_reg   <= 1'b1;\n        dst_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize acknowledge to source domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync1 <= 1'b0;\n      ack_sync2 <= 1'b0;\n    end else begin\n      ack_sync1 <= dst_ack_reg;\n      ack_sync2 <= ack_sync1;\n    end\n  end\n\nendmodule\n```<|im_end|>",
