  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state\n  reg src_busy;\n  reg [WIDTH-1:0] src_data_reg;\n\n  // Destination domain state\n  reg dst_busy;\n  reg [WIDTH-1:0] dst_data_reg;\n\n  // Synchronization signals\n  // src_to_dst: source indicates it has data to send\n  reg [2:0] src_to_dst_sync;\n  reg src_to_dst;\n  \n  // dst_to_src: destination indicates it is ready to accept new data\n  reg [2:0] dst_to_src_sync;\n  reg dst_to_src;\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_busy <= 1'b0;\n      src_data_reg <= {WIDTH{1'b0}};\n      src_to_dst <= 1'b0;\n    end else begin\n      if (src_valid_i && !src_busy && dst_to_src) begin\n        // Accept new data\n        src_data_reg <= src_data_i;\n        src_busy <= 1'b1;\n        src_to_dst <= 1'b1;\n      end else if (!src_valid_i && !src_busy) begin\n        // Idle, ensure src_to_dst is low\n        src_to_dst <= 1'b0;\n      end\n    end\n  end\n\n  // Source ready: can accept new data when not busy and destination is ready\n  assign src_ready_o = !src_busy && dst_to_src;\n\n  // Synchronize src_to_dst to destination domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_to_dst_sync <= 3'b000;\n    end else begin\n      src_to_dst_sync <= {src_to_dst_sync[1:0], src_to_dst};\n    end\n  end\n\n  // Synchronize dst_to_src to source domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_to_src_sync <= 3'b000;\n    end else begin\n      dst_to_src_sync <= {dst_to_src_sync[1:0], dst_to_src};\n    end\n  end\n\n  assign dst_to_src = dst_to_src_sync[2];\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_busy <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_to_src <= 1'b1;\n    end else begin\n      if (dst_busy) begin\n        if (dst_ready_i) begin\n          // Transfer complete, ready for next\n          dst_busy <= 1'b0;\n          dst_to_src <= 1'b1;\n        end\n        // If not ready, stay busy, keep data stable\n      end else begin\n        if (src_to_dst_sync[2]) begin\n          // New data available from source\n          dst_data_reg <= src_data_i;\n          dst_busy <= 1'b1;\n          dst_to_src <= 1'b0;\n        end else begin\n          // Ensure dst_to_src is high when idle\n          dst_to_src <= 1'b1;\n        end\n      end\n    end\n  end\n\n  assign dst_valid_o = dst_busy;\n  assign dst_data_o = dst_data_reg;\n\nendmodule\n```<|im_end|>",
