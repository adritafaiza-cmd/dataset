{
  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain: capture data and generate request\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_req;\n  reg             src_req_next;\n  wire            src_accept;\n\n  // Destination domain: acknowledge\n  reg             dst_ack;\n  reg             dst_ack_next;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_valid_reg;\n\n  // Synchronizers\n  reg [1:0] req_sync;\n  reg [1:0] ack_sync;\n\n  // Source domain logic\n  assign src_accept = src_valid_i & src_ready_o;\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_req <= 1'b0;\n      src_data_reg <= {WIDTH{1'b0}};\n    end else begin\n      if (src_accept) begin\n        src_req <= 1'b1;\n        src_data_reg <= src_data_i;\n      end else if (ack_sync[1]) begin\n        src_req <= 1'b0;\n      end\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_ack <= 1'b0;\n      dst_valid_reg <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n    end else begin\n      if (req_sync[1]) begin\n        dst_ack <= 1'b1;\n        dst_valid_reg <= 1'b1;\n        dst_data_reg <= src_data_reg;\n      end else if (dst_valid_reg & dst_ready_i) begin\n        dst_ack <= 1'b0;\n        dst_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronizers\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync <= 2'b00;\n    end else begin\n      ack_sync <= {ack_sync[0], dst_ack};\n    end\n  end\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync <= 2'b00;\n    end else begin\n      req_sync <= {req_sync[0], src_req};\n    end\n  end\n\n  // Outputs\n  assign src_ready_o = ~src_req;\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_data_o  = dst_data_reg;\n\nendmodule\n```<|im_end|>",
