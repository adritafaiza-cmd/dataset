{
  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain: capture data and generate request pulse\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_req_pulse;\n  wire src_accept = src_valid_i & src_ready_o;\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg <= {WIDTH{1'b0}};\n      src_req_pulse <= 1'b0;\n    end else begin\n      if (src_accept) begin\n        src_data_reg <= src_data_i;\n        src_req_pulse <= 1'b1;\n      end else begin\n        src_req_pulse <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize request pulse to destination domain\n  reg [2:0] req_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync <= 3'b000;\n    end else begin\n      req_sync <= {req_sync[1:0], src_req_pulse};\n    end\n  end\n\n  // Detect rising edge of synchronized request in destination domain\n  wire req_edge = req_sync[1] & ~req_sync[0];\n\n  // Destination domain: hold data and valid\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n    end else begin\n      if (req_edge) begin\n        dst_data_reg <= src_data_reg;\n        dst_valid_reg <= 1'b1;\n      end else if (dst_valid_reg & dst_ready_i) begin\n        dst_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize destination valid back to source domain\n  reg [2:0] valid_sync;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      valid_sync <= 3'b000;\n    end else begin\n      valid_sync <= {valid_sync[1:0], dst_valid_reg};\n    end\n  end\n\n  // Source ready: low when destination has an outstanding item\n  assign src_ready_o = ~valid_sync[2];\n\n  // Destination outputs\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
