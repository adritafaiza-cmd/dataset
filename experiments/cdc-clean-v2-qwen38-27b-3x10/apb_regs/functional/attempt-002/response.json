  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract APB signals from req_i\n  wire psel;\n  wire penable;\n  wire pwrite;\n  wire [ApbAddrWidth-1:0] paddr;\n  wire [ApbDataWidth-1:0] pwdata;\n  wire [ApbDataWidth/8-1:0] pstrb;\n\n  assign psel    = req_i.psel;\n  assign penable = req_i.penable;\n  assign pwrite  = req_i.pwrite;\n  assign paddr   = req_i.paddr;\n  assign pwdata  = req_i.pwdata;\n  assign pstrb   = req_i.pstrb;\n\n  // Response\n  assign resp_o.pready = 1'b1;\n  assign resp_o.pslverr = 1'b0;\n  assign resp_o.prdata  = 8'h0; // Not used for write-only, but keep valid\n\n  // Address decoding\n  // Calculate offset from base address\n  wire [ApbAddrWidth-1:0] addr_offset = paddr - base_addr_i;\n  \n  // Determine register index\n  // Each register occupies AddrOffset bytes\n  // We need to extract the register index from the address offset\n  // The number of bits needed to index NoApbRegs registers\n  localparam int unsigned RegIndexWidth = $clog2(NoApbRegs == 0 ? 1 : NoApbRegs);\n  \n  // The register index is the upper bits of the address offset\n  // Specifically, bits [RegIndexWidth + $clog2(AddrOffset) - 1 : $clog2(AddrOffset)]\n  // But simpler: divide the offset by AddrOffset\n  // Since AddrOffset is a power of 2 (typically), we can shift\n  // Let's use a more general approach: extract the register index\n  // The address offset within the register bank determines which register\n  // reg_idx = addr_offset / AddrOffset\n  \n  // For simplicity and correctness, let's compute the register index\n  // We'll use a combinational block to decode\n  wire [RegIndexWidth-1:0] reg_idx;\n  \n  // The register index is determined by the address offset\n  // Assuming AddrOffset is a power of 2, we can shift right by log2(AddrOffset)\n  localparam int unsigned AddrOffsetLog2 = $clog2(AddrOffset == 1 ? 1 : AddrOffset);\n  \n  assign reg_idx = addr_offset[RegIndexWidth + AddrOffsetLog2 - 1 : AddrOffsetLog2];\n  \n  // Check if the address is within the valid register range\n  wire addr_valid = (reg_idx < NoApbRegs);\n  \n  // Byte strobe for the register\n  // The byte strobes need to be aligned with the register's byte position\n  // The lower bits of the address offset determine which bytes within the register are accessed\n  wire [AddrOffsetLog2-1:0] byte_offset = addr_offset[AddrOffsetLog2-1:0];\n  \n  // Generate byte strobes for the register\n  // We need to map the APB byte strobes to the register's byte positions\n  // The APB data width may be larger than the register data width\n  // We only care about the bytes that overlap with the register\n  \n  // For each byte in the register, determine if it should be updated\n  // The register has RegDataWidth/8 bytes\n  localparam int unsigned RegBytes = RegDataWidth / 8;\n  \n  // Byte strobe for each byte of the register\n  wire [RegBytes-1:0] reg_strb;\n  \n  genvar i;\n  generate\n    for (i = 0; i < RegBytes; i++) begin : gen_strb\n      // The byte position in the APB data bus\n      // The register starts at byte_offset within the AddrOffset-byte block\n      // So the byte i of the register corresponds to APB data byte (byte_offset + i)\n      // But we need to check if this byte is within the APB data width\n      wire byte_in_range = (byte_offset + i) < (ApbDataWidth / 8);\n      assign reg_strb[i] = byte_in_range ? pstrb[byte_offset + i] : 1'b0;\n    end\n  endgenerate\n  \n  // Register storage\n  reg_data_t [NoApbRegs-1:0] reg_q;\n  \n  // Write enable\n  wire write_en = psel & penable & pwrite & addr_valid;\n  \n  // Update registers\n  integer j;\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (j = 0; j < NoApbRegs; j = j + 1) begin\n        if (ReadOnly[j])\n          reg_q[j] <= reg_init_i[j];\n        else\n          reg_q[j] <= '0;\n      end\n    end else begin\n      if (write_en) begin\n        for (j = 0; j < NoApbRegs; j = j + 1) begin\n          if (j == reg_idx && !ReadOnly[j]) begin\n            // Update only the strobed bytes\n            for (i = 0; i < RegBytes; i = i + 1) begin\n              if (reg_strb[i]) begin\n                reg_q[j][i*8 +: 8] <= pwdata[i*8 +: 8];\n              end\n            end\n          end\n        end\n      end\n    end\n  end\n  \n  // Output: read-only registers expose reg_init_i, writable registers expose reg_q\n  genvar k;\n  generate\n    for (k = 0; k < NoApbRegs; k++) begin : gen_out\n      assign reg_q_o[k] = ReadOnly[k] ? reg_init_i[k] : reg_q[k];\n    end\n  endgenerate\n\nendmodule\n```<|im_end|>",
