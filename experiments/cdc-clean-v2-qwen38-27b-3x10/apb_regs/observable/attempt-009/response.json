  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract APB signals from req_t\n  wire        psel    = req_i.psel;\n  wire        penable = req_i.penable;\n  wire        pwrite  = req_i.pwrite;\n  wire [ApbAddrWidth-1:0] paddr = req_i.paddr;\n  wire [ApbDataWidth-1:0] pwdata = req_i.pwdata;\n  wire [ApbDataWidth/8-1:0] pstrb = req_i.pstrb;\n\n  // APB ready is always high (single-cycle slave)\n  assign resp_o.pready = 1'b1;\n  assign resp_o.pslverr = 1'b0;\n\n  // Decode register index from address\n  // Address offset from base\n  wire [ApbAddrWidth-1:0] addr_offset = paddr - base_addr_i;\n  // Register index: divide by AddrOffset\n  wire [ApbAddrWidth-1:0] reg_idx_full = addr_offset / AddrOffset;\n  wire [ApbAddrWidth-1:0] reg_idx = reg_idx_full;\n\n  // Valid register index check\n  wire reg_valid = (reg_idx < NoApbRegs);\n\n  // Write enable: during APB write access (psel & penable & pwrite) and valid register\n  wire write_en = psel & penable & pwrite & reg_valid;\n\n  // Byte strobe mapping: map APB data bytes to register data bytes\n  // RegDataWidth may be smaller than ApbDataWidth\n  localparam int unsigned NumApbBytes  = ApbDataWidth / 8;\n  localparam int unsigned NumRegBytes  = RegDataWidth / 8;\n\n  // For each byte of the register, determine if it should be updated\n  // A register byte b is updated if:\n  //   - b < NumRegBytes\n  //   - The corresponding APB byte strobe is set\n  //   - The APB byte index maps to the same byte position in the register\n  // Since we assume aligned mapping, APB byte i maps to register byte i (if i < NumRegBytes)\n\n  // Build the write data for the register with byte strobes applied\n  // We need to combine existing register value with new data for strobed bytes\n\n  // For each register, compute the new value if written\n  // We'll use a combinational approach: for the selected register, apply byte strobes\n\n  // Determine which register is being accessed\n  // We'll generate the new value for the target register\n\n  // Helper: apply byte strobes to a register value\n  // For a given register index, compute new value\n  function automatic reg_data_t apply_strobes(\n    input reg_data_t old_val,\n    input [ApbDataWidth-1:0] new_val,\n    input [ApbDataWidth/8-1:1:0] strobes\n  );\n    reg_data_t result;\n    integer i;\n    begin\n      result = old_val;\n      for (i = 0; i < NumRegBytes; i = i + 1) begin\n        if (i < NumApbBytes && strobes[i]) begin\n          result[i*8 +: 8] = new_val[i*8 +: 8];\n        end\n      end\n    end\n  endfunction\n\n  // Compute the new value for the target register\n  reg_data_t new_reg_val;\n  assign new_reg_val = apply_strobes(\n    reg_q_o[reg_idx],\n    pwdata,\n    pstrb\n  );\n\n  // Register file\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i = i + 1) begin\n        if (ReadOnly[i])\n          reg_q_o[i] <= reg_init_i[i];\n        else\n          reg_q_o[i] <= '0;\n      end\n    end else begin\n      if (write_en) begin\n        if (!ReadOnly[reg_idx]) begin\n          reg_q_o[reg_idx] <= new_reg_val;\n        end\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>",
