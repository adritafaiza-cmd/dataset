{
  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract APB signals from req_t\n  wire psel    = req_i.psel;\n  wire penable = req_i.penable;\n  wire pwrite  = req_i.pwrite;\n  wire [ApbDataWidth-1:0] pwdata = req_i.pwdata;\n  wire [ApbDataWidth/8-1:0] pstrb = req_i.pstrb;\n  wire [ApbAddrWidth-1:0] paddr = req_i.paddr;\n\n  // Drive APB response\n  assign resp_o.pready = 1'b1;\n  assign resp_o.pslverr = 1'b0;\n  assign resp_o.prdata = 0;\n\n  // Register storage\n  reg_data_t [NoApbRegs-1:0] reg_q;\n\n  // Address decoding\n  wire [ApbAddrWidth-1:0] offset_addr = paddr - base_addr_i;\n  wire [ApbAddrWidth-1:0] reg_index_addr = offset_addr / AddrOffset;\n\n  // Determine if address is within valid range\n  wire addr_valid = (reg_index_addr < NoApbRegs);\n\n  // Write enable: APB access phase (psel & penable) and write operation\n  wire write_en = psel & penable & pwrite & addr_valid;\n\n  // Byte strobe mask for the register data width\n  // pstrb has ApbDataWidth/8 bits; we need to map to RegDataWidth bytes\n  // Assume RegDataWidth <= ApbDataWidth, and data is left-aligned\n  localparam int unsigned RegBytes = (RegDataWidth + 7) / 8;\n  localparam int unsigned ApbBytes = (ApbDataWidth + 7) / 8;\n\n  // Build byte strobe for register data\n  // For each byte in the register, check if the corresponding APB byte strobe is set\n  // The register data is the lower RegDataWidth bits of the APB data\n  wire [RegBytes-1:0] reg_strb;\n  genvar gi;\n  generate\n    for (gi = 0; gi < RegBytes; gi++) begin : gen_strb\n      if (gi < ApbBytes) begin : g_strb_valid\n        assign reg_strb[gi] = pstrb[gi];\n      end else begin : g_strb_zero\n        assign reg_strb[gi] = 1'b0;\n      end\n    end\n  endgenerate\n\n  // Write data: take lower RegDataWidth bits of pwdata\n  wire [RegDataWidth-1:0] write_data = pwdata[RegDataWidth-1:0];\n\n  // Update registers\n  integer i;\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (i = 0; i < NoApbRegs; i = i + 1) begin\n        if (ReadOnly[i]) begin\n          reg_q[i] <= reg_init_i[i];\n        end else begin\n          reg_q[i] <= '0;\n        end\n      end\n    end else begin\n      if (write_en) begin\n        for (i = 0; i < NoApbRegs; i = i + 1) begin\n          if (i == reg_index_addr) begin\n            if (!ReadOnly[i]) begin\n              // Byte-wise update\n              for (int b = 0; b < RegBytes; b = b + 1) begin\n                if (reg_strb[b]) begin\n                  reg_q[i][b*8 +: 8] <= write_data[b*8 +: 8];\n                end\n              end\n            end\n          end\n        end\n      end\n    end\n  end\n\n  // Output registers\n  assign reg_q_o = reg_q;\n\nendmodule\n```<|im_end|>",
