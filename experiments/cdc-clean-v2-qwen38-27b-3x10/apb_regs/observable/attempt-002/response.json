  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract APB signals from req_t\n  wire        psel    = req_i.psel;\n  wire        penable = req_i.penable;\n  wire        pwrite  = req_i.pwrite;\n  wire [ApbAddrWidth-1:0] paddr = req_i.paddr;\n  wire [ApbDataWidth-1:0] pwdata = req_i.pwdata;\n  wire [ApbDataWidth/8-1:0] pstrb = req_i.pstrb;\n\n  // Response\n  assign resp_o.pready = 1'b1;\n  assign resp_o.pslverr = 1'b0;\n  assign resp_o.prdata = 8'h0; // Not used in this simplified interface\n\n  // Register file\n  reg_data_t [NoApbRegs-1:0] reg_q;\n\n  // Address decoding\n  // Each register occupies AddrOffset bytes\n  // The register index is derived from the offset from base_addr\n  wire [ApbAddrWidth-1:0] addr_offset = paddr - base_addr_i;\n  \n  // Number of address bits needed to select a register\n  // AddrOffset is in bytes, so log2(AddrOffset) bits are for byte offset within register\n  // The remaining higher bits select the register\n  // We need to compute: reg_index = addr_offset / AddrOffset\n  // Since AddrOffset is a power of 2 (typically 4), we can right-shift\n  \n  // Compute log2 of AddrOffset\n  // For simplicity, assume AddrOffset is a power of 2\n  // reg_index = addr_offset >> log2(AddrOffset)\n  \n  // Let's compute the shift amount\n  // We'll use a simple approach: divide by AddrOffset\n  wire [ApbAddrWidth-1:0] reg_index_raw = addr_offset / AddrOffset;\n  \n  // Check if the address is within the valid range\n  wire addr_valid = (reg_index_raw < NoApbRegs);\n  \n  // Byte strobe handling\n  // pstrb has ApbDataWidth/8 bits\n  // We need to apply byte strobes to the register data\n  // RegDataWidth may be different from ApbDataWidth\n  \n  // For each register, apply the byte strobes\n  // The byte strobes correspond to bytes in the APB data bus\n  // We need to map these to the register data width\n  \n  // Let's handle the write logic\n  // During a write (psel & penable & pwrite), update the register if address is valid\n  \n  // Byte strobe mask for the register data\n  // We need to create a mask based on pstrb and the relationship between ApbDataWidth and RegDataWidth\n  \n  // For simplicity, assume ApbDataWidth >= RegDataWidth or they are equal\n  // The byte strobes apply to the lower bytes of the APB data\n  // We need to mask the register data with the strobes\n  \n  // Create a byte-enable mask for the register\n  // Each bit in pstrb enables a byte in pwdata\n  // We need to expand this to a bit mask for RegDataWidth bits\n  \n  // Let's build the mask\n  reg_data_t write_mask;\n  integer i;\n  always @* begin\n    write_mask = '0;\n    for (i = 0; i < RegDataWidth/8; i++) begin\n      if (i < ApbDataWidth/8) begin\n        if (pstrb[i]) begin\n          write_mask[i*8 +: 8] = 8'hFF;\n        end\n      end\n    end\n  end\n\n  // Write data: apply the mask\n  reg_data_t write_data;\n  always @* begin\n    write_data = '0;\n    for (i = 0; i < RegDataWidth/8; i++) begin\n      if (i < ApbDataWidth/8) begin\n        write_data[i*8 +: 8] = pwdata[i*8 +: 8];\n      end\n    end\n  end\n\n  // Sequential logic for register file\n  integer j;\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (j = 0; j < NoApbRegs; j++) begin\n        if (ReadOnly[j]) begin\n          reg_q[j] <= reg_init_i[j];\n        end else begin\n          reg_q[j] <= '0;\n        end\n      end\n    end else begin\n      // Check if we're in a write phase\n      if (psel && penable && pwrite && addr_valid) begin\n        for (j = 0; j < NoApbRegs; j++) begin\n          if (j == reg_index_raw) begin\n            if (!ReadOnly[j]) begin\n              // Apply byte strobes\n              reg_q[j] <= (reg_q[j] & ~write_mask) | (write_data & write_mask);\n            end\n          end\n        end\n      end\n    end\n  end\n\n  // Output registers\n  always @* begin\n    for (j = 0; j < NoApbRegs; j++) begin\n      if (ReadOnly[j]) begin\n        reg_q_o[j] = reg_init_i[j];\n      end else begin\n        reg_q_o[j] = reg_q[j];\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>",
