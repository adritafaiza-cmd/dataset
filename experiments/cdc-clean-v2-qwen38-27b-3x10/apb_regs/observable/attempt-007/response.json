{
  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract APB signals from req_t\n  wire        psel    = req_i.psel;\n  wire        penable = req_i.penable;\n  wire        pwrite  = req_i.pwrite;\n  wire [ApbDataWidth-1:0] pwdata = req_i.pwdata;\n  wire [ApbDataWidth/8-1:0] pstrb = req_i.pstrb;\n  wire [ApbAddrWidth-1:0] paddr = req_i.paddr;\n\n  // Drive APB response\n  assign resp_o.pready = 1'b1;\n  assign resp_o.pslverr = 1'b0;\n  assign resp_o.prdata = 0;\n\n  // Register storage\n  reg_data_t [NoApbRegs-1:0] regs;\n\n  // Address decoding\n  wire [ApbAddrWidth-1:0] offset_addr = paddr - base_addr_i;\n  wire [ApbAddrWidth-1:0] reg_index_addr = offset_addr / AddrOffset;\n  wire [ApbAddrWidth-1:0] byte_offset = offset_addr % AddrOffset;\n\n  // Determine if address is in range\n  wire addr_in_range = (reg_index_addr < NoApbRegs);\n\n  // Determine if this is a write access during APB transfer\n  wire write_valid = psel & penable & pwrite & addr_in_range;\n\n  // Determine which register index is being accessed\n  wire [ApbAddrWidth-1:0] reg_idx = reg_index_addr;\n\n  // Byte strobe mask for the register\n  // pstrb has ApbDataWidth/8 bits, each corresponding to a byte\n  // We need to map byte_offset to the appropriate strobe bits\n  // The register data width is RegDataWidth, so we have RegDataWidth/8 bytes\n  // The byte_offset tells us which byte within the register is being accessed\n  // But pstrb already encodes which bytes are valid for the APB write\n\n  // For each register, we need to apply byte strobes\n  // The strobe bits correspond to bytes in the APB data bus\n  // byte_offset tells us the starting byte position within the register\n\n  // Generate strobe mask for the target register\n  // pstrb[i] corresponds to byte i of the APB data bus\n  // The register's byte j corresponds to APB data byte (byte_offset + j)\n  // So for register byte j, the strobe is pstrb[byte_offset + j] if (byte_offset + j) < ApbDataWidth/8\n\n  // We'll build the write data and mask for the target register\n  // Since we can't easily do variable indexing in a combinational block for all registers,\n  // we'll use a case statement or generate\n\n  // For simplicity, we'll handle the write in the always block\n  // by checking if the register index matches and applying the appropriate strobes\n\n  // Determine the number of bytes in the register\n  localparam int unsigned RegBytes = RegDataWidth / 8;\n  localparam int unsigned ApbBytes = ApbDataWidth / 8;\n\n  // For the target register, compute the write data and mask\n  // We'll do this in the always block\n\n  // Reset and register update\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (ReadOnly[i])\n          regs[i] <= reg_init_i[i];\n        else\n          regs[i] <= '0;\n      end\n    end else begin\n      if (write_valid) begin\n        // Apply byte strobes to the target register\n        // For each byte in the register, check if the corresponding APB strobe is set\n        for (int b = 0; b < RegBytes; b++) begin\n          // The APB data byte index for this register byte is byte_offset + b\n          // But we need to be careful: byte_offset is in bytes, and pstrb has ApbBytes bits\n          // If byte_offset + b < ApbBytes, then pstrb[byte_offset + b] is the strobe\n          // Otherwise, no strobe applies (shouldn't happen if address is in range)\n          if ((byte_offset + b) < ApbBytes) begin\n            if (pstrb[byte_offset + b]) begin\n              // Update byte b of the register\n              // The APB data byte is pwdata[(byte_offset + b)*8 +: 8]\n              // The register byte b is regs[reg_idx][b*8 +: 8]\n              if (!ReadOnly[reg_idx]) begin\n                regs[reg_idx][b*8 +: 8] <= pwdata[(byte_offset + b)*8 +: 8];\n              end\n            end\n          end\n        end\n      end\n    end\n  end\n\n  // Drive register outputs\n  always @(*) begin\n    for (int i = 0; i < NoApbRegs; i++) begin\n      if (ReadOnly[i])\n        reg_q_o[i] = reg_init_i[i];\n      else\n        reg_q_o[i] = regs[i];\n    end\n  end\n\nendmodule\n```<|im_end|>",
