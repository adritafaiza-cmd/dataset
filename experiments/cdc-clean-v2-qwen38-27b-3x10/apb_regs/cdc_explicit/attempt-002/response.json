  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract APB signals from req_i\n  wire psel;\n  wire penable;\n  wire pwrite;\n  wire [ApbAddrWidth-1:0] paddr;\n  wire [ApbDataWidth-1:0] pwdata;\n  wire [ApbDataWidth/8-1:0] pstrb;\n\n  assign psel    = req_i.psel;\n  assign penable = req_i.penable;\n  assign pwrite  = req_i.pwrite;\n  assign paddr   = req_i.paddr;\n  assign pwdata  = req_i.pwdata;\n  assign pstrb   = req_i.pstrb;\n\n  // Response\n  assign resp_o.pready = 1'b1;\n  assign resp_o.pslverr = 1'b0;\n  assign resp_o.prdata  = 8'h0; // Not used for write-only, but keep valid\n\n  // Address decoding\n  // Each register is spaced AddrOffset bytes apart\n  // The offset from base address determines which register\n  // We need to compute: (paddr - base_addr_i) / AddrOffset\n  // But we need to be careful with the width\n\n  // Compute the byte offset from base\n  wire [ApbAddrWidth-1:0] byte_offset = paddr - base_addr_i;\n\n  // Number of address bits needed to index registers\n  // NoApbRegs registers, so we need ceil(log2(NoApbRegs)) bits\n  // The register index is byte_offset / AddrOffset\n  // AddrOffset is in bytes, so we shift right by log2(AddrOffset)\n  // But AddrOffset might not be a power of 2, so we do division\n\n  // For simplicity and correctness, we'll use a combinational decoder\n  // that checks if the address falls within each register's range\n\n  // The range for register i is:\n  // base_addr_i + i * AddrOffset <= paddr < base_addr_i + (i+1) * AddrOffset\n\n  // We'll generate a one-hot select signal for each register\n  logic [NoApbRegs-1:0] reg_sel;\n\n  genvar i;\n  generate\n    for (i = 0; i < NoApbRegs; i = i + 1) begin : gen_sel\n      // Check if paddr is in the range for register i\n      // start = base_addr_i + i * AddrOffset\n      // end   = base_addr_i + (i+1) * AddrOffset\n      // We need to compare paddr with these bounds\n\n      // Compute start and end addresses\n      // i * AddrOffset might overflow, but we assume NoApbRegs * AddrOffset fits in ApbAddrWidth\n      wire [ApbAddrWidth-1:0] start_addr = base_addr_i + (ApbAddrWidth'(i) * ApbAddrWidth'(AddrOffset));\n      wire [ApbAddrWidth-1:0] end_addr   = base_addr_i + (ApbAddrWidth'(i+1) * ApbAddrWidth'(AddrOffset));\n\n      // Check if paddr is in [start_addr, end_addr)\n      assign reg_sel[i] = (paddr >= start_addr) && (paddr < end_addr);\n    end\n  endgenerate\n\n  // Write enable: APB access phase (psel && penable) and write\n  wire apb_write = psel && penable && pwrite;\n\n  // Register file\n  reg_data_t [NoApbRegs-1:0] reg_q;\n\n  // Byte strobe width\n  localparam int unsigned NumBytes = RegDataWidth / 8;\n\n  // For each register, handle write with byte strobes\n  genvar j;\n  generate\n    for (j = 0; j < NoApbRegs; j = j + 1) begin : gen_reg\n      if (ReadOnly[j]) begin : gen_ro\n        // Read-only register: always expose reg_init_i\n        assign reg_q[j] = reg_init_i[j];\n      end else begin : gen_rw\n        // Writable register\n        always @(posedge pclk_i or negedge preset_ni) begin\n          if (!preset_ni) begin\n            reg_q[j] <= '0;\n          end else if (apb_write && reg_sel[j]) begin\n            // Apply byte strobes\n            // pwdata is ApbDataWidth bits, pstrb is ApbDataWidth/8 bits\n            // We need to map the byte strobes to the register's bytes\n            // The register is RegDataWidth bits wide\n            // The APB data bus is ApbDataWidth bits wide\n            // We assume ApbDataWidth >= RegDataWidth, and the lower RegDataWidth bits of pwdata\n            // correspond to the register, with pstrb[0] corresponding to the least significant byte\n\n            // For each byte in the register, check if the corresponding strobe is set\n            // and if that byte is within the APB data width\n            for (int b = 0; b < NumBytes; b = b + 1) begin\n              // The byte index in the APB data bus\n              // We assume the register is aligned to the lower bytes of the APB data bus\n              // So byte b of the register corresponds to byte b of pwdata, if b < ApbDataWidth/8\n              if (b < (ApbDataWidth / 8)) begin\n                if (pstrb[b]) begin\n                  reg_q[j][b*8 +: 8] <= pwdata[b*8 +: 8];\n                end\n              end\n            end\n          end\n        end\n      end\n    end\n  endgenerate\n\n  // Drive output\n  assign reg_q_o = reg_q;\n\nendmodule\n```<|im_end|>",
