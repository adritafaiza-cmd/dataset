{
  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract APB signals from req_t\n  wire psel;\n  wire penable;\n  wire pwrite;\n  wire [ApbDataWidth-1:0] pwdata;\n  wire [ApbDataWidth/8-1:0] pstrb;\n  wire [ApbAddrWidth-1:0] paddr;\n\n  assign psel    = req_i.psel;\n  assign penable = req_i.penable;\n  assign pwrite  = req_i.pwrite;\n  assign pwdata  = req_i.pwdata;\n  assign pstrb   = req_i.pstrb;\n  assign paddr   = req_i.paddr;\n\n  // Response\n  assign resp_o.pready = 1'b1;\n  assign resp_o.pslverr = 1'b0;\n  assign resp_o.prdata  = 8'h0; // Not used for write; for read we could mux but spec says read-only expose reg_init_i via reg_q_o\n\n  // Address decoding\n  // Each register is spaced AddrOffset bytes apart\n  // Compute register index from address offset from base\n  wire [ApbAddrWidth-1:0] addr_offset = paddr - base_addr_i;\n  \n  // Number of address bits needed to select a register\n  // AddrOffset is in bytes, so log2(AddrOffset) bits are for byte offset within register\n  // The register index is the upper bits\n  localparam int unsigned ADDR_OFFSET_BITS = (AddrOffset > 1) ? $clog2(AddrOffset) : 0;\n  \n  // Register index: shift right by ADDR_OFFSET_BITS\n  wire [ApbAddrWidth-1:ADDR_OFFSET_BITS] reg_idx_raw = addr_offset[ApbAddrWidth-1:ADDR_OFFSET_BITS];\n  \n  // Valid register index\n  wire [NoApbRegs-1:0] reg_valid = '0;\n  genvar gi;\n  generate\n    for (gi = 0; gi < NoApbRegs; gi = gi + 1) begin : gen_valid\n      assign reg_valid[gi] = (reg_idx_raw == gi[ApbAddrWidth-ADDR_OFFSET_BITS:0]);\n    end\n  endgenerate\n\n  // Write enable for each register\n  wire [NoApbRegs-1:0] wr_en = '0;\n  generate\n    for (gi = 0; gi < NoApbRegs; gi = gi + 1) begin : gen_wren\n      assign wr_en[gi] = psel & penable & pwrite & reg_valid[gi] & ~ReadOnly[gi];\n    end\n  endgenerate\n\n  // Byte strobe mapping\n  // RegDataWidth may be different from ApbDataWidth\n  // We need to map pstrb bytes to the register's byte lanes\n  // Assume RegDataWidth <= ApbDataWidth, and the register occupies the lower RegDataWidth bits\n  // pstrb has ApbDataWidth/8 bits, each corresponding to a byte in pwdata\n  // For register gi, byte b of the register (0-indexed from LSB) corresponds to pstrb[b] if b < RegDataWidth/8\n\n  // Register storage\n  reg_data_t [NoApbRegs-1:0] reg_q;\n\n  // Write data preparation\n  // For each register, build the write data with byte strobes applied\n  wire [RegDataWidth-1:0] wr_data [NoApbRegs];\n  generate\n    for (gi = 0; gi < NoApbRegs; gi = gi + 1) begin : gen_wrdata\n      // Start with current value\n      assign wr_data[gi] = reg_q[gi];\n      // Apply byte strobes\n      localparam int unsigned REG_BYTES = (RegDataWidth + 7) / 8;\n      for (int bi = 0; bi < REG_BYTES; bi = bi + 1) begin : gen_bytes\n        if (bi < ApbDataWidth/8) begin : gen_byte_valid\n          assign wr_data[gi][bi*8 +: 8] = pstrb[bi] ? pwdata[bi*8 +: 8] : reg_q[gi][bi*8 +: 8];\n        end\n      end\n    end\n  endgenerate\n\n  // Register update\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i = i + 1) begin\n        if (ReadOnly[i])\n          reg_q[i] <= reg_init_i[i];\n        else\n          reg_q[i] <= '0;\n      end\n    end else begin\n      for (int i = 0; i < NoApbRegs; i = i + 1) begin\n        if (wr_en[i])\n          reg_q[i] <= wr_data[i];\n        else if (ReadOnly[i])\n          reg_q[i] <= reg_init_i[i];\n      end\n    end\n  end\n\n  // Output\n  generate\n    for (gi = 0; gi < NoApbRegs; gi = gi + 1) begin : gen_out\n      if (ReadOnly[gi])\n        assign reg_q_o[gi] = reg_init_i[gi];\n      else\n        assign reg_q_o[gi] = reg_q[gi];\n    end\n  endgenerate\n\nendmodule\n```<|im_end|>",
