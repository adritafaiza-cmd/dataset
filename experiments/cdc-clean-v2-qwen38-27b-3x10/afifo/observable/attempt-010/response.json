  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam PTR_W = LGFIFO + 1;\n\n\t// Storage\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\n\t// Write pointer (write clock domain)\n\treg [PTR_W-1:0] wr_ptr;\n\t// Read pointer (read clock domain)\n\treg [PTR_W-1:0] rd_ptr;\n\n\t// Gray code pointers for CDC\n\treg [PTR_W-1:0] wr_ptr_gray;\n\treg [PTR_W-1:0] rd_ptr_gray;\n\n\t// Synchronized read pointer in write domain\n\treg [PTR_W-1:0] rd_ptr_gray_sync1;\n\treg [PTR_W-1:0] rd_ptr_gray_sync2;\n\n\t// Synchronized write pointer in read domain\n\treg [PTR_W-1:0] wr_ptr_gray_sync1;\n\treg [PTR_W-1:0] wr_ptr_gray_sync2;\n\n\t// Full/Empty flags\n\twire wr_full;\n\twire rd_empty;\n\n\t// Convert binary to gray\n\tfunction [PTR_W-1:0] bin2gray;\n\t\tinput [PTR_W-1:0] bin;\n\t\tbegin\n\t\t\tbin2gray = bin ^ (bin >> 1);\n\t\tend\n\tendfunction\n\n\t// Convert gray to binary\n\tfunction [PTR_W-1:0] gray2bin;\n\t\tinput [PTR_W-1:0] gray;\n\t\treg [PTR_W-1:0] bin;\n\t\tbegin\n\t\t\tbin[PTR_W-1] = gray[PTR_W-1];\n\t\t\tfor (i = PTR_W-2; i >= 0; i = i - 1)\n\t\t\t\tbin[i] = gray[i] ^ bin[i+1];\n\t\t\tgray2bin = bin;\n\t\tend\n\tendfunction\n\n\t// Write clock domain\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= {PTR_W{1'b0}};\n\t\t\twr_ptr_gray <= {PTR_W{1'b0}};\n\t\tend else if (i_wr && !wr_full) begin\n\t\t\tmem[wr_ptr[LGFIFO-1:0]] <= i_wr_data;\n\t\t\twr_ptr <= wr_ptr + 1'b1;\n\t\t\twr_ptr_gray <= bin2gray(wr_ptr + 1'b1);\n\t\tend\n\tend\n\n\t// Synchronize read pointer gray into write domain\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\trd_ptr_gray_sync1 <= {PTR_W{1'b0}};\n\t\t\trd_ptr_gray_sync2 <= {PTR_W{1'b0}};\n\t\tend else begin\n\t\t\trd_ptr_gray_sync1 <= rd_ptr_gray;\n\t\t\trd_ptr_gray_sync2 <= rd_ptr_gray_sync1;\n\t\tend\n\tend\n\n\t// Full condition: write pointer has lapped read pointer by DEPTH\n\t// In gray code, full when wr_ptr_gray == {~rd_ptr_gray_sync2[PTR_W-1:0], rd_ptr_gray_sync2[PTR_W-2:0]}\n\t// Actually, full when the MSB differs and the rest are equal\n\twire [PTR_W-1:0] rd_ptr_gray_sync2_inv_msb = {~rd_ptr_gray_sync2[PTR_W-1], rd_ptr_gray_sync2[PTR_W-2:0]};\n\tassign wr_full = (wr_ptr_gray == rd_ptr_gray_sync2_inv_msb);\n\n\t// Read clock domain\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= {PTR_W{1'b0}};\n\t\t\trd_ptr_gray <= {PTR_W{1'b0}};\n\t\tend else if (i_rd && !rd_empty) begin\n\t\t\trd_ptr <= rd_ptr + 1'b1;\n\t\t\trd_ptr_gray <= bin2gray(rd_ptr + 1'b1);\n\t\tend\n\tend\n\n\t// Synchronize write pointer gray into read domain\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\twr_ptr_gray_sync1 <= {PTR_W{1'b0}};\n\t\t\twr_ptr_gray_sync2 <= {PTR_W{1'b0}};\n\t\tend else begin\n\t\t\twr_ptr_gray_sync1 <= wr_ptr_gray;\n\t\t\twr_ptr_gray_sync2 <= wr_ptr_gray_sync1;\n\t\tend\n\tend\n\n\t// Empty condition: write pointer equals read pointer\n\tassign rd_empty = (wr_ptr_gray_sync2 == rd_ptr_gray);\n\n\t// Output data: read from memory at current read pointer\n\twire [WIDTH-1:0] rd_data_comb = mem[rd_ptr[LGFIFO-1:0]];\n\n\t// Output registering\n\treg [WIDTH-1:0] o_rd_data_reg;\n\treg o_rd_empty_reg;\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\to_rd_data_reg <= {WIDTH{1'b0}};\n\t\t\to_rd_empty_reg <= 1'b1;\n\t\tend else begin\n\t\t\to_rd_data_reg <= rd_data_comb;\n\t\t\to_rd_empty_reg <= rd_empty;\n\t\tend\n\tend\n\n\t// Assign outputs\n\talways @(*) begin\n\t\tif (OPT_REGISTER_READS) begin\n\t\t\to_rd_data = o_rd_data_reg;\n\t\t\to_rd_empty = o_rd_empty_reg;\n\t\tend else begin\n\t\t\to_rd_data = rd_data_comb;\n\t\t\to_rd_empty = rd_empty;\n\t\tend\n\t\to_wr_full = wr_full;\n\tend\n\nendmodule\n```<|im_end|>",
