  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\t// Internal parameters\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam ADDR_W = LGFIFO;\n\tlocalparam CNT_W = LGFIFO + 1;\n\n\t// Storage\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\n\t// Write pointer (write clock domain)\n\treg [ADDR_W:0] wptr; // extra bit for Gray code\n\n\t// Read pointer (read clock domain)\n\treg [ADDR_W:0] rptr;\n\n\t// Gray code conversion\n\tfunction [ADDR_W:0] bin2gray;\n\t\tinput [ADDR_W:0] bin;\n\t\tbegin\n\t\t\tbin2gray = bin ^ (bin >> 1);\n\t\tend\n\tendfunction\n\n\t// Write side\n\twire [ADDR_W:0] wptr_gray = bin2gray(wptr);\n\twire [ADDR_W:0] rptr_gray_sync; // synchronized read pointer in write domain\n\n\t// Synchronize read pointer to write clock domain\n\treg [ADDR_W:0] rptr_gray_sync_reg [0:NFF-1];\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\trptr_gray_sync_reg[0] <= {1'b0, {ADDR_W{1'b0}}};\n\t\t\trptr_gray_sync_reg[1] <= {1'b0, {ADDR_W{1'b0}}};\n\t\t\tif (NFF > 2) begin\n\t\t\t\tfor (int i = 2; i < NFF; i = i + 1)\n\t\t\t\t\trptr_gray_sync_reg[i] <= {1'b0, {ADDR_W{1'b0}}};\n\t\t\tend\n\t\tend else begin\n\t\t\trptr_gray_sync_reg[0] <= rptr_gray;\n\t\t\trptr_gray_sync_reg[1] <= rptr_gray_sync_reg[0];\n\t\t\tif (NFF > 2) begin\n\t\t\t\tfor (int i = 2; i < NFF; i = i + 1)\n\t\t\t\t\trptr_gray_sync_reg[i] <= rptr_gray_sync_reg[i-1];\n\t\t\tend\n\t\tend\n\tend\n\tassign rptr_gray_sync = rptr_gray_sync_reg[NFF-1];\n\n\t// Write full detection\n\t// Full when write pointer has lapped read pointer by DEPTH\n\t// In Gray code: MSB differs, rest same\n\twire wr_full_raw = (wptr_gray[ADDR_W] != rptr_gray_sync[ADDR_W]) &&\n\t\t\t\t\t   (wptr_gray[ADDR_W-1:0] == rptr_gray_sync[ADDR_W-1:0]);\n\n\t// Write enable\n\twire wr_en = i_wr & ~o_wr_full;\n\n\t// Write operation\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twptr <= {1'b0, {ADDR_W{1'b0}}};\n\t\tend else if (WRITE_ON_POSEDGE) begin\n\t\t\tif (wr_en)\n\t\t\t\twptr <= wptr + 1'b1;\n\t\tend else begin\n\t\t\t// negedge write\n\t\t\tif (wr_en)\n\t\t\t\twptr <= wptr + 1'b1;\n\t\tend\n\tend\n\n\t// Write data\n\talways @(posedge i_wclk) begin\n\t\tif (wr_en)\n\t\t\tmem[wptr[ADDR_W-1:0]] <= i_wr_data;\n\tend\n\n\t// o_wr_full output\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\to_wr_full <= 1'b0;\n\t\telse\n\t\t\to_wr_full <= wr_full_raw;\n\tend\n\n\t// Read side\n\twire [ADDR_W:0] wptr_gray_sync; // synchronized write pointer in read domain\n\n\t// Synchronize write pointer to read clock domain\n\treg [ADDR_W:0] wptr_gray_sync_reg [0:NFF-1];\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\twptr_gray_sync_reg[0] <= {1'b0, {ADDR_W{1'b0}}};\n\t\t\twptr_gray_sync_reg[1] <= {1'b0, {ADDR_W{1'b0}}};\n\t\t\tif (NFF > 2) begin\n\t\t\t\tfor (int i = 2; i < NFF; i = i + 1)\n\t\t\t\t\twptr_gray_sync_reg[i] <= {1'b0, {ADDR_W{1'b0}}};\n\t\t\tend\n\t\tend else begin\n\t\t\twptr_gray_sync_reg[0] <= wptr_gray;\n\t\t\twptr_gray_sync_reg[1] <= wptr_gray_sync_reg[0];\n\t\t\tif (NFF > 2) begin\n\t\t\t\tfor (int i = 2; i < NFF; i = i + 1)\n\t\t\t\t\twptr_gray_sync_reg[i] <= wptr_gray_sync_reg[i-1];\n\t\t\tend\n\t\tend\n\tend\n\tassign wptr_gray_sync = wptr_gray_sync_reg[NFF-1];\n\n\t// Read empty detection\n\t// Empty when write pointer equals read pointer\n\twire rd_empty_raw = (wptr_gray_sync == rptr_gray);\n\n\t// Read enable\n\twire rd_en = i_rd & ~o_rd_empty;\n\n\t// Read operation\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trptr <= {1'b0, {ADDR_W{1'b0}}};\n\t\tend else begin\n\t\t\tif (rd_en)\n\t\t\t\trptr <= rptr + 1'b1;\n\t\tend\n\tend\n\n\t// o_rd_empty output\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_empty <= 1'b1;\n\t\telse\n\t\t\to_rd_empty <= rd_empty_raw;\n\tend\n\n\t// Read data output\n\t// The data is read from memory at the current read pointer\n\t// We need to handle OPT_REGISTER_READS\n\t// When OPT_REGISTER_READS=1: register the read data\n\t// When OPT_REGISTER_READS=0: combinational read (but still synchronized to rclk)\n\n\t// The read address is rptr[ADDR_W-1:0]\n\t// We read from memory combinationally and then register if needed\n\n\treg [WIDTH-1:0] rd_data_reg;\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_data_reg <= {WIDTH{1'b0}};\n\t\tend else begin\n\t\t\tif (OPT_REGISTER_READS) begin\n\t\t\t\t// Register the read data\n\t\t\t\trd_data_reg <= mem[rptr[ADDR_W-1:0]];\n\t\t\tend else begin\n\t\t\t\t// Still register for destination-clock synchronization\n\t\t\t\t// But the spec says \"neither setting provides an asynchronous memory bypass\"\n\t\t\t\t// So we always register\n\t\t\t\trd_data_reg <= mem[rptr[ADDR_W-1:0]];\n\t\t\tend\n\t\tend\n\tend\n\n\t// Output assignment\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_data <= {WIDTH{1'b0}};\n\t\telse\n\t\t\to_rd_data <= rd_data_reg;\n\tend\n\nendmodule\n```<|im_end|>",
