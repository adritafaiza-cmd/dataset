{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0] tx_word;\n    reg [N-1:0] rx_word;\n    reg [3:0]   bit_cnt;\n    reg         busy;\n    reg         tx_valid;\n    reg         rx_valid;\n\n    // SPI clock generation\n    reg [3:0]   sclk_div_cnt;\n    reg         sclk_phase;\n    reg         sclk_out;\n\n    // MOSI output\n    assign spi_mosi_o = tx_word[N-1];\n\n    // SPI clock generation logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_div_cnt <= 4'd0;\n            sclk_phase   <= 1'b0;\n            sclk_out     <= 1'b0;\n        end else if (busy) begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 4'd0;\n                sclk_phase   <= ~sclk_phase;\n                sclk_out     <= sclk_phase;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 4'd1;\n            end\n        end else begin\n            sclk_div_cnt <= 4'd0;\n            sclk_phase   <= 1'b0;\n            sclk_out     <= 1'b0;\n        end\n    end\n\n    assign spi_sck_o = sclk_out;\n\n    // SPI data shift logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            tx_word   <= {N{1'b0}};\n            rx_word   <= {N{1'b0}};\n            bit_cnt   <= 4'd0;\n            busy      <= 1'b0;\n            tx_valid  <= 1'b0;\n            rx_valid  <= 1'b0;\n            spi_ssel_o <= 1'b1;\n        end else if (busy) begin\n            // On rising edge of sclk_out, shift out MSB and shift in MISO\n            if (sclk_out == 1'b1 && sclk_phase == 1'b1) begin\n                // This is the rising edge of the SPI clock\n                tx_word <= {tx_word[N-2:0], 1'b0};\n                rx_word <= {rx_word[N-2:0], spi_miso_i};\n                if (bit_cnt == N - 1) begin\n                    bit_cnt  <= 4'd0;\n                    busy     <= 1'b0;\n                    rx_valid <= 1'b1;\n                    spi_ssel_o <= 1'b1;\n                end else begin\n                    bit_cnt <= bit_cnt + 4'd1;\n                end\n            end\n        end else if (tx_valid) begin\n            // Start a new transaction\n            tx_word    <= di_i;\n            rx_word    <= {N{1'b0}};\n            bit_cnt    <= 4'd0;\n            busy       <= 1'b1;\n            tx_valid   <= 1'b0;\n            spi_ssel_o <= 1'b0;\n        end\n    end\n\n    // Parallel side logic\n    reg        wr_ack_reg;\n    reg        do_valid_reg;\n    reg [N-1:0] do_reg;\n    reg        di_req_reg;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wr_ack_reg   <= 1'b0;\n            do_valid_reg <= 1'b0;\n            do_reg       <= {N{1'b0}};\n            di_req_reg   <= 1'b1;\n        end else begin\n            // Default: deassert one-cycle pulses\n            wr_ack_reg   <= 1'b0;\n            do_valid_reg <= 1'b0;\n\n            // Accept new word when not busy and wren is asserted\n            if (di_req_reg && wren_i) begin\n                wr_ack_reg <= 1'b1;\n                di_req_reg <= 1'b0;\n                tx_valid   <= 1'b1;\n            end\n\n            // When receive is valid, output the word and re-enable di_req\n            if (rx_valid) begin\n                do_valid_reg <= 1'b1;\n                do_reg       <= rx_word;\n                di_req_reg   <= 1'b1;\n                rx_valid     <= 1'b0;\n            end\n        end\n    end\n\n    assign wr_ack_o   = wr_ack_reg;\n    assign do_valid_o = do_valid_reg;\n    assign do_o       = do_reg;\n    assign di_req_o   = di_req_reg;\n\nendmodule\n```<|im_end|>",
