  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // SPI clock divider\n    localparam SPI_CLK_DIV = SPI_2X_CLK_DIV;\n    reg [31:0] spi_clk_cnt;\n    wire spi_clk_edge;\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            spi_clk_cnt <= 0;\n        else\n            spi_clk_cnt <= spi_clk_cnt + 1;\n    end\n\n    assign spi_clk_edge = (spi_clk_cnt == SPI_CLK_DIV - 1);\n\n    // SPI state machine\n    localparam S_IDLE = 0;\n    localparam S_TX   = 1;\n    localparam S_RX   = 2;\n\n    reg [1:0] spi_state;\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [31:0] bit_cnt;\n    reg spi_sck_reg;\n    reg spi_ssel_reg;\n    reg spi_mosi_reg;\n\n    // Parallel side handshake\n    reg di_req_reg;\n    reg wr_ack_reg;\n    reg do_valid_reg;\n    reg [N-1:0] do_reg;\n    reg [N-1:0] pending_word;\n    reg pending_valid;\n\n    // Clock domain crossing: pclk to sclk\n    reg [N-1:0] pclk_word_sync1;\n    reg [N-1:0] pclk_word_sync2;\n    reg pclk_wren_sync1;\n    reg pclk_wren_sync2;\n    reg pclk_wren_sync3;\n    reg pclk_wr_ack_sync1;\n    reg pclk_wr_ack_sync2;\n    reg pclk_do_valid_sync1;\n    reg pclk_do_valid_sync2;\n    reg [N-1:0] pclk_do_sync1;\n    reg [N-1:0] pclk_do_sync2;\n\n    // pclk domain: synchronize sclk signals\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            pclk_word_sync1 <= 0;\n            pclk_word_sync2 <= 0;\n            pclk_wren_sync1 <= 0;\n            pclk_wren_sync2 <= 0;\n            pclk_wren_sync3 <= 0;\n            pclk_wr_ack_sync1 <= 0;\n            pclk_wr_ack_sync2 <= 0;\n            pclk_do_valid_sync1 <= 0;\n            pclk_do_valid_sync2 <= 0;\n            pclk_do_sync1 <= 0;\n            pclk_do_sync2 <= 0;\n        end else begin\n            pclk_word_sync1 <= pending_word;\n            pclk_word_sync2 <= pclk_word_sync1;\n            pclk_wren_sync1 <= pending_valid;\n            pclk_wren_sync2 <= pclk_wren_sync1;\n            pclk_wren_sync3 <= pclk_wren_sync2;\n            pclk_wr_ack_sync1 <= wr_ack_reg;\n            pclk_wr_ack_sync2 <= pclk_wr_ack_sync1;\n            pclk_do_valid_sync1 <= do_valid_reg;\n            pclk_do_valid_sync2 <= pclk_do_valid_sync1;\n            pclk_do_sync1 <= do_reg;\n            pclk_do_sync2 <= pclk_do_sync1;\n        end\n    end\n\n    // sclk domain: synchronize pclk signals\n    reg [N-1:0] sclk_di_sync1;\n    reg [N-1:0] sclk_di_sync2;\n    reg sclk_wren_sync1;\n    reg sclk_wren_sync2;\n    reg sclk_wren_sync3;\n    reg sclk_di_req_sync1;\n    reg sclk_di_req_sync2;\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_di_sync1 <= 0;\n            sclk_di_sync2 <= 0;\n            sclk_wren_sync1 <= 0;\n            sclk_wren_sync2 <= 0;\n            sclk_wren_sync3 <= 0;\n            sclk_di_req_sync1 <= 0;\n            sclk_di_req_sync2 <= 0;\n        end else begin\n            sclk_di_sync1 <= di_i;\n            sclk_di_sync2 <= sclk_di_sync1;\n            sclk_wren_sync1 <= wren_i;\n            sclk_wren_sync2 <= sclk_wren_sync1;\n            sclk_wren_sync3 <= sclk_wren_sync2;\n            sclk_di_req_sync1 <= di_req_reg;\n            sclk_di_req_sync2 <= sclk_di_req_sync1;\n        end\n    end\n\n    // pclk domain: generate outputs\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1;\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n            do_o <= 0;\n        end else begin\n            di_req_o <= sclk_di_req_sync2;\n            wr_ack_o <= pclk_wr_ack_sync1 & ~pclk_wr_ack_sync2;\n            do_valid_o <= pclk_do_valid_sync1 & ~pclk_do_valid_sync2;\n            do_o <= pclk_do_sync2;\n        end\n    end\n\n    // sclk domain: SPI state machine\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_state <= S_IDLE;\n            tx_shift <= 0;\n            rx_shift <= 0;\n            bit_cnt <= 0;\n            spi_sck_reg <= 0;\n            spi_ssel_reg <= 1;\n            spi_mosi_reg <= 0;\n            di_req_reg <= 1;\n            wr_ack_reg <= 0;\n            do_valid_reg <= 0;\n            do_reg <= 0;\n            pending_word <= 0;\n            pending_valid <= 0;\n        end else begin\n            // Default: clear single-cycle pulses\n            wr_ack_reg <= 0;\n            do_valid_reg <= 0;\n\n            case (spi_state)\n                S_IDLE: begin\n                    spi_sck_reg <= 0;\n                    spi_ssel_reg <= 1;\n                    spi_mosi_reg <= 0;\n                    bit_cnt <= 0;\n                    if (sclk_wren_sync3 & sclk_di_req_sync2) begin\n                        // Accept new word\n                        pending_word <= sclk_di_sync2;\n                        pending_valid <= 1;\n                        tx_shift <= sclk_di_sync2;\n                        rx_shift <= 0;\n                        bit_cnt <= 0;\n                        spi_ssel_reg <= 0;\n                        spi_state <= S_TX;\n                        di_req_reg <= 0;\n                        wr_ack_reg <= 1;\n                    end else begin\n                        di_req_reg <= 1;\n                    end\n                end\n\n                S_TX: begin\n                    if (spi_clk_edge) begin\n                        if (bit_cnt == N - 1) begin\n                            spi_sck_reg <= 0;\n                            spi_state <= S_RX;\n                            bit_cnt <= 0;\n                        end else begin\n                            spi_sck_reg <= ~spi_sck_reg;\n                            if (spi_sck_reg == 0) begin\n                                // Rising edge: shift out next bit\n                                spi_mosi_reg <= tx_shift[0];\n                                tx_shift <= {1'b0, tx_shift[N-1:1]};\n                                bit_cnt <= bit_cnt + 1;\n                            end\n                        end\n                    end\n                end\n\n                S_RX: begin\n                    if (spi_clk_edge) begin\n                        if (bit_cnt == N - 1) begin\n                            spi_sck_reg <= 0;\n                            spi_ssel_reg <= 1;\n                            spi_state <= S_IDLE;\n                            bit_cnt <= 0;\n                            do_reg <= rx_shift;\n                            do_valid_reg <= 1;\n                            pending_valid <= 0;\n                        end else begin\n                            spi_sck_reg <= ~spi_sck_reg;\n                            if (spi_sck_reg == 1) begin\n                                // Falling edge: sample MISO\n                                rx_shift <= {spi_miso_i, rx_shift[N-1:1]};\n                                bit_cnt <= bit_cnt + 1;\n                            end\n                        end\n                    end\n                end\n\n                default: begin\n                    spi_state <= S_IDLE;\n                    spi_ssel_reg <= 1;\n                    spi_sck_reg <= 0;\n                end\n            endcase\n        end\n    end\n\n    assign spi_ssel_o = spi_ssel_reg;\n    assign spi_sck_o = spi_sck_reg;\n    assign spi_mosi_o = spi_mosi_reg;\n\nendmodule\n```<|im_end|>",
