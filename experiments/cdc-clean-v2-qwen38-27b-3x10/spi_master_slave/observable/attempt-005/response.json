  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // SPI clock domain signals\n    reg [N-1:0] tx_shift_reg;\n    reg [N-1:0] rx_shift_reg;\n    reg [N-1:0] bit_counter;\n    reg spi_active;\n    reg spi_sck_reg;\n    reg [N-1:0] spi_clk_divider;\n    reg spi_clk_edge;\n\n    // Parallel clock domain signals\n    reg [N-1:0] tx_word_reg;\n    reg [N-1:0] rx_word_reg;\n    reg tx_word_valid;\n    reg rx_word_valid;\n    reg di_req_reg;\n    reg wr_ack_reg;\n    reg do_valid_reg;\n    reg [N-1:0] do_reg;\n\n    // Synchronizers for clock domain crossings\n    reg [1:0] tx_word_valid_sync;\n    reg [1:0] rx_word_valid_sync;\n    reg [1:0] di_req_sync;\n    reg [1:0] wr_ack_sync;\n    reg [1:0] do_valid_sync;\n\n    // Synchronizer for tx_word\n    reg [N-1:0] tx_word_sync;\n    reg tx_word_sync_valid;\n    reg [1:0] tx_word_sync_valid_sync;\n\n    // Synchronizer for rx_word\n    reg [N-1:0] rx_word_sync;\n    reg rx_word_sync_valid;\n    reg [1:0] rx_word_sync_valid_sync;\n\n    // Synchronizer for do_valid\n    reg [1:0] do_valid_sync_pclk;\n    reg [N-1:0] do_sync;\n    reg do_sync_valid;\n    reg [1:0] do_sync_valid_sync;\n\n    // Synchronizer for di_req\n    reg [1:0] di_req_sync_sclk;\n\n    // Synchronizer for wr_ack\n    reg [1:0] wr_ack_sync_sclk;\n\n    // SPI clock generation\n    wire spi_clk = spi_sck_reg;\n\n    // SPI state machine\n    localparam SPI_IDLE = 2'd0;\n    localparam SPI_SHIFT = 2'd1;\n    localparam SPI_DONE = 2'd2;\n\n    reg [1:0] spi_state;\n    reg [1:0] spi_state_next;\n\n    // SPI clock divider\n    reg [N-1:0] spi_clk_div;\n\n    // SPI shift logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            tx_shift_reg <= {N{1'b0}};\n            rx_shift_reg <= {N{1'b0}};\n            bit_counter <= {N{1'b0}};\n            spi_active <= 1'b0;\n            spi_sck_reg <= 1'b0;\n            spi_clk_div <= {N{1'b0}};\n            spi_state <= SPI_IDLE;\n        end else begin\n            spi_ssel_o <= (spi_state == SPI_IDLE) ? 1'b1 : 1'b0;\n            spi_sck_o <= spi_sck_reg;\n\n            case (spi_state)\n                SPI_IDLE: begin\n                    spi_sck_reg <= 1'b0;\n                    spi_clk_div <= {N{1'b0}};\n                    if (tx_word_sync_valid_sync[1]) begin\n                        tx_shift_reg <= tx_word_sync;\n                        rx_shift_reg <= {N{1'b0}};\n                        bit_counter <= {N{1'b0}};\n                        spi_state <= SPI_SHIFT;\n                    end\n                end\n                SPI_SHIFT: begin\n                    // Generate SPI clock\n                    spi_clk_div <= spi_clk_div + 1'b1;\n                    if (spi_clk_div == SPI_2X_CLK_DIV - 1) begin\n                        spi_clk_div <= {N{1'b0}};\n                        spi_sck_reg <= ~spi_sck_reg;\n                    end\n\n                    // On rising edge of SPI clock, shift out and shift in\n                    if (spi_sck_reg == 1'b1 && spi_clk_div == SPI_2X_CLK_DIV - 1) begin\n                        // This is the rising edge\n                        tx_shift_reg <= {tx_shift_reg[N-2:0], 1'b0};\n                        rx_shift_reg <= {spi_miso_i, rx_shift_reg[N-1:0]};\n                        bit_counter <= bit_counter + 1'b1;\n                        if (bit_counter == N - 1) begin\n                            spi_state <= SPI_DONE;\n                        end\n                    end\n                end\n                SPI_DONE: begin\n                    spi_sck_reg <= 1'b0;\n                    spi_state <= SPI_IDLE;\n                end\n                default: spi_state <= SPI_IDLE;\n            endcase\n        end\n    end\n\n    // SPI MOSI output\n    assign spi_mosi_o = tx_shift_reg[N-1];\n\n    // Parallel clock domain - handshake logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1'b1;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n            tx_word_reg <= {N{1'b0}};\n            rx_word_reg <= {N{1'b0}};\n            tx_word_valid <= 1'b0;\n            rx_word_valid <= 1'b0;\n            di_req_reg <= 1'b1;\n            wr_ack_reg <= 1'b0;\n            do_valid_reg <= 1'b0;\n            do_reg <= {N{1'b0}};\n        end else begin\n            // Default: no pulses\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            // Accept new word if di_req is high and wren is high\n            if (di_req_o && wren_i) begin\n                tx_word_reg <= di_i;\n                tx_word_valid <= 1'b1;\n                wr_ack_o <= 1'b1;\n                di_req_o <= 1'b0;\n            end\n\n            // When rx_word_valid is set, output the received word\n            if (rx_word_valid) begin\n                do_o <= rx_word_reg;\n                do_valid_o <= 1'b1;\n                rx_word_valid <= 1'b0;\n                di_req_o <= 1'b1;\n            end\n        end\n    end\n\n    // Synchronizers in pclk domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            tx_word_valid_sync <= 2'b00;\n            rx_word_valid_sync <= 2'b00;\n            di_req_sync <= 2'b00;\n            wr_ack_sync <= 2'b00;\n            do_valid_sync <= 2'b00;\n            tx_word_sync <= {N{1'b0}};\n            tx_word_sync_valid <= 1'b0;\n            tx_word_sync_valid_sync <= 2'b00;\n            rx_word_sync <= {N{1'b0}};\n            rx_word_sync_valid <= 1'b0;\n            rx_word_sync_valid_sync <= 2'b00;\n            do_valid_sync_pclk <= 2'b00;\n            do_sync <= {N{1'b0}};\n            do_sync_valid <= 1'b0;\n            do_sync_valid_sync <= 2'b00;\n        end else begin\n            // Synchronize tx_word_valid from sclk domain\n            tx_word_valid_sync <= {tx_word_valid_sync[0], tx_word_valid};\n\n            // Synchronize rx_word_valid from sclk domain\n            rx_word_valid_sync <= {rx_word_valid_sync[0], rx_word_valid};\n\n            // Synchronize di_req from sclk domain\n            di_req_sync <= {di_req_sync[0], di_req_reg};\n\n            // Synchronize wr_ack from sclk domain\n            wr_ack_sync <= {wr_ack_sync[0], wr_ack_reg};\n\n            // Synchronize do_valid from sclk domain\n            do_valid_sync <= {do_valid_sync[0], do_valid_reg};\n\n            // Synchronize tx_word data\n            if (tx_word_valid_sync[1] && !tx_word_valid_sync[0]) begin\n                tx_word_sync <= tx_word_reg;\n                tx_word_sync_valid <= 1'b1;\n            end else if (tx_word_sync_valid_sync[1]) begin\n                tx_word_sync_valid <= 1'b0;\n            end\n            tx_word_sync_valid_sync <= {tx_word_sync_valid_sync[0], tx_word_sync_valid};\n\n            // Synchronize rx_word data\n            if (rx_word_valid_sync[1] && !rx_word_valid_sync[0]) begin\n                rx_word_sync <= rx_word_reg;\n                rx_word_sync_valid <= 1'b1;\n            end else if (rx_word_sync_valid_sync[1]) begin\n                rx_word_sync_valid <= 1'b0;\n            end\n            rx_word_sync_valid_sync <= {rx_word_sync_valid_sync[0], rx_word_sync_valid};\n\n            // Synchronize do_valid and do data\n            if (do_valid_sync[1] && !do_valid_sync[0]) begin\n                do_sync <= do_reg;\n                do_sync_valid <= 1'b1;\n            end else if (do_sync_valid_sync[1]) begin\n                do_sync_valid <= 1'b0;\n            end\n            do_sync_valid_sync <= {do_sync_valid_sync[0], do_sync_valid};\n        end\n    end\n\n    // Synchronizers in sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_sync_sclk <= 2'b00;\n            wr_ack_sync_sclk <= 2'b00;\n            tx_word_valid <= 1'b0;\n            rx_word_valid <= 1'b0;\n            di_req_reg <= 1'b1;\n            wr_ack_reg <= 1'b0;\n            do_valid_reg <= 1'b0;\n            do_reg <= {N{1'b0}};\n            tx_word_reg <= {N{1'b0}};\n            rx_word_reg <= {N{1'b0}};\n        end else begin\n            // Synchronize di_req from pclk domain\n            di_req_sync_sclk <= {di_req_sync_sclk[0], di_req_o};\n\n            // Synchronize wr_ack from pclk domain\n            wr_ack_sync_sclk <= {wr_ack_sync_sclk[0], wr_ack_o};\n\n            // When tx_word_valid_sync indicates a new word is available\n            if (tx_word_sync_valid_sync[1] && !tx_word_sync_valid_sync[0]) begin\n                tx_word_reg <= tx_word_sync;\n                tx_word_valid <= 1'b1;\n            end else begin\n                tx_word_valid <= 1'b0;\n            end\n\n            // When rx_word_valid_sync indicates a received word is available\n            if (rx_word_sync_valid_sync[1] && !rx_word_sync_valid_sync[0]) begin\n                rx_word_reg <= rx_word_sync;\n                rx_word_valid <= 1'b1;\n            end else begin\n                rx_word_valid <= 1'b0;\n            end\n\n            // When do_valid_sync indicates a valid output\n            if (do_valid_sync[1] && !do_valid_sync[0]) begin\n                do_reg <= do_sync;\n                do_valid_reg <= 1'b1;\n            end else begin\n                do_valid_reg <= 1'b0;\n            end\n\n            // Update di_req_reg based on synchronized di_req\n            di_req_reg <= di_req_sync_sclk[1];\n\n            // Update wr_ack_reg based on synchronized wr_ack\n            wr_ack_reg <= wr_ack_sync_sclk[1];\n        end\n    end\n\n    // When SPI completes a transaction, signal rx_word_valid\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rx_word_valid <= 1'b0;\n        end else begin\n            if (spi_state == SPI_DONE) begin\n                rx_word_reg <= rx_shift_reg;\n                rx_word_valid <= 1'b1;\n            end else begin\n                rx_word_valid <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
