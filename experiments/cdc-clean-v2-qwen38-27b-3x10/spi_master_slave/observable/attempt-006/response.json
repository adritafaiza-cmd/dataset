{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0] tx_shift_reg;\n    reg [N-1:0] rx_shift_reg;\n    reg [N-1:0] bit_count;\n    reg         spi_active;\n    reg         spi_done;\n\n    // Clock domain crossing: pclk to sclk\n    reg [1:0] pclk_sync;\n    reg       pclk_sync_next;\n    wire      pclk_rising;\n\n    // Clock domain crossing: sclk to pclk\n    reg [1:0] sclk_sync;\n    reg       sclk_sync_next;\n    wire      sclk_rising;\n\n    // Parallel side state\n    reg       wr_ack_reg;\n    reg       do_valid_reg;\n    reg [N-1:0] do_reg;\n    reg       di_req_reg;\n    reg       word_pending;\n    reg [N-1:0] pending_word;\n\n    // SPI state machine\n    localparam SPI_IDLE = 2'd0;\n    localparam SPI_SHIFT = 2'd1;\n    localparam SPI_DONE = 2'd2;\n\n    reg [1:0] spi_state;\n    reg [N-1:0] spi_bit_count;\n\n    // 2x clock divider for SPI\n    reg [SPI_2X_CLK_DIV-1:0] clk_div;\n    wire clk_div_done;\n\n    assign clk_div_done = (clk_div == SPI_2X_CLK_DIV - 1);\n\n    // Synchronize pclk to sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            pclk_sync <= 2'b00;\n        else\n            pclk_sync <= {pclk_sync[0], pclk_i};\n    end\n\n    assign pclk_rising = (pclk_sync == 2'b10);\n\n    // Synchronize sclk to pclk domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            sclk_sync <= 2'b00;\n        else\n            sclk_sync <= {sclk_sync[0], sclk_i};\n    end\n\n    assign sclk_rising = (sclk_sync == 2'b10);\n\n    // SPI master logic in sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            tx_shift_reg <= {N{1'b0}};\n            rx_shift_reg <= {N{1'b0}};\n            bit_count <= {N{1'b0}};\n            spi_active <= 1'b0;\n            spi_done <= 1'b0;\n            spi_state <= SPI_IDLE;\n            spi_bit_count <= {N{1'b0}};\n            clk_div <= {SPI_2X_CLK_DIV{1'b0}};\n        end else begin\n            // Default: clear one-shot signals\n            spi_done <= 1'b0;\n\n            case (spi_state)\n                SPI_IDLE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o <= 1'b0;\n                    clk_div <= {SPI_2X_CLK_DIV{1'b0}};\n                    if (pclk_rising && word_pending) begin\n                        // Start SPI transaction\n                        tx_shift_reg <= pending_word;\n                        rx_shift_reg <= {N{1'b0}};\n                        spi_bit_count <= {N{1'b0}};\n                        spi_ssel_o <= 1'b0;\n                        spi_state <= SPI_SHIFT;\n                        clk_div <= {SPI_2X_CLK_DIV{1'b0}};\n                    end\n                end\n\n                SPI_SHIFT: begin\n                    if (clk_div_done) begin\n                        clk_div <= {SPI_2X_CLK_DIV{1'b0}};\n                        // Toggle SCK\n                        spi_sck_o <= ~spi_sck_o;\n                        if (spi_sck_o) begin\n                            // Rising edge of SCK: shift in MISO, shift out MOSI\n                            rx_shift_reg <= {rx_shift_reg[N-2:0], spi_miso_i};\n                            tx_shift_reg <= {tx_shift_reg[N-2:0], 1'b0};\n                            spi_bit_count <= spi_bit_count + 1'b1;\n                            if (spi_bit_count == N - 1) begin\n                                spi_state <= SPI_DONE;\n                            end\n                        end\n                    end else begin\n                        clk_div <= clk_div + 1'b1;\n                    end\n                end\n\n                SPI_DONE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o <= 1'b0;\n                    spi_done <= 1'b1;\n                    spi_state <= SPI_IDLE;\n                end\n\n                default: begin\n                    spi_state <= SPI_IDLE;\n                end\n            end\n        end\n    end\n\n    // MOSI output\n    assign spi_mosi_o = tx_shift_reg[N-1];\n\n    // Parallel side logic in pclk domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1'b1;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n            word_pending <= 1'b0;\n            pending_word <= {N{1'b0}};\n        end else begin\n            // Default: clear one-shot signals\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            if (spi_done) begin\n                // SPI transaction completed\n                do_o <= rx_shift_reg;\n                do_valid_o <= 1'b1;\n                di_req_o <= 1'b1;\n            end else if (di_req_o && wren_i) begin\n                // Accept new word\n                pending_word <= di_i;\n                word_pending <= 1'b1;\n                wr_ack_o <= 1'b1;\n                di_req_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
