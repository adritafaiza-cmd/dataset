  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // SPI clock divider counter\n    reg [31:0] clk_div_cnt;\n    wire clk_div_tick = (clk_div_cnt == SPI_2X_CLK_DIV - 1);\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            clk_div_cnt <= 0;\n        else if (clk_div_tick)\n            clk_div_cnt <= 0;\n        else\n            clk_div_cnt <= clk_div_cnt + 1;\n    end\n\n    // SPI state machine\n    localparam S_IDLE = 2'd0;\n    localparam S_TX   = 2'd1;\n    localparam S_RX   = 2'd2;\n\n    reg [1:0] spi_state;\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [3:0] bit_cnt;\n    reg sck_phase; // 0 = low, 1 = high\n\n    // Parallel side registers\n    reg [N-1:0] tx_word;\n    reg [N-1:0] rx_word;\n    reg tx_valid;\n    reg rx_valid;\n\n    // Clock domain crossing: sclk -> pclk\n    reg [1:0] tx_valid_sync;\n    reg [1:0] rx_valid_sync;\n    reg [N-1:0] tx_word_sync;\n    reg [N-1:0] rx_word_sync;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            tx_valid_sync <= 2'b00;\n            rx_valid_sync <= 2'b00;\n            tx_word_sync <= {N{1'b0}};\n            rx_word_sync <= {N{1'b0}};\n        end else begin\n            tx_valid_sync <= {tx_valid_sync[0], tx_valid};\n            rx_valid_sync <= {rx_valid_sync[0], rx_valid};\n            tx_word_sync <= tx_word;\n            rx_word_sync <= rx_word;\n        end\n    end\n\n    // Clock domain crossing: pclk -> sclk\n    reg [1:0] wren_sync;\n    reg [N-1:0] di_sync;\n    reg wren_pulse;\n    reg di_pulse;\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_sync <= 2'b00;\n            di_sync <= {N{1'b0}};\n            wren_pulse <= 1'b0;\n            di_pulse <= 1'b0;\n        end else begin\n            wren_sync <= {wren_sync[0], wren_i};\n            di_sync <= di_i;\n            wren_pulse <= wren_sync[1] & ~wren_sync[0];\n            di_pulse <= wren_sync[1] & ~wren_sync[0];\n        end\n    end\n\n    // SPI outputs\n    assign spi_mosi_o = tx_shift[N-1];\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            spi_state <= S_IDLE;\n            tx_shift <= {N{1'b0}};\n            rx_shift <= {N{1'b0}};\n            bit_cnt <= 4'd0;\n            sck_phase <= 1'b0;\n            tx_word <= {N{1'b0}};\n            rx_word <= {N{1'b0}};\n            tx_valid <= 1'b0;\n            rx_valid <= 1'b0;\n        end else begin\n            case (spi_state)\n                S_IDLE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o <= 1'b0;\n                    sck_phase <= 1'b0;\n                    if (wren_pulse) begin\n                        tx_word <= di_sync;\n                        tx_shift <= di_sync;\n                        bit_cnt <= 4'd0;\n                        spi_ssel_o <= 1'b0;\n                        spi_state <= S_TX;\n                    end\n                end\n                S_TX: begin\n                    if (clk_div_tick) begin\n                        if (sck_phase == 1'b0) begin\n                            // Rising edge: shift out MSB, sample MISO\n                            spi_sck_o <= 1'b1;\n                            sck_phase <= 1'b1;\n                            rx_shift <= {rx_shift[N-2:0], spi_miso_i};\n                            tx_shift <= {tx_shift[N-2:0], 1'b0};\n                            bit_cnt <= bit_cnt + 1;\n                            if (bit_cnt == N - 1) begin\n                                spi_state <= S_RX;\n                            end\n                        end else begin\n                            // Falling edge\n                            spi_sck_o <= 1'b0;\n                            sck_phase <= 1'b0;\n                        end\n                    end\n                end\n                S_RX: begin\n                    if (clk_div_tick) begin\n                        if (sck_phase == 1'b0) begin\n                            spi_sck_o <= 1'b1;\n                            sck_phase <= 1'b1;\n                            rx_shift <= {rx_shift[N-2:0], spi_miso_i};\n                            tx_shift <= {tx_shift[N-2:0], 1'b0};\n                            bit_cnt <= bit_cnt + 1;\n                            if (bit_cnt == N - 1) begin\n                                spi_state <= S_IDLE;\n                                rx_word <= rx_shift;\n                                rx_valid <= 1'b1;\n                            end\n                        end else begin\n                            spi_sck_o <= 1'b0;\n                            sck_phase <= 1'b0;\n                        end\n                    end\n                end\n                default: begin\n                    spi_state <= S_IDLE;\n                end\n            endcase\n\n            // Clear rx_valid after one cycle\n            if (rx_valid && spi_state != S_RX)\n                rx_valid <= 1'b0;\n        end\n    end\n\n    // Parallel side handshake\n    reg di_req_int;\n    reg wr_ack_int;\n    reg do_valid_int;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1'b1;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n            di_req_int <= 1'b1;\n            wr_ack_int <= 1'b0;\n            do_valid_int <= 1'b0;\n        end else begin\n            // di_req_o: high when idle and no pending transaction\n            di_req_o <= di_req_int;\n\n            // wr_ack_o: pulse when accepting a new word\n            wr_ack_o <= wr_ack_int;\n\n            // do_valid_o: pulse when a received word is ready\n            do_valid_o <= do_valid_int;\n\n            // Update internal flags\n            if (rx_valid_sync[1] & ~rx_valid_sync[0]) begin\n                do_valid_int <= 1'b1;\n                do_o <= rx_word_sync;\n            end else begin\n                do_valid_int <= 1'b0;\n            end\n\n            if (wren_i & di_req_int) begin\n                wr_ack_int <= 1'b1;\n                di_req_int <= 1'b0;\n            end else begin\n                wr_ack_int <= 1'b0;\n            end\n\n            // di_req_int goes high when SPI is back to idle\n            if (spi_state == S_IDLE && !wren_i) begin\n                di_req_int <= 1'b1;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
