  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // ========================================================================\n    // Reset Synchronizers\n    // ========================================================================\n    // SCLK domain reset\n    reg [1:0] rst_sclk_sync;\n    wire rst_sclk = rst_sclk_sync[1];\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            rst_sclk_sync <= 2'b00;\n        else\n            rst_sclk_sync <= {rst_sclk_sync[0], 1'b0};\n    end\n\n    // PCLK domain reset\n    reg [1:0] rst_pclk_sync;\n    wire rst_pclk = rst_pclk_sync[1];\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            rst_pclk_sync <= 2'b00;\n        else\n            rst_pclk_sync <= {rst_pclk_sync[0], 1'b0};\n    end\n\n    // ========================================================================\n    // PCLK Domain: Parallel Interface & Handshake\n    // ========================================================================\n    // State machine for parallel side\n    // IDLE: waiting for wren_i\n    // WAIT_ACK: waiting for wren_i to deassert (handshake complete)\n    // WAIT_REQ: waiting for di_req_o to deassert (serial side done)\n\n    localparam [1:0] ST_IDLE     = 2'd0;\n    localparam [1:0] ST_WAIT_ACK = 2'd1;\n    localparam [1:0] ST_WAIT_REQ = 2'd2;\n\n    reg [1:0] p_state;\n    reg [N-1:0] tx_word_reg;\n    reg [N-1:0] rx_word_reg;\n    reg         tx_valid_reg;\n    reg         rx_valid_reg;\n\n    // Synchronizers for control signals crossing to SCLK domain\n    // tx_valid: PCLK -> SCLK (single bit, 2-stage sync)\n    reg [1:0] tx_valid_sync;\n    wire tx_valid_sclk = tx_valid_sync[1];\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            tx_valid_sync <= 2'b00;\n        else\n            tx_valid_sync <= {tx_valid_sync[0], tx_valid_reg};\n    end\n\n    // rx_done: SCLK -> PCLK (single bit, 2-stage sync)\n    reg [1:0] rx_done_sync;\n    wire rx_done_pclk = rx_done_sync[1];\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            rx_done_sync <= 2'b00;\n        else\n            rx_done_sync <= {rx_done_sync[0], rx_done_sclk};\n    end\n\n    // rx_word: SCLK -> PCLK (multi-bit, use handshake or gray code)\n    // Since we need coherent multi-bit transfer, use a simple approach:\n    // The SCLK domain holds rx_word stable until PCLK acknowledges.\n    // We'll use a 2-phase handshake for the data.\n\n    // Actually, let's use a simpler approach: \n    // The SCLK domain will pulse rx_done_pclk when a word is complete.\n    // The PCLK domain will sample rx_word when rx_done_pclk is high.\n    // To ensure coherence, the SCLK domain must hold rx_word stable\n    // until PCLK has sampled it. We'll use a handshake.\n\n    // Let's use a 4-phase handshake for rx_word:\n    // SCLK domain: rx_word_valid (assert when word ready)\n    // PCLK domain: rx_word_ack (assert when sampled)\n    // This ensures multi-bit coherence.\n\n    reg [1:0] rx_word_valid_sync;\n    wire rx_word_valid_pclk = rx_word_valid_sync[1];\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            rx_word_valid_sync <= 2'b00;\n        else\n            rx_word_valid_sync <= {rx_word_valid_sync[0], rx_word_valid_sclk};\n    end\n\n    reg [1:0] rx_word_ack_sync;\n    wire rx_word_ack_sclk = rx_word_ack_sync[1];\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            rx_word_ack_sync <= 2'b00;\n        else\n            rx_word_ack_sync <= {rx_word_ack_sync[0], rx_word_ack_pclk};\n    end\n\n    // PCLK domain state machine\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            p_state     <= ST_IDLE;\n            tx_word_reg <= {N{1'b0}};\n            rx_word_reg <= {N{1'b0}};\n            tx_valid_reg <= 1'b0;\n            rx_valid_reg <= 1'b0;\n            wr_ack_o    <= 1'b0;\n            do_valid_o  <= 1'b0;\n            do_o        <= {N{1'b0}};\n            di_req_o    <= 1'b0;\n            rx_word_ack_pclk <= 1'b0;\n        end else begin\n            // Default: deassert single-cycle outputs\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            case (p_state)\n                ST_IDLE: begin\n                    di_req_o <= 1'b0;\n                    if (wren_i) begin\n                        tx_word_reg  <= di_i;\n                        tx_valid_reg <= 1'b1;\n                        wr_ack_o     <= 1'b1;\n                        p_state      <= ST_WAIT_ACK;\n                    end\n                end\n\n                ST_WAIT_ACK: begin\n                    // Wait for wren_i to deassert\n                    if (!wren_i) begin\n                        p_state <= ST_WAIT_REQ;\n                    end\n                end\n\n                ST_WAIT_REQ: begin\n                    // Wait for rx_word_valid_pclk to indicate serial side has a word\n                    if (rx_word_valid_pclk) begin\n                        // Sample the received word\n                        rx_word_reg <= rx_word_sclk;\n                        do_o        <= rx_word_sclk;\n                        do_valid_o  <= 1'b1;\n                        // Acknowledge the receive\n                        rx_word_ack_pclk <= 1'b1;\n                        // Deassert tx_valid to allow next transfer\n                        tx_valid_reg <= 1'b0;\n                        p_state      <= ST_IDLE;\n                    end\n                end\n\n                default: begin\n                    p_state <= ST_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // ========================================================================\n    // SCLK Domain: SPI Serial Interface\n    // ========================================================================\n    // SPI state machine\n    // IDLE: ssel high (inactive), sck low\n    // ACTIVE: ssel low (active), shifting data\n\n    localparam [1:0] SPI_IDLE   = 2'd0;\n    localparam [1:0] SPI_ACTIVE = 2'd1;\n\n    reg [1:0] spi_state;\n    reg [N-1:0] tx_shift_reg;\n    reg [N-1:0] rx_shift_reg;\n    reg [$clog2(N)-1:0] bit_count;\n    reg [N-1:0] rx_word_sclk;\n    reg         rx_word_valid_sclk;\n    reg         rx_word_ack_pclk;\n\n    // Synchronizers for control signals crossing from PCLK domain\n    // tx_valid: PCLK -> SCLK\n    reg [1:0] tx_valid_sclk_sync;\n    wire tx_valid_sclk = tx_valid_sclk_sync[1];\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            tx_valid_sclk_sync <= 2'b00;\n        else\n            tx_valid_sclk_sync <= {tx_valid_sclk_sync[0], tx_valid_pclk};\n    end\n\n    // tx_word: PCLK -> SCLK (multi-bit, use handshake)\n    // We'll use a similar 4-phase handshake for tx_word.\n    // PCLK domain: tx_word_valid (assert when word ready)\n    // SCLK domain: tx_word_ack (assert when sampled)\n\n    reg [1:0] tx_word_valid_sync;\n    wire tx_word_valid_sclk = tx_word_valid_sync[1];\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            tx_word_valid_sync <= 2'b00;\n        else\n            tx_word_valid_sync <= {tx_word_valid_sync[0], tx_word_valid_pclk};\n    end\n\n    reg [1:0] tx_word_ack_sync;\n    wire tx_word_ack_pclk = tx_word_ack_sync[1];\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            tx_word_ack_sync <= 2'b00;\n        else\n            tx_word_ack_sync <= {tx_word_ack_sync[0], tx_word_ack_sclk};\n    end\n\n    // SCLK domain state machine\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_state          <= SPI_IDLE;\n            tx_shift_reg       <= {N{1'b0}};\n            rx_shift_reg       <= {N{1'b0}};\n            bit_count          <= {$clog2(N){1'b0}};\n            rx_word_sclk       <= {N{1'b0}};\n            rx_word_valid_sclk <= 1'b0;\n            tx_word_ack_sclk   <= 1'b0;\n            spi_ssel_o         <= 1'b1;\n            spi_sck_o          <= 1'b0;\n        end else begin\n            // Default: deassert single-cycle signals\n            rx_word_valid_sclk <= 1'b0;\n\n            case (spi_state)\n                SPI_IDLE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o  <= 1'b0;\n                    // Wait for tx_word_valid_sclk\n                    if (tx_word_valid_sclk) begin\n                        // Sample the transmit word\n                        tx_shift_reg <= tx_word_pclk;\n                        // Acknowledge the transmit word\n                        tx_word_ack_sclk <= 1'b1;\n                        // Start SPI transfer\n                        spi_ssel_o <= 1'b0;\n                        bit_count  <= {$clog2(N){1'b0}};\n                        spi_state  <= SPI_ACTIVE;\n                    end\n                end\n\n                SPI_ACTIVE: begin\n                    spi_ssel_o <= 1'b0;\n                    // Toggle SCK\n                    if (spi_sck_o == 1'b0) begin\n                        spi_sck_o <= 1'b1;\n                        // On rising edge of SCK, shift out MSB and capture MISO\n                        // Actually, let's use a simpler approach:\n                        // On each SCLK cycle, shift and toggle SCK\n                    end else begin\n                        spi_sck_o <= 1'b0;\n                        // On falling edge of SCK, shift data\n                        // Shift out MSB of tx_shift_reg\n                        tx_shift_reg <= {tx_shift_reg[N-2:0], 1'b0};\n                        // Capture MISO into LSB of rx_shift_reg\n                        rx_shift_reg <= {spi_miso_i, rx_shift_reg[N-1:1]};\n                        \n                        // Increment bit count\n                        if (bit_count == N-1) begin\n                            // Transfer complete\n                            rx_word_sclk       <= rx_shift_reg;\n                            rx_word_valid_sclk <= 1'b1;\n                            // Wait for rx_word_ack_pclk before re-arming\n                            spi_state <= SPI_IDLE;\n                        end else begin\n                            bit_count <= bit_count + 1'b1;\n                        end\n                    end\n                end\n\n                default: begin\n                    spi_state <= SPI_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // ========================================================================\n    // Output Assignments\n    // ========================================================================\n    assign spi_mosi_o = tx_shift_reg[N-1];\n\n    // ========================================================================\n    // PCLK Domain: Handshake Signals for Data Transfer\n    // ========================================================================\n    // tx_word_valid_pclk: asserted when tx_word_reg is valid\n    reg tx_word_valid_pclk;\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            tx_word_valid_pclk <= 1'b0;\n        else\n            tx_word_valid_pclk <= tx_valid_reg;\n    end\n\n    // rx_word_ack_pclk: asserted when PCLK has sampled rx_word\n    // Already defined in the PCLK state machine above\n\n    // ========================================================================\n    // SCLK Domain: Handshake Signals for Data Transfer\n    // ========================================================================\n    // tx_word_ack_sclk: asserted when SCLK has sampled tx_word\n    // Already defined in the SCLK state machine above\n\n    // rx_word_valid_sclk: asserted when SCLK has a completed word\n    // Already defined in the SCLK state machine above\n\nendmodule\n```<|im_end|>",
