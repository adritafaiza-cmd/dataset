  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 3'd0;\n    localparam S_WAIT_WR = 3'd1;\n    localparam S_SHIFT   = 3'd2;\n    localparam S_DONE    = 3'd3;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    // SPI shift registers\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [N-1:0] tx_data;\n    reg [N-1:0] rx_data;\n\n    // Bit counter\n    reg [N-1:0] bit_cnt;\n\n    // SPI clock divider counter\n    reg [N-1:0] clk_div_cnt;\n    reg         clk_phase;\n\n    // Handshake signals\n    reg         wr_ack_int;\n    reg         do_valid_int;\n\n    // SPI_2X_CLK_DIV is used to determine the number of sclk cycles per bit\n    // For standard SPI, we need 2 sclk cycles per bit (one for setup, one for capture)\n    // SPI_2X_CLK_DIV indicates the divider factor\n    // We'll use a simple approach: generate spi_sck_o with a period of 2*SPI_2X_CLK_DIV sclk cycles\n\n    // SPI clock generation\n    // We need to generate a clock with 50% duty cycle\n    // Each bit takes 2 * SPI_2X_CLK_DIV sclk cycles\n    // Half period = SPI_2X_CLK_DIV sclk cycles\n\n    wire [N-1:0] half_period = SPI_2X_CLK_DIV[N-1:0];\n\n    // SPI clock generator\n    reg [N-1:0] clk_gen_cnt;\n    reg         clk_gen_phase;\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            clk_gen_cnt   <= {N{1'b0}};\n            clk_gen_phase <= 1'b0;\n        end else if (state == S_SHIFT) begin\n            if (clk_gen_cnt == half_period - 1) begin\n                clk_gen_cnt   <= {N{1'b0}};\n                clk_gen_phase <= ~clk_gen_phase;\n            end else begin\n                clk_gen_cnt <= clk_gen_cnt + 1'b1;\n            end\n        end else begin\n            clk_gen_cnt   <= {N{1'b0}};\n            clk_gen_phase <= 1'b0;\n        end\n    end\n\n    // SPI SCK output\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck_o <= 1'b0;\n        end else if (state == S_SHIFT) begin\n            spi_sck_o <= clk_gen_phase;\n        end else begin\n            spi_sck_o <= 1'b0;\n        end\n    end\n\n    // SPI SS output\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1; // Inactive high\n        end else begin\n            case (state)\n                S_IDLE:    spi_ssel_o <= 1'b1;\n                S_WAIT_WR: spi_ssel_o <= 1'b1;\n                S_SHIFT:   spi_ssel_o <= 1'b0; // Active low\n                S_DONE:    spi_ssel_o <= 1'b1;\n                default:   spi_ssel_o <= 1'b1;\n            endcase\n        end\n    end\n\n    // SPI MOSI output\n    assign spi_mosi_o = tx_shift[N-1];\n\n    // State machine\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= S_IDLE;\n        end else begin\n            state <= next_state;\n        end\n    end\n\n    always @(*) begin\n        next_state = state;\n        case (state)\n            S_IDLE: begin\n                if (wren_i) begin\n                    next_state = S_WAIT_WR;\n                end\n            end\n            S_WAIT_WR: begin\n                // Wait for wren_i to be deasserted or just proceed\n                // Actually, we should accept the word when wren_i is high\n                // Let's restructure: accept word in S_IDLE when wren_i is high\n                next_state = S_SHIFT;\n            end\n            S_SHIFT: begin\n                if (bit_cnt == N-1) begin\n                    next_state = S_DONE;\n                end\n            end\n            S_DONE: begin\n                next_state = S_IDLE;\n            end\n            default: next_state = S_IDLE;\n        endcase\n    end\n\n    // Control logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            tx_shift    <= {N{1'b0}};\n            rx_shift    <= {N{1'b0}};\n            tx_data     <= {N{1'b0}};\n            rx_data     <= {N{1'b0}};\n            bit_cnt     <= {N{1'b0}};\n            di_req_o    <= 1'b0;\n            wr_ack_o    <= 1'b0;\n            do_valid_o  <= 1'b0;\n            do_o        <= {N{1'b0}};\n        end else begin\n            // Default: clear single-cycle pulses\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    di_req_o <= 1'b1;\n                    if (wren_i) begin\n                        // Accept the word\n                        tx_data  <= di_i;\n                        tx_shift <= di_i;\n                        bit_cnt  <= {N{1'b0}};\n                        wr_ack_o <= 1'b1;\n                        di_req_o <= 1'b0;\n                    end\n                end\n                S_WAIT_WR: begin\n                    // This state is transitional\n                    di_req_o <= 1'b0;\n                end\n                S_SHIFT: begin\n                    di_req_o <= 1'b0;\n                    // On rising edge of spi_sck_o, capture MISO and shift\n                    // We detect the rising edge of clk_gen_phase\n                    if (clk_gen_phase == 1'b1 && clk_gen_cnt == 0) begin\n                        // Rising edge of SCK\n                        rx_shift <= {spi_miso_i, rx_shift[N-1:1]};\n                        tx_shift <= {tx_shift[N-2:0], 1'b0};\n                        if (bit_cnt == N-1) begin\n                            rx_data <= {spi_miso_i, rx_shift[N-1:1]};\n                        end else begin\n                            bit_cnt <= bit_cnt + 1'b1;\n                        end\n                    end\n                end\n                S_DONE: begin\n                    di_req_o <= 1'b1;\n                    do_o     <= rx_data;\n                    do_valid_o <= 1'b1;\n                end\n                default: begin\n                    di_req_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
