{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 2'd0;\n    localparam S_SHIFT   = 2'd1;\n    localparam S_DONE    = 2'd2;\n\n    reg [1:0] state;\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [N-1:0] bit_count;\n    reg [N-1:0] tx_data;\n    reg [N-1:0] rx_data;\n\n    // Clock divider for SPI clock generation\n    reg [31:0] clk_div_cnt;\n    reg clk_phase;\n\n    // Asynchronous reset synchronization for pclk domain\n    reg rst_sync1, rst_sync2;\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rst_sync1 <= 1'b1;\n            rst_sync2 <= 1'b1;\n        end else begin\n            rst_sync1 <= rst_i;\n            rst_sync2 <= rst_sync1;\n        end\n    end\n\n    wire pclk_rst = rst_sync2;\n\n    // SPI clock generation in sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            clk_div_cnt <= 0;\n            clk_phase   <= 0;\n        end else begin\n            if (state == S_SHIFT) begin\n                if (clk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                    clk_div_cnt <= 0;\n                    clk_phase   <= ~clk_phase;\n                end else begin\n                    clk_div_cnt <= clk_div_cnt + 1;\n                end\n            end else begin\n                clk_div_cnt <= 0;\n                clk_phase   <= 0;\n            end\n        end\n    end\n\n    // SPI outputs\n    assign spi_mosi_o = tx_shift[N-1];\n\n    // SPI state machine in sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state       <= S_IDLE;\n            spi_ssel_o  <= 1'b0;\n            spi_sck_o   <= 1'b0;\n            tx_shift    <= {N{1'b0}};\n            rx_shift    <= {N{1'b0}};\n            bit_count   <= {N{1'b0}};\n            tx_data     <= {N{1'b0}};\n            rx_data     <= {N{1'b0}};\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o  <= 1'b0;\n                    if (di_req_o) begin\n                        // Wait for wren to be asserted\n                        if (wren_i) begin\n                            state      <= S_SHIFT;\n                            spi_ssel_o <= 1'b1;\n                            tx_shift   <= di_i;\n                            rx_shift   <= {N{1'b0}};\n                            bit_count  <= {N{1'b0}};\n                            clk_div_cnt <= 0;\n                            clk_phase   <= 0;\n                        end\n                    end\n                end\n\n                S_SHIFT: begin\n                    spi_ssel_o <= 1'b1;\n                    // Toggle SCK on each phase change\n                    if (clk_phase == 1'b1) begin\n                        // On rising edge of SCK, shift in MISO\n                        rx_shift <= {spi_miso_i, rx_shift[N-1:1]};\n                        tx_shift <= {tx_shift[N-2:0], 1'b0};\n                        if (bit_count == N - 1) begin\n                            state     <= S_DONE;\n                            rx_data   <= {spi_miso_i, rx_shift[N-1:1]};\n                        end else begin\n                            bit_count <= bit_count + 1;\n                        end\n                    end\n                    spi_sck_o <= clk_phase;\n                end\n\n                S_DONE: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o  <= 1'b0;\n                    state      <= S_IDLE;\n                end\n\n                default: state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // Parallel interface in pclk domain\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst) begin\n            di_req_o   <= 1'b0;\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o       <= {N{1'b0}};\n        end else begin\n            // Default: deassert one-cycle pulses\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    if (wren_i) begin\n                        di_req_o <= 1'b1;\n                        wr_ack_o <= 1'b1;\n                    end else begin\n                        di_req_o <= 1'b0;\n                    end\n                end\n\n                S_SHIFT: begin\n                    di_req_o <= 1'b0;\n                end\n\n                S_DONE: begin\n                    di_req_o   <= 1'b1;\n                    do_valid_o <= 1'b1;\n                    do_o       <= rx_data;\n                end\n\n                default: begin\n                    di_req_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
