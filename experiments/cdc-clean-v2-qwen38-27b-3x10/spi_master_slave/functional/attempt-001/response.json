{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 3'd0;\n    localparam S_WAIT_WR = 3'd1;\n    localparam S_SHIFT   = 3'd2;\n    localparam S_DONE    = 3'd3;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    // Shift register and counter\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [N-1:0] bit_count;\n\n    // SCLK divider counter\n    reg [N-1:0] sclk_div_cnt;\n    reg         sclk_phase;\n\n    // MOSI output\n    assign spi_mosi_o = tx_shift[N-1];\n\n    // State machine - next state logic\n    always @(*) begin\n        next_state = state;\n        case (state)\n            S_IDLE: begin\n                if (wren_i)\n                    next_state = S_WAIT_WR;\n            end\n            S_WAIT_WR: begin\n                // Wait for wren to deassert, then start shift\n                if (!wren_i)\n                    next_state = S_SHIFT;\n            end\n            S_SHIFT: begin\n                if (bit_count == N-1 && sclk_phase == 1'b1)\n                    next_state = S_DONE;\n            end\n            S_DONE: begin\n                next_state = S_IDLE;\n            end\n            default: next_state = S_IDLE;\n        endcase\n    end\n\n    // State machine - state register\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            state <= S_IDLE;\n        else\n            state <= next_state;\n    end\n\n    // SCLK generation and shift logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o    <= 1'b0;\n            spi_sck_o     <= 1'b0;\n            sclk_div_cnt  <= {N{1'b0}};\n            sclk_phase    <= 1'b0;\n            tx_shift      <= {N{1'b0}};\n            rx_shift      <= {N{1'b0}};\n            bit_count     <= {N{1'b0}};\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    spi_ssel_o   <= 1'b0;\n                    spi_sck_o    <= 1'b0;\n                    sclk_div_cnt <= {N{1'b0}};\n                    sclk_phase   <= 1'b0;\n                    bit_count    <= {N{1'b0}};\n                end\n\n                S_WAIT_WR: begin\n                    spi_ssel_o   <= 1'b1;\n                    spi_sck_o    <= 1'b0;\n                    sclk_div_cnt <= {N{1'b0}};\n                    sclk_phase   <= 1'b0;\n                    bit_count    <= {N{1'b0}};\n                    // Load TX data when entering shift\n                    if (!wren_i)\n                        tx_shift <= di_i;\n                end\n\n                S_SHIFT: begin\n                    spi_ssel_o <= 1'b1;\n                    \n                    // SCLK divider\n                    if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                        sclk_div_cnt <= {N{1'b0}};\n                        sclk_phase   <= ~sclk_phase;\n                        \n                        if (sclk_phase == 1'b0) begin\n                            // Rising edge of SCLK: shift out MSB, capture MISO\n                            spi_sck_o  <= 1'b1;\n                            tx_shift   <= {tx_shift[N-2:0], 1'b0};\n                            rx_shift   <= {spi_miso_i, rx_shift[N-1:0]};\n                            bit_count  <= bit_count + 1'b1;\n                        end else begin\n                            // Falling edge of SCLK\n                            spi_sck_o <= 1'b0;\n                        end\n                    end else begin\n                        sclk_div_cnt <= sclk_div_cnt + 1'b1;\n                    end\n                end\n\n                S_DONE: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o  <= 1'b0;\n                end\n\n                default: begin\n                    spi_ssel_o   <= 1'b0;\n                    spi_sck_o    <= 1'b0;\n                    sclk_div_cnt <= {N{1'b0}};\n                    sclk_phase   <= 1'b0;\n                    bit_count    <= {N{1'b0}};\n                end\n            endcase\n        end\n    end\n\n    // Handshake signals\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o   <= 1'b0;\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o       <= {N{1'b0}};\n        end else begin\n            // Default: deassert one-shot signals\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    di_req_o <= 1'b1;\n                    if (wren_i) begin\n                        di_req_o <= 1'b0;\n                        wr_ack_o <= 1'b1;\n                    end\n                end\n\n                S_WAIT_WR: begin\n                    di_req_o <= 1'b0;\n                end\n\n                S_SHIFT: begin\n                    di_req_o <= 1'b0;\n                end\n\n                S_DONE: begin\n                    di_req_o   <= 1'b1;\n                    do_valid_o <= 1'b1;\n                    do_o       <= rx_shift;\n                end\n\n                default: begin\n                    di_req_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
