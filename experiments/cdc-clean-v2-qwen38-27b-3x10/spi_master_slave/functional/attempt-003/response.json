{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE      = 3'd0;\n    localparam S_WAIT_REQ  = 3'd1;\n    localparam S_ACCEPT    = 3'd2;\n    localparam S_SHIFT     = 3'd3;\n    localparam S_DONE      = 3'd4;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    // Shift register for MOSI\n    reg [N-1:0] mosi_shift;\n    // Shift register for MISO\n    reg [N-1:0] miso_shift;\n    // Bit counter\n    reg [3:0] bit_count;\n    // Clock divider counter\n    reg [3:0] clk_div_cnt;\n    // SCK phase\n    reg sck_phase;\n\n    // Asynchronous reset for sclk domain\n    reg sclk_rst;\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            sclk_rst <= 1'b1;\n        else\n            sclk_rst <= 1'b0;\n    end\n\n    // Asynchronous reset for pclk domain\n    reg pclk_rst;\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            pclk_rst <= 1'b1;\n        else\n            pclk_rst <= 1'b0;\n    end\n\n    // SCLK domain: SPI shift logic\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            spi_ssel_o   <= 1'b0;\n            spi_sck_o    <= 1'b0;\n            mosi_shift   <= {N{1'b0}};\n            miso_shift   <= {N{1'b0}};\n            bit_count    <= 4'd0;\n            clk_div_cnt  <= 4'd0;\n            sck_phase    <= 1'b0;\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    spi_ssel_o  <= 1'b0;\n                    spi_sck_o   <= 1'b0;\n                    clk_div_cnt <= 4'd0;\n                    sck_phase   <= 1'b0;\n                end\n\n                S_WAIT_REQ: begin\n                    spi_ssel_o  <= 1'b0;\n                    spi_sck_o   <= 1'b0;\n                    clk_div_cnt <= 4'd0;\n                    sck_phase   <= 1'b0;\n                end\n\n                S_ACCEPT: begin\n                    // Load data and start transfer\n                    spi_ssel_o  <= 1'b1;\n                    spi_sck_o   <= 1'b0;\n                    mosi_shift  <= di_i;\n                    miso_shift  <= {N{1'b0}};\n                    bit_count   <= 4'd0;\n                    clk_div_cnt <= 4'd0;\n                    sck_phase   <= 1'b0;\n                end\n\n                S_SHIFT: begin\n                    // Clock divider\n                    if (clk_div_cnt < SPI_2X_CLK_DIV - 1) begin\n                        clk_div_cnt <= clk_div_cnt + 4'd1;\n                    end else begin\n                        clk_div_cnt <= 4'd0;\n                        if (!sck_phase) begin\n                            // Rising edge of SCK\n                            spi_sck_o <= 1'b1;\n                            sck_phase <= 1'b1;\n                            // Sample MISO on rising edge (SPI mode 0)\n                            miso_shift <= {miso_shift[N-2:0], spi_miso_i};\n                        end else begin\n                            // Falling edge of SCK\n                            spi_sck_o <= 1'b0;\n                            sck_phase <= 1'b0;\n                            // Shift out MOSI on falling edge\n                            mosi_shift <= {mosi_shift[N-2:0], 1'b0};\n                            if (bit_count == N - 1) begin\n                                // Last bit done\n                                spi_ssel_o <= 1'b0;\n                                spi_sck_o  <= 1'b0;\n                            end else begin\n                                bit_count <= bit_count + 4'd1;\n                            end\n                        end\n                    end\n                end\n\n                S_DONE: begin\n                    spi_ssel_o  <= 1'b0;\n                    spi_sck_o   <= 1'b0;\n                    clk_div_cnt <= 4'd0;\n                    sck_phase   <= 1'b0;\n                end\n\n                default: begin\n                    spi_ssel_o  <= 1'b0;\n                    spi_sck_o   <= 1'b0;\n                    clk_div_cnt <= 4'd0;\n                    sck_phase   <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // PCLK domain: Handshake logic\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst) begin\n            di_req_o   <= 1'b0;\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o       <= {N{1'b0}};\n        end else begin\n            // Default: deassert one-cycle pulses\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    di_req_o <= 1'b1;\n                end\n\n                S_WAIT_REQ: begin\n                    di_req_o <= 1'b1;\n                    if (wren_i) begin\n                        wr_ack_o <= 1'b1;\n                    end\n                end\n\n                S_ACCEPT: begin\n                    di_req_o <= 1'b0;\n                end\n\n                S_SHIFT: begin\n                    di_req_o <= 1'b0;\n                end\n\n                S_DONE: begin\n                    di_req_o <= 1'b0;\n                    do_valid_o <= 1'b1;\n                    do_o <= miso_shift;\n                end\n\n                default: begin\n                    di_req_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // State machine (synchronous to pclk_i for handshake, but state transitions\n    // need to coordinate with sclk domain. We'll use pclk for state machine\n    // since handshake is pclk-based, and the sclk domain logic responds to state)\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst) begin\n            state <= S_IDLE;\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    state <= S_WAIT_REQ;\n                end\n\n                S_WAIT_REQ: begin\n                    if (wren_i) begin\n                        state <= S_ACCEPT;\n                    end\n                end\n\n                S_ACCEPT: begin\n                    state <= S_SHIFT;\n                end\n\n                S_SHIFT: begin\n                    // Wait until sclk domain signals completion\n                    // We need a signal from sclk domain indicating shift is done\n                    // For simplicity, we'll count or use a flag\n                    // Let's use a done flag from sclk domain\n                    if (shift_done) begin\n                        state <= S_DONE;\n                    end\n                end\n\n                S_DONE: begin\n                    state <= S_WAIT_REQ;\n                end\n\n                default: begin\n                    state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Shift done flag - generated in sclk domain, synchronized to pclk\n    reg shift_done_sclk;\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            shift_done_sclk <= 1'b0;\n        end else begin\n            if (state == S_SHIFT && bit_count == N - 1 && sck_phase == 1'b1) begin\n                shift_done_sclk <= 1'b1;\n            end else if (state != S_SHIFT) begin\n                shift_done_sclk <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronize shift_done_sclk to pclk domain\n    reg [1:0] shift_done_sync;\n    wire shift_done;\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst) begin\n            shift_done_sync <= 2'b00;\n        end else begin\n            shift_done_sync <= {shift_done_sync[0], shift_done_sclk};\n        end\n    end\n    assign shift_done = shift_done_sync[1];\n\n    // MOSI output\n    assign spi_mosi_o = mosi_shift[N-1];\n\nendmodule\n```<|im_end|>",
