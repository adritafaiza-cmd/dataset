{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 3'd0;\n    localparam S_WAIT_WR = 3'd1;\n    localparam S_SHIFT   = 3'd2;\n    localparam S_DONE    = 3'd3;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    // Synchronous reset for pclk domain\n    reg [1:0] rst_sync;\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            rst_sync <= 2'b11;\n        else\n            rst_sync <= {rst_sync[0], 1'b0};\n    end\n    wire rst_p = rst_sync[1];\n\n    // Synchronous reset for sclk domain\n    reg [1:0] rst_sync_s;\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            rst_sync_s <= 2'b11;\n        else\n            rst_sync_s <= {rst_sync_s[0], 1'b0};\n    end\n    wire rst_s = rst_sync_s[1];\n\n    // Cross-domain signals\n    // pclk -> sclk: word to shift out, start signal\n    reg [N-1:0] tx_word_p;\n    reg         tx_start_p;\n    reg [N-1:0] tx_word_s;\n    reg         tx_start_s;\n    reg [1:0]   tx_start_sync;\n\n    // sclk -> pclk: done signal, received word\n    reg         done_s;\n    reg [N-1:0] rx_word_s;\n    reg         done_p;\n    reg [N-1:0] rx_word_p;\n    reg [1:0]   done_sync;\n\n    // pclk domain state machine\n    always @(posedge pclk_i or posedge rst_p) begin\n        if (rst_p) begin\n            state      <= S_IDLE;\n            di_req_o   <= 1'b0;\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o       <= {N{1'b0}};\n            tx_start_p <= 1'b0;\n            tx_word_p  <= {N{1'b0}};\n        end else begin\n            // Default: clear one-cycle pulses\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            tx_start_p <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    di_req_o <= 1'b1;\n                    if (wren_i) begin\n                        tx_word_p  <= di_i;\n                        tx_start_p <= 1'b1;\n                        wr_ack_o   <= 1'b1;\n                        di_req_o   <= 1'b0;\n                        state      <= S_WAIT_WR;\n                    end\n                end\n\n                S_WAIT_WR: begin\n                    di_req_o <= 1'b0;\n                    if (done_p) begin\n                        do_o       <= rx_word_p;\n                        do_valid_o <= 1'b1;\n                        state      <= S_IDLE;\n                    end\n                end\n\n                default: begin\n                    state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Synchronize tx_start from pclk to sclk\n    always @(posedge sclk_i or posedge rst_s) begin\n        if (rst_s) begin\n            tx_start_sync <= 2'b00;\n            tx_start_s    <= 1'b0;\n            tx_word_s     <= {N{1'b0}};\n        end else begin\n            tx_start_sync <= {tx_start_sync[0], tx_start_p};\n            tx_start_s    <= tx_start_sync[1];\n            if (tx_start_sync[1] && !tx_start_sync[0]) begin\n                tx_word_s <= tx_word_p;\n            end\n        end\n    end\n\n    // Synchronize done from sclk to pclk\n    always @(posedge pclk_i or posedge rst_p) begin\n        if (rst_p) begin\n            done_sync <= 2'b00;\n            done_p    <= 1'b0;\n            rx_word_p <= {N{1'b0}};\n        end else begin\n            done_sync <= {done_sync[0], done_s};\n            done_p    <= done_sync[1];\n            if (done_sync[1] && !done_sync[0]) begin\n                rx_word_p <= rx_word_s;\n            end\n        end\n    end\n\n    // sclk domain: SPI shift logic\n    reg [N-1:0] shift_reg;\n    reg [N-1:0] rx_shift;\n    reg [3:0]   bit_cnt;\n    reg         sclk_phase;\n    reg         shift_active;\n\n    // SPI_2X_CLK_DIV: number of sclk cycles per SPI bit\n    // We generate SPI SCK at half the rate of sclk_i by toggling every SPI_2X_CLK_DIV/2 cycles\n    // Actually, let's use a simpler approach: divide sclk_i by SPI_2X_CLK_DIV to get SPI bit rate\n    reg [3:0] div_cnt;\n    reg       div_done;\n\n    always @(posedge sclk_i or posedge rst_s) begin\n        if (rst_s) begin\n            spi_ssel_o  <= 1'b0;\n            spi_sck_o   <= 1'b0;\n            shift_reg   <= {N{1'b0}};\n            rx_shift    <= {N{1'b0}};\n            bit_cnt     <= 4'd0;\n            sclk_phase  <= 1'b0;\n            shift_active <= 1'b0;\n            div_cnt     <= 4'd0;\n            div_done    <= 1'b0;\n            done_s      <= 1'b0;\n            rx_word_s   <= {N{1'b0}};\n        end else begin\n            div_done <= 1'b0;\n            done_s   <= 1'b0;\n\n            if (shift_active) begin\n                // Count sclk cycles for SPI bit timing\n                if (div_cnt == SPI_2X_CLK_DIV - 1) begin\n                    div_cnt  <= 4'd0;\n                    div_done <= 1'b1;\n                end else begin\n                    div_cnt <= div_cnt + 4'd1;\n                end\n\n                if (div_done) begin\n                    // Toggle SCK and advance bit\n                    if (!sclk_phase) begin\n                        // Rising edge of SPI SCK: sample MISO, change MOSI\n                        spi_sck_o <= 1'b1;\n                        sclk_phase <= 1'b1;\n                        // Sample MISO on rising edge (SPI mode 0)\n                        rx_shift <= {rx_shift[N-2:0], spi_miso_i};\n                        // Shift out next bit\n                        shift_reg <= {shift_reg[N-2:0], 1'b0};\n                    end else begin\n                        // Falling edge of SPI SCK\n                        spi_sck_o <= 1'b0;\n                        sclk_phase <= 1'b0;\n                        // Update MOSI for next bit\n                        if (bit_cnt == N - 1) begin\n                            // Last bit done\n                            spi_ssel_o <= 1'b0;\n                            shift_active <= 1'b0;\n                            done_s     <= 1'b1;\n                            rx_word_s  <= rx_shift;\n                        end else begin\n                            bit_cnt <= bit_cnt + 4'd1;\n                        end\n                    end\n                end\n            end else begin\n                // Idle: SCK low, SS high\n                spi_sck_o  <= 1'b0;\n                spi_ssel_o <= 1'b1;\n                sclk_phase <= 1'b0;\n                div_cnt    <= 4'd0;\n            end\n\n            // Start new transfer\n            if (tx_start_s && !shift_active) begin\n                shift_reg    <= tx_word_s;\n                rx_shift     <= {N{1'b0}};\n                bit_cnt      <= 4'd0;\n                sclk_phase   <= 1'b0;\n                shift_active <= 1'b1;\n                spi_ssel_o   <= 1'b0;\n                spi_sck_o    <= 1'b0;\n                div_cnt      <= 4'd0;\n            end\n        end\n    end\n\n    // MOSI output: MSB of shift register\n    assign spi_mosi_o = shift_reg[N-1];\n\nendmodule\n```<|im_end|>",
