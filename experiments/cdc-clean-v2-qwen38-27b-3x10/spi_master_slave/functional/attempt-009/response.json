{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE      = 3'd0;\n    localparam S_WAIT_REQ  = 3'd1;\n    localparam S_ACCEPT    = 3'd2;\n    localparam S_SHIFT     = 3'd3;\n    localparam S_DONE      = 3'd4;\n\n    reg [2:0] state;\n    reg [2:0] next_state;\n\n    // SPI shift register and counter\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [N-1:0] bit_count;\n\n    // SCLK divider counter\n    reg [3:0] sclk_div_cnt;\n    reg sclk_phase;\n\n    // SCLK edge detection\n    reg sclk_prev;\n    wire sclk_rising = sclk_i & ~sclk_prev;\n    wire sclk_falling = ~sclk_i & sclk_prev;\n\n    // MOSI output from shift register\n    assign spi_mosi_o = tx_shift[N-1];\n\n    // State machine - next state logic\n    always @(*) begin\n        next_state = state;\n        case (state)\n            S_IDLE: begin\n                if (di_req_o)\n                    next_state = S_WAIT_REQ;\n            end\n            S_WAIT_REQ: begin\n                if (wren_i)\n                    next_state = S_ACCEPT;\n            end\n            S_ACCEPT: begin\n                next_state = S_SHIFT;\n            end\n            S_SHIFT: begin\n                if (bit_count == N-1 && sclk_falling)\n                    next_state = S_DONE;\n            end\n            S_DONE: begin\n                next_state = S_IDLE;\n            end\n            default: next_state = S_IDLE;\n        endcase\n    end\n\n    // State machine - state register\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            state <= S_IDLE;\n        else\n            state <= next_state;\n    end\n\n    // SCLK previous value tracking\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            sclk_prev <= 1'b0;\n        else\n            sclk_prev <= sclk_i;\n    end\n\n    // SCLK divider and phase generation\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_div_cnt <= 4'd0;\n            sclk_phase   <= 1'b0;\n        end else begin\n            if (state == S_SHIFT) begin\n                if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                    sclk_div_cnt <= 4'd0;\n                    sclk_phase   <= ~sclk_phase;\n                end else begin\n                    sclk_div_cnt <= sclk_div_cnt + 4'd1;\n                end\n            end else begin\n                sclk_div_cnt <= 4'd0;\n                sclk_phase   <= 1'b0;\n            end\n        end\n    end\n\n    // SPI SCK output\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            spi_sck_o <= 1'b0;\n        else if (state == S_SHIFT)\n            spi_sck_o <= sclk_phase;\n        else\n            spi_sck_o <= 1'b0;\n    end\n\n    // SPI SS output\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            spi_ssel_o <= 1'b1; // Inactive high\n        else if (state == S_SHIFT || state == S_ACCEPT)\n            spi_ssel_o <= 1'b0; // Active low\n        else\n            spi_ssel_o <= 1'b1;\n    end\n\n    // TX shift register and bit counter\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            tx_shift  <= {N{1'b0}};\n            bit_count <= {N{1'b0}};\n        end else begin\n            case (state)\n                S_ACCEPT: begin\n                    tx_shift  <= di_i;\n                    bit_count <= {N{1'b0}};\n                end\n                S_SHIFT: begin\n                    if (sclk_rising) begin\n                        tx_shift <= {tx_shift[N-2:0], 1'b0};\n                    end\n                    if (sclk_falling) begin\n                        if (bit_count == N-1) begin\n                            bit_count <= {N{1'b0}};\n                        end else begin\n                            bit_count <= bit_count + 1'b1;\n                        end\n                    end\n                end\n                default: begin\n                    tx_shift  <= {N{1'b0}};\n                    bit_count <= {N{1'b0}};\n                end\n            endcase\n        end\n    end\n\n    // RX shift register\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            rx_shift <= {N{1'b0}};\n        else if (state == S_SHIFT) begin\n            if (sclk_falling)\n                rx_shift <= {rx_shift[N-2:0], spi_miso_i};\n        end else\n            rx_shift <= {N{1'b0}};\n    end\n\n    // Handshake signals\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o   <= 1'b0;\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o       <= {N{1'b0}};\n        end else begin\n            // Default: deassert pulses\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    di_req_o <= 1'b1;\n                end\n                S_WAIT_REQ: begin\n                    di_req_o <= 1'b0;\n                end\n                S_ACCEPT: begin\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b1;\n                end\n                S_SHIFT: begin\n                    di_req_o <= 1'b0;\n                end\n                S_DONE: begin\n                    di_req_o <= 1'b0;\n                    do_valid_o <= 1'b1;\n                    do_o       <= rx_shift;\n                end\n                default: begin\n                    di_req_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
