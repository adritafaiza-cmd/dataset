{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 2'd0;\n    localparam S_WAIT_WR = 2'd1;\n    localparam S_SHIFT   = 2'd2;\n    localparam S_DONE    = 2'd3;\n\n    reg [1:0] state;\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [N-1:0] bit_cnt;\n    reg [N-1:0] sck_div_cnt;\n    reg sck_phase;\n\n    // Asynchronous reset for pclk domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state       <= S_IDLE;\n            spi_ssel_o  <= 1'b0;\n            spi_sck_o   <= 1'b0;\n            di_req_o    <= 1'b0;\n            wr_ack_o    <= 1'b0;\n            do_valid_o  <= 1'b0;\n            do_o        <= {N{1'b0}};\n            tx_shift    <= {N{1'b0}};\n            rx_shift    <= {N{1'b0}};\n            bit_cnt     <= {N{1'b0}};\n            sck_div_cnt <= {N{1'b0}};\n            sck_phase   <= 1'b0;\n        end else begin\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o  <= 1'b0;\n                    di_req_o   <= 1'b1;\n                    if (wren_i) begin\n                        tx_shift <= di_i;\n                        bit_cnt  <= {N{1'b0}};\n                        sck_div_cnt <= {N{1'b0}};\n                        sck_phase   <= 1'b0;\n                        spi_ssel_o  <= 1'b1;\n                        di_req_o    <= 1'b0;\n                        wr_ack_o    <= 1'b1;\n                        state       <= S_SHIFT;\n                    end\n                end\n\n                S_SHIFT: begin\n                    // Generate SCK based on SPI_2X_CLK_DIV\n                    // SPI_2X_CLK_DIV = 2 means SCK period = 2 * pclk period\n                    // We toggle SCK every SPI_2X_CLK_DIV/2 pclk cycles\n                    // For simplicity, we use a counter that counts to SPI_2X_CLK_DIV/2\n                    // and toggle sck_phase each time.\n                    \n                    if (sck_div_cnt == (N'(SPI_2X_CLK_DIV) / 2 - 1)) begin\n                        sck_div_cnt <= {N{1'b0}};\n                        sck_phase   <= ~sck_phase;\n                        spi_sck_o   <= sck_phase;\n                        \n                        // On rising edge of SCK (sck_phase becomes 1), shift out MSB and capture MISO\n                        // On falling edge of SCK (sck_phase becomes 0), shift in MISO\n                        if (sck_phase) begin\n                            // Rising edge: shift out next bit\n                            tx_shift <= {tx_shift[N-2:0], 1'b0};\n                            spi_mosi_o <= tx_shift[N-1];\n                        end else begin\n                            // Falling edge: capture MISO\n                            rx_shift <= {spi_miso_i, rx_shift[N-1:1]};\n                            bit_cnt  <= bit_cnt + 1'b1;\n                        end\n                    end else begin\n                        sck_div_cnt <= sck_div_cnt + 1'b1;\n                    end\n                    \n                    // Check if all bits have been shifted\n                    if (bit_cnt == N'(N-1) && sck_phase == 1'b0 && sck_div_cnt == (N'(SPI_2X_CLK_DIV) / 2 - 1)) begin\n                        // All bits shifted, deassert SSEL\n                        spi_ssel_o <= 1'b0;\n                        spi_sck_o  <= 1'b0;\n                        do_o       <= rx_shift;\n                        do_valid_o <= 1'b1;\n                        di_req_o   <= 1'b1;\n                        state      <= S_IDLE;\n                    end\n                end\n\n                default: begin\n                    state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Drive MOSI from the MSB of the transmit shift register\n    assign spi_mosi_o = tx_shift[N-1];\n\nendmodule\n```<|im_end|>",
