  "text": "```verilog\nmodule apbxclk #(\n\t\tparameter\tC_APB_ADDR_WIDTH = 12,\n\t\tparameter\tC_APB_DATA_WIDTH = 32,\n\t\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\t\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\t\tlocalparam\tDW = C_APB_DATA_WIDTH\n\t) (\n\t\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\t\tinput\twire\t\t\tS_APB_PSEL,\n\t\tinput\twire\t\t\tS_APB_PENABLE,\n\t\toutput\treg\t\t\tS_APB_PREADY,\n\t\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\t\tinput\twire\t\t\tS_APB_PWRITE,\n\t\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\t\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\t\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\t\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\t\toutput\twire\t\t\tS_APB_PSLVERR,\n\t\tinput\twire\t\t\tM_APB_PCLK,\n\t\toutput\treg\t\t\tM_PRESETn,\n\t\toutput\treg\t\t\tM_APB_PSEL,\n\t\toutput\treg\t\t\tM_APB_PENABLE,\n\t\tinput\twire\t\t\tM_APB_PREADY,\n\t\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\t\toutput\twire\t\t\tM_APB_PWRITE,\n\t\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\t\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\t\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\t\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\t\tinput\twire\t\t\tM_APB_PSLVERR\n\t);\n\n\t// ------------------------------------------------------------------\n\t// Reset synchronization for M_APB domain\n\t// ------------------------------------------------------------------\n\treg [1:0] m_reset_sync;\n\treg       m_reset_int;\n\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_reset_sync <= 2'b00;\n\t\tend else begin\n\t\t\tm_reset_sync <= {m_reset_sync[0], 1'b1};\n\t\tend\n\tend\n\n\tassign m_reset_int = ~m_reset_sync[1];\n\tassign M_PRESETn   = ~m_reset_int;\n\n\t// ------------------------------------------------------------------\n\t// Source-side: capture request on setup phase, hold until ack\n\t// ------------------------------------------------------------------\n\treg       s_req_valid;\n\treg [AW-1:0] s_addr;\n\treg       s_write;\n\treg [DW-1:0] s_wdata;\n\treg [DW/8-1:0] s_wstrb;\n\treg [2:0]  s_pprot;\n\n\t// Synchronization of s_req_valid into M domain\n\treg [1:0] req_valid_sync;\n\treg       m_req_valid;\n\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_req_valid <= 1'b0;\n\t\t\ts_addr      <= {AW{1'b0}};\n\t\t\ts_write     <= 1'b0;\n\t\t\ts_wdata     <= {DW{1'b0}};\n\t\t\ts_wstrb     <= {(DW/8){1'b0}};\n\t\t\ts_pprot     <= 3'b000;\n\t\tend else if (S_APB_PSEL && !S_APB_PENABLE && !s_req_valid) begin\n\t\t\ts_req_valid <= 1'b1;\n\t\t\ts_addr      <= S_APB_PADDR;\n\t\t\ts_write     <= S_APB_PWRITE;\n\t\t\ts_wdata     <= S_APB_PWDATA;\n\t\t\ts_wstrb     <= S_APB_PWSTRB;\n\t\t\ts_pprot     <= S_APB_PPROT;\n\t\tend else if (S_APB_PSEL && S_APB_PENABLE && S_APB_PREADY) begin\n\t\t\ts_req_valid <= 1'b0;\n\t\tend\n\tend\n\n\t// Synchronize request valid to M domain\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\treq_valid_sync <= 2'b00;\n\t\tend else begin\n\t\t\treq_valid_sync <= {req_valid_sync[0], s_req_valid};\n\t\tend\n\tend\n\tassign m_req_valid = req_valid_sync[1];\n\n\t// ------------------------------------------------------------------\n\t// Destination-side: APB state machine\n\t// ------------------------------------------------------------------\n\tlocalparam ST_IDLE   = 2'b00;\n\tlocalparam ST_SETUP  = 2'b01;\n\tlocalparam ST_ACCESS = 2'b10;\n\n\treg [1:0] m_state;\n\treg       m_sel;\n\treg       m_enable;\n\n\t// Latched request fields in M domain (captured when m_req_valid is seen)\n\treg [AW-1:0] m_addr;\n\treg       m_write;\n\treg [DW-1:0] m_wdata;\n\treg [DW/8-1:0] m_wstrb;\n\treg [2:0]  m_pprot;\n\n\t// Synchronization of completion back to S domain\n\treg [1:0] done_sync;\n\treg       s_done;\n\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_state  <= ST_IDLE;\n\t\t\tm_sel    <= 1'b0;\n\t\t\tm_enable <= 1'b0;\n\t\t\tm_addr   <= {AW{1'b0}};\n\t\t\tm_write  <= 1'b0;\n\t\t\tm_wdata  <= {DW{1'b0}};\n\t\t\tm_wstrb  <= {(DW/8){1'b0}};\n\t\t\tm_pprot  <= 3'b000;\n\t\tend else begin\n\t\t\tcase (m_state)\n\t\t\t\tST_IDLE: begin\n\t\t\t\t\tm_sel    <= 1'b0;\n\t\t\t\t\tm_enable <= 1'b0;\n\t\t\t\t\tif (m_req_valid) begin\n\t\t\t\t\t\tm_state  <= ST_SETUP;\n\t\t\t\t\t\tm_sel    <= 1'b1;\n\t\t\t\t\t\tm_enable <= 1'b0;\n\t\t\t\t\t\tm_addr   <= s_addr;\n\t\t\t\t\t\tm_write  <= s_write;\n\t\t\t\t\t\tm_wdata  <= s_wdata;\n\t\t\t\t\t\tm_wstrb  <= s_wstrb;\n\t\t\t\t\t\tm_pprot  <= s_pprot;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tST_SETUP: begin\n\t\t\t\t\tm_sel    <= 1'b1;\n\t\t\t\t\tm_enable <= 1'b1;\n\t\t\t\t\tm_state  <= ST_ACCESS;\n\t\t\t\tend\n\t\t\t\tST_ACCESS: begin\n\t\t\t\t\tm_sel    <= 1'b1;\n\t\t\t\t\tm_enable <= 1'b1;\n\t\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t\tm_state  <= ST_IDLE;\n\t\t\t\t\t\tm_sel    <= 1'b0;\n\t\t\t\t\t\tm_enable <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: begin\n\t\t\t\t\tm_state  <= ST_IDLE;\n\t\t\t\t\tm_sel    <= 1'b0;\n\t\t\t\t\tm_enable <= 1'b0;\n\t\t\t\tend\n\t\t\tendcase\n\t\tend\n\tend\n\n\tassign M_APB_PSEL    = m_sel;\n\tassign M_APB_PENABLE = m_enable;\n\tassign M_APB_PADDR   = m_addr;\n\tassign M_APB_PWRITE  = m_write;\n\tassign M_APB_PWDATA  = m_wdata;\n\tassign M_APB_PWSTRB  = m_wstrb;\n\tassign M_APB_PPROT   = m_pprot;\n\n\t// ------------------------------------------------------------------\n\t// Synchronize completion (M_APB_PREADY in access phase) to S domain\n\t// ------------------------------------------------------------------\n\twire m_done_pulse = (m_state == ST_ACCESS) && M_APB_PREADY;\n\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tdone_sync <= 2'b00;\n\t\tend else begin\n\t\t\tdone_sync <= {done_sync[0], m_done_pulse};\n\t\tend\n\tend\n\tassign s_done = done_sync[1];\n\n\t// ------------------------------------------------------------------\n\t// Source-side: generate S_APB_PREADY and capture response\n\t// ------------------------------------------------------------------\n\treg [DW-1:0] s_rdata;\n\treg          s_pslverr;\n\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\ts_rdata      <= {DW{1'b0}};\n\t\t\ts_pslverr    <= 1'b0;\n\t\tend else if (s_req_valid && s_done) begin\n\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\ts_rdata      <= M_APB_PRDATA;\n\t\t\ts_pslverr    <= M_APB_PSLVERR;\n\t\tend else if (S_APB_PSEL && S_APB_PENABLE && S_APB_PREADY) begin\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\tend else begin\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\tend\n\tend\n\n\tassign S_APB_PRDATA  = s_rdata;\n\tassign S_APB_PSLVERR = s_pslverr;\n\nendmodule\n```<|im_end|>",
