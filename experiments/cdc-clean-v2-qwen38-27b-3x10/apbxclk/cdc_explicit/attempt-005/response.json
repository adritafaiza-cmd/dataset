  "text": "```verilog\nmodule apbxclk #(\n\tparameter\tC_APB_ADDR_WIDTH = 12,\n\tparameter\tC_APB_DATA_WIDTH = 32,\n\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\tlocalparam\tDW = C_APB_DATA_WIDTH\n) (\n\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\tinput\twire\t\t\tS_APB_PSEL,\n\tinput\twire\t\t\tS_APB_PENABLE,\n\toutput\treg\t\t\tS_APB_PREADY,\n\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\tinput\twire\t\t\tS_APB_PWRITE,\n\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\toutput\twire\t\t\tS_APB_PSLVERR,\n\tinput\twire\t\t\tM_APB_PCLK,\n\toutput\treg\t\t\tM_PRESETn,\n\toutput\treg\t\t\tM_APB_PSEL,\n\toutput\treg\t\t\tM_APB_PENABLE,\n\tinput\twire\t\t\tM_APB_PREADY,\n\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\toutput\twire\t\t\tM_APB_PWRITE,\n\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\tinput\twire\t\t\tM_APB_PSLVERR\n);\n\n\t// Internal signals\n\treg [AW-1:0] s_addr_reg;\n\treg s_write_reg;\n\treg [DW-1:0] s_wdata_reg;\n\treg [DW/8-1:0] s_wstrb_reg;\n\treg [2:0] s_pprot_reg;\n\n\t// Handshake signals\n\treg s_req;\n\treg m_ack;\n\treg m_req;\n\treg s_ack;\n\n\t// Synchronization chains\n\treg [1:0] s_req_sync;\n\treg [1:0] m_ack_sync;\n\treg [1:0] m_req_sync;\n\treg [1:0] s_ack_sync;\n\n\t// M domain state\n\treg m_busy;\n\treg [AW-1:0] m_addr_reg;\n\treg m_write_reg;\n\treg [DW-1:0] m_wdata_reg;\n\treg [DW/8-1:0] m_wstrb_reg;\n\treg [2:0] m_pprot_reg;\n\treg m_setup_done;\n\n\t// S domain response\n\treg [DW-1:0] s_rdata_reg;\n\treg s_pslverr_reg;\n\n\t// Reset synchronization for M domain\n\treg [1:0] s_presetn_sync;\n\n\t// S domain: Capture request when PSEL && PENABLE\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_addr_reg <= {AW{1'b0}};\n\t\t\ts_write_reg <= 1'b0;\n\t\t\ts_wdata_reg <= {DW{1'b0}};\n\t\t\ts_wstrb_reg <= {(DW/8){1'b0}};\n\t\t\ts_pprot_reg <= 3'b000;\n\t\t\ts_req <= 1'b0;\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\ts_rdata_reg <= {DW{1'b0}};\n\t\t\ts_pslverr_reg <= 1'b0;\n\t\tend else begin\n\t\t\tif (S_APB_PSEL && S_APB_PENABLE) begin\n\t\t\t\ts_addr_reg <= S_APB_PADDR;\n\t\t\t\ts_write_reg <= S_APB_PWRITE;\n\t\t\t\ts_wdata_reg <= S_APB_PWDATA;\n\t\t\t\ts_wstrb_reg <= S_APB_PWSTRB;\n\t\t\t\ts_pprot_reg <= S_APB_PPROT;\n\t\t\t\ts_req <= 1'b1;\n\t\t\tend else if (m_ack_sync[1]) begin\n\t\t\t\ts_req <= 1'b0;\n\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\t\ts_rdata_reg <= M_APB_PRDATA;\n\t\t\t\ts_pslverr_reg <= M_APB_PSLVERR;\n\t\t\tend else begin\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// S domain: Synchronize m_ack\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_ack_sync <= 2'b00;\n\t\tend else begin\n\t\t\tm_ack_sync <= {m_ack_sync[0], m_ack};\n\t\tend\n\tend\n\n\t// S domain: Synchronize s_presetn for M domain reset\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_presetn_sync <= 2'b00;\n\t\tend else begin\n\t\t\ts_presetn_sync <= {s_presetn_sync[0], S_PRESETn};\n\t\tend\n\tend\n\n\t// M domain: Synchronize s_req\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\ts_req_sync <= 2'b00;\n\t\tend else begin\n\t\t\ts_req_sync <= {s_req_sync[0], s_req};\n\t\tend\n\tend\n\n\t// M domain: Synchronize s_ack\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\ts_ack_sync <= 2'b00;\n\t\tend else begin\n\t\t\ts_ack_sync <= {s_ack_sync[0], s_ack};\n\t\tend\n\tend\n\n\t// M domain: Reset output\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tM_PRESETn <= 1'b0;\n\t\tend else begin\n\t\t\tM_PRESETn <= s_presetn_sync[1];\n\t\tend\n\tend\n\n\t// M domain: APB state machine\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_busy <= 1'b0;\n\t\t\tm_addr_reg <= {AW{1'b0}};\n\t\t\tm_write_reg <= 1'b0;\n\t\t\tm_wdata_reg <= {DW{1'b0}};\n\t\t\tm_wstrb_reg <= {(DW/8){1'b0}};\n\t\t\tm_pprot_reg <= 3'b000;\n\t\t\tm_setup_done <= 1'b0;\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\tm_req <= 1'b0;\n\t\t\tm_ack <= 1'b0;\n\t\tend else begin\n\t\t\tif (!m_busy) begin\n\t\t\t\tif (s_req_sync[1]) begin\n\t\t\t\t\t// Start new transaction: setup phase\n\t\t\t\t\tm_busy <= 1'b1;\n\t\t\t\t\tm_setup_done <= 1'b0;\n\t\t\t\t\tm_addr_reg <= s_addr_reg;\n\t\t\t\t\tm_write_reg <= s_write_reg;\n\t\t\t\t\tm_wdata_reg <= s_wdata_reg;\n\t\t\t\t\tm_wstrb_reg <= s_wstrb_reg;\n\t\t\t\t\tm_pprot_reg <= s_pprot_reg;\n\t\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\t\tm_req <= 1'b1;\n\t\t\t\t\tm_ack <= 1'b0;\n\t\t\t\tend else begin\n\t\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\t\tm_req <= 1'b0;\n\t\t\t\t\tm_ack <= 1'b0;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\tif (!m_setup_done) begin\n\t\t\t\t\t// Setup phase complete, move to access phase\n\t\t\t\t\tm_setup_done <= 1'b1;\n\t\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\tend else begin\n\t\t\t\t\t// Access phase\n\t\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t\t// Transaction complete\n\t\t\t\t\t\tm_busy <= 1'b0;\n\t\t\t\t\t\tm_setup_done <= 1'b0;\n\t\t\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\t\t\tm_req <= 1'b0;\n\t\t\t\t\t\tm_ack <= 1'b1;\n\t\t\t\t\tend else begin\n\t\t\t\t\t\t// Wait for ready\n\t\t\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\t\t\tm_req <= 1'b1;\n\t\t\t\t\t\tm_ack <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// M domain: Synchronize m_ack to S domain\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_ack <= 1'b0;\n\t\tend else begin\n\t\t\tif (m_busy && m_setup_done && M_APB_PREADY) begin\n\t\t\t\tm_ack <= 1'b1;\n\t\t\tend else if (!m_busy) begin\n\t\t\t\tm_ack <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// S domain: Synchronize m_ack\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_ack_sync <= 2'b00;\n\t\tend else begin\n\t\t\tm_ack_sync <= {m_ack_sync[0], m_ack};\n\t\tend\n\tend\n\n\t// S domain: Synchronize s_ack to M domain\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_ack <= 1'b0;\n\t\tend else begin\n\t\t\tif (m_ack_sync[1]) begin\n\t\t\t\ts_ack <= 1'b1;\n\t\t\tend else begin\n\t\t\t\ts_ack <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// M domain: Synchronize s_ack\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\ts_ack_sync <= 2'b00;\n\t\tend else begin\n\t\t\ts_ack_sync <= {s_ack_sync[0], s_ack};\n\t\tend\n\tend\n\n\t// M domain: Clear m_req when s_ack is received\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_req <= 1'b0;\n\t\tend else begin\n\t\t\tif (s_ack_sync[1]) begin\n\t\t\t\tm_req <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Output assignments\n\tassign M_APB_PADDR = m_addr_reg;\n\tassign M_APB_PWRITE = m_write_reg;\n\tassign M_APB_PWDATA = m_wdata_reg;\n\tassign M_APB_PWSTRB = m_wstrb_reg;\n\tassign M_APB_PPROT = m_pprot_reg;\n\n\tassign S_APB_PRDATA = s_rdata_reg;\n\tassign S_APB_PSLVERR = s_pslverr_reg;\n\nendmodule\n```<|im_end|>",
