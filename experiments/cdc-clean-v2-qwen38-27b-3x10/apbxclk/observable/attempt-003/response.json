  "text": "```verilog\nmodule apbxclk #(\n    parameter C_APB_ADDR_WIDTH = 12,\n    parameter C_APB_DATA_WIDTH = 32,\n    parameter [0:0] OPT_REGISTERED = 1'b0,\n    localparam AW = C_APB_ADDR_WIDTH,\n    localparam DW = C_APB_DATA_WIDTH\n) (\n    input wire S_APB_PCLK, S_PRESETn,\n    input wire S_APB_PSEL,\n    input wire S_APB_PENABLE,\n    output reg S_APB_PREADY,\n    input wire [AW-1:0] S_APB_PADDR,\n    input wire S_APB_PWRITE,\n    input wire [DW-1:0] S_APB_PWDATA,\n    input wire [DW/8-1:0] S_APB_PWSTRB,\n    input wire [2:0] S_APB_PPROT,\n    output wire [DW-1:0] S_APB_PRDATA,\n    output wire S_APB_PSLVERR,\n    input wire M_APB_PCLK,\n    output reg M_PRESETn,\n    output reg M_APB_PSEL,\n    output reg M_APB_PENABLE,\n    input wire M_APB_PREADY,\n    output wire [AW-1:0] M_APB_PADDR,\n    output wire M_APB_PWRITE,\n    output wire [DW-1:0] M_APB_PWDATA,\n    output wire [DW/8-1:0] M_APB_PWSTRB,\n    output wire [2:0] M_APB_PPROT,\n    input wire [DW-1:0] M_APB_PRDATA,\n    input wire M_APB_PSLVERR\n);\n\n    // Synchronization stages for request (slave -> master)\n    reg [1:0] req_sync;\n    reg req_valid_m;\n    reg req_pending_m;\n\n    // Synchronization stages for response (master -> slave)\n    reg [1:0] rsp_sync;\n    reg rsp_valid_s;\n    reg rsp_pending_s;\n\n    // Master-side captured request fields\n    reg [AW-1:0] m_addr;\n    reg m_write;\n    reg [DW-1:0] m_wdata;\n    reg [DW/8-1:0] m_wstrb;\n    reg [2:0] m_pprot;\n\n    // Slave-side captured response fields\n    reg [DW-1:0] s_rdata;\n    reg s_pslverr;\n\n    // Master-side state machine\n    // States: IDLE, SETUP, ACCESS\n    localparam [1:0] M_IDLE = 2'b00,\n                     M_SETUP = 2'b01,\n                     M_ACCESS = 2'b10;\n    reg [1:0] m_state;\n\n    // Slave-side state machine\n    // States: S_IDLE, S_SETUP, S_ACCESS\n    localparam [1:0] S_IDLE = 2'b00,\n                     S_SETUP = 2'b01,\n                     S_ACCESS = 2'b10;\n    reg [1:0] s_state;\n\n    // Master clock domain logic\n    always @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n        if (!M_PRESETn) begin\n            req_sync <= 2'b00;\n            req_valid_m <= 1'b0;\n            req_pending_m <= 1'b0;\n            m_state <= M_IDLE;\n            m_addr <= {AW{1'b0}};\n            m_write <= 1'b0;\n            m_wdata <= {DW{1'b0}};\n            m_wstrb <= {(DW/8){1'b0}};\n            m_pprot <= 3'b000;\n            M_APB_PSEL <= 1'b0;\n            M_APB_PENABLE <= 1'b0;\n        end else begin\n            // Synchronize request valid\n            req_sync <= {req_sync[0], S_APB_PSEL & S_APB_PENABLE & S_APB_PREADY};\n            \n            // Detect rising edge of synchronized request\n            if (req_sync[1] && !req_sync[0]) begin\n                req_valid_m <= 1'b1;\n            end else if (req_valid_m && m_state == M_IDLE) begin\n                req_valid_m <= 1'b0;\n            end\n\n            // State machine\n            case (m_state)\n                M_IDLE: begin\n                    M_APB_PSEL <= 1'b0;\n                    M_APB_PENABLE <= 1'b0;\n                    if (req_valid_m) begin\n                        m_state <= M_SETUP;\n                        M_APB_PSEL <= 1'b1;\n                        M_APB_PENABLE <= 1'b0;\n                        // Capture request fields\n                        m_addr <= S_APB_PADDR;\n                        m_write <= S_APB_PWRITE;\n                        m_wdata <= S_APB_PWDATA;\n                        m_wstrb <= S_APB_PWSTRB;\n                        m_pprot <= S_APB_PPROT;\n                    end\n                end\n                M_SETUP: begin\n                    M_APB_PSEL <= 1'b1;\n                    M_APB_PENABLE <= 1'b1;\n                    m_state <= M_ACCESS;\n                end\n                M_ACCESS: begin\n                    M_APB_PSEL <= 1'b1;\n                    M_APB_PENABLE <= 1'b1;\n                    if (M_APB_PREADY) begin\n                        m_state <= M_IDLE;\n                        M_APB_PSEL <= 1'b0;\n                        M_APB_PENABLE <= 1'b0;\n                        // Signal response to slave side\n                        rsp_sync <= 2'b00;\n                    end\n                end\n                default: m_state <= M_IDLE;\n            endcase\n        end\n    end\n\n    // Master-side output assignments\n    assign M_APB_PADDR = m_addr;\n    assign M_APB_PWRITE = m_write;\n    assign M_APB_PWDATA = m_wdata;\n    assign M_APB_PWSTRB = m_wstrb;\n    assign M_APB_PPROT = m_pprot;\n\n    // Synchronize response from master to slave\n    // We need to synchronize the completion of the master transfer\n    // Use a simple 2-stage synchronizer for the response valid\n    reg [1:0] m_done_sync;\n    reg m_done;\n\n    always @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n        if (!M_PRESETn) begin\n            m_done_sync <= 2'b00;\n            m_done <= 1'b0;\n        end else begin\n            m_done_sync <= {m_done_sync[0], (m_state == M_ACCESS) && M_APB_PREADY};\n            if (m_done_sync[1] && !m_done_sync[0]) begin\n                m_done <= 1'b1;\n            end else if (m_done && rsp_sync[1]) begin\n                m_done <= 1'b0;\n            end\n        end\n    end\n\n    // Slave clock domain logic\n    always @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n        if (!S_PRESETn) begin\n            rsp_sync <= 2'b00;\n            rsp_valid_s <= 1'b0;\n            rsp_pending_s <= 1'b0;\n            s_state <= S_IDLE;\n            s_rdata <= {DW{1'b0}};\n            s_pslverr <= 1'b0;\n            S_APB_PREADY <= 1'b0;\n        end else begin\n            // Synchronize response valid from master\n            rsp_sync <= {rsp_sync[0], m_done};\n            \n            // Detect rising edge of synchronized response\n            if (rsp_sync[1] && !rsp_sync[0]) begin\n                rsp_valid_s <= 1'b1;\n            end else if (rsp_valid_s && s_state == S_ACCESS) begin\n                rsp_valid_s <= 1'b0;\n            end\n\n            // State machine\n            case (s_state)\n                S_IDLE: begin\n                    S_APB_PREADY <= 1'b0;\n                    if (S_APB_PSEL && !S_APB_PENABLE) begin\n                        s_state <= S_SETUP;\n                    end\n                end\n                S_SETUP: begin\n                    S_APB_PREADY <= 1'b0;\n                    s_state <= S_ACCESS;\n                end\n                S_ACCESS: begin\n                    if (rsp_valid_s) begin\n                        // Capture response\n                        s_rdata <= M_APB_PRDATA;\n                        s_pslverr <= M_APB_PSLVERR;\n                        S_APB_PREADY <= 1'b1;\n                        s_state <= S_IDLE;\n                    end else begin\n                        S_APB_PREADY <= 1'b0;\n                    end\n                end\n                default: begin\n                    S_APB_PREADY <= 1'b0;\n                    s_state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Slave-side output assignments\n    assign S_APB_PRDATA = s_rdata;\n    assign S_APB_PSLVERR = s_pslverr;\n\nendmodule\n```<|im_end|>",
