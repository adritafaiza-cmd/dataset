{
  "text": "```verilog\nmodule apbxclk #(\n    parameter C_APB_ADDR_WIDTH = 12,\n    parameter C_APB_DATA_WIDTH = 32,\n    parameter [0:0] OPT_REGISTERED = 1'b0,\n    localparam AW = C_APB_ADDR_WIDTH,\n    localparam DW = C_APB_DATA_WIDTH\n) (\n    input wire S_APB_PCLK, S_PRESETn,\n    input wire S_APB_PSEL,\n    input wire S_APB_PENABLE,\n    output reg S_APB_PREADY,\n    input wire [AW-1:0] S_APB_PADDR,\n    input wire S_APB_PWRITE,\n    input wire [DW-1:0] S_APB_PWDATA,\n    input wire [DW/8-1:0] S_APB_PWSTRB,\n    input wire [2:0] S_APB_PPROT,\n    output wire [DW-1:0] S_APB_PRDATA,\n    output wire S_APB_PSLVERR,\n    input wire M_APB_PCLK,\n    output reg M_PRESETn,\n    output reg M_APB_PSEL,\n    output reg M_APB_PENABLE,\n    input wire M_APB_PREADY,\n    output wire [AW-1:0] M_APB_PADDR,\n    output wire M_APB_PWRITE,\n    output wire [DW-1:0] M_APB_PWDATA,\n    output wire [DW/8-1:0] M_APB_PWSTRB,\n    output wire [2:0] M_APB_PPROT,\n    input wire [DW-1:0] M_APB_PRDATA,\n    input wire M_APB_PSLVERR\n);\n\n    // 2-FF synchronizers\n    reg [1:0] sync_req;\n    reg [1:0] sync_done;\n\n    always @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n        if (!M_PRESETn)\n            sync_req <= 2'b00;\n        else\n            sync_req <= {sync_req[0], S_APB_PSEL};\n    end\n\n    always @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n        if (!S_PRESETn)\n            sync_done <= 2'b00;\n        else\n            sync_done <= {sync_done[0], M_APB_PSEL};\n    end\n\n    // Master-side state machine\n    localparam MS_IDLE = 2'd0;\n    localparam MS_SETUP = 2'd1;\n    localparam MS_ACCESS = 2'd2;\n    localparam MS_DONE = 2'd3;\n\n    reg [1:0] m_state;\n    reg [AW-1:0] m_addr;\n    reg m_write;\n    reg [DW-1:0] m_wdata;\n    reg [DW/8-1:0] m_wstrb;\n    reg [2:0] m_pprot;\n    reg [DW-1:0] m_rdata;\n    reg m_pslverr;\n\n    always @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n        if (!M_PRESETn) begin\n            m_state <= MS_IDLE;\n            m_addr <= {AW{1'b0}};\n            m_write <= 1'b0;\n            m_wdata <= {DW{1'b0}};\n            m_wstrb <= {(DW/8){1'b0}};\n            m_pprot <= 3'b000;\n            m_rdata <= {DW{1'b0}};\n            m_pslverr <= 1'b0;\n        end else begin\n            case (m_state)\n                MS_IDLE: begin\n                    if (sync_req[1]) begin\n                        m_addr <= S_APB_PADDR;\n                        m_write <= S_APB_PWRITE;\n                        m_wdata <= S_APB_PWDATA;\n                        m_wstrb <= S_APB_PWSTRB;\n                        m_pprot <= S_APB_PPROT;\n                        m_state <= MS_SETUP;\n                    end\n                end\n                MS_SETUP: begin\n                    m_state <= MS_ACCESS;\n                end\n                MS_ACCESS: begin\n                    if (M_APB_PREADY) begin\n                        m_rdata <= M_APB_PRDATA;\n                        m_pslverr <= M_APB_PSLVERR;\n                        m_state <= MS_DONE;\n                    end\n                end\n                MS_DONE: begin\n                    m_state <= MS_IDLE;\n                end\n                default: m_state <= MS_IDLE;\n            endcase\n        end\n    end\n\n    // Master APB outputs\n    always @(*) begin\n        M_APB_PSEL = (m_state == MS_SETUP) || (m_state == MS_ACCESS);\n        M_APB_PENABLE = (m_state == MS_ACCESS);\n        M_APB_PADDR = m_addr;\n        M_APB_PWRITE = m_write;\n        M_APB_PWDATA = m_wdata;\n        M_APB_PWSTRB = m_wstrb;\n        M_APB_PPROT = m_pprot;\n    end\n\n    // Slave-side state machine\n    localparam SS_IDLE = 2'd0;\n    localparam SS_WAIT = 2'd1;\n    localparam SS_RESP = 2'd2;\n\n    reg [1:0] s_state;\n    reg [DW-1:0] s_rdata;\n    reg s_pslverr;\n\n    always @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n        if (!S_PRESETn) begin\n            s_state <= SS_IDLE;\n            s_rdata <= {DW{1'b0}};\n            s_pslverr <= 1'b0;\n        end else begin\n            case (s_state)\n                SS_IDLE: begin\n                    if (S_APB_PSEL) begin\n                        s_state <= SS_WAIT;\n                    end\n                end\n                SS_WAIT: begin\n                    if (sync_done[1]) begin\n                        s_rdata <= M_APB_PRDATA;\n                        s_pslverr <= M_APB_PSLVERR;\n                        s_state <= SS_RESP;\n                    end\n                end\n                SS_RESP: begin\n                    if (S_APB_PENABLE) begin\n                        s_state <= SS_IDLE;\n                    end\n                end\n                default: s_state <= SS_IDLE;\n            endcase\n        end\n    end\n\n    // Slave APB outputs\n    always @(*) begin\n        S_APB_PREADY = (s_state == SS_RESP);\n        S_APB_PRDATA = s_rdata;\n        S_APB_PSLVERR = s_pslverr;\n    end\n\nendmodule\n```<|im_end|>",
