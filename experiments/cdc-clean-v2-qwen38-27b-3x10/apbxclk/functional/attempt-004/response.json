  "text": "```verilog\nmodule apbxclk #(\n\t\tparameter\tC_APB_ADDR_WIDTH = 12,\n\t\tparameter\tC_APB_DATA_WIDTH = 32,\n\t\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\t\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\t\tlocalparam\tDW = C_APB_DATA_WIDTH\n\t) (\n\t\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\t\tinput\twire\t\t\tS_APB_PSEL,\n\t\tinput\twire\t\t\tS_APB_PENABLE,\n\t\toutput\treg\t\t\tS_APB_PREADY,\n\t\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\t\tinput\twire\t\t\tS_APB_PWRITE,\n\t\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\t\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\t\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\t\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\t\toutput\twire\t\t\tS_APB_PSLVERR,\n\t\tinput\twire\t\t\tM_APB_PCLK,\n\t\toutput\treg\t\t\tM_PRESETn,\n\t\toutput\treg\t\t\tM_APB_PSEL,\n\t\toutput\treg\t\t\tM_APB_PENABLE,\n\t\tinput\twire\t\t\tM_APB_PREADY,\n\t\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\t\toutput\twire\t\t\tM_APB_PWRITE,\n\t\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\t\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\t\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\t\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\t\tinput\twire\t\t\tM_APB_PSLVERR\n\t);\n\n\t// Synchronous reset for M domain\n\treg [3:0] m_reset_sync;\n\treg m_reset_n;\n\n\talways @(posedge M_APB_PCLK or negedge m_reset_n) begin\n\t\tif (!m_reset_n) begin\n\t\t\tm_reset_sync <= 4'b0000;\n\t\tend else begin\n\t\t\tm_reset_sync <= {m_reset_sync[2:0], 1'b1};\n\t\tend\n\tend\n\n\tassign M_PRESETn = m_reset_sync[3];\n\n\t// Handshake signals\n\treg s_req_valid;\n\treg m_req_ready;\n\treg m_resp_valid;\n\treg s_resp_ready;\n\n\t// M domain: capture request when handshake completes\n\treg [AW-1:0] m_addr;\n\treg m_write;\n\treg [DW-1:0] m_wdata;\n\treg [DW/8-1:0] m_wstrb;\n\treg [2:0] m_pprot;\n\treg m_trans_active;\n\treg m_trans_done;\n\n\t// M domain: APB state machine\n\treg m_apb_sel;\n\treg m_apb_enable;\n\n\t// M domain: capture response\n\treg [DW-1:0] m_rdata;\n\treg m_rslverr;\n\n\t// S domain: hold response\n\treg [DW-1:0] s_rdata;\n\treg s_rslverr;\n\n\t// M domain: request capture logic\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_req_ready <= 1'b0;\n\t\t\tm_trans_active <= 1'b0;\n\t\t\tm_trans_done <= 1'b0;\n\t\t\tm_apb_sel <= 1'b0;\n\t\t\tm_apb_enable <= 1'b0;\n\t\t\tm_addr <= {AW{1'b0}};\n\t\t\tm_write <= 1'b0;\n\t\t\tm_wdata <= {DW{1'b0}};\n\t\t\tm_wstrb <= {(DW/8){1'b0}};\n\t\t\tm_pprot <= 3'b000;\n\t\t\tm_rdata <= {DW{1'b0}};\n\t\t\tm_rslverr <= 1'b0;\n\t\t\tm_resp_valid <= 1'b0;\n\t\tend else begin\n\t\t\tif (m_trans_active) begin\n\t\t\t\t// In access phase\n\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t// Transfer complete\n\t\t\t\t\tm_trans_active <= 1'b0;\n\t\t\t\t\tm_trans_done <= 1'b1;\n\t\t\t\t\tm_apb_sel <= 1'b0;\n\t\t\t\t\tm_apb_enable <= 1'b0;\n\t\t\t\t\tm_resp_valid <= 1'b1;\n\t\t\t\t\tm_rdata <= M_APB_PRDATA;\n\t\t\t\t\tm_rslverr <= M_APB_PSLVERR;\n\t\t\t\t\tm_req_ready <= 1'b0;\n\t\t\t\tend\n\t\t\tend else if (m_trans_done) begin\n\t\t\t\t// Response was consumed, ready for next\n\t\t\t\tm_trans_done <= 1'b0;\n\t\t\t\tm_resp_valid <= 1'b0;\n\t\t\t\tm_req_ready <= 1'b1;\n\t\t\tend else begin\n\t\t\t\t// Idle, waiting for request\n\t\t\t\tif (s_req_valid) begin\n\t\t\t\t\t// Capture request and start APB transfer\n\t\t\t\t\tm_addr <= S_APB_PADDR;\n\t\t\t\t\tm_write <= S_APB_PWRITE;\n\t\t\t\t\tm_wdata <= S_APB_PWDATA;\n\t\t\t\t\tm_wstrb <= S_APB_PWSTRB;\n\t\t\t\t\tm_pprot <= S_APB_PPROT;\n\t\t\t\t\tm_trans_active <= 1'b1;\n\t\t\t\t\tm_apb_sel <= 1'b1;\n\t\t\t\t\tm_apb_enable <= 1'b0;\n\t\t\t\t\tm_req_ready <= 1'b0;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// M domain: APB enable phase\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\tend else begin\n\t\t\tif (m_trans_active) begin\n\t\t\t\tif (!m_apb_enable) begin\n\t\t\t\t\t// Setup phase -> Access phase\n\t\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\tend else begin\n\t\t\t\t\t// Access phase, wait for PREADY\n\t\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\t\tend else begin\n\t\t\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// M domain: output assignments\n\tassign M_APB_PADDR = m_addr;\n\tassign M_APB_PWRITE = m_write;\n\tassign M_APB_PWDATA = m_wdata;\n\tassign M_APB_PWSTRB = m_wstrb;\n\tassign M_APB_PPROT = m_pprot;\n\n\t// S domain: response capture and ready\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\ts_rdata <= {DW{1'b0}};\n\t\t\ts_rslverr <= 1'b0;\n\t\t\ts_req_valid <= 1'b0;\n\t\t\ts_resp_ready <= 1'b0;\n\t\tend else begin\n\t\t\tif (m_resp_valid) begin\n\t\t\t\t// Response available from M domain\n\t\t\t\ts_rdata <= m_rdata;\n\t\t\t\ts_rslverr <= m_rslverr;\n\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\t\ts_resp_ready <= 1'b1;\n\t\t\t\ts_req_valid <= 1'b0;\n\t\t\tend else if (S_APB_PSEL && S_APB_PENABLE && S_APB_PREADY) begin\n\t\t\t\t// Source transfer complete, ready for next\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\ts_resp_ready <= 1'b0;\n\t\t\tend else if (S_APB_PSEL && !S_APB_PENABLE) begin\n\t\t\t\t// Setup phase, check if M domain is ready\n\t\t\t\tif (m_req_ready) begin\n\t\t\t\t\ts_req_valid <= 1'b1;\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\tend else begin\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// S domain: output assignments\n\tassign S_APB_PRDATA = s_rdata;\n\tassign S_APB_PSLVERR = s_rslverr;\n\nendmodule\n```<|im_end|>",
