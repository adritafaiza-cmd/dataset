  "text": "```verilog\nmodule apbxclk #(\n\t\tparameter\tC_APB_ADDR_WIDTH = 12,\n\t\tparameter\tC_APB_DATA_WIDTH = 32,\n\t\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\t\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\t\tlocalparam\tDW = C_APB_DATA_WIDTH\n\t) (\n\t\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\t\tinput\twire\t\t\tS_APB_PSEL,\n\t\tinput\twire\t\t\tS_APB_PENABLE,\n\t\toutput\treg\t\t\tS_APB_PREADY,\n\t\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\t\tinput\twire\t\t\tS_APB_PWRITE,\n\t\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\t\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\t\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\t\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\t\toutput\twire\t\t\tS_APB_PSLVERR,\n\t\tinput\twire\t\t\tM_APB_PCLK,\n\t\toutput\treg\t\t\tM_PRESETn,\n\t\toutput\treg\t\t\tM_APB_PSEL,\n\t\toutput\treg\t\t\tM_APB_PENABLE,\n\t\tinput\twire\t\t\tM_APB_PREADY,\n\t\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\t\toutput\twire\t\t\tM_APB_PWRITE,\n\t\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\t\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\t\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\t\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\t\tinput\twire\t\t\tM_APB_PSLVERR\n\t);\n\n\t// Synchronous reset for M domain\n\treg [1:0] m_reset_sync;\n\treg m_resetn;\n\n\talways @(posedge M_APB_PCLK or negedge m_resetn) begin\n\t\tif (!m_resetn) begin\n\t\t\tm_reset_sync <= 2'b00;\n\t\tend else begin\n\t\t\tm_reset_sync <= {m_reset_sync[0], S_PRESETn};\n\t\tend\n\t\tm_resetn <= m_reset_sync[1];\n\tend\n\n\tassign M_PRESETn = m_resetn;\n\n\t// Handshake signals\n\treg s_req_valid;\n\treg m_req_ready;\n\treg m_resp_valid;\n\treg s_resp_ready;\n\n\t// M domain: capture request from S domain\n\treg [AW-1:0] m_addr;\n\treg m_write;\n\treg [DW-1:0] m_wdata;\n\treg [DW/8-1:0] m_wstrb;\n\treg [2:0] m_pprot;\n\n\t// M domain: APB state machine\n\treg m_apb_sel;\n\treg m_apb_enable;\n\treg m_apb_done;\n\n\t// M domain: capture response\n\treg [DW-1:0] m_rdata;\n\treg m_pslverr;\n\n\t// S domain: capture response from M domain\n\treg [DW-1:0] s_rdata;\n\treg s_pslverr;\n\n\t// S domain: APB state\n\treg s_apb_busy;\n\n\t// M domain: request valid (captured)\n\treg m_req_valid;\n\n\t// M domain: response valid (captured)\n\treg m_resp_valid_reg;\n\n\t// S domain: response ready\n\treg s_resp_ready_reg;\n\n\t// M domain: request ready\n\treg m_req_ready_reg;\n\n\t// M domain: APB phase\n\t// 0: idle, 1: setup, 2: access\n\treg [1:0] m_apb_state;\n\n\t// M domain: capture request fields\n\talways @(posedge M_APB_PCLK or negedge m_resetn) begin\n\t\tif (!m_resetn) begin\n\t\t\tm_req_valid <= 1'b0;\n\t\t\tm_addr <= {AW{1'b0}};\n\t\t\tm_write <= 1'b0;\n\t\t\tm_wdata <= {DW{1'b0}};\n\t\t\tm_wstrb <= {(DW/8){1'b0}};\n\t\t\tm_pprot <= 3'b000;\n\t\t\tm_apb_sel <= 1'b0;\n\t\t\tm_apb_enable <= 1'b0;\n\t\t\tm_apb_state <= 2'b00;\n\t\t\tm_rdata <= {DW{1'b0}};\n\t\t\tm_pslverr <= 1'b0;\n\t\t\tm_resp_valid_reg <= 1'b0;\n\t\t\tm_req_ready_reg <= 1'b0;\n\t\tend else begin\n\t\t\t// Default: no change\n\t\t\t// Handle request capture\n\t\t\tif (s_req_valid && m_req_ready_reg) begin\n\t\t\t\tm_req_valid <= 1'b1;\n\t\t\t\tm_addr <= S_APB_PADDR;\n\t\t\t\tm_write <= S_APB_PWRITE;\n\t\t\t\tm_wdata <= S_APB_PWDATA;\n\t\t\t\tm_wstrb <= S_APB_PWSTRB;\n\t\t\t\tm_pprot <= S_APB_PPROT;\n\t\t\tend else if (m_apb_state == 2'b11) begin\n\t\t\t\t// Transfer complete, clear request valid\n\t\t\t\tm_req_valid <= 1'b0;\n\t\t\tend\n\n\t\t\t// APB state machine\n\t\t\tcase (m_apb_state)\n\t\t\t\t2'b00: begin\n\t\t\t\t\t// Idle\n\t\t\t\t\tm_apb_sel <= 1'b0;\n\t\t\t\t\tm_apb_enable <= 1'b0;\n\t\t\t\t\tif (m_req_valid) begin\n\t\t\t\t\t\tm_apb_state <= 2'b01;\n\t\t\t\t\t\tm_apb_sel <= 1'b1;\n\t\t\t\t\t\tm_apb_enable <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\t2'b01: begin\n\t\t\t\t\t// Setup phase\n\t\t\t\t\tm_apb_sel <= 1'b1;\n\t\t\t\t\tm_apb_enable <= 1'b1;\n\t\t\t\t\tm_apb_state <= 2'b10;\n\t\t\t\tend\n\t\t\t\t2'b10: begin\n\t\t\t\t\t// Access phase\n\t\t\t\t\tm_apb_sel <= 1'b1;\n\t\t\t\t\tm_apb_enable <= 1'b1;\n\t\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t\tm_apb_state <= 2'b11;\n\t\t\t\t\t\tm_rdata <= M_APB_PRDATA;\n\t\t\t\t\t\tm_pslverr <= M_APB_PSLVERR;\n\t\t\t\t\t\tm_resp_valid_reg <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\t2'b11: begin\n\t\t\t\t\t// Done\n\t\t\t\t\tm_apb_sel <= 1'b0;\n\t\t\t\t\tm_apb_enable <= 1'b0;\n\t\t\t\t\tm_apb_state <= 2'b00;\n\t\t\t\t\tif (m_resp_valid_reg && s_resp_ready_reg) begin\n\t\t\t\t\t\tm_resp_valid_reg <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: m_apb_state <= 2'b00;\n\t\t\tendcase\n\n\t\t\t// Request ready: can accept new request when idle and no pending response\n\t\t\tm_req_ready_reg <= (m_apb_state == 2'b00) && !m_resp_valid_reg;\n\t\tend\n\tend\n\n\t// M domain outputs\n\tassign M_APB_PSEL = m_apb_sel;\n\tassign M_APB_PENABLE = m_apb_enable;\n\tassign M_APB_PADDR = m_addr;\n\tassign M_APB_PWRITE = m_write;\n\tassign M_APB_PWDATA = m_wdata;\n\tassign M_APB_PWSTRB = m_wstrb;\n\tassign M_APB_PPROT = m_pprot;\n\n\t// S domain: response capture\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_rdata <= {DW{1'b0}};\n\t\t\ts_pslverr <= 1'b0;\n\t\t\ts_apb_busy <= 1'b0;\n\t\t\ts_resp_ready_reg <= 1'b0;\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\tend else begin\n\t\t\t// Capture response from M domain\n\t\t\tif (m_resp_valid_reg && s_resp_ready_reg) begin\n\t\t\t\ts_rdata <= m_rdata;\n\t\t\t\ts_pslverr <= m_pslverr;\n\t\t\t\ts_apb_busy <= 1'b0;\n\t\t\t\ts_resp_ready_reg <= 1'b0;\n\t\t\tend\n\n\t\t\t// S domain APB logic\n\t\t\tif (!s_apb_busy) begin\n\t\t\t\t// Idle: can accept new request\n\t\t\t\tif (S_APB_PSEL && !S_APB_PENABLE) begin\n\t\t\t\t\t// Setup phase: request is valid\n\t\t\t\t\ts_apb_busy <= 1'b1;\n\t\t\t\t\ts_resp_ready_reg <= 1'b0;\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\t// Busy: waiting for response\n\t\t\t\tif (m_resp_valid_reg) begin\n\t\t\t\t\t// Response available, ready to accept\n\t\t\t\t\ts_resp_ready_reg <= 1'b1;\n\t\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// S domain outputs\n\tassign S_APB_PRDATA = s_rdata;\n\tassign S_APB_PSLVERR = s_pslverr;\n\n\t// Handshake signals\n\tassign s_req_valid = S_APB_PSEL && !S_APB_PENABLE && !s_apb_busy;\n\tassign m_req_ready = m_req_ready_reg;\n\tassign m_resp_valid = m_resp_valid_reg;\n\tassign s_resp_ready = s_resp_ready_reg;\n\nendmodule\n```<|im_end|>",
