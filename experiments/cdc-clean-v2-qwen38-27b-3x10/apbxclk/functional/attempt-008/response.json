  "text": "```verilog\nmodule apbxclk #(\n\t\tparameter\tC_APB_ADDR_WIDTH = 12,\n\t\tparameter\tC_APB_DATA_WIDTH = 32,\n\t\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\t\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\t\tlocalparam\tDW = C_APB_DATA_WIDTH\n\t) (\n\t\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\t\tinput\twire\t\t\tS_APB_PSEL,\n\t\tinput\twire\t\t\tS_APB_PENABLE,\n\t\toutput\treg\t\t\tS_APB_PREADY,\n\t\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\t\tinput\twire\t\t\tS_APB_PWRITE,\n\t\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\t\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\t\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\t\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\t\toutput\twire\t\t\tS_APB_PSLVERR,\n\t\tinput\twire\t\t\tM_APB_PCLK,\n\t\toutput\treg\t\t\tM_PRESETn,\n\t\toutput\treg\t\t\tM_APB_PSEL,\n\t\toutput\treg\t\t\tM_APB_PENABLE,\n\t\tinput\twire\t\t\tM_APB_PREADY,\n\t\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\t\toutput\twire\t\t\tM_APB_PWRITE,\n\t\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\t\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\t\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\t\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\t\tinput\twire\t\t\tM_APB_PSLVERR\n\t);\n\n\t// Synchronous reset for M domain\n\treg [3:0] m_reset_sync;\n\treg m_reset_done;\n\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_reset_sync <= 4'b0000;\n\t\t\tm_reset_done <= 1'b0;\n\t\tend else begin\n\t\t\tm_reset_sync <= {m_reset_sync[2:0], 1'b1};\n\t\t\tm_reset_done <= m_reset_sync[3];\n\t\tend\n\tend\n\n\tassign M_PRESETn = m_reset_done;\n\n\t// S domain: detect setup phase completion (PSEL=1, PENABLE=0)\n\t// and capture the request. We use a handshake to ensure the request\n\t// is captured exactly once per transfer.\n\n\t// S domain state\n\treg s_req_valid;       // request captured, waiting for M to accept\n\treg s_transfer_active; // transfer in progress (M side)\n\treg s_ready_pending;   // M side completed, waiting to signal S ready\n\n\t// Captured request fields (S domain)\n\treg [AW-1:0] s_addr;\n\treg s_write;\n\treg [DW-1:0] s_wdata;\n\treg [DW/8-1:0] s_wstrb;\n\treg [2:0] s_pprot;\n\n\t// M domain: request valid and fields\n\treg m_req_valid;\n\treg [AW-1:0] m_addr;\n\treg m_write;\n\treg [DW-1:0] m_wdata;\n\treg [DW/8-1:0] m_wstrb;\n\treg [2:0] m_pprot;\n\n\t// M domain: response capture\n\treg m_resp_valid;\n\treg [DW-1:0] m_rdata;\n\treg m_rslverr;\n\n\t// S domain: response\n\treg [DW-1:0] s_rdata;\n\treg s_rslverr;\n\n\t// Handshake signals between domains\n\t// S -> M: request valid\n\treg s_to_m_req_valid;\n\t// M -> S: request accepted (M has captured)\n\treg m_to_s_req_accepted;\n\t// M -> S: response valid\n\treg m_to_s_resp_valid;\n\t// S -> M: response accepted (S has captured)\n\treg s_to_m_resp_accepted;\n\n\t// 2-FF synchronizers for each handshake signal\n\t// s_to_m_req_valid: S domain -> M domain\n\treg [1:0] s2m_req_valid_sync;\n\t// m_to_s_req_accepted: M domain -> S domain\n\treg [1:0] m2s_req_accepted_sync;\n\t// m_to_s_resp_valid: M domain -> S domain\n\treg [1:0] m2s_resp_valid_sync;\n\t// s_to_m_resp_accepted: S domain -> M domain\n\treg [1:0] s2m_resp_accepted_sync;\n\n\t// S domain: synchronizer outputs\n\twire s2m_req_valid_m = s2m_req_valid_sync[1];\n\twire m2s_req_accepted_s = m2s_req_accepted_sync[1];\n\twire m2s_resp_valid_s = m2s_resp_valid_sync[1];\n\twire s2m_resp_accepted_m = s2m_resp_accepted_sync[1];\n\n\t// S domain: synchronizer logic\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts2m_req_valid_sync <= 2'b00;\n\t\t\tm2s_req_accepted_sync <= 2'b00;\n\t\t\tm2s_resp_valid_sync <= 2'b00;\n\t\t\ts2m_resp_accepted_sync <= 2'b00;\n\t\tend else begin\n\t\t\ts2m_req_valid_sync <= {s2m_req_valid_sync[0], s_to_m_req_valid};\n\t\t\tm2s_req_accepted_sync <= {m2s_req_accepted_sync[0], m_to_s_req_accepted};\n\t\t\tm2s_resp_valid_sync <= {m2s_resp_valid_sync[0], m_to_s_resp_valid};\n\t\t\ts2m_resp_accepted_sync <= {s2m_resp_accepted_sync[0], s_to_m_resp_accepted};\n\t\tend\n\tend\n\n\t// M domain: synchronizer logic\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts2m_req_valid_sync <= 2'b00;\n\t\t\tm2s_req_accepted_sync <= 2'b00;\n\t\t\tm2s_resp_valid_sync <= 2'b00;\n\t\t\ts2m_resp_accepted_sync <= 2'b00;\n\t\tend else begin\n\t\t\ts2m_req_valid_sync <= {s2m_req_valid_sync[0], s_to_m_req_valid};\n\t\t\tm2s_req_accepted_sync <= {m2s_req_accepted_sync[0], m_to_s_req_accepted};\n\t\t\tm2s_resp_valid_sync <= {m2s_resp_valid_sync[0], m_to_s_resp_valid};\n\t\t\ts2m_resp_accepted_sync <= {s2m_resp_accepted_sync[0], s_to_m_resp_accepted};\n\t\tend\n\tend\n\n\t// S domain: request capture and handshake\n\t// Detect setup phase: PSEL=1, PENABLE=0\n\twire s_setup_phase = S_APB_PSEL && !S_APB_PENABLE;\n\twire s_access_phase = S_APB_PSEL && S_APB_PENABLE;\n\n\t// S domain: state machine for request side\n\t// States: IDLE, WAIT_M_ACCEPT, WAIT_M_RESP\n\t// We use a simple approach:\n\t// - When in setup phase and not already waiting, capture request and assert s_to_m_req_valid\n\t// - When m2s_req_accepted_s is high, deassert s_to_m_req_valid\n\t// - When m2s_resp_valid_s is high, capture response and assert s_to_m_resp_accepted\n\t// - When s2m_resp_accepted_m is high, deassert s_to_m_resp_accepted and signal S_APB_PREADY\n\n\t// S domain: request valid generation\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_to_m_req_valid <= 1'b0;\n\t\t\ts_to_m_resp_accepted <= 1'b0;\n\t\t\ts_addr <= {AW{1'b0}};\n\t\t\ts_write <= 1'b0;\n\t\t\ts_wdata <= {DW{1'b0}};\n\t\t\ts_wstrb <= {(DW/8){1'b0}};\n\t\t\ts_pprot <= 3'b000;\n\t\t\ts_rdata <= {DW{1'b0}};\n\t\t\ts_rslverr <= 1'b0;\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\tend else begin\n\t\t\t// Default: no ready\n\t\t\tS_APB_PREADY <= 1'b0;\n\n\t\t\t// Request valid: assert when in setup phase and not already valid\n\t\t\tif (s_setup_phase && !s_to_m_req_valid) begin\n\t\t\t\ts_to_m_req_valid <= 1'b1;\n\t\t\t\ts_addr <= S_APB_PADDR;\n\t\t\t\ts_write <= S_APB_PWRITE;\n\t\t\t\ts_wdata <= S_APB_PWDATA;\n\t\t\t\ts_wstrb <= S_APB_PWSTRB;\n\t\t\t\ts_pprot <= S_APB_PPROT;\n\t\t\tend\n\n\t\t\t// Deassert request valid when M accepts\n\t\t\tif (m2s_req_accepted_s) begin\n\t\t\t\ts_to_m_req_valid <= 1'b0;\n\t\t\tend\n\n\t\t\t// Response: when M signals response valid, capture and acknowledge\n\t\t\tif (m2s_resp_valid_s) begin\n\t\t\t\ts_rdata <= M_APB_PRDATA;\n\t\t\t\ts_rslverr <= M_APB_PSLVERR;\n\t\t\t\ts_to_m_resp_accepted <= 1'b1;\n\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\tend\n\n\t\t\t// Deassert response accepted when M acknowledges\n\t\t\tif (s2m_resp_accepted_m) begin\n\t\t\t\ts_to_m_resp_accepted <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// M domain: request acceptance and APB drive\n\t// M domain: state machine\n\t// - When s2m_req_valid_m is high and not already valid, capture request and assert m_to_s_req_accepted\n\t// - Drive M_APB_PSEL and M_APB_PENABLE for setup and access phases\n\t// - When M_APB_PREADY is high during access phase, capture response and assert m_to_s_resp_valid\n\t// - Deassert m_to_s_resp_valid when s2m_resp_accepted_m is high\n\n\t// M domain: APB phase control\n\treg m_setup_phase;\n\treg m_access_phase;\n\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_to_s_req_accepted <= 1'b0;\n\t\t\tm_to_s_resp_valid <= 1'b0;\n\t\t\tm_addr <= {AW{1'b0}};\n\t\t\tm_write <= 1'b0;\n\t\t\tm_wdata <= {DW{1'b0}};\n\t\t\tm_wstrb <= {(DW/8){1'b0}};\n\t\t\tm_pprot <= 3'b000;\n\t\t\tm_setup_phase <= 1'b0;\n\t\t\tm_access_phase <= 1'b0;\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\tend else begin\n\t\t\t// Default: no APB activity\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\tm_setup_phase <= 1'b0;\n\t\t\tm_access_phase <= 1'b0;\n\n\t\t\t// Accept request from S domain\n\t\t\tif (s2m_req_valid_m && !m_to_s_req_accepted) begin\n\t\t\t\tm_to_s_req_accepted <= 1'b1;\n\t\t\t\tm_addr <= s_addr;\n\t\t\t\tm_write <= s_write;\n\t\t\t\tm_wdata <= s_wdata;\n\t\t\t\tm_wstrb <= s_wstrb;\n\t\t\t\tm_pprot <= s_pprot;\n\t\t\t\t// Start setup phase\n\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\tm_setup_phase <= 1'b1;\n\t\t\tend\n\n\t\t\t// Deassert request accepted when S acknowledges\n\t\t\tif (s2m_resp_accepted_m) begin\n\t\t\t\tm_to_s_req_accepted <= 1'b0;\n\t\t\tend\n\n\t\t\t// Transition from setup to access phase\n\t\t\tif (m_setup_phase) begin\n\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\tm_setup_phase <= 1'b0;\n\t\t\t\tm_access_phase <= 1'b1;\n\t\t\tend\n\n\t\t\t// Access phase: wait for M_APB_PREADY\n\t\t\tif (m_access_phase) begin\n\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t// Transfer complete\n\t\t\t\t\tm_access_phase <= 1'b0;\n\t\t\t\t\tm_to_s_resp_valid <= 1'b1;\n\t\t\t\tend\n\t\t\tend\n\n\t\t\t// Deassert response valid when S acknowledges\n\t\t\tif (s2m_resp_accepted_m) begin\n\t\t\t\tm_to_s_resp_valid <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// M domain: output assignments\n\tassign M_APB_PADDR = m_addr;\n\tassign M_APB_PWRITE = m_write;\n\tassign M_APB_PWDATA = m_wdata;\n\tassign M_APB_PWSTRB = m_wstrb;\n\tassign M_APB_PPROT = m_pprot;\n\n\t// S domain: output assignments\n\tassign S_APB_PRDATA = s_rdata;\n\tassign S_APB_PSLVERR = s_rslverr;\n\nendmodule\n```<|im_end|>",
