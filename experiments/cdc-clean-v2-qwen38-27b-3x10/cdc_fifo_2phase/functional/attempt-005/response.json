  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Gray code conversion functions\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_WIDTH-1:0] gray2bin;\n        input [PTR_WIDTH-1:0] gray;\n        reg [PTR_WIDTH-1:0] bin;\n        begin\n            bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source domain\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_gray;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_gray_sync1;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_gray_sync2;\n\n    wire [PTR_WIDTH-1:0] src_wr_ptr_gray;\n    wire [PTR_WIDTH-1:0] src_rd_ptr_bin;\n    wire [PTR_WIDTH-1:0] dst_rd_ptr_bin;\n    wire src_full;\n    wire src_empty;\n\n    // Destination domain\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [PTR_WIDTH-1:0] src_wr_ptr_gray_sync1;\n    reg [PTR_WIDTH-1:0] src_wr_ptr_gray_sync2;\n\n    wire [PTR_WIDTH-1:0] dst_rd_ptr_gray;\n    wire [PTR_WIDTH-1:0] dst_wr_ptr_bin;\n    wire dst_full;\n    wire dst_empty;\n\n    // Source domain logic\n    assign src_wr_ptr_gray = bin2gray(src_wr_ptr);\n    assign src_rd_ptr_bin = gray2bin(src_rd_ptr_gray);\n    assign dst_rd_ptr_bin = gray2bin(dst_rd_ptr_gray_sync2);\n\n    assign src_full = (src_wr_ptr_gray[PTR_WIDTH-1] != dst_rd_ptr_gray_sync2[PTR_WIDTH-1]) &&\n                      (src_wr_ptr_gray[PTR_WIDTH-2:0] == dst_rd_ptr_gray_sync2[PTR_WIDTH-2:0]);\n    assign src_empty = (src_wr_ptr_gray == dst_rd_ptr_gray_sync2);\n\n    assign src_ready_o = ~src_full;\n\n    // Write to memory in source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (src_valid_i && src_ready_o) begin\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n        end\n    end\n\n    // Synchronize destination read pointer gray to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_rd_ptr_gray_sync1 <= dst_rd_ptr_gray;\n            dst_rd_ptr_gray_sync2 <= dst_rd_ptr_gray_sync1;\n        end\n    end\n\n    // Destination domain logic\n    assign dst_rd_ptr_gray = bin2gray(dst_rd_ptr);\n    assign dst_wr_ptr_bin = gray2bin(src_wr_ptr_gray_sync2);\n\n    assign dst_full = (dst_rd_ptr_gray[PTR_WIDTH-1] != src_wr_ptr_gray_sync2[PTR_WIDTH-1]) &&\n                      (dst_rd_ptr_gray[PTR_WIDTH-2:0] == src_wr_ptr_gray_sync2[PTR_WIDTH-2:0]);\n    assign dst_empty = (dst_rd_ptr_gray == src_wr_ptr_gray_sync2);\n\n    // Read from memory in destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_valid_reg && dst_ready_i) begin\n                // Handshake complete, advance read pointer\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                // Check if there's more data to present\n                if (dst_rd_ptr_gray != src_wr_ptr_gray_sync2) begin\n                    dst_data_reg <= mem[(dst_rd_ptr + 1'b1)[LOG_DEPTH-1:0]];\n                    dst_valid_reg <= 1'b1;\n                end else begin\n                    dst_valid_reg <= 1'b0;\n                end\n            end else if (!dst_valid_reg && !dst_empty) begin\n                // No valid data currently, but FIFO has data\n                dst_data_reg <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n                dst_valid_reg <= 1'b1;\n            end\n        end\n    end\n\n    // Synchronize source write pointer gray to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            src_wr_ptr_gray_sync1 <= src_wr_ptr_gray;\n            src_wr_ptr_gray_sync2 <= src_wr_ptr_gray_sync1;\n        end\n    end\n\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
