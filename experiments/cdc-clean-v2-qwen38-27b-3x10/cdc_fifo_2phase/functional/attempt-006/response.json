  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_src;\n\n    // Destination domain\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_dst;\n    reg [PTR_WIDTH-1:0] src_wr_ptr_dst;\n\n    // Gray code pointers\n    wire [PTR_WIDTH-1:0] src_wr_ptr_gray = src_wr_ptr ^ (src_wr_ptr >> 1);\n    wire [PTR_WIDTH-1:0] dst_rd_ptr_gray = dst_rd_ptr_src ^ (dst_rd_ptr_src >> 1);\n    wire [PTR_WIDTH-1:0] dst_wr_ptr_gray = dst_wr_ptr_dst ^ (dst_wr_ptr_dst >> 1);\n    wire [PTR_WIDTH-1:0] src_wr_ptr_gray_dst = src_wr_ptr_dst ^ (src_wr_ptr_dst >> 1);\n\n    // Synchronizers\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_gray_sync1, dst_rd_ptr_gray_sync2;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_gray_sync1, dst_wr_ptr_gray_sync2;\n\n    // Source domain: synchronize dst_rd_ptr_gray\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_rd_ptr_gray_sync1 <= dst_rd_ptr_gray;\n            dst_rd_ptr_gray_sync2 <= dst_rd_ptr_gray_sync1;\n        end\n    end\n\n    // Destination domain: synchronize src_wr_ptr_gray\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            src_wr_ptr_gray_sync1 <= src_wr_ptr_gray;\n            src_wr_ptr_gray_sync2 <= src_wr_ptr_gray_sync1;\n        end\n    end\n\n    // Convert gray to binary\n    function [PTR_WIDTH-1:0] gray_to_bin;\n        input [PTR_WIDTH-1:0] gray;\n        integer i;\n        begin\n            gray_to_bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                gray_to_bin[i] = gray_to_bin[i+1] ^ gray[i];\n        end\n    endfunction\n\n    wire [PTR_WIDTH-1:0] dst_rd_ptr_bin_src = gray_to_bin(dst_rd_ptr_gray_sync2);\n    wire [PTR_WIDTH-1:0] src_wr_ptr_bin_dst = gray_to_bin(src_wr_ptr_gray_sync2);\n\n    // Source domain: write logic\n    wire src_full = (src_wr_ptr[PTR_WIDTH-1] != dst_rd_ptr_bin_src[PTR_WIDTH-1]) &&\n                    (src_wr_ptr[PTR_WIDTH-2:0] == dst_rd_ptr_bin_src[PTR_WIDTH-2:0]);\n    wire src_can_write = src_valid_i && !src_full;\n\n    assign src_ready_o = !src_full;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_src <= {PTR_WIDTH{1'b0}};\n        end else begin\n            if (src_can_write) begin\n                mem[src_wr_ptr[PTR_WIDTH-2:0]] <= src_data_i;\n                src_wr_ptr <= src_wr_ptr + 1'b1;\n            end\n            if (dst_valid_reg && dst_ready_i) begin\n                dst_rd_ptr_src <= dst_rd_ptr_src + 1'b1;\n            end\n        end\n    end\n\n    // Destination domain: read logic\n    wire dst_empty = (dst_wr_ptr_dst == src_wr_ptr_bin_dst);\n    wire dst_can_read = dst_valid_reg && dst_ready_i;\n\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_wr_ptr_dst <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_dst <= {PTR_WIDTH{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            // Update synchronized write pointer\n            src_wr_ptr_dst <= src_wr_ptr_gray_sync2;\n\n            // Read from memory if not empty and valid is low\n            if (!dst_valid_reg && !dst_empty) begin\n                dst_data_reg <= mem[dst_wr_ptr_dst[PTR_WIDTH-2:0]];\n                dst_valid_reg <= 1'b1;\n                dst_wr_ptr_dst <= dst_wr_ptr_dst + 1'b1;\n            end\n\n            // Clear valid when ready\n            if (dst_valid_reg && dst_ready_i) begin\n                dst_valid_reg <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
