  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n\n    // Source domain: write pointer and FIFO storage\n    reg [PTR_W-1:0] wr_ptr;\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Destination domain: read pointer\n    reg [PTR_W-1:0] rd_ptr;\n\n    // Synchronization of write pointer to destination domain\n    reg [PTR_W-1:0] wr_ptr_sync1, wr_ptr_sync2;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            wr_ptr_sync1 <= {PTR_W{1'b0}};\n            wr_ptr_sync2 <= {PTR_W{1'b0}};\n        end else begin\n            wr_ptr_sync1 <= wr_ptr;\n            wr_ptr_sync2 <= wr_ptr_sync1;\n        end\n    end\n\n    // Synchronization of read pointer to source domain\n    reg [PTR_W-1:0] rd_ptr_sync1, rd_ptr_sync2;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            rd_ptr_sync1 <= {PTR_W{1'b0}};\n            rd_ptr_sync2 <= {PTR_W{1'b0}};\n        end else begin\n            rd_ptr_sync1 <= rd_ptr;\n            rd_ptr_sync2 <= rd_ptr_sync1;\n        end\n    end\n\n    // Source domain: write logic\n    wire src_wr_en = src_valid_i & src_ready_o;\n    wire [PTR_W-1:0] wr_ptr_next = wr_ptr + 1'b1;\n    wire [PTR_W-1:0] rd_ptr_src = rd_ptr_sync2;\n    wire src_full = (wr_ptr_next == rd_ptr_src);\n    assign src_ready_o = !src_full;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            wr_ptr <= {PTR_W{1'b0}};\n        end else if (src_wr_en) begin\n            mem[wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n            wr_ptr <= wr_ptr_next;\n        end\n    end\n\n    // Destination domain: read logic\n    wire [PTR_W-1:0] wr_ptr_dst = wr_ptr_sync2;\n    wire [PTR_W-1:0] rd_ptr_next = rd_ptr + 1'b1;\n    wire dst_empty = (rd_ptr == wr_ptr_dst);\n    wire dst_rd_en = dst_valid_o & dst_ready_i;\n\n    // Two-stage pipeline for destination output\n    reg [WIDTH-1:0] data_pipe1, data_pipe2;\n    reg             valid_pipe1, valid_pipe2;\n\n    // Stage 1: read from memory\n    wire [WIDTH-1:0] mem_rd_data = mem[rd_ptr[LOG_DEPTH-1:0]];\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            rd_ptr <= {PTR_W{1'b0}};\n            data_pipe1 <= {WIDTH{1'b0}};\n            valid_pipe1 <= 1'b0;\n            data_pipe2 <= {WIDTH{1'b0}};\n            valid_pipe2 <= 1'b0;\n        end else begin\n            // Advance read pointer when we consume from stage 2\n            if (dst_rd_en) begin\n                rd_ptr <= rd_ptr_next;\n            end\n\n            // Stage 1: load from memory when not empty and stage 2 is ready to accept\n            // We load stage 1 when the FIFO is not empty.\n            // Stage 2 accepts from stage 1 when stage 2 is not valid or is being consumed.\n            if (!dst_empty) begin\n                data_pipe1 <= mem_rd_data;\n                valid_pipe1 <= 1'b1;\n            end else begin\n                valid_pipe1 <= 1'b0;\n            end\n\n            // Stage 2: accept from stage 1\n            if (valid_pipe1) begin\n                data_pipe2 <= data_pipe1;\n                valid_pipe2 <= 1'b1;\n            end else begin\n                valid_pipe2 <= 1'b0;\n            end\n        end\n    end\n\n    assign dst_data_o = data_pipe2;\n    assign dst_valid_o = valid_pipe2;\n\nendmodule\n```<|im_end|>",
