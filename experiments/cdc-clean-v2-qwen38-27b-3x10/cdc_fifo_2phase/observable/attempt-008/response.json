  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n\n    // Source domain registers\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [PTR_W-1:0] dst_rd_ptr_src; // dst read pointer synchronized to src domain\n\n    // Destination domain registers\n    reg [WIDTH-1:0] dst_data_reg;\n    reg             dst_valid_reg;\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [PTR_W-1:0] src_wr_ptr_dst; // src write pointer synchronized to dst domain\n\n    // Synchronizer registers\n    reg [PTR_W-1:0] src_wr_ptr_sync1, src_wr_ptr_sync2;\n    reg [PTR_W-1:0] dst_rd_ptr_sync1, dst_rd_ptr_sync2;\n\n    // Synchronize src_wr_ptr to dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_sync1 <= {PTR_W{1'b0}};\n            src_wr_ptr_sync2 <= {PTR_W{1'b0}};\n        end else begin\n            src_wr_ptr_sync1 <= src_wr_ptr;\n            src_wr_ptr_sync2 <= src_wr_ptr_sync1;\n        end\n    end\n\n    // Synchronize dst_rd_ptr to src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_sync1 <= {PTR_W{1'b0}};\n            dst_rd_ptr_sync2 <= {PTR_W{1'b0}};\n        end else begin\n            dst_rd_ptr_sync1 <= dst_rd_ptr;\n            dst_rd_ptr_sync2 <= dst_rd_ptr_sync1;\n        end\n    end\n\n    // Compute full/empty conditions\n    wire src_full;\n    wire dst_empty;\n\n    // Full: write pointer has lapped read pointer by DEPTH\n    // In Gray code or binary, we compare the upper bit and the lower LOG_DEPTH bits\n    // For binary pointers with PTR_W = LOG_DEPTH+1:\n    // full when src_wr_ptr[LOG_DEPTH] != dst_rd_ptr_src[LOG_DEPTH] && src_wr_ptr[LOG_DEPTH-1:0] == dst_rd_ptr_src[LOG_DEPTH-1:0]\n    assign src_full = (src_wr_ptr[LOG_DEPTH] != dst_rd_ptr_src[LOG_DEPTH]) &&\n                      (src_wr_ptr[LOG_DEPTH-1:0] == dst_rd_ptr_src[LOG_DEPTH-1:0]);\n\n    // Empty: write pointer equals read pointer\n    assign dst_empty = (src_wr_ptr_dst == dst_rd_ptr);\n\n    // Source ready: not full\n    assign src_ready_o = ~src_full;\n\n    // Write to memory in source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n        end else if (src_valid_i && src_ready_o) begin\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n        end\n    end\n\n    // Destination domain: read from memory and present data\n    // dst_valid_reg indicates there is data available to be consumed\n    // We use a simple approach: dst_valid_reg is set when we read from memory\n    // and cleared when dst_ready_i is asserted.\n\n    // Read pointer and data register in destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_valid_reg && dst_ready_i) begin\n                // Data is consumed, clear valid\n                dst_valid_reg <= 1'b0;\n            end\n            if (!dst_valid_reg && !dst_empty) begin\n                // Load next word from memory\n                dst_data_reg <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                dst_valid_reg <= 1'b1;\n            end\n        end\n    end\n\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
