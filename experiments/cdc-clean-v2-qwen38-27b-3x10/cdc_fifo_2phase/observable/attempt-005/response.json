{
  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n\n    // Source domain registers\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [PTR_W-1:0] dst_rd_ptr_src; // dst read pointer synchronized to src domain\n\n    // Destination domain registers\n    reg [WIDTH-1:0] dst_data_reg;\n    reg             dst_valid_reg;\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [PTR_W-1:0] src_wr_ptr_dst; // src write pointer synchronized to dst domain\n\n    // Synchronization registers\n    reg [PTR_W-1:0] src_wr_ptr_sync1, src_wr_ptr_sync2;\n    reg [PTR_W-1:0] dst_rd_ptr_sync1, dst_rd_ptr_sync2;\n\n    // Synchronize src_wr_ptr to dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_sync1 <= {PTR_W{1'b0}};\n            src_wr_ptr_sync2 <= {PTR_W{1'b0}};\n        end else begin\n            src_wr_ptr_sync1 <= src_wr_ptr;\n            src_wr_ptr_sync2 <= src_wr_ptr_sync1;\n        end\n    end\n\n    // Synchronize dst_rd_ptr to src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_sync1 <= {PTR_W{1'b0}};\n            dst_rd_ptr_sync2 <= {PTR_W{1'b0}};\n        end else begin\n            dst_rd_ptr_sync1 <= dst_rd_ptr;\n            dst_rd_ptr_sync2 <= dst_rd_ptr_sync1;\n        end\n    end\n\n    // Compute full/empty conditions\n    wire [PTR_W-1:0] src_wr_ptr_dst_sync = src_wr_ptr_sync2;\n    wire [PTR_W-1:0] dst_rd_ptr_src_sync = dst_rd_ptr_sync2;\n\n    // FIFO full: write pointer has lapped read pointer by DEPTH\n    wire src_full = (src_wr_ptr == dst_rd_ptr_src_sync) && \n                    (src_wr_ptr[PTR_W-1] != dst_rd_ptr_src_sync[PTR_W-1]);\n    // Actually, for a FIFO with DEPTH entries, full when:\n    // src_wr_ptr == dst_rd_ptr_src_sync and the MSB differs\n    // Let me reconsider: with PTR_W = LOG_DEPTH+1, the FIFO is full when\n    // src_wr_ptr == dst_rd_ptr_src_sync and the top bit differs.\n    // But actually the standard approach: full when (src_wr_ptr - dst_rd_ptr_src_sync) == DEPTH\n    // Since we're using binary pointers with an extra bit, full when:\n    // src_wr_ptr[LOG_DEPTH] != dst_rd_ptr_src_sync[LOG_DEPTH] and \n    // src_wr_ptr[LOG_DEPTH-1:0] == dst_rd_ptr_src_sync[LOG_DEPTH-1:0]\n\n    wire src_full_correct = (src_wr_ptr[LOG_DEPTH] != dst_rd_ptr_src_sync[LOG_DEPTH]) && \n                            (src_wr_ptr[LOG_DEPTH-1:0] == dst_rd_ptr_src_sync[LOG_DEPTH-1:0]);\n\n    // FIFO empty: write pointer equals read pointer\n    wire dst_empty = (src_wr_ptr_dst_sync == dst_rd_ptr);\n\n    // Source ready: not full\n    assign src_ready_o = !src_full_correct;\n\n    // Write to memory in source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n        end else if (src_valid_i && src_ready_o) begin\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n        end\n    end\n\n    // Destination domain: read from memory and present data\n    // dst_valid_reg indicates there is data available\n    // We read from memory when dst_valid_reg is high and dst_ready_i is high\n    // After reading, we advance dst_rd_ptr\n\n    // The data to present is from the memory at dst_rd_ptr\n    // We need to register the data output\n\n    // Let's use a simple approach:\n    // dst_valid_reg is high when there's data in the FIFO\n    // When dst_valid_reg && dst_ready_i, we consume the data\n    // dst_data_o is the registered sample of the data at dst_rd_ptr\n\n    // Read data from memory (combinational)\n    wire [WIDTH-1:0] mem_data = mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n\n    // Register the data output\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n            dst_rd_ptr <= {PTR_W{1'b0}};\n        end else begin\n            if (dst_valid_reg && dst_ready_i) begin\n                // Consume current data, advance read pointer\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                // Check if there's more data\n                if (dst_empty) begin\n                    dst_valid_reg <= 1'b0;\n                end else begin\n                    dst_valid_reg <= 1'b1;\n                    dst_data_reg <= mem[(dst_rd_ptr + 1'b1)[LOG_DEPTH-1:0]];\n                end\n            end else if (!dst_valid_reg && !dst_empty) begin\n                // New data available, load it\n                dst_valid_reg <= 1'b1;\n                dst_data_reg <= mem_data;\n            end\n        end\n    end\n\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
