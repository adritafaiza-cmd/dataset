  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Source domain registers\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_src;\n\n    // Destination domain registers\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [PTR_WIDTH-1:0] src_wr_ptr_dst;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Gray code pointers\n    wire [PTR_WIDTH-1:0] src_wr_ptr_gray;\n    wire [PTR_WIDTH-1:0] dst_rd_ptr_gray;\n\n    // Synchronizers\n    reg [PTR_WIDTH-1:0] src_wr_ptr_gray_sync1, src_wr_ptr_gray_sync2;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_gray_sync1, dst_rd_ptr_gray_sync2;\n\n    // Full and empty flags\n    wire src_full;\n    wire dst_empty;\n\n    // Source ready\n    assign src_ready_o = ~src_full;\n\n    // Destination outputs\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\n    // Gray code conversion\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    assign src_wr_ptr_gray = bin2gray(src_wr_ptr);\n    assign dst_rd_ptr_gray = bin2gray(dst_rd_ptr);\n\n    // Full condition: write pointer gray equals read pointer gray with MSB different\n    // In binary: full when src_wr_ptr[MSB] != dst_rd_ptr_src[MSB] and src_wr_ptr[MSB-1:0] == dst_rd_ptr_src[MSB-1:0]\n    assign src_full = (src_wr_ptr[PTR_WIDTH-1] != dst_rd_ptr_src[PTR_WIDTH-1]) && \n                      (src_wr_ptr[PTR_WIDTH-2:0] == dst_rd_ptr_src[PTR_WIDTH-2:0]);\n\n    // Empty condition: read pointer gray equals write pointer gray\n    assign dst_empty = (dst_rd_ptr == src_wr_ptr_dst);\n\n    // Source clock domain: write to memory\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_src <= {PTR_WIDTH{1'b0}};\n        end else begin\n            if (src_valid_i && src_ready_o) begin\n                mem[src_wr_ptr[PTR_WIDTH-2:0]] <= src_data_i;\n                src_wr_ptr <= src_wr_ptr + 1'b1;\n            end\n        end\n    end\n\n    // Synchronize src_wr_ptr_gray to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            src_wr_ptr_gray_sync1 <= src_wr_ptr_gray;\n            src_wr_ptr_gray_sync2 <= src_wr_ptr_gray_sync1;\n        end\n    end\n\n    // Convert synchronized gray code back to binary in destination domain\n    reg [PTR_WIDTH-1:0] src_wr_ptr_dst;\n    always @(*) begin\n        src_wr_ptr_dst = src_wr_ptr_gray_sync2;\n        // Gray to binary conversion\n        begin : gray2bin\n            integer i;\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1) begin\n                src_wr_ptr_dst[i] = src_wr_ptr_dst[i+1] ^ src_wr_ptr_gray_sync2[i];\n            end\n        end\n    end\n\n    // Synchronize dst_rd_ptr_gray to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_rd_ptr_gray_sync1 <= dst_rd_ptr_gray;\n            dst_rd_ptr_gray_sync2 <= dst_rd_ptr_gray_sync1;\n        end\n    end\n\n    // Convert synchronized gray code back to binary in source domain\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_src_calc;\n    always @(*) begin\n        dst_rd_ptr_src_calc = dst_rd_ptr_gray_sync2;\n        begin : gray2bin_src\n            integer i;\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1) begin\n                dst_rd_ptr_src_calc[i] = dst_rd_ptr_src_calc[i+1] ^ dst_rd_ptr_gray_sync2[i];\n            end\n        end\n    end\n\n    // Update dst_rd_ptr_src in source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_src <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_rd_ptr_src <= dst_rd_ptr_src_calc;\n        end\n    end\n\n    // Destination clock domain: read from memory\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_valid_reg && dst_ready_i) begin\n                // Current data is being consumed, prepare next\n                if (!dst_empty) begin\n                    dst_data_reg <= mem[dst_rd_ptr[PTR_WIDTH-2:0]];\n                    dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                    dst_valid_reg <= 1'b1;\n                end else begin\n                    dst_valid_reg <= 1'b0;\n                end\n            end else if (!dst_valid_reg && !dst_empty) begin\n                // No valid data, load next\n                dst_data_reg <= mem[dst_rd_ptr[PTR_WIDTH-2:0]];\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                dst_valid_reg <= 1'b1;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
