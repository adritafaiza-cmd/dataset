{
  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH;\n    localparam FULL_THRESH = DEPTH - 1;\n\n    // Source domain registers\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [PTR_W-1:0] dst_rd_ptr_src; // dst read pointer synchronized to src domain\n\n    // Destination domain registers\n    reg [WIDTH-1:0] dst_data_reg;\n    reg             dst_valid_reg;\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [PTR_W-1:0] src_wr_ptr_dst; // src write pointer synchronized to dst domain\n\n    // Synchronization registers\n    reg [PTR_W-1:0] src_wr_ptr_sync1, src_wr_ptr_sync2;\n    reg [PTR_W-1:0] dst_rd_ptr_sync1, dst_rd_ptr_sync2;\n\n    // Synchronize src_wr_ptr to dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_sync1 <= {PTR_W{1'b0}};\n            src_wr_ptr_sync2 <= {PTR_W{1'b0}};\n        end else begin\n            src_wr_ptr_sync1 <= src_wr_ptr;\n            src_wr_ptr_sync2 <= src_wr_ptr_sync1;\n        end\n    end\n\n    // Synchronize dst_rd_ptr to src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_sync1 <= {PTR_W{1'b0}};\n            dst_rd_ptr_sync2 <= {PTR_W{1'b0}};\n        end else begin\n            dst_rd_ptr_sync1 <= dst_rd_ptr;\n            dst_rd_ptr_sync2 <= dst_rd_ptr_sync1;\n        end\n    end\n\n    // Compute full/empty in respective domains\n    wire [PTR_W:0] src_wr_ptr_ext = {1'b0, src_wr_ptr};\n    wire [PTR_W:0] dst_rd_ptr_src_ext = {1'b0, dst_rd_ptr_src};\n    wire [PTR_W:0] src_wr_ptr_dst_ext = {1'b0, src_wr_ptr_dst};\n    wire [PTR_W:0] dst_rd_ptr_ext = {1'b0, dst_rd_ptr};\n\n    // In src domain: full when (src_wr_ptr - dst_rd_ptr_src) == DEPTH\n    // We use the synchronized dst_rd_ptr (dst_rd_ptr_src)\n    wire [PTR_W:0] src_count = src_wr_ptr_ext - dst_rd_ptr_src_ext;\n    wire src_full = (src_count == DEPTH);\n\n    // In dst domain: empty when (src_wr_ptr_dst - dst_rd_ptr) == 0\n    wire [PTR_W:0] dst_count = src_wr_ptr_dst_ext - dst_rd_ptr_ext;\n    wire dst_empty = (dst_count == 0);\n\n    // Source side: write to memory\n    wire src_write = src_valid_i & ~src_full;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n        end else if (src_write) begin\n            mem[src_wr_ptr] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n        end\n    end\n\n    // Destination side: read from memory\n    wire dst_read = dst_valid_reg & dst_ready_i;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_read) begin\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                dst_valid_reg <= 1'b0;\n            end\n            if (!dst_empty && !dst_valid_reg) begin\n                dst_data_reg <= mem[dst_rd_ptr];\n                dst_valid_reg <= 1'b1;\n            end\n        end\n    end\n\n    // Outputs\n    assign src_ready_o = ~src_full;\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
