nput  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Total data width for storage\n    localparam TOTAL_DATA_WIDTH = DATA_WIDTH + \n                                  (KEEP_ENABLE ? KEEP_WIDTH : 0) +\n                                  (LAST_ENABLE ? 1 : 0) +\n                                  (ID_ENABLE ? ID_WIDTH : 0) +\n                                  (DEST_ENABLE ? DEST_WIDTH : 0) +\n                                  (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Internal signals\n    reg [TOTAL_DATA_WIDTH-1:0] mem [0:DEPTH-1];\n    \n    // Write pointer (source clock domain)\n    reg [PTR_WIDTH-1:0] w_ptr;\n    // Read pointer (master clock domain)\n    reg [PTR_WIDTH-1:0] r_ptr;\n    \n    // Gray code pointers for CDC\n    reg [PTR_WIDTH-1:0] w_ptr_gray;\n    reg [PTR_WIDTH-1:0] r_ptr_gray;\n    \n    // Synchronizers\n    reg [PTR_WIDTH-1:0] w_ptr_gray_sync1, w_ptr_gray_sync2;\n    reg [PTR_WIDTH-1:0] r_ptr_gray_sync1, r_ptr_gray_sync2;\n    \n    // Binary pointers from gray code\n    reg [PTR_WIDTH-1:0] w_ptr_bin_sync;\n    reg [PTR_WIDTH-1:0] r_ptr_bin_sync;\n    \n    // Status flags\n    reg s_overflow;\n    reg m_overflow;\n    reg s_bad_frame;\n    reg m_bad_frame;\n    reg s_good_frame;\n    reg m_good_frame;\n    \n    // Pause signals\n    reg s_pause_active;\n    reg m_pause_active;\n    \n    // Frame tracking\n    reg in_frame;\n    reg frame_overflow;\n    \n    // Helper functions\n    function [PTR_WIDTH-1:0] gray_to_bin;\n        input [PTR_WIDTH-1:0] gray;\n        integer i;\n        begin\n            gray_to_bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                gray_to_bin[i] = gray_to_bin[i+1] ^ gray[i];\n        end\n    endfunction\n    \n    function [PTR_WIDTH-1:0] bin_to_gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin_to_gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Write data assembly\n    wire [TOTAL_DATA_WIDTH-1:0] w_data;\n    assign w_data = {\n        (USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}}),\n        (DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}}),\n        (ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}}),\n        (LAST_ENABLE ? s_axis_tlast : 1'b0),\n        (KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}}),\n        s_axis_tdata\n    };\n\n    // Read data extraction\n    wire [TOTAL_DATA_WIDTH-1:0] r_data;\n    wire [DATA_WIDTH-1:0] r_tdata;\n    wire [KEEP_WIDTH-1:0] r_tkeep;\n    wire r_tlast;\n    wire [ID_WIDTH-1:0] r_tid;\n    wire [DEST_WIDTH-1:0] r_tdest;\n    wire [USER_WIDTH-1:0] r_tuser;\n\n    assign r_tdata = r_data[DATA_WIDTH-1:0];\n    assign r_tkeep = KEEP_ENABLE ? r_data[DATA_WIDTH + KEEP_WIDTH-1:DATA_WIDTH] : {KEEP_WIDTH{1'b0}};\n    assign r_tlast = LAST_ENABLE ? r_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0)] : 1'b0;\n    assign r_tid = ID_ENABLE ? r_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + ID_WIDTH-1 : DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0)] : {ID_WIDTH{1'b0}};\n    assign r_tdest = DEST_ENABLE ? r_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) + DEST_WIDTH-1 : DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0)] : {DEST_WIDTH{1'b0}};\n    assign r_tuser = USER_ENABLE ? r_data[TOTAL_DATA_WIDTH-1:DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) + (DEST_ENABLE ? DEST_WIDTH : 0)] : {USER_WIDTH{1'b0}};\n\n    // Depth calculation\n    wire [PTR_WIDTH-1:0] w_ptr_bin_m;\n    wire [PTR_WIDTH-1:0] r_ptr_bin_s;\n    wire [PTR_WIDTH-1:0] depth_s;\n    wire [PTR_WIDTH-1:0] depth_m;\n    \n    assign w_ptr_bin_m = gray_to_bin(w_ptr_gray_sync2);\n    assign r_ptr_bin_s = gray_to_bin(r_ptr_gray_sync2);\n    \n    assign depth_s = w_ptr - r_ptr_bin_s;\n    assign depth_m = w_ptr_bin_m - r_ptr;\n\n    // Full and empty conditions\n    wire s_full;\n    wire m_empty;\n    wire s_empty;\n    wire m_full;\n    \n    assign s_full = (w_ptr[PTR_WIDTH-1] == r_ptr_bin_s[PTR_WIDTH-1]) && \n                    (w_ptr[ADDR_WIDTH-1:0] == r_ptr_bin_s[ADDR_WIDTH-1:0]) &&\n                    (w_ptr[PTR_WIDTH-1] != r_ptr_bin_s[PTR_WIDTH-1]) ||\n                    (w_ptr == r_ptr_bin_s + DEPTH);\n    \n    // Simpler full check: full when write pointer has lapped read pointer by DEPTH\n    assign s_full = (w_ptr - r_ptr_bin_s) == DEPTH;\n    assign m_empty = (w_ptr_bin_m - r_ptr) == 0;\n    assign s_empty = (w_ptr - r_ptr_bin_s) == 0;\n    assign m_full = (w_ptr_bin_m - r_ptr) == DEPTH;\n\n    // Write enable\n    wire s_write_en;\n    assign s_write_en = s_axis_tvalid && s_axis_tready && !s_pause_active;\n\n    // Read enable\n    wire m_read_en;\n    assign m_read_en = m_axis_tvalid && m_axis_tready && !m_pause_active;\n\n    // Source clock domain\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_ptr <= {PTR_WIDTH{1'b0}};\n            w_ptr_gray <= {PTR_WIDTH{1'b0}};\n            s_overflow <= 1'b0;\n            s_bad_frame <= 1'b0;\n            s_good_frame <= 1'b0;\n            s_pause_active <= 1'b0;\n            in_frame <= 1'b0;\n            frame_overflow <= 1'b0;\n        end else begin\n            // Update write pointer\n            if (s_write_en) begin\n                w_ptr <= w_ptr + 1'b1;\n            end\n            \n            // Update gray code\n            w_ptr_gray <= bin_to_gray(w_ptr);\n            \n            // Overflow detection\n            if (s_write_en && s_full) begin\n                s_overflow <= 1'b1;\n            end\n            \n            // Frame tracking\n            if (s_write_en) begin\n                if (s_axis_tlast) begin\n                    if (in_frame) begin\n                        s_good_frame <= 1'b1;\n                    end\n                    in_frame <= 1'b0;\n                end else begin\n                    in_frame <= 1'b1;\n                end\n            end\n            \n            // Pause handling\n            if (PAUSE_ENABLE) begin\n                if (s_pause_req) begin\n                    s_pause_active <= 1'b1;\n                end else if (s_empty) begin\n                    s_pause_active <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // Write to memory\n    always @(posedge s_clk) begin\n        if (s_write_en) begin\n            mem[w_ptr[ADDR_WIDTH-1:0]] <= w_data;\n        end\n    end\n\n    // Synchronize write pointer gray code to master clock\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            w_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            w_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            w_ptr_gray_sync1 <= w_ptr_gray;\n            w_ptr_gray_sync2 <= w_ptr_gray_sync1;\n        end\n    end\n\n    // Synchronize read pointer gray code to source clock\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            r_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            r_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            r_ptr_gray_sync1 <= r_ptr_gray;\n            r_ptr_gray_sync2 <= r_ptr_gray_sync1;\n        end\n    end\n\n    // Master clock domain\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr <= {PTR_WIDTH{1'b0}};\n            r_ptr_gray <= {PTR_WIDTH{1'b0}};\n            m_overflow <= 1'b0;\n            m_bad_frame <= 1'b0;\n            m_good_frame <= 1'b0;\n            m_pause_active <= 1'b0;\n        end else begin\n            // Update read pointer\n            if (m_read_en) begin\n                r_ptr <= r_ptr + 1'b1;\n            end\n            \n            // Update gray code\n            r_ptr_gray <= bin_to_gray(r_ptr);\n            \n            // Pause handling\n            if (PAUSE_ENABLE) begin\n                if (m_pause_req) begin\n                    m_pause_active <= 1'b1;\n                end else if (m_empty) begin\n                    m_pause_active <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // Read from memory\n    reg [TOTAL_DATA_WIDTH-1:0] r_data_reg;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_data_reg <= {TOTAL_DATA_WIDTH{1'b0}};\n        end else begin\n            r_data_reg <= mem[r_ptr[ADDR_WIDTH-1:0]];\n        end\n    end\n\n    assign r_data = r_data_reg;\n\n    // Output valid\n    assign m_axis_tvalid = !m_empty && !m_pause_active;\n\n    // Output data\n    assign m_axis_tdata = r_tdata;\n    assign m_axis_tkeep = r_tkeep;\n    assign m_axis_tlast = r_tlast;\n    assign m_axis_tid = r_tid;\n    assign m_axis_tdest = r_tdest;\n    assign m_axis_tuser = r_tuser;\n\n    // Input ready\n    wire s_ready_base;\n    assign s_ready_base = !s_full && !s_pause_active;\n    \n    // Drop/mark when full logic\n    wire s_ready_final;\n    if (DROP_WHEN_FULL) begin\n        assign s_ready_final = 1'b1;\n    end else if (MARK_WHEN_FULL) begin\n        assign s_ready_final = s_ready_base;\n    end else begin\n        assign s_ready_final = s_ready_base;\n    end\n    \n    assign s_axis_tready = s_ready_final;\n\n    // Pause ack\n    assign s_pause_ack = s_pause_active;\n    assign m_pause_ack = m_pause_active;\n\n    // Status depth\n    assign s_status_depth = depth_s[ADDR_WIDTH:0];\n    assign m_status_depth = depth_m[ADDR_WIDTH:0];\n    \n    // Depth commit (simplified - use current depth)\n    assign s_status_depth_commit = depth_s[ADDR_WIDTH:0];\n    assign m_status_depth_commit = depth_m[ADDR_WIDTH:0];\n\n    // Status flags\n    assign s_status_overflow = s_overflow;\n    assign m_status_overflow = m_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign m_status_bad_frame = m_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n    assign m_status_good_frame = m_good_frame;\n\nendmodule\n```<|im_end|>",
