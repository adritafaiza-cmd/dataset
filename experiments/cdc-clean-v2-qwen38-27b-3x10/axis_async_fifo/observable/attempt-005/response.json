  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n\n    // Total data width for storage\n    localparam TOTAL_DATA_WIDTH = DATA_WIDTH + \n                                  (KEEP_ENABLE ? KEEP_WIDTH : 0) +\n                                  (LAST_ENABLE ? 1 : 0) +\n                                  (ID_ENABLE ? ID_WIDTH : 0) +\n                                  (DEST_ENABLE ? DEST_WIDTH : 0) +\n                                  (USER_ENABLE ? USER_WIDTH : 0);\n\n    // RAM storage\n    reg [TOTAL_DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Write pointer (s_clk domain)\n    reg [PTR_WIDTH-1:0] wr_ptr;\n    // Read pointer (m_clk domain)\n    reg [PTR_WIDTH-1:0] rd_ptr;\n\n    // Synchronizers for read pointer to s_clk domain\n    reg [PTR_WIDTH-1:0] rd_ptr_sync1, rd_ptr_sync2, rd_ptr_sync3;\n    // Synchronizers for write pointer to m_clk domain\n    reg [PTR_WIDTH-1:0] wr_ptr_sync1, wr_ptr_sync2, wr_ptr_sync3;\n\n    // Synchronizers for pause requests\n    reg s_pause_req_sync1, s_pause_req_sync2;\n    reg m_pause_req_sync1, m_pause_req_sync2;\n\n    // Pause state\n    reg s_paused, m_paused;\n\n    // Overflow/Bad frame tracking\n    reg s_overflow, s_bad_frame, s_good_frame;\n    reg m_overflow, m_bad_frame, m_good_frame;\n\n    // Depth calculations\n    wire [PTR_WIDTH-1:0] wr_ptr_m = wr_ptr;\n    wire [PTR_WIDTH-1:0] rd_ptr_s = rd_ptr_sync3;\n    wire [PTR_WIDTH-1:0] wr_ptr_m_sync = wr_ptr_sync3;\n    wire [PTR_WIDTH-1:0] rd_ptr_m = rd_ptr;\n\n    // Depth in s_clk domain\n    wire [PTR_WIDTH-1:0] s_depth = wr_ptr - rd_ptr_s;\n    // Depth in m_clk domain\n    wire [PTR_WIDTH-1:0] m_depth = wr_ptr_m_sync - rd_ptr_m;\n\n    // Full/Empty conditions\n    wire s_full = (s_depth >= DEPTH);\n    wire m_empty = (m_depth == 0);\n\n    // Write enable\n    wire s_write_en = s_axis_tvalid && s_axis_tready && !s_paused;\n\n    // Read enable\n    wire m_read_en = m_axis_tvalid && m_axis_tready && !m_paused;\n\n    // tready generation\n    assign s_axis_tready = !s_full && !s_paused;\n    assign m_axis_tvalid = !m_empty && !m_paused;\n\n    // Pause ack\n    assign s_pause_ack = s_paused;\n    assign m_pause_ack = m_paused;\n\n    // Status outputs\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth;\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n\n    // Synchronizer for rd_ptr to s_clk\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            rd_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            rd_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            rd_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            rd_ptr_sync1 <= rd_ptr;\n            rd_ptr_sync2 <= rd_ptr_sync1;\n            rd_ptr_sync3 <= rd_ptr_sync2;\n        end\n    end\n\n    // Synchronizer for wr_ptr to m_clk\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            wr_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            wr_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            wr_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            wr_ptr_sync1 <= wr_ptr;\n            wr_ptr_sync2 <= wr_ptr_sync1;\n            wr_ptr_sync3 <= wr_ptr_sync2;\n        end\n    end\n\n    // Synchronizer for s_pause_req to m_clk\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_pause_req_sync1 <= 1'b0;\n            s_pause_req_sync2 <= 1'b0;\n        end else begin\n            s_pause_req_sync1 <= s_pause_req;\n            s_pause_req_sync2 <= s_pause_req_sync1;\n        end\n    end\n\n    // Synchronizer for m_pause_req to s_clk\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            m_pause_req_sync1 <= 1'b0;\n            m_pause_req_sync2 <= 1'b0;\n        end else begin\n            m_pause_req_sync1 <= m_pause_req;\n            m_pause_req_sync2 <= m_pause_req_sync1;\n        end\n    end\n\n    // Pause logic in s_clk domain\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_paused <= 1'b0;\n        end else if (PAUSE_ENABLE) begin\n            if (m_pause_req_sync2) begin\n                s_paused <= 1'b1;\n            end else if (!m_pause_req_sync2 && s_paused) begin\n                s_paused <= 1'b0;\n            end\n        end\n    end\n\n    // Pause logic in m_clk domain\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_paused <= 1'b0;\n        end else if (PAUSE_ENABLE) begin\n            if (s_pause_req_sync2) begin\n                m_paused <= 1'b1;\n            end else if (!s_pause_req_sync2 && m_paused) begin\n                m_paused <= 1'b0;\n            end\n        end\n    end\n\n    // Write pointer and RAM write in s_clk domain\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            wr_ptr <= {PTR_WIDTH{1'b0}};\n            s_overflow <= 1'b0;\n            s_bad_frame <= 1'b0;\n            s_good_frame <= 1'b0;\n        end else begin\n            if (s_write_en) begin\n                // Write data to RAM\n                mem[wr_ptr[ADDR_WIDTH-1:0]] <= {\n                    (USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}}),\n                    (DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}}),\n                    (ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}}),\n                    (LAST_ENABLE ? s_axis_tlast : 1'b0),\n                    (KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}}),\n                    s_axis_tdata\n                };\n                wr_ptr <= wr_ptr + 1'b1;\n            end\n            // Overflow detection\n            if (s_axis_tvalid && s_full && !s_paused) begin\n                s_overflow <= 1'b1;\n            end\n            // Frame tracking\n            if (s_write_en && s_axis_tlast) begin\n                if (FRAME_FIFO) begin\n                    // Check for bad frame based on user signal\n                    if (USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        s_bad_frame <= 1'b1;\n                    end else begin\n                        s_good_frame <= 1'b1;\n                    end\n                end\n            end\n        end\n    end\n\n    // Read pointer and RAM read in m_clk domain\n    reg [TOTAL_DATA_WIDTH-1:0] rd_data;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            rd_ptr <= {PTR_WIDTH{1'b0}};\n            m_overflow <= 1'b0;\n            m_bad_frame <= 1'b0;\n            m_good_frame <= 1'b0;\n            rd_data <= {TOTAL_DATA_WIDTH{1'b0}};\n        end else begin\n            if (m_read_en) begin\n                rd_ptr <= rd_ptr + 1'b1;\n            end\n            // Read from RAM\n            if (!m_empty) begin\n                rd_data <= mem[rd_ptr[ADDR_WIDTH-1:0]];\n            end\n            // Frame tracking on read\n            if (m_read_en && rd_data[LAST_ENABLE ? (DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0)) : DATA_WIDTH]) begin\n                if (FRAME_FIFO) begin\n                    if (USER_ENABLE && (rd_data[TOTAL_DATA_WIDTH-1:TOTAL_DATA_WIDTH-USER_WIDTH] & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        m_bad_frame <= 1'b1;\n                    end else begin\n                        m_good_frame <= 1'b1;\n                    end\n                end\n            end\n        end\n    end\n\n    // Output assignment\n    assign m_axis_tdata = rd_data[DATA_WIDTH-1:0];\n    assign m_axis_tkeep = KEEP_ENABLE ? rd_data[DATA_WIDTH + KEEP_WIDTH-1:DATA_WIDTH] : {KEEP_WIDTH{1'b0}};\n    assign m_axis_tlast = LAST_ENABLE ? rd_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0)] : 1'b0;\n    assign m_axis_tid = ID_ENABLE ? rd_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + ID_WIDTH-1:DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0)] : {ID_WIDTH{1'b0}};\n    assign m_axis_tdest = DEST_ENABLE ? rd_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) + DEST_WIDTH-1:DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0)] : {DEST_WIDTH{1'b0}};\n    assign m_axis_tuser = USER_ENABLE ? rd_data[TOTAL_DATA_WIDTH-1:TOTAL_DATA_WIDTH-USER_WIDTH] : {USER_WIDTH{1'b0}};\n\nendmodule\n```<|im_end|>",
