nput  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_MASK = DEPTH - 1;\n    \n    // Total width of the data word to be stored in RAM\n    localparam TOTAL_DATA_WIDTH = DATA_WIDTH + \n                                  (KEEP_ENABLE ? KEEP_WIDTH : 0) +\n                                  (LAST_ENABLE ? 1 : 0) +\n                                  (ID_ENABLE ? ID_WIDTH : 0) +\n                                  (DEST_ENABLE ? DEST_WIDTH : 0) +\n                                  (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Internal signals\n    wire [TOTAL_DATA_WIDTH-1:0] s_axis_tdata_packed;\n    wire [TOTAL_DATA_WIDTH-1:0] m_axis_tdata_unpacked;\n    \n    // Pack input data\n    assign s_axis_tdata_packed = {\n        (USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}}),\n        (DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}}),\n        (ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}}),\n        (LAST_ENABLE ? s_axis_tlast : 1'b0),\n        (KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}}),\n        s_axis_tdata\n    };\n\n    // Unpack output data\n    assign m_axis_tdata = m_axis_tdata_unpacked[DATA_WIDTH-1:0];\n    assign m_axis_tkeep = m_axis_tdata_unpacked[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) - 1 : DATA_WIDTH];\n    assign m_axis_tlast = m_axis_tdata_unpacked[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) - 1];\n    assign m_axis_tid = m_axis_tdata_unpacked[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) - 1 : DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0)];\n    assign m_axis_tdest = m_axis_tdata_unpacked[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) + (DEST_ENABLE ? DEST_WIDTH : 0) - 1 : DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0)];\n    assign m_axis_tuser = m_axis_tdata_unpacked[TOTAL_DATA_WIDTH-1 : DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) + (DEST_ENABLE ? DEST_WIDTH : 0)];\n\n    // FIFO pointers\n    reg [ADDR_WIDTH:0] s_wr_ptr;\n    reg [ADDR_WIDTH:0] m_rd_ptr;\n    \n    // Synchronized pointers\n    reg [ADDR_WIDTH:0] s_wr_ptr_m_sync1;\n    reg [ADDR_WIDTH:0] s_wr_ptr_m_sync2;\n    reg [ADDR_WIDTH:0] m_rd_ptr_s_sync1;\n    reg [ADDR_WIDTH:0] m_rd_ptr_s_sync2;\n    \n    // RAM\n    reg [TOTAL_DATA_WIDTH-1:0] ram [0:DEPTH-1];\n    \n    // Read data\n    reg [TOTAL_DATA_WIDTH-1:0] ram_rd_data;\n    reg [TOTAL_DATA_WIDTH-1:0] ram_rd_data_reg;\n    \n    // Control signals\n    wire s_wr_en;\n    wire m_rd_en;\n    wire s_full;\n    wire m_empty;\n    wire s_overflow;\n    wire m_overflow;\n    \n    // Pause signals\n    wire s_pause_active;\n    wire m_pause_active;\n    \n    // Frame tracking\n    reg s_in_frame;\n    reg m_in_frame;\n    reg s_bad_frame;\n    reg m_bad_frame;\n    reg s_good_frame;\n    reg m_good_frame;\n    \n    // Depth calculation\n    wire [$clog2(DEPTH):0] s_depth;\n    wire [$clog2(DEPTH):0] m_depth;\n    wire [$clog2(DEPTH):0] s_depth_commit;\n    wire [$clog2(DEPTH):0] m_depth_commit;\n    \n    // Synchronize write pointer to master clock domain\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_wr_ptr_m_sync1 <= {({ADDR_WIDTH+1