E_VALUE) begin\n                        s_bad_frame <= 1'b1;\n                    end else begin\n                        s_good_frame <= 1'b1;\n                    end\n                end else begin\n                    s_in_frame <= 1'b1;\n                end\n            end\n        end\n    end\n    \n    // Frame tracking - master side\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_in_frame <= 1'b0;\n            m_bad_frame <= 1'b0;\n            m_good_frame <= 1'b0;\n        end else begin\n            if (m_rd_en) begin\n                if (m_axis_tlast) begin\n                    m_in_frame <= 1'b0;\n                    // Check for bad frame\n                    if (USER_ENABLE && (m_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        m_bad_frame <= 1'b1;\n                    end else begin\n                        m_good_frame <= 1'b1;\n                    end\n                end else begin\n                    m_in_frame <= 1'b1;\n                end\n            end\n        end\n    end\n    \n    // RAM write\n    always @(posedge s_clk) begin\n        if (s_wr_en) begin\n            ram[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdata_packed;\n        end\n    end\n    \n    // RAM read\n    always @(posedge m_clk) begin\n        ram_rd_data <= ram[m_rd_ptr[ADDR_WIDTH-1:0]];\n    end\n    \n    // Pipeline stage\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            ram_rd_data_reg <= {({TOTAL_DATA_WIDTH}{1'b0}});\n        end else begin\n            ram_rd_data_reg <= ram_rd_data;\n        end\n    end\n    \n    // Output data\n    assign m_axis_tdata_unpacked = ram_rd_data_reg;\n    \n    // Valid signal\n    assign m_axis_tvalid = !m_empty && !m_pause_active;\n    \n    // Ready signal\n    assign s_axis_tready = !s_full || DROP_WHEN_FULL || MARK_WHEN_FULL;\n    \n    // Pointer updates\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= {({ADDR_WIDTH+1}{1'b0}});\n        end else if (s_wr_en) begin\n            s_wr_ptr <= s_wr_ptr + 1'b1;\n        end\n    end\n    \n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= {({ADDR_WIDTH+1}{1'b0}});\n        end else if (m_rd_en) begin\n            m_rd_ptr <= m_rd_ptr + 1'b1;\n        end\n    end\n    \n    // Pause acknowledgments\n    assign s_pause_ack = s_pause_active;\n    assign m_pause_ack = m_pause_active;\n    \n    // Status outputs\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth_commit;\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n    \n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth_commit;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n\nendmodule\n```<|im_end|>",
