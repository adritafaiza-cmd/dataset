  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Total sideband width\n    localparam SIDE_WIDTH = (KEEP_ENABLE ? KEEP_WIDTH : 0) +\n                            (LAST_ENABLE ? 1 : 0) +\n                            (ID_ENABLE ? ID_WIDTH : 0) +\n                            (DEST_ENABLE ? DEST_WIDTH : 0) +\n                            (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Pack sidebands into a single vector for easier handling\n    // Order: keep, last, id, dest, user\n    wire [SIDE_WIDTH-1:0] s_sideband;\n    wire [SIDE_WIDTH-1:0] m_sideband;\n\n    // Unpack sidebands\n    wire [KEEP_WIDTH-1:0] s_keep;\n    wire                   s_last;\n    wire [ID_WIDTH-1:0]    s_id;\n    wire [DEST_WIDTH-1:0]  s_dest;\n    wire [USER_WIDTH-1:0]  s_user;\n\n    wire [KEEP_WIDTH-1:0] m_keep;\n    wire                   m_last;\n    wire [ID_WIDTH-1:0]    m_id;\n    wire [DEST_WIDTH-1:0]  m_dest;\n    wire [USER_WIDTH-1:0]  m_user;\n\n    // Pack source sideband\n    assign s_sideband = {\n        (USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}}),\n        (DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}}),\n        (ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}}),\n        (LAST_ENABLE ? s_axis_tlast : 1'b0),\n        (KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}})\n    };\n\n    // Unpack destination sideband\n    assign m_keep = m_sideband[0 +: KEEP_ENABLE ? KEEP_WIDTH : 1];\n    assign m_last = m_sideband[KEEP_ENABLE ? KEEP_WIDTH : 0];\n    assign m_id   = m_sideband[(KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) +: ID_ENABLE ? ID_WIDTH : 1];\n    assign m_dest = m_sideband[(KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) +: DEST_ENABLE ? DEST_WIDTH : 1];\n    assign m_user = m_sideband[(KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) + (DEST_ENABLE ? DEST_WIDTH : 0) +: USER_ENABLE ? USER_WIDTH : 1];\n\n    // Correct unpacking with proper offsets\n    localparam OFF_KEEP = 0;\n    localparam OFF_LAST = OFF_KEEP + (KEEP_ENABLE ? KEEP_WIDTH : 0);\n    localparam OFF_ID   = OFF_LAST + (LAST_ENABLE ? 1 : 0);\n    localparam OFF_DEST = OFF_ID + (ID_ENABLE ? ID_WIDTH : 0);\n    localparam OFF_USER = OFF_DEST + (DEST_ENABLE ? DEST_WIDTH : 0);\n\n    assign m_keep = m_sideband[OFF_KEEP +: (KEEP_ENABLE ? KEEP_WIDTH : 1)];\n    assign m_last = m_sideband[OFF_LAST];\n    assign m_id   = m_sideband[OFF_ID +: (ID_ENABLE ? ID_WIDTH : 1)];\n    assign m_dest = m_sideband[OFF_DEST +: (DEST_ENABLE ? DEST_WIDTH : 1)];\n    assign m_user = m_sideband[OFF_USER +: (USER_ENABLE ? USER_WIDTH : 1)];\n\n    // Re-pack source sideband correctly\n    assign s_sideband = {\n        (USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}}),\n        (DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}}),\n        (ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}}),\n        (LAST_ENABLE ? s_axis_tlast : 1'b0),\n        (KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}})\n    };\n\n    // Source domain\n    reg [PTR_WIDTH-1:0] s_wr_ptr;\n    reg [PTR_WIDTH-1:0] s_rd_ptr_sync; // synchronized read pointer from m domain\n    reg [PTR_WIDTH-1:0] s_rd_ptr_sync_d1;\n    reg [PTR_WIDTH-1:0] s_rd_ptr_sync_d2;\n\n    // Destination domain\n    reg [PTR_WIDTH-1:0] m_rd_ptr;\n    reg [PTR_WIDTH-1:0] m_wr_ptr_sync; // synchronized write pointer from s domain\n    reg [PTR_WIDTH-1:0] m_wr_ptr_sync_d1;\n    reg [PTR_WIDTH-1:0] m_wr_ptr_sync_d2;\n\n    // RAM storage\n    reg [DATA_WIDTH-1:0] ram_data [0:DEPTH-1];\n    reg [SIDE_WIDTH-1:0] ram_side [0:DEPTH-1];\n\n    // Source write\n    wire s_wr_en = s_axis_tvalid & s_axis_tready;\n    wire [ADDR_WIDTH-1:0] s_wr_addr = s_wr_ptr[ADDR_WIDTH-1:0];\n\n    // Destination read\n    wire m_rd_en = m_axis_tvalid & m_axis_tready;\n    wire [ADDR_WIDTH-1:0] m_rd_addr = m_rd_ptr[ADDR_WIDTH-1:0];\n\n    // RAM write\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (s_wr_en) begin\n            ram_data[s_wr_addr] <= s_axis_tdata;\n            ram_side[s_wr_addr] <= s_sideband;\n            s_wr_ptr <= s_wr_ptr + 1'b1;\n        end\n    end\n\n    // Synchronize write pointer to m domain\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_wr_ptr_sync_d1 <= {PTR_WIDTH{1'b0}};\n            m_wr_ptr_sync_d2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            m_wr_ptr_sync_d1 <= s_wr_ptr;\n            m_wr_ptr_sync_d2 <= m_wr_ptr_sync_d1;\n        end\n    end\n    assign m_wr_ptr_sync = m_wr_ptr_sync_d2;\n\n    // Synchronize read pointer to s domain\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_rd_ptr_sync_d1 <= {PTR_WIDTH{1'b0}};\n            s_rd_ptr_sync_d2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            s_rd_ptr_sync_d1 <= m_rd_ptr;\n            s_rd_ptr_sync_d2 <= s_rd_ptr_sync_d1;\n        end\n    end\n    assign s_rd_ptr_sync = s_rd_ptr_sync_d2;\n\n    // Depth calculations\n    wire [PTR_WIDTH-1:0] s_depth = s_wr_ptr - s_rd_ptr_sync;\n    wire [PTR_WIDTH-1:0] m_depth = m_wr_ptr_sync - m_rd_ptr;\n\n    // Full/Empty\n    wire s_full = (s_depth == DEPTH);\n    wire m_empty = (m_depth == 0);\n\n    // Pause logic\n    reg s_pause_active;\n    reg m_pause_active;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_pause_active <= 1'b0;\n        end else if (PAUSE_ENABLE) begin\n            s_pause_active <= s_pause_req;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_pause_active <= 1'b0;\n        end else if (PAUSE_ENABLE) begin\n            m_pause_active <= m_pause_req;\n        end\n    end\n\n    assign s_pause_ack = PAUSE_ENABLE ? s_pause_active : 1'b0;\n    assign m_pause_ack = PAUSE_ENABLE ? m_pause_active : 1'b0;\n\n    // tready logic\n    wire s_tready_base = (DROP_WHEN_FULL || MARK_WHEN_FULL) ? 1'b1 : ~s_full;\n    wire s_tready_pause = PAUSE_ENABLE ? ~s_pause_active : 1'b1;\n    assign s_axis_tready = s_tready_base & s_tready_pause;\n\n    // Output valid\n    assign m_axis_tvalid = ~m_empty & (PAUSE_ENABLE ? ~m_pause_active : 1'b1);\n\n    // Output data\n    assign m_axis_tdata = ram_data[m_rd_addr];\n    assign m_axis_tkeep = m_keep;\n    assign m_axis_tlast = m_last;\n    assign m_axis_tid   = m_id;\n    assign m_axis_tdest = m_dest;\n    assign m_axis_tuser = m_user;\n\n    // Destination read pointer update\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (m_rd_en) begin\n            m_rd_ptr <= m_rd_ptr + 1'b1;\n        end\n    end\n\n    // Status signals\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth;\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth;\n\n    // Overflow and frame status (simplified)\n    reg s_overflow;\n    reg m_overflow;\n    reg s_bad_frame;\n    reg m_bad_frame;\n    reg s_good_frame;\n    reg m_good_frame;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_overflow <= 1'b0;\n            s_bad_frame <= 1'b0;\n            s_good_frame <= 1'b0;\n        end else begin\n            s_overflow <= s_overflow | (s_wr_en & s_full & ~DROP_WHEN_FULL & ~MARK_WHEN_FULL);\n            // Frame tracking would go here\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_overflow <= 1'b0;\n            m_bad_frame <= 1'b0;\n            m_good_frame <= 1'b0;\n        end else begin\n            m_overflow <= m_overflow;\n            // Frame tracking would go here\n        end\n    end\n\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n\nendmodule\n```<|im_end|>",
