wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Total width of stored data\n    localparam TOTAL_WIDTH = DATA_WIDTH + \n                             (KEEP_ENABLE ? KEEP_WIDTH : 0) + \n                             (LAST_ENABLE ? 1 : 0) + \n                             (ID_ENABLE ? ID_WIDTH : 0) + \n                             (DEST_ENABLE ? DEST_WIDTH : 0) + \n                             (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Internal signals\n    wire [TOTAL_WIDTH-1:0] s_axis_tdata_packed;\n    wire [TOTAL_WIDTH-1:0] m_axis_tdata_packed;\n\n    // Pack input data\n    assign s_axis_tdata_packed = {\n        USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}},\n        DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}},\n        ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}},\n        LAST_ENABLE ? s_axis_tlast : 1'b0,\n        KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}},\n        s_axis_tdata\n    };\n\n    // Unpack output data\n    assign m_axis_tdata = m_axis_tdata_packed[DATA_WIDTH-1:0];\n    assign m_axis_tkeep = KEEP_ENABLE ? m_axis_tdata_packed[DATA_WIDTH +: KEEP_WIDTH] : {KEEP_WIDTH{1'b0}};\n    assign m_axis_tlast = LAST_ENABLE ? m_axis_tdata_packed[DATA_WIDTH + KEEP_WIDTH] : 1'b0;\n    assign m_axis_tid = ID_ENABLE ? m_axis_tdata_packed[DATA_WIDTH + KEEP_WIDTH + (LAST_ENABLE?1:0) +: ID_WIDTH] : {ID_WIDTH{1'b0}};\n    assign m_axis_tdest = DEST_ENABLE ? m_axis_tdata_packed[DATA_WIDTH + KEEP_WIDTH + (LAST_ENABLE?1:0) + ID_WIDTH +: DEST_WIDTH] : {DEST_WIDTH{1'b0}};\n    assign m_axis_tuser = USER_ENABLE ? m_axis_tdata_packed[DATA_WIDTH + KEEP_WIDTH + (LAST_ENABLE?1:0) + ID_WIDTH + DEST_WIDTH +: USER_WIDTH] : {USER_WIDTH{1'b0}};\n\n    // FIFO pointers\n    reg [ADDR_WIDTH:0] s_wr_ptr;\n    reg [ADDR_WIDTH:0] m_rd_ptr;\n\n    // Synchronized pointers\n    reg [ADDR_WIDTH:0] s_wr_ptr_m_sync1;\n    reg [ADDR_WIDTH:0] s_wr_ptr_m_sync2;\n    reg [ADDR_WIDTH:0] m_rd_ptr_s_sync1;\n    reg [ADDR_WIDTH:0] m_rd_ptr_s_sync2;\n\n    // RAM storage\n    reg [TOTAL_WIDTH-1:0] ram [0:DEPTH-1];\n\n    // Write enable\n    wire s_axis_tready_int;\n    wire s_axis_tready;\n    wire s_axis_tvalid_int;\n    wire s_axis_tvalid;\n\n    // Pause logic\n    reg s_pause_ack_reg;\n    reg m_pause_ack_reg;\n\n    // Status registers\n    reg s_status_overflow_reg;\n    reg s_status_bad_frame_reg;\n    reg s_status_good_frame_reg;\n    reg m_status_overflow_reg;\n    reg m_status_bad_frame_reg;\n    reg m_status_good_frame_reg;\n\n    // Depth calculation\n    wire [$clog2(DEPTH):0] s_depth;\n    wire [$clog2(DEPTH):0] m_depth;\n\n    // Synchronize write pointer to m_clk domain\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_wr_ptr_m_sync1 <= {({ADDR_WIDTH+1}{1'b0}});\n            s_wr_ptr_m_sync2 <= {({ADDR_WIDTH+1}{1'b0}});\n        end else begin\n            s_wr_ptr_m_sync1 <= s_wr_ptr;\n            s_wr_ptr_m_sync2 <= s_wr_ptr_m_sync1;\n        end\n    end\n\n    // Synchronize read pointer to s_clk domain\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            m_rd_ptr_s_sync1 <= {({ADDR_WIDTH+1}{1'b0}});\n            m_rd_ptr_s_sync2 <= {({ADDR_WIDTH+1}{1'b0}});\n        end else begin\n            m_rd_ptr_s_sync1 <= m_rd_ptr;\n            m_rd_ptr_s_sync2 <= m_rd_ptr_s_sync1;\n        end\n    end\n\n    // Calculate depths\n    assign s_depth = s_wr_ptr - m_rd_ptr_s_sync2;\n    assign m_depth = s_wr_ptr_m_sync2 - m_rd_ptr;\n\n    // Pause acknowledgment\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_pause_ack_reg <= 1'b0;\n        end else if (PAUSE_ENABLE) begin\n            s_pause_ack_reg <= s_pause_req;\n        end else begin\n            s_pause_ack_reg <= 1'b0;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_pause_ack_reg <= 1'b0;\n        end else if (PAUSE_ENABLE) begin\n            m_pause_ack_reg <= m_pause_req;\n        end else begin\n            m_pause_ack_reg <= 1'b0;\n        end\n    end\n\n    assign s_pause_ack = s_pause_ack_reg;\n    assign m_pause_ack = m_pause_ack_reg;\n\n    // Determine if FIFO is full\n    wire s_fifo_full = (s_depth == DEPTH);\n    wire m_fifo_empty = (m_depth == 0);\n\n    // Write ready logic\n    wire s_pause_active = PAUSE_ENABLE ? s_pause_req : 1'b0;\n    wire m_pause_active = PAUSE_ENABLE ? m_pause_req : 1'b0;\n\n    // For simplicity, we'll implement a basic version without frame tracking\n    // that handles the basic FIFO functionality with CDC safety\n\n    assign s_axis_tready = (DROP_WHEN_FULL || MARK_WHEN_FULL) ? 1'b1 : \n                           (s_fifo_full ? 1'b0 : \n                            (s_pause_active ? 1'b0 : 1'b1));\n\n    assign s_axis_tvalid = s_axis_tvalid;\n\n    // Write to RAM\n    wire s_axis_twrite = s_axis_tvalid && s_axis_tready;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= {({ADDR_WIDTH+1}{1'b0}});\n        end else if (s_axis_twrite) begin\n            ram[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdata_packed;\n            s_wr_ptr <= s_wr_ptr + 1'b1;\n        end\n    end\n\n    // Read from RAM\n    wire m_axis_tread = m_axis_tvalid && m_axis_tready;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= {({ADDR_WIDTH+1}{1'b0}});\n        end 