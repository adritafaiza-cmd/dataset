ion\n    wire [$clog2(DEPTH):0] s_depth;\n    wire [$clog2(DEPTH):0] m_depth;\n    \n    // Commit depth (synchronized)\n    wire [$clog2(DEPTH):0] s_depth_commit;\n    wire [$clog2(DEPTH):0] m_depth_commit;\n\n    // Data packing\n    assign s_wr_data = {\n        (USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}}),\n        (DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}}),\n        (ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}}),\n        (LAST_ENABLE ? s_axis_tlast : 1'b0),\n        (KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}}),\n        s_axis_tdata\n    };\n\n    // Data unpacking\n    assign m_axis_tdata = m_rd_data[DATA_WIDTH-1:0];\n    assign m_axis_tkeep = KEEP_ENABLE ? m_rd_data[DATA_WIDTH + KEEP_WIDTH-1:DATA_WIDTH] : {KEEP_WIDTH{1'b0}};\n    assign m_axis_tlast = LAST_ENABLE ? m_rd_data[DATA_WIDTH + KEEP_WIDTH] : 1'b0;\n    assign m_axis_tid = ID_ENABLE ? m_rd_data[DATA_WIDTH + KEEP_WIDTH + (LAST_ENABLE?1:0) + ID_WIDTH-1:DATA_WIDTH + KEEP_WIDTH + (LAST_ENABLE?1:0)] : {ID_WIDTH{1'b0}};\n    assign m_axis_tdest = DEST_ENABLE ? m_rd_data[DATA_WIDTH + KEEP_WIDTH + (LAST_ENABLE?1:0) + ID_WIDTH + DEST_WIDTH-1:DATA_WIDTH + KEEP_WIDTH + (LAST_ENABLE?1:0) + ID_WIDTH] : {DEST_WIDTH{1'b0}};\n    assign m_axis_tuser = USER_ENABLE ? m_rd_data[TOTAL_WIDTH-1:DATA_WIDTH + KEEP_WIDTH + (LAST_ENABLE?1:0) + ID_WIDTH + DEST_WIDTH] : {USER_WIDTH{1'b0}};\n\n    // Write pointer\n    reg [ADDR_WIDTH:0] s_wr_ptr_reg;\n    assign s_wr_ptr = s_wr_ptr_reg;\n    \n    // Read pointer\n    reg [ADDR_WIDTH:0] m_rd_ptr_reg;\n    assign m_rd_ptr = m_rd_ptr_reg;\n\n    // Synchronize read pointer to source domain\n    reg [ADDR_WIDTH:0] s_rd_ptr_sync_1, s_rd_ptr_sync_2;\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_rd_ptr_sync_1 <= {(ADDR_WIDTH+1){1'b0}};\n            s_rd_ptr_sync_2 <= {(ADDR_WIDTH+1){1'b0}};\n        end else begin\n            s_rd_ptr_sync_1 <= m_rd_ptr;\n            s_rd_ptr_sync_2 <= s_rd_ptr_sync_1;\n        end\n    end\n    assign s_rd_ptr_sync = s_rd_ptr_sync_2;\n\n    // Synchronize write pointer to destination domain\n    reg [ADDR_WIDTH:0] m_wr_ptr_sync_1, m_wr_ptr_sync_2;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_wr_ptr_sync_1 <= {(ADDR_WIDTH+1){1'b0}};\n            m_wr_ptr_sync_2 <= {(ADDR_WIDTH+1){1'b0}};\n        end else begin\n            m_wr_ptr_sync_1 <= s_wr_ptr;\n            m_wr_ptr_sync_2 <= m_wr_ptr_sync_1;\n        end\n    end\n    assign m_wr_ptr_sync = m_wr_ptr_sync_2;\n\n    // Full/Empty logic\n    assign s_full = (s_wr_ptr_reg[ADDR_WIDTH] != s_rd_ptr_sync[ADDR_WIDTH]) && \n                    (s_wr_ptr_reg[ADDR_WIDTH-1:0] == s_rd_ptr_sync[ADDR_WIDTH-1:0]);\n    assign s_empty = (s_wr_ptr_reg == s_rd_ptr_sync);\n    \n    assign m_full = (m_wr_ptr_sync[ADDR_WIDTH] != m_rd_ptr_reg[ADDR_WIDTH]) && \n                    (m_wr_ptr_sync[ADDR_WIDTH-1:0] == m_rd_ptr_reg[ADDR_WIDTH-1:0]);\n    assign m_empty = (m_wr_ptr_sync == m_rd_ptr_reg);\n\n    // Depth calculation\n    wire [$clog2(DEPTH):0] s_depth_raw = s_wr_ptr_reg - s_rd_ptr_sync;\n    wire [$clog2(DEPTH):0] m_depth_raw = m_wr_ptr_sync - m_rd_ptr_reg;\n    \n    assign s_depth = (s_depth_raw > DEPTH_LIMIT) ? DEPTH_LIMIT[$clog2(DEPTH):0] : s_depth_raw[$clog2(DEPTH):0];\n    assign m_depth = (m_depth_raw > DEPTH_LIMIT) ? DEPTH_LIMIT[$clog2(DEPTH):0] : m_depth_raw[$clog2(DEPTH):0];\n\n    // Commit depth (synchronized version)\n    reg [$clog2(DEPTH):0] s_depth_commit_reg;\n    reg [$clog2(DEPTH):0] m_depth_commit_reg;\n    \n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_depth_commit_reg <= {($clog2(DEPTH)+1){1'b0}};\n        end else begin\n            s_depth_commit_reg <= s_depth;\n        end\n    end\n    assign s_status_depth_commit = s_depth_commit_reg;\n    \n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_depth_commit_reg <= {($clog2(DEPTH)+1){1'b0}};\n        end else begin\n            m_depth_commit_reg <= m_depth;\n        end\n    end\n    assign m_status_depth_commit = m_depth_commit_reg;\n\n    // Write enable\n    wire s_write_allowed = s_axis_tvalid && s_axis_tready;\n    assign s_wr_en = s_write_allowed;\n\n    // Read enable\n    wire m_read_allowed = m_axis_tvalid && m_axis_tready;\n    assign m_rd_en = m_read_allowed;\n\n    // Tready logic\n    wire s_pause_active = PAUSE_ENABLE ? (s_pause_req && s_pause_ack_reg) : 1'b0;\n    wire m_pause_active = PAUSE_ENABLE ? (m_pause_req && m_pause_ack_reg) : 1'b0;\n    \n    wire s_can_accept = !s_full && !s_pause_active;\n    wire m_can_read = !m_empty && !m_pause_active;\n    \n    assign s_axis_tready = (DROP_WHEN_FULL || MARK_WHEN_FULL) ? 1'b1 : s_can_accept;\n    assign m_axis_tvalid = m_can_read;\n\n    // Write pointer update\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr_reg <= {(ADDR_WIDTH+1){1'b0}};\n        end else if (s_wr_en) begin\n            s_wr_ptr_reg <= s_wr_ptr_reg + 1'b1;\n        end\n    end\n\n    // Read pointer update\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr_reg <= {(ADDR_WIDTH+1){1'b0}};\n        end else if (m_rd_en) begin\n            m_rd_ptr_reg <= m_rd_ptr_reg + 1'b1;\n        end\n    end\n\n    // RAM implementation\n    reg [TOTAL_WIDTH-1:0] ram [0:DEPTH_POW2-1];\n    \n    // Write to RAM\n    always @(posedge s_clk) begin\n        if (s_wr_en) begin\n            ram[s_wr_ptr_reg[ADDR_WIDTH-1:0]] <= s_wr_data;\n        end\n    end\n\n    // Read from RAM\n    reg [TOTAL_WIDTH-1:0] m_rd_data_reg;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_data_reg <= {TOTAL_WIDTH{1'b0}};\n        end else if (m_rd_en) begin\n            m_rd_data_reg <= ram[m_rd_ptr_reg[ADDR_WIDTH-1:0]];\n        end\n    end\n    assign m_rd_data = m_rd_data_reg;\n\n    // Status depth\n    assign s_status_depth = s_depth;\n    assign m_status_depth = m_depth;\n\n    // Overflow detection\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_overflow_reg <= 1'b0;\n        end else if (s_axis_tvalid && s_full && !DROP_WHEN_FULL && !MARK_WHEN_FULL) begin\n            s_overflow_reg <= 1'b1;\n        end\n    end\n    assign s_status_overflow = s_overflow_reg;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_overflow_reg <= 1'b0;\n        end else if (m_axis_tvalid && m_full) begin\n            m_overflow_reg <= 1'b1;\n        end\n    end\n    assign m_status_overflow = m_overflow_reg;\n\n    // Frame tracking and status\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_in_frame <= 1'b0;\n            s_bad_frame_reg <= 1'b0;\n            s_good_frame_reg <= 1'b0;\n        end else begin\n            if (s_wr_en) begin\n                if (s_axis_tlast) begin\n                    s_in_frame <= 1'b0;\n                    if (USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        s_bad_frame_reg <= 1'b1;\n                    end else begin\n                        s_good_frame_reg <= 1'b1;\n                    end\n                end else begin\n                    s_in_frame <= 1'b1;\n                end\n            end\n        end\n    end\n    assign s_status_bad_frame = s_bad_frame_reg;\n    assign s_status_good_frame = s_good_frame_reg;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_in_frame <= 1'b0;\n            m_bad_frame_reg <= 1'b0;\n            m_good_frame_reg <= 1'b0;\n        end else begin\n            if (m_rd_en) begin\n                if (m_axis_tlast) begin\n                    m_in_frame <= 1'b0;\n                    if (USER_ENABLE && (m_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n              