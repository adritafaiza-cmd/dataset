  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam PTR_W = ASIZE + 1;\n  localparam AFULL_THRESH  = DEPTH - 1;\n  localparam AEMPTY_THRESH = 1;\n\n  // Internal FIFO storage\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  // Side A pointers (A is writer when a_dir=1, reader when a_dir=0)\n  // We maintain two independent FIFOs: A->B and B->A\n  // But the problem says \"bidirectional\" with direction select per side.\n  // Re-reading: a_dir=1 means A writes, a_dir=0 means A reads.\n  // So A can be writing to B or reading from B, but not both simultaneously.\n  // Similarly for B.\n  // This is a bidirectional FIFO where each side can be in write or read mode.\n  // When A writes and B reads, data flows A->B.\n  // When B writes and A reads, data flows B->A.\n  // We need two separate FIFOs: one for A->B, one for B->A.\n\n  // FIFO A->B: A writes, B reads\n  reg [PTR_W-1:0] ab_wr_ptr;\n  reg [PTR_W-1:0] ab_rd_ptr;\n  reg [PTR_W-1:0] ab_wr_ptr_sync1, ab_wr_ptr_sync2;\n  reg [PTR_W-1:0] ab_rd_ptr_sync1, ab_rd_ptr_sync2;\n\n  // FIFO B->A: B writes, A reads\n  reg [PTR_W-1:0] ba_wr_ptr;\n  reg [PTR_W-1:0] ba_rd_ptr;\n  reg [PTR_W-1:0] ba_wr_ptr_sync1, ba_wr_ptr_sync2;\n  reg [PTR_W-1:0] ba_rd_ptr_sync1, ba_rd_ptr_sync2;\n\n  // Storage for A->B FIFO\n  reg [DSIZE-1:0] ab_mem [0:DEPTH-1];\n  // Storage for B->A FIFO\n  reg [DSIZE-1:0] ba_mem [0:DEPTH-1];\n\n  // Synchronizers for A->B write pointer (to B side)\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ab_wr_ptr_sync1 <= {PTR_W{1'b0}};\n      ab_wr_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      ab_wr_ptr_sync1 <= ab_wr_ptr;\n      ab_wr_ptr_sync2 <= ab_wr_ptr_sync1;\n    end\n  end\n\n  // Synchronizers for A->B read pointer (to A side)\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ab_rd_ptr_sync1 <= {PTR_W{1'b0}};\n      ab_rd_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      ab_rd_ptr_sync1 <= ab_rd_ptr;\n      ab_rd_ptr_sync2 <= ab_rd_ptr_sync1;\n    end\n  end\n\n  // Synchronizers for B->A write pointer (to A side)\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ba_wr_ptr_sync1 <= {PTR_W{1'b0}};\n      ba_wr_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      ba_wr_ptr_sync1 <= ba_wr_ptr;\n      ba_wr_ptr_sync2 <= ba_wr_ptr_sync1;\n    end\n  end\n\n  // Synchronizers for B->A read pointer (to B side)\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ba_rd_ptr_sync1 <= {PTR_W{1'b0}};\n      ba_rd_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      ba_rd_ptr_sync1 <= ba_rd_ptr;\n      ba_rd_ptr_sync2 <= ba_rd_ptr_sync1;\n    end\n  end\n\n  // A->B FIFO: A writes when a_dir=1 and a_winc=1\n  wire ab_write_en = a_dir & a_winc;\n  wire ab_read_en  = !b_dir & b_rinc;\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ab_wr_ptr <= {PTR_W{1'b0}};\n    end else if (ab_write_en) begin\n      ab_mem[ab_wr_ptr[ASIZE-1:0]] <= a_wdata;\n      ab_wr_ptr <= ab_wr_ptr + 1'b1;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ab_rd_ptr <= {PTR_W{1'b0}};\n    end else if (ab_read_en) begin\n      ab_rd_ptr <= ab_rd_ptr + 1'b1;\n    end\n  end\n\n  // B->A FIFO: B writes when b_dir=1 and b_winc=1\n  wire ba_write_en = b_dir & b_winc;\n  wire ba_read_en  = !a_dir & a_rinc;\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ba_wr_ptr <= {PTR_W{1'b0}};\n    end else if (ba_write_en) begin\n      ba_mem[ba_wr_ptr[ASIZE-1:0]] <= b_wdata;\n      ba_wr_ptr <= ba_wr_ptr + 1'b1;\n    end\n  end\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ba_rd_ptr <= {PTR_W{1'b0}};\n    end else if (ba_read_en) begin\n      ba_rd_ptr <= ba_rd_ptr + 1'b1;\n    end\n  end\n\n  // A->B FIFO status on A side (A is writer)\n  wire [PTR_W-1:0] ab_wr_ptr_a = ab_wr_ptr;\n  wire [PTR_W-1:0] ab_rd_ptr_a = ab_rd_ptr_sync2;\n  wire [PTR_W-1:0] ab_count_a  = ab_wr_ptr_a - ab_rd_ptr_a;\n  wire ab_full_a  = (ab_count_a == DEPTH);\n  wire ab_afull_a = (ab_count_a >= AFULL_THRESH);\n  wire ab_empty_a = (ab_count_a == 0);\n  wire ab_aempty_a = (ab_count_a <= AEMPTY_THRESH);\n\n  // A->B FIFO status on B side (B is reader)\n  wire [PTR_W-1:0] ab_wr_ptr_b = ab_wr_ptr_sync2;\n  wire [PTR_W-1:0] ab_rd_ptr_b = ab_rd_ptr;\n  wire [PTR_W-1:0] ab_count_b  = ab_wr_ptr_b - ab_rd_ptr_b;\n  wire ab_full_b  = (ab_count_b == DEPTH);\n  wire ab_afull_b = (ab_count_b >= AFULL_THRESH);\n  wire ab_empty_b = (ab_count_b == 0);\n  wire ab_aempty_b = (ab_count_b <= AEMPTY_THRESH);\n\n  // B->A FIFO status on B side (B is writer)\n  wire [PTR_W-1:0] ba_wr_ptr_b = ba_wr_ptr;\n  wire [PTR_W-1:0] ba_rd_ptr_b = ba_rd_ptr_sync2;\n  wire [PTR_W-1:0] ba_count_b  = ba_wr_ptr_b - ba_rd_ptr_b;\n  wire ba_full_b  = (ba_count_b == DEPTH);\n  wire ba_afull_b = (ba_count_b >= AFULL_THRESH);\n  wire ba_empty_b = (ba_count_b == 0);\n  wire ba_aempty_b = (ba_count_b <= AEMPTY_THRESH);\n\n  // B->A FIFO status on A side (A is reader)\n  wire [PTR_W-1:0] ba_wr_ptr_a = ba_wr_ptr_sync2;\n  wire [PTR_W-1:0] ba_rd_ptr_a = ba_rd_ptr;\n  wire [PTR_W-1:0] ba_count_a  = ba_wr_ptr_a - ba_rd_ptr_a;\n  wire ba_full_a  = (ba_count_a == DEPTH);\n  wire ba_afull_a = (ba_count_a >= AFULL_THRESH);\n  wire ba_empty_a = (ba_count_a == 0);\n  wire ba_aempty_a = (ba_count_a <= AEMPTY_THRESH);\n\n  // A side outputs:\n  // When a_dir=1 (A is writer): full/afull refer to A->B FIFO\n  // When a_dir=0 (A is reader): empty/aempty refer to B->A FIFO\n  assign a_full   = a_dir ? ab_full_a  : ba_full_a;\n  assign a_afull  = a_dir ? ab_afull_a : ba_afull_a;\n  assign a_empty  = a_dir ? ab_empty_a : ba_empty_a;\n  assign a_aempty = a_dir ? ab_aempty_a : ba_aempty_a;\n\n  // A read data: when a_dir=0, read from B->A FIFO\n  reg [DSIZE-1:0] a_rdata_reg;\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_rdata_reg <= {DSIZE{1'b0}};\n    end else if (ba_read_en) begin\n      a_rdata_reg <= ba_mem[ba_rd_ptr[ASIZE-1:0]];\n    end\n  end\n  assign a_rdata = a_rdata_reg;\n\n  // B side outputs:\n  // When b_dir=1 (B is writer): full/afull refer to B->A FIFO\n  // When b_dir=0 (B is reader): empty/aempty refer to A->B FIFO\n  assign b_full   = b_dir ? ba_full_b  : ab_full_b;\n  assign b_afull  = b_dir ? ba_afull_b : ab_afull_b;\n  assign b_empty  = b_dir ? ba_empty_b : ab_empty_b;\n  assign b_aempty = b_dir ? ba_aempty_b : ab_aempty_b;\n\n  // B read data: when b_dir=0, read from A->B FIFO\n  reg [DSIZE-1:0] b_rdata_reg;\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_rdata_reg <= {DSIZE{1'b0}};\n    end else if (ab_read_en) begin\n      b_rdata_reg <= ab_mem[ab_rd_ptr[ASIZE-1:0]];\n    end\n  end\n  assign b_rdata = b_rdata_reg;\n\nendmodule\n```<|im_end|>",
