  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam AWIDTH = ASIZE + 1;\n  localparam AFULL_THRESH = DEPTH - 2;\n  localparam AEMPTY_THRESH = 2;\n\n  // Internal FIFO storage for A->B direction\n  reg [DSIZE-1:0] fifo_ab [0:DEPTH-1];\n  // Internal FIFO storage for B->A direction\n  reg [DSIZE-1:0] fifo_ba [0:DEPTH-1];\n\n  // Pointers for A->B FIFO\n  // Write pointer in A domain, read pointer in B domain\n  reg [AWIDTH-1:0] ab_wr_ptr_a;\n  reg [AWIDTH-1:0] ab_rd_ptr_b;\n  // Synchronized versions\n  reg [AWIDTH-1:0] ab_wr_ptr_b_sync0, ab_wr_ptr_b_sync1, ab_wr_ptr_b_sync2;\n  reg [AWIDTH-1:0] ab_rd_ptr_a_sync0, ab_rd_ptr_a_sync1, ab_rd_ptr_a_sync2;\n\n  // Pointers for B->A FIFO\n  // Write pointer in B domain, read pointer in A domain\n  reg [AWIDTH-1:0] ba_wr_ptr_b;\n  reg [AWIDTH-1:0] ba_rd_ptr_a;\n  // Synchronized versions\n  reg [AWIDTH-1:0] ba_wr_ptr_a_sync0, ba_wr_ptr_a_sync1, ba_wr_ptr_a_sync2;\n  reg [AWIDTH-1:0] ba_rd_ptr_b_sync0, ba_rd_ptr_b_sync1, ba_rd_ptr_b_sync2;\n\n  // Data staging for A->B: two destination-clock stages\n  reg [DSIZE-1:0] ab_data_stage0, ab_data_stage1;\n  reg ab_valid_stage0, ab_valid_stage1;\n\n  // Data staging for B->A: two destination-clock stages\n  reg [DSIZE-1:0] ba_data_stage0, ba_data_stage1;\n  reg ba_valid_stage0, ba_valid_stage1;\n\n  // Direction change tracking\n  // For A side: a_dir=1 means write to A->B FIFO, a_dir=0 means read from B->A FIFO\n  // For B side: b_dir=1 means write to B->A FIFO, b_dir=0 means read from A->B FIFO\n\n  // A side: write to A->B FIFO when a_dir=1 and a_winc\n  wire a_write_ab = a_dir & a_winc;\n  // A side: read from B->A FIFO when a_dir=0 and a_rinc\n  wire a_read_ba = ~a_dir & a_rinc;\n\n  // B side: write to B->A FIFO when b_dir=1 and b_winc\n  wire b_write_ba = b_dir & b_winc;\n  // B side: read from A->B FIFO when b_dir=0 and b_rinc\n  wire b_read_ab = ~b_dir & b_rinc;\n\n  // Compute full/empty flags\n  // A->B FIFO: full when write pointer (A) catches up to read pointer (B)\n  wire [AWIDTH-1:0] ab_wr_ptr_b_sync = ab_wr_ptr_b_sync2;\n  wire [AWIDTH-1:0] ab_rd_ptr_a_sync = ab_rd_ptr_a_sync2;\n  wire [AWIDTH-1:0] ab_diff = ab_wr_ptr_a - ab_rd_ptr_a_sync;\n  wire a_full_ab = (ab_diff == 0) && (ab_wr_ptr_a[ASIZE] != ab_rd_ptr_a_sync[ASIZE]);\n  wire a_afull_ab = (ab_diff == AFULL_THRESH);\n\n  // B->A FIFO: full when write pointer (B) catches up to read pointer (A)\n  wire [AWIDTH-1:0] ba_wr_ptr_a_sync = ba_wr_ptr_a_sync2;\n  wire [AWIDTH-1:0] ba_rd_ptr_b_sync = ba_rd_ptr_b_sync2;\n  wire [AWIDTH-1:0] ba_diff = ba_wr_ptr_b - ba_rd_ptr_b_sync;\n  wire b_full_ba = (ba_diff == 0) && (ba_wr_ptr_b[ASIZE] != ba_rd_ptr_b_sync[ASIZE]);\n  wire b_afull_ba = (ba_diff == AFULL_THRESH);\n\n  // Empty flags\n  // A->B FIFO empty: read pointer (B) equals write pointer (A)\n  wire b_empty_ab = (ab_rd_ptr_b == ab_wr_ptr_b_sync);\n  wire b_aempty_ab = (ab_diff == 0) || (ab_diff == 1);\n\n  // B->A FIFO empty: read pointer (A) equals write pointer (B)\n  wire a_empty_ba = (ba_rd_ptr_a == ba_wr_ptr_a_sync);\n  wire a_aempty_ba = (ba_diff == 0) || (ba_diff == 1);\n\n  // Local full/empty for each side based on direction\n  // A side: if a_dir=1 (write), full is a_full_ab; if a_dir=0 (read), empty is a_empty_ba\n  assign a_full = a_dir ? a_full_ab : 1'b0;\n  assign a_afull = a_dir ? a_afull_ab : 1'b0;\n  assign a_empty = ~a_dir ? a_empty_ba : 1'b0;\n  assign a_aempty = ~a_dir ? a_aempty_ba : 1'b0;\n\n  // B side: if b_dir=1 (write), full is b_full_ba; if b_dir=0 (read), empty is b_empty_ab\n  assign b_full = b_dir ? b_full_ba : 1'b0;\n  assign b_afull = b_dir ? b_afull_ba : 1'b0;\n  assign b_empty = ~b_dir ? b_empty_ab : 1'b0;\n  assign b_aempty = ~b_dir ? b_aempty_ab : 1'b0;\n\n  // A->B FIFO write in A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ab_wr_ptr_a <= {AWIDTH{1'b0}};\n      ab_data_stage0 <= {DSIZE{1'b0}};\n      ab_valid_stage0 <= 1'b0;\n    end else begin\n      if (a_write_ab && !a_full_ab) begin\n        fifo_ab[ab_wr_ptr_a[ASIZE-1:0]] <= a_wdata;\n        ab_wr_ptr_a <= ab_wr_ptr_a + 1'b1;\n        ab_data_stage0 <= a_wdata;\n        ab_valid_stage0 <= 1'b1;\n      end else begin\n        ab_valid_stage0 <= 1'b0;\n      end\n    end\n  end\n\n  // A->B FIFO read in B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ab_rd_ptr_b <= {AWIDTH{1'b0}};\n      ab_data_stage1 <= {DSIZE{1'b0}};\n      ab_valid_stage1 <= 1'b0;\n    end else begin\n      if (b_read_ab && !b_empty_ab) begin\n        ab_rd_ptr_b <= ab_rd_ptr_b + 1'b1;\n        ab_data_stage1 <= fifo_ab[ab_rd_ptr_b[ASIZE-1:0]];\n        ab_valid_stage1 <= 1'b1;\n      end else begin\n        ab_valid_stage1 <= 1'b0;\n      end\n    end\n  end\n\n  // B->A FIFO write in B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ba_wr_ptr_b <= {AWIDTH{1'b0}};\n      ba_data_stage0 <= {DSIZE{1'b0}};\n      ba_valid_stage0 <= 1'b0;\n    end else begin\n      if (b_write_ba && !b_full_ba) begin\n        fifo_ba[ba_wr_ptr_b[ASIZE-1:0]] <= b_wdata;\n        ba_wr_ptr_b <= ba_wr_ptr_b + 1'b1;\n        ba_data_stage0 <= b_wdata;\n        ba_valid_stage0 <= 1'b1;\n      end else begin\n        ba_valid_stage0 <= 1'b0;\n      end\n    end\n  end\n\n  // B->A FIFO read in A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ba_rd_ptr_a <= {AWIDTH{1'b0}};\n      ba_data_stage1 <= {DSIZE{1'b0}};\n      ba_valid_stage1 <= 1'b0;\n    end else begin\n      if (a_read_ba && !a_empty_ba) begin\n        ba_rd_ptr_a <= ba_rd_ptr_a + 1'b1;\n        ba_data_stage1 <= fifo_ba[ba_rd_ptr_a[ASIZE-1:0]];\n        ba_valid_stage1 <= 1'b1;\n      end else begin\n        ba_valid_stage1 <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize A->B write pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ab_wr_ptr_b_sync0 <= {AWIDTH{1'b0}};\n      ab_wr_ptr_b_sync1 <= {AWIDTH{1'b0}};\n      ab_wr_ptr_b_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      ab_wr_ptr_b_sync0 <= ab_wr_ptr_a;\n      ab_wr_ptr_b_sync1 <= ab_wr_ptr_b_sync0;\n      ab_wr_ptr_b_sync2 <= ab_wr_ptr_b_sync1;\n    end\n  end\n\n  // Synchronize A->B read pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ab_rd_ptr_a_sync0 <= {AWIDTH{1'b0}};\n      ab_rd_ptr_a_sync1 <= {AWIDTH{1'b0}};\n      ab_rd_ptr_a_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      ab_rd_ptr_a_sync0 <= ab_rd_ptr_b;\n      ab_rd_ptr_a_sync1 <= ab_rd_ptr_a_sync0;\n      ab_rd_ptr_a_sync2 <= ab_rd_ptr_a_sync1;\n    end\n  end\n\n  // Synchronize B->A write pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ba_wr_ptr_a_sync0 <= {AWIDTH{1'b0}};\n      ba_wr_ptr_a_sync1 <= {AWIDTH{1'b0}};\n      ba_wr_ptr_a_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      ba_wr_ptr_a_sync0 <= ba_wr_ptr_b;\n      ba_wr_ptr_a_sync1 <= ba_wr_ptr_a_sync0;\n      ba_wr_ptr_a_sync2 <= ba_wr_ptr_a_sync1;\n    end\n  end\n\n  // Synchronize B->A read pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ba_rd_ptr_b_sync0 <= {AWIDTH{1'b0}};\n      ba_rd_ptr_b_sync1 <= {AWIDTH{1'b0}};\n      ba_rd_ptr_b_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      ba_rd_ptr_b_sync0 <= ba_rd_ptr_a;\n      ba_rd_ptr_b_sync1 <= ba_rd_ptr_b_sync0;\n      ba_rd_ptr_b_sync2 <= ba_rd_ptr_b_sync1;\n    end\n  end\n\n  // Read data outputs\n  assign a_rdata = ba_data_stage1;\n  assign b_rdata = ab_data_stage1;\n\nendmodule\n```<|im_end|>",
