  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam AFULL_THRESH  = DEPTH - 2;\n  localparam AEMPTY_THRESH = 2;\n\n  // --- A-to-B direction: A writes, B reads ---\n  // A-side write pointer\n  reg [ASIZE:0] a2b_wr_ptr_a;\n  // B-side read pointer\n  reg [ASIZE:0] a2b_rd_ptr_b;\n\n  // Storage for A-to-B\n  reg [DSIZE-1:0] a2b_mem [0:DEPTH-1];\n\n  // Synchronize A's write pointer to B domain\n  reg [ASIZE:0] a2b_wr_ptr_b_sync1;\n  reg [ASIZE:0] a2b_wr_ptr_b_sync2;\n  reg [ASIZE:0] a2b_wr_ptr_b;\n\n  // Synchronize B's read pointer to A domain\n  reg [ASIZE:0] a2b_rd_ptr_a_sync1;\n  reg [ASIZE:0] a2b_rd_ptr_a_sync2;\n  reg [ASIZE:0] a2b_rd_ptr_a;\n\n  // B-side read data register\n  reg [DSIZE-1:0] a2b_rdata_b;\n\n  // --- B-to-A direction: B writes, A reads ---\n  // B-side write pointer\n  reg [ASIZE:0] b2a_wr_ptr_b;\n  // A-side read pointer\n  reg [ASIZE:0] b2a_rd_ptr_a;\n\n  // Storage for B-to-A\n  reg [DSIZE-1:0] b2a_mem [0:DEPTH-1];\n\n  // Synchronize B's write pointer to A domain\n  reg [ASIZE:0] b2a_wr_ptr_a_sync1;\n  reg [ASIZE:0] b2a_wr_ptr_a_sync2;\n  reg [ASIZE:0] b2a_wr_ptr_a;\n\n  // Synchronize A's read pointer to B domain\n  reg [ASIZE:0] b2a_rd_ptr_b_sync1;\n  reg [ASIZE:0] b2a_rd_ptr_b_sync2;\n  reg [ASIZE:0] b2a_rd_ptr_b;\n\n  // A-side read data register\n  reg [DSIZE-1:0] b2a_rdata_a;\n\n  // --- A domain logic ---\n\n  // A-to-B: A is writer\n  wire a2b_wr_en = a_dir & a_winc & ~a_full;\n  wire a2b_wr_addr = a2b_wr_ptr_a[ASIZE-1:0];\n\n  // B-to-A: A is reader\n  wire b2a_rd_en = ~a_dir & a_rinc & ~a_empty;\n  wire b2a_rd_addr = b2a_rd_ptr_a[ASIZE-1:0];\n\n  // A-to-B write\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a2b_wr_ptr_a <= {1'b0, {ASIZE{1'b0}}};\n    else if (a2b_wr_en)\n      a2b_wr_ptr_a <= a2b_wr_ptr_a + 1'b1;\n  end\n\n  always @(posedge a_clk) begin\n    if (a2b_wr_en)\n      a2b_mem[a2b_wr_addr] <= a_wdata;\n  end\n\n  // B-to-A read\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b2a_rd_ptr_a <= {1'b0, {ASIZE{1'b0}}};\n      b2a_rdata_a  <= {DSIZE{1'b0}};\n    end else if (b2a_rd_en) begin\n      b2a_rd_ptr_a <= b2a_rd_ptr_a + 1'b1;\n      b2a_rdata_a  <= b2a_mem[b2a_rd_addr];\n    end\n  end\n\n  // Synchronize B's read pointer (a2b_rd_ptr_b) to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a2b_rd_ptr_a_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      a2b_rd_ptr_a_sync2 <= {1'b0, {ASIZE{1'b0}}};\n      a2b_rd_ptr_a       <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      a2b_rd_ptr_a_sync1 <= a2b_rd_ptr_b;\n      a2b_rd_ptr_a_sync2 <= a2b_rd_ptr_a_sync1;\n      a2b_rd_ptr_a       <= a2b_rd_ptr_a_sync2;\n    end\n  end\n\n  // Synchronize A's read pointer (b2a_rd_ptr_a) to B domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b2a_rd_ptr_b_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      b2a_rd_ptr_b_sync2 <= {1'b0, {ASIZE{1'b0}}};\n      b2a_rd_ptr_b       <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      b2a_rd_ptr_b_sync1 <= b2a_rd_ptr_a;\n      b2a_rd_ptr_b_sync2 <= b2a_rd_ptr_b_sync1;\n      b2a_rd_ptr_b       <= b2a_rd_ptr_b_sync2;\n    end\n  end\n\n  // A-side status flags\n  // a_full: A-to-B FIFO full (A is writer)\n  wire [ASIZE:0] a2b_wr_ptr_a_ext = a2b_wr_ptr_a;\n  wire [ASIZE:0] a2b_rd_ptr_a_ext = a2b_rd_ptr_a;\n  wire a_full = (a2b_wr_ptr_a[ASIZE] != a2b_rd_ptr_a[ASIZE]) &&\n                (a2b_wr_ptr_a[ASIZE-1:0] == a2b_rd_ptr_a[ASIZE-1:0]);\n\n  wire a_afull = (a2b_wr_ptr_a[ASIZE-1:0] - a2b_rd_ptr_a[ASIZE-1:0]) >= AFULL_THRESH;\n\n  // a_empty: B-to-A FIFO empty (A is reader)\n  wire [ASIZE:0] b2a_wr_ptr_a_ext = b2a_wr_ptr_a;\n  wire [ASIZE:0] b2a_rd_ptr_a_ext = b2a_rd_ptr_a;\n  wire a_empty = (b2a_wr_ptr_a == b2a_rd_ptr_a);\n\n  wire a_aempty = (b2a_wr_ptr_a[ASIZE-1:0] - b2a_rd_ptr_a[ASIZE-1:0]) <= AEMPTY_THRESH;\n\n  // A-side read data\n  assign a_rdata = b2a_rdata_a;\n\n  // --- B domain logic ---\n\n  // A-to-B: B is reader\n  wire a2b_rd_en = ~b_dir & b_rinc & ~b_empty;\n  wire a2b_rd_addr = a2b_rd_ptr_b[ASIZE-1:0];\n\n  // B-to-A: B is writer\n  wire b2a_wr_en = b_dir & b_winc & ~b_full;\n  wire b2a_wr_addr = b2a_wr_ptr_b[ASIZE-1:0];\n\n  // A-to-B read\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a2b_rd_ptr_b <= {1'b0, {ASIZE{1'b0}}};\n      a2b_rdata_b  <= {DSIZE{1'b0}};\n    end else if (a2b_rd_en) begin\n      a2b_rd_ptr_b <= a2b_rd_ptr_b + 1'b1;\n      a2b_rdata_b  <= a2b_mem[a2b_rd_addr];\n    end\n  end\n\n  // B-to-A write\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b2a_wr_ptr_b <= {1'b0, {ASIZE{1'b0}}};\n    else if (b2a_wr_en)\n      b2a_wr_ptr_b <= b2a_wr_ptr_b + 1'b1;\n  end\n\n  always @(posedge b_clk) begin\n    if (b2a_wr_en)\n      b2a_mem[b2a_wr_addr] <= b_wdata;\n  end\n\n  // Synchronize A's write pointer (a2b_wr_ptr_a) to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a2b_wr_ptr_b_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      a2b_wr_ptr_b_sync2 <= {1'b0, {ASIZE{1'b0}}};\n      a2b_wr_ptr_b       <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      a2b_wr_ptr_b_sync1 <= a2b_wr_ptr_a;\n      a2b_wr_ptr_b_sync2 <= a2b_wr_ptr_b_sync1;\n      a2b_wr_ptr_b       <= a2b_wr_ptr_b_sync2;\n    end\n  end\n\n  // Synchronize B's write pointer (b2a_wr_ptr_b) to A domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b2a_wr_ptr_a_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      b2a_wr_ptr_a_sync2 <= {1'b0, {ASIZE{1'b0}}};\n      b2a_wr_ptr_a       <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      b2a_wr_ptr_a_sync1 <= b2a_wr_ptr_b;\n      b2a_wr_ptr_a_sync2 <= b2a_wr_ptr_a_sync1;\n      b2a_wr_ptr_a       <= b2a_wr_ptr_a_sync2;\n    end\n  end\n\n  // B-side status flags\n  // b_full: B-to-A FIFO full (B is writer)\n  wire b_full = (b2a_wr_ptr_b[ASIZE] != b2a_rd_ptr_b[ASIZE]) &&\n                (b2a_wr_ptr_b[ASIZE-1:0] == b2a_rd_ptr_b[ASIZE-1:0]);\n\n  wire b_afull = (b2a_wr_ptr_b[ASIZE-1:0] - b2a_rd_ptr_b[ASIZE-1:0]) >= AFULL_THRESH;\n\n  // b_empty: A-to-B FIFO empty (B is reader)\n  wire b_empty = (a2b_wr_ptr_b == a2b_rd_ptr_b);\n\n  wire b_aempty = (a2b_wr_ptr_b[ASIZE-1:0] - a2b_rd_ptr_b[ASIZE-1:0]) <= AEMPTY_THRESH;\n\n  // B-side read data\n  assign b_rdata = a2b_rdata_b;\n\nendmodule\n```<|im_end|>",
