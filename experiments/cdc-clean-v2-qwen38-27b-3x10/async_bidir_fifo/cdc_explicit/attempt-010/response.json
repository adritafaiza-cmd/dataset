  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam AFULL_THRESH  = DEPTH - 1;\n  localparam AEMPTY_THRESH = 1;\n\n  // ---------------------------------------------------------------------------\n  // Direction A: A writes to B\n  // ---------------------------------------------------------------------------\n  reg [DSIZE-1:0] a2b_mem [0:DEPTH-1];\n  reg [ASIZE:0]   a2b_wr_ptr_a;\n  reg [ASIZE:0]   a2b_rd_ptr_b;\n\n  // Synchronizer for write pointer (A -> B)\n  reg [ASIZE:0] a2b_wr_ptr_b_sync0;\n  reg [ASIZE:0] a2b_wr_ptr_b_sync1;\n  reg [ASIZE:0] a2b_wr_ptr_b_sync2;\n\n  // Synchronizer for read pointer (B -> A)\n  reg [ASIZE:0] a2b_rd_ptr_a_sync0;\n  reg [ASIZE:0] a2b_rd_ptr_a_sync1;\n  reg [ASIZE:0] a2b_rd_ptr_a_sync2;\n\n  // Data synchronizer for A->B (two destination-clock stages)\n  reg [DSIZE-1:0] a2b_data_b_sync0;\n  reg [DSIZE-1:0] a2b_data_b_sync1;\n  reg             a2b_valid_b_sync0;\n  reg             a2b_valid_b_sync1;\n\n  // ---------------------------------------------------------------------------\n  // Direction B: B writes to A\n  // ---------------------------------------------------------------------------\n  reg [DSIZE-1:0] b2a_mem [0:DEPTH-1];\n  reg [ASIZE:0]   b2a_wr_ptr_b;\n  reg [ASIZE:0]   b2a_rd_ptr_a;\n\n  // Synchronizer for write pointer (B -> A)\n  reg [ASIZE:0] b2a_wr_ptr_a_sync0;\n  reg [ASIZE:0] b2a_wr_ptr_a_sync1;\n  reg [ASIZE:0] b2a_wr_ptr_a_sync2;\n\n  // Synchronizer for read pointer (A -> B)\n  reg [ASIZE:0] b2a_rd_ptr_b_sync0;\n  reg [ASIZE:0] b2a_rd_ptr_b_sync1;\n  reg [ASIZE:0] b2a_rd_ptr_b_sync2;\n\n  // Data synchronizer for B->A (two destination-clock stages)\n  reg [DSIZE-1:0] b2a_data_a_sync0;\n  reg [DSIZE-1:0] b2a_data_a_sync1;\n  reg             b2a_valid_a_sync0;\n  reg             b2a_valid_a_sync1;\n\n  // ---------------------------------------------------------------------------\n  // A-side logic\n  // ---------------------------------------------------------------------------\n  wire a_is_writer = a_dir;\n  wire a_is_reader = ~a_dir;\n\n  // A writes to a2b when a_is_writer and a_winc\n  wire a2b_write = a_is_writer & a_winc;\n  // A reads from b2a when a_is_reader and a_rinc\n  wire b2a_read  = a_is_reader & a_rinc;\n\n  // A2B write pointer update\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a2b_wr_ptr_a <= {1'b0, {ASIZE{1'b0}}};\n    else if (a2b_write)\n      a2b_wr_ptr_a <= a2b_wr_ptr_a + 1'b1;\n  end\n\n  // A2B memory write\n  always @(posedge a_clk) begin\n    if (a2b_write)\n      a2b_mem[a2b_wr_ptr_a[ASIZE-1:0]] <= a_wdata;\n  end\n\n  // B2A read pointer update\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      b2a_rd_ptr_a <= {1'b0, {ASIZE{1'b0}}};\n    else if (b2a_read)\n      b2a_rd_ptr_a <= b2a_rd_ptr_a + 1'b1;\n  end\n\n  // B2A memory read (for A to read)\n  reg [DSIZE-1:0] b2a_rdata_a_reg;\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      b2a_rdata_a_reg <= {DSIZE{1'b0}};\n    else if (b2a_read)\n      b2a_rdata_a_reg <= b2a_mem[b2a_rd_ptr_a[ASIZE-1:0]];\n  end\n\n  // A-side read data output\n  assign a_rdata = b2a_rdata_a_reg;\n\n  // A-side full/empty flags\n  // a_full: A is writer, a2b is full\n  // a_empty: A is reader, b2a is empty\n  wire [ASIZE:0] a2b_wr_ptr_a_local = a2b_wr_ptr_a;\n  wire [ASIZE:0] a2b_rd_ptr_a_local = a2b_rd_ptr_a_sync2;\n  wire [ASIZE:0] b2a_wr_ptr_a_local = b2a_wr_ptr_a_sync2;\n  wire [ASIZE:0] b2a_rd_ptr_a_local = b2a_rd_ptr_a;\n\n  wire a2b_full_a  = (a2b_wr_ptr_a_local == a2b_rd_ptr_a_local + DEPTH);\n  wire a2b_empty_a = (a2b_wr_ptr_a_local == a2b_rd_ptr_a_local);\n  wire b2a_full_a  = (b2a_wr_ptr_a_local == b2a_rd_ptr_a_local + DEPTH);\n  wire b2a_empty_a = (b2a_wr_ptr_a_local == b2a_rd_ptr_a_local);\n\n  assign a_full   = a_is_writer ? a2b_full_a  : b2a_full_a;\n  assign a_empty  = a_is_reader ? b2a_empty_a : a2b_empty_a;\n\n  // Almost full/empty\n  wire [ASIZE:0] a2b_count_a = a2b_wr_ptr_a_local - a2b_rd_ptr_a_local;\n  wire [ASIZE:0] b2a_count_a = b2a_wr_ptr_a_local - b2a_rd_ptr_a_local;\n\n  assign a_afull  = a_is_writer ? (a2b_count_a >= AFULL_THRESH) : (b2a_count_a >= AFULL_THRESH);\n  assign a_aempty = a_is_reader ? (b2a_count_a <= AEMPTY_THRESH) : (a2b_count_a <= AEMPTY_THRESH);\n\n  // ---------------------------------------------------------------------------\n  // B-side logic\n  // ---------------------------------------------------------------------------\n  wire b_is_writer = b_dir;\n  wire b_is_reader = ~b_dir;\n\n  // B writes to b2a when b_is_writer and b_winc\n  wire b2a_write = b_is_writer & b_winc;\n  // B reads from a2b when b_is_reader and b_rinc\n  wire a2b_read  = b_is_reader & b_rinc;\n\n  // B2A write pointer update\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b2a_wr_ptr_b <= {1'b0, {ASIZE{1'b0}}};\n    else if (b2a_write)\n      b2a_wr_ptr_b <= b2a_wr_ptr_b + 1'b1;\n  end\n\n  // B2A memory write\n  always @(posedge b_clk) begin\n    if (b2a_write)\n      b2a_mem[b2a_wr_ptr_b[ASIZE-1:0]] <= b_wdata;\n  end\n\n  // A2B read pointer update\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      a2b_rd_ptr_b <= {1'b0, {ASIZE{1'b0}}};\n    else if (a2b_read)\n      a2b_rd_ptr_b <= a2b_rd_ptr_b + 1'b1;\n  end\n\n  // A2B memory read (for B to read)\n  reg [DSIZE-1:0] a2b_rdata_b_reg;\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      a2b_rdata_b_reg <= {DSIZE{1'b0}};\n    else if (a2b_read)\n      a2b_rdata_b_reg <= a2b_mem[a2b_rd_ptr_b[ASIZE-1:0]];\n  end\n\n  // B-side read data output\n  assign b_rdata = a2b_rdata_b_reg;\n\n  // B-side full/empty flags\n  wire [ASIZE:0] a2b_wr_ptr_b_local = a2b_wr_ptr_b_sync2;\n  wire [ASIZE:0] a2b_rd_ptr_b_local = a2b_rd_ptr_b;\n  wire [ASIZE:0] b2a_wr_ptr_b_local = b2a_wr_ptr_b;\n  wire [ASIZE:0] b2a_rd_ptr_b_local = b2a_rd_ptr_b_sync2;\n\n  wire a2b_full_b  = (a2b_wr_ptr_b_local == a2b_rd_ptr_b_local + DEPTH);\n  wire a2b_empty_b = (a2b_wr_ptr_b_local == a2b_rd_ptr_b_local);\n  wire b2a_full_b  = (b2a_wr_ptr_b_local == b2a_rd_ptr_b_local + DEPTH);\n  wire b2a_empty_b = (b2a_wr_ptr_b_local == b2a_rd_ptr_b_local);\n\n  assign b_full   = b_is_writer ? b2a_full_b  : a2b_full_b;\n  assign b_empty  = b_is_reader ? a2b_empty_b : b2a_empty_b;\n\n  // Almost full/empty\n  wire [ASIZE:0] a2b_count_b = a2b_wr_ptr_b_local - a2b_rd_ptr_b_local;\n  wire [ASIZE:0] b2a_count_b = b2a_wr_ptr_b_local - b2a_rd_ptr_b_local;\n\n  assign b_afull  = b_is_writer ? (b2a_count_b >= AFULL_THRESH) : (a2b_count_b >= AFULL_THRESH);\n  assign b_aempty = b_is_reader ? (a2b_count_b <= AEMPTY_THRESH) : (b2a_count_b <= AEMPTY_THRESH);\n\n  // ---------------------------------------------------------------------------\n  // CDC: Pointer synchronizers\n  // ---------------------------------------------------------------------------\n\n  // A2B write pointer: A -> B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a2b_wr_ptr_b_sync0 <= {1'b0, {ASIZE{1'b0}}};\n      a2b_wr_ptr_b_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      a2b_wr_ptr_b_sync2 <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      a2b_wr_ptr_b_sync0 <= a2b_wr_ptr_a;\n      a2b_wr_ptr_b_sync1 <= a2b_wr_ptr_b_sync0;\n      a2b_wr_ptr_b_sync2 <= a2b_wr_ptr_b_sync1;\n    end\n  end\n\n  // A2B read pointer: B -> A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a2b_rd_ptr_a_sync0 <= {1'b0, {ASIZE{1'b0}}};\n      a2b_rd_ptr_a_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      a2b_rd_ptr_a_sync2 <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      a2b_rd_ptr_a_sync0 <= a2b_rd_ptr_b;\n      a2b_rd_ptr_a_sync1 <= a2b_rd_ptr_a_sync0;\n      a2b_rd_ptr_a_sync2 <= a2b_rd_ptr_a_sync1;\n    end\n  end\n\n  // B2A write pointer: B -> A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b2a_wr_ptr_a_sync0 <= {1'b0, {ASIZE{1'b0}}};\n      b2a_wr_ptr_a_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      b2a_wr_ptr_a_sync2 <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      b2a_wr_ptr_a_sync0 <= b2a_wr_ptr_b;\n      b2a_wr_ptr_a_sync1 <= b2a_wr_ptr_a_sync0;\n      b2a_wr_ptr_a_sync2 <= b2a_wr_ptr_a_sync1;\n    end\n  end\n\n  // B2A read pointer: A -> B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b2a_rd_ptr_b_sync0 <= {1'b0, {ASIZE{1'b0}}};\n      b2a_rd_ptr_b_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      b2a_rd_ptr_b_sync2 <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      b2a_rd_ptr_b_sync0 <= b2a_rd_ptr_a;\n      b2a_rd_ptr_b_sync1 <= b2a_rd_ptr_b_sync0;\n      b2a_rd_ptr_b_sync2 <= b2a_rd_ptr_b_sync1;\n    end\n  end\n\n  // ---------------------------------------------------------------------------\n  // CDC: Data synchronizers (two destination-clock stages)\n  // ---------------------------------------------------------------------------\n\n  // A2B data: A -> B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a2b_data_b_sync0 <= {DSIZE{1'b0}};\n      a2b_data_b_sync1 <= {DSIZE{1'b0}};\n      a2b_valid_b_sync0 <= 1'b0;\n      a2b_valid_b_sync1 <= 1'b0;\n    end else begin\n      a2b_data_b_sync0 <= a2b_mem[a2b_wr_ptr_a[ASIZE-1:0]];\n      a2b_data_b_sync1 <= a2b_data_b_sync0;\n      a2b_valid_b_sync0 <= a2b_write;\n      a2b_valid_b_sync1 <= a2b_valid_b_sync0;\n    end\n  end\n\n  // B2A data: B -> A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b2a_data_a_sync0 <= {DSIZE{1'b0}};\n      b2a_data_a_sync1 <= {DSIZE{1'b0}};\n      b2a_valid_a_sync0 <= 1'b0;\n      b2a_valid_a_sync1 <= 1'b0;\n    end else begin\n      b2a_data_a_sync0 <= b2a_mem[b2a_wr_ptr_b[ASIZE-1:0]];\n      b2a_data_a_sync1 <= b2a_data_a_sync0;\n      b2a_valid_a_sync0 <= b2a_write;\n      b2a_valid_a_sync1 <= b2a_valid_a_sync0;\n    end\n  end\n\nendmodule\n```<|im_end|>",
