  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam PTR_W = ASIZE + 1;\n  localparam AFULL_THRESH  = DEPTH - 2;\n  localparam AEMPTY_THRESH = 2;\n\n  // Internal FIFO state for A->B direction\n  reg [DSIZE-1:0] fifo_ab [0:DEPTH-1];\n  reg [PTR_W-1:0] ab_wr_ptr_a;\n  reg [PTR_W-1:0] ab_rd_ptr_b;\n  reg [PTR_W-1:0] ab_wr_ptr_b_sync;\n  reg [PTR_W-1:0] ab_rd_ptr_a_sync;\n\n  // Internal FIFO state for B->A direction\n  reg [DSIZE-1:0] fifo_ba [0:DEPTH-1];\n  reg [PTR_W-1:0] ba_wr_ptr_b;\n  reg [PTR_W-1:0] ba_rd_ptr_a;\n  reg [PTR_W-1:0] ba_wr_ptr_a_sync;\n  reg [PTR_W-1:0] ba_rd_ptr_b_sync;\n\n  // Synchronization registers for A->B pointers\n  reg [PTR_W-1:0] ab_wr_ptr_b_sync_r1, ab_wr_ptr_b_sync_r2;\n  reg [PTR_W-1:0] ab_rd_ptr_a_sync_r1, ab_rd_ptr_a_sync_r2;\n\n  // Synchronization registers for B->A pointers\n  reg [PTR_W-1:0] ba_wr_ptr_a_sync_r1, ba_wr_ptr_a_sync_r2;\n  reg [PTR_W-1:0] ba_rd_ptr_b_sync_r1, ba_rd_ptr_b_sync_r2;\n\n  // Data synchronization for A->B (two-stage pipeline in B domain)\n  reg [DSIZE-1:0] ab_data_b_r1, ab_data_b_r2;\n  reg             ab_valid_b_r1, ab_valid_b_r2;\n\n  // Data synchronization for B->A (two-stage pipeline in A domain)\n  reg [DSIZE-1:0] ba_data_a_r1, ba_data_a_r2;\n  reg             ba_valid_a_r1, ba_valid_a_r2;\n\n  // Write enable signals\n  wire ab_wr_en_a;\n  wire ab_rd_en_b;\n  wire ba_wr_en_b;\n  wire ba_rd_en_a;\n\n  // Direction-based enables\n  assign ab_wr_en_a = a_dir & a_winc & ~a_full;\n  assign ab_rd_en_b = ~b_dir & b_rinc & ~b_empty;\n  assign ba_wr_en_b = b_dir & b_winc & ~b_full;\n  assign ba_rd_en_a = ~a_dir & a_rinc & ~a_empty;\n\n  // A domain: A->B write\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ab_wr_ptr_a <= {PTR_W{1'b0}};\n    end else if (ab_wr_en_a) begin\n      ab_wr_ptr_a <= ab_wr_ptr_a + 1'b1;\n    end\n  end\n\n  // A domain: B->A read\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ba_rd_ptr_a <= {PTR_W{1'b0}};\n    end else if (ba_rd_en_a) begin\n      ba_rd_ptr_a <= ba_rd_ptr_a + 1'b1;\n    end\n  end\n\n  // B domain: A->B read\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ab_rd_ptr_b <= {PTR_W{1'b0}};\n    end else if (ab_rd_en_b) begin\n      ab_rd_ptr_b <= ab_rd_ptr_b + 1'b1;\n    end\n  end\n\n  // B domain: B->A write\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ba_wr_ptr_b <= {PTR_W{1'b0}};\n    end else if (ba_wr_en_b) begin\n      ba_wr_ptr_b <= ba_wr_ptr_b + 1'b1;\n    end\n  end\n\n  // A domain: store data for A->B\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      // No reset needed for data, but we can leave it\n    end else if (ab_wr_en_a) begin\n      fifo_ab[ab_wr_ptr_a[ASIZE-1:0]] <= a_wdata;\n    end\n  end\n\n  // B domain: store data for B->A\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      // No reset needed for data\n    end else if (ba_wr_en_b) begin\n      fifo_ba[ba_wr_ptr_b[ASIZE-1:0]] <= b_wdata;\n    end\n  end\n\n  // A domain: read data for B->A (output to A side)\n  wire [DSIZE-1:0] ba_rd_data_a;\n  assign ba_rd_data_a = fifo_ba[ba_rd_ptr_a[ASIZE-1:0]];\n\n  // B domain: read data for A->B (output to B side)\n  wire [DSIZE-1:0] ab_rd_data_b;\n  assign ab_rd_data_b = fifo_ab[ab_rd_ptr_b[ASIZE-1:0]];\n\n  // Synchronize A->B write pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ab_wr_ptr_b_sync_r1 <= {PTR_W{1'b0}};\n      ab_wr_ptr_b_sync_r2 <= {PTR_W{1'b0}};\n    end else begin\n      ab_wr_ptr_b_sync_r1 <= ab_wr_ptr_a;\n      ab_wr_ptr_b_sync_r2 <= ab_wr_ptr_b_sync_r1;\n    end\n  end\n  assign ab_wr_ptr_b_sync = ab_wr_ptr_b_sync_r2;\n\n  // Synchronize A->B read pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ab_rd_ptr_a_sync_r1 <= {PTR_W{1'b0}};\n      ab_rd_ptr_a_sync_r2 <= {PTR_W{1'b0}};\n    end else begin\n      ab_rd_ptr_a_sync_r1 <= ab_rd_ptr_b;\n      ab_rd_ptr_a_sync_r2 <= ab_rd_ptr_a_sync_r1;\n    end\n  end\n  assign ab_rd_ptr_a_sync = ab_rd_ptr_a_sync_r2;\n\n  // Synchronize B->A write pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ba_wr_ptr_a_sync_r1 <= {PTR_W{1'b0}};\n      ba_wr_ptr_a_sync_r2 <= {PTR_W{1'b0}};\n    end else begin\n      ba_wr_ptr_a_sync_r1 <= ba_wr_ptr_b;\n      ba_wr_ptr_a_sync_r2 <= ba_wr_ptr_a_sync_r1;\n    end\n  end\n  assign ba_wr_ptr_a_sync = ba_wr_ptr_a_sync_r2;\n\n  // Synchronize B->A read pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ba_rd_ptr_b_sync_r1 <= {PTR_W{1'b0}};\n      ba_rd_ptr_b_sync_r2 <= {PTR_W{1'b0}};\n    end else begin\n      ba_rd_ptr_b_sync_r1 <= ba_rd_ptr_a;\n      ba_rd_ptr_b_sync_r2 <= ba_rd_ptr_b_sync_r1;\n    end\n  end\n  assign ba_rd_ptr_b_sync = ba_rd_ptr_b_sync_r2;\n\n  // Data pipeline for A->B: capture data in B domain when read\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ab_data_b_r1 <= {DSIZE{1'b0}};\n      ab_data_b_r2 <= {DSIZE{1'b0}};\n      ab_valid_b_r1 <= 1'b0;\n      ab_valid_b_r2 <= 1'b0;\n    end else begin\n      if (ab_rd_en_b) begin\n        ab_data_b_r1 <= ab_rd_data_b;\n        ab_valid_b_r1 <= 1'b1;\n      end else begin\n        ab_valid_b_r1 <= 1'b0;\n      end\n      ab_data_b_r2 <= ab_data_b_r1;\n      ab_valid_b_r2 <= ab_valid_b_r1;\n    end\n  end\n\n  // Data pipeline for B->A: capture data in A domain when read\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ba_data_a_r1 <= {DSIZE{1'b0}};\n      ba_data_a_r2 <= {DSIZE{1'b0}};\n      ba_valid_a_r1 <= 1'b0;\n      ba_valid_a_r2 <= 1'b0;\n    end else begin\n      if (ba_rd_en_a) begin\n        ba_data_a_r1 <= ba_rd_data_a;\n        ba_valid_a_r1 <= 1'b1;\n      end else begin\n        ba_valid_a_r1 <= 1'b0;\n      end\n      ba_data_a_r2 <= ba_data_a_r1;\n      ba_valid_a_r2 <= ba_valid_a_r1;\n    end\n  end\n\n  // Output data\n  assign a_rdata = ba_data_a_r2;\n  assign b_rdata = ab_data_b_r2;\n\n  // Status flags\n  wire [PTR_W-1:0] ab_count_a;\n  wire [PTR_W-1:0] ab_count_b;\n  wire [PTR_W-1:0] ba_count_a;\n  wire [PTR_W-1:0] ba_count_b;\n\n  assign ab_count_a = ab_wr_ptr_a - ab_rd_ptr_a_sync;\n  assign ab_count_b = ab_wr_ptr_b_sync - ab_rd_ptr_b;\n  assign ba_count_a = ba_wr_ptr_a_sync - ba_rd_ptr_a;\n  assign ba_count_b = ba_wr_ptr_b - ba_rd_ptr_b_sync;\n\n  // A side: A is writer for A->B, reader for B->A\n  assign a_full   = (ab_count_a == DEPTH);\n  assign a_afull  = (ab_count_a >= AFULL_THRESH);\n  assign a_empty  = (ba_count_a == 0);\n  assign a_aempty = (ba_count_a <= AEMPTY_THRESH);\n\n  // B side: B is reader for A->B, writer for B->A\n  assign b_full   = (ba_count_b == DEPTH);\n  assign b_afull  = (ba_count_b >= AFULL_THRESH);\n  assign b_empty  = (ab_count_b == 0);\n  assign b_aempty = (ab_count_b <= AEMPTY_THRESH);\n\nendmodule\n```<|im_end|>",
