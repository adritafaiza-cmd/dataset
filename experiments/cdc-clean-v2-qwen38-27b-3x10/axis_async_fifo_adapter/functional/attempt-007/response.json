  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    wire s_wr_en;\n    wire m_rd_en;\n    wire s_full;\n    wire m_empty;\n    wire s_overflow;\n    wire m_overflow;\n    wire s_bad_frame;\n    wire m_bad_frame;\n    wire s_good_frame;\n    wire m_good_frame;\n    wire s_pause_active;\n    wire m_pause_active;\n\n    // Write side (s_clk domain)\n    reg [PTR_WIDTH-1:0] s_wr_ptr;\n    reg [PTR_WIDTH-1:0] s_rd_ptr_sync;\n    reg [PTR_WIDTH-1:0] s_rd_ptr_sync2;\n    reg [PTR_WIDTH-1:0] s_rd_ptr_sync3;\n    reg [ADDR_WIDTH-1:0] s_wr_addr;\n    reg [S_DATA_WIDTH-1:0] s_wr_data;\n    reg [S_KEEP_WIDTH-1:0] s_wr_keep;\n    reg s_wr_tlast;\n    reg [ID_WIDTH-1:0] s_wr_tid;\n    reg [DEST_WIDTH-1:0] s_wr_tdest;\n    reg [USER_WIDTH-1:0] s_wr_tuser;\n    reg s_wr_overflow;\n    reg s_wr_bad_frame;\n    reg s_wr_good_frame;\n\n    // Read side (m_clk domain)\n    reg [PTR_WIDTH-1:0] m_rd_ptr;\n    reg [PTR_WIDTH-1:0] m_wr_ptr_sync;\n    reg [PTR_WIDTH-1:0] m_wr_ptr_sync2;\n    reg [PTR_WIDTH-1:0] m_wr_ptr_sync3;\n    reg [ADDR_WIDTH-1:0] m_rd_addr;\n    reg [M_DATA_WIDTH-1:0] m_rd_data;\n    reg [M_KEEP_WIDTH-1:0] m_rd_keep;\n    reg m_rd_tlast;\n    reg [ID_WIDTH-1:0] m_rd_tid;\n    reg [DEST_WIDTH-1:0] m_rd_tdest;\n    reg [USER_WIDTH-1:0] m_rd_tuser;\n    reg m_rd_overflow;\n    reg m_rd_bad_frame;\n    reg m_rd_good_frame;\n\n    // RAM storage\n    reg [S_DATA_WIDTH-1:0] ram_data [0:DEPTH-1];\n    reg [S_KEEP_WIDTH-1:0] ram_keep [0:DEPTH-1];\n    reg ram_tlast [0:DEPTH-1];\n    reg [ID_WIDTH-1:0] ram_tid [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0] ram_tdest [0:DEPTH-1];\n    reg [USER_WIDTH-1:0] ram_tuser [0:DEPTH-1];\n    reg ram_overflow [0:DEPTH-1];\n    reg ram_bad_frame [0:DEPTH-1];\n    reg ram_good_frame [0:DEPTH-1];\n\n    // Write address\n    assign s_wr_addr = s_wr_ptr[ADDR_WIDTH-1:0];\n\n    // Read address\n    assign m_rd_addr = m_rd_ptr[ADDR_WIDTH-1:0];\n\n    // Synchronization of read pointer to write domain\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_rd_ptr_sync <= {PTR_WIDTH{1'b0}};\n            s_rd_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            s_rd_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            s_rd_ptr_sync <= m_rd_ptr;\n            s_rd_ptr_sync2 <= s_rd_ptr_sync;\n            s_rd_ptr_sync3 <= s_rd_ptr_sync2;\n        end\n    end\n\n    // Synchronization of write pointer to read domain\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_wr_ptr_sync <= {PTR_WIDTH{1'b0}};\n            m_wr_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            m_wr_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            m_wr_ptr_sync <= s_wr_ptr;\n            m_wr_ptr_sync2 <= m_wr_ptr_sync;\n            m_wr_ptr_sync3 <= m_wr_ptr_sync2;\n        end\n    end\n\n    // Full/Empty detection\n    wire s_full = (s_wr_ptr == s_rd_ptr_sync3) && (s_wr_ptr[PTR_WIDTH-1] != s_rd_ptr_sync3[PTR_WIDTH-1]);\n    wire m_empty = (m_rd_ptr == m_wr_ptr_sync3);\n\n    // Pause logic\n    wire s_pause = PAUSE_ENABLE ? s_pause_req : 1'b0;\n    wire m_pause = PAUSE_ENABLE ? m_pause_req : 1'b0;\n\n    // Write enable\n    assign s_wr_en = s_axis_tvalid && s_axis_tready && !s_pause;\n\n    // Read enable\n    assign m_rd_en = m_axis_tvalid && m_axis_tready && !m_pause;\n\n    // Write pointer update\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (s_wr_en) begin\n            s_wr_ptr <= s_wr_ptr + 1'b1;\n        end\n    end\n\n    // Read pointer update\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (m_rd_en) begin\n            m_rd_ptr <= m_rd_ptr + 1'b1;\n        end\n    end\n\n    // Write data to RAM\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_overflow <= 1'b0;\n            s_wr_bad_frame <= 1'b0;\n            s_wr_good_frame <= 1'b0;\n        end else if (s_wr_en) begin\n            ram_data[s_wr_addr] <= s_axis_tdata;\n            ram_keep[s_wr_addr] <= s_axis_tkeep;\n            ram_tlast[s_wr_addr] <= s_axis_tlast;\n            ram_tid[s_wr_addr] <= s_axis_tid;\n            ram_tdest[s_wr_addr] <= s_axis_tdest;\n            ram_tuser[s_wr_addr] <= s_axis_tuser;\n            \n            // Overflow detection\n            if (s_full && DROP_WHEN_FULL) begin\n                s_wr_overflow <= 1'b1;\n            end else begin\n                s_wr_overflow <= 1'b0;\n            end\n            \n            // Frame detection\n            if (s_axis_tlast) begin\n                // Check for bad frame\n                if (USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                    s_wr_bad_frame <= 1'b1;\n                    s_wr_good_frame <= 1'b0;\n                end else begin\n                    s_wr_bad_frame <= 1'b0;\n                    s_wr_good_frame <= 1'b1;\n                end\n            end else begin\n                s_wr_bad_frame <= 1'b0;\n                s_wr_good_frame <= 1'b0;\n            end\n        end\n    end\n\n    // Read data from RAM\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_overflow <= 1'b0;\n            m_rd_bad_frame <= 1'b0;\n            m_rd_good_frame <= 1'b0;\n        end else if (m_rd_en) begin\n            m_rd_overflow <= ram_overflow[m_rd_addr];\n            m_rd_bad_frame <= ram_bad_frame[m_rd_addr];\n            m_rd_good_frame <= ram_good_frame[m_rd_addr];\n        end\n    end\n\n    // Width adapter: Convert S_DATA_WIDTH to M_DATA_WIDTH\n    // For simplicity, we assume S_DATA_WIDTH == M_DATA_WIDTH or handle basic cases\n    // In a real implementation, this would be more complex\n    wire [M_DATA_WIDTH-1:0] adapted_data;\n    wire [M_KEEP_WIDTH-1:0] adapted_keep;\n    \n    // Simple passthrough if widths match, otherwise truncate/extend\n    generate\n        if (S_DATA_WIDTH == M_DATA_WIDTH) begin\n            assign adapted_data = ram_data[m_rd_addr];\n            assign adapted_keep = ram_keep[m_rd_addr];\n        end else if (S_DATA_WIDTH > M_DATA_WIDTH) begin\n            assign adapted_data = ram_data[m_rd_addr][M_DATA_WIDTH-1:0];\n            assign adapted_keep = ram_keep[m_rd_addr][M_KEEP_WIDTH-1:0];\n        end else begin\n            assign adapted_data = {ram_data[m_rd_addr], {(M_DATA_WIDTH-S_DATA_WIDTH){1'b0}}};\n            assign adapted_keep = {ram_keep[m_rd_addr], {(M_KEEP_WIDTH-S_KEEP_WIDTH){1'b0}}};\n        end\n    endgenerate\n\n    // Output signals\n    assign m_axis_tdata = adapted_data;\n    assign m_axis_tkeep = adapted_keep;\n    assign m_axis_tvalid = !m_empty;\n    assign m_axis_tlast = ram_tlast[m_rd_addr];\n    assign m_axis_tid = ram_tid[m_rd_addr];\n    assign m_axis_tdest = ram_tdest[m_rd_addr];\n    assign m_axis_tuser = ram_tuser[m_rd_addr];\n\n    // Input ready\n    assign s_axis_tready = !s_full && !s_pause;\n\n    // Pause ack\n    assign s_pause_ack = s_pause;\n    assign m_pause_ack = m_pause;\n\n    // Status signals\n    wire [$clog2(DEPTH):0] s_depth = s_wr_ptr - s_rd_ptr_sync3;\n    wire [$clog2(DEPTH):0] m_depth = m_wr_ptr_sync3 - m_rd_ptr;\n\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth;\n    assign s_status_overflow = s_wr_overflow;\n    assign s_status_bad_frame = s_wr_bad_frame;\n    assign s_status_good_frame = s_wr_good_frame;\n\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth;\n    assign m_status_overflow = m_rd_overflow;\n    assign m_status_bad_frame = m_rd_bad_frame;\n    assign m_status_good_frame = m_rd_good_frame;\n\nendmodule\n```<|im_end|>",
