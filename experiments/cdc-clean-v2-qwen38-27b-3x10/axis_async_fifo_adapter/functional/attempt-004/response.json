  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    wire s_wr_en;\n    wire m_rd_en;\n    wire s_full;\n    wire m_empty;\n    wire [S_DATA_WIDTH-1:0] s_wr_data;\n    wire [S_KEEP_WIDTH-1:0] s_wr_keep;\n    wire s_wr_last;\n    wire [ID_WIDTH-1:0] s_wr_id;\n    wire [DEST_WIDTH-1:0] s_wr_dest;\n    wire [USER_WIDTH-1:0] s_wr_user;\n\n    wire [M_DATA_WIDTH-1:0] m_rd_data;\n    wire [M_KEEP_WIDTH-1:0] m_rd_keep;\n    wire m_rd_last;\n    wire [ID_WIDTH-1:0] m_rd_id;\n    wire [DEST_WIDTH-1:0] m_rd_dest;\n    wire [USER_WIDTH-1:0] m_rd_user;\n\n    // Pause logic\n    reg s_paused = 1'b0;\n    reg m_paused = 1'b0;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            s_paused <= 1'b0;\n        else if (PAUSE_ENABLE)\n            s_paused <= s_pause_req;\n        else\n            s_paused <= 1'b0;\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            m_paused <= 1'b0;\n        else if (PAUSE_ENABLE)\n            m_paused <= m_pause_req;\n        else\n            m_paused <= 1'b0;\n    end\n\n    assign s_pause_ack = s_paused;\n    assign m_pause_ack = m_paused;\n\n    // Write enable: valid, not full, not paused\n    assign s_wr_en = s_axis_tvalid & ~s_full & ~s_paused;\n\n    // Read enable: not empty, ready, not paused\n    assign m_rd_en = ~m_empty & m_axis_tready & ~m_paused;\n\n    // Write data\n    assign s_wr_data = s_axis_tdata;\n    assign s_wr_keep = s_axis_tkeep;\n    assign s_wr_last = s_axis_tlast;\n    assign s_wr_id = s_axis_tid;\n    assign s_wr_dest = s_axis_tdest;\n    assign s_wr_user = s_axis_tuser;\n\n    // Read data\n    assign m_rd_data = m_axis_tdata;\n    assign m_rd_keep = m_axis_tkeep;\n    assign m_rd_last = m_axis_tlast;\n    assign m_rd_id = m_axis_tid;\n    assign m_rd_dest = m_axis_tdest;\n    assign m_rd_user = m_axis_tuser;\n\n    // Status\n    assign s_status_overflow = s_axis_tvalid & s_full;\n    assign m_status_overflow = 1'b0; // Not applicable for read side in this context\n    assign s_status_bad_frame = 1'b0;\n    assign s_status_good_frame = 1'b0;\n    assign m_status_bad_frame = 1'b0;\n    assign m_status_good_frame = 1'b0;\n\n    // Depth calculation\n    wire [PTR_WIDTH-1:0] s_wr_ptr;\n    wire [PTR_WIDTH-1:0] m_rd_ptr;\n    wire [PTR_WIDTH-1:0] s_wr_ptr_m;\n    wire [PTR_WIDTH-1:0] m_rd_ptr_s;\n\n    // Async FIFO core\n    async_fifo #(\n        .DEPTH(DEPTH),\n        .DATA_WIDTH(S_DATA_WIDTH + S_KEEP_WIDTH + 1 + ID_WIDTH + DEST_WIDTH + USER_WIDTH)\n    ) u_fifo (\n        .wr_clk(s_clk),\n        .wr_rst(s_rst),\n        .wr_en(s_wr_en),\n        .wr_data({s_wr_user, s_wr_dest, s_wr_id, s_wr_last, s_wr_keep, s_wr_data}),\n        .full(s_full),\n        .rd_clk(m_clk),\n        .rd_rst(m_rst),\n        .rd_en(m_rd_en),\n        .rd_data({m_rd_user, m_rd_dest, m_rd_id, m_rd_last, m_rd_keep, m_rd_data}),\n        .empty(m_empty)\n    );\n\n    // Pointer synchronization for depth\n    // Write pointer to master clock\n    wire [PTR_WIDTH-1:0] s_wr_ptr_sync1;\n    wire [PTR_WIDTH-1:0] s_wr_ptr_sync2;\n    wire [PTR_WIDTH-1:0] s_wr_ptr_sync3;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_wr_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            s_wr_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            s_wr_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            s_wr_ptr_sync1 <= s_wr_ptr;\n            s_wr_ptr_sync2 <= s_wr_ptr_sync1;\n            s_wr_ptr_sync3 <= s_wr_ptr_sync2;\n        end\n    end\n    assign s_wr_ptr_m = s_wr_ptr_sync3;\n\n    // Read pointer to slave clock\n    wire [PTR_WIDTH-1:0] m_rd_ptr_sync1;\n    wire [PTR_WIDTH-1:0] m_rd_ptr_sync2;\n    wire [PTR_WIDTH-1:0] m_rd_ptr_sync3;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            m_rd_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            m_rd_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            m_rd_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            m_rd_ptr_sync1 <= m_rd_ptr;\n            m_rd_ptr_sync2 <= m_rd_ptr_sync1;\n            m_rd_ptr_sync3 <= m_rd_ptr_sync2;\n        end\n    end\n    assign m_rd_ptr_s = m_rd_ptr_sync3;\n\n    // Depth in slave clock domain\n    wire [PTR_WIDTH-1:0] s_depth_raw = s_wr_ptr - m_rd_ptr_s;\n    assign s_status_depth = s_depth_raw[PTR_WIDTH-1:0];\n    assign s_status_depth_commit = s_depth_raw[PTR_WIDTH-1:0];\n\n    // Depth in master clock domain\n    wire [PTR_WIDTH-1:0] m_depth_raw = s_wr_ptr_m - m_rd_ptr;\n    assign m_status_depth = m_depth_raw[PTR_WIDTH-1:0];\n    assign m_status_depth_commit = m_depth_raw[PTR_WIDTH-1:0];\n\n    // tready\n    assign s_axis_tready = ~s_full & ~s_paused;\n\n    // tvalid\n    assign m_axis_tvalid = ~m_empty & ~m_paused;\n\nendmodule\n\n// Simple async FIFO implementation\nmodule async_fifo #(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8\n) (\n    input wire wr_clk,\n    input wire wr_rst,\n    input wire wr_en,\n    input wire [DATA_WIDTH-1:0] wr_data,\n    output wire full,\n    input wire rd_clk,\n    input wire rd_rst,\n    input wire rd_en,\n    output wire [DATA_WIDTH-1:0] rd_data,\n    output wire empty\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Write pointer\n    reg [PTR_WIDTH-1:0] wr_ptr = {PTR_WIDTH{1'b0}};\n    wire [ADDR_WIDTH-1:0] wr_addr = wr_ptr[ADDR_WIDTH-1:0];\n\n    // Read pointer\n    reg [PTR_WIDTH-1:0] rd_ptr = {PTR_WIDTH{1'b0}};\n    wire [ADDR_WIDTH-1:0] rd_addr = rd_ptr[ADDR_WIDTH-1:0];\n\n    // Write pointer synchronization to read clock\n    reg [PTR_WIDTH-1:0] wr_ptr_sync1 = {PTR_WIDTH{1'b0}};\n    reg [PTR_WIDTH-1:0] wr_ptr_sync2 = {PTR_WIDTH{1'b0}};\n    reg [PTR_WIDTH-1:0] wr_ptr_sync3 = {PTR_WIDTH{1'b0}};\n\n    always @(posedge rd_clk or posedge rd_rst) begin\n        if (rd_rst) begin\n            wr_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            wr_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            wr_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            wr_ptr_sync1 <= wr_ptr;\n            wr_ptr_sync2 <= wr_ptr_sync1;\n            wr_ptr_sync3 <= wr_ptr_sync2;\n        end\n    end\n\n    // Read pointer synchronization to write clock\n    reg [PTR_WIDTH-1:0] rd_ptr_sync1 = {PTR_WIDTH{1'b0}};\n    reg [PTR_WIDTH-1:0] rd_ptr_sync2 = {PTR_WIDTH{1'b0}};\n    reg [PTR_WIDTH-1:0] rd_ptr_sync3 = {PTR_WIDTH{1'b0}};\n\n    always @(posedge wr_clk or posedge wr_rst) begin\n        if (wr_rst) begin\n            rd_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            rd_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            rd_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            rd_ptr_sync1 <= rd_ptr;\n            rd_ptr_sync2 <= rd_ptr_sync1;\n            rd_ptr_sync3 <= rd_ptr_sync2;\n        end\n    end\n\n    // Full and empty detection\n    wire [PTR_WIDTH-1:0] wr_ptr_rd = wr_ptr_sync3;\n    wire [PTR_WIDTH-1:0] rd_ptr_wr = rd_ptr_sync3;\n\n    assign full = (wr_ptr[ADDR_WIDTH] != rd_ptr_wr[ADDR_WIDTH]) && \n                  (wr_ptr[ADDR_WIDTH-1:0] == rd_ptr_wr[ADDR_WIDTH-1:0]);\n    assign empty = (rd_ptr == wr_ptr_rd);\n\n    // Write logic\n    always @(posedge wr_clk or posedge wr_rst) begin\n        if (wr_rst)\n            wr_ptr <= {PTR_WIDTH{1'b0}};\n        else if (wr_en && !full)\n            wr_ptr <= wr_ptr + 1'b1;\n    end\n\n    always @(posedge wr_clk) begin\n        if (wr_en && !full)\n            mem[wr_addr] <= wr_data;\n    end\n\n    // Read logic\n    always @(posedge rd_clk or posedge rd_rst) begin\n        if (rd_rst)\n            rd_ptr <= {PTR_WIDTH{1'b0}};\n        else if (rd_en && !empty)\n            rd_ptr <= rd_ptr + 1'b1;\n    end\n\n    assign rd_data = mem[rd_addr];\n\nendmodule\n```<|im_end|>",
