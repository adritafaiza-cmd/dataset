  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    wire s_wr_en;\n    wire m_rd_en;\n    wire s_full;\n    wire m_empty;\n    wire s_overflow;\n    wire m_overflow;\n    wire s_bad_frame;\n    wire m_bad_frame;\n    wire s_good_frame;\n    wire m_good_frame;\n    wire s_pause_active;\n    wire m_pause_active;\n\n    // Synchronous FIFO core\n    wire [S_DATA_WIDTH-1:0] fifo_tdata;\n    wire [S_KEEP_WIDTH-1:0] fifo_tkeep;\n    wire fifo_tlast;\n    wire [ID_WIDTH-1:0] fifo_tid;\n    wire [DEST_WIDTH-1:0] fifo_tdest;\n    wire [USER_WIDTH-1:0] fifo_tuser;\n\n    // Width adapter signals\n    wire [M_DATA_WIDTH-1:0] adapter_tdata;\n    wire [M_KEEP_WIDTH-1:0] adapter_tkeep;\n    wire adapter_tlast;\n    wire [ID_WIDTH-1:0] adapter_tid;\n    wire [DEST_WIDTH-1:0] adapter_tdest;\n    wire [USER_WIDTH-1:0] adapter_tuser;\n    wire adapter_valid;\n    wire adapter_ready;\n\n    // Pause logic\n    assign s_pause_active = PAUSE_ENABLE ? s_pause_req : 1'b0;\n    assign m_pause_active = PAUSE_ENABLE ? m_pause_req : 1'b0;\n    assign s_pause_ack = PAUSE_ENABLE ? s_pause_req : 1'b0;\n    assign m_pause_ack = PAUSE_ENABLE ? m_pause_req : 1'b0;\n\n    // Synchronous FIFO instantiation\n    sync_fifo #(\n        .DEPTH(DEPTH),\n        .DATA_WIDTH(S_DATA_WIDTH + S_KEEP_WIDTH + 1 + ID_WIDTH + DEST_WIDTH + USER_WIDTH)\n    ) u_fifo (\n        .clk(s_clk),\n        .rst(s_rst),\n        .wr_en(s_wr_en),\n        .rd_en(m_rd_en),\n        .dout({fifo_tuser, fifo_tdest, fifo_tid, fifo_tlast, fifo_tkeep, fifo_tdata}),\n        .full(s_full),\n        .empty(m_empty)\n    );\n\n    // Write enable logic\n    wire s_accept = s_axis_tvalid && s_axis_tready;\n    assign s_wr_en = s_accept && !s_pause_active;\n    assign s_axis_tready = !s_full && !s_pause_active;\n\n    // Overflow detection\n    assign s_overflow = s_axis_tvalid && s_full && !s_pause_active;\n    assign m_overflow = 1'b0;\n\n    // Frame status\n    assign s_bad_frame = 1'b0;\n    assign m_bad_frame = 1'b0;\n    assign s_good_frame = s_accept && s_axis_tlast;\n    assign m_good_frame = m_rd_en && fifo_tlast;\n\n    // Depth status\n    wire [PTR_WIDTH-1:0] s_wr_ptr;\n    wire [PTR_WIDTH-1:0] m_rd_ptr;\n    wire [PTR_WIDTH-1:0] s_wr_ptr_sync;\n    wire [PTR_WIDTH-1:0] m_rd_ptr_sync;\n\n    // Pointer synchronization\n    sync_ptr #(.WIDTH(PTR_WIDTH)) u_s_wr_ptr_sync (\n        .clk(m_clk),\n        .rst(m_rst),\n        .din(s_wr_ptr),\n        .dout(s_wr_ptr_sync)\n    );\n\n    sync_ptr #(.WIDTH(PTR_WIDTH)) u_m_rd_ptr_sync (\n        .clk(s_clk),\n        .rst(s_rst),\n        .din(m_rd_ptr),\n        .dout(m_rd_ptr_sync)\n    );\n\n    // Pointer generation\n    reg [PTR_WIDTH-1:0] s_wr_ptr_reg;\n    reg [PTR_WIDTH-1:0] m_rd_ptr_reg;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            s_wr_ptr_reg <= {PTR_WIDTH{1'b0}};\n        else if (s_wr_en)\n            s_wr_ptr_reg <= s_wr_ptr_reg + 1'b1;\n    end\n    assign s_wr_ptr = s_wr_ptr_reg;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            m_rd_ptr_reg <= {PTR_WIDTH{1'b0}};\n        else if (m_rd_en)\n            m_rd_ptr_reg <= m_rd_ptr_reg + 1'b1;\n    end\n    assign m_rd_ptr = m_rd_ptr_reg;\n\n    // Depth calculation\n    wire [PTR_WIDTH-1:0] s_depth_raw = s_wr_ptr - m_rd_ptr_sync;\n    wire [PTR_WIDTH-1:0] m_depth_raw = s_wr_ptr_sync - m_rd_ptr;\n    assign s_status_depth = s_depth_raw[ADDR_WIDTH:0];\n    assign s_status_depth_commit = s_depth_raw[ADDR_WIDTH:0];\n    assign m_status_depth = m_depth_raw[ADDR_WIDTH:0];\n    assign m_status_depth_commit = m_depth_raw[ADDR_WIDTH:0];\n\n    // Width adapter\n    width_adapter #(\n        .S_DATA_WIDTH(S_DATA_WIDTH),\n        .S_KEEP_ENABLE(S_KEEP_ENABLE),\n        .S_KEEP_WIDTH(S_KEEP_WIDTH),\n        .M_DATA_WIDTH(M_DATA_WIDTH),\n        .M_KEEP_ENABLE(M_KEEP_ENABLE),\n        .M_KEEP_WIDTH(M_KEEP_WIDTH),\n        .ID_ENABLE(ID_ENABLE),\n        .ID_WIDTH(ID_WIDTH),\n        .DEST_ENABLE(DEST_ENABLE),\n        .DEST_WIDTH(DEST_WIDTH),\n        .USER_ENABLE(USER_ENABLE),\n        .USER_WIDTH(USER_WIDTH)\n    ) u_adapter (\n        .clk(m_clk),\n        .rst(m_rst),\n        .s_valid(!m_empty),\n        .s_ready(adapter_ready),\n        .s_tdata(fifo_tdata),\n        .s_tkeep(fifo_tkeep),\n        .s_tlast(fifo_tlast),\n        .s_tid(fifo_tid),\n        .s_tdest(fifo_tdest),\n        .s_tuser(fifo_tuser),\n        .m_valid(adapter_valid),\n        .m_ready(m_axis_tready),\n        .m_tdata(adapter_tdata),\n        .m_tkeep(adapter_tkeep),\n        .m_tlast(adapter_tlast),\n        .m_tid(adapter_tid),\n        .m_tdest(adapter_tdest),\n        .m_tuser(adapter_tuser)\n    );\n\n    // Output assignment\n    assign m_axis_tdata = adapter_tdata;\n    assign m_axis_tkeep = adapter_tkeep;\n    assign m_axis_tvalid = adapter_valid && !m_pause_active;\n    assign m_axis_tlast = adapter_tlast;\n    assign m_axis_tid = adapter_tid;\n    assign m_axis_tdest = adapter_tdest;\n    assign m_axis_tuser = adapter_tuser;\n\n    // Read enable\n    assign m_rd_en = adapter_ready && !m_empty && !m_pause_active;\n\nendmodule\n\n// Synchronous FIFO\nmodule sync_fifo #(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8\n) (\n    input  wire                  clk,\n    input  wire                  rst,\n    input  wire                  wr_en,\n    input  wire                  rd_en,\n    input  wire [DATA_WIDTH-1:0] din,\n    output wire [DATA_WIDTH-1:0] dout,\n    output wire                  full,\n    output wire                  empty\n);\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n    reg [ADDR_WIDTH-1:0] wr_addr;\n    reg [ADDR_WIDTH-1:0] rd_addr;\n    reg [PTR_WIDTH-1:0] wr_ptr;\n    reg [PTR_WIDTH-1:0] rd_ptr;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            wr_addr <= {ADDR_WIDTH{1'b0}};\n            rd_addr <= {ADDR_WIDTH{1'b0}};\n            wr_ptr <= {PTR_WIDTH{1'b0}};\n            rd_ptr <= {PTR_WIDTH{1'b0}};\n        end else begin\n            if (wr_en) begin\n                mem[wr_addr] <= din;\n                wr_addr <= wr_addr + 1'b1;\n                wr_ptr <= wr_ptr + 1'b1;\n            end\n            if (rd_en) begin\n                rd_addr <= rd_addr + 1'b1;\n                rd_ptr <= rd_ptr + 1'b1;\n            end\n        end\n    end\n\n    assign dout = mem[rd_addr];\n    assign full = (wr_ptr - rd_ptr) == DEPTH;\n    assign empty = (wr_ptr == rd_ptr);\n\nendmodule\n\n// Pointer synchronizer\nmodule sync_ptr #(\n    parameter WIDTH = 8\n) (\n    input  wire              clk,\n    input  wire              rst,\n    input  wire [WIDTH-1:0] din,\n    output wire [WIDTH-1:0] dout\n);\n    reg [WIDTH-1:0] sync_reg1;\n    reg [WIDTH-1:0] sync_reg2;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            sync_reg1 <= {WIDTH{1'b0}};\n            sync_reg2 <= {WIDTH{1'b0}};\n        end else begin\n            sync_reg1 <= din;\n            sync_reg2 <= sync_reg1;\n        end\n    end\n\n    assign dout = sync_reg2;\n\nendmodule\n\n// Width adapter\nmodule width_adapter #(\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = 0,\n    parameter S_KEEP_WIDTH = 1,\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = 0,\n    parameter M_KEEP_WIDTH = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 0,\n    parameter USER_WIDTH = 1\n) (\n    input  wire                          clk,\n    input  wire                          rst,\n    input  wire                          s_valid,\n    output wire                          s_ready,\n    input  wire [S_DATA_WIDTH-1:0]       s_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]       s_tkeep,\n    input  wire                          s_tlast,\n    input  wire [ID_WIDTH-1:0]           s_tid,\n    input  wire [DEST_WIDTH-1:0]         s_tdest,\n    input  wire [USER_WIDTH-1:0]         s_tuser,\n    output wire                          m_valid,\n    input  wire                          m_ready,\n    output wire [M_DATA_WIDTH-1:0]       m_tdata,\n    output wire [M_KEEP_WIDTH-1:0]       m_tkeep,\n    output wire                          m_tlast,\n    output wire [ID_WIDTH-1:0]           m_tid,\n    output wire [DEST_WIDTH-1:0]         m_tdest,\n    output wire [USER_WIDTH-1:0]         m_tuser\n);\n    // Simple pass-through for now (assumes same width or direct mapping)\n    assign s_ready = m_ready;\n    assign m_valid = s_valid;\n    assign m_tdata = s_tdata[M_DATA_WIDTH-1:0];\n    assign m_tkeep = s_tkeep[M_KEEP_WIDTH-1:0];\n    assign m_tlast = s_tlast;\n    assign m_tid = s_tid;\n    assign m_tdest = s_tdest;\n    assign m_tuser = s_tuser;\n\nendmodule\n```<|im_end|>",
