  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n\n    // Internal data width for storage\n    localparam DATA_W = S_DATA_WIDTH;\n    localparam KEEP_W = S_KEEP_WIDTH;\n    localparam USER_W = USER_ENABLE ? USER_WIDTH : 1;\n    localparam ID_W = ID_ENABLE ? ID_WIDTH : 1;\n    localparam DEST_W = DEST_ENABLE ? DEST_WIDTH : 1;\n\n    // Total bits per entry\n    localparam ENTRY_W = DATA_W + KEEP_W + USER_W + ID_W + DEST_W + 1; // +1 for tlast\n\n    // RAM\n    reg [ENTRY_W-1:0] ram [0:DEPTH-1];\n\n    // Write pointer (s_clk domain)\n    reg [PTR_WIDTH-1:0] wr_ptr;\n    reg [ADDR_WIDTH-1:0] wr_addr;\n\n    // Read pointer (m_clk domain)\n    reg [PTR_WIDTH-1:1] rd_ptr;\n    reg [ADDR_WIDTH-1:0] rd_addr;\n\n    // Gray code pointers for CDC\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_WIDTH-1:0] gray2bin;\n        input [PTR_WIDTH-1:0] gray;\n        reg [PTR_WIDTH-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Gray code write pointer\n    wire [PTR_WIDTH-1:0] wr_ptr_gray = bin2gray({wr_ptr, wr_addr});\n    // Actually, let's use a single pointer with enough bits\n    // Let's redefine: use a single counter for write and read\n\n    // Redefine pointers as single counters\n    reg [PTR_WIDTH-1:0] wr_ptr_reg;\n    reg [PTR_WIDTH-1:0] rd_ptr_reg;\n\n    wire [PTR_WIDTH-1:0] wr_ptr_gray = bin2gray(wr_ptr_reg);\n    wire [PTR_WIDTH-1:0] rd_ptr_gray = bin2gray(rd_ptr_reg);\n\n    // Synchronizers\n    reg [PTR_WIDTH-1:0] wr_ptr_gray_s1, wr_ptr_gray_s2;\n    reg [PTR_WIDTH-1:0] rd_ptr_gray_s1, rd_ptr_gray_s2;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            wr_ptr_gray_s1 <= {PTR_WIDTH{1'b0}};\n            wr_ptr_gray_s2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            wr_ptr_gray_s1 <= wr_ptr_gray;\n            wr_ptr_gray_s2 <= wr_ptr_gray_s1;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            rd_ptr_gray_s1 <= {PTR_WIDTH{1'b0}};\n            rd_ptr_gray_s2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            rd_ptr_gray_s1 <= rd_ptr_gray;\n            rd_ptr_gray_s2 <= rd_ptr_gray_s1;\n        end\n    end\n\n    // Convert synchronized gray to binary\n    wire [PTR_WIDTH-1:0] wr_ptr_sync = gray2bin(wr_ptr_gray_s2);\n    wire [PTR_WIDTH-1:0] rd_ptr_sync = gray2bin(rd_ptr_gray_s2);\n\n    // Depth calculation\n    wire [PTR_WIDTH:0] depth = wr_ptr_sync - rd_ptr_sync;\n    wire [PTR_WIDTH-1:0] depth_low = depth[PTR_WIDTH-1:0];\n    wire full = (depth == DEPTH);\n    wire empty = (depth == 0);\n\n    // Write address\n    wire [ADDR_WIDTH-1:0] wr_addr_calc = wr_ptr_reg[ADDR_WIDTH-1:0];\n    wire [ADDR_WIDTH-1:0] rd_addr_calc = rd_ptr_reg[ADDR_WIDTH-1:0];\n\n    // Write enable\n    wire s_write_en = s_axis_tvalid & s_axis_tready & ~full;\n\n    // Read enable\n    wire m_read_en = m_axis_tvalid & m_axis_tready & ~empty;\n\n    // Update write pointer\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            wr_ptr_reg <= {PTR_WIDTH{1'b0}};\n        else if (s_write_en)\n            wr_ptr_reg <= wr_ptr_reg + 1'b1;\n    end\n\n    // Update read pointer\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            rd_ptr_reg <= {PTR_WIDTH{1'b0}};\n        else if (m_read_en)\n            rd_ptr_reg <= rd_ptr_reg + 1'b1;\n    end\n\n    // RAM write\n    always @(posedge s_clk) begin\n        if (s_write_en) begin\n            ram[wr_addr_calc] <= {s_axis_tlast, s_axis_tuser, s_axis_tid, s_axis_tdest, s_axis_tkeep, s_axis_tdata};\n        end\n    end\n\n    // RAM read\n    reg [ENTRY_W-1:0] rd_data;\n    always @(posedge m_clk) begin\n        rd_data <= ram[rd_addr_calc];\n    end\n\n    // Output signals\n    assign m_axis_tdata = rd_data[DATA_W-1:0];\n    assign m_axis_tkeep = rd_data[DATA_W + KEEP_W-1:DATA_W];\n    assign m_axis_tlast = rd_data[ENTRY_W-1];\n    assign m_axis_tuser = rd_data[ENTRY_W-2:ENTRY_W-1-USER_W];\n    assign m_axis_tid = rd_data[ENTRY_W-1-USER_W:ENTRY_W-1-USER_W-ID_W];\n    assign m_axis_tdest = rd_data[ENTRY_W-1-USER_W-ID_W:ENTRY_W-1-USER_W-ID_W-DEST_W];\n\n    // Valid and ready\n    assign m_axis_tvalid = ~empty;\n    assign s_axis_tready = ~full;\n\n    // Pause logic\n    reg s_pause_ack_reg, m_pause_ack_reg;\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            s_pause_ack_reg <= 1'b0;\n        else if (PAUSE_ENABLE)\n            s_pause_ack_reg <= s_pause_req;\n        else\n            s_pause_ack_reg <= 1'b0;\n    end\n    assign s_pause_ack = s_pause_ack_reg;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            m_pause_ack_reg <= 1'b0;\n        else if (PAUSE_ENABLE)\n            m_pause_ack_reg <= m_pause_req;\n        else\n            m_pause_ack_reg <= 1'b0;\n    end\n    assign m_pause_ack = m_pause_ack_reg;\n\n    // Status\n    assign s_status_depth = depth_low;\n    assign s_status_depth_commit = depth_low;\n    assign s_status_overflow = full;\n    assign s_status_bad_frame = 1'b0;\n    assign s_status_good_frame = 1'b0;\n    assign m_status_depth = depth_low;\n    assign m_status_depth_commit = depth_low;\n    assign m_status_overflow = full;\n    assign m_status_bad_frame = 1'b0;\n    assign m_status_good_frame = 1'b0;\n\nendmodule\n```<|im_end|>",
