  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal data width for storage: data + keep + last + user\n    localparam STORE_DATA_WIDTH = S_DATA_WIDTH;\n    localparam STORE_KEEP_WIDTH = S_KEEP_WIDTH;\n    localparam STORE_USER_WIDTH = USER_WIDTH;\n    localparam STORE_TOTAL_WIDTH = STORE_DATA_WIDTH + STORE_KEEP_WIDTH + 1 + STORE_USER_WIDTH;\n\n    // RAM storage\n    reg [STORE_TOTAL_WIDTH-1:0] ram [0:DEPTH-1];\n\n    // Write pointer (s_clk domain)\n    reg [PTR_WIDTH-1:0] w_ptr;\n    // Read pointer (m_clk domain)\n    reg [PTR_WIDTH-1:0] r_ptr;\n\n    // Gray code pointers for CDC\n    reg [PTR_WIDTH-1:0] w_ptr_gray;\n    reg [PTR_WIDTH-1:0] r_ptr_gray;\n\n    // Synchronizers\n    reg [PTR_WIDTH-1:0] w_ptr_gray_sync1, w_ptr_gray_sync2;\n    reg [PTR_WIDTH-1:0] r_ptr_gray_sync1, r_ptr_gray_sync2;\n\n    // Synchronizers for pause\n    reg s_pause_req_sync1, s_pause_req_sync2;\n    reg m_pause_req_sync1, m_pause_req_sync2;\n\n    // Status flags\n    reg s_overflow;\n    reg m_overflow;\n    reg s_bad_frame;\n    reg m_bad_frame;\n    reg s_good_frame;\n    reg m_good_frame;\n\n    // Pause logic\n    reg s_pause_active;\n    reg m_pause_active;\n\n    // Write side logic\n    wire s_write_enable = s_axis_tvalid && s_axis_tready;\n    wire s_full = (w_ptr[PTR_WIDTH-1] == r_ptr_gray_sync2[PTR_WIDTH-1]) &&\n                  (w_ptr[ADDR_WIDTH-1:0] == r_ptr_gray_sync2[ADDR_WIDTH-1:0]);\n    wire s_almost_full = (w_ptr[PTR_WIDTH-1] == r_ptr_gray_sync2[PTR_WIDTH-1]) &&\n                         (w_ptr[ADDR_WIDTH-1:0] == (r_ptr_gray_sync2[ADDR_WIDTH-1:0] + 1'b1));\n\n    // Read side logic\n    wire m_read_enable = m_axis_tvalid && m_axis_tready;\n    wire m_empty = (r_ptr[PTR_WIDTH-1] == w_ptr_gray_sync2[PTR_WIDTH-1]) &&\n                   (r_ptr[ADDR_WIDTH-1:0] == w_ptr_gray_sync2[ADDR_WIDTH-1:0]);\n\n    // Depth calculation\n    wire [PTR_WIDTH-1:0] s_depth = w_ptr - r_ptr_gray_sync2;\n    wire [PTR_WIDTH-1:0] m_depth = w_ptr_gray_sync2 - r_ptr;\n\n    // tready generation\n    assign s_axis_tready = !s_full && !s_pause_active && !s_rst;\n    assign m_axis_tvalid = !m_empty && !m_rst;\n\n    // Pause ack\n    assign s_pause_ack = s_pause_active;\n    assign m_pause_ack = m_pause_active;\n\n    // Status outputs\n    assign s_status_depth = s_depth[ADDR_WIDTH:0];\n    assign s_status_depth_commit = s_depth[ADDR_WIDTH:0];\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n    assign m_status_depth = m_depth[ADDR_WIDTH:0];\n    assign m_status_depth_commit = m_depth[ADDR_WIDTH:0];\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n\n    // Gray code conversion\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Write pointer update\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_ptr <= {PTR_WIDTH{1'b0}};\n            w_ptr_gray <= {PTR_WIDTH{1'b0}};\n            s_overflow <= 1'b0;\n            s_bad_frame <= 1'b0;\n            s_good_frame <= 1'b0;\n            s_pause_active <= 1'b0;\n        end else begin\n            if (s_write_enable) begin\n                w_ptr <= w_ptr + 1'b1;\n                w_ptr_gray <= bin2gray(w_ptr + 1'b1);\n            end\n            if (s_write_enable && s_full) begin\n                s_overflow <= 1'b1;\n            end\n            if (s_write_enable && s_axis_tlast) begin\n                if (DROP_BAD_FRAME && s_axis_tuser[0]) begin\n                    s_bad_frame <= 1'b1;\n                end else begin\n                    s_good_frame <= 1'b1;\n                end\n            end\n            if (PAUSE_ENABLE) begin\n                if (s_pause_req_sync2 && !s_pause_active) begin\n                    s_pause_active <= 1'b1;\n                end else if (!s_pause_req_sync2 && s_pause_active) begin\n                    s_pause_active <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // RAM write\n    always @(posedge s_clk) begin\n        if (s_write_enable) begin\n            ram[w_ptr[ADDR_WIDTH-1:0]] <= {s_axis_tdata, s_axis_tkeep, s_axis_tlast, s_axis_tuser};\n        end\n    end\n\n    // Read pointer update\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr <= {PTR_WIDTH{1'b0}};\n            r_ptr_gray <= {PTR_WIDTH{1'b0}};\n            m_overflow <= 1'b0;\n            m_bad_frame <= 1'b0;\n            m_good_frame <= 1'b0;\n            m_pause_active <= 1'b0;\n        end else begin\n            if (m_read_enable) begin\n                r_ptr <= r_ptr + 1'b1;\n                r_ptr_gray <= bin2gray(r_ptr + 1'b1);\n            end\n            if (m_read_enable && m_axis_tlast) begin\n                if (DROP_BAD_FRAME && m_axis_tuser[0]) begin\n                    m_bad_frame <= 1'b1;\n                end else begin\n                    m_good_frame <= 1'b1;\n                end\n            end\n            if (PAUSE_ENABLE) begin\n                if (m_pause_req_sync2 && !m_pause_active) begin\n                    m_pause_active <= 1'b1;\n                end else if (!m_pause_req_sync2 && m_pause_active) begin\n                    m_pause_active <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // RAM read\n    reg [STORE_TOTAL_WIDTH-1:0] ram_read_data;\n    always @(posedge m_clk) begin\n        ram_read_data <= ram[r_ptr[ADDR_WIDTH-1:0]];\n    end\n\n    // Output data\n    assign m_axis_tdata = ram_read_data[STORE_DATA_WIDTH-1:0];\n    assign m_axis_tkeep = ram_read_data[STORE_DATA_WIDTH + STORE_KEEP_WIDTH-1:STORE_DATA_WIDTH];\n    assign m_axis_tlast = ram_read_data[STORE_DATA_WIDTH + STORE_KEEP_WIDTH];\n    assign m_axis_tuser = ram_read_data[STORE_TOTAL_WIDTH-1:STORE_DATA_WIDTH + STORE_KEEP_WIDTH + 1];\n    assign m_axis_tid = {ID_WIDTH{1'b0}};\n    assign m_axis_tdest = {DEST_WIDTH{1'b0}};\n\n    // Synchronizers\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            w_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n            s_pause_req_sync1 <= 1'b0;\n            s_pause_req_sync2 <= 1'b0;\n        end else begin\n            w_ptr_gray_sync1 <= w_ptr_gray;\n            w_ptr_gray_sync2 <= w_ptr_gray_sync1;\n            s_pause_req_sync1 <= s_pause_req;\n            s_pause_req_sync2 <= s_pause_req_sync1;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            r_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n            m_pause_req_sync1 <= 1'b0;\n            m_pause_req_sync2 <= 1'b0;\n        end else begin\n            r_ptr_gray_sync1 <= r_ptr_gray;\n            r_ptr_gray_sync2 <= r_ptr_gray_sync1;\n            m_pause_req_sync1 <= m_pause_req;\n            m_pause_req_sync2 <= m_pause_req_sync1;\n        end\n    end\n\nendmodule\n```<|im_end|>",
