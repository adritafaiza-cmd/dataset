          "text": "`default_nettype none\n\nmodule cdc_reset_sync (\n  input  logic clk_i,\n  input  logic arst_ni,\n  output logic rst_ni\n);\n\n  (* ASYNC_REG = \"TRUE\" *) logic [1:0] sync_q;\n\n  always_ff @(posedge clk_i or negedge arst_ni) begin\n    if (!arst_ni)\n      sync_q <= 2'b00;\n    else\n      sync_q <= {sync_q[0], 1'b1};\n  end\n\n  assign rst_ni = sync_q[1];\n\nendmodule\n\n\nmodule cdc_2phase #(\n  parameter int WIDTH = 1\n)(\n  input  logic             src_rst_ni,\n  input  logic             src_clk_i,\n  input  logic [WIDTH-1:0] src_data_i,\n  input  logic             src_valid_i,\n  output logic             src_ready_o,\n\n  input  logic             dst_rst_ni,\n  input  logic             dst_clk_i,\n  output logic [WIDTH-1:0] dst_data_o,\n  output logic             dst_valid_o,\n  input  logic             dst_ready_i\n);\n\n  wire common_arst_ni = src_rst_ni & dst_rst_ni;\n\n  logic src_local_rst_ni;\n  logic dst_local_rst_ni;\n\n  cdc_reset_sync u_src_reset_sync (\n    .clk_i   (src_clk_i),\n    .arst_ni (common_arst_ni),\n    .rst_ni  (src_local_rst_ni)\n  );\n\n  cdc_reset_sync u_dst_reset_sync (\n    .clk_i   (dst_clk_i),\n    .arst_ni (common_arst_ni),\n    .rst_ni  (dst_local_rst_ni)\n  );\n\n  logic [WIDTH-1:0] src_payload_q;\n  logic             src_req_q;\n\n  (* ASYNC_REG = \"TRUE\" *) logic dst_ack_src_meta_q;\n  (* ASYNC_REG = \"TRUE\" *) logic dst_ack_src_sync_q;\n\n  logic dst_ack_q;\n\n  assign src_ready_o =\n      src_local_rst_ni && (src_req_q == dst_ack_src_sync_q);\n\n  always_ff @(posedge src_clk_i or negedge src_local_rst_ni) begin\n    if (!src_local_rst_ni) begin\n      src_payload_q <= '0;\n      src_req_q     <= 1'b0;\n    end else if (src_valid_i && src_ready_o) begin\n      src_payload_q <= src_data_i;\n      src_req_q     <= ~src_req_q;\n    end\n  end\n\n  always_ff @(posedge src_clk_i or negedge src_local_rst_ni) begin\n    if (!src_local_rst_ni) begin\n      dst_ack_src_meta_q <= 1'b0;\n      dst_ack_src_sync_q <= 1'b0;\n    end else begin\n      dst_ack_src_meta_q <= dst_ack_q;\n      dst_ack_src_sync_q <= dst_ack_src_meta_q;\n    end\n  end\n\n  (* ASYNC_REG = \"TRUE\" *) logic [2:0] dst_req_sync_q;\n  (* ASYNC_REG = \"TRUE\" *) logic [WIDTH-1:0] dst_data_meta_q;\n  (* ASYNC_REG = \"TRUE\" *) logic [WIDTH-1:0] dst_data_sync_q;\n\n  always_ff @(posedge dst_clk_i or negedge dst_local_rst_ni) begin\n    if (!dst_local_rst_ni) begin\n      dst_req_sync_q <= 3'b000;\n      dst_data_meta_q <= '0;\n      dst_data_sync_q <= '0;\n    end else begin\n      dst_req_sync_q[0] <= src_req_q;\n      dst_req_sync_q[1] <= dst_req_sync_q[0];\n      dst_req_sync_q[2] <= dst_req_sync_q[1];\n\n      dst_data_meta_q <= src_payload_q;\n      dst_data_sync_q <= dst_data_meta_q;\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_local_rst_ni) begin\n    if (!dst_local_rst_ni) begin\n      dst_data_o  <= '0;\n      dst_valid_o <= 1'b0;\n      dst_ack_q   <= 1'b0;\n    end else begin\n      if (!dst_valid_o) begin\n        if (dst_req_sync_q[2] != dst_ack_q) begin\n          dst_data_o  <= dst_data_sync_q;\n          dst_valid_o <= 1'b1;\n        end\n      end else if (dst_ready_i) begin\n        dst_valid_o <= 1'b0;\n        dst_ack_q   <= dst_req_sync_q[2];\n      end\n    end\n  end\n\nendmodule\n\n`default_nettype wire"
