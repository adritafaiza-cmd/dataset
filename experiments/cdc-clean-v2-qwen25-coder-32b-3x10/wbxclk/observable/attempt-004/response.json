  "text": "```verilog\nmodule wbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\t// FIFO for Wishbone to XCLK requests\n\treg [AW-1:0] wb_req_addr_fifo [0:(1<<LGFIFO)-1];\n\treg [DW-1:0] wb_req_data_fifo [0:(1<<LGFIFO)-1];\n\treg [(DW/8-1):0] wb_req_sel_fifo [0:(1<<LGFIFO)-1];\n\treg wb_req_we_fifo [0:(1<<LGFIFO)-1];\n\treg [LGFIFO-1:0] wb_req_wr_ptr, wb_req_rd_ptr;\n\treg wb_req_full, wb_req_empty;\n\n\t// FIFO for XCLK to Wishbone responses\n\treg [DW-1:0] xclk_resp_data_fifo [0:(1<<LGFIFO)-1];\n\treg xclk_resp_err_fifo [0:(1<<LGFIFO)-1];\n\treg [LGFIFO-1:0] xclk_resp_wr_ptr, xclk_resp_rd_ptr;\n\treg xclk_resp_full, xclk_resp_empty;\n\n\t// FIFO control logic for Wishbone to XCLK requests\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\twb_req_wr_ptr <= 0;\n\t\t\twb_req_rd_ptr <= 0;\n\t\t\twb_req_full <= 0;\n\t\t\twb_req_empty <= 1;\n\t\tend else begin\n\t\t\tif (i_wb_cyc && i_wb_stb && !wb_req_full) begin\n\t\t\t\twb_req_addr_fifo[wb_req_wr_ptr] <= i_wb_addr;\n\t\t\t\twb_req_data_fifo[wb_req_wr_ptr] <= i_wb_data;\n\t\t\t\twb_req_sel_fifo[wb_req_wr_ptr] <= i_wb_sel;\n\t\t\t\twb_req_we_fifo[wb_req_wr_ptr] <= i_wb_we;\n\t\t\t\twb_req_wr_ptr <= wb_req_wr_ptr + 1;\n\t\t\t\twb_req_empty <= 0;\n\t\t\t\tif (wb_req_wr_ptr == wb_req_rd_ptr - 1)\n\t\t\t\t\twb_req_full <= 1;\n\t\t\tend\n\t\t\tif (o_xclk_stb && !i_xclk_stall && !wb_req_empty) begin\n\t\t\t\twb_req_rd_ptr <= wb_req_rd_ptr + 1;\n\t\t\t\twb_req_full <= 0;\n\t\t\t\tif (wb_req_wr_ptr == wb_req_rd_ptr)\n\t\t\t\t\twb_req_empty <= 1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// FIFO control logic for XCLK to Wishbone responses\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\txclk_resp_wr_ptr <= 0;\n\t\t\txclk_resp_rd_ptr <= 0;\n\t\t\txclk_resp_full <= 0;\n\t\t\txclk_resp_empty <= 1;\n\t\tend else begin\n\t\t\tif (i_xclk_ack && !xclk_resp_full) begin\n\t\t\t\txclk_resp_data_fifo[xclk_resp_wr_ptr] <= i_xclk_data;\n\t\t\t\txclk_resp_err_fifo[xclk_resp_wr_ptr] <= i_xclk_err;\n\t\t\t\txclk_resp_wr_ptr <= xclk_resp_wr_ptr + 1;\n\t\t\t\txclk_resp_empty <= 0;\n\t\t\t\tif (xclk_resp_wr_ptr == xclk_resp_rd_ptr - 1)\n\t\t\t\t\txclk_resp_full <= 1;\n\t\t\tend\n\t\t\tif (o_wb_ack && !xclk_resp_empty) begin\n\t\t\t\txclk_resp_rd_ptr <= xclk_resp_rd_ptr + 1;\n\t\t\t\txclk_resp_full <= 0;\n\t\t\t\tif (xclk_resp_wr_ptr == xclk_resp_rd_ptr)\n\t\t\t\t\txclk_resp_empty <= 1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Wishbone side logic\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\t\to_wb_stall <= 0;\n\t\tend else begin\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_err <= 0;\n\t\t\tif (!xclk_resp_empty) begin\n\t\t\t\to_wb_data <= xclk_resp_data_fifo[xclk_resp_rd_ptr];\n\t\t\t\to_wb_err <= xclk_resp_err_fifo[xclk_resp_rd_ptr];\n\t\t\t\to_wb_ack <= 1;\n\t\t\tend\n\t\t\to_wb_stall <= wb_req_full;\n\t\tend\n\tend\n\n\t// XCLK side logic\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend else begin\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\tif (!wb_req_empty && !o_xclk_stb) begin\n\t\t\t\to_xclk_cyc <= 1;\n\t\t\t\to_xclk_stb <= 1;\n\t\t\t\to_xclk_we <= wb_req_we_fifo[wb_req_rd_ptr];\n\t\t\t\to_xclk_addr <= wb_req_addr_fifo[wb_req_rd_ptr];\n\t\t\t\to_xclk_data <= wb_req_data_fifo[wb_req_rd_ptr];\n\t\t\t\to_xclk_sel <= wb_req_sel_fifo[wb_req_rd_ptr];\n\t\t\tend\n\t\t\tif (i_xclk_ack || i_xclk_err) begin\n\t\t\t\to_xclk_cyc <= 0;\n\t\t\t\to_xclk_stb <= 0;\n\t\t\tend\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
