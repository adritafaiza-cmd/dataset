  "text": "```verilog\nmodule wbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\n\t// FIFO for Wishbone to XCLK\n\treg [AW-1:0] wb2x_addr_fifo [0:FIFO_DEPTH-1];\n\treg [DW-1:0] wb2x_data_fifo [0:FIFO_DEPTH-1];\n\treg [(DW/8-1):0] wb2x_sel_fifo [0:FIFO_DEPTH-1];\n\treg wb2x_we_fifo [0:FIFO_DEPTH-1];\n\treg wb2x_valid_fifo [0:FIFO_DEPTH-1];\n\treg [LGFIFO-1:0] wb2x_wr_ptr, wb2x_rd_ptr;\n\treg wb2x_full, wb2x_empty;\n\n\t// FIFO for XCLK to Wishbone\n\treg [DW-1:0] x2wb_data_fifo [0:FIFO_DEPTH-1];\n\treg x2wb_err_fifo [0:FIFO_DEPTH-1];\n\treg x2wb_valid_fifo [0:FIFO_DEPTH-1];\n\treg [LGFIFO-1:0] x2wb_wr_ptr, x2wb_rd_ptr;\n\treg x2wb_full, x2wb_empty;\n\n\t// FIFO control logic for Wishbone to XCLK\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\twb2x_wr_ptr <= 0;\n\t\t\twb2x_rd_ptr <= 0;\n\t\t\twb2x_valid_fifo <= {FIFO_DEPTH{1'b0}};\n\t\tend else begin\n\t\t\tif (i_wb_cyc && i_wb_stb && !wb2x_full) begin\n\t\t\t\twb2x_addr_fifo[wb2x_wr_ptr] <= i_wb_addr;\n\t\t\t\twb2x_data_fifo[wb2x_wr_ptr] <= i_wb_data;\n\t\t\t\twb2x_sel_fifo[wb2x_wr_ptr] <= i_wb_sel;\n\t\t\t\twb2x_we_fifo[wb2x_wr_ptr] <= i_wb_we;\n\t\t\t\twb2x_valid_fifo[wb2x_wr_ptr] <= 1;\n\t\t\t\twb2x_wr_ptr <= wb2x_wr_ptr + 1;\n\t\t\tend\n\t\t\tif (o_xclk_ack && !wb2x_empty) begin\n\t\t\t\twb2x_valid_fifo[wb2x_rd_ptr] <= 0;\n\t\t\t\twb2x_rd_ptr <= wb2x_rd_ptr + 1;\n\t\t\tend\n\t\tend\n\tend\n\n\tassign wb2x_full = wb2x_wr_ptr == wb2x_rd_ptr + FIFO_DEPTH;\n\tassign wb2x_empty = wb2x_wr_ptr == wb2x_rd_ptr;\n\n\t// FIFO control logic for XCLK to Wishbone\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tx2wb_wr_ptr <= 0;\n\t\t\tx2wb_rd_ptr <= 0;\n\t\t\tx2wb_valid_fifo <= {FIFO_DEPTH{1'b0}};\n\t\tend else begin\n\t\t\tif (i_xclk_ack && !x2wb_full) begin\n\t\t\t\tx2wb_data_fifo[x2wb_wr_ptr] <= i_xclk_data;\n\t\t\t\tx2wb_err_fifo[x2wb_wr_ptr] <= i_xclk_err;\n\t\t\t\tx2wb_valid_fifo[x2wb_wr_ptr] <= 1;\n\t\t\t\tx2wb_wr_ptr <= x2wb_wr_ptr + 1;\n\t\t\tend\n\t\t\tif (o_wb_ack && !x2wb_empty) begin\n\t\t\t\tx2wb_valid_fifo[x2wb_rd_ptr] <= 0;\n\t\t\t\tx2wb_rd_ptr <= x2wb_rd_ptr + 1;\n\t\t\tend\n\t\tend\n\tend\n\n\tassign x2wb_full = x2wb_wr_ptr == x2wb_rd_ptr + FIFO_DEPTH;\n\tassign x2wb_empty = x2wb_wr_ptr == x2wb_rd_ptr;\n\n\t// Output assignments for Wishbone side\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend else begin\n\t\t\tif (!x2wb_empty) begin\n\t\t\t\to_wb_ack <= 1;\n\t\t\t\to_wb_data <= x2wb_data_fifo[x2wb_rd_ptr];\n\t\t\t\to_wb_err <= x2wb_err_fifo[x2wb_rd_ptr];\n\t\t\tend else begin\n\t\t\t\to_wb_ack <= 0;\n\t\t\t\to_wb_data <= 0;\n\t\t\t\to_wb_err <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\tassign o_wb_stall = wb2x_full;\n\n\t// Output assignments for XCLK side\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend else begin\n\t\t\tif (!wb2x_empty && !i_xclk_stall) begin\n\t\t\t\to_xclk_cyc <= 1;\n\t\t\t\to_xclk_stb <= 1;\n\t\t\t\to_xclk_we <= wb2x_we_fifo[wb2x_rd_ptr];\n\t\t\t\to_xclk_addr <= wb2x_addr_fifo[wb2x_rd_ptr];\n\t\t\t\to_xclk_data <= wb2x_data_fifo[wb2x_rd_ptr];\n\t\t\t\to_xclk_sel <= wb2x_sel_fifo[wb2x_rd_ptr];\n\t\t\tend else begin\n\t\t\t\to_xclk_cyc <= 0;\n\t\t\t\to_xclk_stb <= 0;\n\t\t\t\to_xclk_we <= 0;\n\t\t\t\to_xclk_addr <= 0;\n\t\t\t\to_xclk_data <= 0;\n\t\t\t\to_xclk_sel <= 0;\n\t\t\tend\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
