  "text": "```verilog\nmodule wbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\t// FIFO for Wishbone to XCLK\n\treg [AW-1:0] fifo_addr [0:(1<<LGFIFO)-1];\n\treg [DW-1:0] fifo_data [0:(1<<LGFIFO)-1];\n\treg [(DW/8-1):0] fifo_sel [0:(1<<LGFIFO)-1];\n\treg fifo_we [0:(1<<LGFIFO)-1];\n\treg fifo_stb [0:(1<<LGFIFO)-1];\n\treg fifo_cyc [0:(1<<LGFIFO)-1];\n\treg [LGFIFO:0] wb_wr_ptr, wb_rd_ptr;\n\treg [LGFIFO:0] wb_full, wb_empty;\n\n\t// FIFO for XCLK to Wishbone\n\treg [DW-1:0] fifo_xclk_data [0:(1<<LGFIFO)-1];\n\treg fifo_xclk_ack [0:(1<<LGFIFO)-1];\n\treg fifo_xclk_err [0:(1<<LGFIFO)-1];\n\treg [LGFIFO:0] xclk_wr_ptr, xclk_rd_ptr;\n\treg [LGFIFO:0] xclk_full, xclk_empty;\n\n\t// FIFO pointers and flags\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\twb_wr_ptr <= 0;\n\t\t\twb_rd_ptr <= 0;\n\t\t\twb_full <= 0;\n\t\t\twb_empty <= 1;\n\t\tend else begin\n\t\t\tif (i_wb_stb && !wb_full) begin\n\t\t\t\tfifo_addr[wb_wr_ptr[LGFIFO-1:0]] <= i_wb_addr;\n\t\t\t\tfifo_data[wb_wr_ptr[LGFIFO-1:0]] <= i_wb_data;\n\t\t\t\tfifo_sel[wb_wr_ptr[LGFIFO-1:0]] <= i_wb_sel;\n\t\t\t\tfifo_we[wb_wr_ptr[LGFIFO-1:0]] <= i_wb_we;\n\t\t\t\tfifo_stb[wb_wr_ptr[LGFIFO-1:0]] <= i_wb_stb;\n\t\t\t\tfifo_cyc[wb_wr_ptr[LGFIFO-1:0]] <= i_wb_cyc;\n\t\t\t\twb_wr_ptr <= wb_wr_ptr + 1;\n\t\t\t\twb_empty <= 0;\n\t\t\t\tif (wb_wr_ptr[LGFIFO:0] == wb_rd_ptr[LGFIFO:0] + (1<<LGFIFO) - 1)\n\t\t\t\t\twb_full <= 1;\n\t\t\tend\n\t\t\tif (i_xclk_ack && !wb_empty) begin\n\t\t\t\twb_rd_ptr <= wb_rd_ptr + 1;\n\t\t\t\twb_full <= 0;\n\t\t\t\tif (wb_wr_ptr[LGFIFO:0] == wb_rd_ptr[LGFIFO:0])\n\t\t\t\t\twb_empty <= 1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// FIFO pointers and flags for XCLK\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\txclk_wr_ptr <= 0;\n\t\t\txclk_rd_ptr <= 0;\n\t\t\txclk_full <= 0;\n\t\t\txclk_empty <= 1;\n\t\tend else begin\n\t\t\tif (i_xclk_ack && !xclk_full) begin\n\t\t\t\tfifo_xclk_data[xclk_wr_ptr[LGFIFO-1:0]] <= i_xclk_data;\n\t\t\t\tfifo_xclk_ack[xclk_wr_ptr[LGFIFO-1:0]] <= i_xclk_ack;\n\t\t\t\tfifo_xclk_err[xclk_wr_ptr[LGFIFO-1:0]] <= i_xclk_err;\n\t\t\t\txclk_wr_ptr <= xclk_wr_ptr + 1;\n\t\t\t\txclk_empty <= 0;\n\t\t\t\tif (xclk_wr_ptr[LGFIFO:0] == xclk_rd_ptr[LGFIFO:0] + (1<<LGFIFO) - 1)\n\t\t\t\t\txclk_full <= 1;\n\t\t\tend\n\t\t\tif (o_wb_ack && !xclk_empty) begin\n\t\t\t\txclk_rd_ptr <= xclk_rd_ptr + 1;\n\t\t\t\txclk_full <= 0;\n\t\t\t\tif (xclk_wr_ptr[LGFIFO:0] == xclk_rd_ptr[LGFIFO:0])\n\t\t\t\t\txclk_empty <= 1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Output assignments for Wishbone\n\tassign o_wb_stall = wb_full;\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend else begin\n\t\t\tif (!xclk_empty) begin\n\t\t\t\to_wb_ack <= fifo_xclk_ack[xclk_rd_ptr[LGFIFO-1:0]];\n\t\t\t\to_wb_data <= fifo_xclk_data[xclk_rd_ptr[LGFIFO-1:0]];\n\t\t\t\to_wb_err <= fifo_xclk_err[xclk_rd_ptr[LGFIFO-1:0]];\n\t\t\tend else begin\n\t\t\t\to_wb_ack <= 0;\n\t\t\t\to_wb_data <= 0;\n\t\t\t\to_wb_err <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Output assignments for XCLK\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend else begin\n\t\t\tif (!wb_empty && !i_xclk_stall) begin\n\t\t\t\to_xclk_cyc <= fifo_cyc[wb_rd_ptr[LGFIFO-1:0]];\n\t\t\t\to_xclk_stb <= fifo_stb[wb_rd_ptr[LGFIFO-1:0]];\n\t\t\t\to_xclk_we <= fifo_we[wb_rd_ptr[LGFIFO-1:0]];\n\t\t\t\to_xclk_addr <= fifo_addr[wb_rd_ptr[LGFIFO-1:0]];\n\t\t\t\to_xclk_data <= fifo_data[wb_rd_ptr[LGFIFO-1:0]];\n\t\t\t\to_xclk_sel <= fifo_sel[wb_rd_ptr[LGFIFO-1:0]];\n\t\t\tend else begin\n\t\t\t\to_xclk_cyc <= 0;\n\t\t\t\to_xclk_stb <= 0;\n\t\t\t\to_xclk_we <= 0;\n\t\t\t\to_xclk_addr <= 0;\n\t\t\t\to_xclk_data <= 0;\n\t\t\t\to_xclk_sel <= 0;\n\t\t\tend\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
