  "text": "```verilog\nmodule wbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\t// FIFO for Wishbone to XCLK\n\treg [(AW-1):0]\tfifo_wb_addr [0:(1<<LGFIFO)-1];\n\treg [(DW-1):0]\tfifo_wb_data [0:(1<<LGFIFO)-1];\n\treg [(DW/8-1):0]\tfifo_wb_sel [0:(1<<LGFIFO)-1];\n\treg\t\t\tfifo_wb_we [0:(1<<LGFIFO)-1];\n\treg\t\t\tfifo_wb_cyc [0:(1<<LGFIFO)-1];\n\treg\t\t\tfifo_wb_stb [0:(1<<LGFIFO)-1];\n\treg [$clog2(1<<LGFIFO)-1:0]\tfifo_wb_wr_ptr, fifo_wb_rd_ptr;\n\treg [$clog2(1<<LGFIFO):0]\tfifo_wb_count;\n\n\t// FIFO for XCLK to Wishbone\n\treg [(DW-1):0]\tfifo_xclk_data [0:(1<<LGFIFO)-1];\n\treg\t\t\tfifo_xclk_err [0:(1<<LGFIFO)-1];\n\treg\t\t\tfifo_xclk_ack [0:(1<<LGFIFO)-1];\n\treg [$clog2(1<<LGFIFO)-1:0]\tfifo_xclk_wr_ptr, fifo_xclk_rd_ptr;\n\treg [$clog2(1<<LGFIFO):0]\tfifo_xclk_count;\n\n\t// FIFO Write Logic for Wishbone to XCLK\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tfifo_wb_wr_ptr <= 0;\n\t\t\tfifo_wb_count <= 0;\n\t\tend else if (i_wb_stb && !i_xclk_stall && (fifo_wb_count < (1<<LGFIFO))) begin\n\t\t\tfifo_wb_addr[fifo_wb_wr_ptr] <= i_wb_addr;\n\t\t\tfifo_wb_data[fifo_wb_wr_ptr] <= i_wb_data;\n\t\t\tfifo_wb_sel[fifo_wb_wr_ptr] <= i_wb_sel;\n\t\t\tfifo_wb_we[fifo_wb_wr_ptr] <= i_wb_we;\n\t\t\tfifo_wb_cyc[fifo_wb_wr_ptr] <= i_wb_cyc;\n\t\t\tfifo_wb_stb[fifo_wb_wr_ptr] <= i_wb_stb;\n\t\t\tfifo_wb_wr_ptr <= fifo_wb_wr_ptr + 1;\n\t\t\tfifo_wb_count <= fifo_wb_count + 1;\n\t\tend\n\tend\n\n\t// FIFO Read Logic for Wishbone to XCLK\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tfifo_wb_rd_ptr <= 0;\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend else if (fifo_wb_count > 0) begin\n\t\t\to_xclk_cyc <= fifo_wb_cyc[fifo_wb_rd_ptr];\n\t\t\to_xclk_stb <= fifo_wb_stb[fifo_wb_rd_ptr];\n\t\t\to_xclk_we <= fifo_wb_we[fifo_wb_rd_ptr];\n\t\t\to_xclk_addr <= fifo_wb_addr[fifo_wb_rd_ptr];\n\t\t\to_xclk_data <= fifo_wb_data[fifo_wb_rd_ptr];\n\t\t\to_xclk_sel <= fifo_wb_sel[fifo_wb_rd_ptr];\n\t\t\tfifo_wb_rd_ptr <= fifo_wb_rd_ptr + 1;\n\t\t\tfifo_wb_count <= fifo_wb_count - 1;\n\t\tend else begin\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend\n\tend\n\n\t// FIFO Write Logic for XCLK to Wishbone\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tfifo_xclk_wr_ptr <= 0;\n\t\t\tfifo_xclk_count <= 0;\n\t\tend else if (i_xclk_ack && (fifo_xclk_count < (1<<LGFIFO))) begin\n\t\t\tfifo_xclk_data[fifo_xclk_wr_ptr] <= i_xclk_data;\n\t\t\tfifo_xclk_err[fifo_xclk_wr_ptr] <= i_xclk_err;\n\t\t\tfifo_xclk_ack[fifo_xclk_wr_ptr] <= i_xclk_ack;\n\t\t\tfifo_xclk_wr_ptr <= fifo_xclk_wr_ptr + 1;\n\t\t\tfifo_xclk_count <= fifo_xclk_count + 1;\n\t\tend\n\tend\n\n\t// FIFO Read Logic for XCLK to Wishbone\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tfifo_xclk_rd_ptr <= 0;\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend else if (fifo_xclk_count > 0) begin\n\t\t\to_wb_ack <= fifo_xclk_ack[fifo_xclk_rd_ptr];\n\t\t\to_wb_data <= fifo_xclk_data[fifo_xclk_rd_ptr];\n\t\t\to_wb_err <= fifo_xclk_err[fifo_xclk_rd_ptr];\n\t\t\tfifo_xclk_rd_ptr <= fifo_xclk_rd_ptr + 1;\n\t\t\tfifo_xclk_count <= fifo_xclk_count - 1;\n\t\tend else begin\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend\n\tend\n\n\t// Backpressure signal\n\tassign o_wb_stall = (fifo_wb_count >= (1<<LGFIFO));\n\nendmodule\n```<|im_end|>",
