  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  logic [WIDTH-1:0] sync_data;\n  logic sync_valid;\n  logic sync_ready;\n\n  // Synchronization logic for valid signal\n  logic [SYNC_STAGES-1:0] sync_valid_reg;\n  logic [SYNC_STAGES-1:0] sync_ready_reg;\n\n  // Clear signals\n  logic src_clear_reg;\n  logic dst_clear_reg;\n  logic src_clear_sync;\n  logic dst_clear_sync;\n\n  // Clear pending signals\n  logic src_clear_pending;\n  logic dst_clear_pending;\n\n  // Source domain logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_reg <= 0;\n      src_clear_pending <= 0;\n    end else begin\n      src_clear_reg <= src_clear_i;\n      if (src_clear_i) begin\n        src_clear_pending <= 1;\n      end else if (!src_clear_pending_o) begin\n        src_clear_pending <= 0;\n      end\n    end\n  end\n\n  // Destination domain logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_reg <= 0;\n      dst_clear_pending <= 0;\n    end else begin\n      dst_clear_reg <= dst_clear_i;\n      if (dst_clear_i) begin\n        dst_clear_pending <= 1;\n      end else if (!dst_clear_pending_o) begin\n        dst_clear_pending <= 0;\n      end\n    end\n  end\n\n  // Synchronize clear signals\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_clear_sync <= 0;\n    end else begin\n      dst_clear_sync <= dst_clear_reg;\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_clear_sync <= 0;\n    end else begin\n      src_clear_sync <= src_clear_reg;\n    end\n  end\n\n  // Synchronize valid and ready signals\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      sync_valid_reg <= 0;\n    end else begin\n      sync_valid_reg <= {sync_valid_reg[SYNC_STAGES-2:0], src_valid_i & ~src_clear_reg};\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      sync_ready_reg <= 0;\n    end else begin\n      sync_ready_reg <= {sync_ready_reg[SYNC_STAGES-2:0], dst_ready_i & ~dst_clear_reg};\n    end\n  end\n\n  // Assign synchronized signals\n  assign sync_valid = sync_valid_reg[SYNC_STAGES-1];\n  assign sync_ready = sync_ready_reg[SYNC_STAGES-1];\n\n  // Data synchronization\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      sync_data <= 0;\n    end else if (src_valid_i & sync_ready & ~src_clear_reg) begin\n      sync_data <= src_data_i;\n    end\n  end\n\n  // Output assignments\n  assign src_ready_o = sync_ready & ~src_clear_reg;\n  assign src_clear_pending_o = src_clear_pending;\n\n  assign dst_data_o = sync_data;\n  assign dst_valid_o = sync_valid & ~dst_clear_reg;\n  assign dst_clear_pending_o = dst_clear_pending;\n\nendmodule\n```<|im_end|>",
