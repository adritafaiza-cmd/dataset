  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side signals\n  logic src_valid_sync;\n  logic src_clear_sync;\n  logic src_clear_pending;\n  logic src_ready;\n  logic [WIDTH-1:0] src_data_sync;\n\n  // Destination side signals\n  logic dst_valid_sync;\n  logic dst_clear_sync;\n  logic dst_clear_pending;\n  logic dst_ready;\n  logic [WIDTH-1:0] dst_data;\n\n  // Synchronization FIFO\n  logic [WIDTH-1:0] sync_fifo [0:SYNC_STAGES-1];\n  logic [SYNC_STAGES-1:0] sync_valid;\n  logic [SYNC_STAGES-1:0] sync_clear;\n\n  // Source side synchronization\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_sync <= 0;\n      src_clear_sync <= 0;\n      src_data_sync <= 0;\n    end else begin\n      src_valid_sync <= src_valid_i;\n      src_clear_sync <= src_clear_i;\n      src_data_sync <= src_data_i;\n    end\n  end\n\n  // Destination side synchronization\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_sync <= 0;\n      dst_clear_sync <= 0;\n    end else begin\n      dst_valid_sync <= sync_valid[SYNC_STAGES-1];\n      dst_clear_sync <= sync_clear[SYNC_STAGES-1];\n    end\n  end\n\n  // Synchronization FIFO logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      sync_valid <= 0;\n      sync_clear <= 0;\n      sync_fifo <= 0;\n    end else begin\n      if (src_valid_i && src_ready) begin\n        sync_fifo[0] <= src_data_i;\n        sync_valid[0] <= 1;\n        sync_clear[0] <= src_clear_i;\n      end else if (sync_valid[0]) begin\n        sync_valid[0] <= 0;\n      end\n\n      for (int i = 1; i < SYNC_STAGES; i = i + 1) begin\n        if (sync_valid[i-1]) begin\n          sync_fifo[i] <= sync_fifo[i-1];\n          sync_valid[i] <= sync_valid[i-1];\n          sync_clear[i] <= sync_clear[i-1];\n        end else begin\n          sync_valid[i] <= 0;\n        end\n      end\n    end\n  end\n\n  // Clear pending logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_pending <= 0;\n    end else begin\n      if (src_clear_i) begin\n        src_clear_pending <= 1;\n      end else if (sync_clear[SYNC_STAGES-1] && dst_ready) begin\n        src_clear_pending <= 0;\n      end\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_pending <= 0;\n    end else begin\n      if (dst_clear_i) begin\n        dst_clear_pending <= 1;\n      end else if (sync_clear[SYNC_STAGES-1] && dst_ready) begin\n        dst_clear_pending <= 0;\n      end\n    end\n  end\n\n  // Ready and valid logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ready <= 0;\n    end else begin\n      if (src_clear_i) begin\n        src_ready <= 0;\n      end else if (!sync_valid[SYNC_STAGES-1] || (dst_ready && sync_valid[SYNC_STAGES-1])) begin\n        src_ready <= 1;\n      end else begin\n        src_ready <= 0;\n      end\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_ready <= 0;\n    end else begin\n      if (dst_clear_i) begin\n        dst_ready <= 0;\n      end else if (!sync_valid[SYNC_STAGES-1] || (dst_ready && sync_valid[SYNC_STAGES-1])) begin\n        dst_ready <= 1;\n      end else begin\n        dst_ready <= 0;\n      end\n    end\n  end\n\n  // Output assignments\n  assign src_clear_pending_o = src_clear_pending;\n  assign src_ready_o = src_ready;\n  assign dst_clear_pending_o = dst_clear_pending;\n  assign dst_data_o = sync_fifo[SYNC_STAGES-1];\n  assign dst_valid_o = dst_valid_sync;\n\nendmodule\n```<|im_end|>",
