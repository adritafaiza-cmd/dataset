  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic src_clear_sync;\n  logic src_clear_req;\n  logic src_clear_ack;\n  logic src_clear_pending;\n  logic src_valid_sync;\n  logic src_valid_req;\n  logic src_valid_ack;\n  logic [WIDTH-1:0] src_data_sync;\n\n  // Destination domain signals\n  logic dst_clear_sync;\n  logic dst_clear_req;\n  logic dst_clear_ack;\n  logic dst_clear_pending;\n  logic dst_valid_sync;\n  logic dst_valid_req;\n  logic dst_valid_ack;\n  logic [WIDTH-1:0] dst_data_sync;\n\n  // Synchronization for clear signal from source to destination\n  logic [SYNC_STAGES-1:0] src_clear_sync_reg;\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_clear_sync_reg <= '0;\n    end else begin\n      src_clear_sync_reg <= {src_clear_sync_reg[SYNC_STAGES-2:0], src_clear_i};\n    end\n  end\n  assign src_clear_sync = src_clear_sync_reg[SYNC_STAGES-1];\n\n  // Synchronization for clear signal from destination to source\n  logic [SYNC_STAGES-1:0] dst_clear_sync_reg;\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_clear_sync_reg <= '0;\n    end else begin\n      dst_clear_sync_reg <= {dst_clear_sync_reg[SYNC_STAGES-2:0], dst_clear_i};\n    end\n  end\n  assign dst_clear_sync = dst_clear_sync_reg[SYNC_STAGES-1];\n\n  // Synchronization for valid signal from source to destination\n  logic [SYNC_STAGES-1:0] src_valid_sync_reg;\n  always_ff @(posedge dst_clk_i or negedge dst_rst_n