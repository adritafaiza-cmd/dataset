  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic src_clear_synced;\n  logic src_clear_req;\n  logic src_clear_ack;\n  logic src_clear_pending;\n  logic src_valid_synced;\n  logic [WIDTH-1:0] src_data_synced;\n\n  // Destination domain signals\n  logic dst_clear_synced;\n  logic dst_clear_req;\n  logic dst_clear_ack;\n  logic dst_clear_pending;\n  logic dst_valid_synced;\n  logic [WIDTH-1:0] dst_data_synced;\n\n  // Synchronization FIFO\n  logic [WIDTH-1:0] sync_fifo [0:SYNC_STAGES-1];\n  logic [SYNC_STAGES-1:0] sync_valid;\n  logic [SYNC_STAGES-1:0] sync_ready;\n\n  // Source domain clear logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_pending <= 1'b0;\n      src_clear_req <= 1'b0;\n    end else begin\n      if (src_clear_i) begin\n        src_clear_pending <= 1'b1;\n        src_clear_req <= 1'b1;\n      end else if (src_clear_ack) begin\n        src_clear_pending <= 1'b0;\n        src_clear_req <= 1'b0;\n      end\n    end\n  end\n\n  // Source domain clear pending output\n  assign src_clear_pending_o = src_clear_pending;\n\n  // Source domain clear request to destination domain\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_req <= 1'b0;\n    end else begin\n      dst_clear_req <= src_clear_synced;\n    end\n  end\n\n  // Source domain clear acknowledge from destination domain\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_ack <= 1'b0;\n    end else begin\n      src_clear_ack <= dst_clear_ack;\n    end\n  end\n\n  // Destination domain clear logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_pending <= 1'b0;\n      dst_clear_ack <= 1'b0;\n    end else begin\n      if (dst_clear_i) begin\n        dst_clear_pending <= 1'b1;\n        dst_clear_ack <= 1'b0;\n      end else if (dst_clear_req) begin\n        dst_clear_pending <= 1'b1;\n        dst_clear_ack <= 1'b1;\n      end else if (dst_clear_ack) begin\n        dst_clear_pending <= 1'b0;\n        dst_clear_ack <= 1'b0;\n      end\n    end\n  end\n\n  // Destination domain clear pending output\n  assign dst_clear_pending_o = dst_clear_pending;\n\n  // Source domain clear request to source domain\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_synced <= 1'b0;\n    end else begin\n      src_clear_synced <= dst_clear_ack;\n    end\n  end\n\n  // Source domain valid and data synchronization\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_synced <= 1'b0;\n      src_data_synced <= '0;\n    end else if (src_valid_i && !src_clear_i) begin\n      src_valid_synced <= 1'b1;\n      src_data_synced <= src_data_i;\n    end else if (sync_ready[0]) begin\n      src_valid_synced <= 1'b0;\n    end\n  end\n\n  // Destination domain valid and data synchronization\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_synced <= 1'b0;\n      dst_data_synced <= '0;\n    end else if (sync_valid[SYNC_STAGES-1]) begin\n      dst_valid_synced <= 1'b1;\n      dst_data_synced <= sync_fifo[SYNC_STAGES-1];\n    end else if (dst_ready_i) begin\n      dst_valid_synced <= 1'b0;\n    end\n  end\n\n  // Synchronization FIFO logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      sync_valid <= '0;\n      sync_fifo <= '{default: '0};\n    end else begin\n      for (int i = 0; i < SYNC_STAGES; i++) begin\n        if (i == 0) begin\n          sync_valid[i] <= src_valid_synced && !dst_clear_i;\n          sync_fifo[i] <= src_data_synced;\n        end else begin\n          sync_valid[i] <= sync_valid[i-1];\n          sync_fifo[i] <= sync_fifo[i-1];\n        end\n      end\n    end\n  end\n\n  // Synchronization ready signal\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      sync_ready <= '0;\n    end else begin\n      sync_ready[0] <= sync_valid[SYNC_STAGES-1] ? dst_ready_i : 1'b1;\n      for (int i = 1; i < SYNC_STAGES; i++) begin\n        sync_ready[i] <= sync_ready[i-1];\n      end\n    end\n  end\n\n  // Source domain ready output\n  assign src_ready_o = sync_ready[SYNC_STAGES-1] && !src_clear_i;\n\n  // Destination domain valid output\n  assign dst_valid_o = dst_valid_synced && !dst_clear_i;\n\n  // Destination domain data output\n  assign dst_data_o = dst_data_synced;\n\nendmodule\n```<|im_end|>",
