  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic src_clear_synced;\n  logic src_clear_req;\n  logic src_clear_ack;\n  logic src_clear_pending;\n  logic src_valid_synced;\n  logic src_valid_req;\n  logic src_valid_ack;\n  logic [WIDTH-1:0] src_data_synced;\n\n  // Destination domain signals\n  logic dst_clear_synced;\n  logic dst_clear_req;\n  logic dst_clear_ack;\n  logic dst_clear_pending;\n  logic dst_valid_synced;\n  logic dst_valid_req;\n  logic dst_valid_ack;\n  logic [WIDTH-1:0] dst_data_synced;\n\n  // Synchronization FIFO\n  logic [WIDTH-1:0] sync_fifo [0:SYNC_STAGES-1];\n  logic [SYNC_STAGES-1:0] sync_fifo_valid;\n\n  // Source domain clear handling\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_synced <= 0;\n      src_clear_req <= 0;\n      src_clear_ack <= 0;\n      src_clear_pending <= 0;\n    end else begin\n      src_clear_synced <= src_clear_i;\n      if (src_clear_i) begin\n        src_clear_req <= 1;\n        src_clear_pending <= 1;\n      end else if (src_clear_ack) begin\n        src_clear_req <= 0;\n        src_clear_pending <= 0;\n      end\n    end\n  end\n\n  // Destination domain clear handling\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_synced <= 0;\n      dst_clear_req <= 0;\n      dst_clear_ack <= 0;\n      dst_clear_pending <= 0;\n    end else begin\n      dst_clear_synced <= dst_clear_i;\n      if (dst_clear_i) begin\n        dst_clear_req <= 1;\n        dst_clear_pending <= 1;\n      end else if (dst_clear_ack) begin\n        dst_clear_req <= 0;\n        dst_clear_pending <= 0;\n      end\n    end\n  end\n\n  // Source domain valid handling\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_synced <= 0;\n      src_valid_req <= 0;\n      src_valid_ack <= 0;\n    end else begin\n      src_valid_synced <= src_valid_i;\n      if (src_valid_i && !src_clear_i) begin\n        src_valid_req <= 1;\n      end else if (src_valid_ack) begin\n        src_valid_req <= 0;\n      end\n    end\n  end\n\n  // Synchronization FIFO handling\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      sync_fifo_valid <= 0;\n      sync_fifo <= '{default:0};\n    end else begin\n      if (src_valid_req && !src_clear_i) begin\n        sync_fifo[0] <= src_data_i;\n        sync_fifo_valid[0] <= 1;\n      end\n      for (int i = 0; i < SYNC_STAGES-1; i++) begin\n        sync_fifo[i+1] <= sync_fifo[i];\n        sync_fifo_valid[i+1] <= sync_fifo_valid[i];\n      end\n    end\n  end\n\n  // Destination domain valid handling\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_synced <= 0;\n      dst_valid_req <= 0;\n      dst_valid_ack <= 0;\n    end else begin\n      dst_valid_synced <= sync_fifo_valid[SYNC_STAGES-1];\n      if (sync_fifo_valid[SYNC_STAGES-1] && !dst_clear_i) begin\n        dst_valid_req <= 1;\n      end else if (dst_valid_ack) begin\n        dst_valid_req <= 0;\n      end\n    end\n  end\n\n  // Source domain ready and clear pending output\n  assign src_ready_o = !src_valid_synced || src_clear_i;\n  assign src_clear_pending_o = src_clear_pending;\n\n  // Destination domain data and valid output\n  assign dst_data_o = sync_fifo[SYNC_STAGES-1];\n  assign dst_valid_o = dst_valid_synced && !dst_clear_i;\n  assign dst_clear_pending_o = dst_clear_pending;\n\n  // Clear handshake\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_ack <= 0;\n    end else begin\n      src_clear_ack <= dst_clear_req;\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_ack <= 0;\n    end else begin\n      dst_clear_ack <= src_clear_req;\n    end\n  end\n\n  // Valid handshake\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_ack <= 0;\n    end else begin\n      dst_valid_ack <= dst_ready_i && dst_valid_req;\n    end\n  end\n\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_ack <= 0;\n    end else begin\n      src_valid_ack <= dst_valid_ack;\n    end\n  end\n\nendmodule\n```<|im_end|>",
