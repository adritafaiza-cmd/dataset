  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n  logic src_ready_sync;\n  logic dst_valid_sync;\n  logic dst_ready_sync;\n  logic src_clear_sync;\n  logic dst_clear_sync;\n  logic src_clear_pending;\n  logic dst_clear_pending;\n\n  // Synchronizers for clear signals\n  logic [SYNC_STAGES-1:0] src_clear_sync_chain;\n  logic [SYNC_STAGES-1:0] dst_clear_sync_chain;\n\n  // Synchronizers for valid and ready signals\n  logic [SYNC_STAGES-1:0] src_valid_sync_chain;\n  logic [SYNC_STAGES-1:0] dst_ready_sync_chain;\n\n  // Synchronizers for data\n  logic [WIDTH-1:0] src_data_sync_chain [SYNC_STAGES-1:0];\n\n  // Source side logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_sync_chain <= '0;\n      src_valid_sync_chain <= '0;\n      src_data_sync_chain  <= '{default: '0};\n    end else begin\n      src_clear_sync_chain <= {src_clear_sync_chain[SYNC_STAGES-2:0], src_clear_i};\n      src_valid_sync_chain <= {src_valid_sync_chain[SYNC_STAGES-2:0], src_valid_i};\n      src_data_sync_chain  <= {src_data_sync_chain[SYNC_STAGES-2:0], src_data_i};\n    end\n  end\n\n  assign src_clear_sync = src_clear_sync_chain[SYNC_STAGES-1];\n  assign src_valid_sync = src_valid_sync_chain[SYNC_STAGES-1];\n  assign src_data_sync  = src_data_sync_chain[SYNC_STAGES-1];\n\n  // Destination side logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_sync_chain <= '0;\n      dst_ready_sync_chain <= '0;\n    end else begin\n      dst_clear_sync_chain <= {dst_clear_sync_chain[SYNC_STAGES-2:0], dst_clear_i};\n      dst_ready_sync_chain <= {dst_ready_sync_chain[SYNC_STAGES-2:0], dst_ready_i};\n    end\n  end\n\n  assign dst_clear_sync = dst_clear_sync_chain[SYNC_STAGES-1];\n  assign dst_ready_sync = dst_ready_sync_chain[SYNC_STAGES-1];\n\n  // Clear pending signals\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_pending <= 1'b0;\n    end else if (src_clear_i) begin\n      src_clear_pending <= 1'b1;\n    end else if (dst_clear_sync) begin\n      src_clear_pending <= 1'b0;\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_pending <= 1'b0;\n    end else if (dst_clear_i) begin\n      dst_clear_pending <= 1'b1;\n    end else if (src_clear_sync) begin\n      dst_clear_pending <= 1'b0;\n    end\n  end\n\n  // Main handshake logic\n  logic src_handshake;\n  logic dst_handshake;\n\n  assign src_handshake = src_valid_sync & dst_ready_sync & ~src_clear_sync & ~dst_clear_sync;\n  assign dst_handshake = dst_valid_sync & src_ready_sync & ~src_clear_sync & ~dst_clear_sync;\n\n  // Source side ready and valid\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ready_o <= 1'b0;\n      src_valid_sync <= 1'b0;\n    end else begin\n      src_ready_o <= ~src_valid_sync | dst_handshake;\n      src_valid_sync <= src_valid_sync & ~dst_handshake | src_handshake;\n    end\n  end\n\n  // Destination side ready and valid\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_ready_o <= 1'b0;\n      dst_valid_sync <= 1'b0;\n    end else begin\n      dst_ready_o <= ~dst_valid_sync | src_handshake;\n      dst_valid_sync <= dst_valid_sync & ~src_handshake | dst_handshake;\n    end\n  end\n\n  // Data transfer\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_o <= '0;\n    end else if (dst_handshake) begin\n      dst_data_o <= src_data_sync;\n    end\n  end\n\n  // Clear pending outputs\n  assign src_clear_pending_o = src_clear_pending;\n  assign dst_clear_pending_o = dst_clear_pending;\n\nendmodule\n```<|im_end|>",
