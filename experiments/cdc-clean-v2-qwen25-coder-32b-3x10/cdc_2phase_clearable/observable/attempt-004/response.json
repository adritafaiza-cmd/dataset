  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side signals\n  logic src_clear_synced;\n  logic src_clear_req;\n  logic src_clear_ack;\n  logic src_clear_pending;\n  logic [WIDTH-1:0] src_data_reg;\n  logic src_valid_reg;\n  logic src_ready;\n\n  // Destination side signals\n  logic dst_clear_synced;\n  logic dst_clear_req;\n  logic dst_clear_ack;\n  logic dst_clear_pending;\n  logic [WIDTH-1:0] dst_data_reg;\n  logic dst_valid_reg;\n  logic dst_ready;\n\n  // Synchronization for clear signal from source to destination\n  logic [SYNC_STAGES-1:0] src_clear_sync;\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_clear_sync <= '0;\n    end else begin\n      src_clear_sync <= {src_clear_sync[SYNC_STAGES-2:0], src_clear_i};\n    end\n  end\n  assign src_clear_synced = src_clear_sync[SYNC_STAGES-1];\n\n  // Synchronization for clear signal from destination to source\n  logic [SYNC_STAGES-1:0] dst_clear_sync;\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_clear_sync <= '0;\n    end else begin\n      dst_clear_sync <= {dst_clear_sync[SYNC_STAGES-2:0], dst_clear_i};\n    end\n  end\n  assign dst_clear_synced = dst_clear_sync[SYNC_STAGES-1];\n\n  // Source side clear request and acknowledgment\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_req <= 0;\n      src_clear_ack <= 0;\n    end else begin\n      if (src_clear_i && !src_clear_req) begin\n        src_clear_req <= 1;\n      end else if (src_clear_ack) begin\n        src_clear_req <= 0;\n        src_clear_ack <= 0;\n      end\n    end\n  end\n\n  // Destination side clear request and acknowledgment\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_req <= 0;\n      dst_clear_ack <= 0;\n    end else begin\n      if (dst_clear_i && !dst_clear_req) begin\n        dst_clear_req <= 1;\n      end else if (dst_clear_ack) begin\n        dst_clear_req <= 0;\n        dst_clear_ack <= 0;\n      end\n    end\n  end\n\n  // Source side clear pending\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_pending <= 0;\n    end else begin\n      if (src_clear_req && !src_clear_synced) begin\n        src_clear_pending <= 1;\n      end else if (src_clear_synced) begin\n        src_clear_pending <= 0;\n      end\n    end\n  end\n\n  // Destination side clear pending\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_pending <= 0;\n    end else begin\n      if (dst_clear_req && !dst_clear_synced) begin\n        dst_clear_pending <= 1;\n      end else if (dst_clear_synced) begin\n        dst_clear_pending <= 0;\n      end\n    end\n  end\n\n  // Source side valid/ready handshake\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg <= '0;\n      src_valid_reg <= 0;\n    end else begin\n      if (src_valid_i && src_ready) begin\n        src_data_reg <= src_data_i;\n        src_valid_reg <= 1;\n      end else if (dst_ready) begin\n        src_valid_reg <= 0;\n      end\n    end\n  end\n\n  // Destination side valid/ready handshake\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg <= '0;\n      dst_valid_reg <= 0;\n    end else begin\n      if (src_valid_reg && !dst_valid_reg) begin\n        dst_da