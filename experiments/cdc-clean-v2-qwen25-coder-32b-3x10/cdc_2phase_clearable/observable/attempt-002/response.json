  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side signals\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n  logic src_ready_sync;\n  logic src_clear_sync;\n  logic src_clear_pending;\n\n  // Destination side signals\n  logic [WIDTH-1:0] dst_data_reg;\n  logic dst_valid_reg;\n  logic dst_ready_sync;\n  logic dst_clear_sync;\n  logic dst_clear_pending;\n\n  // Synchronization FIFO\n  logic [WIDTH-1:0] fifo_data [0:SYNC_STAGES-1];\n  logic fifo_valid [0:SYNC_STAGES-1];\n  logic fifo_ready [0:SYNC_STAGES-1];\n\n  // Source to Destination synchronization\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_clear_sync <= 0;\n      src_clear_pending <= 0;\n      fifo_valid[0] <= 0;\n    end else begin\n      src_clear_sync <= src_clear_i;\n      src_clear_pending <= src_clear_sync;\n\n      if (src_valid_i && fifo_ready[0]) begin\n        fifo_data[0] <= src_data_i;\n        fifo_valid[0] <= 1;\n      end else if (fifo_ready[0]) begin\n        fifo_valid[0] <= 0;\n      end\n    end\n  end\n\n  // Synchronization chain\n  generate\n    genvar i;\n    for (i = 0; i < SYNC_STAGES-1; i = i + 1) begin : gen_sync_chain\n      always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n          fifo_valid[i+1] <= 0;\n        end else begin\n          if (fifo_ready[i] && fifo_valid[i]) begin\n            fifo_data[i+1] <= fifo_data[i];\n            fifo_valid[i+1] <= 1;\n          end else if (fifo_ready[i]) begin\n            fifo_valid[i+1] <= 0;\n          end\n        end\n      end\n    end\n  endgenerate\n\n  // Destination side synchronization\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_clear_sync <= 0;\n      dst_clear_pending <= 0;\n      dst_valid_reg <= 0;\n    end else begin\n      dst_clear_sync <= dst_clear_i;\n      dst_clear_pending <= dst_clear_sync;\n\n      if (fifo_valid[SYNC_STAGES-1] && dst_ready_i) begin\n        dst_data_reg <= fifo_data[SYNC_STAGES-1];\n        dst_valid_reg <= 1;\n      end else if (dst_ready_i) begin\n        dst_valid_reg <= 0;\n      end\n    end\n  end\n\n  // Ready signals\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ready_sync <= 0;\n    end else begin\n      src_ready_sync <= fifo_ready[SYNC_STAGES-1];\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      fifo_ready[0] <= 0;\n    end else begin\n      fifo_ready[0] <= !dst_valid_reg || dst_ready_i;\n    end\n  end\n\n  generate\n    genvar j;\n    for (j = 0; j < SYNC_STAGES-1; j = j + 1) begin : gen_ready_chain\n      always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n          fifo_ready[j+1] <= 0;\n        end else begin\n          fifo_ready[j+1] <= fifo_ready[j];\n        end\n      end\n    end\n  endgenerate\n\n  // Outputs\n  assign src_ready_o = src_ready_sync;\n  assign src_clear_pending_o = src_clear_pending;\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_clear_pending_o = dst_clear_pending;\n\nendmodule\n```<|im_end|>",
