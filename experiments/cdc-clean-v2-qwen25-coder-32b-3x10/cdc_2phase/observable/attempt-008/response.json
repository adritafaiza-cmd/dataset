  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Intermediate signals for clock-domain crossing\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n  logic dst_valid_sync;\n\n  // Synchronizers for src_valid and src_data\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_sync <= '0;\n      src_valid_sync <= 1'b0;\n    end else begin\n      if (src_valid_i) begin\n        src_data_sync <= src_data_i;\n        src_valid_sync <= 1'b1;\n      end else if (dst_valid_sync) begin\n        src_valid_sync <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronizer for dst_valid\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_sync <= 1'b0;\n    end else begin\n      dst_valid_sync <= src_valid_sync;\n    end\n  end\n\n  // Output assignments\n  assign src_ready_o = !src_valid_sync;\n  assign dst_data_o = src_data_sync;\n  assign dst_valid_o = dst_valid_sync & !dst_ready_i;\n\nendmodule\n```<|im_end|>",
