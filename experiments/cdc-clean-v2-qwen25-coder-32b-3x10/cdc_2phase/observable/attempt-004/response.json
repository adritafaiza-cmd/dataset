  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side signals\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n  logic src_ready;\n\n  // Destination side signals\n  logic [WIDTH-1:0] dst_data_reg;\n  logic dst_valid_reg;\n\n  // Synchronization registers for crossing from src_clk_i to dst_clk_i\n  logic [WIDTH-1:0] sync_data [2];\n  logic sync_valid [2];\n\n  // Source side logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_sync <= '0;\n      src_valid_sync <= '0;\n    end else begin\n      src_data_sync <= src_data_i;\n      src_valid_sync <= src_valid_i;\n    end\n  end\n\n  assign src_ready_o = src_ready;\n\n  // Synchronization logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      sync_data[0] <= '0;\n      sync_data[1] <= '0;\n      sync_valid[0] <= '0;\n      sync_valid[1] <= '0;\n    end else begin\n      sync_data[0] <= src_data_sync;\n      sync_data[1] <= sync_data[0];\n      sync_valid[0] <= src_valid_sync;\n      sync_valid[1] <= sync_valid[0];\n    end\n  end\n\n  // Destination side logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg <= '0;\n      dst_valid_reg <= '0;\n      src_ready <= '0;\n    end else begin\n      if (dst_ready_i && dst_valid_reg) begin\n        dst_valid_reg <= '0;\n        src_ready <= '1;\n      end else if (sync_valid[1] && !dst_valid_reg) begin\n        dst_data_reg <= sync_data[1];\n        dst_valid_reg <= '1;\n        src_ready <= '0;\n      end else begin\n        src_ready <= '0;\n      end\n    end\n  end\n\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
