  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side signals\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n  logic src_ready;\n\n  // Destination side signals\n  logic [WIDTH-1:0] dst_data_reg;\n  logic dst_valid_reg;\n\n  // Synchronizers for src_valid_i and src_data_i\n  logic [WIDTH-1:0] src_data_meta;\n  logic src_valid_meta;\n\n  // Source side synchronizer\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_meta <= '0;\n      src_valid_meta <= 1'b0;\n    end else begin\n      src_data_meta <= src_data_i;\n      src_valid_meta <= src_valid_i;\n    end\n  end\n\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_sync <= '0;\n      src_valid_sync <= 1'b0;\n    end else begin\n      src_data_sync <= src_data_meta;\n      src_valid_sync <= src_valid_meta;\n    end\n  end\n\n  // Source side ready signal\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ready <= 1'b0;\n    end else begin\n      src_ready <= dst_ready_i & dst_valid_o;\n    end\n  end\n\n  assign src_ready_o = src_ready;\n\n  // Destination side synchronizer\n  logic dst_valid_meta;\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_meta <= 1'b0;\n    end else begin\n      dst_valid_meta <= src_valid_sync;\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_data_reg <= '0;\n    end else begin\n      if (dst_ready_i && dst_valid_o) begin\n        dst_valid_reg <= 1'b0;\n      end else if (dst_valid_meta && !dst_valid_reg) begin\n        dst_valid_reg <= 1'b1;\n        dst_data_reg <= src_data_sync;\n      end\n    end\n  end\n\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_data_o = dst_data_reg;\n\nendmodule\n```<|im_end|>",
