  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // FIFO control signals\n  logic [WIDTH-1:0] fifo_data;\n  logic fifo_valid, fifo_ready;\n\n  // Cross-domain FIFO\n  cdc_fifo #(\n    .WIDTH(WIDTH)\n  ) cdc_fifo_inst (\n    .src_rst_ni(src_rst_ni),\n    .src_clk_i(src_clk_i),\n    .src_data_i(src_data_i),\n    .src_valid_i(src_valid_i),\n    .src_ready_o(src_ready_o),\n    .dst_rst_ni(dst_rst_ni),\n    .dst_clk_i(dst_clk_i),\n    .dst_data_o(fifo_data),\n    .dst_valid_o(fifo_valid),\n    .dst_ready_i(fifo_ready)\n  );\n\n  // Destination side logic\n  logic [WIDTH-1:0] dst_data_reg;\n  logic dst_valid_reg;\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg <= '0;\n      dst_valid_reg <= 1'b0;\n    end else begin\n      if (fifo_valid && fifo_ready) begin\n        dst_data_reg <= fifo_data;\n        dst_valid_reg <= 1'b1;\n      end else if (dst_ready_i) begin\n        dst_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n  assign fifo_ready = dst_ready_i || !dst_valid_reg;\n\nendmodule\n\nmodule cdc_fifo #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // FIFO storage\n  logic [WIDTH-1:0] fifo_data;\n  logic fifo_valid;\n\n  // Source side write logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      fifo_data <= '0;\n      fifo_valid <= 1'b0;\n    end else if (src_valid_i && !fifo_valid) begin\n      fifo_data <= src_data_i;\n      fifo_valid <= 1'b1;\n    end else if (fifo_valid && dst_ready_i) begin\n      fifo_valid <= 1'b0;\n    end\n  end\n\n  // Destination side read logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_o <= '0;\n      dst_valid_o <= 1'b0;\n    end else begin\n      if (fifo_valid && !dst_valid_o) begin\n        dst_data_o <= fifo_data;\n        dst_valid_o <= 1'b1;\n      end else if (dst_ready_i) begin\n        dst_valid_o <= 1'b0;\n      end\n    end\n  end\n\n  assign src_ready_o = !fifo_valid;\n\nendmodule\n```<|im_end|>",
