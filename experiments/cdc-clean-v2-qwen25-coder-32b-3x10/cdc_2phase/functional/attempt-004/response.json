  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic src_ready;\n  logic [WIDTH-1:0] src_data_ff;\n  logic src_valid_ff;\n\n  // Destination domain signals\n  logic dst_valid;\n  logic [WIDTH-1:0] dst_data_ff;\n\n  // Synchronization flops for crossing from source to destination domain\n  logic [WIDTH-1:0] sync_data_ff [2:0];\n  logic sync_valid_ff [2:0];\n\n  // Source domain logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ready <= 1'b0;\n      src_data_ff <= '0;\n      src_valid_ff <= 1'b0;\n    end else begin\n      src_ready <= ~src_valid_ff | (src_valid_ff & dst_valid);\n      if (src_ready & src_valid_i) begin\n        src_data_ff <= src_data_i;\n        src_valid_ff <= 1'b1;\n      end else if (dst_valid) begin\n        src_valid_ff <= 1'b0;\n      end\n    end\n  end\n\n  // Cross-domain synchronization\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      sync_data_ff[0] <= '0;\n      sync_data_ff[1] <= '0;\n      sync_data_ff[2] <= '0;\n      sync_valid_ff[0] <= 1'b0;\n      sync_valid_ff[1] <= 1'b0;\n      sync_valid_ff[2] <= 1'b0;\n    end else begin\n      sync_data_ff[0] <= src_data_ff;\n      sync_data_ff[1] <= sync_data_ff[0];\n      sync_data_ff[2] <= sync_data_ff[1];\n      sync_valid_ff[0] <= src_valid_ff;\n      sync_valid_ff[1] <= sync_valid_ff[0];\n      sync_valid_ff[2] <= sync_valid_ff[1];\n    end\n  end\n\n  // Destination domain logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid <= 1'b0;\n      dst_data_o <= '0;\n      dst_valid_o <= 1'b0;\n    end else begin\n      if (sync_valid_ff[2] & ~dst_valid) begin\n        dst_data_o <= sync_data_ff[2];\n        dst_valid <= 1'b1;\n      end else if (dst_valid & dst_ready_i) begin\n        dst_valid <= 1'b0;\n      end\n      dst_valid_o <= dst_valid;\n    end\n  end\n\n  // Assign output signals\n  assign src_ready_o = src_ready;\n\nendmodule\n```<|im_end|>",
