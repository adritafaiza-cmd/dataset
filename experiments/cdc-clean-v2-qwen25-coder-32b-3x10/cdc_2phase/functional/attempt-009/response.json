  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic [WIDTH-1:0] src_data_ff;\n  logic src_valid_ff;\n  logic src_ready_ff;\n\n  // Destination domain signals\n  logic [WIDTH-1:0] dst_data_ff;\n  logic dst_valid_ff;\n  logic dst_ready_ff;\n\n  // Synchronization flops\n  logic [1:0] sync_valid;\n\n  // Source domain logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_ff <= '0;\n      src_valid_ff <= '0;\n      src_ready_ff <= '0;\n    end else begin\n      if (src_ready_ff && src_valid_i) begin\n        src_data_ff <= src_data_i;\n      end\n      src_valid_ff <= src_valid_i;\n      src_ready_ff <= !src_valid_ff || (sync_valid[1] && dst_ready_ff);\n    end\n  end\n\n  // Synchronization logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      sync_valid <= '0;\n    end else begin\n      sync_valid <= {sync_valid[0], src_valid_ff};\n    end\n  end\n\n  // Destination domain logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_ff <= '0;\n      dst_valid_ff <= '0;\n      dst_ready_ff <= '0;\n    end else begin\n      if (dst_ready_i && dst_valid_ff) begin\n        dst_valid_ff <= '0;\n      end else if (sync_valid[1] && !dst_valid_ff) begin\n        dst_data_ff <= src_data_ff;\n        dst_valid_ff <= '1;\n      end\n      dst_ready_ff <= dst_ready_i;\n    end\n  end\n\n  // Output assignments\n  assign src_ready_o = src_ready_ff;\n  assign dst_data_o = dst_data_ff;\n  assign dst_valid_o = dst_valid_ff;\n\nendmodule\n```<|im_end|>",
