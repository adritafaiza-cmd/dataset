  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic src_ready;\n  logic [WIDTH-1:0] src_data_ff;\n  logic src_valid_ff;\n\n  // Destination domain signals\n  logic dst_valid;\n  logic [WIDTH-1:0] dst_data_ff;\n\n  // Synchronization flops for src_valid and src_data\n  logic [1:0] src_valid_sync;\n  logic [WIDTH-1:0] src_data_sync;\n\n  // Source domain logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ready <= 1'b0;\n      src_data_ff <= '0;\n      src_valid_ff <= 1'b0;\n    end else begin\n      // Accept new data if ready and valid\n      if (src_ready && src_valid_i) begin\n        src_data_ff <= src_data_i;\n        src_valid_ff <= 1'b1;\n      end else if (dst_ready_i && dst_valid) begin\n        // Clear valid flag once data is acknowledged\n        src_valid_ff <= 1'b0;\n      end\n      // Generate ready signal based on whether data is already in transit\n      src_ready <= !src_valid_ff;\n    end\n  end\n\n  // Synchronize src_valid and src_data to destination clock domain\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_valid_sync <= '0;\n      src_data_sync <= '0;\n    end else begin\n      src_valid_sync <= {src_valid_sync[0], src_valid_ff};\n      src_data_sync <= src_data_ff;\n    end\n  end\n\n  // Destination domain logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid <= 1'b0;\n      dst_data_o <= '0;\n    end else begin\n      // Accept new data if not already valid\n      if (!dst_valid && src_valid_sync[1]) begin\n        dst_data_o <= src_data_sync;\n        dst_valid <= 1'b1;\n      end else if (dst_valid && dst_ready_i) begin\n        // Clear valid flag once data is acknowledged\n        dst_valid <= 1'b0;\n      end\n    end\n  end\n\n  // Assign outputs\n  assign src_ready_o = src_ready;\n  assign dst_valid_o = dst_valid;\n\nendmodule\n```<|im_end|>",
