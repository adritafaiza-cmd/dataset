  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic src_ready;\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n\n  // Destination domain signals\n  logic [WIDTH-1:0] dst_data_reg [1:0];\n  logic dst_valid_reg [1:0];\n\n  // Source domain logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ready <= 1'b0;\n      src_data_sync <= '0;\n      src_valid_sync <= 1'b0;\n    end else begin\n      src_ready <= ~src_valid_sync;\n      if (src_valid_i && src_ready) begin\n        src_data_sync <= src_data_i;\n        src_valid_sync <= 1'b1;\n      end else if (dst_valid_reg[1]) begin\n        src_valid_sync <= 1'b0;\n      end\n    end\n  end\n\n  // Cross-domain synchronization\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg[0] <= '0;\n      dst_data_reg[1] <= '0;\n      dst_valid_reg[0] <= 1'b0;\n      dst_valid_reg[1] <= 1'b0;\n    end else begin\n      dst_data_reg[0] <= src_data_sync;\n      dst_data_reg[1] <= dst_data_reg[0];\n      dst_valid_reg[0] <= src_valid_sync;\n      dst_valid_reg[1] <= dst_valid_reg[0];\n    end\n  end\n\n  // Destination domain logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_o <= '0;\n      dst_valid_o <= 1'b0;\n    end else begin\n      if (dst_valid_reg[1] && dst_ready_i) begin\n        dst_valid_o <= 1'b0;\n      end else if (dst_valid_reg[1] && !dst_valid_o) begin\n        dst_data_o <= dst_data_reg[1];\n        dst_valid_o <= 1'b1;\n      end\n    end\n  end\n\n  // Output assignments\n  assign src_ready_o = src_ready;\n\nendmodule\n```<|im_end|>",
