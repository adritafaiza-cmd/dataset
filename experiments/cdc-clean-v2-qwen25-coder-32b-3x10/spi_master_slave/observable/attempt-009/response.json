{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        shift_reg;\n    reg [3:0]          bit_cnt;\n    reg                spi_start;\n    reg                spi_busy;\n    reg                spi_done;\n    reg [N-1:0]        di_i_sync;\n    reg                wren_i_sync;\n    reg                spi_sck_o_sync;\n\n    // Clock domain crossing for di_i and wren_i\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_i_sync <= 0;\n            wren_i_sync <= 0;\n        end else begin\n            di_i_sync <= di_i;\n            wren_i_sync <= wren_i;\n        end\n    end\n\n    // SPI state machine\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1;\n            spi_sck_o <= 0;\n            spi_busy <= 0;\n            spi_done <= 0;\n            bit_cnt <= 0;\n            shift_reg <= 0;\n            spi_start <= 0;\n        end else begin\n            spi_done <= 0;\n            if (!spi_busy && spi_start) begin\n                spi_busy <= 1;\n                spi_ssel_o <= 0;\n                bit_cnt <= N-1;\n                shift_reg <= di_i_sync;\n                spi_sck_o <= 0;\n            end else if (spi_busy) begin\n                if (bit_cnt == 0) begin\n                    spi_busy <= 0;\n                    spi_ssel_o <= 1;\n                    spi_done <= 1;\n                end else begin\n                    spi_sck_o <= ~spi_sck_o;\n                    if (spi_sck_o) begin\n                        shift_reg <= {shift_reg[N-2:0], spi_miso_i};\n                        bit_cnt <= bit_cnt - 1;\n                    end\n                end\n            end\n        end\n    end\n\n    // SPI MOSI output\n    assign spi_mosi_o = shift_reg[N-1];\n\n    // Clock domain crossing for spi_sck_o\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck_o_sync <= 0;\n        end else begin\n            spi_sck_o_sync <= spi_sck_o;\n        end\n    end\n\n    // Parallel interface control\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1;\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n            do_o <= 0;\n        end else begin\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n            if (!spi_busy && !spi_start) begin\n                if (wren_i_sync) begin\n                    spi_start <= 1;\n                    wr_ack_o <= 1;\n                    di_req_o <= 0;\n                end\n            end else if (spi_done) begin\n                do_o <= shift_reg;\n                do_valid_o <= 1;\n                di_req_o <= 1;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
