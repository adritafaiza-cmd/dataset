{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        di_sync;\n    reg                wren_sync;\n    reg [N-1:0]        shift_reg;\n    reg [3:0]          bit_cnt;\n    reg                spi_busy;\n    reg                spi_start;\n    reg [1:0]          sclk_div_cnt;\n    reg [1:0]          pclk_div_cnt;\n\n    // Synchronize di_i and wren_i to pclk_i domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_sync <= 0;\n            wren_sync <= 0;\n        end else begin\n            di_sync <= di_i;\n            wren_sync <= wren_i;\n        end\n    end\n\n    // SPI control logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1;\n            spi_sck_o <= 0;\n            spi_busy <= 0;\n            spi_start <= 0;\n            bit_cnt <= 0;\n            shift_reg <= 0;\n            sclk_div_cnt <= 0;\n        end else begin\n            if (!spi_busy && spi_start) begin\n                spi_busy <= 1;\n                spi_ssel_o <= 0;\n                shift_reg <= di_sync;\n                bit_cnt <= N-1;\n                spi_sck_o <= 0;\n                sclk_div_cnt <= 0;\n            end else if (spi_busy) begin\n                if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                    spi_sck_o <= ~spi_sck_o;\n                    if (spi_sck_o) begin\n                        // Shift out on rising edge\n                        spi_mosi_o <= shift_reg[N-1];\n                        shift_reg <= {shift_reg[N-2:0], 1'b0};\n                    end else begin\n                        // Shift in on falling edge\n                        do_o <= {do_o[N-2:0], spi_miso_i};\n                    end\n                    if (bit_cnt == 0) begin\n                        spi_busy <= 0;\n                        spi_ssel_o <= 1;\n                    end else begin\n                        bit_cnt <= bit_cnt - 1;\n                    end\n                end\n                sclk_div_cnt <= sclk_div_cnt + 1;\n            end\n        end\n    end\n\n    // PCLK domain control logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1;\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n            spi_start <= 0;\n            pclk_div_cnt <= 0;\n        end else begin\n            if (!spi_busy && wren_sync) begin\n                spi_start <= 1;\n                wr_ack_o <= 1;\n                di_req_o <= 0;\n            end else begin\n                spi_start <= 0;\n                wr_ack_o <= 0;\n            end\n\n            if (!spi_busy && pclk_div_cnt == 1) begin\n                di_req_o <= 1;\n                do_valid_o <= 1;\n            end else begin\n                do_valid_o <= 0;\n            end\n\n            pclk_div_cnt <= pclk_div_cnt + 1;\n        end\n    end\n\nendmodule\n```<|im_end|>",
