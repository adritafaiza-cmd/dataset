{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    reg [N-1:0]       shift_reg;\n    reg [3:0]         bit_cnt;\n    reg               spi_sck;\n    reg               spi_ssel;\n    reg [N-1:0]       di_sync;\n    reg               wren_sync;\n    reg [1:0]         state;\n    reg [1:0]         next_state;\n    reg [1:0]         state_ff;\n    reg [1:0]         next_state_ff;\n    reg [1:0]         state_sync;\n    reg [1:0]         next_state_sync;\n\n    // State definitions\n    localparam IDLE = 2'b00;\n    localparam TRANSFER = 2'b01;\n    localparam DONE = 2'b10;\n\n    // Clock domain crossing for wren_i and di_i\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_sync <= 1'b0;\n            di_sync <= {N{1'b0}};\n        end else begin\n            wren_sync <= wren_i;\n            di_sync <= di_i;\n        end\n    end\n\n    // State machine in pclk domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= IDLE;\n            state_ff <= IDLE;\n            state_sync <= IDLE;\n        end else begin\n            state <= next_state;\n            state_ff <= state;\n            state_sync <= state_ff;\n        end\n    end\n\n    // Next state logic in pclk domain\n    always @(*) begin\n        next_state = state;\n        case (state)\n            IDLE: begin\n                if (wren_sync) begin\n                    next_state = TRANSFER;\n                end\n            end\n            TRANSFER: begin\n                if (bit_cnt == N-1) begin\n                    next_state = DONE;\n                end\n            end\n            DONE: begin\n                next_state = IDLE;\n            end\n        endcase\n    end\n\n    // Shift register and bit counter\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            shift_reg <= {N{1'b0}};\n            bit_cnt <= 4'b0;\n            spi_sck <= 1'b0;\n            spi_ssel <= 1'b1;\n        end else begin\n            case (state_sync)\n                IDLE: begin\n                    if (wren_sync) begin\n                        shift_reg <= di_sync;\n                        bit_cnt <= 4'b0;\n                        spi_ssel <= 1'b0;\n                    end\n                end\n                TRANSFER: begin\n                    spi_sck <= ~spi_sck;\n                    if (spi_sck) begin\n                        shift_reg <= {shift_reg[N-2:0], spi_miso_i};\n                        bit_cnt <= bit_cnt + 1;\n                    end\n                end\n                DONE: begin\n                    spi_ssel <= 1'b1;\n                end\n            endcase\n        end\n    end\n\n    // Outputs\n    assign spi_sck_o = spi_sck;\n    assign spi_ssel_o = spi_ssel;\n    assign spi_mosi_o = shift_reg[N-1];\n\n    // Handshake signals\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1'b1;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n        end else begin\n            di_req_o <= (state == IDLE);\n            wr_ack_o <= (state == TRANSFER) & (state_ff == IDLE);\n            do_valid_o <= (state == DONE) & (state_ff == TRANSFER);\n            if (state == DONE) begin\n                do_o <= shift_reg;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
