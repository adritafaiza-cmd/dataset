{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    reg [N-1:0]       shift_reg;\n    reg [3:0]         bit_cnt;\n    reg               spi_sck;\n    reg               spi_sck_d;\n    reg               spi_ssel;\n    reg [N-1:0]       di_i_sync;\n    reg               wren_i_sync;\n    reg               wren_i_sync_d;\n    reg [1:0]         state;\n    reg [1:0]         next_state;\n    reg [1:0]         state_sync;\n    reg [1:0]         state_sync_d;\n\n    // State definitions\n    localparam IDLE = 2'b00;\n    localparam TRANSFER = 2'b01;\n    localparam DONE = 2'b10;\n\n    // Clock domain crossing for wren_i and di_i\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_i_sync <= 1'b0;\n            wren_i_sync_d <= 1'b0;\n            di_i_sync <= {N{1'b0}};\n        end else begin\n            wren_i_sync <= wren_i;\n            wren_i_sync_d <= wren_i_sync;\n            di_i_sync <= di_i;\n        end\n    end\n\n    // Clock domain crossing for state\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state_sync <= IDLE;\n            state_sync_d <= IDLE;\n        end else begin\n            state_sync <= state;\n            state_sync_d <= state_sync;\n        end\n    end\n\n    // SPI clock generation\n    reg [1:0] sclk_div_cnt;\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_div_cnt <= 2'b00;\n            spi_sck <= 1'b0;\n        end else begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 2'b00;\n                spi_sck <= ~spi_sck;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 1;\n            end\n        end\n    end\n\n    // SPI clock edge detection\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck_d <= 1'b0;\n        end else begin\n            spi_sck_d <= spi_sck;\n        end\n    end\n\n    // State machine\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= IDLE;\n            bit_cnt <= 4'b0000;\n            spi_ssel <= 1'b1;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            shift_reg <= {N{1'b0}};\n        end else begin\n            state <= next_state;\n\n            case (state)\n                IDLE: begin\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                    if (wren_i_sync && !wren_i_sync_d && state_sync_d == IDLE) begin\n                        shift_reg <= di_i_sync;\n                        bit_cnt <= N-1;\n                        spi_ssel <= 1'b0;\n                        wr_ack_o <= 1'b1;\n                        next_state <= TRANSFER;\n                    end else begin\n                        next_state <= IDLE;\n                    end\n                end\n\n                TRANSFER: begin\n                    if (spi_sck && !spi_sck_d) begin\n                        spi_mosi_o <= shift_reg[bit_cnt];\n                        if (bit_cnt == 0) begin\n                            next_state <= DONE;\n                        end else begin\n                            bit_cnt <= bit_cnt - 1;\n                        end\n                    end else begin\n                        next_state <= TRANSFER;\n                    end\n                end\n\n                DONE: begin\n                    if (spi_sck && !spi_sck_d) begin\n                        do_o[bit_cnt] <= spi_miso_i;\n                        if (bit_cnt == N-1) begin\n                            spi_ssel <= 1'b1;\n                            do_valid_o <= 1'b1;\n                            next_state <= IDLE;\n                        end else begin\n                            bit_cnt <= bit_cnt + 1;\n                        end\n                    end else begin\n                        next_state <= DONE;\n                    end\n                end\n\n                default: begin\n                    next_state <= IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Request output\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1'b1;\n        end else begin\n            if (state_sync == IDLE) begin\n                di_req_o <= 1'b1;\n            end else begin\n                di_req_o <= 1'b0;\n            end\n        end\n    end\n\n    // SPI outputs\n    assign spi_sck_o = spi_sck;\n    assign spi_ssel_o = spi_ssel;\n\nendmodule\n```<|im_end|>",
