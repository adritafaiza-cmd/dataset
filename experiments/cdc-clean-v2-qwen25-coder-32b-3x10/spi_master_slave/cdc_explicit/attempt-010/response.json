{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        shift_reg;\n    reg [N-1:0]        rx_data;\n    reg [3:0]          bit_cnt;\n    reg                tx_start;\n    reg                rx_done;\n    reg                tx_done;\n    reg                spi_sck;\n    reg                spi_ssel;\n    reg                di_req;\n    reg                wr_ack;\n    reg                do_valid;\n\n    // Cross-domain synchronization\n    reg                wren_sync;\n    reg                wren_sync2;\n    reg                tx_done_sync;\n    reg                tx_done_sync2;\n\n    // Synchronize wren_i from pclk_i domain to sclk_i domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_sync <= 0;\n            wren_sync2 <= 0;\n        end else begin\n            wren_sync <= wren_i;\n            wren_sync2 <= wren_sync;\n        end\n    end\n\n    // Synchronize tx_done from sclk_i domain to pclk_i domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            tx_done_sync <= 0;\n            tx_done_sync2 <= 0;\n        end else begin\n            tx_done_sync <= tx_done;\n            tx_done_sync2 <= tx_done_sync;\n        end\n    end\n\n    // SPI control logic in sclk_i domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck <= 0;\n            spi_ssel <= 0;\n            bit_cnt <= 0;\n            shift_reg <= 0;\n            tx_start <= 0;\n            tx_done <= 0;\n            rx_data <= 0;\n            rx_done <= 0;\n        end else begin\n            // SPI clock generation\n            spi_sck <= ~spi_sck;\n\n            // SPI transaction control\n            if (tx_start) begin\n                spi_ssel <= 1;\n                bit_cnt <= N-1;\n                shift_reg <= di_i;\n                tx_start <= 0;\n            end else if (bit_cnt < N) begin\n                spi_mosi_o <= shift_reg[N-1];\n                shift_reg <= {shift_reg[N-2:0], 1'b0};\n                rx_data <= {rx_data[N-2:0], spi_miso_i};\n                bit_cnt <= bit_cnt - 1;\n            end else begin\n                spi_ssel <= 0;\n                tx_done <= 1;\n                rx_done <= 1;\n            end\n\n            // End of transaction\n            if (tx_done && spi_sck) begin\n                tx_done <= 0;\n            end\n\n            if (rx_done && ~spi_sck) begin\n                rx_done <= 0;\n            end\n        end\n    end\n\n    // Data request and write acknowledge in pclk_i domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req <= 0;\n            wr_ack <= 0;\n            do_valid <= 0;\n            do_o <= 0;\n        end else begin\n            // Request new data\n            if (tx_done_sync2 && ~tx_done_sync) begin\n                di_req <= 1;\n            end else if (wren_sync2 && ~wren_sync) begin\n                di_req <= 0;\n                wr_ack <= 1;\n                tx_start <= 1;\n            end else begin\n                wr_ack <= 0;\n            end\n\n            // Data valid and output\n            if (rx_done_sync2 && ~rx_done_sync) begin\n                do_valid <= 1;\n                do_o <= rx_data;\n            end else begin\n                do_valid <= 0;\n            end\n        end\n    end\n\n    // Assign outputs\n    assign spi_sck_o = spi_sck;\n    assign spi_ssel_o = spi_ssel;\n    assign di_req_o = di_req;\n    assign wr_ack_o = wr_ack;\n    assign do_valid_o = do_valid;\n    assign do_o = do_o;\n\nendmodule\n```<|im_end|>",
