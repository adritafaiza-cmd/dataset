{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        shift_reg;\n    reg [N-1:0]        miso_reg;\n    reg [3:0]          bit_cnt;\n    reg                shift_en;\n    reg                shift_done;\n    reg                wr_ack_pclk;\n    reg                di_req_pclk;\n    reg                do_valid_pclk;\n    reg [N-1:0]        do_o_pclk;\n\n    // Synchronizers for reset and control signals\n    reg                rst_sync_sclk;\n    reg                rst_sync_pclk;\n    reg                wren_sync_sclk;\n\n    // Synchronizer for reset in sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rst_sync_sclk <= 1'b1;\n        end else begin\n            rst_sync_sclk <= 1'b0;\n        end\n    end\n\n    // Synchronizer for reset in pclk domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rst_sync_pclk <= 1'b1;\n        end else begin\n            rst_sync_pclk <= 1'b0;\n        end\n    end\n\n    // Synchronizer for wren_i in sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_sync_sclk <= 1'b0;\n        end else begin\n            wren_sync_sclk <= wren_i;\n        end\n    end\n\n    // SPI control logic in sclk domain\n    always @(posedge sclk_i or posedge rst_sync_sclk) begin\n        if (rst_sync_sclk) begin\n            spi_ssel_o <= 1'b0;\n            spi_sck_o <= 1'b0;\n            shift_reg <= {N{1'b0}};\n            miso_reg <= {N{1'b0}};\n            bit_cnt <= 4'b0;\n            shift_en <= 1'b0;\n            shift_done <= 1'b0;\n        end else begin\n            if (wren_sync_sclk && !shift_en) begin\n                shift_reg <= di_i;\n                bit_cnt <= N-1;\n                shift_en <= 1'b1;\n                spi_ssel_o <= 1'b1;\n            end else if (shift_en) begin\n                if (bit_cnt == 0) begin\n                    shift_en <= 1'b0;\n                    shift_done <= 1'b1;\n                    spi_ssel_o <= 1'b0;\n                end else begin\n                    bit_cnt <= bit_cnt - 1;\n                end\n            end\n\n            // SPI clock generation\n            spi_sck_o <= (shift_en && (bit_cnt[0] ^ (SPI_2X_CLK_DIV == 2)));\n\n            // MOSI output\n            spi_mosi_o <= shift_reg[N-1];\n\n            // Shift register update\n            if (shift_en) begin\n                shift_reg <= {shift_reg[N-2:0], 1'b0};\n            end\n\n            // MISO capture\n            if (shift_en && spi_sck_o) begin\n                miso_reg <= {miso_reg[N-2:0], spi_miso_i};\n            end\n        end\n    end\n\n    // Control signals synchronization and handshake logic in pclk domain\n    always @(posedge pclk_i or posedge rst_sync_pclk) begin\n        if (rst_sync_pclk) begin\n            wr_ack_o <= 1'b0;\n            di_req_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n            wr_ack_pclk <= 1'b0;\n            di_req_pclk <= 1'b0;\n            do_valid_pclk <= 1'b0;\n            do_o_pclk <= {N{1'b0}};\n        end else begin\n            // Write acknowledge\n            wr_ack_o <= wr_ack_pclk;\n            wr_ack_pclk <= shift_done;\n\n            // Data request\n            di_req_o <= di_req_pclk;\n            di_req_pclk <= !wren_i && !shift_en;\n\n            // Data valid and output\n            do_valid_o <= do_valid_pclk;\n            do_o <= do_o_pclk;\n            if (shift_done) begin\n                do_valid_pclk <= 1'b1;\n                do_o_pclk <= miso_reg;\n            end else if (do_valid_pclk) begin\n                do_valid_pclk <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
