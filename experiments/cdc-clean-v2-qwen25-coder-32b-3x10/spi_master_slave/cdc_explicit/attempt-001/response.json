{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        shift_reg;\n    reg [N-1:0]        rx_shift_reg;\n    reg [3:0]          bit_cnt;\n    reg                tx_start;\n    reg                rx_done;\n    reg                tx_done;\n    reg                sclk_en;\n    reg                pclk_en;\n    reg                sclk_rst;\n    reg                pclk_rst;\n    reg [N-1:0]        di_sync;\n    reg                wren_sync;\n    reg                wr_ack_sync;\n    reg                do_valid_sync;\n    reg [N-1:0]        do_o_sync;\n\n    // Clock enable generation\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_en <= 0;\n            sclk_rst <= 1;\n        end else begin\n            sclk_en <= ~sclk_en;\n            sclk_rst <= 0;\n        end\n    end\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            pclk_en <= 0;\n            pclk_rst <= 1;\n        end else begin\n            pclk_en <= ~pclk_en;\n            pclk_rst <= 0;\n        end\n    end\n\n    // Synchronization of inputs from pclk domain to sclk domain\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            di_sync <= 0;\n            wren_sync <= 0;\n        end else begin\n            di_sync <= di_i;\n            wren_sync <= wren_i;\n        end\n    end\n\n    // Synchronization of outputs from sclk domain to pclk domain\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst) begin\n            wr_ack_sync <= 0;\n            do_valid_sync <= 0;\n            do_o_sync <= 0;\n        end else begin\n            wr_ack_sync <= wr_ack_o;\n            do_valid_sync <= do_valid_o;\n            do_o_sync <= do_o;\n        end\n    end\n\n    // Assign synchronized outputs\n    assign wr_ack_o = wr_ack_sync;\n    assign do_valid_o = do_valid_sync;\n    assign do_o = do_o_sync;\n\n    // SPI control logic\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            spi_ssel_o <= 0;\n            spi_sck_o <= 0;\n            spi_mosi_o <= 0;\n            tx_start <= 0;\n            rx_done <= 0;\n            tx_done <= 0;\n            bit_cnt <= 0;\n            shift_reg <= 0;\n            rx_shift_reg <= 0;\n        end else if (sclk_en) begin\n            if (tx_start) begin\n                spi_ssel_o <= 1;\n                spi_sck_o <= 0;\n                shift_reg <= di_sync;\n                bit_cnt <= N-1;\n                tx_start <= 0;\n            end else if (bit_cnt < N) begin\n                spi_sck_o <= ~spi_sck_o;\n                if (spi_sck_o) begin\n                    spi_mosi_o <= shift_reg[bit_cnt];\n                    shift_reg <= {shift_reg[N-2:0], 1'b0};\n                    rx_shift_reg <= {spi_miso_i, rx_shift_reg[N-1:1]};\n                    bit_cnt <= bit_cnt - 1;\n                end\n            end else begin\n                spi_sck_o <= 0;\n                spi_ssel_o <= 0;\n                rx_done <= 1;\n                tx_done <= 1;\n            end\n        end\n    end\n\n    // Request and acknowledge logic\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst) begin\n            di_req_o <= 0;\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n        end else begin\n            if (tx_done) begin\n                wr_ack_o <= 1;\n                tx_done <= 0;\n            end else if (wr_ack_o) begin\n                wr_ack_o <= 0;\n            end\n\n            if (rx_done) begin\n                do_valid_o <= 1;\n                do_o <= rx_shift_reg;\n                rx_done <= 0;\n            end else if (do_valid_o) begin\n                do_valid_o <= 0;\n            end\n\n            if (tx_done && !wren_sync) begin\n                di_req_o <= 1;\n            end else if (di_req_o && !wren_sync) begin\n                di_req_o <= 0;\n            end\n\n            if (wren_sync && !tx_start && !tx_done) begin\n                tx_start <= 1;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
