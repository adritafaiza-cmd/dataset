{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        shift_reg;\n    reg [N-1:0]        miso_reg;\n    reg [3:0]          bit_cnt;\n    reg                shift_en;\n    reg                shift_done;\n    reg                miso_sample;\n    reg                sclk_en;\n    reg                sclk_cnt;\n    reg                pclk_cnt;\n    reg                pclk_en;\n    reg                wr_ack_sync;\n    reg                wr_ack_sync2;\n    reg                di_req_sync;\n    reg                di_req_sync2;\n\n    // SCLK domain logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_cnt <= 0;\n            sclk_en <= 0;\n        end else begin\n            if (sclk_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_cnt <= 0;\n                sclk_en <= ~sclk_en;\n            end else begin\n                sclk_cnt <= sclk_cnt + 1;\n            end\n        end\n    end\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck_o <= 0;\n        end else begin\n            spi_sck_o <= sclk_en;\n        end\n    end\n\n    // Shift register and bit counter\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            shift_reg <= 0;\n            bit_cnt <= 0;\n            shift_en <= 0;\n            shift_done <= 0;\n            miso_sample <= 0;\n        end else begin\n            if (shift_en) begin\n                if (bit_cnt < N) begin\n                    shift_reg <= {shift_reg[N-2:0], spi_miso_i};\n                    bit_cnt <= bit_cnt + 1;\n                    miso_sample <= 1;\n                end else begin\n                    shift_done <= 1;\n                    shift_en <= 0;\n                end\n            end else if (shift_done) begin\n                shift_done <= 0;\n                miso_sample <= 0;\n            end else if (wr_ack_sync2) begin\n                shift_reg <= di_i;\n                bit_cnt <= 0;\n                shift_en <= 1;\n            end\n        end\n    end\n\n    // MOSI output\n    assign spi_mosi_o = shift_reg[N-1];\n\n    // PCLK domain logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            pclk_cnt <= 0;\n            pclk_en <= 0;\n        end else begin\n            if (pclk_cnt == SPI_2X_CLK_DIV - 1) begin\n                pclk_cnt <= 0;\n                pclk_en <= ~pclk_en;\n            end else begin\n                pclk_cnt <= pclk_cnt + 1;\n            end\n        end\n    end\n\n    // SSEL control\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1;\n        end else begin\n            if (wr_ack_sync2) begin\n                spi_ssel_o <= 0;\n            end else if (shift_done) begin\n                spi_ssel_o <= 1;\n            end\n        end\n    end\n\n    // Write acknowledge and request signals\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wr_ack_o <= 0;\n            wr_ack_sync <= 0;\n            wr_ack_sync2 <= 0;\n            di_req_o <= 0;\n            di_req_sync <= 0;\n            di_req_sync2 <= 0;\n        end else begin\n            wr_ack_sync <= wr_ack_sync2;\n            wr_ack_sync2 <= wren_i & ~wr_ack_sync2;\n            wr_ack_o <= wr_ack_sync2 & ~wr_ack_sync;\n\n            di_req_sync <= di_req_sync2;\n            di_req_sync2 <= shift_done & ~di_req_sync2;\n            di_req_o <= di_req_sync2 & ~di_req_sync;\n        end\n    end\n\n    // Data output and valid signal\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            do_o <= 0;\n            do_valid_o <= 0;\n        end else begin\n            if (miso_sample) begin\n                miso_reg <= shift_reg;\n            end\n            if (shift_done) begin\n                do_o <= miso_reg;\n                do_valid_o <= 1;\n            end else begin\n                do_valid_o <= 0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
