{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Synchronizers for crossing from pclk_i to sclk_i\n    reg [1:0] wren_sync;\n    reg [1:0] rst_sync;\n\n    // Synchronizers for crossing from sclk_i to pclk_i\n    reg [1:0] wr_ack_sync;\n    reg [1:0] do_valid_sync;\n\n    // Registers for data transfer\n    reg [N-1:0] tx_data;\n    reg [N-1:0] rx_data;\n    reg [3:0] bit_cnt;\n\n    // State machine states\n    typedef enum reg [2:0] {\n        IDLE,\n        LOAD_DATA,\n        TRANSFER,\n        WAIT_FOR_NEXT\n    } state_t;\n\n    state_t state, next_state;\n\n    // Synchronizers for wren_i and rst_i\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_sync <= 2'b00;\n            rst_sync  <= 2'b11;\n        end else begin\n            wren_sync <= {wren_sync[0], wren_i};\n            rst_sync  <= {rst_sync[0], rst_i};\n        end\n    end\n\n    // Synchronizers for wr_ack_o and do_valid_o\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wr_ack_sync   <= 2'b00;\n            do_valid_sync <= 2'b00;\n        end else begin\n            wr_ack_sync   <= {wr_ack_sync[0], wr_ack_o};\n            do_valid_sync <= {do_valid_sync[0], do_valid_o};\n        end\n    end\n\n    // State machine for SPI master\n    always @(posedge sclk_i or posedge rst_sync[1]) begin\n        if (rst_sync[1]) begin\n            state <= IDLE;\n        end else begin\n            state <= next_state;\n        end\n    end\n\n    // Next state logic\n    always @(*) begin\n        next_state = state;\n        case (state)\n            IDLE: begin\n                if (wren_sync[1]) begin\n                    next_state = LOAD_DATA;\n                end\n            end\n            LOAD_DATA: begin\n                next_state = TRANSFER;\n            end\n            TRANSFER: begin\n                if (bit_cnt == N) begin\n                    next_state = WAIT_FOR_NEXT;\n                end\n            end\n            WAIT_FOR_NEXT: begin\n                if (!wren_sync[1]) begin\n                    next_state = IDLE;\n                end\n            end\n        endcase\n    end\n\n    // Output logic and data transfer\n    always @(posedge sclk_i or posedge rst_sync[1]) begin\n        if (rst_sync[1]) begin\n            spi_ssel_o   <= 1'b1;\n            spi_sck_o    <= 1'b0;\n            spi_mosi_o   <= 1'b0;\n            di_req_o     <= 1'b0;\n            wr_ack_o     <= 1'b0;\n            do_valid_o   <= 1'b0;\n            do_o         <= {N{1'b0}};\n            tx_data      <= {N{1'b0}};\n            rx_data      <= {N{1'b0}};\n            bit_cnt      <= 4'b0000;\n        end else begin\n            case (state)\n                IDLE: begin\n                    di_req_o <= 1'b1;\n                end\n                LOAD_DATA: begin\n                    tx_data  <= di_i;\n                    bit_cnt  <= 4'b0000;\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b1;\n                    spi_ssel_o <= 1'b0;\n                end\n                TRANSFER: begin\n                    spi_sck_o <= ~spi_sck_o;\n                    if (spi_sck_o) begin\n                        spi_mosi_o <= tx_data[N-1];\n                        tx_data    <= {tx_data[N-2:0], 1'b0};\n                        rx_data    <= {rx_data[N-2:0], spi_miso_i};\n                        bit_cnt    <= bit_cnt + 1;\n                    end\n                end\n                WAIT_FOR_NEXT: begin\n                    spi_ssel_o <= 1'b1;\n                    do_o       <= rx_data;\n                    do_valid_o <= 1'b1;\n                    wr_ack_o   <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
