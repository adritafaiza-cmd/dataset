  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        shift_reg;\n    reg [N-1:0]        received_data;\n    reg [3:0]          bit_cnt;\n    reg                shift_en;\n    reg                shift_done;\n    reg                spi_ssel;\n    reg                spi_sck;\n    reg                spi_mosi;\n    reg                di_req;\n    reg                wr_ack;\n    reg                do_valid;\n    reg [N-1:0]        do_data;\n\n    // Synchronizers for reset and control signals\n    reg                rst_sclk_sync1;\n    reg                rst_sclk_sync2;\n    reg                rst_pclk_sync1;\n    reg                rst_pclk_sync2;\n    reg                wren_sclk_sync1;\n    reg                wren_sclk_sync2;\n\n    // Reset synchronization for sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rst_sclk_sync1 <= 1'b1;\n            rst_sclk_sync2 <= 1'b1;\n        end else begin\n            rst_sclk_sync1 <= 1'b0;\n            rst_sclk_sync2 <= rst_sclk_sync1;\n        end\n    end\n\n    // Reset synchronization for pclk domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rst_pclk_sync1 <= 1'b1;\n            rst_pclk_sync2 <= 1'b1;\n        end else begin\n            rst_pclk_sync1 <= 1'b0;\n            rst_pclk_sync2 <= rst_pclk_sync1;\n        end\n    end\n\n    // wren synchronization to sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_sclk_sync1 <= 1'b0;\n            wren_sclk_sync2 <= 1'b0;\n        end else begin\n            wren_sclk_sync1 <= wren_i;\n            wren_sclk_sync2 <= wren_sclk_sync1;\n        end\n    end\n\n    // SPI clock generation\n    reg [1:0] sclk_div_cnt;\n    always @(posedge sclk_i or posedge rst_sclk_sync2) begin\n        if (rst_sclk_sync2) begin\n            sclk_div_cnt <= 2'b00;\n            spi_sck <= 1'b0;\n        end else begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 2'b00;\n                spi_sck <= ~spi_sck;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 1;\n            end\n        end\n    end\n\n    // SPI master state machine\n    typedef enum reg [2:0] {\n        IDLE,\n        LOAD_DATA,\n        SHIFT,\n        STORE_DATA\n    } state_t;\n\n    state_t state, next_state;\n\n    always @(posedge sclk_i or posedge rst_sclk_sync2) begin\n        if (rst_sclk_sync2)\n            state <= IDLE;\n        else\n            state <= next_state;\n    end\n\n    always @(*) begin\n        next_state = state;\n        shift_en = 1'b0;\n        shift_done = 1'b0;\n        di_req = 1'b0;\n        wr_ack = 1'b0;\n        do_valid = 1'b0;\n\n        case (state)\n            IDLE: begin\n                if (wren_sclk_sync2) begin\n                    next_state = LOAD_DATA;\n                end\n            end\n            LOAD_DATA: begin\n                next_state = SHIFT;\n                shift_en = 1'b1;\n                wr_ack = 1'b1;\n            end\n            SHIFT: begin\n                if (bit_cnt == N - 1) begin\n                    next_state = STORE_DATA;\n                    shift_done = 1'b1;\n                end else begin\n                    shift_en = 1'b1;\n                end\n            end\n            STORE_DATA: begin\n                next_state = IDLE;\n                do_valid = 1'b1;\n                di_req = 1'b1;\n            end\n            default: begin\n                next_state = IDLE;\n            end\n        endcase\n    end\n\n    // Bit counter\n    always @(posedge sclk_i or posedge rst_sclk_sync2) begin\n        if (rst_sclk_sync2)\n            bit_cnt <= 4'b0000;\n        else if (shift_en) begin\n            if (shift_done)\n                bit_cnt <= 4'b0000;\n            else\n                bit_cnt <= bit_cnt + 1;\n        end\n    end\n\n    // Shift register for transmit and receive\n    always @(posedge sclk_i or posedge rst_sclk_sync2) begin\n        if (rst_sclk_sync2) begin\n            shift_reg <= {N{1'b0}};\n            received_data <= {N{1'b0}};\n        end else begin\n            if (shift_en) begin\n                if (spi_sck) begin\n                    shift_reg <= {shift_reg[N-2:0], spi_miso_i};\n                    received_data <= {received_data[N-2:0], spi_mosi};\n                end\n            end else if (state == LOAD_DATA) begin\n                shift_reg <= di_i;\n            end\n        end\n    end\n\n    // Output assignments\n    always @(posedge pclk_i or posedge rst_pclk_sync2) begin\n        if (rst_pclk_sync2) begin\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            spi_mosi_o <= 1'b0;\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n        end else begin\n            spi_ssel_o <= ~spi_ssel;\n            spi_sck_o <= spi_sck;\n            spi_mosi_o <= shift_reg[N-1];\n            di_req_o <= di_req;\n            wr_ack_o <= wr_ack;\n            do_valid_o <= do_valid;\n            do_o <= received_data;\n        end\n    end\n\n    // SPI select control\n    always @(posedge sclk_i or posedge rst_sclk_sync2) begin\n        if (rst_sclk_sync2)\n            spi_ssel <= 1'b1;\n        else begin\n            if (state == LOAD_DATA)\n                spi_ssel <= 1'b0;\n            else if (state == IDLE)\n                spi_ssel <= 1'b1;\n        end\n    end\n\nendmodule\n```<|im_end|>",
