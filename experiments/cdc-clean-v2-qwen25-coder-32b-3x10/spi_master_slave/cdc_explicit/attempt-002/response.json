{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        shift_reg;\n    reg [N-1:0]        miso_reg;\n    reg [3:0]          bit_cnt;\n    reg                shift_en;\n    reg                shift_done;\n    reg                miso_sample;\n    reg                miso_sample_d;\n    reg                miso_sample_d2;\n    reg                wren_sync;\n    reg                wren_sync_d;\n    reg                wren_sync_d2;\n    reg                di_req_sync;\n    reg                di_req_sync_d;\n    reg                di_req_sync_d2;\n\n    // Clock domain crossing for wren_i\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_sync <= 1'b0;\n            wren_sync_d <= 1'b0;\n            wren_sync_d2 <= 1'b0;\n        end else begin\n            wren_sync <= wren_i;\n            wren_sync_d <= wren_sync;\n            wren_sync_d2 <= wren_sync_d;\n        end\n    end\n\n    // Clock domain crossing for di_req_o\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_sync <= 1'b0;\n            di_req_sync_d <= 1'b0;\n            di_req_sync_d2 <= 1'b0;\n        end else begin\n            di_req_sync <= di_req_o;\n            di_req_sync_d <= di_req_sync;\n            di_req_sync_d2 <= di_req_sync_d;\n        end\n    end\n\n    // SPI clock generation\n    reg [1:0] sclk_div;\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_div <= 2'b00;\n            spi_sck_o <= 1'b0;\n        end else begin\n            sclk_div <= sclk_div + 1'b1;\n            if (sclk_div == SPI_2X_CLK_DIV - 1) begin\n                spi_sck_o <= ~spi_sck_o;\n                sclk_div <= 2'b00;\n            end\n        end\n    end\n\n    // SPI control logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1;\n            shift_reg <= {N{1'b0}};\n            miso_reg <= {N{1'b0}};\n            bit_cnt <= 4'b0000;\n            shift_en <= 1'b0;\n            shift_done <= 1'b0;\n            miso_sample <= 1'b0;\n            miso_sample_d <= 1'b0;\n            miso_sample_d2 <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            di_req_o <= 1'b0;\n        end else begin\n            if (shift_done) begin\n                spi_ssel_o <= 1'b1;\n                do_o <= miso_reg;\n                do_valid_o <= 1'b1;\n                di_req_o <= 1'b1;\n            end else begin\n                do_valid_o <= 1'b0;\n                di_req_o <= 1'b0;\n            end\n\n            if (wren_sync_d2 && !wren_sync_d) begin\n                spi_ssel_o <= 1'b0;\n                shift_reg <= di_i;\n                bit_cnt <= N - 1;\n                shift_en <= 1'b1;\n                wr_ack_o <= 1'b1;\n            end else if (shift_en) begin\n                if (spi_sck_o) begin\n                    miso_sample <= spi_miso_i;\n                end else begin\n                    miso_sample <= miso_sample;\n                end\n\n                if (bit_cnt == 4'b0000) begin\n                    shift_en <= 1'b0;\n                    shift_done <= 1'b1;\n                end else begin\n                    shift_en <= 1'b1;\n                    shift_done <= 1'b0;\n                    bit_cnt <= bit_cnt - 1;\n                end\n            end else begin\n                wr_ack_o <= 1'b0;\n            end\n\n            // MISO sampling\n            miso_sample_d <= miso_sample;\n            miso_sample_d2 <= miso_sample_d;\n\n            if (!spi_sck_o) begin\n                miso_reg <= {miso_reg[N-2:0], miso_sample_d2};\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
