  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        shift_reg;\n    reg [N-1:0]        rx_data;\n    reg [3:0]          bit_cnt;\n    reg                tx_start;\n    reg                rx_done;\n    reg                tx_done;\n    reg                sclk_en;\n    reg                pclk_en;\n    reg                sclk_rst;\n    reg                pclk_rst;\n    reg                sclk_rst_sync;\n    reg                pclk_rst_sync;\n    reg                sclk_rst_sync2;\n    reg                pclk_rst_sync2;\n    reg                sclk_en_sync;\n    reg                pclk_en_sync;\n    reg                sclk_en_sync2;\n    reg                pclk_en_sync2;\n    reg                wren_sync;\n    reg                wren_sync2;\n    reg                wren_sync3;\n    reg                di_req_sync;\n    reg                di_req_sync2;\n    reg                di_req_sync3;\n\n    // Reset synchronization\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_rst_sync <= 1'b1;\n            sclk_rst_sync2 <= 1'b1;\n        end else begin\n            sclk_rst_sync <= 1'b0;\n            sclk_rst_sync2 <= sclk_rst_sync;\n        end\n    end\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            pclk_rst_sync <= 1'b1;\n            pclk_rst_sync2 <= 1'b1;\n        end else begin\n            pclk_rst_sync <= 1'b0;\n            pclk_rst_sync2 <= pclk_rst_sync;\n        end\n    end\n\n    // Enable synchronization\n    always @(posedge sclk_i or posedge sclk_rst_sync2) begin\n        if (sclk_rst_sync2) begin\n            sclk_en_sync <= 1'b0;\n            sclk_en_sync2 <= 1'b0;\n        end else begin\n            sclk_en_sync <= sclk_en;\n            sclk_en_sync2 <= sclk_en_sync;\n        end\n    end\n\n    always @(posedge pclk_i or posedge pclk_rst_sync2) begin\n        if (pclk_rst_sync2) begin\n            pclk_en_sync <= 1'b0;\n            pclk_en_sync2 <= 1'b0;\n        end else begin\n            pclk_en_sync <= pclk_en;\n            pclk_en_sync2 <= pclk_en_sync;\n        end\n    end\n\n    // wren synchronization\n    always @(posedge pclk_i or posedge pclk_rst_sync2) begin\n        if (pclk_rst_sync2) begin\n            wren_sync <= 1'b0;\n            wren_sync2 <= 1'b0;\n            wren_sync3 <= 1'b0;\n        end else begin\n            wren_sync <= wren_i;\n            wren_sync2 <= wren_sync;\n            wren_sync3 <= wren_sync2;\n        end\n    end\n\n    // di_req synchronization\n    always @(posedge sclk_i or posedge sclk_rst_sync2) begin\n        if (sclk_rst_sync2) begin\n            di_req_sync <= 1'b0;\n            di_req_sync2 <= 1'b0;\n            di_req_sync3 <= 1'b0;\n        end else begin\n            di_req_sync <= di_req_o;\n            di_req_sync2 <= di_req_sync;\n            di_req_sync3 <= di_req_sync2;\n        end\n    end\n\n    // SPI clock enable generation\n    reg [1:0] sclk_div_cnt;\n    always @(posedge sclk_i or posedge sclk_rst_sync2) begin\n        if (sclk_rst_sync2) begin\n            sclk_div_cnt <= 2'b00;\n            sclk_en <= 1'b0;\n        end else begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 2'b00;\n                sclk_en <= ~sclk_en;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 1;\n            end\n        end\n    end\n\n    // SPI control logic\n    always @(posedge sclk_i or posedge sclk_rst_sync2) begin\n        if (sclk_rst_sync2) begin\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            spi_mosi_o <= 1'b0;\n            bit_cnt <= 4'b0000;\n            tx_start <= 1'b0;\n            rx_done <= 1'b0;\n            tx_done <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            shift_reg <= {N{1'b0}};\n            rx_data <= {N{1'b0}};\n        end else begin\n            if (sclk_en_sync2) begin\n                if (tx_start && (bit_cnt == N)) begin\n                    tx_done <= 1'b1;\n                    rx_done <= 1'b1;\n                    tx_start <= 1'b0;\n                end else if (tx_start) begin\n                    spi_mosi_o <= shift_reg[N-1];\n                    shift_reg <= {shift_reg[N-2:0], 1'b0};\n                    bit_cnt <= bit_cnt + 1;\n                end else if (wren_sync3 && !di_req_sync3) begin\n                    shift_reg <= di_i;\n                    bit_cnt <= 4'b0000;\n                    tx_start <= 1'b1;\n                    wr_ack_o <= 1'b1;\n                end else begin\n                    wr_ack_o <= 1'b0;\n                end\n\n                if (rx_done) begin\n                    do_o <= rx_data;\n                    do_valid_o <= 1'b1;\n                    rx_done <= 1'b0;\n                end else begin\n                    do_valid_o <= 1'b0;\n                end\n\n                if (tx_done) begin\n                    tx_done <= 1'b0;\n                    di_req_o <= 1'b1;\n                end else if (di_req_sync3) begin\n                    di_req_o <= 1'b0;\n                end\n\n                spi_sck_o <= sclk_en;\n                spi_ssel_o <= ~tx_start;\n            end\n        end\n    end\n\n    // MISO capture\n    always @(posedge sclk_i or posedge sclk_rst_sync2) begin\n        if (sclk_rst_sync2) begin\n            rx_data <= {N{1'b0}};\n        end else begin\n            if (sclk_en_sync2 && tx_start && (bit_cnt < N)) begin\n                rx_data <= {rx_data[N-2:0], spi_miso_i};\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
