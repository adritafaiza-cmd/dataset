  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal signals\n    reg [N-1:0]        shift_reg;\n    reg [N-1:0]        rx_data;\n    reg [3:0]          bit_cnt;\n    reg                tx_start;\n    reg                rx_done;\n    reg                tx_done;\n    reg                sclk_en;\n    reg                pclk_en;\n    reg                sclk_rst;\n    reg                pclk_rst;\n    reg                spi_ssel_r;\n    reg                spi_sck_r;\n    reg                spi_mosi_r;\n    reg                di_req_r;\n    reg                wr_ack_r;\n    reg                do_valid_r;\n    reg [N-1:0]        do_o_r;\n\n    // Clock and reset synchronizers\n    reg [1:0]          rst_sync_sclk;\n    reg [1:0]          rst_sync_pclk;\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rst_sync_sclk <= 2'b11;\n        end else begin\n            rst_sync_sclk <= {rst_sync_sclk[0], rst_i};\n        end\n    end\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rst_sync_pclk <= 2'b11;\n        end else begin\n            rst_sync_pclk <= {rst_sync_pclk[0], rst_i};\n        end\n    end\n\n    assign sclk_rst = rst_sync_sclk[1];\n    assign pclk_rst = rst_sync_pclk[1];\n\n    // SPI clock enable generation\n    reg [1:0]          sclk_div_cnt;\n\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            sclk_div_cnt <= 2'b00;\n            sclk_en <= 1'b0;\n        end else begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 2'b00;\n                sclk_en <= ~sclk_en;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 1;\n            end\n        end\n    end\n\n    // SPI clock generation\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            spi_sck_r <= 1'b0;\n        end else if (sclk_en) begin\n            spi_sck_r <= ~spi_sck_r;\n        end\n    end\n\n    assign spi_sck_o = spi_sck_r;\n\n    // SPI master state machine\n    typedef enum reg [2:0] {\n        IDLE,\n        START,\n        TRANSFER,\n        FINISH\n    } state_t;\n\n    state_t state, next_state;\n\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            state <= IDLE;\n        end else begin\n            state <= next_state;\n        end\n    end\n\n    always @(*) begin\n        next_state = state;\n        case (state)\n            IDLE: begin\n                if (tx_start) begin\n                    next_state = START;\n                end\n            end\n            START: begin\n                next_state = TRANSFER;\n            end\n            TRANSFER: begin\n                if (bit_cnt == N - 1) begin\n                    next_state = FINISH;\n                end\n            end\n            FINISH: begin\n                next_state = IDLE;\n            end\n        endcase\n    end\n\n    // SPI master control logic\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            spi_ssel_r <= 1'b1;\n            spi_mosi_r <= 1'b0;\n            bit_cnt <= 4'b0000;\n            tx_start <= 1'b0;\n            tx_done <= 1'b0;\n            rx_done <= 1'b0;\n            shift_reg <= {N{1'b0}};\n            rx_data <= {N{1'b0}};\n        end else begin\n            case (state)\n                IDLE: begin\n                    spi_ssel_r <= 1'b1;\n                    if (tx_start) begin\n                        spi_ssel_r <= 1'b0;\n                        shift_reg <= di_i;\n                        bit_cnt <= 4'b0000;\n                    end\n                end\n                START: begin\n                    spi_mosi_r <= shift_reg[N-1];\n                end\n                TRANSFER: begin\n                    if (sclk_en) begin\n                        shift_reg <= {shift_reg[N-2:0], 1'b0};\n                        spi_mosi_r <= shift_reg[N-1];\n                        bit_cnt <= bit_cnt + 1;\n                    end\n                end\n                FINISH: begin\n                    tx_done <= 1'b1;\n                    rx_done <= 1'b1;\n                end\n            endcase\n        end\n    end\n\n    // Data capture on MISO\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            rx_data <= {N{1'b0}};\n        end else if (sclk_en && state == TRANSFER) begin\n            rx_data <= {rx_data[N-2:0], spi_miso_i};\n        end\n    end\n\n    // Output assignments\n    assign spi_mosi_o = spi_mosi_r;\n    assign spi_ssel_o = spi_ssel_r;\n\n    // Parallel side interface control\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst) begin\n            di_req_r <= 1'b0;\n            wr_ack_r <= 1'b0;\n            do_valid_r <= 1'b0;\n            do_o_r <= {N{1'b0}};\n        end else begin\n            di_req_r <= 1'b0;\n            wr_ack_r <= 1'b0;\n            do_valid_r <= 1'b0;\n\n            if (state == IDLE && !tx_start) begin\n                if (wren_i) begin\n                    tx_start <= 1'b1;\n                    wr_ack_r <= 1'b1;\n                end else begin\n                    di_req_r <= 1'b1;\n                end\n            end\n\n            if (tx_done) begin\n                tx_start <= 1'b0;\n                tx_done <= 1'b0;\n            end\n\n            if (rx_done) begin\n                rx_done <= 1'b0;\n                do_o_r <= rx_data;\n                do_valid_r <= 1'b1;\n            end\n        end\n    end\n\n    assign di_req_o = di_req_r;\n    assign wr_ack_o = wr_ack_r;\n    assign do_valid_o = do_valid_r;\n    assign do_o = do_o_r;\n\nendmodule\n```<|im_end|>",
