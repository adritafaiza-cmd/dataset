{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    reg [N-1:0] shift_reg;\n    reg [3:0]   bit_cnt;\n    reg         sclk_div_cnt;\n    reg         sclk_edge;\n    reg         pclk_edge;\n    reg         shift_en;\n    reg         load_en;\n    reg         done;\n\n    // SCLK edge detection\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_div_cnt <= 0;\n            sclk_edge <= 0;\n        end else begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 0;\n                sclk_edge <= ~sclk_edge;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 1;\n            end\n        end\n    end\n\n    // PCLK edge detection\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            pclk_edge <= 0;\n        end else begin\n            pclk_edge <= ~pclk_edge;\n        end\n    end\n\n    // State machine\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 0;\n            spi_sck_o <= 0;\n            di_req_o <= 1;\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n            shift_en <= 0;\n            load_en <= 0;\n            done <= 0;\n            bit_cnt <= 0;\n        end else begin\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n\n            if (done) begin\n                spi_ssel_o <= 0;\n                di_req_o <= 1;\n                done <= 0;\n            end else if (di_req_o && wren_i) begin\n                spi_ssel_o <= 1;\n                di_req_o <= 0;\n                wr_ack_o <= 1;\n                load_en <= 1;\n                shift_en <= 1;\n                bit_cnt <= N - 1;\n            end else if (shift_en) begin\n                if (sclk_edge) begin\n                    if (bit_cnt == 0) begin\n                        shift_en <= 0;\n                        done <= 1;\n                        do_valid_o <= 1;\n                    end else begin\n                        bit_cnt <= bit_cnt - 1;\n                    end\n                end\n            end\n        end\n    end\n\n    // Shift register and data handling\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            shift_reg <= 0;\n            do_o <= 0;\n        end else begin\n            if (load_en) begin\n                shift_reg <= di_i;\n                load_en <= 0;\n            end else if (shift_en && sclk_edge) begin\n                shift_reg <= {shift_reg[N-2:0], 1'b0};\n                do_o <= {do_o[N-2:0], spi_miso_i};\n            end\n        end\n    end\n\n    // SPI signals\n    assign spi_mosi_o = shift_reg[N-1];\n    assign spi_sck_o = sclk_edge;\n\nendmodule\n```<|im_end|>",
