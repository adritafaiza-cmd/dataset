{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    reg [N-1:0] shift_reg;\n    reg [3:0]   bit_cnt;\n    reg         shift_en;\n    reg         shift_dir;\n    reg [N-1:0] data_in;\n    reg         data_in_valid;\n    reg         data_out_valid;\n    reg [1:0]   sclk_div_cnt;\n\n    // State machine states\n    typedef enum reg [2:0] {\n        IDLE,\n        LOAD_DATA,\n        SHIFT_OUT,\n        SHIFT_IN,\n        FINISH\n    } state_t;\n\n    state_t state, next_state;\n\n    // State machine\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= IDLE;\n        end else begin\n            state <= next_state;\n        end\n    end\n\n    // Next state logic\n    always @(*) begin\n        next_state = state;\n        case (state)\n            IDLE: begin\n                if (data_in_valid) begin\n                    next_state = LOAD_DATA;\n                end\n            end\n            LOAD_DATA: begin\n                next_state = SHIFT_OUT;\n            end\n            SHIFT_OUT: begin\n                if (bit_cnt == N-1) begin\n                    next_state = SHIFT_IN;\n                end\n            end\n            SHIFT_IN: begin\n                if (bit_cnt == N-1) begin\n                    next_state = FINISH;\n                end\n            end\n            FINISH: begin\n                next_state = IDLE;\n            end\n        endcase\n    end\n\n    // Output logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            di_req_o <= 1'b1;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            data_in_valid <= 1'b0;\n            data_out_valid <= 1'b0;\n            bit_cnt <= 4'b0;\n            sclk_div_cnt <= 2'b0;\n        end else begin\n            case (state)\n                IDLE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o <= 1'b0;\n                    di_req_o <= 1'b1;\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                    if (wren_i) begin\n                        data_in <= di_i;\n                        data_in_valid <= 1'b1;\n                        di_req_o <= 1'b0;\n                    end\n                end\n                LOAD_DATA: begin\n                    spi_ssel_o <= 1'b0;\n                    shift_reg <= data_in;\n                    bit_cnt <= 4'b0;\n                    data_in_valid <= 1'b0;\n                    wr_ack_o <= 1'b1;\n                end\n                SHIFT_OUT: begin\n                    if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                        spi_sck_o <= ~spi_sck_o;\n                        if (spi_sck_o) begin\n                            shift_reg <= {shift_reg[N-2:0], 1'b0};\n                            bit_cnt <= bit_cnt + 1;\n                        end\n                        sclk_div_cnt <= 2'b0;\n                    end else begin\n                        sclk_div_cnt <= sclk_div_cnt + 1;\n                    end\n                end\n                SHIFT_IN: begin\n                    if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                        spi_sck_o <= ~spi_sck_o;\n                        if (spi_sck_o) begin\n                            shift_reg <= {shift_reg[N-2:0], spi_miso_i};\n                            bit_cnt <= bit_cnt + 1;\n                        end\n                        sclk_div_cnt <= 2'b0;\n                    end else begin\n                        sclk_div_cnt <= sclk_div_cnt + 1;\n                    end\n                end\n                FINISH: begin\n                    spi_ssel_o <= 1'b1;\n                    do_o <= shift_reg;\n                    do_valid_o <= 1'b1;\n                end\n            endcase\n        end\n    end\n\n    // SPI MOSI output\n    assign spi_mosi_o = shift_reg[N-1];\n\nendmodule\n```<|im_end|>",
