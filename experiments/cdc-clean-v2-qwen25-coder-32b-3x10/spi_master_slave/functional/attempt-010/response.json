{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    reg [N-1:0] shift_reg;\n    reg [3:0]   bit_cnt;\n    reg         shift_en;\n    reg         sclk_div_cnt;\n    reg         sclk_edge;\n    reg [N-1:0] data_in;\n    reg         data_in_valid;\n    reg         data_out_valid;\n    reg [N-1:0] data_out;\n\n    // SCLK Divider\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_div_cnt <= 0;\n            sclk_edge <= 0;\n        end else begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 0;\n                sclk_edge <= ~sclk_edge;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 1;\n            end\n        end\n    end\n\n    // SPI Clock and Select\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck_o <= 0;\n            spi_ssel_o <= 1;\n        end else begin\n            if (sclk_edge) begin\n                spi_sck_o <= ~spi_sck_o;\n                if (bit_cnt == N) begin\n                    spi_ssel_o <= 1;\n                end else begin\n                    spi_ssel_o <= 0;\n                end\n            end\n        end\n    end\n\n    // Shift Register Control\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            shift_reg <= 0;\n            bit_cnt <= 0;\n            shift_en <= 0;\n        end else begin\n            if (sclk_edge && spi_ssel_o == 0) begin\n                if (bit_cnt == 0) begin\n                    shift_reg <= data_in;\n                    bit_cnt <= N;\n                end else begin\n                    shift_reg <= {shift_reg[N-2:0], spi_miso_i};\n                    bit_cnt <= bit_cnt - 1;\n                end\n            end\n        end\n    end\n\n    // Data Input Handling\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            data_in <= 0;\n            data_in_valid <= 0;\n            di_req_o <= 1;\n            wr_ack_o <= 0;\n        end else begin\n            if (wren_i && di_req_o) begin\n                data_in <= di_i;\n                data_in_valid <= 1;\n                di_req_o <= 0;\n                wr_ack_o <= 1;\n            end else begin\n                wr_ack_o <= 0;\n            end\n            if (bit_cnt == N && spi_ssel_o == 1 && data_in_valid) begin\n                data_in_valid <= 0;\n                di_req_o <= 1;\n            end\n        end\n    end\n\n    // Data Output Handling\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            data_out <= 0;\n            data_out_valid <= 0;\n            do_valid_o <= 0;\n            do_o <= 0;\n        end else begin\n            if (bit_cnt == 0 && spi_ssel_o == 1 && data_in_valid == 0) begin\n                data_out <= shift_reg;\n                data_out_valid <= 1;\n                do_valid_o <= 1;\n                do_o <= shift_reg;\n            end else begin\n                do_valid_o <= 0;\n            end\n        end\n    end\n\n    // MOSI Output\n    assign spi_mosi_o = shift_reg[N-1];\n\nendmodule\n```<|im_end|>",
