{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    reg [N-1:0] shift_reg;\n    reg [N-1:0] data_in;\n    reg [N-1:0] data_out;\n    reg [3:0]   bit_cnt;\n    reg         sclk_div_cnt;\n    reg         sclk_edge;\n    reg         pclk_edge;\n    reg         start_transfer;\n    reg         transfer_in_progress;\n\n    // Synchronous reset for pclk domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1'b1;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            spi_ssel_o <= 1'b0;\n            spi_sck_o <= 1'b0;\n            start_transfer <= 1'b0;\n            transfer_in_progress <= 1'b0;\n            bit_cnt <= 4'b0;\n            sclk_div_cnt <= 1'b0;\n        end else begin\n            // Request new data if not busy\n            if (!transfer_in_progress) begin\n                di_req_o <= 1'b1;\n            end\n\n            // Accept new data\n            if (wren_i && di_req_o) begin\n                data_in <= di_i;\n                di_req_o <= 1'b0;\n                wr_ack_o <= 1'b1;\n                start_transfer <= 1'b1;\n            end else begin\n                wr_ack_o <= 1'b0;\n            end\n\n            // Start transfer\n            if (start_transfer) begin\n                start_transfer <= 1'b0;\n                transfer_in_progress <= 1'b1;\n                spi_ssel_o <= 1'b1;\n                shift_reg <= data_in;\n                bit_cnt <= N-1;\n            end\n\n            // Transfer in progress\n            if (transfer_in_progress) begin\n                if (sclk_edge) begin\n                    if (bit_cnt == 0) begin\n                        transfer_in_progress <= 1'b0;\n                        spi_ssel_o <= 1'b0;\n                        do_o <= data_out;\n                        do_valid_o <= 1'b1;\n                    end else begin\n                        bit_cnt <= bit_cnt - 1;\n                    end\n                end\n            end else begin\n                do_valid_o <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronous reset for sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck_o <= 1'b0;\n            sclk_div_cnt <= 1'b0;\n            sclk_edge <= 1'b0;\n            data_out <= {N{1'b0}};\n        end else begin\n            // SCK generation\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 1'b0;\n                spi_sck_o <= ~spi_sck_o;\n                sclk_edge <= 1'b1;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 1;\n                sclk_edge <= 1'b0;\n            end\n\n            // Shift register and data out capture\n            if (sclk_edge && spi_sck_o) begin\n                spi_mosi_o <= shift_reg[N-1];\n                shift_reg <= {shift_reg[N-2:0], 1'b0};\n                data_out <= {data_out[N-2:0], spi_miso_i};\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
