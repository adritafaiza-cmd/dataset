{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    reg [N-1:0] shift_reg;\n    reg [N-1:0] data_in;\n    reg [N-1:0] data_out;\n    reg [3:0]   bit_cnt;\n    reg         sclk_div_cnt;\n    reg         sclk_edge;\n    reg         transfer_active;\n    reg         data_loaded;\n\n    // SCLK Divider\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_div_cnt <= 0;\n        end else begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 0;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 1;\n            end\n        end\n    end\n\n    // SCLK Edge Detection\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_edge <= 0;\n        end else begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_edge <= ~sclk_edge;\n            end\n        end\n    end\n\n    // SPI Control Logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1;\n            spi_sck_o  <= 1'b0;\n            di_req_o   <= 1'b1;\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            data_loaded <= 1'b0;\n            transfer_active <= 1'b0;\n            bit_cnt <= 0;\n            shift_reg <= 0;\n            data_in <= 0;\n            data_out <= 0;\n        end else begin\n            // Request new data\n            if (!transfer_active && !data_loaded) begin\n                di_req_o <= 1'b1;\n            end else begin\n                di_req_o <= 1'b0;\n            end\n\n            // Accept new data\n            if (wren_i && di_req_o) begin\n                data_in <= di_i;\n                data_loaded <= 1'b1;\n                wr_ack_o <= 1'b1;\n            end else begin\n                wr_ack_o <= 1'b0;\n            end\n\n            // Start transfer\n            if (data_loaded && !transfer_active) begin\n                transfer_active <= 1'b1;\n                spi_ssel_o <= 1'b0;\n                shift_reg <= data_in;\n                bit_cnt <= N - 1;\n                data_loaded <= 1'b0;\n            end\n\n            // Shift data\n            if (transfer_active && sclk_edge) begin\n                spi_sck_o <= ~spi_sck_o;\n                if (spi_sck_o) begin\n                    spi_mosi_o = shift_reg[bit_cnt];\n                    if (bit_cnt == 0) begin\n                        transfer_active <= 1'b0;\n                        spi_ssel_o <= 1'b1;\n                        data_out <= shift_reg;\n                        do_valid_o <= 1'b1;\n                    end else begin\n                        bit_cnt <= bit_cnt - 1;\n                    end\n                end else begin\n                    data_out[bit_cnt] = spi_miso_i;\n                end\n            end\n\n            // End of transfer\n            if (do_valid_o) begin\n                do_valid_o <= 1'b0;\n                do_o <= data_out;\n            end\n        end\n    end\n\n    assign spi_mosi_o = shift_reg[bit_cnt];\n\nendmodule\n```<|im_end|>",
