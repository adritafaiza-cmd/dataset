{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    reg [N-1:0] shift_reg;\n    reg [3:0]   bit_cnt;\n    reg         sclk_div_cnt;\n    reg         sclk_edge;\n    reg         pclk_edge;\n    reg         start_transfer;\n    reg         transfer_in_progress;\n\n    // SCLK Divider\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_div_cnt <= 0;\n            sclk_edge <= 0;\n        end else begin\n            if (sclk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                sclk_div_cnt <= 0;\n                sclk_edge <= ~sclk_edge;\n            end else begin\n                sclk_div_cnt <= sclk_div_cnt + 1;\n            end\n        end\n    end\n\n    // SPI Clock Generation\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck_o <= 0;\n        end else begin\n            spi_sck_o <= sclk_edge;\n        end\n    end\n\n    // PCLK Edge Detection\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            pclk_edge <= 0;\n        end else begin\n            pclk_edge <= ~pclk_edge;\n        end\n    end\n\n    // Control Logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 0;\n            di_req_o <= 1;\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n            start_transfer <= 0;\n            transfer_in_progress <= 0;\n            bit_cnt <= 0;\n        end else begin\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n\n            if (!transfer_in_progress && wren_i && di_req_o) begin\n                start_transfer <= 1;\n                di_req_o <= 0;\n            end else begin\n                start_transfer <= 0;\n            end\n\n            if (start_transfer) begin\n                spi_ssel_o <= 1;\n                shift_reg <= di_i;\n                bit_cnt <= N - 1;\n                transfer_in_progress <= 1;\n                wr_ack_o <= 1;\n            end else if (transfer_in_progress) begin\n                if (sclk_edge) begin\n                    spi_mosi_o = shift_reg[bit_cnt];\n                    if (bit_cnt == 0) begin\n                        transfer_in_progress <= 0;\n                        spi_ssel_o <= 0;\n                        do_valid_o <= 1;\n                        do_o <= shift_reg;\n                        di_req_o <= 1;\n                    end else begin\n                        bit_cnt <= bit_cnt - 1;\n                    end\n                end\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
