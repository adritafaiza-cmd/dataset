  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n\n    // FIFO for requests from source to destination\n    reg [ADDR_WIDTH-1:0]       req_addr_ff [0:DEPTH-1];\n    reg [DATA_WIDTH-1:0]       req_wdata_ff [0:DEPTH-1];\n    reg [DATA_WIDTH/8-1:0]     req_strb_ff [0:DEPTH-1];\n    reg [2:0]                  req_prot_ff [0:DEPTH-1];\n    reg                        req_write_ff [0:DEPTH-1];\n    reg [$clog2(DEPTH)-1:0]    req_wr_ptr;\n    reg [$clog2(DEPTH)-1:0]    req_rd_ptr;\n    reg [$clog2(DEPTH):0]      req_count;\n\n    // FIFO for responses from destination to source\n    reg [DATA_WIDTH-1:0]       resp_rdata_ff [0:DEPTH-1];\n    reg                        resp_slverr_ff [0:DEPTH-1];\n    reg [$clog2(DEPTH)-1:0]    resp_wr_ptr;\n    reg [$clog2(DEPTH)-1:0]    resp_rd_ptr;\n    reg [$clog2(DEPTH):0]      resp_count;\n\n    // Source side logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_pready_o <= 1'b0;\n            req_wr_ptr <= {$clog2(DEPTH){1'b0}};\n            req_count <= {$clog2(DEPTH)+1{1'b0}};\n        end else begin\n            if (src_psel_i && src_penable_i && (req_count < DEPTH)) begin\n                req_addr_ff[req_wr_ptr] <= src_paddr_i;\n                req_wdata_ff[req_wr_ptr] <= src_pwdata_i;\n                req_strb_ff[req_wr_ptr] <= src_pstrb_i;\n                req_prot_ff[req_wr_ptr] <= src_pprot_i;\n                req_write_ff[req_wr_ptr] <= src_pwrite_i;\n                req_wr_ptr <= req_wr_ptr + 1;\n                req_count <= req_count + 1;\n                src_pready_o <= 1'b0;\n            end else if (!src_pready_o && (req_count == 0)) begin\n                src_pready_o <= 1'b1;\n            end\n        end\n    end\n\n    // Destination side logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_psel_o <= 1'b0;\n            dst_penable_o <= 1'b0;\n            req_rd_ptr <= {$clog2(DEPTH){1'b0}};\n        end else begin\n            if (req_count > 0 && dst_pready_i) begin\n                dst_psel_o <= 1'b1;\n                dst_penable_o <= 1'b1;\n                dst_pwrite_o <= req_write_ff[req_rd_ptr];\n                dst_paddr_o <= req_addr_ff[req_rd_ptr];\n                dst_pwdata_o <= req_wdata_ff[req_rd_ptr];\n                dst_pstrb_o <= req_strb_ff[req_rd_ptr];\n                dst_pprot_o <= req_prot_ff[req_rd_ptr];\n                req_rd_ptr <= req_rd_ptr + 1;\n                req_count <= req_count - 1;\n            end else begin\n                dst_psel_o <= 1'b0;\n                dst_penable_o <= 1'b0;\n            end\n        end\n    end\n\n    // Response FIFO write logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            resp_wr_ptr <= {$clog2(DEPTH){1'b0}};\n            resp_count <= {$clog2(DEPTH)+1{1'b0}};\n        end else begin\n            if (dst_psel_o && dst_penable_o && dst_pready_i) begin\n                resp_rdata_ff[resp_wr_ptr] <= dst_prdata_i;\n                resp_slverr_ff[resp_wr_ptr] <= dst_pslverr_i;\n                resp_wr_ptr <= resp_wr_ptr + 1;\n                resp_count <= resp_count + 1;\n            end\n        end\n    end\n\n    // Source side response read logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_prdata_o <= {DATA_WIDTH{1'b0}};\n            src_pslverr_o <= 1'b0;\n            resp_rd_ptr <= {$clog2(DEPTH){1'b0}};\n        end else begin\n            if (resp_count > 0) begin\n                src_prdata_o <= resp_rdata_ff[resp_rd_ptr];\n                src_pslverr_o <= resp_slverr_ff[resp_rd_ptr];\n                resp_rd_ptr <= resp_rd_ptr + 1;\n                resp_count <= resp_count - 1;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
