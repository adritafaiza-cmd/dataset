  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // FIFO signals\n    reg [ADDR_WIDTH-1:0]       fifo_addr;\n    reg [DATA_WIDTH-1:0]       fifo_wdata;\n    reg [DATA_WIDTH/8-1:0]     fifo_strb;\n    reg [2:0]                  fifo_prot;\n    reg                        fifo_wren;\n    reg                        fifo_rden;\n    reg [DATA_WIDTH-1:0]       fifo_rdata;\n    reg                        fifo_empty;\n    reg                        fifo_full;\n\n    // Source side signals\n    reg                        src_req_valid;\n    reg                        src_req_ready;\n    reg                        src_req_accepted;\n    reg                        src_req_done;\n\n    // Destination side signals\n    reg                        dst_req_valid;\n    reg                        dst_req_ready;\n    reg                        dst_req_accepted;\n    reg                        dst_req_done;\n\n    // FIFO instantiation\n    fifo_sync #(\n        .DATA_WIDTH (ADDR_WIDTH + DATA_WIDTH + DATA_WIDTH/8 + 3),\n        .LOG_DEPTH  (LOG_DEPTH)\n    ) fifo_inst (\n        .clk_wr     (src_pclk_i),\n        .rst_wr_n   (src_preset_ni),\n        .clk_rd     (dst_pclk_i),\n        .rst_rd_n   (dst_preset_ni),\n        .din        ({src_paddr_i, src_pwdata_i, src_pstrb_i, src_pprot_i}),\n        .wr_en      (fifo_wren),\n        .rd_en      (fifo_rden),\n        .dout       ({fifo_addr, fifo_wdata, fifo_strb, fifo_prot}),\n        .empty      (fifo_empty),\n        .full       (fifo_full)\n    );\n\n    // Source side logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_valid <= 0;\n            src_req_accepted <= 0;\n            src_req_done <= 0;\n            fifo_wren <= 0;\n        end else begin\n            if (src_psel_i && src_penable_i && !src_req_valid) begin\n                src_req_valid <= 1;\n            end\n            if (src_req_valid && !fifo_full) begin\n                fifo_wren <= 1;\n                src_req_accepted <= 1;\n            end else begin\n                fifo_wren <= 0;\n            end\n            if (src_req_accepted && fifo_empty) begin\n                src_req_done <= 1;\n            end\n            if (src_req_done && dst_pready_i) begin\n                src_req_valid <= 0;\n                src_req_accepted <= 0;\n                src_req_done <= 0;\n            end\n        end\n    end\n\n    assign src_pready_o = src_req_done;\n    assign src_prdata_o = dst_prdata_i;\n    assign src_pslverr_o = dst_pslverr_i;\n\n    // Destination side logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req_valid <= 0;\n            dst_req_accepted <= 0;\n            dst_req_done <= 0;\n            fifo_rden <= 0;\n        end else begin\n            if (!fifo_empty && !dst_req_valid) begin\n                fifo_rden <= 1;\n                dst_req_valid <= 1;\n            end else begin\n                fifo_rden <= 0;\n            end\n            if (dst_req_valid && dst_pready_i) begin\n                dst_req_accepted <= 1;\n            end\n            if (dst_req_accepted) begin\n                dst_req_done <= 1;\n            end\n            if (dst_req_done) begin\n                dst_req_valid <= 0;\n                dst_req_accepted <= 0;\n                dst_req_done <= 0;\n            end\n        end\n    end\n\n    assign dst_psel_o = dst_req_valid;\n    assign dst_penable_o = dst_req_valid;\n    assign dst_pwrite_o = src_pwrite_i;\n    assign dst_paddr_o = fifo_addr;\n    assign dst_pwdata_o = fifo_wdata;\n    assign dst_pstrb_o = fifo_strb;\n    assign dst_pprot_o = fifo_prot;\n\nendmodule\n\n// Synchronous FIFO module\nmodule fifo_sync #(\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      clk_wr,\n    input                      rst_wr_n,\n    input                      clk_rd,\n    input                      rst_rd_n,\n    input  [DATA_WIDTH-1:0]    din,\n    input                      wr_en,\n    input                      rd_en,\n    output [DATA_WIDTH-1:0]    dout,\n    output                     empty,\n    output                     full\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    reg [DATA_WIDTH-1:0]       mem [0:DEPTH-1];\n    reg [$clog2(DEPTH):0]      wr_ptr;\n    reg [$clog2(DEPTH):0]      rd_ptr;\n    reg [$clog2(DEPTH):0]      wr_ptr_gray;\n    reg [$clog2(DEPTH):0]      rd_ptr_gray;\n    reg [$clog2(DEPTH):0]      wr_ptr_gray_sync;\n    reg [$clog2(DEPTH):0]      rd_ptr_gray_sync;\n\n    // Write pointer logic\n    always @(posedge clk_wr or negedge rst_wr_n) begin\n        if (!rst_wr_n) begin\n            wr_ptr <= 0;\n        end else if (wr_en && !full) begin\n            wr_ptr <= wr_ptr + 1;\n        end\n    end\n\n    // Read pointer logic\n    always @(posedge clk_rd or negedge rst_rd_n) begin\n        if (!rst_rd_n) begin\n            rd_ptr <= 0;\n        end else if (rd_en && !empty) begin\n            rd_ptr <= rd_ptr + 1;\n        end\n    end\n\n    // Gray code conversion\n    always @(*) begin\n        wr_ptr_gray = wr_ptr ^ (wr_ptr >> 1);\n        rd_ptr_gray = rd_ptr ^ (rd_ptr >> 1);\n    end\n\n    // Synchronize gray pointers\n    always @(posedge clk_wr or negedge rst_wr_n) begin\n        if (!rst_wr_n) begin\n            rd_ptr_gray_sync <= 0;\n        end else begin\n            rd_ptr_gray_sync <= rd_ptr_gray;\n        end\n    end\n\n    always @(posedge clk_rd or negedge rst_rd_n) begin\n        if (!rst_rd_n) begin\n            wr_ptr_gray_sync <= 0;\n        end else begin\n            wr_ptr_gray_sync <= wr_ptr_gray;\n        end\n    end\n\n    // Write data to memory\n    always @(posedge clk_wr) begin\n        if (wr_en && !full) begin\n            mem[wr_ptr] <= din;\n        end\n    end\n\n    // Read data from memory\n    always @(posedge clk_rd) begin\n        if (rd_en && !empty) begin\n            dout <= mem[rd_ptr];\n        end\n    end\n\n    // Full and empty flags\n    assign full = (wr_ptr_gray_sync == {~rd_ptr_gray[$clog2(DEPTH)], rd_ptr_gray[$clog2(DEPTH)-1:0]});\n    assign empty = (wr_ptr_gray_sync == rd_ptr_gray_sync);\n\nendmodule\n```<|im_end|>",
