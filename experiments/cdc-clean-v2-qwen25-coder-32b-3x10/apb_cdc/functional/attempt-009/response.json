  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // FIFO signals\n    reg [ADDR_WIDTH-1:0]       fifo_addr;\n    reg [DATA_WIDTH-1:0]       fifo_wdata;\n    reg [DATA_WIDTH/8-1:0]     fifo_strb;\n    reg [2:0]                  fifo_prot;\n    reg                        fifo_write;\n    reg                        fifo_read;\n    reg                        fifo_full;\n    reg                        fifo_empty;\n    reg [DATA_WIDTH-1:0]       fifo_rdata;\n\n    // Source side signals\n    reg                        src_req_valid;\n    reg                        src_req_ready;\n    reg                        src_req_accepted;\n    reg [DATA_WIDTH-1:0]       src_rdata;\n    reg                        src_slverr;\n\n    // Destination side signals\n    reg                        dst_req_valid;\n    reg                        dst_req_ready;\n    reg                        dst_req_accepted;\n\n    // FIFO instantiation\n    fifo_sync #(\n        .DATA_WIDTH(ADDR_WIDTH + DATA_WIDTH + DATA_WIDTH/8 + 3),\n        .LOG_DEPTH(LOG_DEPTH)\n    ) fifo_inst (\n        .clk_wr(src_pclk_i),\n        .rst_wr(~src_preset_ni),\n        .clk_rd(dst_pclk_i),\n        .rst_rd(~dst_preset_ni),\n        .din({src_paddr_i, src_pwdata_i, src_pstrb_i, src_pprot_i}),\n        .wr_en(fifo_write),\n        .rd_en(fifo_read),\n        .full(fifo_full),\n        .empty(fifo_empty),\n        .dout({fifo_addr, fifo_wdata, fifo_strb, fifo_prot})\n    );\n\n    // Source side logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_valid <= 0;\n            src_req_accepted <= 0;\n            src_pready_o <= 0;\n        end else begin\n            if (src_psel_i && src_penable_i && !src_req_valid) begin\n                src_req_valid <= 1;\n            end else if (src_req_accepted) begin\n                src_req_valid <= 0;\n                src_req_accepted <= 0;\n                src_pready_o <= 0;\n            end else if (src_pready_o && dst_pready_i) begin\n                src_req_accepted <= 1;\n                src_pready_o <= 1;\n                src_prdata_o <= src_rdata;\n                src_pslverr_o <= src_slverr;\n            end\n        end\n    end\n\n    // FIFO write control\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            fifo_write <= 0;\n        end else begin\n            fifo_write <= src_req_valid && !fifo_full;\n        end\n    end\n\n    // Destination side logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req_valid <= 0;\n            dst_req_accepted <= 0;\n            dst_psel_o <= 0;\n            dst_penable_o <= 0;\n        end else begin\n            if (dst_req_ready && !fifo_empty) begin\n                dst_req_valid <= 1;\n                dst_psel_o <= 1;\n                dst_penable_o <= 1;\n                dst_pwrite_o <= fifo_prot[0];\n                dst_paddr_o <= fifo_addr;\n                dst_pwdata_o <= fifo_wdata;\n                dst_pstrb_o <= fifo_strb;\n                dst_pprot_o <= fifo_prot;\n            end else if (dst_pready_i) begin\n                dst_req_valid <= 0;\n                dst_req_accepted <= 1;\n                dst_psel_o <= 0;\n                dst_penable_o <= 0;\n                src_rdata <= dst_prdata_i;\n                src_slverr <= dst_pslverr_i;\n            end else if (dst_req_accepted) begin\n                dst_req_accepted <= 0;\n            end\n        end\n    end\n\n    // FIFO read control\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            fifo_read <= 0;\n        end else begin\n            fifo_read <= dst_req_ready && !fifo_empty;\n        end\n    end\n\n    // Destination request ready\n    assign dst_req_ready = !dst_req_valid && !fifo_empty;\n\n    // Source request ready\n    assign src_req_ready = !src_req_valid && !fifo_full;\n\nendmodule\n\n// FIFO synchronous module\nmodule fifo_sync #(\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      clk_wr,\n    input                      rst_wr,\n    input                      clk_rd,\n    input                      rst_rd,\n    input  [DATA_WIDTH-1:0]    din,\n    input                      wr_en,\n    input                      rd_en,\n    output                     full,\n    output                     empty,\n    output [DATA_WIDTH-1:0]    dout\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    reg [DATA_WIDTH-1:0]       mem [0:DEPTH-1];\n    reg [$clog2(DEPTH):0]      wr_ptr;\n    reg [$clog2(DEPTH):0]      rd_ptr;\n    reg [$clog2(DEPTH):0]      wr_ptr_gray;\n    reg [$clog2(DEPTH):0]      rd_ptr_gray;\n    reg [$clog2(DEPTH):0]      wr_ptr_gray_sync;\n    reg [$clog2(DEPTH):0]      rd_ptr_gray_sync;\n\n    // Write pointer logic\n    always @(posedge clk_wr or negedge rst_wr) begin\n        if (!rst_wr) begin\n            wr_ptr <= 0;\n            wr_ptr_gray <= 0;\n        end else if (wr_en && !full) begin\n            mem[wr_ptr] <= din;\n            wr_ptr <= wr_ptr + 1;\n            wr_ptr_gray <= wr_ptr ^ (wr_ptr >> 1);\n        end\n    end\n\n    // Read pointer logic\n    always @(posedge clk_rd or negedge rst_rd) begin\n        if (!rst_rd) begin\n            rd_ptr <= 0;\n            rd_ptr_gray <= 0;\n        end else if (rd_en && !empty) begin\n            rd_ptr <= rd_ptr + 1;\n            rd_ptr_gray <= rd_ptr ^ (rd_ptr >> 1);\n        end\n    end\n\n    // Gray code synchronization\n    always @(posedge clk_wr or negedge rst_wr) begin\n        if (!rst_wr) begin\n            rd_ptr_gray_sync <= 0;\n        end else begin\n            rd_ptr_gray_sync <= rd_ptr_gray;\n        end\n    end\n\n    always @(posedge clk_rd or negedge rst_rd) begin\n        if (!rst_rd) begin\n            wr_ptr_gray_sync <= 0;\n        end else begin\n            wr_ptr_gray_sync <= wr_ptr_gray;\n        end\n    end\n\n    // Full and empty flags\n    assign full = (wr_ptr_gray_sync == {~rd_ptr_gray[LOG_DEPTH], rd_ptr_gray[LOG_DEPTH-1:0]});\n    assign empty = (wr_ptr_gray_sync == rd_ptr_gray_sync);\n\n    // Output data\n    assign dout = mem[rd_ptr];\n\nendmodule\n```<|im_end|>",
