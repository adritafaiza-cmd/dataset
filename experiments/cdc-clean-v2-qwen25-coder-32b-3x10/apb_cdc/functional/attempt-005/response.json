  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // FIFO signals\n    reg [ADDR_WIDTH-1:0]       fifo_addr;\n    reg [DATA_WIDTH-1:0]       fifo_wdata;\n    reg [DATA_WIDTH/8-1:0]     fifo_strb;\n    reg [2:0]                  fifo_prot;\n    reg                        fifo_wren;\n    reg                        fifo_rden;\n    reg [DATA_WIDTH-1:0]       fifo_rdata;\n    reg                        fifo_empty;\n    reg                        fifo_full;\n\n    // Source side signals\n    reg                        src_req_valid;\n    reg                        src_req_ready;\n    reg                        src_req_accepted;\n    reg                        src_req_done;\n\n    // Destination side signals\n    reg                        dst_req_valid;\n    reg                        dst_req_ready;\n    reg                        dst_req_accepted;\n    reg                        dst_req_done;\n\n    // FIFO instantiation\n    fifo_sync #(\n        .DATA_WIDTH(ADDR_WIDTH + DATA_WIDTH + DATA_WIDTH/8 + 3),\n        .LOG_DEPTH(LOG_DEPTH)\n    ) u_fifo (\n        .clk_i(src_pclk_i),\n        .rst_ni(src_preset_ni),\n        .wren_i(fifo_wren),\n        .wdata_i({src_paddr_i, src_pwdata_i, src_pstrb_i, src_pprot_i}),\n        .rden_i(fifo_rden),\n        .rdata_o({fifo_addr, fifo_wdata, fifo_strb, fifo_prot}),\n        .empty_o(fifo_empty),\n        .full_o(fifo_full)\n    );\n\n    // Source side logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_valid <= 0;\n            src_req_accepted <= 0;\n            src_req_done <= 0;\n            fifo_wren <= 0;\n        end else begin\n            if (src_psel_i && src_penable_i && !src_req_valid) begin\n                src_req_valid <= 1;\n            end\n            if (src_req_valid && !fifo_full) begin\n                fifo_wren <= 1;\n                src_req_accepted <= 1;\n            end else begin\n                fifo_wren <= 0;\n            end\n            if (src_req_accepted && fifo_wren) begin\n                src_req_valid <= 0;\n                src_req_accepted <= 0;\n            end\n            if (src_req_done) begin\n                src_req_done <= 0;\n            end\n        end\n    end\n\n    // Destination side logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req_valid <= 0;\n            dst_req_accepted <= 0;\n            dst_req_done <= 0;\n            fifo_rden <= 0;\n        end else begin\n            if (!fifo_empty && !dst_req_valid) begin\n                fifo_rden <= 1;\n                dst_req_valid <= 1;\n            end else begin\n                fifo_rden <= 0;\n            end\n            if (dst_req_valid && dst_pready_i) begin\n                dst_req_accepted <= 1;\n            end\n            if (dst_req_accepted) begin\n                dst_req_valid <= 0;\n                dst_req_accepted <= 0;\n                dst_req_done <= 1;\n            end\n        end\n    end\n\n    // Source side outputs\n    assign src_pready_o = src_req_done;\n    assign src_prdata_o = dst_prdata_i;\n    assign src_pslverr_o = dst_pslverr_i;\n\n    // Destination side outputs\n    assign dst_psel_o = dst_req_valid;\n    assign dst_penable_o = dst_req_valid;\n    assign dst_pwrite_o = src_pwrite_i;\n    assign dst_paddr_o = fifo_addr;\n    assign dst_pwdata_o = fifo_wdata;\n    assign dst_pstrb_o = fifo_strb;\n    assign dst_pprot_o = fifo_prot;\n\n    // Request completion\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_done <= 0;\n        end else begin\n            if (dst_req_done) begin\n                src_req_done <= 1;\n            end\n        end\n    end\n\nendmodule\n\n// Synchronous FIFO module\nmodule fifo_sync #(\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      clk_i,\n    input                      rst_ni,\n    input                      wren_i,\n    input  [DATA_WIDTH-1:0]    wdata_i,\n    input                      rden_i,\n    output [DATA_WIDTH-1:0]    rdata_o,\n    output                     empty_o,\n    output                     full_o\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    reg [DATA_WIDTH-1:0]       mem [0:DEPTH-1];\n    reg [ADDR_WIDTH-1:0]       wr_ptr;\n    reg [ADDR_WIDTH-1:0]       rd_ptr;\n    reg [ADDR_WIDTH:0]         cnt;\n\n    // Write pointer logic\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            wr_ptr <= 0;\n        end else if (wren_i && !full_o) begin\n            wr_ptr <= wr_ptr + 1;\n        end\n    end\n\n    // Read pointer logic\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            rd_ptr <= 0;\n        end else if (rden_i && !empty_o) begin\n            rd_ptr <= rd_ptr + 1;\n        end\n    end\n\n    // Memory write\n    always @(posedge clk_i) begin\n        if (wren_i && !full_o) begin\n            mem[wr_ptr] <= wdata_i;\n        end\n    end\n\n    // Memory read\n    assign rdata_o = mem[rd_ptr];\n\n    // Counter logic\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            cnt <= 0;\n        end else begin\n            if (wren_i && !rden_i && !full_o) begin\n                cnt <= cnt + 1;\n            end else if (!wren_i && rden_i && !empty_o) begin\n                cnt <= cnt - 1;\n            end else if (wren_i && rden_i && !full_o && !empty_o) begin\n                // Do nothing, cnt remains the same\n            end\n        end\n    end\n\n    // Empty and full flags\n    assign empty_o = (cnt == 0);\n    assign full_o = (cnt == DEPTH);\n\nendmodule\n```<|im_end|>",
