  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // FIFO signals\n    reg [ADDR_WIDTH-1:0]       fifo_addr;\n    reg [DATA_WIDTH-1:0]       fifo_wdata;\n    reg [DATA_WIDTH/8-1:0]     fifo_strb;\n    reg [2:0]                  fifo_prot;\n    reg                        fifo_write;\n    reg                        fifo_read;\n    reg                        fifo_full;\n    reg                        fifo_empty;\n    reg [DATA_WIDTH-1:0]       fifo_rdata;\n\n    // Source side signals\n    reg                        src_req_valid;\n    reg                        src_req_ready;\n    reg                        src_req_accepted;\n    reg                        src_req_done;\n\n    // Destination side signals\n    reg                        dst_req_valid;\n    reg                        dst_req_ready;\n    reg                        dst_req_accepted;\n    reg                        dst_req_done;\n\n    // FIFO instantiation\n    fifo_sync #(\n        .DATA_WIDTH (ADDR_WIDTH + DATA_WIDTH + DATA_WIDTH/8 + 3),\n        .LOG_DEPTH  (LOG_DEPTH)\n    ) fifo_inst (\n        .clk_wr_i   (src_pclk_i),\n        .rst_wr_ni  (src_preset_ni),\n        .clk_rd_i   (dst_pclk_i),\n        .rst_rd_ni  (dst_preset_ni),\n        .data_i     ({src_paddr_i, src_pwdata_i, src_pstrb_i, src_pprot_i}),\n        .write_i    (fifo_write),\n        .read_i     (fifo_read),\n        .full_o     (fifo_full),\n        .empty_o    (fifo_empty),\n        .data_o     ({fifo_addr, fifo_wdata, fifo_strb, fifo_prot})\n    );\n\n    // Source side logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_valid <= 0;\n            src_req_accepted <= 0;\n            src_req_done <= 0;\n            fifo_write <= 0;\n        end else begin\n            if (src_psel_i && src_penable_i && !src_req_valid) begin\n                src_req_valid <= 1;\n            end\n            if (src_req_valid && !fifo_full) begin\n                fifo_write <= 1;\n                src_req_accepted <= 1;\n            end else begin\n                fifo_write <= 0;\n            end\n            if (src_req_accepted && dst_pready_i) begin\n                src_req_done <= 1;\n            end\n            if (src_req_done) begin\n                src_req_valid <= 0;\n                src_req_accepted <= 0;\n                src_req_done <= 0;\n            end\n        end\n    end\n\n    // Destination side logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req_valid <= 0;\n            dst_req_accepted <= 0;\n            dst_req_done <= 0;\n            fifo_read <= 0;\n        end else begin\n            if (!fifo_empty && !dst_req_valid) begin\n                fifo_read <= 1;\n                dst_req_valid <= 1;\n            end else begin\n                fifo_read <= 0;\n            end\n            if (dst_req_valid && dst_pready_i) begin\n                dst_req_accepted <= 1;\n            end\n            if (dst_req_accepted) begin\n                dst_req_done <= 1;\n            end\n            if (dst_req_done) begin\n                dst_req_valid <= 0;\n                dst_req_accepted <= 0;\n                dst_req_done <= 0;\n            end\n        end\n    end\n\n    // Output assignments\n    assign src_pready_o = src_req_done;\n    assign src_prdata_o = dst_prdata_i;\n    assign src_pslverr_o = dst_pslverr_i;\n\n    assign dst_psel_o = dst_req_valid;\n    assign dst_penable_o = dst_req_valid;\n    assign dst_pwrite_o = src_pwrite_i;\n    assign dst_paddr_o = fifo_addr;\n    assign dst_pwdata_o = fifo_wdata;\n    assign dst_pstrb_o = fifo_strb;\n    assign dst_pprot_o = fifo_prot;\n\nendmodule\n\n// FIFO synchronization module\nmodule fifo_sync #(\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      clk_wr_i,\n    input                      rst_wr_ni,\n    input                      clk_rd_i,\n    input                      rst_rd_ni,\n    input  [DATA_WIDTH-1:0]    data_i,\n    input                      write_i,\n    input                      read_i,\n    output                     full_o,\n    output                     empty_o,\n    output [DATA_WIDTH-1:0]    data_o\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    reg [DATA_WIDTH-1:0]       mem [0:DEPTH-1];\n    reg [$clog2(DEPTH):0]      wr_ptr;\n    reg [$clog2(DEPTH):0]      rd_ptr;\n    reg [$clog2(DEPTH):0]      wr_ptr_gray;\n    reg [$clog2(DEPTH):0]      rd_ptr_gray;\n    reg [$clog2(DEPTH):0]      wr_ptr_gray_sync;\n    reg [$clog2(DEPTH):0]      rd_ptr_gray_sync;\n\n    // Write pointer logic\n    always @(posedge clk_wr_i or negedge rst_wr_ni) begin\n        if (!rst_wr_ni) begin\n            wr_ptr <= 0;\n            wr_ptr_gray <= 0;\n        end else if (write_i && !full_o) begin\n            mem[wr_ptr] <= data_i;\n            wr_ptr <= wr_ptr + 1;\n            wr_ptr_gray <= wr_ptr ^ (wr_ptr >> 1);\n        end\n    end\n\n    // Read pointer logic\n    always @(posedge clk_rd_i or negedge rst_rd_ni) begin\n        if (!rst_rd_ni) begin\n            rd_ptr <= 0;\n            rd_ptr_gray <= 0;\n        end else if (read_i && !empty_o) begin\n            rd_ptr <= rd_ptr + 1;\n            rd_ptr_gray <= rd_ptr ^ (rd_ptr >> 1);\n        end\n    end\n\n    // Gray code synchronization\n    always @(posedge clk_wr_i or negedge rst_wr_ni) begin\n        if (!rst_wr_ni) begin\n            rd_ptr_gray_sync <= 0;\n        end else begin\n            rd_ptr_gray_sync <= rd_ptr_gray;\n        end\n    end\n\n    always @(posedge clk_rd_i or negedge rst_rd_ni) begin\n        if (!rst_rd_ni) begin\n            wr_ptr_gray_sync <= 0;\n        end else begin\n            wr_ptr_gray_sync <= wr_ptr_gray;\n        end\n    end\n\n    // Full and empty flags\n    assign full_o = (wr_ptr_gray_sync ^ wr_ptr_gray) == {($clog2(DEPTH)+1){1'b1}};\n    assign empty_o = (rd_ptr_gray_sync ^ rd_ptr_gray) == {($clog2(DEPTH)+1){1'b1}};\n\n    // Data output\n    assign data_o = mem[rd_ptr];\n\nendmodule\n```<|im_end|>",
