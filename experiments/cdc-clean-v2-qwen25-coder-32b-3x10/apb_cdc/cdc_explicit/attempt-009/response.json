  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // FIFO signals\n    reg [ADDR_WIDTH-1:0]       fifo_addr [0:(1<<LOG_DEPTH)-1];\n    reg [DATA_WIDTH-1:0]       fifo_wdata [0:(1<<LOG_DEPTH)-1];\n    reg [DATA_WIDTH/8-1:0]     fifo_strb [0:(1<<LOG_DEPTH)-1];\n    reg [2:0]                  fifo_prot [0:(1<<LOG_DEPTH)-1];\n    reg                        fifo_write;\n    reg                        fifo_read;\n    reg [$clog2(1<<LOG_DEPTH):0] fifo_wr_ptr;\n    reg [$clog2(1<<LOG_DEPTH):0] fifo_rd_ptr;\n    reg [$clog2(1<<LOG_DEPTH):0] fifo_wr_ptr_gray;\n    reg [$clog2(1<<LOG_DEPTH):0] fifo_rd_ptr_gray;\n    reg [$clog2(1<<LOG_DEPTH):0] fifo_wr_ptr_gray_sync;\n    reg [$clog2(1<<LOG_DEPTH):0] fifo_rd_ptr_gray_sync;\n    reg                        fifo_full;\n    reg                        fifo_empty;\n\n    // Source side signals\n    reg                        src_req_valid;\n    reg                        src_req_ready;\n    reg                        src_req_accepted;\n    reg                        src_req_done;\n\n    // Destination side signals\n    reg                        dst_req_valid;\n    reg                        dst_req_ready;\n    reg                        dst_req_accepted;\n    reg                        dst_req_done;\n\n    // FIFO write logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            fifo_wr_ptr <= 0;\n            fifo_wr_ptr_gray <= 0;\n        end else if (fifo_write && !fifo_full) begin\n            fifo_wr_ptr <= fifo_wr_ptr + 1;\n            fifo_wr_ptr_gray <= fifo_wr_ptr + 1 ^ (fifo_wr_ptr + 1) >> 1;\n        end\n    end\n\n    // FIFO read logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            fifo_rd_ptr <= 0;\n            fifo_rd_ptr_gray <= 0;\n        end else if (fifo_read && !fifo_empty) begin\n            fifo_rd_ptr <= fifo_rd_ptr + 1;\n            fifo_rd_ptr_gray <= fifo_rd_ptr + 1 ^ (fifo_rd_ptr + 1) >> 1;\n        end\n    end\n\n    // FIFO full and empty flags\n    assign fifo_full = (fifo_wr_ptr_gray == fifo_rd_ptr_gray_sync + 1);\n    assign fifo_empty = (fifo_wr_ptr_gray_sync == fifo_rd_ptr_gray);\n\n    // FIFO write enable\n    assign fifo_write = src_req_valid && src_req_ready && !fifo_full;\n\n    // FIFO read enable\n    assign fifo_read = dst_req_valid && dst_req_ready && !fifo_empty;\n\n    // FIFO write data\n    always @(posedge src_pclk_i) begin\n        if (fifo_write) begin\n            fifo_addr[fifo_wr_ptr] <= src_paddr_i;\n            fifo_wdata[fifo_wr_ptr] <= src_pwdata_i;\n            fifo_strb[fifo_wr_ptr] <= src_pstrb_i;\n            fifo_prot[fifo_wr_ptr] <= src_pprot_i;\n        end\n    end\n\n    // FIFO read data\n    reg [ADDR_WIDTH-1:0]       fifo_addr_sync;\n    reg [DATA_WIDTH-1:0]       fifo_wdata_sync;\n    reg [DATA_WIDTH/8-1:0]     fifo_strb_sync;\n    reg [2:0]                  fifo_prot_sync;\n\n    always @(posedge dst_pclk_i) begin\n        fifo_addr_sync <= fifo_addr[fifo_rd_ptr];\n        fifo_wdata_sync <= fifo_wdata[fifo_rd_ptr];\n        fifo_strb_sync <= fifo_strb[fifo_rd_ptr];\n        fifo_prot_sync <= fifo_prot[fifo_rd_ptr];\n    end\n\n    // Gray code synchronization\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            fifo_wr_ptr_gray_sync <= 0;\n        end else begin\n            fifo_wr_ptr_gray_sync <= fifo_wr_ptr_gray;\n        end\n    end\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            fifo_rd_ptr_gray_sync <= 0;\n        end else begin\n            fifo_rd_ptr_gray_sync <= fifo_rd_ptr_gray;\n        end\n    end\n\n    // Source side logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_valid <= 0;\n            src_req_accepted <= 0;\n            src_req_done <= 0;\n        end else begin\n            if (src_psel_i && src_penable_i && !src_req_valid) begin\n                src_req_valid <= 1;\n            end else if (src_req_accepted) begin\n                src_req_valid <= 0;\n            end\n\n            if (src_req_valid && src_req_ready) begin\n                src_req_accepted <= 1;\n            end\n\n            if (src_req_accepted && dst_pready_i) begin\n                src_req_done <= 1;\n            end\n\n            if (src_req_done && dst_pready_i) begin\n                src_req_accepted <= 0;\n                src_req_done <= 0;\n            end\n        end\n    end\n\n    // Destination side logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req_valid <= 0;\n            dst_req_accepted <= 0;\n       