  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // FIFO signals\n    reg [ADDR_WIDTH-1:0]       fifo_addr [0:(1<<LOG_DEPTH)-1];\n    reg [DATA_WIDTH-1:0]       fifo_wdata [0:(1<<LOG_DEPTH)-1];\n    reg [DATA_WIDTH/8-1:0]     fifo_strb [0:(1<<LOG_DEPTH)-1];\n    reg [2:0]                  fifo_prot [0:(1<<LOG_DEPTH)-1];\n    reg                        fifo_write;\n    reg                        fifo_read;\n    reg [LOG_DEPTH:0]          fifo_wptr;\n    reg [LOG_DEPTH:0]          fifo_rptr;\n    reg [LOG_DEPTH:0]          fifo_count;\n\n    // Source side signals\n    reg                        src_req_valid;\n    reg                        src_req_ready;\n    reg                        src_req_accepted;\n    reg [ADDR_WIDTH-1:0]       src_req_addr;\n    reg [DATA_WIDTH-1:0]       src_req_wdata;\n    reg [DATA_WIDTH/8-1:0]     src_req_strb;\n    reg [2:0]                  src_req_prot;\n    reg                        src_req_write;\n\n    // Destination side signals\n    reg                        dst_req_valid;\n    reg                        dst_req_ready;\n    reg [ADDR_WIDTH-1:0]       dst_req_addr;\n    reg [DATA_WIDTH-1:0]       dst_req_wdata;\n    reg [DATA_WIDTH/8-1:0]     dst_req_strb;\n    reg [2:0]                  dst_req_prot;\n    reg                        dst_req_write;\n\n    // FIFO write logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            fifo_wptr <= 0;\n            fifo_count <= 0;\n        end else if (fifo_write && !fifo_full) begin\n            fifo_addr[fifo_wptr[LOG_DEPTH-1:0]] <= src_paddr_i;\n            fifo_wdata[fifo_wptr[LOG_DEPTH-1:0]] <= src_pwdata_i;\n            fifo_strb[fifo_wptr[LOG_DEPTH-1:0]] <= src_pstrb_i;\n            fifo_prot[fifo_wptr[LOG_DEPTH-1:0]] <= src_pprot_i;\n            fifo_wptr <= fifo_wptr + 1;\n            fifo_count <= fifo_count + 1;\n        end\n    end\n\n    // FIFO read logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            fifo_rptr <= 0;\n        end else if (fifo_read && !fifo_empty) begin\n            fifo_rptr <= fifo_rptr + 1;\n            fifo_count <= fifo_count - 1;\n        end\n    end\n\n    // FIFO status\n    wire fifo_full = (fifo_count == (1<<LOG_DEPTH));\n    wire fifo_empty = (fifo_count == 0);\n\n    // Source side request handling\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_valid <= 0;\n            src_req_accepted <= 0;\n        end else begin\n            if (src_psel_i && src_penable_i && !src_req_valid) begin\n                src_req_valid <= 1;\n                src_req_addr <= src_paddr_i;\n                src_req_wdata <= src_pwdata_i;\n                src_req_strb <= src_pstrb_i;\n                src_req_prot <= src_pprot_i;\n                src_req_write <= src_pwrite_i;\n            end else if (src_req_accepted) begin\n                src_req_valid <= 0;\n                src_req_accepted <= 0;\n            end\n        end\n    end\n\n    // Source side ready signal\n    assign src_pready_o = !src_req_valid || src_req_accepted;\n\n    // FIFO write enable\n    assign fifo_write = src_req_valid && !src_req_accepted && !fifo_full;\n\n    // FIFO read enable\n    assign fifo_read = dst_req_ready && !fifo_empty;\n\n    // Destination side request handling\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req_valid <= 0;\n        end else begin\n            if (fifo_read) begin\n                dst_req_valid <= 1;\n                dst_req_addr <= fifo_addr[fifo_rptr[LOG_DEPTH-1:0]];\n                dst_req_wdata <= fifo_wdata[fifo_rptr[LOG_DEPTH-1:0]];\n                dst_req_strb <= fifo_strb[fifo_rptr[LOG_DEPTH-1:0]];\n                dst_req_prot <= fifo_prot[fifo_rptr[LOG_DEPTH-1:0]];\n                dst_req_write <= fifo_wptr[LOG_DEPTH-1:0] == fifo_rptr[LOG_DEPTH-1:0];\n            end else if (dst_pready_i) begin\n                dst_req_valid <= 0;\n            end\n        end\n    end\n\n    // Destination side ready signal\n    assign dst_req_ready = !dst_req_valid || dst_pready_i;\n\n    // Destination side outputs\n    assign dst_psel_o = dst_req_valid;\n    assign dst_penable_o = dst_req_valid;\n    assign dst_pwrite_o = dst_req_write;\n    assign dst_paddr_o = dst_req_addr;\n    assign dst_pwdata_o = dst_req_wdata;\n    assign dst_pstrb_o = dst_req_strb;\n    assign dst_pprot_o = dst_req_prot;\n\n    // Source side response handling\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_prdata_o <= 0;\n            src_pslverr_o <= 0;\n        end else if (src_req_accepted && dst_pready_i) begin\n            src_prdata_o <= dst_prdata_i;\n            src_pslverr_o <= dst_pslverr_i;\n        end\n    end\n\n    // Source side request acceptance\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_accepted <= 0;\n        end else if (src_req_valid && fifo_write) begin\n            src_req_accepted <= 1;\n        end\n    end\n\nendmodule\n```<|im_end|>",
