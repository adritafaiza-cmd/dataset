  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // FIFO signals\n    reg [ADDR_WIDTH-1:0]       fifo_addr;\n    reg [DATA_WIDTH-1:0]       fifo_wdata;\n    reg [DATA_WIDTH/8-1:0]     fifo_strb;\n    reg [2:0]                  fifo_prot;\n    reg                        fifo_wren;\n    reg                        fifo_rden;\n    reg                        fifo_empty;\n    reg                        fifo_full;\n\n    // Synchronization signals\n    reg                        src_req_sync;\n    reg                        src_req_sync2;\n    reg                        dst_req_sync;\n    reg                        dst_req_sync2;\n    reg                        src_ack_sync;\n    reg                        src_ack_sync2;\n    reg                        dst_ack_sync;\n    reg                        dst_ack_sync2;\n\n    // Source side logic\n    reg                        src_req;\n    reg                        src_req_reg;\n    reg                        src_ack;\n    reg                        src_ack_reg;\n\n    // Destination side logic\n    reg                        dst_req;\n    reg                        dst_req_reg;\n    reg                        dst_ack;\n    reg                        dst_ack_reg;\n\n    // FIFO instantiation\n    fifo_sync #(\n        .DATA_WIDTH(ADDR_WIDTH + DATA_WIDTH + DATA_WIDTH/8 + 3),\n        .LOG_DEPTH(LOG_DEPTH)\n    ) u_fifo (\n        .clk_i(src_pclk_i),\n        .rst_ni(src_preset_ni),\n        .wren_i(fifo_wren),\n        .rden_i(fifo_rden),\n        .data_i({src_paddr_i, src_pwdata_i, src_pstrb_i, src_pprot_i}),\n        .data_o({fifo_addr, fifo_wdata, fifo_strb, fifo_prot}),\n        .empty_o(fifo_empty),\n        .full_o(fifo_full)\n    );\n\n    // Source side request handling\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req <= 0;\n            src_req_reg <= 0;\n        end else begin\n            if (src_psel_i && src_penable_i && !fifo_full) begin\n                src_req <= 1;\n            end else begin\n                src_req <= 0;\n            end\n            src_req_reg <= src_req;\n        end\n    end\n\n    // Source side FIFO write enable\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            fifo_wren <= 0;\n        end else begin\n            fifo_wren <= src_req && !src_req_reg;\n        end\n    end\n\n    // Source side acknowledgment handling\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_ack <= 0;\n            src_ack_reg <= 0;\n        end else begin\n            if (src_ack_sync2 && !src_ack_reg) begin\n                src_ack <= 1;\n            end else begin\n                src_ack <= 0;\n            end\n            src_ack_reg <= src_ack;\n        end\n    end\n\n    // Source side ready signal\n    assign src_pready_o = src_ack;\n\n    // Source side data output\n    assign src_prdata_o = dst_prdata_i;\n    assign src_pslverr_o = dst_pslverr_i;\n\n    // Destination side request handling\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req <= 0;\n            dst_req_reg <= 0;\n        end else begin\n            if (!fifo_empty) begin\n                dst_req <= 1;\n            end else begin\n                dst_req <= 0;\n            end\n            dst_req_reg <= dst_req;\n        end\n    end\n\n    // Destination side FIFO read enable\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            fifo_rden <= 0;\n        end else begin\n            fifo_rden <= dst_req && !dst_req_reg && dst_pready_i;\n        end\n    end\n\n    // Destination side acknowledgment handling\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_ack <= 0;\n            dst_ack_reg <= 0;\n        end else begin\n            if (dst_pready_i && dst_req) begin\n                dst_ack <= 1;\n            end else begin\n                dst_ack <= 0;\n            end\n            dst_ack_reg <= dst_ack;\n        end\n    end\n\n    // Destination side output signals\n    assign dst_psel_o = dst_req;\n    assign dst_penable_o = dst_req;\n    assign dst_pwrite_o = src_pwrite_i;\n    assign dst_paddr_o = fifo_addr;\n    assign dst_pwdata_o = fifo_wdata;\n    assign dst_pstrb_o = fifo_strb;\n    assign dst_pprot_o = fifo_prot;\n\n    // Synchronization logic for request and acknowledgment\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_sync <= 0;\n            src_req_sync2 <= 0;\n        end else begin\n            src_req_sync <= dst_req;\n            src_req_sync2 <= src_req_sync;\n        end\n    end\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req_sync <= 0;\n            dst_req_sync2 <= 0;\n        end else begin\n            dst_req_sync <= src_req;\n            dst_req_sync2 <= dst_req_sync;\n        end\n    end\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_ack_sync <= 0;\n            src_ack_sync2 <= 0;\n        end else begin\n            src_ack_sync <= dst_ack;\n            src_ack_sync2 <= src_ack_sync;\n        end\n    end\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_ack_sync <= 0;\n            dst_ack_sync2 <= 0;\n        end else begin\n            dst_ack_sync <= src_ack;\n            dst_ack_sync2 <= dst_ack_sync;\n        end\n    end\n\nendmodule\n\n// FIFO with synchronization\nmodule fifo_sync #(\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      clk_i,\n    input                      rst_ni,\n    input                      wren_i,\n    input                      rden_i,\n    input  [DATA_WIDTH-1:0]    data_i,\n    output [DATA_WIDTH-1:0]    data_o,\n    output                     empty_o,\n    output                     full_o\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n\n    reg [DATA_WIDTH-1:0]       mem [0:DEPTH-1];\n    reg [$clog2(DEPTH)-1:0]    wr_ptr;\n    reg [$clog2(DEPTH)-1:0]    rd_ptr;\n    reg [$clog2(DEPTH):0]      count;\n\n    // Write pointer and memory write\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            wr_ptr <= 0;\n        end else if (wren_i && !full_o) begin\n            mem[wr_ptr] <= data_i;\n            wr_ptr <= wr_ptr + 1;\n        end\n    end\n\n    // Read pointer and memory read\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            rd_ptr <= 0;\n        end else if (rden_i && !empty_o) begin\n            rd_ptr <= rd_ptr + 1;\n        end\n    end\n\n    // Count and flags\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            count <= 0;\n        end else begin\n            if (wren_i && !rden_i && !full_o) begin\n                count <= count + 1;\n            end else if (!wren_i && rden_i && !empty_o) begin\n                count <= count - 1;\n            end else if (wren_i && rden_i && !full_o && !empty_o) begin\n                count <= count;\n            end else if (wren_i && rden_i && full_o && empty_o) begin\n                count <= 0;\n            end\n        end\n    end\n\n    assign empty_o = (count == 0);\n    assign full_o = (count == DEPTH);\n\n    // Output data\n    assign data_o = mem[rd_ptr];\n\nendmodule\n```<|im_end|>",
