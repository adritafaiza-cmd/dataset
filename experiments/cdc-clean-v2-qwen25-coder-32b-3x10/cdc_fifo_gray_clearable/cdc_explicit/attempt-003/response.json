  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    // Source domain signals\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray;\n    reg [ADDR_WIDTH:0] src_wr_ptr_bin;\n    reg [ADDR_WIDTH:0] src_rd_ptr_gray_sync;\n    reg [WIDTH-1:0] mem [DEPTH-1:0];\n    reg src_clear_pending;\n    reg src_ready;\n\n    // Destination domain signals\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_bin;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray_sync;\n    reg [WIDTH-1:0] dst_data_reg [1:0];\n    reg dst_clear_pending;\n    reg dst_valid;\n    reg [1:0] dst_valid_reg;\n\n    // Gray code conversion functions\n    function [ADDR_WIDTH:0] bin2gray;\n        input [ADDR_WIDTH:0] bin;\n        bin2gray = bin ^ (bin >> 1);\n    endfunction\n\n    function [ADDR_WIDTH:0] gray2bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = 1; i <= ADDR_WIDTH; i = i + 1) begin\n            bin = bin ^ (gray >> i);\n        end\n        gray2bin = bin;\n    endfunction\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr_gray <= 0;\n            src_wr_ptr_bin <= 0;\n            src_clear_pending <= 0;\n        end else begin\n            if (src_clear_i) begin\n                src_wr_ptr_gray <= 0;\n                src_wr_ptr_bin <= 0;\n                src_clear_pending <= 1;\n            end else if (src_ready && src_valid_i) begin\n                src_wr_ptr_bin <= src_wr_ptr_bin + 1;\n                src_wr_ptr_gray <= bin2gray(src_wr_ptr_bin + 1);\n            end\n            if (src_clear_pending && (src_wr_ptr_gray == src_rd_ptr_gray_sync)) begin\n                src_clear_pending <= 0;\n            end\n        end\n    end\n\n    // Source domain ready signal\n    always @(*) begin\n        src_ready = 1;\n        if (bin2gray(src_wr_ptr_bin + 1) == src_rd_ptr_gray_sync) begin\n            src_ready = 0;\n        end\n    end\n\n    // Source domain memory write\n    always @(posedge src_clk_i) begin\n        if (src_ready && src_valid_i) begin\n            mem[src_wr_ptr_bin % DEPTH] <= src_data_i;\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr_gray <= 0;\n            dst_rd_ptr_bin <= 0;\n            dst_clear_pending <= 0;\n            dst_valid_reg <= 0;\n        end else begin\n            if (dst_clear_i) begin\n                dst_rd_ptr_gray <= 0;\n                dst_rd_ptr_bin <= 0;\n                dst_clear_pending <= 1;\n                dst_valid_reg <= 0;\n            end else if (dst_valid && dst_ready_i) begin\n                dst_rd_ptr_bin <= dst_rd_ptr_bin + 1;\n                dst_rd_ptr_gray <= bin2gray(dst_rd_ptr_bin + 1);\n                dst_valid_reg <= {dst_valid_reg[0], 0};\n            end else if (dst_valid && !dst_ready_i) begin\n                dst_valid_reg <= {dst_valid_reg[0], dst_valid_reg[1]};\n            end\n            if (dst_clear_pending && (dst_wr_ptr_gray_sync == dst_rd_ptr_gray)) begin\n                dst_clear_pending <= 0;\n            end\n        end\n    end\n\n    // Destination domain valid signal\n    always @(*) begin\n        dst_valid = dst_valid_reg[1];\n    end\n\n    // Destination domain memory read\n    always @(posedge dst_clk_i) begin\n        if (dst_valid && dst_ready_i) begin\n            dst_data_reg[0] <= mem[dst_rd_ptr_bin % DEPTH];\n        end\n        dst_data_reg[1] <= dst_data_reg[0];\n    end\n\n    // Synchronization of pointers\n    genvar i;\n    generate\n        for (i = 0; i < SYNC_STAGES; i = i + 1) begin : sync_stages\n            always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n                if (!dst_rst_ni) begin\n                    src_rd_ptr_gray_sync[i] <= 0;\n                end else begin\n                    src_rd_ptr_gray_sync[i] <= (i == 0) ? src_wr_ptr_gray : src_rd_ptr_gray_sync[i-1];\n                end\n            end\n\n            always @(posedge src_clk_i or negedge src_rst_ni) begin\n                if (!src_rst_ni) begin\n                    dst_wr_ptr_gray_sync[i] <= 0;\n                end else begin\n                    dst_wr_ptr_gray_sync[i] <= (i == 0) ? dst_rd_ptr_gray : dst_wr_ptr_gray_sync[i-1];\n                end\n            end\n        end\n    endgenerate\n\n    // Output assignments\n    assign src_ready_o = src_ready;\n    assign src_clear_pending_o = src_clear_pending;\n    assign dst_data_o = dst_data_reg[1];\n    assign dst_valid_o = dst_valid;\n    assign dst_clear_pending_o = dst_clear_pending;\n\nendmodule\n```<|im_end|>",
