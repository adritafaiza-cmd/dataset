  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    // Source domain signals\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray;\n    reg [ADDR_WIDTH:0] src_wr_ptr_bin;\n    reg [ADDR_WIDTH:0] src_rd_ptr_gray_sync;\n    reg [ADDR_WIDTH:0] src_clear_pending;\n    reg [WIDTH-1:0]    mem [DEPTH-1:0];\n\n    // Destination domain signals\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_bin;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray_sync;\n    reg [ADDR_WIDTH:0] dst_clear_pending;\n    reg [WIDTH-1:0]    dst_data_reg;\n    reg                dst_valid_reg;\n\n    // Binary to Gray conversion\n    function [ADDR_WIDTH:0] bin_to_gray;\n        input [ADDR_WIDTH:0] bin;\n        bin_to_gray = bin ^ (bin >> 1);\n    endfunction\n\n    // Gray to Binary conversion\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = 1; i <= ADDR_WIDTH; i = i + 1) begin\n            bin = bin ^ (gray >> i);\n        end\n        gray_to_bin = bin;\n    endfunction\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr_gray <= 0;\n            src_wr_ptr_bin <= 0;\n            src_clear_pending <= 0;\n        end else begin\n            if (src_clear_i) begin\n                src_wr_ptr_gray <= 0;\n                src_wr_ptr_bin <= 0;\n                src_clear_pending <= 1;\n            end else if (src_ready_o && src_valid_i) begin\n                src_wr_ptr_bin <= src_wr_ptr_bin + 1;\n                src_wr_ptr_gray <= bin_to_gray(src_wr_ptr_bin + 1);\n                mem[src_wr_ptr_bin % DEPTH] <= src_data_i;\n            end\n        end\n    end\n\n    // Synchronize read pointer to source domain\n    reg [ADDR_WIDTH:0] src_rd_ptr_gray_sync_reg [SYNC_STAGES-1:0];\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_rd_ptr_gray_sync_reg <= {SYNC_STAGES{0}};\n        end else begin\n            src_rd_ptr_gray_sync_reg[0] <= dst_rd_ptr_gray;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1) begin\n                src_rd_ptr_gray_sync_reg[i] <= src_rd_ptr_gray_sync_reg[i-1];\n            end\n        end\n    end\n    assign src_rd_ptr_gray_sync = src_rd_ptr_gray_sync_reg[SYNC_STAGES-1];\n\n    // Source ready logic\n    assign src_ready_o = (src_wr_ptr_bin + 1 != gray_to_bin(src_rd_ptr_gray_sync));\n\n    // Source clear pending logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear_pending <= 0;\n        end else if (src_clear_i) begin\n            src_clear_pending <= 1;\n        end else if (src_wr_ptr_bin == gray_to_bin(src_rd_ptr_gray_sync)) begin\n            src_clear_pending <= 0;\n        end\n    end\n    assign src_clear_pending_o = src_clear_pending;\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr_gray <= 0;\n            dst_rd_ptr_bin <= 0;\n            dst_clear_pending <= 0;\n            dst_valid_reg <= 0;\n        end else begin\n            if (dst_clear_i) begin\n                dst_rd_ptr_gray <= 0;\n                dst_rd_ptr_bin <= 0;\n                dst_clear_pending <= 1;\n                dst_valid_reg <= 0;\n            end else if (dst_valid_reg && dst_ready_i) begin\n                dst_rd_ptr_bin <= dst_rd_ptr_bin + 1;\n                dst_rd_ptr_gray <= bin_to_gray(dst_rd_ptr_bin + 1);\n                dst_valid_reg <= 0;\n            end else if (!dst_valid_reg && (dst_wr_ptr_bin != dst_rd_ptr_bin)) begin\n                dst_data_reg <= mem[dst_rd_ptr_bin % DEPTH];\n                dst_valid_reg <= 1;\n            end\n        end\n    end\n\n    // Synchronize write pointer to destination domain\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray_sync_reg [SYNC_STAGES-1:0];\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_wr_ptr_gray_sync_reg <= {SYNC_STAGES{0}};\n        end else begin\n            dst_wr_ptr_gray_sync_reg[0] <= src_wr_ptr_gray;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1) begin\n                dst_wr_ptr_gray_sync_reg[i] <= dst_wr_ptr_gray_sync_reg[i-1];\n            end\n        end\n    end\n    assign dst_wr_ptr_gray_sync = dst_wr_ptr_gray_sync_reg[SYNC_STAGES-1];\n\n    // Destination clear pending logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear_pending <= 0;\n        end else if (dst_clear_i) begin\n            dst_clear_pending <= 1;\n        end else if (dst_wr_ptr_bin == dst_rd_ptr_bin) begin\n            dst_clear_pending <= 0;\n        end\n    end\n    assign dst_clear_pending_o = dst_clear_pending;\n\n    // Destination data and valid outputs\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
