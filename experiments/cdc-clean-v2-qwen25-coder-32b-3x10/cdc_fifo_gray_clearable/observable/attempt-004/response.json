  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray, src_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] src_rd_ptr_gray, src_rd_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray, dst_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray, dst_rd_ptr_gray_nxt;\n\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n\n    reg src_clear_reg, src_clear_reg_nxt;\n    reg dst_clear_reg, dst_clear_reg_nxt;\n\n    // Binary pointers for internal use\n    reg [ADDR_WIDTH:0] src_wr_ptr_bin, src_wr_ptr_bin_nxt;\n    reg [ADDR_WIDTH:0] src_rd_ptr_bin, src_rd_ptr_bin_nxt;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_bin, dst_wr_ptr_bin_nxt;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_bin, dst_rd_ptr_bin_nxt;\n\n    // Synchronized clear signals\n    reg [SYNC_STAGES-1:0] src_clear_sync;\n    reg [SYNC_STAGES-1:0] dst_clear_sync;\n\n    // Synchronized read pointers\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray_sync [SYNC_STAGES-1:0];\n    reg [ADDR_WIDTH:0] src_rd_ptr_gray_sync [SYNC_STAGES-1:0];\n\n    // Binary conversion\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        begin\n            gray_to_bin = gray;\n            for (i = ADDR_WIDTH; i > 0; i = i - 1) begin\n                gray_to_bin[i-1] = gray_to_bin[i] ^ gray_to_bin[i-1];\n            end\n        end\n    endfunction\n\n    // Binary to Gray conversion\n    function [ADDR_WIDTH:0] bin_to_gray;\n        input [ADDR_WIDTH:0] bin;\n        begin\n            bin_to_gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Source side logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr_gray <= 0;\n            src_wr_ptr_bin <= 0;\n            src_clear_reg <= 0;\n        end else begin\n            src_wr_ptr_gray <= src_wr_ptr_gray_nxt;\n            src_wr_ptr_bin <= src_wr_ptr_bin_nxt;\n            src_clear_reg <= src_clear_reg_nxt;\n        end\n    end\n\n    always @(*) begin\n        src_wr_ptr_gray_nxt = src_wr_ptr_gray;\n        src_wr_ptr_bin_nxt = src_wr_ptr_bin;\n        src_clear_reg_nxt = src_clear_reg;\n        src_ready_o = 1'b0;\n\n        if (src_clear_i) begin\n            src_wr_ptr_gray_nxt = 0;\n            src_wr_ptr_bin_nxt = 0;\n            src_clear_reg_nxt = 1'b1;\n        end else if (src_valid_i && !src_clear_reg) begin\n            src_wr_ptr_bin_nxt = src_wr_ptr_bin + 1;\n            src_wr_ptr_gray_nxt = bin_to_gray(src_wr_ptr_bin_nxt);\n            src_ready_o = 1'b1;\n        end\n    end\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear_pending_o <= 0;\n        end else begin\n            src_clear_pending_o <= src_clear_reg;\n        end\n    end\n\n    // Destination side logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr_gray <= 0;\n            dst_rd_ptr_bin <= 0;\n            dst_clear_reg <= 0;\n        end else begin\n            dst_rd_ptr_gray <= dst_rd_ptr_gray_nxt;\n            dst_rd_ptr_bin <= dst_rd_ptr_bin_nxt;\n            dst_clear_reg <= dst_clear_reg_nxt;\n        end\n    end\n\n    always @(*) begin\n        dst_rd_ptr_gray_nxt = dst_rd_ptr_gray;\n        dst_rd_ptr_bin_nxt = dst_rd_ptr_bin;\n        dst_clear_reg_nxt = dst_clear_reg;\n        dst_valid_o = 1'b0;\n\n        if (dst_clear_i) begin\n            dst_rd_ptr_gray_nxt = 0;\n            dst_rd_ptr_bin_nxt = 0;\n            dst_clear_reg_nxt = 1'b1;\n        end else if (dst_ready_i && dst_valid_o && !dst_clear_reg) begin\n            dst_rd_ptr_bin_nxt = dst_rd_ptr_bin + 1;\n            dst_rd_ptr_gray_nxt = bin_to_gray(dst_rd_ptr_bin_nxt);\n        end\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear_pending_o <= 0;\n        end else begin\n            dst_clear_pending_o <= dst_clear_reg;\n        end\n    end\n\n    // Memory write\n    always @(posedge src_clk_i) begin\n        if (src_valid_i && src_ready_o && !src_clear_reg) begin\n            mem[src_wr_ptr_bin[ADDR_WIDTH-1:0]] <= src_data_i;\n        end\n    end\n\n    // Memory read\n    always @(posedge dst_clk_i) begin\n        if (dst_valid_o && dst_ready_i && !dst_clear_reg) begin\n            dst_data_o <= mem[dst_rd_ptr_bin[ADDR_WIDTH-1:0]];\n        end\n    end\n\n    // Synchronization of clear signals\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            src_clear_sync <= {src_clear_sync[SYNC_STAGES-2:0], src_clear_i};\n        end\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            dst_clear_sync <= {dst_clear_sync[SYNC_STAGES-2:0], dst_clear_i};\n        end\n    end\n\n    // Synchronization of read pointers\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_gray_sync <= {SYNC_STAGES{ADDR_WIDTH+1{1'b0}}};\n        end else begin\n            dst_rd_ptr_gray_sync <= {dst_rd_ptr_gray_sync[SYNC_STAGES-2:0], dst_rd_ptr_gray};\n        end\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_rd_ptr_gray_sync <= {SYNC_STAGES{ADDR_WIDTH+1{1'b0}}};\n        end else begin\n            src_rd_ptr_gray_sync <= {src_rd_ptr_gray_sync[SYNC_STAGES-2:0], src_rd_ptr_gray};\n        end\n    end\n\n    // Source side valid and ready\n    assign src_ready_o = (src_wr_ptr_gray_nxt != (dst_rd_ptr_gray_sync[SYNC_STAGES-1] + 1));\n\n    // Destination side valid and ready\n    assign dst_valid_o = (dst_wr_ptr_gray_sync[SYNC_STAGES-1] != (dst_rd_ptr_gray_nxt + 1));\n\nendmodule\n```<|im_end|>",
