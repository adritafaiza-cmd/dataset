  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray, src_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] src_rd_ptr_gray, src_rd_ptr_gray_sync;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray_sync, dst_rd_ptr_gray;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray_nxt;\n    reg [WIDTH-1:0] mem [DEPTH-1:0];\n\n    reg src_clear_reg, dst_clear_reg;\n    reg src_clear_sync, dst_clear_sync;\n\n    // Gray code conversion functions\n    function [ADDR_WIDTH:0] bin_to_gray;\n        input [ADDR_WIDTH:0] bin;\n        bin_to_gray = bin ^ (bin >> 1);\n    endfunction\n\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i > 0; i = i - 1) begin\n            bin[i-1] = bin[i] ^ bin[i-1];\n        end\n        gray_to_bin = bin;\n    endfunction\n\n    // Source side logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr_gray <= 0;\n            src_clear_reg <= 0;\n        end else begin\n            if (src_clear_i) begin\n                src_wr_ptr_gray <= 0;\n                src_clear_reg <= 1;\n            end else if (src_valid_i && src_ready_o) begin\n                src_wr_ptr_gray <= src_wr_ptr_gray_nxt;\n            end\n        end\n    end\n\n    assign src_wr_ptr_gray_nxt = bin_to_gray(gray_to_bin(src_wr_ptr_gray) + 1);\n\n    // Source side clear synchronization\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear_sync <= 0;\n        end else begin\n            src_clear_sync <= src_clear_reg;\n        end\n    end\n\n    assign src_clear_pending_o = src_clear_reg;\n\n    // Source side ready signal\n    assign src_ready_o = (src_wr_ptr_gray_nxt != src_rd_ptr_gray_sync);\n\n    // Source side write operation\n    always @(posedge src_clk_i) begin\n        if (src_valid_i && src_ready_o) begin\n            mem[gray_to_bin(src_wr_ptr_gray)[ADDR_WIDTH-1:0]] <= src_data_i;\n        end\n    end\n\n    // Destination side logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr_gray <= 0;\n            dst_clear_reg <= 0;\n        end else begin\n            if (dst_clear_i) begin\n                dst_rd_ptr_gray <= 0;\n                dst_clear_reg <= 1;\n            end else if (dst_valid_o && dst_ready_i) begin\n                dst_rd_ptr_gray <= dst_wr_ptr_gray_sync;\n            end\n        end\n    end\n\n    // Destination side clear synchronization\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear_sync <= 0;\n        end else begin\n            dst_clear_sync <= dst_clear_reg;\n        end\n    end\n\n    assign dst_clear_pending_o = dst_clear_reg;\n\n    // Gray code synchronization for source read pointer\n    genvar i;\n    generate\n        for (i = 0; i < SYNC_STAGES; i = i + 1) begin : sync_src_rd_ptr_gray\n            reg [ADDR_WIDTH:0] sync_stage;\n            if (i == 0) begin\n                always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n                    if (!dst_rst_ni) begin\n                        sync_stage <= 0;\n                    end else begin\n                        sync_stage <= src_wr_ptr_gray;\n                    end\n                end\n            end else begin\n                always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n                    if (!dst_rst_ni) begin\n                        sync_stage <= 0;\n                    end else begin\n                        sync_stage <= sync_src_rd_ptr_gray[i-1].sync_stage;\n                    end\n                end\n            end\n            if (i == SYNC_STAGES - 1) begin\n                assign src_rd_ptr_gray_sync = sync_stage;\n            end\n        end\n    endgenerate\n\n    // Gray code synchronization for destination write pointer\n    generate\n        for (i = 0; i < SYNC_STAGES; i = i + 1) begin : sync_dst_wr_ptr_gray\n            reg [ADDR_WIDTH:0] sync_stage;\n            if (i == 0) begin\n                always @(posedge src_clk_i or negedge src_rst_ni) begin\n                    if (!src_rst_ni) begin\n                        sync_stage <= 0;\n                    end else begin\n                        sync_stage <= dst_rd_ptr_gray;\n                    end\n                end\n            end else begin\n                always @(posedge src_clk_i or negedge src_rst_ni) begin\n                    if (!src_rst_ni) begin\n                        sync_stage <= 0;\n                    end else begin\n                        sync_stage <= sync_dst_wr_ptr_gray[i-1].sync_stage;\n                    end\n                end\n            end\n            if (i == SYNC_STAGES - 1) begin\n                assign dst_wr_ptr_gray_sync = sync_stage;\n            end\n        end\n    endgenerate\n\n    // Destination side valid signal\n    assign dst_valid_o = (dst_wr_ptr_gray_sync != dst_rd_ptr_gray);\n\n    // Destination side read operation\n    always @(posedge dst_clk_i) begin\n        if (dst_valid_o && dst_ready_i)