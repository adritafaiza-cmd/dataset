nc_reg;\n            always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n                if (!dst_rst_ni) begin\n                    sync_reg <= 0;\n                end else begin\n                    sync_reg <= {sync_reg[SYNC_STAGES-2:0], src_rd_ptr_gray_sync[i]};\n                end\n            end\n            assign dst_wr_ptr_gray_sync[i] = sync_reg[SYNC_STAGES-1];\n        end\n    endgenerate\n\n    // Cross-domain synchronization for dst_rd_ptr_gray\n    generate\n        for (i = 0; i <= ADDR_WIDTH; i = i + 1) begin : sync_dst_rd_ptr_gray\n            reg [SYNC_STAGES-1:0] sync_reg;\n            always @(posedge src_clk_i or negedge src_rst_ni) begin\n                if (!src_rst_ni) begin\n                    sync_reg <= 0;\n                end else begin\n                    sync_reg <= {sync_reg[SYNC_STAGES-2:0], dst_rd_ptr_gray[i]};\n                end\n            end\n            assign src_rd_ptr_gray_sync[i] = sync_reg[SYNC_STAGES-1];\n        end\n    endgenerate\n\n    // Source side ready and valid logic\n    assign src_ready_o = (src_wr_ptr_gray != dst_wr_ptr_gray_sync);\n    assign src_clear_pending_o = src_clear_pending;\n\n    // Destination side valid and data logic\n    assign dst_valid_o = (dst_wr_ptr_gray_sync != dst_rd_ptr_gray);\n    assign dst_data_o = mem[gray_to_bin(dst_rd_ptr_gray)];\n    assign dst_clear_pending_o = dst_clear_pending;\n\n    // Memory write logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            mem <= '{default:0};\n        end else if (src_valid_i && src_ready_o) begin\n            mem[gray_to_bin(src_wr_ptr_gray)] <= src_data_i;\n        end\n    end\n\nendmodule\n```<|im_end|>",
