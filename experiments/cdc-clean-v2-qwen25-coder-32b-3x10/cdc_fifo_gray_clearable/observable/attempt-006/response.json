  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    // Source side signals\n    reg [ADDR_WIDTH:0] src_wr_ptr;\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray;\n    reg [ADDR_WIDTH:0] src_rd_ptr_gray_sync;\n    reg [WIDTH-1:0]    mem [0:DEPTH-1];\n    reg                src_clear_pending;\n    reg                src_clear;\n\n    // Destination side signals\n    reg [ADDR_WIDTH:0] dst_rd_ptr;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray_sync;\n    reg                dst_clear_pending;\n    reg                dst_clear;\n\n    // Clear handling\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear <= 1'b0;\n            src_clear_pending <= 1'b0;\n        end else begin\n            if (src_clear_i) begin\n                src_clear <= 1'b1;\n                src_clear_pending <= 1'b1;\n            end else if (src_clear) begin\n                src_clear <= 1'b0;\n            end\n        end\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear <= 1'b0;\n            dst_clear_pending <= 1'b0;\n        end else begin\n            if (dst_clear_i) begin\n 