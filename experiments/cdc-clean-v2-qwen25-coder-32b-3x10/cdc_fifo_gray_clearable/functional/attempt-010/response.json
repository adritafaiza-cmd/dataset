  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray, src_wr_ptr_bin, src_wr_ptr_bin_next;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray, dst_rd_ptr_bin, dst_rd_ptr_bin_next;\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg src_clear_pending, dst_clear_pending;\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr_gray <= 0;\n            src_wr_ptr_bin <= 0;\n            src_clear_pending <= 0;\n        end else begin\n            if (src_clear_i) begin\n                src_wr_ptr_gray <= 0;\n                src_wr_ptr_bin <= 0;\n                src_clear_pending <= 1;\n            end else if (src_ready_o && src_valid_i) begin\n                src_wr_ptr_bin <= src_wr_ptr_bin_next;\n                src_wr_ptr_gray <= src_wr_ptr_bin_next ^ (src_wr_ptr_bin_next >> 1);\n            end\n            if (src_clear_pending && !dst_clear_pending) begin\n                src_clear_pending <= 0;\n            end\n        end\n    end\n\n    assign src_wr_ptr_bin_next = src_wr_ptr_bin + 1;\n\n    assign src_ready_o = ~((src_wr_ptr_bin_next[ADDR_WIDTH-1:0] == dst_rd_ptr_bin[ADDR_WIDTH-1:0]) && (src_wr_ptr_bin_next[ADDR_WIDTH] != dst_rd_ptr_bin[ADDR_WIDTH]));\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            mem[0] <= 0;\n        end else if (src_ready_o && src_valid_i) begin\n            mem[src_wr_ptr_bin[ADDR_WIDTH-1:0]] <= src_data_i;\n        end\n    end\n\n    assign src_clear_pending_o = src_clear_pending;\n\n    // Destination domain logic\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray_sync [0:SYNC_STAGES-1];\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr_gray_sync[0] <= 0;\n        end else begin\n            dst_rd_ptr_gray_sync[0] <= src_wr_ptr_gray;\n        end\n    end\n\n    genvar i;\n    generate\n        for (i = 1; i < SYNC_STAGES; i = i + 1) begin : gen_sync_stages\n            always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n                if (!dst_rst_ni) begin\n                    dst_rd_ptr_gray_sync[i] <= 0;\n                end else begin\n                    dst_rd_ptr_gray_sync[i] <= dst_rd_ptr_gray_sync[i-1];\n                end\n            end\n        end\n    endgenerate\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr_bin <= 0;\n            dst_clear_pending <= 0;\n        end else begin\n            if (dst_clear_i) begin\n                dst_rd_ptr_bin <= 0;\n                dst_clear_pending <= 1;\n            end else if (dst_valid_o && dst_ready_i) begin\n                dst_rd_ptr_bin <= dst_rd_ptr_bin_next;\n            end\n            if (dst_clear_pending && !src_clear_pending) begin\n                dst_clear_pending <= 0;\n            end\n        end\n    end\n\n    assign dst_rd_ptr_bin_next = dst_rd_ptr_bin + 1;\n\n    assign dst_valid_o = ~((dst_rd_ptr_bin_next[ADDR_WIDTH-1:0] == src_wr_ptr_bin[ADDR_WIDTH-1:0]) && (dst_rd_ptr_bin_next[ADDR_WIDTH] != src_wr_ptr_bin[ADDR_WIDTH]));\n\n    always @(posedge dst_clk_i or ne