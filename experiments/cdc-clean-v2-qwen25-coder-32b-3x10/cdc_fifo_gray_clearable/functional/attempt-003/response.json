  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    // Source domain signals\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray;\n    reg [ADDR_WIDTH:0] src_wr_ptr_bin;\n    reg [ADDR_WIDTH:0] src_rd_ptr_gray_sync;\n    reg [WIDTH-1:0] mem [DEPTH-1:0];\n    reg src_clear_pending;\n    reg src_ready;\n\n    // Destination domain signals\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_bin;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray_sync;\n    reg dst_clear_pending;\n    reg dst_valid;\n    reg [WIDTH-1:0] dst_data;\n\n    // Gray code conversion functions\n    function [ADDR_WIDTH:0] bin_to_gray;\n        input [ADDR_WIDTH:0] bin;\n        bin_to_gray = bin ^ (bin >> 1);\n    endfunction\n\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i > 0; i = i - 1) begin\n            bin[i-1] = bin[i] ^ bin[i-1];\n        end\n        gray_to_bin = bin;\n    endfunction\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr_gray <= 0;\n            src_wr_ptr_bin <= 0;\n            src_clear_pending <= 0;\n        end else begin\n            if (src_clear_i) begin\n                src_wr_ptr_gray <= 0;\n                src_wr_ptr_bin <= 0;\n                src_clear_pending <= 1;\n            end else if (src_ready && src_valid_i) begin\n                src_wr_ptr_bin <= src_wr_ptr_bin + 1;\n                src_wr_ptr_gray <= bin_to_gray(src_wr_ptr_bin + 1);\n            end\n            if (src_clear_pending && (src_wr_ptr_gray == src_rd_ptr_gray_sync)) begin\n                src_clear_pending <= 0;\n            end\n        end\n    end\n\n    // Source domain ready signal\n    always @(*) begin\n        src_ready = (src_wr_ptr_gray + 1 != src_rd_ptr_gray_sync);\n    end\n\n    // Source domain memory write\n    always @(posedge src_clk_i) begin\n        if (src_ready && src_valid_i) begin\n            mem[src_wr_ptr_bin[ADDR_WIDTH-1:0]] <= src_data_i;\n        end\n    end\n\n    // Source domain clear pending output\n    assign src_clear_pending_o = src_clear_pending;\n\n    // Source domain ready output\n    assign src_ready_o = src_ready;\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr_gray <= 0;\n            dst_rd_ptr_bin <= 0;\n            dst_clear_pending <= 0;\n        end else begin\n            if (dst_clear_i) begin\n                dst_rd_ptr_gray <= 0;\n                dst_rd_ptr_bin <= 0;\n                dst_clear_pending <= 1;\n            end else if (dst_valid && dst_ready_i) begin\n                dst_rd_ptr_bin <= dst_rd_ptr_bin + 1;\n                dst_rd_ptr_gray <= bin_to_gray(dst_rd_ptr_bin + 1);\n            end\n            if (dst_clear_pending && (dst_wr_ptr_gray_sync == dst_rd_ptr_gray)) begin\n                dst_clear_pending <= 0;\n            end\n        end\n    end\n\n    // Destination domain valid signal\n    always @(*) begin\n        dst_valid = (dst_wr_ptr_gray_sync != dst_rd_ptr_gray);\n    end\n\n    // Destination domain memory read\n    always @(posedge dst_clk_i) begin\n        if (dst_valid && dst_ready_i) begin\n            dst_data <= mem[dst_rd_ptr_bin[ADDR_WIDTH-1:0]];\n        end\n    end\n\n    // Destination domain clear pending output\n    assign dst_clear_pending_o = dst_clear_pending;\n\n    // Destination domain valid output\n    assign dst_valid_o = dst_valid;\n\n    // Destination domain data output\n    assign dst_data_o = dst_data;\n\n    // Gray code synchronization for source to destination\n    genvar i;\n    generate\n        for (i = 0; i <= ADDR_WIDTH; i = i + 1) begin : sync_src_to_dst\n            reg [SYNC_STAGES-1:0] sync_reg;\n            always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n                if (!dst_rst_ni) begin\n                    sync_reg <= 0;\n                end else begin\n                    sync_reg <= {sync_reg[SYNC_STAGES-2:0], src_wr_ptr_gray[i]};\n                end\n            end\n            assign dst_wr_ptr_gray_sync[i] = sync_reg[SYNC_STAGES-1];\n        end\n    endgenerate\n\n    // Gray code synchronization for destination to source\n    generate\n        for (i = 0; i <= ADDR_WIDTH; i = i + 1) begin : sync_dst_to_src\n            reg [SYNC_STAGES-1:0] sync_reg;\n            always @(posedge src_clk_i or negedge src_rst_ni) begin\n                if (!src_rst_ni) begin\n                    sync_reg <= 0;\n                end else begin\n                    sync_reg <= {sync_reg[SYNC_STAGES-2:0], dst_rd_ptr_gray[i]};\n                end\n            end\n            assign src_rd_ptr_gray_sync[i] = sync_reg[SYNC_STAGES-1];\n        end\n    endgenerate\n\nendmodule\n```<|im_end|>",
