  "text": "```verilog\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    reg [WIDTH-1:0] mem [DEPTH-1:0];\n\n    // Source side pointers\n    reg [ADDR_WIDTH:0] src_wr_ptr;\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray_sync;\n\n    // Destination side pointers\n    reg [ADDR_WIDTH:0] dst_rd_ptr;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray;\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray_sync;\n\n    // Gray code conversion functions\n    function [ADDR_WIDTH:0] bin_to_gray;\n        input [ADDR_WIDTH:0] bin;\n        bin_to_gray = bin ^ (bin >> 1);\n    endfunction\n\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH; i > 0; i = i - 1) begin\n            bin[i-1] = bin[i] ^ bin[i-1];\n        end\n        gray_to_bin = bin;\n    endfunction\n\n    // Source side logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= 0;\n            src_wr_ptr_gray <= 0;\n        end else if (src_valid_i && src_ready_o) begin\n            mem[src_wr_ptr[ADDR_WIDTH-1:0]] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr + 1;\n            src_wr_ptr_gray <= bin_to_gray(src_wr_ptr + 1);\n        end\n    end\n\n    // Synchronize destination read pointer to source clock domain\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray_sync_reg [SYNC_STAGES-1:0];\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_gray_sync_reg <= {SYNC_STAGES{0}};\n        end else begin\n            dst_rd_ptr_gray_sync_reg[0] <= dst_rd_ptr_gray;\n            for (integer i = 0; i < SYNC_STAGES-1; i = i + 1) begin\n                dst_rd_ptr_gray_sync_reg[i+1] <= dst_rd_ptr_gray_sync_reg[i];\n            end\n        end\n    end\n    assign dst_rd_ptr_gray_sync = dst_rd_ptr_gray_sync_reg[SYNC_STAGES-1];\n\n    // Source ready signal\n    assign src_ready_o = (src_wr_ptr_gray + 1 != dst_rd_ptr_gray_sync);\n\n    // Destination side logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= 0;\n            dst_rd_ptr_gray <= 0;\n        end else if (dst_valid_o && dst_ready_i) begin\n            dst_rd_ptr <= dst_rd_ptr + 1;\n            dst_rd_ptr_gray <= bin_to_gray(dst_rd_ptr + 1);\n        end\n    end\n\n    // Synchronize source write pointer to destination clock domain\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray_sync_reg [SYNC_STAGES-1:0];\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_gray_sync_reg <= {SYNC_STAGES{0}};\n        end else begin\n            src_wr_ptr_gray_sync_reg[0] <= src_wr_ptr_gray;\n            for (integer i = 0; i < SYNC_STAGES-1; i = i + 1) begin\n                src_wr_ptr_gray_sync_reg[i+1] <= src_wr_ptr_gray_sync_reg[i];\n            end\n        end\n    end\n    assign src_wr_ptr_gray_sync = src_wr_ptr_gray_sync_reg[SYNC_STAGES-1];\n\n    // Destination valid signal\n    assign dst_valid_o = (src_wr_ptr_gray_sync != dst_rd_ptr_gray);\n\n    // Destination data output\n    assign dst_data_o = mem[dst_rd_ptr[ADDR_WIDTH-1:0]];\n\nendmodule\n```<|im_end|>",
