  "text": "```verilog\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray, src_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] src_rd_ptr_gray, src_rd_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray, dst_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray, dst_rd_ptr_gray_nxt;\n\n    reg [WIDTH-1:0] mem [DEPTH-1:0];\n\n    // Gray code conversion functions\n    function [ADDR_WIDTH:0] bin2gray;\n        input [ADDR_WIDTH:0] bin;\n        bin2gray = bin ^ (bin >> 1);\n    endfunction\n\n    function [ADDR_WIDTH:0] gray2bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i > 0; i = i - 1) begin\n            bin[i-1] = bin[i] ^ bin[i-1];\n        end\n        gray2bin = bin;\n    endfunction\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr_gray <= 0;\n            src_rd_ptr_gray <= 0;\n        end else begin\n            src_wr_ptr_gray <= src_wr_ptr_gray_nxt;\n            src_rd_ptr_gray <= src_rd_ptr_gray_nxt;\n        end\n    end\n\n    always @(*) begin\n        src_wr_ptr_gray_nxt = src_wr_ptr_gray;\n        src_rd_ptr_gray_nxt = src_rd_ptr_gray;\n        src_ready_o = 1'b0;\n\n        if (src_valid_i && (gray2bin(src_wr_ptr_gray) != gray2bin(src_rd_ptr_gray) + 1)) begin\n            src_ready_o = 1'b1;\n            src_wr_ptr_gray_nxt = bin2gray(gray2bin(src_wr_ptr_gray) + 1);\n        end\n    end\n\n    always @(posedge src_clk_i) begin\n        if (src_ready_o && src_valid_i) begin\n            mem[gray2bin(src_wr_ptr_gray)[ADDR_WIDTH-1:0]] <= src_data_i;\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_wr_ptr_gray <= 0;\n            dst_rd_ptr_gray <= 0;\n        end else begin\n            dst_wr_ptr_gray <= dst_wr_ptr_gray_nxt;\n            dst_rd_ptr_gray <= dst_rd_ptr_gray_nxt;\n        end\n    end\n\n    // Synchronize src_wr_ptr_gray to dst_clk_i\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray_sync [SYNC_STAGES-1:0];\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_gray_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            src_wr_ptr_gray_sync[0] <= src_wr_ptr_gray;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1) begin\n                src_wr_ptr_gray_sync[i] <= src_wr_ptr_gray_sync[i-1];\n            end\n        end\n    end\n\n    always @(*) begin\n        dst_wr_ptr_gray_nxt = dst_wr_ptr_gray;\n        dst_rd_ptr_gray_nxt = dst_rd_ptr_gray;\n        dst_valid_o = 1'b0;\n\n        if (gray2bin(dst_wr_ptr_gray) != gray2bin(dst_rd_ptr_gray) && gray2bin(src_wr_ptr_gray_sync[SYNC_STAGES-1]) != gray2bin(dst_wr_ptr_gray) + 1) begin\n            dst_valid_o = 1'b1;\n            dst_wr_ptr_gray_nxt = bin2gray(gray2bin(dst_wr_ptr_gray) + 1);\n        end\n    end\n\n    always @(posedge dst_clk_i) begin\n        if (dst_valid_o && dst_ready_i) begin\n            dst_rd_ptr_gray_nxt = bin2gray(gray2bin(dst_rd_ptr_gray) + 1);\n        end\n    end\n\n    always @(posedge dst_clk_i) begin\n        if (dst_valid_o) begin\n            dst_data_o <= mem[gray2bin(dst_rd_ptr_gray)[ADDR_WIDTH-1:0]];\n        end\n    end\n\nendmodule\n```<|im_end|>",
