  "text": "```verilog\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    reg [WIDTH-1:0] mem [DEPTH-1:0];\n    reg [ADDR_WIDTH:0] src_wr_ptr_gray, src_wr_ptr_gray_nxt, src_wr_ptr_bin;\n    reg [ADDR_WIDTH:0] dst_rd_ptr_gray, dst_rd_ptr_gray_nxt, dst_rd_ptr_bin;\n    reg [SYNC_STAGES-1:0] dst_wr_ptr_gray_sync, dst_rd_ptr_gray_sync;\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr_gray <= 0;\n        end else begin\n            src_wr_ptr_gray <= src_wr_ptr_gray_nxt;\n        end\n    end\n\n    always @(*) begin\n        src_wr_ptr_gray_nxt = src_wr_ptr_gray;\n        if (src_valid_i && src_ready_o) begin\n            src_wr_ptr_gray_nxt = src_wr_ptr_gray + 1;\n        end\n    end\n\n    assign src_wr_ptr_bin = (src_wr_ptr_gray >> 1) ^ src_wr_ptr_gray;\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr_gray <= 0;\n        end else begin\n            dst_rd_ptr_gray <= dst_rd_ptr_gray_nxt;\n        end\n    end\n\n    always @(*) begin\n        dst_rd_ptr_gray_nxt = dst_rd_ptr_gray;\n        if (dst_valid_o && dst_ready_i) begin\n            dst_rd_ptr_gray_nxt = dst_rd_ptr_gray + 1;\n        end\n    end\n\n    assign dst_rd_ptr_bin = (dst_rd_ptr_gray >> 1) ^ dst_rd_ptr_gray;\n\n    // Cross-domain synchronization\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_wr_ptr_gray_sync <= 0;\n        end else begin\n            dst_wr_ptr_gray_sync <= {dst_wr_ptr_gray_sync[SYNC_STAGES-2:0], src_wr_ptr_gray};\n        end\n    end\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_gray_sync <= 0;\n        end else begin\n            dst_rd_ptr_gray_sync <= {dst_rd_ptr_gray_sync[SYNC_STAGES-2:0], dst_rd_ptr_gray};\n        end\n    end\n\n    // Source ready signal\n    assign src_ready_o = (src_wr_ptr_bin + 1) != dst_wr_ptr_gray_sync[SYNC_STAGES-1];\n\n    // Destination valid signal\n    assign dst_valid_o = (dst_rd_ptr_bin + 1) != dst_wr_ptr_gray_sync[SYNC_STAGES-1];\n\n    // Data output\n    reg [WIDTH-1:0] dst_data_o_reg [SYNC_STAGES-1:0];\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_o_reg <= 0;\n        end else begin\n            dst_data_o_reg[0] <= mem[dst_rd_ptr_bin];\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1) begin\n                dst_data_o_reg[i] <= dst_data_o_reg[i-1];\n            end\n        end\n    end\n\n    assign dst_data_o = dst_data_o_reg[SYNC_STAGES-1];\n\nendmodule\n```<|im_end|>",
