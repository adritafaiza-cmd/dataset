  "text": "```verilog\nmodule axil_cdc #\n(\n    parameter DATA_WIDTH = 32,\n    parameter ADDR_WIDTH = 32,\n    parameter STRB_WIDTH = (DATA_WIDTH/8)\n)\n(\n    /*\n     * AXI lite slave interface\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_awaddr,\n    input  wire [2:0]             s_axil_awprot,\n    input  wire                   s_axil_awvalid,\n    output wire                   s_axil_awready,\n    input  wire [DATA_WIDTH-1:0]  s_axil_wdata,\n    input  wire [STRB_WIDTH-1:0]  s_axil_wstrb,\n    input  wire                   s_axil_wvalid,\n    output wire                   s_axil_wready,\n    output wire [1:0]             s_axil_bresp,\n    output wire                   s_axil_bvalid,\n    input  wire                   s_axil_bready,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_araddr,\n    input  wire [2:0]             s_axil_arprot,\n    input  wire                   s_axil_arvalid,\n    output wire                   s_axil_arready,\n    output wire [DATA_WIDTH-1:0]  s_axil_rdata,\n    output wire [1:0]             s_axil_rresp,\n    output wire                   s_axil_rvalid,\n    input  wire                   s_axil_rready,\n    /*\n     * AXI lite master interface\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [ADDR_WIDTH-1:0]  m_axil_awaddr,\n    output wire [2:0]             m_axil_awprot,\n    output wire                   m_axil_awvalid,\n    input  wire                   m_axil_awready,\n    output wire [DATA_WIDTH-1:0]  m_axil_wdata,\n    output wire [STRB_WIDTH-1:0]  m_axil_wstrb,\n    output wire                   m_axil_wvalid,\n    input  wire                   m_axil_wready,\n    input  wire [1:0]             m_axil_bresp,\n    input  wire                   m_axil_bvalid,\n    output wire                   m_axil_bready,\n    output wire [ADDR_WIDTH-1:0]  m_axil_araddr,\n    output wire [2:0]             m_axil_arprot,\n    output wire                   m_axil_arvalid,\n    input  wire                   m_axil_arready,\n    input  wire [DATA_WIDTH-1:0]  m_axil_rdata,\n    input  wire [1:0]             m_axil_rresp,\n    input  wire                   m_axil_rvalid,\n    output wire                   m_axil_rready\n);\n\n    /*\n     * Write channel\n     */\n    reg [ADDR_WIDTH-1:0] s_awaddr_reg;\n    reg [2:0] s_awprot_reg;\n    reg [DATA_WIDTH-1:0] s_wdata_reg;\n    reg [STRB_WIDTH-1:0] s_wstrb_reg;\n    reg s_awvalid_reg;\n    reg s_wvalid_reg;\n    reg s_awvalid_sync1;\n    reg s_awvalid_sync2;\n    reg s_wvalid_sync1;\n    reg s_wvalid_sync2;\n    reg m_awvalid_reg;\n    reg m_wvalid_reg;\n    reg m_awready_sync1;\n    reg m_awready_sync2;\n    reg m_wready_sync1;\n    reg m_wready_sync2;\n    reg [1:0] m_bresp_reg;\n    reg m_bvalid_reg;\n    reg s_bready_sync1;\n    reg s_bready_sync2;\n\n    /*\n     * Read channel\n     */\n    reg [ADDR_WIDTH-1:0] s_araddr_reg;\n    reg [2:0] s_arprot_reg;\n    reg s_arvalid_reg;\n    reg s_arvalid_sync1;\n    reg s_arvalid_sync2;\n    reg m_arvalid_reg;\n    reg m_arready_sync1;\n    reg m_arready_sync2;\n    reg [DATA_WIDTH-1:0] m_rdata_reg;\n    reg [1:0] m_rresp_reg;\n    reg m_rvalid_reg;\n    reg s_rready_sync1;\n    reg s_rready_sync2;\n\n    /*\n     * Write channel synchronization\n     */\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_awvalid_sync1 <= 1'b0;\n            s_awvalid_sync2 <= 1'b0;\n            s_wvalid_sync1 <= 1'b0;\n            s_wvalid_sync2 <= 1'b0;\n        end else begin\n            s_awvalid_sync1 <= s_awvalid_reg;\n            s_awvalid_sync2 <= s_awvalid_sync1;\n            s_wvalid_sync1 <= s_wvalid_reg;\n            s_wvalid_sync2 <= s_wvalid_sync1;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_awready_sync1 <= 1'b0;\n            m_awready_sync2 <= 1'b0;\n            m_wready_sync1 <= 1'b0;\n            m_wready_sync2 <= 1'b0;\n        end else begin\n            m_awready_sync1 <= m_axil_awready;\n            m_awready_sync2 <= m_awready_sync1;\n            m_wready_sync1 <= m_axil_wready;\n            m_wready_sync2 <= m_wready_sync1;\n        end\n    end\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_bready_sync1 <= 1'b0;\n            s_bready_sync2 <= 1'b0;\n        end else begin\n            s_bready_sync1 <= s_axil_bready;\n            s_bready_sync2 <= s_bready_sync1;\n        end\n    end\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_axil_awready <= 1'b0;\n            s_axil_wready <= 1'b0;\n            s_axil_bresp <= 2'b0;\n            s_axil_bvalid <= 1'b0;\n            s_awaddr_reg <= {ADDR_WIDTH{1'b0}};\n            s_awprot_reg <= 3'b0;\n            s_wdata_reg <= {DATA_WIDTH{1'b0}};\n            s_wstrb_reg <= {STRB_WIDTH{1'b0}};\n            s_awvalid_reg <= 1'b0;\n            s_wvalid_reg <= 1'b0;\n        end else begin\n            s_axil_awready <= ~s_awvalid_sync2 & m_awready_sync2;\n            s_axil_wready <= ~s_wvalid_sync2 & m_wready_sync2;\n            if (s_axil_awready & s_axil_awvalid) begin\n                s_awaddr_reg <= s_axil_awaddr;\n                s_awprot_reg <= s_axil_awprot;\n                s_awvalid_reg <= 1'b1;\n            end else if (m_axil_awready) begin\n                s_awvalid_reg <= 1'b0;\n            end\n            if (s_axil_wready & s_axil_wvalid) begin\n                s_wdata_reg <= s_axil_wdata;\n                s_wstrb_reg <= s_axil_wstrb;\n                s_wvalid_reg <= 1'b1;\n            end else if (m_axil_wready) begin\n                s_wvalid_reg <= 1'b0;\n            end\n            if (m_axil_bvalid & s_bready_sync2) begin\n                s_axil_bresp <= m_axil_bresp;\n                s_axil_bvalid <= 1'b1;\n            end else begin\n                s_axil_bvalid <= 1'b0;\n            end\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_axil_awaddr <= {ADDR_WIDTH{1'b0}};\n            m_axil_awprot <= 3'b0;\n            m_axil_awvalid <= 1'b0;\n            m_axil_wdata <= {DATA_WIDTH{1'b0}};\n            m_axil_wstrb <= {STRB_WIDTH{1'b0}};\n            m_axil_wvalid <= 1'b0;\n            m_axil_bready <= 1'b0;\n            m_bresp_reg <= 2'b0;\n            m_bvalid_reg <= 1'b0;\n        end else begin\n            m_axil_awaddr <= s_awaddr_reg;\n            m_axil_awprot <= s_awprot_reg;\n            m_axil_awvalid <= s_awvalid_sync2;\n            m_axil_wdata <= s_wdata_reg;\n            m_axil_wstrb <= s_wstrb_reg;\n            m_axil_wvalid <= s_wvalid_sync2;\n            m_axil_bready <= s_bready_sync2;\n            if (m_axil_bvalid) begin\n                m_bresp_reg <= m_axil_bresp;\n                m_bvalid_reg <= 1'b1;\n            end else begin\n                m_bvalid_reg <= 1'b0;\n            end\n        end\n    end\n\n    /*\n     * Read channel synchronization\n     */\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_arvalid_sync1 <= 1'b0;\n            s_arvalid_sync2 <= 1'b0;\n        end else begin\n            s_arvalid_sync1 <= s_arvalid_reg;\n            s_arvalid_sync2 <= s_arvalid_sync1;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_arready_sync1 <= 1'b0;\n            m_arready_sync2 <= 1'b0;\n        end else begin\n            m_arready_sync1 <= m_axil_arready;\n            m_arready_sync2 <= m_arready_sync1;\n        end\n    end\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_rready_sync1 <= 1'b0;\n            s_rready_sync2 <= 1'b0;\n        end else begin\n            s_rready_sync1 <= s_axil_rready;\n            s_rready_sync2 <= s_rready_sync1;\n        end\n    end\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_axil_arready <= 1'b0;\n            s_axil_rdata <= {DATA_WIDTH{1'b0}};\n            s_axil_rresp <= 2'b0;\n            s_axil_rvalid <= 1'b0;\n            s_araddr_reg <= {ADDR_WIDTH{1'b0}};\n            s_arprot_reg <= 3'b0;\n            s_arvalid_reg <= 1'b0;\n        end else begin\n            s_axil_arready <= ~s_arvalid_sync2 & m_arready_sync2;\n            if (s_axil_arready & s_axil_arvalid) begin\n                s_araddr_reg <= s_axil_araddr;\n                s_arprot_reg <= s_axil_arprot;\n                s_arvalid_reg <= 1'b1;\n            end else if (m_axil_arready) begin\n                s_arvalid_reg <= 1'b0;\n            end\n            if (m_axil_rvalid & s_rready_sync2) begin\n                s_axil_rdata <= m_axil_rdata;\n                s_axil_rresp <= m_axil_rresp;\n                s_axil_rvalid <= 1'b1;\n            end else begin\n                s_axil_rvalid <= 1'b0;\n            end\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_axil_araddr <= {ADDR_WIDTH{1'b0}};\n            m_axil_arprot <= 3'b0;\n            m_axil_arvalid <= 1'b0;\n            m_axil_rready <= 1'b0;\n            m_rdata_reg <= {DATA_WIDTH{1'b0}};\n            m_rresp_reg <= 2'b0;\n            m_rvalid_reg <= 1'b0;\n        end else begin\n            m_axil_araddr <= s_araddr_reg;\n            m_axil_arprot <= s_arprot_reg;\n            m_axil_arvalid <= s_arvalid_sync2;\n            m_axil_rready <= s_rready_sync2;\n            if (m_axil_rvalid) begin\n                m_rdata_reg <= m_axil_rdata;\n                m_rresp_reg <= m_axil_rresp;\n                m_rvalid_reg <= 1'b1;\n            end else begin\n                m_rvalid_reg <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
