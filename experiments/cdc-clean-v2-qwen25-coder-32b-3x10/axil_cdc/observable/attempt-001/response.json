  "text": "```verilog\nmodule axil_cdc #\n(\n    parameter DATA_WIDTH = 32,\n    parameter ADDR_WIDTH = 32,\n    parameter STRB_WIDTH = (DATA_WIDTH/8)\n)\n(\n    /*\n     * AXI lite slave interface\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_awaddr,\n    input  wire [2:0]             s_axil_awprot,\n    input  wire                   s_axil_awvalid,\n    output wire                   s_axil_awready,\n    input  wire [DATA_WIDTH-1:0]  s_axil_wdata,\n    input  wire [STRB_WIDTH-1:0]  s_axil_wstrb,\n    input  wire                   s_axil_wvalid,\n    output wire                   s_axil_wready,\n    output wire [1:0]             s_axil_bresp,\n    output wire                   s_axil_bvalid,\n    input  wire                   s_axil_bready,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_araddr,\n    input  wire [2:0]             s_axil_arprot,\n    input  wire                   s_axil_arvalid,\n    output wire                   s_axil_arready,\n    output wire [DATA_WIDTH-1:0]  s_axil_rdata,\n    output wire [1:0]             s_axil_rresp,\n    output wire                   s_axil_rvalid,\n    input  wire                   s_axil_rready,\n    /*\n     * AXI lite master interface\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [ADDR_WIDTH-1:0]  m_axil_awaddr,\n    output wire [2:0]             m_axil_awprot,\n    output wire                   m_axil_awvalid,\n    input  wire                   m_axil_awready,\n    output wire [DATA_WIDTH-1:0]  m_axil_wdata,\n    output wire [STRB_WIDTH-1:0]  m_axil_wstrb,\n    output wire                   m_axil_wvalid,\n    input  wire                   m_axil_wready,\n    input  wire [1:0]             m_axil_bresp,\n    input  wire                   m_axil_bvalid,\n    output wire                   m_axil_bready,\n    output wire [ADDR_WIDTH-1:0]  m_axil_araddr,\n    output wire [2:0]             m_axil_arprot,\n    output wire                   m_axil_arvalid,\n    input  wire                   m_axil_arready,\n    input  wire [DATA_WIDTH-1:0]  m_axil_rdata,\n    input  wire [1:0]             m_axil_rresp,\n    input  wire                   m_axil_rvalid,\n    output wire                   m_axil_rready\n);\n\n    // Slave to Master signals\n    reg [ADDR_WIDTH-1:0] s2m_awaddr_reg;\n    reg [2:0] s2m_awprot_reg;\n    reg s2m_awvalid_reg;\n    reg [DATA_WIDTH-1:0] s2m_wdata_reg;\n    reg [STRB_WIDTH-1:0] s2m_wstrb_reg;\n    reg s2m_wvalid_reg;\n    reg [ADDR_WIDTH-1:0] s2m_araddr_reg;\n    reg [2:0] s2m_arprot_reg;\n    reg s2m_arvalid_reg;\n\n    // Master to Slave signals\n    reg [1:0] m2s_bresp_reg;\n    reg m2s_bvalid_reg;\n    reg [DATA_WIDTH-1:0] m2s_rdata_reg;\n    reg [1:0] m2s_rresp_reg;\n    reg m2s_rvalid_reg;\n\n    // Cross-domain synchronization\n    reg [1:0] s_awvalid_meta, s_awvalid_sync;\n    reg [1:0] s_wvalid_meta, s_wvalid_sync;\n    reg [1:0] s_arvalid_meta, s_arvalid_sync;\n    reg [1:0] m_bvalid_meta, m_bvalid_sync;\n    reg [1:0] m_rvalid_meta, m_rvalid_sync;\n\n    // Slave side\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_axil_awready <= 0;\n            s_axil_wready <= 0;\n            s_axil_arready <= 0;\n            s_axil_bresp <= 0;\n            s_axil_bvalid <= 0;\n            s_axil_rdata <= 0;\n            s_axil_rresp <= 0;\n            s_axil_rvalid <= 0;\n            s2m_awaddr_reg <= 0;\n            s2m_awprot_reg <= 0;\n            s2m_awvalid_reg <= 0;\n            s2m_wdata_reg <= 0;\n            s2m_wstrb_reg <= 0;\n            s2m_wvalid_reg <= 0;\n            s2m_araddr_reg <= 0;\n            s2m_arprot_reg <= 0;\n            s2m_arvalid_reg <= 0;\n            s_awvalid_meta <= 0;\n            s_wvalid_meta <= 0;\n            s_arvalid_meta <= 0;\n        end else begin\n            // AW channel\n            s_axil_awready <= ~s2m_awvalid_reg;\n            if (s_axil_awvalid && ~s2m_awvalid_reg) begin\n                s2m_awaddr_reg <= s_axil_awaddr;\n                s2m_awprot_reg <= s_axil_awprot;\n                s2m_awvalid_reg <= 1;\n            end\n            if (s_awvalid_sync[1] && ~s_awvalid_sync[0]) begin\n                s2m_awvalid_reg <= 0;\n            end\n\n            // W channel\n            s_axil_wready <= ~s2m_wvalid_reg;\n            if (s_axil_wvalid && ~s2m_wvalid_reg) begin\n                s2m_wdata_reg <= s_axil_wdata;\n                s2m_wstrb_reg <= s_axil_wstrb;\n                s2m_wvalid_reg <= 1;\n            end\n            if (s_wvalid_sync[1] && ~s_wvalid_sync[0]) begin\n                s2m_wvalid_reg <= 0;\n            end\n\n            // AR channel\n            s_axil_arready <= ~s2m_arvalid_reg;\n            if (s_axil_arvalid && ~s2m_arvalid_reg) begin\n                s2m_araddr_reg <= s_axil_araddr;\n                s2m_arprot_reg <= s_axil_arprot;\n                s2m_arvalid_reg <= 1;\n            end\n            if (s_arvalid_sync[1] && ~s_arvalid_sync[0]) begin\n                s2m_arvalid_reg <= 0;\n            end\n\n            // B channel\n            if (m_bvalid_sync[1] && ~m_bvalid_sync[0]) begin\n                s_axil_bresp <= m2s_bresp_reg;\n                s_axil_bvalid <= 1;\n            end\n            if (s_axil_bready && s_axil_bvalid) begin\n                s_axil_bvalid <= 0;\n            end\n\n            // R channel\n            if (m_rvalid_sync[1] && ~m_rvalid_sync[0]) begin\n                s_axil_rdata <= m2s_rdata_reg;\n                s_axil_rresp <= m2s_rresp_reg;\n                s_axil_rvalid <= 1;\n            end\n            if (s_axil_rready && s_axil_rvalid) begin\n                s_axil_rvalid <= 0;\n            end\n\n            // Cross-domain synchronization for AW, W, AR valid signals\n            s_awvalid_meta <= {s_awvalid_meta[0], s2m_awvalid_reg};\n            s_wvalid_meta <= {s_wvalid_meta[0], s2m_wvalid_reg};\n            s_arvalid_meta <= {s_arvalid_meta[0], s2m_arvalid_reg};\n        end\n    end\n\n    // Master side\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_axil_awaddr <= 0;\n            m_axil_awprot <= 0;\n            m_axil_awvalid <= 0;\n            m_axil_wdata <= 0;\n            m_axil_wstrb <= 0;\n            m_axil_wvalid <= 0;\n            m_axil_araddr <= 0;\n            m_axil_arprot <= 0;\n            m_axil_arvalid <= 0;\n            m_axil_bready <= 0;\n            m_axil_rready <= 0;\n            m2s_bresp_reg <= 0;\n            m2s_bvalid_reg <= 0;\n            m2s_rdata_reg <= 0;\n            m2s_rresp_reg <= 0;\n            m2s_rvalid_reg <= 0;\n            m_bvalid_meta <= 0;\n            m_rvalid_meta <= 0;\n        end else begin\n            // AW channel\n            m_axil_awaddr <= s2m_awaddr_reg;\n            m_axil_awprot <= s2m_awprot_reg;\n            m_axil_awvalid <= s2m_awvalid_reg;\n            if (m_axil_awready && m_axil_awvalid) begin\n                m_axil_awvalid <= 0;\n            end\n\n            // W channel\n            m_axil_wdata <= s2m_wdata_reg;\n            m_axil_wstrb <= s2m_wstrb_reg;\n            m_axil_wvalid <= s2m_wvalid_reg;\n            if (m_axil_wready && m_axil_wvalid) begin\n                m_axil_wvalid <= 0;\n            end\n\n            // AR channel\n            m_axil_araddr <= s2m_araddr_reg;\n            m_axil_arprot <= s2m_arprot_reg;\n            m_axil_arvalid <= s2m_arvalid_reg;\n            if (m_axil_arready && m_axil_arvalid) begin\n                m_axil_arvalid <= 0;\n            end\n\n            // B channel\n            m_axil_bready <= m2s_bvalid_reg ? 0 : 1;\n            if (m_axil_bvalid && ~m2s_bvalid_reg) begin\n                m2s_bresp_reg <= m_axil_bresp;\n                m2s_bvalid_reg <= 1;\n            end\n            if (m_bvalid_sync[1] && ~m_bvalid_sync[0]) begin\n                m2s_bvalid_reg <= 0;\n            end\n\n            // R channel\n            m_axil_rready <= m2s_rvalid_reg ? 0 : 1;\n            if (m_axil_rvalid && ~m2s_rvalid_reg) begin\n                m2s_rdata_reg <= m_axil_rdata;\n                m2s_rresp_reg <= m_axil_rresp;\n                m2s_rvalid_reg <= 1;\n            end\n            if (m_rvalid_sync[1] && ~m_rvalid_sync[0]) begin\n                m2s_rvalid_reg <= 0;\n            end\n\n            // Cross-domain synchronization for B, R valid signals\n            m_bvalid_meta <= {m_bvalid_meta[0], m_axil_bvalid};\n            m_rvalid_meta <= {m_rvalid_meta[0], m_axil_rvalid};\n        end\n    end\n\n    // Cross-domain synchronization for AW, W, AR valid signals\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_awvalid_sync <= 0;\n            s_wvalid_sync <= 0;\n            s_arvalid_sync <= 0;\n        end else begin\n            s_awvalid_sync <= s_awvalid_meta;\n            s_wvalid_sync <= s_wvalid_meta;\n            s_arvalid_sync <= s_arvalid_meta;\n        end\n    end\n\n    // Cross-domain synchronization for B, R valid signals\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            m_bvalid_sync <= 0;\n            m_rvalid_sync <= 0;\n        end else begin\n            m_bvalid_sync <= m_bvalid_meta;\n            m_rvalid_sync <= m_rvalid_meta;\n        end\n    end\n\nendmodule\n```<|im_end|>",
