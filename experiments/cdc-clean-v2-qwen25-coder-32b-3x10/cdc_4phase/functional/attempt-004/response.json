  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic [WIDTH-1:0] src_data_sync [3:0];\n  logic [1:0] src_phase;\n  logic src_valid_sync;\n\n  // Destination domain signals\n  logic [WIDTH-1:0] dst_data_sync [3:0];\n  logic [1:0] dst_phase;\n  logic dst_valid_sync;\n\n  // Source domain logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_phase <= 2'b00;\n      src_valid_sync <= 1'b0;\n    end else begin\n      src_phase <= src_phase + 1'b1;\n      if (src_valid_i && src_ready_o) begin\n        src_data_sync[src_phase] <= src_data_i;\n        src_valid_sync <= 1'b1;\n      end else if (dst_valid_sync) begin\n        src_valid_sync <= 1'b0;\n      end\n    end\n  end\n\n  // Destination domain logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_phase <= 2'b00;\n      dst_valid_sync <= 1'b0;\n      dst_data_o <= SEND_RESET_MSG ? RESET_MSG : {WIDTH{1'b0}};\n      dst_valid_o <= SEND_RESET_MSG;\n    end else begin\n      dst_phase <= dst_phase + 1'b1;\n      if (dst_valid_sync && dst_ready_i) begin\n        dst_valid_sync <= 1'b0;\n      end else if (src_valid_sync) begin\n        dst_data_o <= src_data_sync[dst_phase];\n        dst_valid_sync <= 1'b1;\n      end\n    end\n  end\n\n  // Source ready signal\n  always_comb begin\n    if (DECOUPLED) begin\n      src_ready_o = ~src_valid_sync;\n    end else begin\n      src_ready_o = ~src_valid_sync && ~dst_valid_sync;\n    end\n  end\n\nendmodule\n```<|im_end|>",
