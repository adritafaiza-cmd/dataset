  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n  logic src_ready;\n  logic [1:0] src_phase;\n\n  // Destination domain signals\n  logic [WIDTH-1:0] dst_data_sync;\n  logic dst_valid;\n  logic [1:0] dst_phase;\n\n  // Synchronization FIFO\n  logic [WIDTH-1:0] fifo [3:0];\n  logic [1:0] fifo_wr_ptr;\n  logic [1:0] fifo_rd_ptr;\n  logic fifo_full;\n  logic fifo_empty;\n\n  // Source domain logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_phase <= 2'b00;\n      src_valid_sync <= 1'b0;\n      src_data_sync <= {WIDTH{1'b0}};\n    end else begin\n      src_phase <= src_phase + 1'b1;\n      if (src_valid_i && src_ready) begin\n        src_valid_sync <= 1'b1;\n        src_data_sync <= src_data_i;\n      end else if (fifo_full) begin\n        src_valid_sync <= 1'b0;\n      end\n    end\n  end\n\n  // Cross-domain synchronization for src_valid_sync and src_data_sync\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_phase <= 2'b00;\n      dst_valid <= 1'b0;\n      dst_data_sync <= {WIDTH{1'b0}};\n    end else begin\n      dst_phase <= dst_phase + 1'b1;\n      if (dst_phase != src_phase) begin\n        dst_valid <= src_valid_sync;\n        dst_data_sync <= src_data_sync;\n      end\n    end\n  end\n\n  // FIFO write logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      fifo_wr_ptr <= 2'b00;\n      fifo_full <= 1'b0;\n    end else begin\n      if (dst_valid && !fifo_full) begin\n        fifo[fifo_wr_ptr] <= dst_data_sync;\n        fifo_wr_ptr <= fifo_wr_ptr + 1'b1;\n        fifo_full <= (fifo_wr_ptr == fifo_rd_ptr);\n      end\n    end\n  end\n\n  // FIFO read logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      fifo_rd_ptr <= 2'b00;\n      fifo_empty <= 1'b1;\n      dst_data_o <= SEND_RESET_MSG ? RESET_MSG : {WIDTH{1'b0}};\n      dst_valid_o <= SEND_RESET_MSG;\n    end else begin\n      if (dst_ready_i && !fifo_empty) begin\n        fifo_rd_ptr <= fifo_rd_ptr + 1'b1;\n        fifo_empty <= (fifo_wr_ptr == fifo_rd_ptr);\n      end\n      if (!fifo_empty) begin\n        dst_data_o <= fifo[fifo_rd_ptr];\n        dst_valid_o <= 1'b1;\n      end else if (SEND_RESET_MSG) begin\n        dst_data_o <= RESET_MSG;\n        dst_valid_o <= 1'b1;\n      end else begin\n        dst_valid_o <= 1'b0;\n      end\n    end\n  end\n\n  // Source ready logic\n  always_comb begin\n    if (DECOUPLED) begin\n      src_ready = !fifo_full;\n    end else begin\n      src_ready = !fifo_full && (!dst_valid_o || dst_ready_i);\n    end\n  end\n\n  assign src_ready_o = src_ready;\n\nendmodule\n```<|im_end|>",
