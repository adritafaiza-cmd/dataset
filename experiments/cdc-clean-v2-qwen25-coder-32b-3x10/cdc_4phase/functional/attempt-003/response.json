  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n  logic src_ready_sync;\n\n  // Destination domain signals\n  logic [WIDTH-1:0] dst_data_sync;\n  logic dst_valid_sync;\n  logic dst_ready_sync;\n\n  // Synchronization FIFO\n  logic [WIDTH-1:0] fifo [3:0];\n  logic [1:0] wr_ptr, rd_ptr;\n  logic wr_en, rd_en;\n  logic fifo_full, fifo_empty;\n\n  // Source domain\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ready_o <= 1'b0;\n      src_data_sync <= RESET_MSG;\n      src_valid_sync <= SEND_RESET_MSG;\n    end else begin\n      if (wr_en && !fifo_full) begin\n        fifo[wr_ptr] <= src_data_i;\n        src_ready_o <= DECOUPLED || fifo_empty;\n      end else begin\n        src_ready_o <= DECOUPLED || fifo_empty;\n      end\n      src_data_sync <= fifo[wr_ptr];\n      src_valid_sync <= !fifo_empty;\n    end\n  end\n\n  // Destination domain\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_o <= RESET_MSG;\n      dst_valid_o <= SEND_RESET_MSG;\n      dst_ready_sync <= 1'b0;\n    end else begin\n      if (rd_en && !fifo_empty) begin\n        dst_data_o <= fifo[rd_ptr];\n        dst_valid_o <= 1'b1;\n      end else if (dst_ready_i) begin\n        dst_valid_o <= 1'b0;\n      end\n      dst_ready_sync <= dst_ready_i;\n    end\n  end\n\n  // Write pointer logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      wr_ptr <= 2'b00;\n    end else if (wr_en && !fifo_full) begin\n      wr_ptr <= wr_ptr + 1'b1;\n    end\n  end\n\n  // Read pointer logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      rd_ptr <= 2'b00;\n    end else if (rd_en && !fifo_empty) begin\n      rd_ptr <= rd_ptr + 1'b1;\n    end\n  end\n\n  // FIFO full and empty flags\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      fifo_full <= 1'b0;\n      fifo_empty <= 1'b1;\n    end else begin\n      if (wr_en && !fifo_full && (wr_ptr == rd_ptr - 1)) begin\n        fifo_full <= 1'b1;\n        fifo_empty <= 1'b0;\n      end else if (rd_en && !fifo_empty && (wr_ptr == rd_ptr)) begin\n        fifo_full <= 1'b0;\n        fifo_empty <= 1'b1;\n      end else if (wr_en && !fifo_full) begin\n        fifo_empty <= 1'b0;\n      end else if (rd_en && !fifo_empty) begin\n        fifo_full <= 1'b0;\n      end\n    end\n  end\n\n  // Write enable logic\n  assign wr_en = src_valid_i && src_ready_o;\n\n  // Read enable logic\n  assign rd_en = dst_valid_o && dst_ready_i;\n\nendmodule\n```<|im_end|>",
