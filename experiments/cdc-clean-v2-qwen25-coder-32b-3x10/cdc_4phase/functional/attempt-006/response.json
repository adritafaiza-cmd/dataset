  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic [WIDTH-1:0] src_data_reg;\n  logic src_valid_reg;\n  logic src_ready_reg;\n\n  // Destination domain signals\n  logic [WIDTH-1:0] dst_data_reg [3:0];\n  logic dst_valid_reg [3:0];\n  logic [1:0] phase;\n\n  // Source domain logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg <= RESET_MSG;\n      src_valid_reg <= SEND_RESET_MSG;\n      src_ready_reg <= 1'b0;\n    end else begin\n      if (src_ready_reg && src_valid_i) begin\n        src_data_reg <= src_data_i;\n        src_valid_reg <= 1'b1;\n      end else if (dst_valid_reg[3]) begin\n        src_valid_reg <= 1'b0;\n      end\n      src_ready_reg <= DECOUPLED || !src_valid_reg;\n    end\n  end\n\n  assign src_ready_o = src_ready_reg;\n\n  // Cross-domain phase logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      phase <= 2'b00;\n    end else begin\n      phase <= phase + 1'b1;\n    end\n  end\n\n  // Destination domain logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg <= '{default: RESET_MSG};\n      dst_valid_reg <= '{default: SEND_RESET_MSG};\n    end else begin\n      // Shift data and valid signals through the pipeline\n      dst_data_reg[0] <= src_data_reg;\n      dst_valid_reg[0] <= src_valid_reg;\n      dst_data_reg[1] <= dst_data_reg[0];\n      dst_valid_reg[1] <= dst_valid_reg[0];\n      dst_data_reg[2] <= dst_data_reg[1];\n      dst_valid_reg[2] <= dst_valid_reg[1];\n      dst_data_reg[3] <= dst_data_reg[2];\n      dst_valid_reg[3] <= dst_valid_reg[2];\n\n      // Clear valid signal when acknowledged\n      if (dst_valid_reg[3] && dst_ready_i) begin\n        dst_valid_reg[3] <= 1'b0;\n      end\n    end\n  end\n\n  assign dst_data_o = dst_data_reg[3];\n  assign dst_valid_o = dst_valid_reg[3];\n\nendmodule\n```<|im_end|>",
