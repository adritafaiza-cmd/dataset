  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side signals\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n  logic src_ready_sync;\n\n  // Destination side signals\n  logic [WIDTH-1:0] dst_data_sync;\n  logic dst_valid_sync;\n  logic dst_ready_sync;\n\n  // Four-phase handshake signals\n  logic [1:0] src_phase;\n  logic [1:0] dst_phase;\n\n  // Synchronization registers\n  logic [WIDTH-1:0] sync_data [3:0];\n  logic sync_valid [3:0];\n  logic sync_ready [3:0];\n\n  // Source side logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_phase <= 2'b00;\n      src_data_sync <= RESET_MSG;\n      src_valid_sync <= SEND_RESET_MSG;\n      src_ready_sync <= 1'b0;\n    end else begin\n      // Update phase\n      if (src_valid_i && src_ready_o) begin\n        src_phase <= src_phase + 1;\n      end\n\n      // Synchronize data and valid\n      sync_data[src_phase] <= src_data_i;\n      sync_valid[src_phase] <= src_valid_i;\n\n      // Update source ready\n      src_ready_sync <= sync_ready[src_phase];\n    end\n  end\n\n  // Destination side logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_phase <= 2'b00;\n      dst_data_sync <= RESET_MSG;\n      dst_valid_sync <= SEND_RESET_MSG;\n      dst_ready_sync <= 1'b0;\n    end else begin\n      // Update phase\n      if (dst_valid_o && dst_ready_i) begin\n        dst_phase <= dst_phase + 1;\n      end\n\n      // Synchronize data and valid\n      dst_data_sync <= sync_data[dst_phase];\n      dst_valid_sync <= sync_valid[dst_phase];\n\n      // Update destination ready\n      dst_ready_sync <= sync_ready[dst_phase];\n    end\n  end\n\n  // Cross-domain ready signals\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      sync_ready[dst_phase] <= 1'b0;\n    end else begin\n      sync_ready[dst_phase] <= dst_ready_sync;\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      sync_ready[src_phase] <= 1'b0;\n    end else begin\n      sync_ready[src_phase] <= src_ready_sync;\n    end\n  end\n\n  // Output assignments\n  assign src_ready_o = src_ready_sync;\n  assign dst_data_o = dst_data_sync;\n  assign dst_valid_o = dst_valid_sync;\n\nendmodule\n```<|im_end|>",
