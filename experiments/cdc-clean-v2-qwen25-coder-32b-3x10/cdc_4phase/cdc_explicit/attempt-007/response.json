  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic [WIDTH-1:0] src_data_sync;\n  logic src_valid_sync;\n  logic src_ready;\n\n  // Destination domain signals\n  logic [WIDTH-1:0] dst_data_reg [3:0];\n  logic dst_valid_reg [3:0];\n  logic dst_ready_sync;\n\n  // Synchronization flops for src_valid_i and src_data_i\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_sync <= RESET_MSG;\n      src_valid_sync <= 1'b0;\n    end else begin\n      src_data_sync <= src_data_i;\n      src_valid_sync <= src_valid_i;\n    end\n  end\n\n  // Synchronization flop for dst_ready_i\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_ready_sync <= 1'b0;\n    end else begin\n      dst_ready_sync <= dst_ready_i;\n    end\n  end\n\n  // Shift register for data and valid signals\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      for (int i = 0; i < 4; i = i + 1) begin\n        dst_data_reg[i] <= RESET_MSG;\n        dst_valid_reg[i] <= 1'b0;\n      end\n    end else begin\n      dst_data_reg[0] <= src_data_sync;\n      dst_valid_reg[0] <= src_valid_sync;\n      for (int i = 1; i < 4; i = i + 1) begin\n        dst_data_reg[i] <= dst_data_reg[i-1];\n        dst_valid_reg[i] <= dst_valid_reg[i-1];\n      end\n    end\n  end\n\n  // Output assignments\n  assign dst_data_o = dst_data_reg[3];\n  assign dst_valid_o = dst_valid_reg[3] & ~dst_ready_sync;\n\n  // Source ready signal\n  assign src_ready = dst_ready_sync | ~dst_valid_reg[3];\n  assign src_ready_o = DECOUPLED ? src_ready : (src_ready & ~dst_valid_reg[2]);\n\nendmodule\n```<|im_end|>",
