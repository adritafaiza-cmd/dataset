{
  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 2**ADDR_WIDTH;\n    localparam AW = ADDR_WIDTH + 1;\n\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    reg [AW-1:0] wptr, rptr;\n    reg [AW-1:0] wptr_gray, rptr_gray;\n    reg [AW-1:0] rptr_gray_sync [0:SYNC_STAGES-1];\n\n    // Write side logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= 0;\n            wptr_gray <= 0;\n        end else if (winc && !wfull) begin\n            wptr <= wptr + 1;\n            wptr_gray <= (wptr + 1) ^ ((wptr + 1) >> 1);\n        end\n    end\n\n    // Read side logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= 0;\n            rptr_gray <= 0;\n        end else if (rinc && !rempty) begin\n            rptr <= rptr + 1;\n            rptr_gray <= (rptr + 1) ^ ((rptr + 1) >> 1);\n        end\n    end\n\n    // Synchronize read pointer to write clock domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_sync[0] <= 0;\n        end else begin\n            rptr_gray_sync[0] <= rptr_gray;\n        end\n    end\n\n    generate\n        if (SYNC_STAGES > 1) begin\n            genvar i;\n            for (i = 1; i < SYNC_STAGES; i = i + 1) begin\n                always @(posedge wclk or negedge wrst_n) begin\n                    if (!wrst_n) begin\n                        rptr_gray_sync[i] <= 0;\n                    end else begin\n                        rptr_gray_sync[i] <= rptr_gray_sync[i-1];\n                    end\n                end\n            end\n        end\n    endgenerate\n\n    // Calculate full flag\n    wire [AW-1:0] rptr_bin_sync;\n    assign rptr_bin_sync = {rptr_gray_sync[SYNC_STAGES-1][AW-1], rptr_gray_sync[SYNC_STAGES-1][AW-2:0] ^ (rptr_gray_sync[SYNC_STAGES-1][AW-1:1] >> 1)};\n    assign wfull = (wptr_gray[AW-1:AW-ADDR_WIDTH] == {~rptr_bin_sync[AW-1:AW-ADDR_WIDTH], rptr_bin_sync[AW-ADDR_WIDTH-1:0]});\n\n    // Write data to memory\n    always @(posedge wclk) begin\n        if (winc && !wfull) begin\n            mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n        end\n    end\n\n    // Synchronize write pointer to read clock domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_sync[0] <= 0;\n        end else begin\n            wptr_gray_sync[0] <= wptr_gray;\n        end\n    end\n\n    generate\n        if (SYNC_STAGES > 1) begin\n            genvar i;\n            for (i = 1; i < SYNC_STAGES; i = i + 1) begin\n                always @(posedge rclk or negedge rrst_n) begin\n                    if (!rrst_n) begin\n                        wptr_gray_sync[i] <= 0;\n                    end else begin\n                        wptr_gray_sync[i] <= wptr_gray_sync[i-1];\n                    end\n                end\n            end\n        end\n    endgenerate\n\n    // Calculate empty flag\n    wire [AW-1:0] wptr_bin_sync;\n    assign wptr_bin_sync = {wptr_gray_sync[SYNC_STAGES-1][AW-1], wptr_gray_sync[SYNC_STAGES-1][AW-2:0] ^ (wptr_gray_sync[SYNC_STAGES-1][AW-1:1] >> 1)};\n    assign rempty = (rptr_gray[AW-1:AW-ADDR_WIDTH] == {~wptr_bin_sync[AW-1:AW-ADDR_WIDTH], wptr_bin_sync[AW-ADDR_WIDTH-1:0]});\n\n    // Read data from memory\n    always @(posedge rclk) begin\n        if (rinc && !rempty) begin\n            rdata <= mem[rptr[ADDR_WIDTH-1:0]];\n        end\n    end\n\n    // Assign address outputs\n    assign waddr = wptr;\n    assign raddr = rptr;\n\nendmodule\n```<|im_end|>",
