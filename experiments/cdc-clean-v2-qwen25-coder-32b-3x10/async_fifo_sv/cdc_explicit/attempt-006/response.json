{
  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 2**ADDR_WIDTH;\n    localparam ADDR_MSB = ADDR_WIDTH;\n\n    // Write and read pointers\n    reg [ADDR_MSB:0] wptr, rptr;\n    reg [ADDR_MSB:0] wptr_gray, rptr_gray;\n    reg [ADDR_MSB:0] wptr_gray_sync [SYNC_STAGES-1:0];\n    reg [ADDR_MSB:0] rptr_gray_sync [SYNC_STAGES-1:0];\n\n    // Memory array\n    reg [DATA_WIDTH-1:0] mem [DEPTH-1:0];\n\n    // Gray code conversion functions\n    function [ADDR_MSB:0] bin_to_gray;\n        input [ADDR_MSB:0] bin;\n        bin_to_gray = bin ^ (bin >> 1);\n    endfunction\n\n    function [ADDR_MSB:0] gray_to_bin;\n        input [ADDR_MSB:0] gray;\n        integer i;\n        reg [ADDR_MSB:0] bin;\n        bin = gray;\n        for (i = ADDR_MSB-1; i >= 0; i = i - 1) begin\n            bin[i] = bin[i+1] ^ gray[i];\n        end\n        gray_to_bin = bin;\n    endfunction\n\n    // Write domain logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= 0;\n            wptr_gray <= 0;\n        end else if (winc && !wfull) begin\n            wptr <= wptr + 1;\n            wptr_gray <= bin_to_gray(wptr + 1);\n        end\n    end\n\n    // Read domain logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= 0;\n            rptr_gray <= 0;\n        end else if (rinc && !rempty) begin\n            rptr <= rptr + 1;\n            rptr_gray <= bin_to_gray(rptr + 1);\n        end\n    end\n\n    // Synchronize write pointer to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_sync <= '{default: 0};\n        end else begin\n            wptr_gray_sync[0] <= wptr_gray;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1) begin\n                wptr_gray_sync[i] <= wptr_gray_sync[i-1];\n            end\n        end\n    end\n\n    // Synchronize read pointer to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_sync <= '{default: 0};\n        end else begin\n            rptr_gray_sync[0] <= rptr_gray;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1) begin\n                rptr_gray_sync[i] <= rptr_gray_sync[i-1];\n            end\n        end\n    end\n\n    // Calculate full and empty flags\n    wire [ADDR_MSB:0] wptr_gray_sync_last = wptr_gray_sync[SYNC_STAGES-1];\n    wire [ADDR_MSB:0] rptr_gray_sync_last = rptr_gray_sync[SYNC_STAGES-1];\n    wire [ADDR_MSB:0] wptr_sync = gray_to_bin(wptr_gray_sync_last);\n    wire [ADDR_MSB:0] rptr_sync = gray_to_bin(rptr_gray_sync_last);\n\n    assign wfull = (wptr_sync[ADDR_MSB-1:0] == rptr_sync[ADDR_MSB-1:0]) && (wptr_sync[ADDR_MSB] != rptr_sync[ADDR_MSB]);\n    assign rempty = (wptr_sync == rptr_sync);\n\n    // Write data to memory\n    always @(posedge wclk) begin\n        if (winc && !wfull) begin\n            mem[wptr[ADDR_MSB-1:0]] <= wdata;\n        end\n    end\n\n    // Read data from memory\n    always @(posedge rclk) begin\n        if (rinc && !rempty) begin\n            rdata <= mem[rptr[ADDR_MSB-1:0]];\n        end\n    end\n\n    // Debug outputs\n    assign waddr = wptr;\n    assign raddr = rptr;\n\nendmodule\n```<|im_end|>",
