{
  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 2**ADDR_WIDTH;\n    localparam ADDR_WIDTH_PLUS1 = ADDR_WIDTH + 1;\n\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    reg [ADDR_WIDTH_PLUS1:0] wptr_gray, wptr_gray_next, wptr_gray_reg;\n    reg [ADDR_WIDTH_PLUS1:0] rptr_gray, rptr_gray_next, rptr_gray_reg;\n\n    reg [ADDR_WIDTH_PLUS1:0] wptr_bin, wptr_bin_next;\n    reg [ADDR_WIDTH_PLUS1:0] rptr_bin, rptr_bin_next;\n\n    reg [ADDR_WIDTH_PLUS1:0] wptr_gray_sync [0:SYNC_STAGES-1];\n    reg [ADDR_WIDTH_PLUS1:0] rptr_gray_sync [0:SYNC_STAGES-1];\n\n    // Write domain logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr_gray <= 0;\n            wptr_gray_reg <= 0;\n        end else begin\n            wptr_gray <= wptr_gray_next;\n            wptr_gray_reg <= wptr_gray_next;\n        end\n    end\n\n    always @(*) begin\n        wptr_bin_next = wptr_gray ^ (wptr_gray >> 1);\n        if (winc && !wfull)\n            wptr_gray_next = wptr_gray + 1;\n        else\n            wptr_gray_next = wptr_gray;\n    end\n\n    assign waddr = wptr_bin_next[ADDR_WIDTH:0];\n\n    // Read domain logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr_gray <= 0;\n            rptr_gray_reg <= 0;\n        end else begin\n            rptr_gray <= rptr_gray_next;\n            rptr_gray_reg <= rptr_gray_next;\n        end\n    end\n\n    always @(*) begin\n        rptr_bin_next = rptr_gray ^ (rptr_gray >> 1);\n        if (rinc && !rempty)\n            rptr_gray_next = rptr_gray + 1;\n        else\n            rptr_gray_next = rptr_gray;\n    end\n\n    assign raddr = rptr_bin_next[ADDR_WIDTH:0];\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (winc && !wfull)\n            mem[wptr_bin_next[ADDR_WIDTH-1:0]] <= wdata;\n    end\n\n    // Memory read\n    always @(posedge rclk) begin\n        if (rinc && !rempty)\n            rdata <= mem[rptr_bin_next[ADDR_WIDTH-1:0]];\n    end\n\n    // Gray code synchronization\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            for (int i = 0; i < SYNC_STAGES; i = i + 1)\n                wptr_gray_sync[i] <= 0;\n        end else begin\n            wptr_gray_sync[0] <= rptr_gray_reg;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                wptr_gray_sync[i] <= wptr_gray_sync[i-1];\n        end\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            for (int i = 0; i < SYNC_STAGES; i = i + 1)\n                rptr_gray_sync[i] <= 0;\n        end else begin\n            rptr_gray_sync[0] <= wptr_gray_reg;\n            for (int i = 1; i < SYNC_STAGES; i = i + 1)\n                rptr_gray_sync[i] <= rptr_gray_sync[i-1];\n        end\n    end\n\n    // Full and empty flags\n    assign wptr_bin = wptr_gray ^ (wptr_gray >> 1);\n    assign rptr_bin = rptr_gray_sync[SYNC_STAGES-1] ^ (rptr_gray_sync[SYNC_STAGES-1] >> 1);\n\n    assign wfull = (wptr_bin[ADDR_WIDTH_PLUS1:0] == {~rptr_bin[ADDR_WIDTH_PLUS1], rptr_bin[ADDR_WIDTH:0]});\n    assign rempty = (wptr_bin[ADDR_WIDTH_PLUS1:0] == rptr_bin[ADDR_WIDTH_PLUS1:0]);\n\nendmodule\n```<|im_end|>",
