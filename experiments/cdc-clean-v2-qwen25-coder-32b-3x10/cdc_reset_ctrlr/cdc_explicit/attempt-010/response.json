  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // Internal signals\n    reg [SYNC_STAGES-1:0] a_clear_sync;\n    reg [SYNC_STAGES-1:0] b_clear_sync;\n    reg [SYNC_STAGES-1:0] a_isolate_sync;\n    reg [SYNC_STAGES-1:0] b_isolate_sync;\n\n    reg a_isolate_req;\n    reg a_clear_req;\n    reg a_isolate_done;\n    reg a_clear_done;\n    reg a_release_req;\n    reg a_release_done;\n\n    reg b_isolate_req;\n    reg b_clear_req;\n    reg b_isolate_done;\n    reg b_clear_done;\n    reg b_release_req;\n    reg b_release_done;\n\n    // Synchronize clear requests from B domain to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_clear_sync <= {a_clear_sync[SYNC_STAGES-2:0], b_clear_i};\n        end\n    end\n\n    // Synchronize clear requests from A domain to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_clear_sync <= {b_clear_sync[SYNC_STAGES-2:0], a_clear_i};\n        end\n    end\n\n    // Synchronize isolate acks from B domain to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_isolate_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_isolate_sync <= {a_isolate_sync[SYNC_STAGES-2:0], b_isolate_ack_i};\n        end\n    end\n\n    // Synchronize isolate acks from A domain to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_isolate_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_isolate_sync <= {b_isolate_sync[SYNC_STAGES-2:0], a_isolate_ack_i};\n        end\n    end\n\n    // A domain state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_isolate_req <= 1'b0;\n            a_clear_req <= 1'b0;\n            a_isolate_done <= 1'b0;\n            a_clear_done <= 1'b0;\n            a_release_req <= 1'b0;\n            a_release_done <= 1'b0;\n        end else begin\n            case ({a_isolate_req, a_isolate_done, a_clear_req, a_clear_done, a_release_req, a_release_done})\n                6'b000000: begin // IDLE\n                    if (a_clear_sync[SYNC_STAGES-1]) begin\n                        a_isolate_req <= 1'b1;\n                    end\n                end\n                6'b100000: begin // ISOLATE_REQUESTED\n                    a_isolate_o <= 1'b1;\n                    if (a_isolate_sync[SYNC_STAGES-1]) begin\n                        a_isolate_req <= 1'b0;\n                        a_isolate_done <= 1'b1;\n                    end\n                end\n                6'b010000: begin // ISOLATE_DONE\n                    a_clear_req <= 1'b1;\n                end\n                6'b011000: begin // CLEAR_REQUESTED\n                    a_clear_o <= 1'b1;\n                    if (a_clear_ack_i) begin\n                        a_clear_req <= 1'b0;\n                        a_clear_done <= 1'b1;\n                    end\n                end\n                6'b011100: begin // CLEAR_DONE\n                    a_release_req <= 1'b1;\n                end\n                6'b011110: begin // RELEASE_REQUESTED\n                    a_isolate_o <= 1'b0;\n                    a_clear_o <= 1'b0;\n                    if (b_isolate_sync[SYNC_STAGES-1]) begin\n                        a_release_req <= 1'b0;\n                        a_release_done <= 1'b1;\n                    end\n                end\n                6'b011111: begin // RELEASE_DONE\n                    a_release_done <= 1'b0;\n                end\n                default: begin\n                    a_isolate_req <= 1'b0;\n                    a_clear_req <= 1'b0;\n                    a_isolate_done <= 1'b0;\n                    a_clear_done <= 1'b0;\n                    a_release_req <= 1'b0;\n                    a_release_done <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // B domain state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_isolate_req <= 1'b0;\n            b_clear_req <= 1'b0;\n            b_isolate_done <= 1'b0;\n            b_clear_done <= 1'b0;\n            b_release_req <= 1'b0;\n            b_release_done <= 1'b0;\n        end else begin\n            case ({b_isolate_req, b_isolate_done, b_clear_req, b_clear_done, b_release_req, b_release_done})\n                6'b000000: begin // IDLE\n                    if (b_clear_sync[SYNC_STAGES-1]) begin\n                        b_isolate_req <= 1'b1;\n                    end\n                end\n                6'b100000: begin // ISOLATE_REQUESTED\n                    b_isolate_o <= 1'b1;\n                    if (b_isolate_sync[SYNC_STAGES-1]) begin\n                        b_isolate_req <= 1'b0;\n                        b_isolate_done <= 1'b1;\n                    end\n                end\n                6'b010000: begin // ISOLATE_DONE\n                    b_clear_req <= 1'b1;\n                end\n                6'b011000: begin // CLEAR_REQUESTED\n                    b_clear_o <= 1'b1;\n                    if (b_clear_ack_i) begin\n                        b_clear_req <= 1'b0;\n                        b_clear_done <= 1'b1;\n                    end\n                end\n                6'b011100: begin // CLEAR_DONE\n                    b_release_req <= 1'b1;\n                end\n                6'b011110: begin // RELEASE_REQUESTED\n                    b_isolate_o <= 1'b0;\n                    b_clear_o <= 1'b0;\n                    if (a_isolate_sync[SYNC_STAGES-1]) begin\n                        b_release_req <= 1'b0;\n                        b_release_done <= 1'b1;\n                    end\n                end\n                6'b011111: begin // RELEASE_DONE\n                    b_release_done <= 1'b0;\n                end\n                default: begin\n                    b_isolate_req <= 1'b0;\n                    b_clear_req <= 1'b0;\n                    b_isolate_done <= 1'b0;\n                    b_clear_done <= 1'b0;\n                    b_release_req <= 1'b0;\n                    b_release_done <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
