  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // Internal signals\n    reg [SYNC_STAGES-1:0] a_clear_sync;\n    reg [SYNC_STAGES-1:0] b_clear_sync;\n    reg [SYNC_STAGES-1:0] a_isolate_sync;\n    reg [SYNC_STAGES-1:0] b_isolate_sync;\n\n    reg a_isolate_req;\n    reg b_isolate_req;\n    reg a_clear_req;\n    reg b_clear_req;\n\n    reg a_isolate;\n    reg a_clear;\n    reg a_released;\n\n    reg b_isolate;\n    reg b_clear;\n    reg b_released;\n\n    // Synchronization flops for a_clear_i\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_clear_sync <= {a_clear_sync[SYNC_STAGES-2:0], a_clear_i};\n        end\n    end\n\n    // Synchronization flops for b_clear_i\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_clear_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_clear_sync <= {b_clear_sync[SYNC_STAGES-2:0], b_clear_i};\n        end\n    end\n\n    // Synchronization flops for a_isolate_o\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_isolate_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_isolate_sync <= {a_isolate_sync[SYNC_STAGES-2:0], a_isolate_o};\n        end\n    end\n\n    // Synchronization flops for b_isolate_o\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_isolate_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_isolate_sync <= {b_isolate_sync[SYNC_STAGES-2:0], b_isolate_o};\n        end\n    end\n\n    // FSM for A side\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_isolate_req <= 1'b0;\n            a_clear_req <= 1'b0;\n            a_isolate <= 1'b0;\n            a_clear <= 1'b0;\n            a_released <= 1'b0;\n        end else begin\n            case ({a_isolate_req, a_clear_req, a_isolate, a_clear, a_released, a_isolate_ack_i, a_clear_ack_i, b_isolate_sync[SYNC_STAGES-1]})\n                8'b00000000: begin // IDLE\n                    if (a_clear_sync[SYNC_STAGES-1]) begin\n                        a_isolate_req <= 1'b1;\n                    end\n                end\n                8'b10000000: begin // ISOLATE_REQUESTED\n                    a_isolate_o <= 1'b1;\n                    if (a_isolate_ack_i) begin\n                        a_isolate_req <= 1'b0;\n                        a_clear_req <= 1'b1;\n                    end\n                end\n                8'b01000000: begin // CLEAR_REQUESTED\n                    a_clear_o <= 1'b1;\n                    if (a_clear_ack_i) begin\n                        a_clear_req <= 1'b0;\n                    end\n                end\n                8'b00110000: begin // CLEAR_ACTIVE\n                    if (b_isolate_sync[SYNC_STAGES-1]) begin\n                        a_clear_o <= 1'b0;\n                        a_released <= 1'b1;\n                    end\n                end\n                8'b00101000: begin // RELEASE_REQUESTED\n                    a_isolate_o <= 1'b0;\n                    if (!a_isolate_o) begin\n                        a_released <= 1'b0;\n                    end\n                end\n                default: begin\n                    // Stay in current state\n                end\n            endcase\n        end\n    end\n\n    // FSM for B side\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_isolate_req <= 1'b0;\n            b_clear_req <= 1'b0;\n            b_isolate <= 1'b0;\n            b_clear <= 1'b0;\n            b_released <= 1'b0;\n        end else begin\n            case ({b_isolate_req, b_clear_req, b_isolate, b_clear, b_released, b_isolate_ack_i, b_clear_ack_i, a_isolate_sync[SYNC_STAGES-1]})\n                8'b00000000: begin // IDLE\n                    if (b_clear_sync[SYNC_STAGES-1]) begin\n                        b_isolate_req <= 1'b1;\n                    end\n                end\n                8'b10000000: begin // ISOLATE_REQUESTED\n                    b_isolate_o <= 1'b1;\n                    if (b_isolate_ack_i) begin\n                        b_isolate_req <= 1'b0;\n                        b_clear_req <= 1'b1;\n                    end\n                end\n                8'b01000000: begin // CLEAR_REQUESTED\n                    b_clear_o <= 1'b1;\n                    if (b_clear_ack_i) begin\n                        b_clear_req <= 1'b0;\n                    end\n                end\n                8'b00110000: begin // CLEAR_ACTIVE\n                    if (a_isolate_sync[SYNC_STAGES-1]) begin\n                        b_clear_o <= 1'b0;\n                        b_released <= 1'b1;\n                    end\n                end\n                8'b00101000: begin // RELEASE_REQUESTED\n                    b_isolate_o <= 1'b0;\n                    if (!b_isolate_o) begin\n                        b_released <= 1'b0;\n                    end\n                end\n                default: begin\n                    // Stay in current state\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
