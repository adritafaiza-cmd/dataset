  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // Local state for A domain\n    reg [1:0] a_state;\n    reg [1:0] a_next_state;\n    reg a_isolate_req;\n    reg a_clear_req;\n    reg a_clear_done;\n    reg a_isolate_done;\n\n    // Local state for B domain\n    reg [1:0] b_state;\n    reg [1:0] b_next_state;\n    reg b_isolate_req;\n    reg b_clear_req;\n    reg b_clear_done;\n    reg b_isolate_done;\n\n    // Synchronizers for A to B\n    reg [SYNC_STAGES-1:0] a_clear_sync;\n    reg [SYNC_STAGES-1:0] a_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] a_clear_ack_sync;\n\n    // Synchronizers for B to A\n    reg [SYNC_STAGES-1:0] b_clear_sync;\n    reg [SYNC_STAGES-1:0] b_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] b_clear_ack_sync;\n\n    // State machine for A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state <= 2'b00;\n            a_isolate_req <= 1'b0;\n            a_clear_req <= 1'b0;\n            a_clear_done <= 1'b0;\n            a_isolate_done <= 1'b0;\n        end else begin\n            a_state <= a_next_state;\n            a_isolate_req <= (a_state == 2'b00 && (a_clear_i || b_clear_sync[SYNC_STAGES-1]));\n            a_clear_req <= (a_state == 2'b01 && a_isolate_ack_sync[SYNC_STAGES-1]);\n            a_clear_done <= (a_state == 2'b10 && a_clear_ack_sync[SYNC_STAGES-1]);\n            a_isolate_done <= (a_state == 2'b11 && b_isolate_ack_sync[SYNC_STAGES-1]);\n        end\n    end\n\n    always @(*) begin\n        a_next_state = a_state;\n        case (a_state)\n            2'b00: if (a_isolate_ack_sync[SYNC_STAGES-1]) a_next_state = 2'b01;\n            2'b01: if (a_clear_ack_sync[SYNC_STAGES-1]) a_next_state = 2'b10;\n            2'b10: if (b_isolate_ack_sync[SYNC_STAGES-1]) a_next_state = 2'b11;\n            2'b11: if (a_isolate_ack_sync[SYNC_STAGES-1] && b_isolate_ack_sync[SYNC_STAGES-1]) a_next_state = 2'b00;\n        endcase\n    end\n\n    // State machine for B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state <= 2'b00;\n            b_isolate_req <= 1'b0;\n            b_clear_req <= 1'b0;\n            b_clear_done <= 1'b0;\n            b_isolate_done <= 1'b0;\n        end else begin\n            b_state <= b_next_state;\n            b_isolate_req <= (b_state == 2'b00 && (b_clear_i || a_clear_sync[SYNC_STAGES-1]));\n            b_clear_req <= (b_state == 2'b01 && b_isolate_ack_sync[SYNC_STAGES-1]);\n            b_clear_done <= (b_state == 2'b10 && b_clear_ack_sync[SYNC_STAGES-1]);\n            b_isolate_done <= (b_state == 2'b11 && a_isolate_ack_sync[SYNC_STAGES-1]);\n        end\n    end\n\n    always @(*) begin\n        b_next_state = b_state;\n        case (b_state)\n            2'b00: if (b_isolate_ack_sync[SYNC_STAGES-1]) b_next_state = 2'b01;\n            2'b01: if (b_clear_ack_sync[SYNC_STAGES-1]) b_next_state = 2'b10;\n            2'b10: if (a_isolate_ack_sync[SYNC_STAGES-1]) b_next_state = 2'b11;\n            2'b11: if (b_isolate_ack_sync[SYNC_STAGES-1] && a_isolate_ack_sync[SYNC_STAGES-1]) b_next_state = 2'b00;\n        endcase\n    end\n\n    // Synchronizers\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_clear_sync <= {SYNC_STAGES{1'b0}};\n            a_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n            a_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_clear_sync <= {a_clear_sync[SYNC_STAGES-2:0], b_clear_i};\n            a_isolate_ack_sync <= {a_isolate_ack_sync[SYNC_STAGES-2:0], b_isolate_ack_i};\n            a_clear_ack_sync <= {a_clear_ack_sync[SYNC_STAGES-2:0], b_clear_ack_i};\n        end\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_clear_sync <= {SYNC_STAGES{1'b0}};\n            b_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n            b_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_clear_sync <= {b_clear_sync[SYNC_STAGES-2:0], a_clear_i};\n            b_isolate_ack_sync <= {b_isolate_ack_sync[SYNC_STAGES-2:0], a_isolate_ack_i};\n            b_clear_ack_sync <= {b_clear_ack_sync[SYNC_STAGES-2:0], a_clear_ack_i};\n        end\n    end\n\n    // Outputs\n    assign a_isolate_o = a_isolate_req;\n    assign a_clear_o = a_clear_req & ~a_clear_done;\n    assign b_isolate_o = b_isolate_req;\n    assign b_clear_o = b_clear_req & ~b_clear_done;\n\nendmodule\n```<|im_end|>",
