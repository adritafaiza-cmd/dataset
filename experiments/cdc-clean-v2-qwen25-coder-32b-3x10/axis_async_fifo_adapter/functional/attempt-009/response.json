  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    // Internal signals\n    reg [$clog2(DEPTH):0] s_wr_ptr, s_wr_ptr_next, s_rd_ptr, s_rd_ptr_next;\n    reg [$clog2(DEPTH):0] m_wr_ptr, m_wr_ptr_next, m_rd_ptr, m_rd_ptr_next;\n    reg [$clog2(DEPTH):0] s_depth, s_depth_commit, m_depth, m_depth_commit;\n    reg [S_DATA_WIDTH-1:0] s_fifo_data [0:DEPTH-1];\n    reg [S_KEEP_WIDTH-1:0] s_fifo_keep [0:DEPTH-1];\n    reg s_fifo_tlast [0:DEPTH-1];\n    reg [ID_WIDTH-1:0] s_fifo_tid [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0] s_fifo_tdest [0:DEPTH-1];\n    reg [USER_WIDTH-1:0] s_fifo_tuser [0:DEPTH-1];\n    reg s_fifo_full, s_fifo_empty, m_fifo_full, m_fifo_empty;\n    reg s_axis_tready_int, m_axis_tvalid_int;\n    reg s_pause_ack_int, m_pause_ack_int;\n    reg s_status_overflow_int, s_status_bad_frame_int, s_status_good_frame_int;\n    reg m_status_overflow_int, m_status_bad_frame_int, m_status_good_frame_int;\n\n    // FIFO write logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= 0;\n            s_depth <= 0;\n            s_depth_commit <= 0;\n            s_status_overflow_int <= 0;\n            s_status_bad_frame_int <= 0;\n            s_status_good_frame_int <= 0;\n        end else begin\n            s_wr_ptr <= s_wr_ptr_next;\n            s_depth <= s_depth_commit;\n            s_depth_commit <= s_depth_commit + (s_axis_tvalid & s_axis_tready_int) - (m_axis_tvalid_int & m_axis_tready);\n            if (s_depth_commit == DEPTH && s_axis_tvalid & s_axis_tready_int) begin\n                s_status_overflow_int <= 1;\n            end else begin\n                s_status_overflow_int <= 0;\n            end\n        end\n    end\n\n    always @(*) begin\n        s_wr_ptr_next = s_wr_ptr;\n        if (s_axis_tvalid & s_axis_tready_int) begin\n            s_wr_ptr_next = s_wr_ptr + 1;\n        end\n    end\n\n    always @(posedge s_clk) begin\n        if (s_axis_tvalid & s_axis_tready_int) begin\n            s_fifo_data[s_wr_ptr] <= s_axis_tdata;\n            s_fifo_keep[s_wr_ptr] <= s_axis_tkeep;\n            s_fifo_tlast[s_wr_ptr] <= s_axis_tlast;\n            if (ID_ENABLE) s_fifo_tid[s_wr_ptr] <= s_axis_tid;\n            if (DEST_ENABLE) s_fifo_tdest[s_wr_ptr] <= s_axis_tdest;\n            if (USER_ENABLE) s_fifo_tuser[s_wr_ptr] <= s_axis_tuser;\n        end\n    end\n\n    // FIFO read logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= 0;\n            m_depth <= 0;\n            m_depth_commit <= 0;\n            m_status_bad_frame_int <= 0;\n            m_status_good_frame_int <= 0;\n        end else begin\n            m_rd_ptr <= m_rd_ptr_next;\n            m_depth <= m_depth_commit;\n            m_depth_commit <= m_depth_commit - (m_axis_tvalid_int & m_axis_tready);\n        end\n    end\n\n    always @(*) begin\n        m_rd_ptr_next = m_rd_ptr;\n        if (m_axis_tvalid_int & m_axis_tready) begin\n            m_rd_ptr_next = m_rd_ptr + 1;\n        end\n    end\n\n    // FIFO status\n    assign s_fifo_full = (s_depth_commit == DEPTH);\n    assign s_fifo_empty = (s_depth_commit == 0);\n    assign m_fifo_full = (m_depth_commit == DEPTH);\n    assign m_fifo_empty = (m_depth_commit == 0);\n\n    // FIFO read data\n    reg [M_DATA_WIDTH-1:0] m_axis_tdata_int;\n    reg [M_KEEP_WIDTH-1:0] m_axis_tkeep_int;\n    reg m_axis_tlast_int;\n    reg [ID_WIDTH-1:0] m_axis_tid_int;\n    reg [DEST_WIDTH-1:0] m_axis_tdest_int;\n    reg [USER_WIDTH-1:0] m_axis_tuser_int;\n\n    always @(posedge m_clk) begin\n        if (m_axis_tvalid_int & m_axis_tready) begin\n            m_axis_tdata_int <= s_fifo_data[m_rd_ptr];\n            m_axis_tkeep_int <= s_fifo_keep[m_rd_ptr];\n            m_axis_tlast_int <= s_fifo_tlast[m_rd_ptr];\n            if (ID_ENABLE) m_axis_tid_int <= s_fifo_tid[m_rd_ptr];\n            if (DEST_ENABLE) m_axis_tdest_int <= s_fifo_tdest[m_rd_ptr];\n            if (USER_ENABLE) m_axis_tuser_int <= s_fifo_tuser[m_rd_ptr];\n        end\n    end\n\n    // Width adapter\n    reg [M_DATA_WIDTH-1:0] m_axis_tdata_reg;\n    reg [M_KEEP_WIDTH-1:0] m_axis_tkeep_reg;\n    reg m_axis_tlast_reg;\n    reg [ID_WIDTH-1:0] m_axis_tid_reg;\n    reg [DEST_WIDTH-1:0] m_axis_tdest_reg;\n    reg [USER_WIDTH-1:0] m_axis_tuser_reg;\n    reg m_axis_tvalid_reg;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_axis_tdata_reg <= 0;\n            m_axis_tkeep_reg <= 0;\n            m_axis_tlast_reg <= 0;\n            m_axis_tid_reg <= 0;\n            m_axis_tdest_reg <= 0;\n            m_axis_tuser_reg <= 0;\n            m_axis_tvalid_reg <= 0;\n        end else begin\n            if (m_axis_tvalid_int & m_axis_tready) begin\n                m_axis_tdata_reg <= m_axis_tdata_int;\n                m_axis_tkeep_reg <= m_axis_tkeep_int;\n                m_axis_tlast_reg <= m_axis_tlast_int;\n                if (ID_ENABLE) m_axis_tid_reg <= m_axis_tid_int;\n                if (DEST_ENABLE) m_axis_tdest_reg <= m_axis_tdest_int;\n                if (USER_ENABLE) m_axis_tuser_reg <= m_axis_tuser_int;\n                m_axis_tvalid_reg <= 1;\n            end else if (m_axis_tready) begin\n                m_axis_tvalid_reg <= 0;\n            end\n        end\n    end\n\n    // Handshake signals\n    assign s_axis_tready_int = ~s_fifo_full & ~s_pause_req;\n    assign m_axis_tvalid_int = ~m_fifo_empty & ~m_pause_req;\n\n    assign s_axis_tready = s_axis_tready_int;\n    assign m_axis_tvalid = m_axis_tvalid_reg;\n    assign m_axis_tdata = m_axis_tdata_reg;\n    assign m_axis_tkeep = m_axis_tkeep_reg;\n    assign m_axis_tlast = m_axis_tlast_reg;\n    assign m_axis_tid = m_axis_tid_reg;\n    assign m_axis_tdest = m_axis_tdest_reg;\n    assign m_axis_tuser = m_axis_tuser_reg;\n\n    // Pause signals\n    assign s_pause_ack_int = s_pause_req & s_axis_tready_int;\n    assign m_pause_ack_int = m_pause_req & m_axis_tvalid_int;\n\n    assign s_pause_ack = s_pause_ack_int;\n    assign m_pause_ack = m_pause_ack_int;\n\n    // Status signals\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth_commit;\n    assign s_status_overflow = s_status_overflow_int;\n    assign s_status_bad_frame = s_status_bad_frame_int;\n    assign s_status_good_frame = s_status_good_frame_int;\n\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth_commit;\n    assign m_status_overflow = m_status_overflow_int;\n    assign m_status_bad_frame = m_status_bad_frame_int;\n    assign m_status_good_frame = m_status_good_frame_int;\n\nendmodule\n```<|im_end|>",
