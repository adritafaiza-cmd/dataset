id) begin\n            s_pause_ack_reg <= 0;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_pause_ack_reg <= 0;\n        end else if (m_pause_req) begin\n            m_pause_ack_reg <= 1;\n        end else if (m_axis_tready && m_axis_tvalid) begin\n            m_pause_ack_reg <= 0;\n        end\n    end\n\nendmodule\n```<|im_end|>",
