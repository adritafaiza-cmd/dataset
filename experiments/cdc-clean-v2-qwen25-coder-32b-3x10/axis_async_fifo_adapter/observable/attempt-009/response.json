m [DEPTH-1:0];\n    reg [ID_WIDTH-1:0] id_mem [DEPTH-1:0];\n    reg [DEST_WIDTH-1:0] dest_mem [DEPTH-1:0];\n    reg [USER_WIDTH-1:0] user_mem [DEPTH-1:0];\n\n    reg [ADDR_WIDTH:0] s_depth, s_depth_commit;\n    reg [ADDR_WIDTH:0] m_depth, m_depth_commit;\n\n    reg s_overflow, s_bad_frame, s_good_frame;\n    reg m_overflow, m_bad_frame, m_good_frame;\n\n    reg s_pause_ack_reg, m_pause_ack_reg;\n\n    // Gray code conversion\n    function [ADDR_WIDTH:0] binary_to_gray;\n        input [ADDR_WIDTH:0] bin;\n        binary_to_gray = bin ^ (bin >> 1);\n    endfunction\n\n    function [ADDR_WIDTH:0] gray_to_binary;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i >= 0; i = i - 1) begin\n            bin[i] = bin[i] ^ bin[i+1];\n        end\n        gray_to_binary = bin;\n    endfunction\n\n    // Write side logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= 0;\n            s_wr_ptr_gray <= 0;\n            s_wr_ptr_gray_nxt <= 0;\n            s_axis_tready <= 0;\n            s_depth <= 0;\n            s_depth_commit <= 0;\n            s_overflow <= 0;\n            s_bad_frame <= 0;\n            s_good_frame <= 0;\n        end else begin\n            s_wr_ptr_gray_nxt <= binary_to_gray(s_wr_ptr + 1);\n            if (s_axis_tvalid && s_axis_tready) begin\n                mem[s_wr_ptr] <= s_axis_tdata;\n                keep_mem[s_wr_ptr] <= s_axis_tkeep;\n                last_mem[s_wr_ptr] <= s_axis_tlast;\n                id_mem[s_wr_ptr] <= s_axis_tid;\n                dest_mem[s_wr_ptr] <= s_axis_tdest;\n                user_mem[s_wr_ptr] <= s_axis_tuser;\n                s_wr_ptr <= s_wr_ptr + 1;\n                s_wr_ptr_gray <= s_wr_ptr_gray_nxt;\n                s_depth <= s_depth + 1;\n                s_depth_commit <= s_depth_commit + 1;\n                if (s_axis_tlast) begin\n                    s_good_frame <= 1;\n                end\n            end else if (s_axis_tvalid && !s_axis_tready) begin\n                s_depth_commit <= s_depth_commit + 1;\n            end\n            if (s_depth == DEPTH) begin\n                s_axis_tready <= 0;\n                s_overflow <= 1;\n            end else if (s_axis_tvalid && !s_axis_tready) begin\n                s_axis_tready <= 1;\n                s_overflow <= 0;\n            end\n        end\n    end\n\n    // Read side logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= 0;\n            m_rd_ptr_gray <= 0;\n            m_rd_ptr_gray_nxt <= 0;\n            m_axis_tvalid <= 0;\n            m_depth <= 0;\n            m_depth_commit <= 0;\n            m_bad_frame <= 0;\n            m_good_frame <= 0;\n        end else begin\n            m_rd_ptr_gray_nxt <= binary_to_gray(m_rd_ptr + 1);\n            if (m_axis_tvalid && m_axis_tready) begin\n                m_rd_ptr <= m_rd_ptr + 1;\n                m_rd_ptr_gray <= m_rd_ptr_gray_nxt;\n                m_depth <= m_depth - 1;\n                m_depth_commit <= m_depth_commit - 1;\n                if (m_axis_tlast) begin\n                    m_good_frame <= 1;\n                end\n            end else if (m_axis_tvalid && !m_axis_tready) begin\n                m_depth_commit <= m_depth_commit - 1;\n            end\n            if (m_depth == 0) begin\n                m_axis_tvalid <= 0;\n            end else if (m_depth > 0 && !m_axis_tvalid) begin\n                m_axis_tvalid <= 1;\n            end\n        end\n    end\n\n    // Cross-domain logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_rd_ptr_gray <= 0;\n        end else begin\n            s_rd_ptr_gray <= m_rd_ptr_gray_nxt;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_wr_ptr_gray <= 0;\n        end else begin\n            m_wr_ptr_gray <= s_wr_ptr_gray_nxt;\n        end\n    end\n\n    // Status signals\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth_commit;\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth_commit;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n\n    // Pause signals\n    assign s_pause_ack = s_pause_ack_reg;\n    assign m_pause_ack = m_pause_ack_reg;\n\n    // Data width conversion\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_axis_tdata_reg <= 0;\n            s_axis_tkeep_reg <= 0;\n            s_axis_tvalid_reg <= 0;\n            s_axis_tlast_reg <= 0;\n            s_axis_tid_reg <= 0;\n            s_axis_tdest_reg <= 0;\n            s_axis_tuser_reg <= 0;\n        end else if (s_axis_tvalid && s_axis_tready) begin\n            s_axis_tdata_reg <= s_axis_tdata;\n            s_axis_tkeep_reg <= s_axis_tkeep;\n            s_axis_tvalid_reg <= s_axis_tvalid;\n            s_axis_tlast_reg <= s_axis_tlast;\n            s_axis_tid_reg <= s_axis_tid;\n            s_axis_tdest_reg <= s_axis_tdest;\n            s_axis_tuser_reg <= s_axis_tuser;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_axis_tdata_reg <= 0;\n            m_axis_tkeep_reg <= 0;\n            m_axis_tvalid_reg <= 0;\n            m_axis_tlast_reg <= 0;\n            m_axis_tid_reg <= 0;\n            m_axis_tdest_reg <= 0;\n            m_axis_tuser_reg <= 0;\n        end else if (m_axis_tvalid && m_axis_tready) begin\n            m_axis_tdata_reg <= m_axis_tdata;\n            m_axis_tkeep_reg <= m_axis_tkeep;\n            m_axis_tvalid_reg <= m_axis_tvalid;\n            m_axis_tlast_reg <= m_axis_tlast;\n            m_axis_t