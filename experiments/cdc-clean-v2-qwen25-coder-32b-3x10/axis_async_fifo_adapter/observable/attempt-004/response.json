$clog2(DEPTH):0] next_depth_commit;\n            reg m_axis_tvalid_next;\n\n            next_rd_ptr = m_rd_ptr + (m_axis_tvalid_reg & m_axis_tready);\n            next_rd_ptr_gray = bin2gray(next_rd_ptr);\n            next_depth = m_depth - (m_axis_tvalid_reg & m_axis_tready);\n            next_depth_commit = m_depth_commit - (m_axis_tvalid_reg & m_axis_tready & m_axis_tlast_reg);\n            m_axis_tvalid_next = (m_depth > 0) & ~m_pause_req;\n\n            if (m_axis_tvalid_reg & m_axis_tready) begin\n                if (m_axis_tlast_reg) begin\n                    if (DROP_BAD_FRAME && (m_axis_tuser_reg & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        m_status_bad_frame_reg <= 1;\n                    end else begin\n                        m_status_good_frame_reg <= 1;\n                    end\n                end else begin\n                    m_status_bad_frame_reg <= 0;\n                    m_status_good_frame_reg <= 0;\n                end\n            end\n\n            if (m_axis_tvalid_reg & m_axis_tready) begin\n                m_axis_tdata_reg <= fifo_mem[m_rd_ptr];\n                m_axis_tkeep_reg <= fifo_keep[m_rd_ptr];\n                m_axis_tlast_reg <= fifo_last[m_rd_ptr];\n                m_axis_tid_reg <= fifo_tid[m_rd_ptr];\n                m_axis_tdest_reg <= fifo_tdest[m_rd_ptr];\n                m_axis_tuser_reg <= fifo_tuser[m_rd_ptr];\n            end\n\n            m_rd_ptr <= next_rd_ptr;\n            m_rd_ptr_gray <= next_rd_ptr_gray;\n            m_axis_tvalid_reg <= m_axis_tvalid_next;\n            m_depth <= next_depth;\n            m_depth_commit <= next_depth_commit;\n        end\n    end\n\n    // Cross-domain synchronization\n    reg [$clog2(DEPTH):0] s_wr_ptr_gray_sync;\n    reg [$clog2(DEPTH):0] m_rd_ptr_gray_sync;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_wr_ptr_gray_sync <= 0;\n        end else begin\n            s_wr_ptr_gray_sync <= s_wr_ptr