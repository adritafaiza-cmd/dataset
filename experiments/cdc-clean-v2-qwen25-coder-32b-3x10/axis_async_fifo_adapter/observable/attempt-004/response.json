  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    // Internal signals\n    reg [S_DATA_WIDTH-1:0] s_axis_tdata_reg;\n    reg [S_KEEP_WIDTH-1:0] s_axis_tkeep_reg;\n    reg                    s_axis_tvalid_reg;\n    reg                    s_axis_tlast_reg;\n    reg [ID_WIDTH-1:0]     s_axis_tid_reg;\n    reg [DEST_WIDTH-1:0]   s_axis_tdest_reg;\n    reg [USER_WIDTH-1:0]   s_axis_tuser_reg;\n\n    reg [M_DATA_WIDTH-1:0] m_axis_tdata_reg;\n    reg [M_KEEP_WIDTH-1:0] m_axis_tkeep_reg;\n    reg                    m_axis_tvalid_reg;\n    reg                    m_axis_tlast_reg;\n    reg [ID_WIDTH-1:0]     m_axis_tid_reg;\n    reg [DEST_WIDTH-1:0]   m_axis_tdest_reg;\n    reg [USER_WIDTH-1:0]   m_axis_tuser_reg;\n\n    reg [$clog2(DEPTH):0]  s_wr_ptr;\n    reg [$clog2(DEPTH):0]  s_wr_ptr_gray;\n    reg [$clog2(DEPTH):0]  m_rd_ptr;\n    reg [$clog2(DEPTH):0]  m_rd_ptr_gray;\n\n    reg [$clog2(DEPTH):0]  s_depth;\n    reg [$clog2(DEPTH):0]  m_depth;\n\n    reg                    s_pause_ack_reg;\n    reg                    m_pause_ack_reg;\n\n    reg                    s_status_overflow_reg;\n    reg                    s_status_bad_frame_reg;\n    reg                    s_status_good_frame_reg;\n    reg                    m_status_overflow_reg;\n    reg                    m_status_bad_frame_reg;\n    reg                    m_status_good_frame_reg;\n\n    reg [$clog2(DEPTH):0]  s_depth_commit;\n    reg [$clog2(DEPTH):0]  m_depth_commit;\n\n    // FIFO memory\n    reg [S_DATA_WIDTH-1:0] fifo_mem [DEPTH-1:0];\n    reg [S_KEEP_WIDTH-1:0] fifo_keep [DEPTH-1:0];\n    reg                    fifo_last [DEPTH-1:0];\n    reg [ID_WIDTH-1:0]     fifo_tid [DEPTH-1:0];\n    reg [DEST_WIDTH-1:0]   fifo_tdest [DEPTH-1:0];\n    reg [USER_WIDTH-1:0]   fifo_tuser [DEPTH-1:0];\n\n    // Gray code conversion\n    function [$clog2(DEPTH):0] bin2gray;\n        input [$clog2(DEPTH):0] bin;\n        bin2gray = (bin >> 1) ^ bin;\n    endfunction\n\n    // Binary code conversion\n    function [$clog2(DEPTH):0] gray2bin;\n        input [$clog2(DEPTH):0] gray;\n        integer i;\n        reg [$clog2(DEPTH):0] bin;\n        bin = gray;\n        for (i = $clog2(DEPTH); i > 0; i = i - 1) begin\n            bin[i-1] = bin[i] ^ bin[i-1];\n        end\n        gray2bin = bin;\n    endfunction\n\n    // Write side logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= 0;\n            s_wr_ptr_gray <= 0;\n            s_axis_tready <= 0;\n            s_depth <= 0;\n            s_depth_commit <= 0;\n            s_status_overflow_reg <= 0;\n            s_status_bad_frame_reg <= 0;\n            s_status_good_frame_reg <= 0;\n        end else begin\n            reg [$clog2(DEPTH):0] next_wr_ptr;\n            reg [$clog2(DEPTH):0] next_wr_ptr_gray;\n            reg [$clog2(DEPTH):0] next_depth;\n            reg [$clog2(DEPTH):0] next_depth_commit;\n            reg s_axis_tready_next;\n\n            next_wr_ptr = s_wr_ptr + 1;\n            next_wr_ptr_gray = bin2gray(next_wr_ptr);\n            next_depth = s_depth + (s_axis_tvalid & s_axis_tready);\n            next_depth_commit = s_depth_commit + (s_axis_tvalid & s_axis_tr