  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    // Internal signals\n    reg [$clog2(DEPTH):0] s_wr_ptr, s_wr_ptr_gray, s_wr_ptr_gray_sync, s_wr_ptr_gray_sync2;\n    reg [$clog2(DEPTH):0] s_rd_ptr, s_rd_ptr_gray, s_rd_ptr_gray_sync, s_rd_ptr_gray_sync2;\n    reg [$clog2(DEPTH):0] m_wr_ptr, m_wr_ptr_gray, m_wr_ptr_gray_sync, m_wr_ptr_gray_sync2;\n    reg [$clog2(DEPTH):0] m_rd_ptr, m_rd_ptr_gray, m_rd_ptr_gray_sync, m_rd_ptr_gray_sync2;\n\n    reg [S_DATA_WIDTH-1:0] s_fifo [DEPTH-1:0];\n    reg [S_KEEP_WIDTH-1:0] s_keep_fifo [DEPTH-1:0];\n    reg [ID_WIDTH-1:0] s_tid_fifo [DEPTH-1:0];\n    reg [DEST_WIDTH-1:0] s_tdest_fifo [DEPTH-1:0];\n    reg [USER_WIDTH-1:0] s_tuser_fifo [DEPTH-1:0];\n    reg s_tlast_fifo [DEPTH-1:0];\n\n    reg [M_DATA_WIDTH-1:0] m_fifo [DEPTH-1:0];\n    reg [M_KEEP_WIDTH-1:0] m_keep_fifo [DEPTH-1:0];\n    reg [ID_WIDTH-1:0] m_tid_fifo [DEPTH-1:0];\n    reg [DEST_WIDTH-1:0] m_tdest_fifo [DEPTH-1:0];\n    reg [USER_WIDTH-1:0] m_tuser_fifo [DEPTH-1:0];\n    reg m_tlast_fifo [DEPTH-1:0];\n\n    reg s_axis_tready_int;\n    reg m_axis_tvalid_int;\n    reg s_pause_ack_int;\n    reg m_pause_ack_int;\n\n    reg [$clog2(DEPTH):0] s_depth, s_depth_commit;\n    reg [$clog2(DEPTH):0] m_depth, m_depth_commit;\n    reg s_overflow, s_bad_frame, s_good_frame;\n    reg m_overflow, m_bad_frame, m_good_frame;\n\n    // Binary to Gray conversion\n    function [$clog2(DEPTH):0] bin_to_gray;\n        input [$clog2(DEPTH):0] bin;\n        bin_to_gray = bin ^ (bin >> 1);\n    endfunction\n\n    // Gray to Binary conversion\n    function [$clog2(DEPTH):0] gray_to_bin;\n        input [$clog2(DEPTH):0] gray;\n        integer i;\n        reg [$clog2(DEPTH):0] bin;\n        bin = gray;\n        for (i = $clog2(DEPTH) - 1; i >= 0; i = i - 1)\n            bin[i] = bin[i+1] ^ gray[i];\n        gray_to_bin = bin;\n    endfunction\n\n    // Source clock domain\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= 0;\n            s_wr_ptr_gray <= 0;\n            s_wr_ptr_gray_sync <= 0;\n            s_wr_ptr_gray_sync2 <= 0;\n            s_axis_tready_int <= 0;\n            s_depth <= 0;\n            s_depth_commit <= 0;\n            s_overflow <= 0;\n            s_bad_frame <= 0;\n            s_good_frame <= 0;\n        end else begin\n            s_wr_ptr_gray <= bin_to_gray(s_wr_ptr);\n            s_wr_ptr_gray_sync <= s_wr_ptr_gray_sync2;\n            s_wr_ptr_gray_sync2 <= s_wr_ptr_gray;\n\n            if (s_axis_tvalid && s_axis_tready_int) begin\n                s_fifo[s_wr_ptr] <= s_axis_tdata;\n                s_keep_fifo[s_wr_ptr] <= s_axis_tkeep;\n                s_tid_fifo[s_wr_ptr] <= s_axis_tid;\n                s_tdest_fifo[s_wr_ptr] <= s_axis_tdest;\n                s_tuser_fifo[s_wr_ptr] <= s_axis_tuser;\n                s_tlast_fifo[s_wr_ptr] <= s_axis_tlast;\n                s_wr_ptr <= s_wr_ptr + 1;\n                s_depth <= s_depth + 1;\n                if (s_axis_tlast) begin\n                    s_depth_commit <= s_depth_commit + 1;\n                    if (s_axis_tuser & USER_BAD_FRAME_MASK == USER_BAD_FRAME_VALUE)\n                        s_bad_frame <= 1;\n                    else\n                        s_good_frame <= 1;\n                end\n            end\n\n            if (s_depth == DEPTH)\n                s_overflow <= 1;\n\n            if (s_axis_tlast)\n                s_axis_tready_int <= 1;\n            else if (s_depth == DEPTH - 1)\n                s_axis_tready_int <= 0;\n            else\n                s_axis_tready_int <= 1;\n\n            if (s_good_frame && s_axis_tlast)\n                s_good_frame <= 0;\n\n            if (s_bad_frame && s_axis_tlast)\n                s_bad_frame <= 0;\n\n            if (s_overflow && s_axis_tlast)\n                s_overflow <= 0;\n        end\n    end\n\n    // Source to Master CDC\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_rd_ptr_gray_sync <= 0;\n            s_rd_ptr_gray_sync2 <= 0;\n        end else begin\n            s_rd_ptr_gray_sync <= s_wr_ptr_gray_sync;\n            s_rd_ptr_gray_sync2 <= s_wr_ptr_gray_sync2;\n        end\n    end\n\n    assign s_rd_ptr_gray = s_rd_ptr_gray_sync2;\n    assign s_rd_ptr = gray_to_bin(s_rd_ptr_gray);\n\n    // Master clock domain\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_wr_ptr <= 0;\n            m_wr_ptr_gray <= 0;\n            m_wr_ptr_gray_sync <= 0;\n            m_wr_ptr_gray_sync2 <= 0;\n            m_axis_tvalid_int <= 0;\n            m_depth <= 0;\n            m_depth_commit <= 0;\n            m_overflow <= 0;\n            m_bad_frame <= 0;\n            m_good_frame <= 0;\n        end else begin\n            m_wr_ptr_gray <= bin_to_gray(m_wr_ptr);\n            m_wr_ptr_gray_sync <= m_wr_ptr_gray_sync2;\n            m_wr_ptr_gray_sync2 <= m_wr_ptr_gray;\n\n            if (m_axis_tvalid_int && m_axis_tready) begin\n                m_wr_ptr <= m_wr_ptr + 1;\n                m_depth <= m_depth - 1;\n                if (m_tlast_fifo[m_rd_ptr])\n                    m_depth_commit <= m_depth_commit - 1;\n            end\n\n            if (s_depth > m_depth && m_axis_tready) begin\n                m_fifo[m_wr_ptr] <= s_fifo[s_rd_ptr];\n                m_keep_fifo[m_wr_ptr] <= s_keep_fifo[s_rd_ptr];\n                m_tid_fifo[m_wr_ptr] <= s_tid_fifo[s_rd_ptr];\n                m_tdest_fifo[m_wr_ptr] <= s_tdest_fifo[s_rd_ptr];\n                m_tuser_fifo[m_wr_ptr] <= s_tuser_fifo[s_rd_ptr];\n                m_tlast_fifo[m_wr_ptr] <= s_tlast_fifo[s_rd_ptr];\n                m_wr_ptr <= m_wr_ptr + 1;\n                m_depth <= m_depth + 1;\n                if (s_tlast_fifo[s_rd_ptr]) begin\n                    m_depth_commit <= m_depth_commit + 1;\n                    if (s_tuser_fifo[s_rd_ptr] & USER_BAD_FRAME_MASK == USER_BAD_FRAME_VALUE)\n                        m_bad_frame <= 1;\n                    else\n                        m_good_frame <= 1;\n                end\n                s_rd_ptr <= s_rd_ptr + 1;\n            end\n\n            if (m_depth == DEPTH)\n                m_overflow <= 1;\n\n            if (m_depth > 0)\n                m_axis_tvalid_int <= 1;\n            else\n                m_axis_tvalid_int <= 0;\n\n            if (m_good_frame && m_tlast_fifo[m_rd_ptr])\n                m_good_frame <= 0;\n\n            if (m_bad_frame && m_tlast_fifo[m_rd_ptr])\n                m_bad_frame <= 0;\n\n            if (m_overflow && m_tlast_fifo[m_rd_ptr])\n                m_overflow <= 0;\n        end\n    end\n\n    // Master to Source CDC\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            m_rd_ptr_gray_sync <= 0;\n            m_rd_ptr_gray_sync2 <= 0;\n        end else begin\n            m_rd_ptr_gray_sync <= m_wr_ptr_gray_sync;\n            m_rd_ptr_gray_sync2 <= m_wr_ptr_gray_sync2;\n        end\n    end\n\n    assign m_rd_ptr_gray = m_rd_ptr_gray_sync2;\n    assign m_rd_ptr = gray_to_bin(m_rd_ptr_gray);\n\n    // Width conversion\n    reg [M_DATA_WIDTH-1:0] m_axis_tdata_int;\n    reg [M_KEEP_WIDTH-1:0] m_axis_tkeep_int;\n    reg m_axis_tlast_int;\n    reg [ID_WIDTH-1:0] m_axis_tid_int;\n    reg [DEST_WIDTH-1:0] m_axis_tdest_int;\n    reg [USER_WIDTH-1:0] m_axis_tuser_int;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_axis_tdata_int <= 0;\n            m_axis_tkeep_int <= 0;\n            m_axis_tlast_int <= 0;\n            m_axis_tid_int <= 0;\n            m_axis_tdest_int <= 0;\n            m_axis_tuser_int <= 0;\n        end else begin\n            if (m_axis_tvalid_int && m_axis_tready) begin\n                m_axis_tdata_int <= m_fifo[m_rd_ptr];\n                m_axis_tkeep_int <= m_keep_fifo[m_rd_ptr];\n                m_axis_tlast_int <= m_tlast_fifo[m_rd_ptr];\n                m_axis_tid_int <= m_tid_fifo[m_rd_ptr];\n                m_axis_tdest_int <= m_tdest_fifo[m_rd_ptr];\n                m_axis_tuser_int <= m_tuser_fifo[m_rd_ptr];\n            end\n        end\n    end\n\n    // Pause signals\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            s_pause_ack_int <= 0;\n        else\n            s_pause_ack_int <= s_pause_req;\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            m_pause_ack_int <= 0;\n        else\n            m_pause_ack_int <= m_pause_req;\n    end\n\n    // Status signals\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth_commit;\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth_commit;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n\n    // Output assignments\n    assign s_axis_tready = s_axis_tready_int;\n    assign m_axis_tdata = m_axis_tdata_int;\n    assign m_axis_tkeep = m_axis_tkeep_int;\n    assign m_axis_tvalid = m_axis_tvalid_int;\n    assig