  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam S_WORD_WIDTH = S_DATA_WIDTH + (S_KEEP_ENABLE ? S_KEEP_WIDTH : 0) + (ID_ENABLE ? ID_WIDTH : 0) + (DEST_ENABLE ? DEST_WIDTH : 0) + (USER_ENABLE ? USER_WIDTH : 0) + 1;\n    localparam M_WORD_WIDTH = M_DATA_WIDTH + (M_KEEP_ENABLE ? M_KEEP_WIDTH : 0) + (ID_ENABLE ? ID_WIDTH : 0) + (DEST_ENABLE ? DEST_WIDTH : 0) + (USER_ENABLE ? USER_WIDTH : 0) + 1;\n\n    reg [ADDR_WIDTH:0] s_wr_ptr, s_wr_ptr_gray, s_wr_ptr_gray_sync;\n    reg [ADDR_WIDTH:0] m_rd_ptr, m_rd_ptr_gray, m_rd_ptr_gray_sync;\n    reg [ADDR_WIDTH:0] s_wr_ptr_gray_sync, m_rd_ptr_gray_sync;\n\n    reg [S_WORD_WIDTH-1:0] mem [DEPTH-1:0];\n    reg [ADDR_WIDTH:0] s_depth, m_depth;\n    reg s_full, m_full, s_empty, m_empty;\n\n    reg s_axis_tready_reg;\n    reg m_axis_tvalid_reg;\n    reg [M_DATA_WIDTH-1:0] m_axis_tdata_reg;\n    reg [M_KEEP_WIDTH-1:0] m_axis_tkeep_reg;\n    reg m_axis_tlast_reg;\n    reg [ID_WIDTH-1:0] m_axis_tid_reg;\n    reg [DEST_WIDTH-1:0] m_axis_tdest_reg;\n    reg [USER_WIDTH-1:0] m_axis_tuser_reg;\n\n    reg s_pause_ack_reg;\n    reg m_pause_ack_reg;\n\n    reg s_status_overflow_reg;\n    reg s_status_bad_frame_reg;\n    reg s_status_good_frame_reg;\n    reg m_status_overflow_reg;\n    reg m_status_bad_frame_reg;\n    reg m_status_good_frame_reg;\n\n    // Gray code conversion\n    function [ADDR_WIDTH:0] bin2gray;\n        input [ADDR_WIDTH:0] bin;\n        bin2gray = bin ^ (bin >> 1);\n    endfunction\n\n    // Gray code conversion\n    function [ADDR_WIDTH:0] gray2bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i >= 0; i = i - 1) begin\n            bin[i] = bin[i] ^ bin[i+1];\n        end\n        gray2bin = bin;\n    endfunction\n\n    // Write pointer logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= 0;\n            s_wr_ptr_gray <= 0;\n        end else if (s_axis_tvalid && s_axis_tready_reg) begin\n            s_wr_ptr <= s_wr_ptr + 1;\n            s_wr_ptr_gray <= bin2gray(s_wr_ptr + 1);\n        end\n    end\n\n    // Read pointer logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= 0;\n            m_rd_ptr_gray <= 0;\n        end else if (m_axis_tvalid_reg && m_axis_tready) begin\n            m_rd_ptr <= m_rd_ptr + 1;\n            m_rd_ptr_gray <= bin2gray(m_rd_ptr + 1);\n        end\n    end\n\n    // Gray code synchronization\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr_gray_sync <= 0;\n        end else begin\n            s_wr_ptr_gray_sync <= s_wr_ptr_gray;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr_gray_sync <= 0;\n        end else begin\n            m_rd_ptr_gray_sync <= m_rd_ptr_gray;\n        end\n    end\n\n    // Depth calculation\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_depth <= 0;\n        end else begin\n            s_depth <= gray2bin(s_wr_ptr_gray_sync) - gray2bin(m_rd_ptr_gray_sync);\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_depth <= 0;\n        end else begin\n            m_depth <= gray2bin(s_wr_ptr_gray_sync) - gray2bin(m_rd_ptr_gray_sync);\n        end\n    end\n\n    // Full and empty flags\n    assign s_full = (s_depth == DEPTH);\n    assign m_empty = (m_depth == 0);\n\n    // Write enable\n    assign s_axis_tready_reg = !s_full && !s_pause_req;\n\n    // Read enable\n    assign m_axis_tvalid_reg = !m_empty && !m_pause_req;\n\n    // Memory write\n    always @(posedge s_clk) begin\n        if (s_axis_tvalid && s_axis_tready_reg) begin\n            mem[s_wr_ptr[ADDR_WIDTH-1:0]] = {s_axis_tlast, s_axis_tuser, s_axis_tdest, s_axis_tid, s_axis_tkeep, s_axis_tdata};\n        end\n    end\n\n    // Memory read\n    always @(posedge m_clk) begin\n        if (m_axis_tvalid_reg && m_axis_tready) begin\n            {m_axis_tlast_reg, m_axis_tuser_reg, m_axis_tdest_reg, m_axis_tid_reg, m_axis_tkeep_reg, m_axis_tdata_reg} = mem[m_rd_ptr[ADDR_WIDTH-1:0]];\n        end\n    end\n\n    // Output assignment\n    assign s_axis_tready = s_axis_tready_reg;\n    assign m_axis_tdata = m_axis_tdata_reg;\n    assign m_axis_tkeep = m_axis_tkeep_reg;\n    assign m_axis_tvalid = m_axis_tvalid_reg;\n    assign m_axis_tlast = m_axis_tlast_reg;\n    assign m_axis_tid = m_axis_tid_reg;\n    assign m_axis_tdest = m_axis_tdest_reg;\n    assign m_axis_tuser = m_axis_tuser_reg;\n\n    // Pause acknowledge\n    assign s_pause_ack_reg = s_pause_req;\n    assign m_pause_ack_reg = m_pause_req;\n\n    // Status signals\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth;\n    assign s_status_overflow = s_status_overflow_reg;\n    assign s_status_bad_frame = s_status_bad_frame_reg;\n    assign s_status_good_frame = s_status_good_frame_reg;\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth;\n    assign m_status_overflow = m_status_overflow_reg;\n    assign m_status_bad_frame = m_status_bad_frame_reg;\n    assign m_status_good_frame = m_status_good_frame_reg;\n\n    // Width adaptation (simple zero-padding for demonstration)\n    always @(posedge m_clk) begin\n        if (m_axis_tvalid_reg && m_axis_tready) begin\n            if (M_DATA_WIDTH > S_DATA_WIDTH) begin\n                m_axis_tdata_reg[M_DATA_WIDTH-1:S_DATA_WIDTH] <= 0;\n            end else if (M_DATA_WIDTH < S_DATA_WIDTH) begin\n                m_axis_tdata_reg <= m_axis_tdata_reg[M_DATA_WIDTH-1:0];\n            end\n        end\n    end\n\n    // Pause acknowledge\n    assign s_pause_ack = s_pause_ack_reg;\n    assign m_pause_ack = m_pause_ack_reg;\n\nendmodule\n```<|im_end|>",
