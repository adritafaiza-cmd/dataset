_ARESETN;\n\nendmodule\n\nmodule fifo #(\n\t\tparameter WIDTH = 32,\n\t\tparameter DEPTH = 16\n\t) (\n\t\tinput wire clk,\n\t\tinput wire rst,\n\t\tinput wire wr_en,\n\t\tinput wire rd_en,\n\t\tinput wire [WIDTH-1:0] din,\n\t\toutput reg [WIDTH-1:0] dout,\n\t\toutput reg full,\n\t\toutput reg empty,\n\t\toutput reg wr_rst_busy,\n\t\toutput reg rd_rst_busy,\n\t\toutput reg wr_ack,\n\t\toutput reg rd_ack\n\t);\n\n\tlocalparam ADDR_WIDTH = $clog2(DEPTH);\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\treg [ADDR_WIDTH-1:0] wr_ptr, rd_ptr;\n\treg [ADDR_WIDTH:0] count;\n\n\talways @(posedge clk or posedge rst) begin\n\t\tif (rst) begin\n\t\t\twr_ptr <= 0;\n\t\t\trd_ptr <= 0;\n\t\t\tcount <= 0;\n\t\t\tfull <= 0;\n\t\t\tempty <= 1;\n\t\t\twr_rst_busy <= 1;\n\t\t\trd_rst_busy <= 1;\n\t\t\twr_ack <= 0;\n\t\t\trd_ack <= 0;\n\t\tend else begin\n\t\t\twr_rst_busy <= 0;\n\t\t\trd_rst_busy <= 0;\n\t\t\twr_ack <= wr_en & ~full;\n\t\t\trd_ack <= rd_en & ~empty;\n\n\t\t\tif (wr_en & ~full) begin\n\t\t\t\tmem[wr_ptr] <= din;\n\t\t\t\twr_ptr <= wr_ptr + 1;\n\t\t\t\tcount <= count + 1;\n\t\t\tend\n\n\t\t\tif (rd_en & ~empty) begin\n\t\t\t\tdout <= mem[rd_ptr];\n\t\t\t\trd_ptr <= rd_ptr + 1;\n\t\t\t\tcount <= count - 1;\n\t\t\tend\n\n\t\t\tfull <= (count == DEPTH);\n\t\t\tempty <= (count == 0);\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
