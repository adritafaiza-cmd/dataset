n\n\t\t\twr_ptr <= 0;\n\t\t\trd_ptr <= 0;\n\t\t\tcount <= 0;\n\t\t\tfull <= 0;\n\t\t\tempty <= 1;\n\t\tend else begin\n\t\t\tif (wr_en && !full) begin\n\t\t\t\tmem[wr_ptr] <= din;\n\t\t\t\twr_ptr <= wr_ptr + 1;\n\t\t\t\tcount <= count + 1;\n\t\t\tend\n\t\t\tif (rd_en && !empty) begin\n\t\t\t\tdout <= mem[rd_ptr];\n\t\t\t\trd_ptr <= rd_ptr + 1;\n\t\t\t\tcount <= count - 1;\n\t\t\tend\n\t\t\tfull <= (count == DEPTH);\n\t\t\tempty <= (count == 0);\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
