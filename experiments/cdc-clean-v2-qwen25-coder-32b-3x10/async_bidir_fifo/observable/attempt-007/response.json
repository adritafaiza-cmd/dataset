  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam AWIDTH = ASIZE;\n\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  // A side signals\n  reg [AWIDTH:0] a_wr_ptr, a_wr_ptr_gray, a_wr_ptr_gray_nxt;\n  reg [AWIDTH:0] a_rd_ptr, a_rd_ptr_gray, a_rd_ptr_gray_nxt;\n  reg [AWIDTH:0] a_wr_ptr_gray_sync, a_rd_ptr_gray_sync;\n\n  // B side signals\n  reg [AWIDTH:0] b_wr_ptr, b_wr_ptr_gray, b_wr_ptr_gray_nxt;\n  reg [AWIDTH:0] b_rd_ptr, b_rd_ptr_gray, b_rd_ptr_gray_nxt;\n  reg [AWIDTH:0] b_wr_ptr_gray_sync, b_rd_ptr_gray_sync;\n\n  // A side logic\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= 0;\n      a_wr_ptr_gray <= 0;\n      a_wr_ptr_gray_nxt <= 0;\n    end else begin\n      a_wr_ptr_gray_nxt <= a_wr_ptr + 1;\n      a_wr_ptr_gray <= a_wr_ptr_gray_nxt;\n      if (a_winc && !a_full)\n        a_wr_ptr <= a_wr_ptr + 1;\n    end\n  end\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_rd_ptr <= 0;\n      a_rd_ptr_gray <= 0;\n      a_rd_ptr_gray_nxt <= 0;\n    end else begin\n      a_rd_ptr_gray_nxt <= a_rd_ptr + 1;\n      a_rd_ptr_gray <= a_rd_ptr_gray_nxt;\n      if (a_rinc && !a_empty)\n        a_rd_ptr <= a_rd_ptr + 1;\n    end\n  end\n\n  // B side logic\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= 0;\n      b_wr_ptr_gray <= 0;\n      b_wr_ptr_gray_nxt <= 0;\n    end else begin\n      b_wr_ptr_gray_nxt <= b_wr_ptr + 1;\n      b_wr_ptr_gray <= b_wr_ptr_gray_nxt;\n      if (b_winc && !b_full)\n        b_wr_ptr <= b_wr_ptr + 1;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_rd_ptr <= 0;\n      b_rd_ptr_gray <= 0;\n      b_rd_ptr_gray_nxt <= 0;\n    end else begin\n      b_rd_ptr_gray_nxt <= b_rd_ptr + 1;\n      b_rd_ptr_gray <= b_rd_ptr_gray_nxt;\n      if (b_rinc && !b_empty)\n        b_rd_ptr <= b_rd_ptr + 1;\n    end\n  end\n\n  // Gray code synchronization\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_gray_sync <= 0;\n      b_rd_ptr_gray_sync <= 0;\n    end else begin\n      b_wr_ptr_gray_sync <= b_wr_ptr_gray;\n      b_rd_ptr_gray_sync <= b_rd_ptr_gray;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_gray_sync <= 0;\n      a_rd_ptr_gray_sync <= 0;\n    end else begin\n      a_wr_ptr_gray_sync <= a_wr_ptr_gray;\n      a_rd_ptr_gray_sync <= a_rd_ptr_gray;\n    end\n  end\n\n  // Write and read data\n  always @(posedge a_clk) begin\n    if (a_winc && !a_full)\n      mem[a_wr_ptr[AWIDTH-1:0]] <= a_wdata;\n  end\n\n  always @(posedge b_clk) begin\n    if (b_winc && !b_full)\n      mem[b_wr_ptr[AWIDTH-1:0]] <= b_wdata;\n  end\n\n  // Read data\n  assign a_rdata = mem[a_rd_ptr[AWIDTH-1:0]];\n  assign b_rdata = mem[b_rd_ptr[AWIDTH-1:0]];\n\n  // Full and empty flags\n  wire [AWIDTH:0] a_full_cnt, a_empty_cnt;\n  wire [AWIDTH:0] b_full_cnt, b_empty_cnt;\n\n  assign a_full_cnt = a_wr_ptr_gray_sync - a_rd_ptr_gray;\n  assign a_empty_cnt = a_rd_ptr_gray_sync - a_wr_ptr_gray;\n\n  assign b_full_cnt = b_wr_ptr_gray_sync - b_rd_ptr_gray;\n  assign b_empty_cnt = b_rd_ptr_gray_sync - b_wr_ptr_gray;\n\n  assign a_full = a_full_cnt[AWIDTH];\n  assign a_afull = a_full_cnt[AWIDTH-1];\n  assign a_empty = a_empty_cnt[AWIDTH];\n  assign a_aempty = a_empty_cnt[AWIDTH-1];\n\n  assign b_full = b_full_cnt[AWIDTH];\n  assign b_afull = b_full_cnt[AWIDTH-1];\n  assign b_empty = b_empty_cnt[AWIDTH];\n  assign b_aempty = b_empty_cnt[AWIDTH-1];\n\nendmodule\n```<|im_end|>",
