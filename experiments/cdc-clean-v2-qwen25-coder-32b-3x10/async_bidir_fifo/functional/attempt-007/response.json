  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  reg [ASIZE:0] a_wr_ptr, a_wr_ptr_gray, a_wr_ptr_gray_sync, a_rd_ptr, a_rd_ptr_gray;\n  reg [ASIZE:0] b_wr_ptr, b_wr_ptr_gray, b_wr_ptr_gray_sync, b_rd_ptr, b_rd_ptr_gray;\n\n  // Gray code conversion\n  function [ASIZE:0] bin2gray;\n    input [ASIZE:0] bin;\n    bin2gray = bin ^ (bin >> 1);\n  endfunction\n\n  // Gray code to binary conversion\n  function [ASIZE:0] gray2bin;\n    input [ASIZE:0] gray;\n    integer i;\n    reg [ASIZE:0] bin;\n    bin = gray;\n    for (i = ASIZE; i > 0; i = i - 1)\n      bin[i-1] = bin[i] ^ bin[i-1];\n    gray2bin = bin;\n  endfunction\n\n  // a_clk domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= 0;\n      a_wr_ptr_gray <= 0;\n    end else if (a_dir && !a_full) begin\n      a_wr_ptr <= a_wr_ptr + 1;\n      a_wr_ptr_gray <= bin2gray(a_wr_ptr + 1);\n    end\n  end\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_rd_ptr <= 0;\n      a_rd_ptr_gray <= 0;\n    end else if (!a_dir && !a_empty) begin\n      a_rd_ptr <= a_rd_ptr + 1;\n      a_rd_ptr_gray <= bin2gray(a_rd_ptr + 1);\n    end\n  end\n\n  // Synchronize b_wr_ptr_gray to a_clk domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_gray_sync <= 0;\n    end else begin\n      b_wr_ptr_gray_sync <= b_wr_ptr_gray;\n    end\n  end\n\n  // Calculate flags\n  assign a_full = (a_wr_ptr_gray == (b_wr_ptr_gray_sync ^ (1 << ASIZE)));\n  assign a_afull = (a_wr_ptr_gray == (b_wr_ptr_gray_sync ^ (3 << ASIZE)));\n  assign a_empty = (a_wr_ptr_gray == a_rd_ptr_gray);\n  assign a_aempty = (a_wr_ptr_gray == (a_rd_ptr_gray ^ (1 << ASIZE)));\n\n  // Write data to memory\n  always @(posedge a_clk) begin\n    if (a_dir && !a_full) begin\n      mem[a_wr_ptr[ASIZE-1:0]] <= a_wdata;\n    end\n  end\n\n  // Read data from memory\n  always @(posedge a_clk) begin\n    if (!a_dir && !a_empty) begin\n      a_rdata <= mem[a_rd_ptr[ASIZE-1:0]];\n    end\n  end\n\n  // b_clk domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= 0;\n      b_wr_ptr_gray <= 0;\n    end else if (b_dir && !b_full) begin\n      b_wr_ptr <= b_wr_ptr + 1;\n      b_wr_ptr_gray <= bin2gray(b_wr_ptr + 1);\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_rd_ptr <= 0;\n      b_rd_ptr_gray <= 0;\n    end else if (!b_dir && !b_empty) begin\n      b_rd_ptr <= b_rd_ptr + 1;\n      b_rd_ptr_gray <= bin2gray(b_rd_ptr + 1);\n    end\n  end\n\n  // Synchronize a_wr_ptr_gray to b_clk domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_gray_sync <= 0;\n    end else begin\n      a_wr_ptr_gray_sync <= a_wr_ptr_gray;\n    end\n  end\n\n  // Calculate flags\n  assign b_full = (b_wr_ptr_gray == (a_wr_ptr_gray_sync ^ (1 << ASIZE)));\n  assign b_afull = (b_wr_ptr_gray == (a_wr_ptr_gray_sync ^ (3 << ASIZE)));\n  assign b_empty = (b_wr_ptr_gray == b_rd_ptr_gray);\n  assign b_aempty = (b_wr_ptr_gray == (b_rd_ptr_gray ^ (1 << ASIZE)));\n\n  // Write data to memory\n  always @(posedge b_clk) begin\n    if (b_dir && !b_full) begin\n      mem[b_wr_ptr[ASIZE-1:0]] <= b_wdata;\n    end\n  end\n\n  // Read data from memory\n  always @(posedge b_clk) begin\n    if (!b_dir && !b_empty) begin\n      b_rdata <= mem[b_rd_ptr[ASIZE-1:0]];\n    end\n  end\n\nendmodule\n```<|im_end|>",
