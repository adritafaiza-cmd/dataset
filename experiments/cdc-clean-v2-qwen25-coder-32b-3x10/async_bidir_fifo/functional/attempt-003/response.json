  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  reg [ASIZE:0] a_wr_ptr, a_rd_ptr, a_wr_ptr_gray, a_rd_ptr_gray;\n  reg [ASIZE:0] b_wr_ptr, b_rd_ptr, b_wr_ptr_gray, b_rd_ptr_gray;\n\n  reg [DSIZE-1:0] a_rdata_reg, b_rdata_reg;\n\n  // Gray code conversion functions\n  function [ASIZE:0] bin_to_gray;\n    input [ASIZE:0] bin;\n    bin_to_gray = bin ^ (bin >> 1);\n  endfunction\n\n  function [ASIZE:0] gray_to_bin;\n    input [ASIZE:0] gray;\n    integer i;\n    reg [ASIZE:0] bin;\n    bin = gray;\n    for (i = ASIZE; i > 0; i = i - 1)\n      bin[i-1] = bin[i] ^ bin[i-1];\n    gray_to_bin = bin;\n  endfunction\n\n  // A-side logic\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= 0;\n      a_wr_ptr_gray <= 0;\n      a_rd_ptr <= 0;\n      a_rd_ptr_gray <= 0;\n    end else begin\n      if (a_dir) begin // Write\n        if (!a_full) begin\n          mem[a_wr_ptr[ASIZE-1:0]] <= a_wdata;\n          a_wr_ptr <= a_wr_ptr + 1;\n          a_wr_ptr_gray <= bin_to_gray(a_wr_ptr + 1);\n        end\n      end else begin // Read\n        if (!a_empty) begin\n          a_rd_ptr <= a_rd_ptr + 1;\n          a_rd_ptr_gray <= bin_to_gray(a_rd_ptr + 1);\n        end\n      end\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= 0;\n      b_wr_ptr_gray <= 0;\n      b_rd_ptr <= 0;\n      b_rd_ptr_gray <= 0;\n    end else begin\n      if (b_dir) begin // Write\n        if (!b_full) begin\n          mem[b_wr_ptr[ASIZE-1:0]] <= b_wdata;\n          b_wr_ptr <= b_wr_ptr + 1;\n          b_wr_ptr_gray <= bin_to_gray(b_wr_ptr + 1);\n        end\n      end else begin // Read\n        if (!b_empty) begin\n          b_rd_ptr <= b_rd_ptr + 1;\n          b_rd_ptr_gray <= bin_to_gray(b_rd_ptr + 1);\n        end\n      end\n    end\n  end\n\n  // A-side read data\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_rdata_reg <= 0;\n    else if (a_rinc && !a_empty)\n      a_rdata_reg <= mem[a_rd_ptr[ASIZE-1:0]];\n  end\n\n  // B-side read data\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_rdata_reg <= 0;\n    else if (b_rinc && !b_empty)\n      b_rdata_reg <= mem[b_rd_ptr[ASIZE-1:0]];\n  end\n\n  // A-side flags\n  wire [ASIZE:0] a_wr_ptr_gray_sync, a_rd_ptr_gray_sync;\n  sync_gray #(.WIDTH(ASIZE+1)) sync_a_wr_ptr_gray (.clk(a_clk), .rst_n(a_rst_n), .din(b_wr_ptr_gray), .dout(a_wr_ptr_gray_sync));\n  sync_gray #(.WIDTH(ASIZE+1)) sync_a_rd_ptr_gray (.clk(a_clk), .rst_n(a_rst_n), .din(b_rd_ptr_gray), .dout(a_rd_ptr_gray_sync));\n\n  assign a_full = (a_wr_ptr_gray_sync == bin_to_gray(a_wr_ptr + 1));\n  assign a_afull = (a_wr_ptr_gray_sync == bin_to_gray(a_wr_ptr + DEPTH - 1));\n  assign a_empty = (a_wr_ptr_gray == a_rd_ptr_gray_sync);\n  assign a_aempty = (a_wr_ptr_gray == bin_to_gray(a_rd_ptr_sync + 1));\n\n  // B-side flags\n  wire [ASIZE:0] b_wr_ptr_gray_sync, b_rd_ptr_gray_sync;\n  sync_gray #(.WIDTH(ASIZE+1)) sync_b_wr_ptr_gray (.clk(b_clk), .rst_n(b_rst_n), .din(a_wr_ptr_gray), .dout(b_wr_ptr_gray_sync));\n  sync_gray #(.WIDTH(ASIZE+1)) sync_b_rd_ptr_gray (.clk(b_clk), .rst_n(b_rst_n), .din(a_rd_ptr_gray), .dout(b_rd_ptr_gray_sync));\n\n  assign b_full = (b_wr_ptr_gray_sync == bin_to_gray(b_wr_ptr + 1));\n  assign b_afull = (b_wr_ptr_gray_sync == bin_to_gray(b_wr_ptr + DEPTH - 1));\n  assign b_empty = (b_wr_ptr_gray == b_rd_ptr_gray_sync);\n  assign b_aempty = (b_wr_ptr_gray == bin_to_gray(b_rd_ptr_sync + 1));\n\n  // Output assignments\n  assign a_rdata = a_rdata_reg;\n  assign b_rdata = b_rdata_reg;\n\nendmodule\n\n// Gray code synchronizer\nmodule sync_gray\n  #(\n    parameter WIDTH = 5\n    ) (\n       input wire              clk,\n       input wire              rst_n,\n       input wire [WIDTH-1:0]  din,\n       output reg [WIDTH-1:0]  dout\n       );\n\n  reg [WIDTH-1:0] sync_reg1, sync_reg2;\n\n  always @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n      sync_reg1 <= 0;\n      sync_reg2 <= 0;\n      dout <= 0;\n    end else begin\n      sync_reg1 <= din;\n      sync_reg2 <= sync_reg1;\n      dout <= sync_reg2;\n    end\n  end\n\nendmodule\n```<|im_end|>",
