  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AFULL_THRESHOLD = DEPTH - 2;\n\n    // FIFO for A to B direction\n    reg [DSIZE-1:0] mem_a2b [0:DEPTH-1];\n    reg [ASIZE:0] wr_ptr_a2b, rd_ptr_a2b, wr_ptr_gray_a2b, rd_ptr_gray_a2b;\n    reg [ASIZE:0] wr_ptr_gray_sync_a2b, rd_ptr_gray_sync_a2b;\n\n    // FIFO for B to A direction\n    reg [DSIZE-1:0] mem_b2a [0:DEPTH-1];\n    reg [ASIZE:0] wr_ptr_b2a, rd_ptr_b2a, wr_ptr_gray_b2a, rd_ptr_gray_b2a;\n    reg [ASIZE:0] wr_ptr_gray_sync_b2a, rd_ptr_gray_sync_b2a;\n\n    // Binary to Gray conversion\n    function [ASIZE:0] bin2gray;\n        input [ASIZE:0] bin;\n        bin2gray = bin ^ (bin >> 1);\n    endfunction\n\n    // Gray to Binary conversion\n    function [ASIZE:0] gray2bin;\n        input [ASIZE:0] gray;\n        integer i;\n        reg [ASIZE:0] bin;\n        bin = gray;\n        for (i = ASIZE-1; i > 0; i = i - 1)\n            bin[i-1] = bin[i] ^ bin[i-1];\n        gray2bin = bin;\n    endfunction\n\n    // A to B FIFO logic\n    always @(posedge a_clk or negedge a_rst_n) begin\n        if (!a_rst_n) begin\n            wr_ptr_a2b <= 0;\n            rd_ptr_a2b <= 0;\n        end else begin\n            if (a_dir && !a_full) begin\n                mem_a2b[wr_ptr_a2b[ASIZE-1:0]] <= a_wdata;\n                wr_ptr_a2b <= wr_ptr_a2b + 1;\n            end\n        end\n    end\n\n    always @(posedge b_clk or negedge b_rst_n) begin\n        if (!b_rst_n) begin\n            wr_ptr_gray_sync_a2b <= 0;\n        end else begin\n            wr_ptr_gray_sync_a2b <= bin2gray(wr_ptr_a2b);\n        end\n    end\n\n    always @(posedge b_clk or negedge b_rst_n) begin\n        if (!b_rst_n) begin\n            rd_ptr_b2a <= 0;\n        end else begin\n            if (!b_dir && !b_empty) begin\n                rd_ptr_b2a <= rd_ptr_b2a + 1;\n            end\n        end\n    end\n\n    always @(posedge b_clk or negedge b_rst_n) begin\n        if (!b_rst_n) begin\n            rd_ptr_gray_sync_a2b <= 0;\n        end else begin\n            rd_ptr_gray_sync_a2b <= bin2gray(rd_ptr_b2a);\n        end\n    end\n\n    assign wr_ptr_gray_a2b = bin2gray(wr_ptr_a2b);\n    assign rd_ptr_gray_a2b = bin2gray(rd_ptr_a2b);\n\n    assign a_full = (wr_ptr_gray_a2b[ASIZE] != rd_ptr_gray_sync_a2b[ASIZE]) && (wr_ptr_gray_a2b[ASIZE-1:0] == rd_ptr_gray_sync_a2b[ASIZE-1:0]);\n    assign a_afull = (wr_ptr_gray_a2b[ASIZE] == rd_ptr_gray_sync_a2b[ASIZE]) && (wr_ptr_gray_a2b[ASIZE-1:0] == rd_ptr_gray_sync_a2b[ASIZE-1:0] + AFULL_THRESHOLD);\n    assign a_empty = (wr_ptr_gray_sync_a2b == rd_ptr_gray_a2b);\n    assign a_aempty = (wr_ptr_gray_sync_a2b[ASIZE] != rd_ptr_gray_a2b[ASIZE]) && (wr_ptr_gray_sync_a2b[ASIZE-1:0] == rd_ptr_gray_a2b[ASIZE-1:0] + 1);\n\n    assign a_rdata = mem_a2b[rd_ptr_a2b[ASIZE-1:0]];\n\n    // B to A FIFO logic\n    always @(posedge b_clk or negedge b_rst_n) begin\n        if (!b_rst_n) begin\n            wr_ptr_b2a <= 0;\n            rd_ptr_b2a <= 0;\n        end else begin\n            if (b_dir && !b_full) begin\n                mem_b2a[wr_ptr_b2a[ASIZE-1:0]] <= b_wdata;\n                wr_ptr_b2a <= wr_ptr_b2a + 1;\n            end\n        end\n    end\n\n    always @(posedge a_clk or negedge a_rst_n) begin\n        if (!a_rst_n) begin\n            wr_ptr_gray_sync_b2a <= 0;\n        end else begin\n            wr_ptr_gray_sync_b2a <= bin2gray(wr_ptr_b2a);\n        end\n    end\n\n    always @(posedge a_clk or negedge a_rst_n) begin\n        if (!a_rst_n) begin\n            rd_ptr_a2b <= 0;\n        end else begin\n            if (!a_dir && !a_empty) begin\n                rd_ptr_a2b <= rd_ptr_a2b + 1;\n            end\n        end\n    end\n\n    always @(posedge a_clk or negedge a_rst_n) begin\n        if (!a_rst_n) begin\n            rd_ptr_gray_sync_b2a <= 0;\n        end else begin\n            rd_ptr_gray_sync_b2a <= bin2gray(rd_ptr_a2b);\n        end\n    end\n\n    assign wr_ptr_gray_b2a = bin2gray(wr_ptr_b2a);\n    assign rd_ptr_gray_b2a = bin2gray(rd_ptr_b2a);\n\n    assign b_full = (wr_ptr_gray_b2a[ASIZE] != rd_ptr_gray_sync_b2a[ASIZE]) && (wr_ptr_gray_b2a[ASIZE-1:0] == rd_ptr_gray_sync_b2a[ASIZE-1:0]);\n    assign b_afull = (wr_ptr_gray_b2a[ASIZE] == rd_ptr_gray_sync_b2a[ASIZE]) && (wr_ptr_gray_b2a[ASIZE-1:0] == rd_ptr_gray_sync_b2a[ASIZE-1:0] + AFULL_THRESHOLD);\n    assign b_empty = (wr_ptr_gray_sync_b2a == rd_ptr_gray_b2a);\n    assign b_aempty = (wr_ptr_gray_sync_b2a[ASIZE] != rd_ptr_gray_b2a[ASIZE]) && (wr_ptr_gray_sync_b2a[ASIZE-1:0] == rd_ptr_gray_b2a[ASIZE-1:0] + 1);\n\n    assign b_rdata = mem_b2a[rd_ptr_b2a[ASIZE-1:0]];\n\nendmodule\n```<|im_end|>",
