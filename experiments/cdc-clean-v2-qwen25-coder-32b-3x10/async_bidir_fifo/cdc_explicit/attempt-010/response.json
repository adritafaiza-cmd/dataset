  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AFULL_THRESHOLD = DEPTH - 2;\n    localparam AEMPTY_THRESHOLD = 1;\n\n    // FIFO for A to B direction\n    reg [DSIZE-1:0] mem_a2b [0:DEPTH-1];\n    reg [ASIZE:0] wptr_a2b, rptr_a2b, wptr_a2b_sync, rptr_a2b_sync;\n    reg [ASIZE:0] wptr_a2b_gray, rptr_a2b_gray, wptr_a2b_gray_sync, rptr_a2b_gray_sync;\n\n    // FIFO for B to A direction\n    reg [DSIZE-1:0] mem_b2a [0:DEPTH-1];\n    reg [ASIZE:0] wptr_b2a, rptr_b2a, wptr_b2a_sync, rptr_b2a_sync;\n    reg [ASIZE:0] wptr_b2a_gray, rptr_b2a_gray, wptr_b2a_gray_sync, rptr_b2a_gray_sync;\n\n    // Gray code conversion functions\n    function [ASIZE:0] bin2gray;\n        input [ASIZE:0] bin;\n        bin2gray = (bin >> 1) ^ bin;\n    endfunction\n\n    function [ASIZE:0] gray2bin;\n        input [ASIZE:0] gray;\n        integer i;\n        reg [ASIZE:0] bin;\n        bin = gray;\n        for (i = ASIZE; i > 0; i = i - 1)\n            bin[i-1] = bin[i] ^ bin[i-1];\n        return bin;\n    endfunction\n\n    // A to B FIFO write and read logic\n    always @(posedge a_clk or negedge a_rst_n) begin\n        if (!a_rst_n) begin\n            wptr_a2b <= 0;\n            rptr_a2b <= 0;\n        end else begin\n            if (a_dir && !a_full) begin\n                mem_a2b[wptr_a2b[ASIZE-1:0]] <= a_wdata;\n                wptr_a2b <= wptr_a2b + 1;\n            end\n        end\n    end\n\n    always @(posedge b_clk or negedge b_rst_n) begin\n        if (!b_rst_n) begin\n            wptr_a2b_gray_sync <= 0;\n            rptr_a2b_gray_sync <= 0;\n        end else begin\n            wptr_a2b_gray_sync <= bin2gray(wptr_a2b);\n            rptr_a2b_gray_sync <= rptr_a2b_gray;\n        end\n    end\n\n    always @(posedge b_clk or negedge b_rst_n) begin\n        if (!b_rst_n) begin\n            rptr_a2b <= 0;\n        end else begin\n            if (!b_dir && !b_empty) begin\n                rptr_a2b <= rptr_a2b + 1;\n            end\n        end\n    end\n\n    // B to A FIFO write and read logic\n    always @(posedge b_clk or negedge b_rst_n) begin\n        if (!b_rst_n) begin\n            wptr_b2a <= 0;\n            rptr_b2a <= 0;\n        end else begin\n            if (b_dir && !b_full) begin\n                mem_b2a[wptr_b2a[ASIZE-1:0]] <= b_wdata;\n                wptr_b2a <= wptr_b2a + 1;\n            end\n        end\n    end\n\n    always @(posedge a_clk or negedge a_rst_n) begin\n        if (!a_rst_n) begin\n            wptr_b2a_gray_sync <= 0;\n            rptr_b2a_gray_sync <= 0;\n        end else begin\n            wptr_b2a_gray_sync <= bin2gray(wptr_b2a);\n            rptr_b2a_gray_sync <= rptr_b2a_gray;\n        end\n    end\n\n    always @(posedge a_clk or negedge a_rst_n) begin\n        if (!a_rst_n) begin\n            rptr_b2a <= 0;\n        end else begin\n            if (!a_dir && !a_empty) begin\n                rptr_b2a <= rptr_b2a + 1;\n            end\n        end\n    end\n\n    // A side outputs\n    assign a_rdata = mem_a2b[rptr_a2b[ASIZE-1:0]];\n    assign a_full = (wptr_a2b_gray_sync[ASIZE:0] == {~rptr_a2b_gray_sync[ASIZE], rptr_a2b_gray_sync[ASIZE-1:0]});\n    assign a_afull = (wptr_a2b_gray_sync[ASIZE:0] == {~rptr_a2b_gray_sync[ASIZE], rptr_a2b_gray_sync[ASIZE-1:0] + AFULL_THRESHOLD});\n    assign a_empty = (wptr_a2b_gray_sync[ASIZE:0] == rptr_a2b_gray_sync[ASIZE:0]);\n    assign a_aempty = (wptr_a2b_gray_sync[ASIZE:0] == {rptr_a2b_gray_sync[ASIZE], rptr_a2b_gray_sync[ASIZE-1:0] + AEMPTY_THRESHOLD});\n\n    // B side outputs\n    assign b_rdata = mem_b2a[rptr_b2a[ASIZE-1:0]];\n    assign b_full = (wptr_b2a_gray_sync[ASIZE:0] == {~rptr_b2a_gray_sync[ASIZE], rptr_b2a_gray_sync[ASIZE-1:0]});\n    assign b_afull = (wptr_b2a_gray_sync[ASIZE:0] == {~rptr_b2a_gray_sync[ASIZE], rptr_b2a_gray_sync[ASIZE-1:0] + AFULL_THRESHOLD});\n    assign b_empty = (wptr_b2a_gray_sync[ASIZE:0] == rptr_b2a_gray_sync[ASIZE:0]);\n    assign b_aempty = (wptr_b2a_gray_sync[ASIZE:0] == {rptr_b2a_gray_sync[ASIZE], rptr_b2a_gray_sync[ASIZE-1:0] + AEMPTY_THRESHOLD});\n\nendmodule\n```<|im_end|>",
