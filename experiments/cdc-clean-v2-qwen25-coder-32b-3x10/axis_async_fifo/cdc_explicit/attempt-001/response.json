  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n\n    // FIFO signals\n    reg [ADDR_WIDTH:0] s_wr_ptr, s_wr_ptr_gray, s_wr_ptr_gray_sync, s_wr_ptr_gray_sync2;\n    reg [ADDR_WIDTH:0] m_rd_ptr, m_rd_ptr_gray, m_rd_ptr_gray_sync, m_rd_ptr_gray_sync2;\n    reg [ADDR_WIDTH:0] s_depth, m_depth;\n    reg [ADDR_WIDTH:0] s_depth_commit, m_depth_commit;\n    reg [ADDR_WIDTH:0] s_depth_gray, m_depth_gray;\n    reg [ADDR_WIDTH:0] s_depth_gray_sync, m_depth_gray_sync;\n    reg [ADDR_WIDTH:0] s_depth_gray_sync2, m_depth_gray_sync2;\n\n    // FIFO memory\n    reg [DATA_WIDTH-1:0] mem_data [DEPTH-1:0];\n    reg [KEEP_WIDTH-1:0] mem_keep [DEPTH-1:0];\n    reg [LAST_ENABLE:0]  mem_last [DEPTH-1:0];\n    reg [ID_ENABLE:0]    mem_tid [DEPTH-1:0];\n    reg [DEST_ENABLE:0]  mem_tdest [DEPTH-1:0];\n    reg [USER_ENABLE:0]  mem_tuser [DEPTH-1:0];\n\n    // Flags\n    reg s_full, s_empty, m_full, m_empty;\n    reg s_overflow, s_bad_frame, s_good_frame;\n    reg m_overflow, m_bad_frame, m_good_frame;\n\n    // Pause signals\n    reg s_pause_ack_reg, m_pause_ack_reg;\n\n    // Status signals\n    reg [$clog2(DEPTH):0] s_status_depth_reg, s_status_depth_commit_reg;\n    reg [$clog2(DEPTH):0] m_status_depth_reg, m_status_depth_commit_reg;\n\n    // Gray code conversion\n    function [ADDR_WIDTH:0] bin2gray;\n        input [ADDR_WIDTH:0] bin;\n        bin2gray = bin ^ (bin >> 1);\n    endfunction\n\n    // Binary code conversion\n    function [ADDR_WIDTH:0] gray2bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i > 0; i = i - 1) begin\n            bin[i-1] = bin[i] ^ bin[i-1];\n        end\n        gray2bin = bin;\n    endfunction\n\n    // Write pointer logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= 0;\n        end else if (s_axis_tvalid && s_axis_tready) begin\n            s_wr_ptr <= s_wr_ptr + 1;\n        end\n    end\n\n    // Read pointer logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= 0;\n        end else if (m_axis_tvalid && m_axis_tready) begin\n            m_rd_ptr <= m_rd_ptr + 1;\n        end\n    end\n\n    // Gray code conversion and synchronization\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr_gray <= 0;\n            s_wr_ptr_gray_sync <= 0;\n            s_wr_ptr_gray_sync2 <= 0;\n        end else begin\n            s_wr_ptr_gray <= bin2gray(s_wr_ptr);\n            s_wr_ptr_gray_sync <= s_wr_ptr_gray;\n            s_wr_ptr_gray_sync2 <= s_wr_ptr_gray_sync;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr_gray <= 0;\n            m_rd_ptr_gray_sync <= 0;\n            m_rd_ptr_gray_sync2 <= 0;\n        end else begin\n            m_rd_ptr_gray <= bin2gray(m_rd_ptr);\n            m_rd_ptr_gray_sync <= m_rd_ptr_gray;\n            m_rd_ptr_gray_sync2 <= m_rd_ptr_gray_sync;\n        end\n    end\n\n    // Depth calculation\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_depth <= 0;\n            s_depth_gray <= 0;\n            s_depth_gray_sync <= 0;\n            s_depth_gray_sync2 <= 0;\n        end else begin\n            s_depth <= s_wr_ptr - gray2bin(s_rd_ptr_gray_sync2);\n            s_depth_gray <= bin2gray(s_depth);\n            s_depth_gray_sync <= s_depth_gray;\n            s_depth_gray_sync2 <= s_depth_gray_sync;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_depth <= 0;\n            m_depth_gray <= 0;\n            m_depth_gray_sync <= 0;\n            m_depth_gray_sync2 <= 0;\n        end else begin\n            m_depth <= m_wr_ptr - gray2bin(m_rd_ptr_gray_sync2);\n            m_depth_gray <= bin2gray(m_depth);\n            m_depth_gray_sync <= m_depth_gray;\n            m_depth_gray_sync2 <= m_depth_gray_sync;\n        end\n    end\n\n    // FIFO full and empty flags\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_full <= 0;\n            s_empty <= 1;\n        end else begin\n            s_full <= (s_wr_ptr_gray_sync2 == bin2gray(s_rd_ptr + DEPTH));\n            s_empty <= (s_wr_ptr_gray_sync2 == s_rd_ptr_gray_sync2);\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_full <= 0;\n            m_empty <= 1;\n        end else begin\n            m_full <= (m_wr_ptr_gray_sync2 == bin2gray(m_rd_ptr + DEPTH));\n            m_empty <= (m_wr_ptr_gray_sync2 == m_rd_ptr_gray_sync2);\n        end\n    end\n\n    // FIFO write logic\n    always @(posedge s_clk) begin\n        if (s_axis_tvalid && s_axis_tready) begin\n            mem_data[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdata;\n            mem_keep[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tkeep;\n            mem_last[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tlast;\n            mem_tid[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tid;\n            mem_tdest[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdest;\n            mem_tuser[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tuser;\n        end\n    end\n\n    // FIFO read logic\n    always @(posedge m_clk) begin\n        if (m_axis_tvalid && m_axis_tready) begin\n            m_axis_tdata <= mem_data[m_rd_ptr[ADDR_WIDTH-1:0]];\n            m_axis_tkeep <= mem_keep[m_rd_ptr[ADDR_WIDTH-1:0]];\n            m_axis_tlast <= mem_last[m_rd_ptr[ADDR_WIDTH-1:0]];\n            m_axis_tid <= mem_tid[m_rd_ptr[ADDR_WIDTH-1:0]];\n            m_axis_tdest <= mem_tdest[m_rd_ptr[ADDR_WIDTH-1:0]];\n            m_axis_tuser <= mem_tuser[m_rd_ptr[ADDR_WIDTH-1:0]];\n        end\n    end\n\n    // Handshake logic\n    assign s_axis_tready = !s_full;\n    assign m_axis_tvalid = !m_empty;\n\n    // Pause logic\n    assign s_pause_ack = s_pause_ack_reg;\n    assign m_pause_ack = m_pause_ack_reg;\n\n    // Status logic\n    assign s_status_depth = s_status_depth_reg;\n    assign s_status_depth_commit = s_status_depth_commit_reg;\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n\n    assign m_status_depth = m_status_depth_reg;\n    assign m_status_depth_commit = m_status_depth_commit_reg;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n\nendmodule\n```\n\nThis Verilog-2001 implementation of an asynchronous AXI-Stream FIFO includes the necessary logic for handling asynchronous clocks and resets, as well as the required AXI-Stream interface signals and parameters. The FIFO uses gray code for pointer synchronization to ensure safe crossing of clock domains. The implementation also includes basic handshake and status logic, but does not include advanced features like frame handling, pause control, or overflow management beyond the basic FIFO operations.<|im_end|>",
