  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n\n    reg [ADDR_WIDTH:0] s_wr_ptr, s_wr_ptr_gray, s_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] s_rd_ptr, s_rd_ptr_gray, s_rd_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] m_wr_ptr, m_wr_ptr_gray, m_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] m_rd_ptr, m_rd_ptr_gray, m_rd_ptr_gray_nxt;\n\n    reg [DATA_WIDTH-1:0] mem_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] mem_keep [0:DEPTH-1];\n    reg [LAST_ENABLE:0]  mem_last [0:DEPTH-1];\n    reg [ID_ENABLE:0]    mem_id [0:DEPTH-1];\n    reg [DEST_ENABLE:0]  mem_dest [0:DEPTH-1];\n    reg [USER_ENABLE:0]  mem_user [0:DEPTH-1];\n\n    reg [ADDR_WIDTH:0] s_depth, s_depth_commit;\n    reg [ADDR_WIDTH:0] m_depth, m_depth_commit;\n\n    reg s_full, s_empty, s_overflow, s_bad_frame, s_good_frame;\n    reg m_full, m_empty, m_overflow, m_bad_frame, m_good_frame;\n\n    reg s_pause_ack_reg, m_pause_ack_reg;\n\n    // Binary to Gray conversion\n    function [ADDR_WIDTH:0] bin2gray;\n        input [ADDR_WIDTH:0] bin;\n        bin2gray = bin ^ (bin >> 1);\n    endfunction\n\n    // Gray to Binary conversion\n    function [ADDR_WIDTH:0] gray2bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i >= 0; i = i - 1) begin\n            bin[i] = bin[i] ^ bin[i+1];\n        end\n        gray2bin = bin;\n    endfunction\n\n    // Synchronous write side\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= 0;\n            s_wr_ptr_gray <= 0;\n            s_depth <= 0;\n            s_depth_commit <= 0;\n            s_full <= 0;\n            s_empty <= 1;\n            s_overflow <= 0;\n            s_bad_frame <= 0;\n            s_good_frame <= 0;\n        end else begin\n            s_wr_ptr_gray_nxt = bin2gray(s_wr_ptr + 1);\n            if (s_axis_tvalid && s_axis_tready && !s_full) begin\n                mem_data[s_wr_ptr] <= s_axis_tdata;\n                if (KEEP_ENABLE) mem_keep[s_wr_ptr] <= s_axis_tkeep;\n                if (LAST_ENABLE) mem_last[s_wr_ptr] <= s_axis_tlast;\n                if (ID_ENABLE) mem_id[s_wr_ptr] <= s_axis_tid;\n                if (DEST_ENABLE) mem_dest[s_wr_ptr] <= s_axis_tdest;\n                if (USER_ENABLE) mem_user[s_wr_ptr] <= s_axis_tuser;\n                s_wr_ptr <= s_wr_ptr + 1;\n                s_wr_ptr_gray <= s_wr_ptr_gray_nxt;\n                s_depth <= s_depth + 1;\n                if (s_depth == DEPTH-1) begin\n                    s_full <= 1;\n                    s_empty <= 0;\n                end else begin\n                    s_full <= 0;\n                    s_empty <= 0;\n                end\n                if (s_axis_tlast) begin\n                    s_depth_commit <= s_depth + 1;\n                    s_good_frame <= 1;\n                end\n            end else begin\n                s_good_frame <= 0;\n            end\n            if (s_depth_commit == DEPTH) begin\n                s_overflow <= 1;\n            end else begin\n                s_overflow <= 0;\n            end\n        end\n    end\n\n    // Synchronous read side\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= 0;\n            m_rd_ptr_gray <= 0;\n            m_depth <= 0;\n            m_depth_commit <= 0;\n            m_full <= 0;\n            m_empty <= 1;\n            m_bad_frame <= 0;\n            m_good_frame <= 0;\n        end else begin\n            m_rd_ptr_gray_nxt = bin2gray(m_rd_ptr + 1);\n            if (m_axis_tvalid && m_axis_tready && !m_empty) begin\n                m_rd_ptr <= m_rd_ptr + 1;\n                m_rd_ptr_gray <= m_rd_ptr_gray_nxt;\n                m_depth <= m_depth - 1;\n                if (m_depth == 0) begin\n                    m_full <= 0;\n                    m_empty <= 1;\n                end else begin\n                    m_full <= 0;\n                    m_empty <= 0;\n                end\n                if (m_axis_tlast) begin\n                    m_depth_commit <= m_depth - 1;\n                    m_good_frame <= 1;\n                end\n            end else begin\n                m_good_frame <= 0;\n            end\n        end\n    end\n\n    // Cross-clock domain synchronization for write pointer\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_wr_ptr_gray_sync <= 0;\n        end else begin\n            s_wr_ptr_gray_sync <= s_wr_ptr_gray;\n        end\n    end\n\n    // Cross-clock domain synchronization for read pointer\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            m_rd_ptr_gray_sync <= 0;\n        end else begin\n            m_rd_ptr_gray_sync <= m_rd_ptr_gray;\n        end\n    end\n\n    // Calculate depth in s_clk domain\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_depth <= 0;\n        end else begin\n            s_depth <= gray2bin(s_wr_ptr_gray) - gray2bin(m_rd_ptr_gray_sync);\n        end\n    end\n\n    // Calculate depth in m_clk domain\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_depth <= 0;\n        end else begin\n            m_depth <= gray2bin(s_wr_ptr_gray_sync) - gray2bin(m_rd_ptr_gray);\n        end\n    end\n\n    // Output FIFO logic (if enabled)\n    reg [DATA_WIDTH-1:0] output_fifo_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] output_fifo_keep [0:DEPTH-1];\n    reg [LAST_ENABLE:0]  output_fifo_last [0:DEPTH-1];\n    reg [ID_ENABLE:0]    output_fifo_id [0:DEPTH-1];\n    reg [DEST_ENABLE:0]  output_fifo_dest [0:DEPTH-1];\n    reg [USER_ENABLE:0]  output_fifo_user [0:DEPTH-1];\n    reg [ADDR_WIDTH:0] output_fifo_wr_ptr, output_fifo_wr_ptr_gray, output_fifo_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] output_fifo_rd_ptr, output_fifo_rd_ptr_gray, output_fifo_rd_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] output_fifo_depth;\n    reg output_fifo_full, output_fifo_empty;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            output_fifo_wr_ptr <= 0;\n            output_fifo_wr_ptr_gray <= 0;\n            output_fifo_depth <= 0;\n            output_fifo_full <= 0;\n            output_fifo_empty <= 1;\n        end else begin\n            output_fifo_wr_ptr_gray_nxt = bin2gray(output_fifo_wr_ptr + 1);\n            if (m_axis_tvalid && m_axis_tready && !output_fifo_full) begin\n                output_fifo_data[output_fifo_wr_ptr] <= m_axis_tdata;\n                if (KEEP_ENABLE) output_fifo_keep[output_fifo_wr_ptr] <= m_axis_tkeep;\n                if (LAST_ENABLE) output_fifo_last[output_fifo_wr_ptr] <= m_axis_tlast;\n                if (ID_ENABLE) output_fifo_id[output_fifo_wr_ptr] <= m_axis_tid;\n                if (DEST_ENABLE) output_fifo_dest[output_fifo_wr_ptr] <= m_axis_tdest;\n                if (USER_ENABLE) output_fifo_user[output_fifo_wr_ptr] <= m_axis_tuser;\n                output_fifo_wr_ptr <= output_fifo_wr_ptr + 1;\n                output_fifo_wr_ptr_gray <= output_fifo_wr_ptr_gray_nxt;\n                output_fifo_depth <= output_fifo_depth + 1;\n                if (output_fifo_depth == DEPTH-1) begin\n                    output_fifo_full <= 1;\n                    output_fifo_empty <= 0;\n                end else begin\n                    output_fifo_full <= 0;\n                    output_fifo_empty <= 0;\n                end\n            end\n            if (m_axis_tvalid && m_axis_tready && !output_fifo_empty) begin\n                output_fifo_depth <= output_fifo_depth - 1;\n                if (output_fifo_depth == 0) begin\n                    output_fifo_full <= 0;\n                    output_fifo_empty <= 1;\n                end else begin\n                    output_fifo_full <= 0;\n                    output_fifo_empty <= 0;\n                end\n            end\n        end\n    end\n\n    // Output FIFO read side\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            output_fifo_rd_ptr <= 0;\n            output_fifo_rd_ptr_gray <= 0;\n        end else begin\n            output_fifo_rd_ptr_gray_nxt = bin2gray(output_fifo_rd_ptr + 1);\n            if (m_axis_tvalid && m_axis_tready && !output_fifo_empty) begin\n                output_fifo_rd_ptr <= output_fifo_rd_ptr + 1;\n                output_fifo_rd_ptr_gray <= output_fifo_rd_ptr_gray_nxt;\n            end\n        end\n    end\n\n    // Output FIFO data selection\n    assign m_axis_tdata = OUTPUT_FIFO_ENABLE ? output_fifo_data[output_fifo_rd_ptr] : mem_data[m_rd_ptr];\n    assign m_axis_tkeep = OUTPUT_FIFO_ENABLE ? output_fifo_keep[output_fifo_rd_ptr] : mem_keep[m_rd_ptr];\n    assign m_axis_tlast = OUTPUT_FIFO_ENABLE ? output_fifo_last[output_fifo_rd_ptr] : mem_last[m_rd_ptr];\n    assign m_axis_tid = OUTPUT_FIFO_ENABLE ? output_fifo_id[output_fifo_rd_ptr] : mem_id[m_rd_ptr];\n    assign m_axis_tdest = OUTPUT_FIFO_ENABLE ? output_fifo_dest[output_fifo_rd_ptr] : mem_dest[m_rd_ptr];\n    assign m_axis_tuser = OUTPUT_FIFO_ENABLE ? output_fifo_user[output_fifo_rd_ptr] : mem_user[m_rd_ptr];\n\n    // Handshake signals\n    assign s_axis_tready = (!s_full || DROP_WHEN_FULL || MARK_WHEN_FULL) && !s_pause_req;\n    assign m_axis_tvalid = (!m_empty || OUTPUT_FIFO_ENABLE) && !m_pause_req;\n\n    // Pause signals\n    assign s_pause_ack = s_pause_req;\n    assign m_pause_ack = m_pause_req;\n\n    // Status signals\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth_commit;\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth_commit;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n\nendmodule\n```<|im_end|>",
