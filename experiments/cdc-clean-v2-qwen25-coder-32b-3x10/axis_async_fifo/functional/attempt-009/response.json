  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n\n    reg [ADDR_WIDTH:0] wptr_s, rptr_s, wptr_m, rptr_m;\n    reg [ADDR_WIDTH:0] wptr_s_gray, rptr_s_gray, wptr_m_gray, rptr_m_gray;\n    reg [ADDR_WIDTH:0] wptr_s_gray_sync, rptr_s_gray_sync, wptr_m_gray_sync, rptr_m_gray_sync;\n\n    reg [DATA_WIDTH-1:0] mem_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] mem_keep [0:DEPTH-1];\n    reg [LAST_ENABLE:0]  mem_last [0:DEPTH-1];\n    reg [ID_ENABLE:0]    mem_id [0:DEPTH-1];\n    reg [DEST_ENABLE:0]  mem_dest [0:DEPTH-1];\n    reg [USER_ENABLE:0]  mem_user [0:DEPTH-1];\n\n    reg [ADDR_WIDTH:0] depth_s, depth_m;\n    reg [ADDR_WIDTH:0] depth_commit_s, depth_commit_m;\n    reg overflow_s, overflow_m;\n    reg bad_frame_s, bad_frame_m;\n    reg good_frame_s, good_frame_m;\n\n    reg pause_s, pause_m;\n    reg pause_s_ack, pause_m_ack;\n\n    // Binary to Gray conversion\n    function [ADDR_WIDTH:0] bin_to_gray;\n        input [ADDR_WIDTH:0] bin;\n        bin_to_gray = bin ^ (bin >> 1);\n    endfunction\n\n    // Gray to Binary conversion\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i >= 0; i = i - 1) begin\n            bin[i] = bin[i] ^ bin[i+1];\n        end\n        gray_to_bin = bin;\n    endfunction\n\n    // Write side logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            wptr_s <= 0;\n            wptr_s_gray <= 0;\n            depth_s <= 0;\n            depth_commit_s <= 0;\n            overflow_s <= 0;\n            bad_frame_s <= 0;\n            good_frame_s <= 0;\n            pause_s <= 0;\n            pause_s_ack <= 0;\n        end else begin\n            if (s_axis_tvalid && s_axis_tready) begin\n                mem_data[wptr_s[ADDR_WIDTH-1:0]] <= s_axis_tdata;\n                if (KEEP_ENABLE) mem_keep[wptr_s[ADDR_WIDTH-1:0]] <= s_axis_tkeep;\n                if (LAST_ENABLE) mem_last[wptr_s[ADDR_WIDTH-1:0]] <= s_axis_tlast;\n                if (ID_ENABLE) mem_id[wptr_s[ADDR_WIDTH-1:0]] <= s_axis_tid;\n                if (DEST_ENABLE) mem_dest[wptr_s[ADDR_WIDTH-1:0]] <= s_axis_tdest;\n                if (USER_ENABLE) mem_user[wptr_s[ADDR_WIDTH-1:0]] <= s_axis_tuser;\n\n                if (s_axis_tlast) begin\n                    depth_commit_s <= depth_s;\n                    if (depth_s > DEPTH) begin\n                        overflow_s <= 1;\n                    end else begin\n                        overflow_s <= 0;\n                    end\n                    if (USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        bad_frame_s <= 1;\n                    end else begin\n                        good_frame_s <= 1;\n                    end\n                end\n\n                wptr_s <= wptr_s + 1;\n                wptr_s_gray <= bin_to_gray(wptr_s + 1);\n            end\n\n            if (FRAME_FIFO && s_axis_tlast) begin\n                depth_s <= 0;\n            end else begin\n                depth_s <= depth_s + (s_axis_tvalid && s_axis_tready) - (m_axis_tvalid && m_axis_tready);\n            end\n\n            if (PAUSE_ENABLE && s_pause_req) begin\n                pause_s <= 1;\n                pause_s_ack <= 1;\n            end else if (pause_s && m_axis_tready) begin\n                pause_s <= 0;\n            end\n        end\n    end\n\n    // Read side logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            rptr_m <= 0;\n            rptr_m_gray <= 0;\n            depth_m <= 0;\n            depth_commit_m <= 0;\n            overflow_m <= 0;\n            bad_frame_m <= 0;\n            good_frame_m <= 0;\n            pause_m <= 0;\n            pause_m_ack <= 0;\n        end else begin\n            if (m_axis_tvalid && m_axis_tready) begin\n                rptr_m <= rptr_m + 1;\n                rptr_m_gray <= bin_to_gray(rptr_m + 1);\n\n                if (m_axis_tlast) begin\n                    depth_commit_m <= depth_m;\n                    if (depth_m > DEPTH) begin\n                        overflow_m <= 1;\n                    end else begin\n                        overflow_m <= 0;\n                    end\n                    if (USER_ENABLE && (m_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        bad_frame_m <= 1;\n                    end else begin\n                        good_frame_m <= 1;\n                    end\n                end\n            end\n\n            if (FRAME_FIFO && m_axis_tlast) begin\n                depth_m <= 0;\n            end else begin\n                depth_m <= depth_m + (s_axis_tvalid && s_axis_tready) - (m_axis_tvalid && m_axis_tready);\n            end\n\n            if (PAUSE_ENABLE && m_pause_req) begin\n                pause_m <= 1;\n                pause_m_ack <= 1;\n            end else if (pause_m && s_axis_tready) begin\n                pause_m <= 0;\n            end\n        end\n    end\n\n    // Gray code synchronization\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            rptr_m_gray_sync <= 0;\n        end else begin\n            rptr_m_gray_sync <= rptr_m_gray;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            wptr_s_gray_sync <= 0;\n        end else begin\n            wptr_s_gray_sync <= wptr_s_gray;\n        end\n    end\n\n    // Status signals\n    assign s_status_depth = depth_s;\n    assign s_status_depth_commit = depth_commit_s;\n    assign s_status_overflow = overflow_s;\n    assign s_status_bad_frame = bad_frame_s;\n    assign s_status_good_frame = good_frame_s;\n\n    assign m_status_depth = depth_m;\n    assign m_status_depth_commit = depth_commit_m;\n    assign m_status_overflow = overflow_m;\n    assign m_status_bad_frame = bad_frame_m;\n    assign m_status_good_frame = good_frame_m;\n\n    // Pause signals\n    assign s_pause_ack = pause_s_ack;\n    assign m_pause_ack = pause_m_ack;\n\n    // Handshake signals\n    assign s_axis_tready = (!pause_s && (depth_s < DEPTH || MARK_WHEN_FULL)) || DROP_WHEN_FULL;\n    assign m_axis_tvalid = (!pause_m && (depth_m > 0));\n\n    // Output signals\n    assign m_axis_tdata = mem_data[rptr_m[ADDR_WIDTH-1:0]];\n    assign m_axis_tkeep = KEEP_ENABLE ? mem_keep[rptr_m[ADDR_WIDTH-1:0]] : {KEEP_WIDTH{1'b1}};\n    assign m_axis_tlast = LAST_ENABLE ? mem_last[rptr_m[ADDR_WIDTH-1:0]] : 1'b0;\n    assign m_axis_tid = ID_ENABLE ? mem_id[rptr_m[ADDR_WIDTH-1:0]] : {ID_WIDTH{1'b0}};\n    assign m_axis_tdest = DEST_ENABLE ? mem_dest[rptr_m[ADDR_WIDTH-1:0]] : {DEST_WIDTH{1'b0}};\n    assign m_axis_tuser = USER_ENABLE ? mem_user[rptr_m[ADDR_WIDTH-1:0]] : {USER_WIDTH{1'b0}};\n\nendmodule\n```<|im_end|>",
