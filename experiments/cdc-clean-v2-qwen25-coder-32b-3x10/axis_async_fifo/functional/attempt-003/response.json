  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n\n    reg [ADDR_WIDTH:0] wptr_s, wptr_m;\n    reg [ADDR_WIDTH:0] rptr_s, rptr_m;\n    reg [ADDR_WIDTH:0] wptr_gray_s, wptr_gray_m;\n    reg [ADDR_WIDTH:0] rptr_gray_s, rptr_gray_m;\n\n    reg [DATA_WIDTH-1:0] mem_data [DEPTH-1:0];\n    reg [KEEP_WIDTH-1:0] mem_keep [DEPTH-1:0];\n    reg [LAST_ENABLE:0]  mem_last [DEPTH-1:0];\n    reg [ID_ENABLE:0]    mem_id [DEPTH-1:0];\n    reg [DEST_ENABLE:0]  mem_dest [DEPTH-1:0];\n    reg [USER_ENABLE:0]  mem_user [DEPTH-1:0];\n\n    reg [ADDR_WIDTH:0] depth_s, depth_m;\n    reg [ADDR_WIDTH:0] depth_commit_s, depth_commit_m;\n    reg overflow_s, overflow_m;\n    reg bad_frame_s, bad_frame_m;\n    reg good_frame_s, good_frame_m;\n\n    reg pause_s, pause_m;\n    reg pause_ack_s, pause_ack_m;\n\n    // Gray code conversion\n    function [ADDR_WIDTH:0] bin2gray;\n        input [ADDR_WIDTH:0] bin;\n        bin2gray = bin ^ (bin >> 1);\n    endfunction\n\n    // Binary code conversion\n    function [ADDR_WIDTH:0] gray2bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i >= 0; i = i - 1) begin\n            bin[i] = bin[i] ^ bin[i+1];\n        end\n        gray2bin = bin;\n    endfunction\n\n    // Write pointer logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            wptr_s <= 0;\n            wptr_gray_s <= 0;\n        end else if (s_axis_tvalid && s_axis_tready) begin\n            wptr_s <= wptr_s + 1;\n            wptr_gray_s <= bin2gray(wptr_s + 1);\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            wptr_m <= 0;\n            wptr_gray_m <= 0;\n        end else if (m_axis_tvalid && m_axis_tready) begin\n            wptr_m <= wptr_m + 1;\n            wptr_gray_m <= bin2gray(wptr_m + 1);\n        end\n    end\n\n    // Read pointer logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            rptr_s <= 0;\n            rptr_gray_s <= 0;\n        end else if (m_axis_tvalid && m_axis_tready) begin\n            rptr_s <= rptr_s + 1;\n            rptr_gray_s <= bin2gray(rptr_s + 1);\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            rptr_m <= 0;\n            rptr_gray_m <= 0;\n        end else if (s_axis_tvalid && s_axis_tready) begin\n            rptr_m <= rptr_m + 1;\n            rptr_gray_m <= bin2gray(rptr_m + 1);\n        end\n    end\n\n    // Memory write logic\n    always @(posedge s_clk) begin\n        if (s_axis_tvalid && s_axis_tready) begin\n            mem_data[gray2bin(wptr_gray_s)] <= s_axis_tdata;\n            mem_keep[gray2bin(wptr_gray_s)] <= s_axis_tkeep;\n            mem_last[gray2bin(wptr_gray_s)] <= s_axis_tlast;\n            mem_id[gray2bin(wptr_gray_s)] <= s_axis_tid;\n            mem_dest[gray2bin(wptr_gray_s)] <= s_axis_tdest;\n            mem_user[gray2bin(wptr_gray_s)] <= s_axis_tuser;\n        end\n    end\n\n    // Memory read logic\n    always @(posedge m_clk) begin\n        if (m_axis_tvalid && m_axis_tready) begin\n            m_axis_tdata <= mem_data[gray2bin(rptr_gray_m)];\n            m_axis_tkeep <= mem_keep[gray2bin(rptr_gray_m)];\n            m_axis_tlast <= mem_last[gray2bin(rptr_gray_m)];\n            m_axis_tid <= mem_id[gray2bin(rptr_gray_m)];\n            m_axis_tdest <= mem_dest[gray2bin(rptr_gray_m)];\n            m_axis_tuser <= mem_user[gray2bin(rptr_gray_m)];\n        end\n    end\n\n    // Depth calculation\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            depth_s <= 0;\n            depth_commit_s <= 0;\n            overflow_s <= 0;\n            bad_frame_s <= 0;\n            good_frame_s <= 0;\n        end else begin\n            depth_s <= wptr_s - rptr_s;\n            depth_commit_s <= depth_s;\n            overflow_s <= (depth_s >= DEPTH);\n            bad_frame_s <= (USER_ENABLE && (mem_user[gray2bin(wptr_gray_s)] & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE);\n            good_frame_s <= (USER_ENABLE && (mem_user[gray2bin(wptr_gray_s)] & USER_BAD_FRAME_MASK) != USER_BAD_FRAME_VALUE);\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            depth_m <= 0;\n            depth_commit_m <= 0;\n            overflow_m <= 0;\n            bad_frame_m <= 0;\n            good_frame_m <= 0;\n        end else begin\n            depth_m <= wptr_m - rptr_m;\n            depth_commit_m <= depth_m;\n            overflow_m <= (depth_m >= DEPTH);\n            bad_frame_m <= (USER_ENABLE && (mem_user[gray2bin(wptr_gray_m)] & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE);\n            good_frame_m <= (USER_ENABLE && (mem_user[gray2bin(wptr_gray_m)] & USER_BAD_FRAME_MASK) != USER_BAD_FRAME_VALUE);\n        end\n    end\n\n    // Handshake logic\n    assign s_axis_tready = (!overflow_s && !pause_s) || MARK_WHEN_FULL;\n    assign m_axis_tvalid = (depth_m > 0) && !pause_m;\n\n    // Pause logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            pause_s <= 0;\n            pause_ack_s <= 0;\n        end else begin\n            pause_s <= s_pause_req;\n            pause_ack_s <= s_pause_req;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            pause_m <= 0;\n            pause_ack_m <= 0;\n        end else begin\n            pause_m <= m_pause_req;\n            pause_ack_m <= m_pause_req;\n        end\n    end\n\n    // Status outputs\n    assign s_status_depth = depth_s;\n    assign s_status_depth_commit = depth_commit_s;\n    assign s_status_overflow = overflow_s;\n    assign s_status_bad_frame = bad_frame_s;\n    assign s_status_good_frame = good_frame_s;\n\n    assign m_status_depth = depth_m;\n    assign m_status_depth_commit = depth_commit_m;\n    assign m_status_overflow = overflow_m;\n    assign m_status_bad_frame = bad_frame_m;\n    assign m_status_good_frame = good_frame_m;\n\n    // Pause ack outputs\n    assign s_pause_ack = pause_ack_s;\n    assign m_pause_ack = pause_ack_m;\n\nendmodule\n```<|im_end|>",
