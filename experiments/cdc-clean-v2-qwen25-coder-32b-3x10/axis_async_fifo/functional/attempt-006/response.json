  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n\n    reg [ADDR_WIDTH:0] s_wr_ptr, s_wr_ptr_gray, s_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] s_rd_ptr, s_rd_ptr_gray, s_rd_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] m_wr_ptr, m_wr_ptr_gray, m_wr_ptr_gray_nxt;\n    reg [ADDR_WIDTH:0] m_rd_ptr, m_rd_ptr_gray, m_rd_ptr_gray_nxt;\n\n    reg [DATA_WIDTH-1:0] mem_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] mem_keep [0:DEPTH-1];\n    reg [LAST_ENABLE-1:0] mem_last [0:DEPTH-1];\n    reg [ID_ENABLE*ID_WIDTH-1:0] mem_id [0:DEPTH-1];\n    reg [DEST_ENABLE*DEST_WIDTH-1:0] mem_dest [0:DEPTH-1];\n    reg [USER_ENABLE*USER_WIDTH-1:0] mem_user [0:DEPTH-1];\n\n    reg s_axis_tready_reg;\n    reg m_axis_tvalid_reg;\n    reg s_pause_ack_reg;\n    reg m_pause_ack_reg;\n\n    reg s_status_overflow_reg;\n    reg s_status_bad_frame_reg;\n    reg s_status_good_frame_reg;\n    reg m_status_overflow_reg;\n    reg m_status_bad_frame_reg;\n    reg m_status_good_frame_reg;\n\n    reg [ADDR_WIDTH:0] s_depth, s_depth_commit;\n    reg [ADDR_WIDTH:0] m_depth, m_depth_commit;\n\n    // Binary to Gray conversion\n    function [ADDR_WIDTH:0] bin_to_gray;\n        input [ADDR_WIDTH:0] bin;\n        bin_to_gray = bin ^ (bin >> 1);\n    endfunction\n\n    // Gray to Binary conversion\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        reg [ADDR_WIDTH:0] bin;\n        bin = gray;\n        for (i = ADDR_WIDTH-1; i >= 0; i = i - 1) begin\n            bin[i] = bin[i+1] ^ bin[i];\n        end\n        gray_to_bin = bin;\n    endfunction\n\n    // Synchronous write side\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= 0;\n            s_wr_ptr_gray <= 0;\n            s_wr_ptr_gray_nxt <= 0;\n            s_status_overflow_reg <= 0;\n            s_status_bad_frame_reg <= 0;\n            s_status_good_frame_reg <= 0;\n            s_depth <= 0;\n            s_depth_commit <= 0;\n        end else begin\n            s_wr_ptr_gray_nxt <= bin_to_gray(s_wr_ptr + 1);\n            if (s_axis_tvalid && s_axis_tready_reg) begin\n                mem_data[s_wr_ptr] <= s_axis_tdata;\n                mem_keep[s_wr_ptr] <= s_axis_tkeep;\n                mem_last[s_wr_ptr] <= s_axis_tlast;\n                if (ID_ENABLE) mem_id[s_wr_ptr] <= s_axis_tid;\n                if (DEST_ENABLE) mem_dest[s_wr_ptr] <= s_axis_tdest;\n                if (USER_ENABLE) mem_user[s_wr_ptr] <= s_axis_tuser;\n                s_wr_ptr <= s_wr_ptr + 1;\n                s_wr_ptr_gray <= s_wr_ptr_gray_nxt;\n                s_depth <= s_depth + 1;\n                if (s_axis_tlast) begin\n                    s_depth_commit <= s_depth + 1;\n                    if (USER_ENABLE && (mem_user[s_wr_ptr] & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        s_status_bad_frame_reg <= 1;\n                    end else begin\n                        s_status_good_frame_reg <= 1;\n                    end\n                end\n                if (s_depth == DEPTH - 1) begin\n                    s_status_overflow_reg <= 1;\n                end\n            end\n        end\n    end\n\n    // Synchronous read side\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= 0;\n            m_rd_ptr_gray <= 0;\n            m_rd_ptr_gray_nxt <= 0;\n            m_status_bad_frame_reg <= 0;\n            m_status_good_frame_reg <= 0;\n            m_depth <= 0;\n            m_depth_commit <= 0;\n        end else begin\n            m_rd_ptr_gray_nxt <= bin_to_gray(m_rd_ptr + 1);\n            if (m_axis_tvalid_reg && m_axis_tready) begin\n                m_rd_ptr <= m_rd_ptr + 1;\n                m_rd_ptr_gray <= m_rd_ptr_gray_nxt;\n                m_depth <= m_depth - 1;\n                if (m_axis_tlast) begin\n                    m_depth_commit <= m_depth - 1;\n                    if (USER_ENABLE && (mem_user[m_rd_ptr] & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        m_status_bad_frame_reg <= 1;\n                    end else begin\n                        m_status_good_frame_reg <= 1;\n                    end\n                end\n            end\n        end\n    end\n\n    // Cross-clock domain synchronization for write pointer\n    reg [ADDR_WIDTH:0] s_wr_ptr_gray_sync;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_wr_ptr_gray_sync <= 0;\n        end else begin\n            s_wr_ptr_gray_sync <= s_wr_ptr_gray;\n        end\n    end\n\n    // Cross-clock domain synchronization for read pointer\n    reg [ADDR_WIDTH:0] m_rd_ptr_gray_sync;\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            m_rd_ptr_gray_sync <= 0;\n        end else begin\n            m_rd_ptr_gray_sync <= m_rd_ptr_gray;\n        end\n    end\n\n    // Calculate depth and depth_commit\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_depth <= 0;\n            s_depth_commit <= 0;\n        end else begin\n            if (s_axis_tvalid && s_axis_tready_reg) begin\n                s_depth <= s_depth + 1;\n                if (s_axis_tlast) begin\n                    s_depth_commit <= s_depth + 1;\n                end\n            end\n            if (m_axis_tvalid_reg && m_axis_tready) begin\n                s_depth <= s_depth - 1;\n                if (m_axis_tlast) begin\n                    s_depth_commit <= s_depth - 1;\n                end\n            end\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_depth <= 0;\n            m_depth_commit <= 0;\n        end else begin\n            if (s_axis_tvalid && s_axis_tready_reg) begin\n                m_depth <= m_depth + 1;\n                if (s_axis_tlast) begin\n                    m_depth_commit <= m_depth + 1;\n                end\n            end\n            if (m_axis_tvalid_reg && m_axis_tready) begin\n                m_depth <= m_depth - 1;\n                if (m_axis_tlast) begin\n                    m_depth_commit <= m_depth - 1;\n                end\n            end\n        end\n    end\n\n    // Calculate s_axis_tready\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_axis_tready_reg <= 0;\n        end else begin\n            if (DROP_WHEN_FULL) begin\n                s_axis_tready_reg <= 1;\n            end else if (MARK_WHEN_FULL) begin\n                s_axis_tready_reg <= (s_depth < DEPTH - 1);\n            end else begin\n                s_axis_tready_reg <= (s_depth < DEPTH);\n            end\n        end\n    end\n\n    // Calculate m_axis_tvalid\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_axis_tvalid_reg <= 0;\n        end else begin\n            m_axis_tvalid_reg <= (m_depth > 0);\n        end\n    end\n\n    // Output data\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_axis_tdata <= 0;\n            m_axis_tkeep <= 0;\n            m_axis_tlast <= 0;\n            m_axis_tid <= 0;\n            m_axis_tdest <= 0;\n            m_axis_tuser <= 0;\n        end else begin\n            if (m_axis_tvalid_reg && m_axis_tready) begin\n                m_axis_tdata <= mem_data[m_rd_ptr];\n                m_axis_tkeep <= mem_keep[m_rd_ptr];\n                m_axis_tlast <= mem_last[m_rd_ptr];\n                if (ID_ENABLE) m_axis_tid <= mem_id[m_rd_ptr];\n                if (DEST_ENABLE) m_axis_tdest <= mem_dest[m_rd_ptr];\n                if (USER_ENABLE) m_axis_tuser <= mem_user[m_rd_ptr];\n            end\n        end\n    end\n\n    // Pause signals\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_pause_ack_reg <= 0;\n        end else begin\n            s_pause_ack_reg <= s_pause_req;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_pause_ack_reg <= 0;\n        end else begin\n            m_pause_ack_reg <= m_pause_req;\n        end\n    end\n\n    // Status outputs\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth_commit;\n    assign s_status_overflow = s_status_overflow_reg;\n    assign s_status_bad_frame = s_status_bad_frame_reg;\n    assign s_status_good_frame = s_status_good_frame_reg;\n\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth_commit;\n    assign m_status_overflow = m_status_overflow_reg;\n    assign m_status_bad_frame = m_status_bad_frame_reg;\n    assign m_status_good_frame = m_status_good_frame_reg;\n\n    // Output ready and valid\n    assign s_axis_tready = s_axis_tready_reg;\n    assign m_axis_tvalid = m_axis_tvalid_reg;\n    assign s_pause_ack = s_pause_ack_reg;\n    assign m_pause_ack = m_pause_ack_reg;\n\nendmodule\n```<|im_end|>",
