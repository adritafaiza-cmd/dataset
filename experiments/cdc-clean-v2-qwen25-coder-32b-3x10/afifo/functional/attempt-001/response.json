  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam AW = LGFIFO;\n\n\treg [AW:0] wptr_gray, wptr_gray_nxt, wptr_gray_sync;\n\treg [AW:0] rptr_gray, rptr_gray_nxt, rptr_gray_sync;\n\treg [AW:0] wptr_bin, rptr_bin;\n\n\t// Gray code to binary conversion\n\tfunction [AW:0] gray2bin;\n\t\tinput [AW:0] gray;\n\t\tinteger i;\n\t\treg [AW:0] bin;\n\t\tbegin\n\t\t\tbin = gray[AW];\n\t\t\tfor (i = AW-1; i >= 0; i = i - 1) begin\n\t\t\t\tbin[i] = bin[i+1] ^ gray[i];\n\t\t\tend\n\t\t\tgray2bin = bin;\n\t\tend\n\tendfunction\n\n\t// Binary to gray code conversion\n\tfunction [AW:0] bin2gray;\n\t\tinput [AW:0] bin;\n\t\tbegin\n\t\t\tbin2gray = bin ^ (bin >> 1);\n\t\tend\n\tendfunction\n\n\t// Write pointer logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twptr_gray <= 0;\n\t\t\to_wr_full <= 0;\n\t\tend else begin\n\t\t\twptr_gray <= wptr_gray_nxt;\n\t\t\to_wr_full <= (wptr_gray_nxt == {~rptr_gray_sync[AW], rptr_gray_sync[AW-1:0]});\n\t\tend\n\tend\n\n\talways @(*) begin\n\t\tif (WRITE_ON_POSEDGE)\n\t\t\twptr_gray_nxt = i_wr & ~o_wr_full ? bin2gray(wptr_bin + 1) : wptr_gray;\n\t\telse\n\t\t\twptr_gray_nxt = bin2gray(wptr_bin);\n\tend\n\n\talways @(posedge i_wclk) begin\n\t\tif (i_wr & ~o_wr_full)\n\t\t\twptr_bin <= wptr_bin + 1;\n\tend\n\n\t// Read pointer logic\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trptr_gray <= 0;\n\t\t\to_rd_empty <= 1;\n\t\tend else begin\n\t\t\trptr_gray <= rptr_gray_nxt;\n\t\t\to_rd_empty <= (rptr_gray_nxt == wptr_gray_sync);\n\t\tend\n\tend\n\n\talways @(*) begin\n\t\trptr_gray_nxt = i_rd & ~o_rd_empty ? bin2gray(rptr_bin + 1) : rptr_gray;\n\tend\n\n\talways @(posedge i_rclk) begin\n\t\tif (i_rd & ~o_rd_empty)\n\t\t\trptr_bin <= rptr_bin + 1;\n\tend\n\n\t// Synchronize pointers\n\tgenerate\n\t\tgenvar i;\n\t\tfor (i = 0; i < NFF; i = i + 1) begin : sync_wptr\n\t\t\tif (i == 0) begin\n\t\t\t\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\t\t\t\tif (!i_rd_reset_n)\n\t\t\t\t\t\twptr_gray_sync <= 0;\n\t\t\t\t\telse\n\t\t\t\t\t\twptr_gray_sync <= wptr_gray;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\t\t\t\tif (!i_rd_reset_n)\n\t\t\t\t\t\twptr_gray_sync <= 0;\n\t\t\t\t\telse\n\t\t\t\t\t\twptr_gray_sync <= wptr_gray_sync;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tfor (i = 0; i < NFF; i = i + 1) begin : sync_rptr\n\t\t\tif (i == 0) begin\n\t\t\t\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\t\t\t\tif (!i_wr_reset_n)\n\t\t\t\t\t\trptr_gray_sync <= 0;\n\t\t\t\t\telse\n\t\t\t\t\t\trptr_gray_sync <= rptr_gray;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\t\t\t\tif (!i_wr_reset_n)\n\t\t\t\t\t\trptr_gray_sync <= 0;\n\t\t\t\t\telse\n\t\t\t\t\t\trptr_gray_sync <= rptr_gray_sync;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tendgenerate\n\n\t// Memory\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\n\talways @(posedge i_wclk) begin\n\t\tif (i_wr & ~o_wr_full)\n\t\t\tmem[wptr_bin[AW-1:0]] <= i_wr_data;\n\tend\n\n\t// Read data\n\treg [WIDTH-1:0] rd_data;\n\n\talways @(posedge i_rclk) begin\n\t\tif (i_rd & ~o_rd_empty)\n\t\t\trd_data <= mem[rptr_bin[AW-1:0]];\n\tend\n\n\t// Output register\n\tgenerate\n\t\tif (OPT_REGISTER_READS) begin\n\t\t\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\t\t\tif (!i_rd_reset_n)\n\t\t\t\t\to_rd_data <= 0;\n\t\t\t\telse\n\t\t\t\t\to_rd_data <= rd_data;\n\t\t\tend\n\t\tend else begin\n\t\t\tassign o_rd_data = rd_data;\n\t\tend\n\tendgenerate\n\nendmodule\n```<|im_end|>",
