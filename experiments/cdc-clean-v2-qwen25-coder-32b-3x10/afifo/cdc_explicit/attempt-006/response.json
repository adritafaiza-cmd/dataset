  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam ADDR_WIDTH = LGFIFO;\n\n\treg [ADDR_WIDTH-1:0] wr_ptr, wr_ptr_gray, wr_ptr_gray_sync;\n\treg [ADDR_WIDTH-1:0] rd_ptr, rd_ptr_gray, rd_ptr_gray_sync;\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\n\t// Write side logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= 0;\n\t\t\twr_ptr_gray <= 0;\n\t\t\to_wr_full <= 1'b0;\n\t\tend else begin\n\t\t\tif (i_wr && !o_wr_full) begin\n\t\t\t\tif (WRITE_ON_POSEDGE) begin\n\t\t\t\t\tmem[wr_ptr] <= i_wr_data;\n\t\t\t\t\twr_ptr <= wr_ptr + 1;\n\t\t\t\tend else begin\n\t\t\t\t\tmem[wr_ptr + 1] <= i_wr_data;\n\t\t\t\t\twr_ptr <= wr_ptr + 1;\n\t\t\t\tend\n\t\t\tend\n\t\t\twr_ptr_gray <= wr_ptr ^ (wr_ptr >> 1);\n\t\tend\n\tend\n\n\t// Gray code synchronization for write pointer\n\tgenerate\n\t\tgenvar i;\n\t\tfor (i = 0; i < NFF; i = i + 1) begin : sync_wr_ptr_gray\n\t\t\treg [ADDR_WIDTH-1:0] wr_ptr_gray_sync_stage;\n\t\t\tif (i == 0) begin\n\t\t\t\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\t\t\t\tif (!i_rd_reset_n)\n\t\t\t\t\t\twr_ptr_gray_sync_stage <= 0;\n\t\t\t\t\telse\n\t\t\t\t\t\twr_ptr_gray_sync_stage <= wr_ptr_gray;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\t\t\t\tif (!i_rd_reset_n)\n\t\t\t\t\t\twr_ptr_gray_sync_stage <= 0;\n\t\t\t\t\telse\n\t\t\t\t\t\twr_ptr_gray_sync_stage <= wr_ptr_gray_sync[i-1];\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (i == NFF - 1)\n\t\t\t\tassign wr_ptr_gray_sync = wr_ptr_gray_sync_stage;\n\t\tend\n\tendgenerate\n\n\t// Read side logic\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= 0;\n\t\t\trd_ptr_gray <= 0;\n\t\t\to_rd_empty <= 1'b1;\n\t\tend else begin\n\t\t\tif (i_rd && !o_rd_empty) begin\n\t\t\t\trd_ptr <= rd_ptr + 1;\n\t\t\tend\n\t\t\trd_ptr_gray <= rd_ptr ^ (rd_ptr >> 1);\n\t\tend\n\tend\n\n\t// Gray code synchronization for read pointer\n\tgenerate\n\t\tgenvar j;\n\t\tfor (j = 0; j < NFF; j = j + 1) begin : sync_rd_ptr_gray\n\t\t\treg [ADDR_WIDTH-1:0] rd_ptr_gray_sync_stage;\n\t\t\tif (j == 0) begin\n\t\t\t\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\t\t\t\tif (!i_wr_reset_n)\n\t\t\t\t\t\trd_ptr_gray_sync_stage <= 0;\n\t\t\t\t\telse\n\t\t\t\t\t\trd_ptr_gray_sync_stage <= rd_ptr_gray;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\t\t\t\tif (!i_wr_reset_n)\n\t\t\t\t\t\trd_ptr_gray_sync_stage <= 0;\n\t\t\t\t\telse\n\t\t\t\t\t\trd_ptr_gray_sync_stage <= rd_ptr_gray_sync[j-1];\n\t\t\t\tend\n\t\t\tend\n\t\t\tif (j == NFF - 1)\n\t\t\t\tassign rd_ptr_gray_sync = rd_ptr_gray_sync_stage;\n\t\tend\n\tendgenerate\n\n\t// Binary conversion and full/empty flags\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\to_wr_full <= 1'b0;\n\t\tend else begin\n\t\t\to_wr_full <= (wr_ptr_gray_sync == (rd_ptr_gray + 1) ^ (rd_ptr_gray >> 1));\n\t\tend\n\tend\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\to_rd_empty <= 1'b1;\n\t\tend else begin\n\t\t\to_rd_empty <= (wr_ptr_gray_sync == rd_ptr_gray);\n\t\tend\n\tend\n\n\t// Read data output\n\treg [WIDTH-1:0] rd_data_sync;\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_data_sync <= 0;\n\t\tend else begin\n\t\t\tif (i_rd && !o_rd_empty) begin\n\t\t\t\trd_data_sync <= mem[rd_ptr];\n\t\t\tend\n\t\tend\n\tend\n\n\t// Optional additional register for read data\n\tgenerate\n\t\tif (OPT_REGISTER_READS) begin\n\t\t\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\t\t\tif (!i_rd_reset_n) begin\n\t\t\t\t\to_rd_data <= 0;\n\t\t\t\tend else begin\n\t\t\t\t\to_rd_data <= rd_data_sync;\n\t\t\t\tend\n\t\t\tend\n\t\tend else begin\n\t\t\tassign o_rd_data = rd_data_sync;\n\t\tend\n\tendgenerate\n\nendmodule\n```<|im_end|>",
