  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam DEPTH = 2**LGFIFO;\n\tlocalparam ADDR_WIDTH = LGFIFO;\n\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\treg [ADDR_WIDTH:0] wr_ptr, rd_ptr;\n\treg [ADDR_WIDTH:0] wr_ptr_gray, rd_ptr_gray;\n\treg [ADDR_WIDTH:0] wr_ptr_gray_sync, rd_ptr_gray_sync;\n\n\t// Write Pointer Logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= 0;\n\t\t\to_wr_full <= 1'b0;\n\t\tend else if (i_wr && !o_wr_full) begin\n\t\t\tmem[wr_ptr[ADDR_WIDTH-1:0]] <= i_wr_data;\n\t\t\twr_ptr <= wr_ptr + 1;\n\t\tend\n\tend\n\n\t// Read Pointer Logic\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= 0;\n\t\t\to_rd_empty <= 1'b1;\n\t\tend else if (i_rd && !o_rd_empty) begin\n\t\t\trd_ptr <= rd_ptr + 1;\n\t\tend\n\tend\n\n\t// Gray Code Conversion\n\tassign wr_ptr_gray = (wr_ptr >> 1) ^ wr_ptr;\n\tassign rd_ptr_gray = (rd_ptr >> 1) ^ rd_ptr;\n\n\t// Gray Code Synchronization\n\tsync_gray_code sync_wr (\n\t\t.clk(i_rclk),\n\t\t.reset_n(i_rd_reset_n),\n\t\t.async_in(wr_ptr_gray),\n\t\t.sync_out(wr_ptr_gray_sync)\n\t);\n\n\tsync_gray_code sync_rd (\n\t\t.clk(i_wclk),\n\t\t.reset_n(i_wr_reset_n),\n\t\t.async_in(rd_ptr_gray),\n\t\t.sync_out(rd_ptr_gray_sync)\n\t);\n\n\t// Full and Empty Flags\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\to_wr_full <= 1'b0;\n\t\tend else begin\n\t\t\to_wr_full <= (wr_ptr_gray_sync[ADDR_WIDTH] != wr_ptr_gray[ADDR_WIDTH]) &&\n\t\t\t\t\t(wr_ptr_gray_sync[ADDR_WIDTH-1:0] == wr_ptr[ADDR_WIDTH-1:0]);\n\t\tend\n\tend\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\to_rd_empty <= 1'b1;\n\t\tend else begin\n\t\t\to_rd_empty <= (rd_ptr_gray_sync[ADDR_WIDTH] != rd_ptr_gray[ADDR_WIDTH]) &&\n\t\t\t\t\t(rd_ptr_gray_sync[ADDR_WIDTH-1:0] == rd_ptr[ADDR_WIDTH-1:0]);\n\t\tend\n\tend\n\n\t// Read Data Output\n\treg [WIDTH-1:0] rd_data_reg;\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_data_reg <= 0;\n\t\tend else if (i_rd && !o_rd_empty) begin\n\t\t\trd_data_reg <= mem[rd_ptr[ADDR_WIDTH-1:0]];\n\t\tend\n\tend\n\n\tassign o_rd_data = OPT_REGISTER_READS ? rd_data_reg : mem[rd_ptr[ADDR_WIDTH-1:0]];\n\nendmodule\n\nmodule sync_gray_code (\n\t\tinput\twire\t\t\tclk,\n\t\tinput\twire\t\t\treset_n,\n\t\tinput\twire [ADDR_WIDTH:0]\tasync_in,\n\t\toutput\treg [ADDR_WIDTH:0]\tsync_out\n\t);\n\n\treg [ADDR_WIDTH:0] sync_reg1, sync_reg2;\n\n\talways @(posedge clk or negedge reset_n) begin\n\t\tif (!reset_n) begin\n\t\t\tsync_reg1 <= 0;\n\t\t\tsync_reg2 <= 0;\n\t\tend else begin\n\t\t\tsync_reg1 <= async_in;\n\t\t\tsync_reg2 <= sync_reg1;\n\t\tend\n\tend\n\n\tassign sync_out = sync_reg2;\n\nendmodule\n```<|im_end|>",
