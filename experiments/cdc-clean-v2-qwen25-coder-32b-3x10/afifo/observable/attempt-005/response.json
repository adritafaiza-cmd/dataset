  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam DEPTH = 2**LGFIFO;\n\tlocalparam ADDR_WIDTH = LGFIFO;\n\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\treg [ADDR_WIDTH:0] wr_ptr, rd_ptr;\n\treg [ADDR_WIDTH:0] wr_ptr_gray, rd_ptr_gray;\n\treg [ADDR_WIDTH:0] wr_ptr_gray_sync, rd_ptr_gray_sync;\n\n\t// Write side logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= 0;\n\t\t\to_wr_full <= 1'b0;\n\t\tend else begin\n\t\t\tif (i_wr && !o_wr_full) begin\n\t\t\t\tmem[wr_ptr[ADDR_WIDTH-1:0]] <= i_wr_data;\n\t\t\t\twr_ptr <= wr_ptr + 1;\n\t\t\tend\n\t\t\to_wr_full <= (wr_ptr_gray_sync[ADDR_WIDTH] != rd_ptr_gray[ADDR_WIDTH]) && (wr_ptr_gray_sync[ADDR_WIDTH-1:0] == rd_ptr_gray[ADDR_WIDTH-1:0]);\n\t\tend\n\tend\n\n\t// Convert wr_ptr to gray code\n\talways @(wr_ptr) begin\n\t\twr_ptr_gray = (wr_ptr >> 1) ^ wr_ptr;\n\tend\n\n\t// Synchronize wr_ptr_gray to read domain\n\tgenerate\n\t\tgenvar i;\n\t\tfor (i = 0; i < NFF; i = i + 1) begin : sync_wr_ptr_gray\n\t\t\treg [ADDR_WIDTH:0] ff;\n\t\t\tif (i == 0) begin\n\t\t\t\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\t\t\t\tif (!i_rd_reset_n) begin\n\t\t\t\t\t\tff <= 0;\n\t\t\t\t\tend else begin\n\t\t\t\t\t\tff <= wr_ptr_gray;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\t\t\t\tif (!i_rd_reset_n) begin\n\t\t\t\t\t\tff <= 0;\n\t\t\t\t\tend else begin\n\t\t\t\t\t\tff <= sync_wr_ptr_gray[i-1].ff;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tassign wr_ptr_gray_sync = sync_wr_ptr_gray[NFF-1].ff;\n\t\tend\n\tendgenerate\n\n\t// Read side logic\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= 0;\n\t\t\to_rd_empty <= 1'b1;\n\t\tend else begin\n\t\t\tif (i_rd && !o_rd_empty) begin\n\t\t\t\trd_ptr <= rd_ptr + 1;\n\t\t\tend\n\t\t\to_rd_empty <= (wr_ptr_gray[ADDR_WIDTH] == rd_ptr_gray_sync[ADDR_WIDTH]) && (wr_ptr_gray[ADDR_WIDTH-1:0] == rd_ptr_gray_sync[ADDR_WIDTH-1:0]);\n\t\tend\n\tend\n\n\t// Convert rd_ptr to gray code\n\talways @(rd_ptr) begin\n\t\trd_ptr_gray = (rd_ptr >> 1) ^ rd_ptr;\n\tend\n\n\t// Synchronize rd_ptr_gray to write domain\n\tgenerate\n\t\tgenvar j;\n\t\tfor (j = 0; j < NFF; j = j + 1) begin : sync_rd_ptr_gray\n\t\t\treg [ADDR_WIDTH:0] ff;\n\t\t\tif (j == 0) begin\n\t\t\t\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\t\t\t\tif (!i_wr_reset_n) begin\n\t\t\t\t\t\tff <= 0;\n\t\t\t\t\tend else begin\n\t\t\t\t\t\tff <= rd_ptr_gray;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\t\t\t\tif (!i_wr_reset_n) begin\n\t\t\t\t\t\tff <= 0;\n\t\t\t\t\tend else begin\n\t\t\t\t\t\tff <= sync_rd_ptr_gray[j-1].ff;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\tassign rd_ptr_gray_sync = sync_rd_ptr_gray[NFF-1].ff;\n\t\tend\n\tendgenerate\n\n\t// Read data output\n\treg [WIDTH-1:0] rd_data_reg;\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_data_reg <= 0;\n\t\tend else if (i_rd && !o_rd_empty) begin\n\t\t\trd_data_reg <= mem[rd_ptr[ADDR_WIDTH-1:0]];\n\t\tend\n\tend\n\n\t// Output selection based on OPT_REGISTER_READS\n\tassign o_rd_data = OPT_REGISTER_READS ? rd_data_reg : mem[rd_ptr[ADDR_WIDTH-1:0]];\n\nendmodule\n```<|im_end|>",
