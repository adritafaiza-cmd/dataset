  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    reg [WIDTH-1:0] mem [DEPTH-1:0];\n    reg [ADDR_WIDTH:0] src_wr_ptr, src_wr_ptr_gray, src_wr_ptr_gray_sync;\n    reg [ADDR_WIDTH:0] dst_rd_ptr, dst_rd_ptr_gray, dst_rd_ptr_gray_sync;\n    reg [ADDR_WIDTH:0] dst_wr_ptr_gray_sync;\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= 0;\n        end else if (src_valid_i && src_ready_o) begin\n            src_wr_ptr <= src_wr_ptr + 1;\n        end\n    end\n\n    // Convert write pointer to Gray code\n    assign src_wr_ptr_gray = (src_wr_ptr >> 1) ^ src_wr_ptr;\n\n    // Synchronize Gray code write pointer to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_gray_sync <= 0;\n        end else begin\n            src_wr_ptr_gray_sync <= src_wr_ptr_gray;\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= 0;\n        end else if (dst_valid_o && dst_ready_i) begin\n            dst_rd_ptr <= dst_rd_ptr + 1;\n        end\n    end\n\n    // Convert read pointer to Gray code\n    assign dst_rd_ptr_gray = (dst_rd_ptr >> 1) ^ dst_rd_ptr;\n\n    // Synchronize Gray code read pointer to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_gray_sync <= 0;\n        end else begin\n            dst_rd_ptr_gray_sync <= dst_rd_ptr_gray;\n        end\n    end\n\n    // Synchronize Gray code write pointer to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_wr_ptr_gray_sync <= 0;\n        end else begin\n            dst_wr_ptr_gray_sync <= src_wr_ptr_gray_sync;\n        end\n    end\n\n    // Convert synchronized Gray code pointers back to binary\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        begin\n            gray_to_bin = gray[ADDR_WIDTH];\n            for (i = ADDR_WIDTH - 1; i >= 0; i = i - 1) begin\n                gray_to_bin[i] = gray_to_bin[i + 1] ^ gray[i];\n            end\n        end\n    endfunction\n\n    wire [ADDR_WIDTH:0] src_wr_ptr_sync = gray_to_bin(src_wr_ptr_gray_sync);\n    wire [ADDR_WIDTH:0] dst_rd_ptr_sync = gray_to_bin(dst_rd_ptr_gray_sync);\n\n    // FIFO full and empty conditions\n    wire full = (src_wr_ptr_sync[ADDR_WIDTH] != dst_wr_ptr_gray_sync[ADDR_WIDTH]) &&\n               (src_wr_ptr_sync[ADDR_WIDTH-1:0] == dst_wr_ptr_gray_sync[ADDR_WIDTH-1:0]);\n    wire empty = (dst_rd_ptr_sync[ADDR_WIDTH] != dst_wr_ptr_gray_sync[ADDR_WIDTH]) &&\n                (dst_rd_ptr_sync[ADDR_WIDTH-1:0] == dst_wr_ptr_gray_sync[ADDR_WIDTH-1:0]);\n\n    // Source ready signal\n    assign src_ready_o = !full;\n\n    // Write data to FIFO\n    always @(posedge src_clk_i) begin\n        if (src_valid_i && src_ready_o) begin\n            mem[src_wr_ptr[ADDR_WIDTH-1:0]] <= src_data_i;\n        end\n    end\n\n    // Destination valid signal\n    reg [1:0] dst_valid_reg;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_reg <= 0;\n        end else if (dst_valid_o && dst_ready_i) begin\n            dst_valid_reg <= {dst_valid_reg[0], 1'b0};\n        end else if (!empty) begin\n            dst_valid_reg <= {dst_valid_reg[0], 1'b1};\n        end\n    end\n\n    assign dst_valid_o = dst_valid_reg[1];\n\n    // Read data from FIFO\n    always @(posedge dst_clk_i) begin\n        if (!empty && dst_valid_o && dst_ready_i) begin\n            dst_data_o <= mem[dst_rd_ptr[ADDR_WIDTH-1:0]];\n        end\n    end\n\nendmodule\n```<|im_end|>",
