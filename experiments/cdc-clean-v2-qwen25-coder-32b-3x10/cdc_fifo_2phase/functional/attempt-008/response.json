{
  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [ADDR_WIDTH:0] src_wr_ptr, src_wr_ptr_gray, src_wr_ptr_gray_sync;\n    reg [ADDR_WIDTH:0] dst_rd_ptr, dst_rd_ptr_gray, dst_rd_ptr_gray_sync;\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= 0;\n            src_wr_ptr_gray <= 0;\n        end else begin\n            if (src_valid_i && src_ready_o) begin\n                mem[src_wr_ptr[ADDR_WIDTH-1:0]] <= src_data_i;\n                src_wr_ptr <= src_wr_ptr + 1;\n                src_wr_ptr_gray <= src_wr_ptr ^ (src_wr_ptr >> 1);\n            end\n        end\n    end\n\n    // Synchronize src_wr_ptr_gray to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_gray_sync <= 0;\n        end else begin\n            src_wr_ptr_gray_sync <= src_wr_ptr_gray;\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= 0;\n            dst_rd_ptr_gray <= 0;\n            dst_valid_o <= 0;\n        end else begin\n            if (dst_valid_o && dst_ready_i) begin\n                dst_rd_ptr <= dst_rd_ptr + 1;\n                dst_rd_ptr_gray <= dst_rd_ptr ^ (dst_rd_ptr >> 1);\n                dst_valid_o <= 0;\n            end else if (gray_to_bin(src_wr_ptr_gray_sync) != dst_rd_ptr) begin\n                dst_data_o <= mem[dst_rd_ptr[ADDR_WIDTH-1:0]];\n                dst_valid_o <= 1;\n            end\n        end\n    end\n\n    // Synchronize dst_rd_ptr_gray to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_gray_sync <= 0;\n        end else begin\n            dst_rd_ptr_gray_sync <= dst_rd_ptr_gray;\n        end\n    end\n\n    // Calculate src_ready_o\n    assign src_ready_o = (gray_to_bin(src_wr_ptr_gray) != dst_rd_ptr_gray_sync);\n\n    // Gray to binary conversion\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        begin\n            gray_to_bin = gray[ADDR_WIDTH];\n            for (i = ADDR_WIDTH - 1; i >= 0; i = i - 1) begin\n                gray_to_bin[i] = gray_to_bin[i+1] ^ gray[i];\n            end\n        end\n    endfunction\n\nendmodule\n```<|im_end|>",
