  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd4,\n  parameter int unsigned        ApbAddrWidth = 32'd32,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd32,\n  parameter int unsigned        RegDataWidth = 32'd32,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Internal signals\n  logic [NoApbRegs-1:0]             reg_q [RegDataWidth-1:0];\n  logic [NoApbRegs-1:0]             reg_next [RegDataWidth-1:0];\n  logic [NoApbRegs-1:0]             reg_we;\n  logic [NoApbRegs-1:0]             reg_we_byte [RegDataWidth/8-1:0];\n  logic [ApbAddrWidth-1:0]          addr_offset;\n  logic [NoApbRegs-1:0]             addr_match;\n  logic [RegDataWidth-1:0]          read_data;\n  logic [RegDataWidth-1:0]          write_data;\n  logic [RegDataWidth/8-1:0]        pstrb;\n  logic                             penable;\n  logic                             psel;\n\n  // Extract signals from req_i and resp_o\n  assign psel    = req_i.psel;\n  assign penable = req_i.penable;\n  assign pstrb   = req_i.pstrb;\n  assign write_data = req_i.pwdata;\n\n  // Address decoding\n  assign addr_offset = req_i.paddr - base_addr_i;\n  assign addr_match = (addr_offset < NoApbRegs * AddrOffset) ? (1'b1 << (addr_offset / AddrOffset)) : '0;\n\n  // Byte-wise write enable\n  genvar i;\n  generate\n    for (i = 0; i < RegDataWidth/8; i = i + 1) begin : gen_byte_we\n      assign reg_we_byte[i] = addr_match & pstrb[i];\n    end\n  endgenerate\n\n  // Register write enable\n  assign reg_we = (|reg_we_byte) & psel & penable;\n\n  // Read data multiplexer\n  always_comb begin\n    read_data = '0;\n    for (int j = 0; j < NoApbRegs; j = j + 1) begin\n      if (addr_match[j]) begin\n        read_data = ReadOnly[j] ? reg_init_i[j] : reg_q[0][j];\n      end\n    end\n  end\n\n  // Register file update\n  always_ff @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int j = 0; j < NoApbRegs; j = j + 1) begin\n        if (!ReadOnly[j]) begin\n          reg_q[0][j] <= '0;\n        end else begin\n          reg_q[0][j] <= reg_init_i[j];\n        end\n      end\n    end else if (reg_we) begin\n      for (int j = 0; j < NoApbRegs; j = j + 1) begin\n        if (addr_match[j] && !ReadOnly[j]) begin\n          for (int k = 0; k < RegDataWidth/8; k = k + 1) begin\n            if (reg_we_byte[k]) begin\n              reg_next[k*8 +: 8][j] = write_data[k*8 +: 8];\n            end else begin\n              reg_next[k*8 +: 8][j] = reg_q[k*8 +: 8][j];\n            end\n          end\n        end else begin\n          reg_next[0][j] = reg_q[0][j];\n        end\n      end\n      reg_q <= reg_next;\n    end\n  end\n\n  // Response signal\n  assign resp_o.prdata = read_data;\n  assign resp_o.pready = 1'b1;\n  assign resp_o.pslverr = 1'b0;\n\n  // Output register values\n  assign reg_q_o = reg_q[0];\n\nendmodule\n```<|im_end|>",
