  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd4,\n  parameter int unsigned        ApbAddrWidth = 32'd32,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd32,\n  parameter int unsigned        RegDataWidth = 32'd32,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Internal register file\n  reg_data_t reg_file [NoApbRegs-1:0];\n\n  // Internal signals\n  logic [NoApbRegs-1:0] reg_addr;\n  logic [ApbDataWidth/8-1:0] byte_strobe;\n  logic [ApbDataWidth-1:0] write_data;\n  logic [ApbDataWidth-1:0] read_data;\n  logic write_enable;\n\n  // Decode the address\n  always_comb begin\n    reg_addr = '0;\n    if (req_i.psel && req_i.penable) begin\n      reg_addr[(ApbAddrWidth-AddrOffset-1):0] = req_i.paddr[ApbAddrWidth-AddrOffset-1:0];\n    end\n  end\n\n  // Byte strobe handling\n  always_comb begin\n    byte_strobe = req_i.pstrb;\n  end\n\n  // Write data handling\n  always_comb begin\n    write_data = '0;\n    for (int i = 0; i < ApbDataWidth/8; i++) begin\n      if (byte_strobe[i]) begin\n        write_data[i*8 +: 8] = req_i.pwdata[i*8 +: 8];\n      end\n    end\n  end\n\n  // Write enable handling\n  always_comb begin\n    write_enable = req_i.psel && req_i.penable && req_i.pwrite;\n  end\n\n  // Register file read and write logic\n  always_ff @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (ReadOnly[i]) begin\n          reg_file[i] <= reg_init_i[i];\n        end else begin\n          reg_file[i] <= '0;\n        end\n      end\n    end else begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (write_enable && reg_addr == i && !ReadOnly[i]) begin\n          reg_file[i] <= (reg_file[i] & ~({ApbDataWidth{byte_strobe}})) | (write_data & {ApbDataWidth{byte_strobe}});\n        end\n      end\n    end\n  end\n\n  // Read data handling\n  always_comb begin\n    read_data = '0;\n    if (req_i.psel && req_i.penable && !req_i.pwrite) begin\n      read_data = reg_file[reg_addr];\n    end\n  end\n\n  // Response handling\n  always_comb begin\n    resp_o.prdata = read_data;\n    resp_o.pready = 1'b1;\n    resp_o.pslverr = 1'b0;\n  end\n\n  // Output register values\n  always_comb begin\n    reg_q_o = reg_file;\n  end\n\nendmodule\n```<|im_end|>",
