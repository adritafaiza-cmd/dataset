  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Internal signals\n  logic [ApbAddrWidth-1:0] addr;\n  logic [NoApbRegs-1:0]    reg_sel;\n  logic [RegDataWidth-1:0] reg_data;\n  logic [ApbDataWidth-1:0] write_data;\n  logic [ApbDataWidth/8-1:0] pstrb;\n  logic                      penable;\n  logic                      psel;\n  logic                      read;\n  logic                      write;\n  logic                      valid_access;\n\n  // Decode the address\n  assign addr = req_i.paddr - base_addr_i;\n  assign reg_sel = (addr < NoApbRegs * AddrOffset) ? (1 << (addr / AddrOffset)) : '0;\n\n  // Determine if the access is valid\n  assign valid_access = (req_i.psel && req_i.penable && (addr < NoApbRegs * AddrOffset));\n\n  // Determine if the access is a read or write\n  assign read = valid_access && !req_i.pwrite;\n  assign write = valid_access && req_i.pwrite;\n\n  // Byte enable signals\n  assign pstrb = req_i.pstrb;\n\n  // Write data with byte enable\n  always_comb begin\n    write_data = '0;\n    for (int i = 0; i < ApbDataWidth/8; i++) begin\n      if (pstrb[i]) begin\n        write_data[i*8 +: 8] = req_i.pwdata[i*8 +: 8];\n      end\n    end\n  end\n\n  // Register file\n  reg_data_t [NoApbRegs-1:0] reg_file;\n\n  always_ff @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (ReadOnly[i]) begin\n          reg_file[i] <= reg_init_i[i];\n        end else begin\n          reg_file[i] <= '0;\n        end\n      end\n    end else begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (write && reg_sel[i] && !ReadOnly[i]) begin\n          reg_file[i] <= (reg_file[i] & ~(pstrb << (i*8))) | (write_data & (pstrb << (i*8)));\n        end\n      end\n    end\n  end\n\n  // Output the current register values\n  always_comb begin\n    reg_q_o = '0;\n    for (int i = 0; i < NoApbRegs; i++) begin\n      if (reg_sel[i]) begin\n        reg_q_o[i] = ReadOnly[i] ? reg_init_i[i] : reg_file[i];\n      end\n    end\n  end\n\n  // APB response\n  always_comb begin\n    resp_o.prdata = '0;\n    resp_o.pready = 1'b1;\n    resp_o.pslverr = 1'b0;\n\n    if (read) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (reg_sel[i]) begin\n          resp_o.prdata = ReadOnly[i] ? reg_init_i[i] : reg_file[i];\n        end\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>",
