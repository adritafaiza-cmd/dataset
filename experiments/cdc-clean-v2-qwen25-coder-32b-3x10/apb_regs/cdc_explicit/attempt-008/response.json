  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Internal register file\n  reg_data_t reg_file [NoApbRegs-1:0];\n\n  // Internal signals\n  logic [NoApbRegs-1:0] addr_match;\n  logic [NoApbRegs-1:0] write_enable;\n  logic [NoApbRegs-1:0] read_enable;\n  logic [NoApbRegs-1:0] byte_enable;\n  logic [NoApbRegs-1:0] reg_write;\n  reg_data_t write_data;\n\n  // Decode the address\n  always_comb begin\n    addr_match = '0;\n    for (int i = 0; i < NoApbRegs; i++) begin\n      addr_match[i] = (req_i.paddr[ApbAddrWidth-1:2] == (base_addr_i[ApbAddrWidth-1:2] + i * (AddrOffset / 4)));\n    end\n  end\n\n  // Determine byte enables\n  always_comb begin\n    byte_enable = '0;\n    for (int i = 0; i < NoApbRegs; i++) begin\n      if (addr_match[i]) begin\n        byte_enable[i] = req_i.pstrb;\n      end\n    end\n  end\n\n  // Determine write enable\n  always_comb begin\n    write_enable = '0;\n    for (int i = 0; i < NoApbRegs; i++) begin\n      if (addr_match[i] && req_i.psel && req_i.penable && !ReadOnly[i]) begin\n        write_enable[i] = 1'b1;\n      end\n    end\n  end\n\n  // Determine read enable\n  always_comb begin\n    read_enable = '0;\n    for (int i = 0; i < NoApbRegs; i++) begin\n      if (addr_match[i] && req_i.psel && !req_i.pwrite) begin\n        read_enable[i] = 1'b1;\n      end\n    end\n  end\n\n  // Generate write data with byte enables\n  always_comb begin\n    write_data = '0;\n    for (int i = 0; i < (ApbDataWidth / 8); i++) begin\n      if (req_i.pstrb[i]) begin\n        write_data[(i+1)*8-1:i*8] = req_i.pwdata[(i+1)*8-1:i*8];\n      end\n    end\n  end\n\n  // Register file write logic\n  always_ff @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (!ReadOnly[i]) begin\n          reg_file[i] <= '0;\n        end else begin\n          reg_file[i] <= reg_init_i[i];\n        end\n      end\n    end else begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (write_enable[i]) begin\n          for (int j = 0; j < (ApbDataWidth / 8); j++) begin\n            if (byte_enable[i][j]) begin\n              reg_file[i][(j+1)*8-1:j*8] <= write_data[(j+1)*8-1:j*8];\n            end\n          end\n        end\n      end\n    end\n  end\n\n  // Output current register values\n  always_comb begin\n    reg_q_o = '0;\n    for (int i = 0; i < NoApbRegs; i++) begin\n      if (read_enable[i]) begin\n        reg_q_o[i] = reg_file[i];\n      end else if (ReadOnly[i]) begin\n        reg_q_o[i] = reg_init_i[i];\n      end\n    end\n  end\n\n  // Generate APB response\n  always_comb begin\n    resp_o.prdata = '0;\n    resp_o.pready = 1'b1;\n    resp_o.pslverr = 1'b0;\n    for (int i = 0; i < NoApbRegs; i++) begin\n      if (read_enable[i]) begin\n        resp_o.prdata = reg_file[i];\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>",
