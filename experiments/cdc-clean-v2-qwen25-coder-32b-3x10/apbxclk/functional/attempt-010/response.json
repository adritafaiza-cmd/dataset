{
  "text": "```verilog\nmodule apbxclk #(\n        parameter C_APB_ADDR_WIDTH = 12,\n        parameter C_APB_DATA_WIDTH = 32,\n        parameter [0:0] OPT_REGISTERED = 1'b0,\n        localparam AW = C_APB_ADDR_WIDTH,\n        localparam DW = C_APB_DATA_WIDTH\n    ) (\n        input wire S_APB_PCLK, S_PRESETn,\n        input wire S_APB_PSEL,\n        input wire S_APB_PENABLE,\n        output reg S_APB_PREADY,\n        input wire [AW-1:0] S_APB_PADDR,\n        input wire S_APB_PWRITE,\n        input wire [DW-1:0] S_APB_PWDATA,\n        input wire [DW/8-1:0] S_APB_PWSTRB,\n        input wire [2:0] S_APB_PPROT,\n        output wire [DW-1:0] S_APB_PRDATA,\n        output wire S_APB_PSLVERR,\n        input wire M_APB_PCLK,\n        output reg M_PRESETn,\n        output reg M_APB_PSEL,\n        output reg M_APB_PENABLE,\n        input wire M_APB_PREADY,\n        output wire [AW-1:0] M_APB_PADDR,\n        output wire M_APB_PWRITE,\n        output wire [DW-1:0] M_APB_PWDATA,\n        output wire [DW/8-1:0] M_APB_PWSTRB,\n        output wire [2:0] M_APB_PPROT,\n        input wire [DW-1:0] M_APB_PRDATA,\n        input wire M_APB_PSLVERR\n    );\n\n    // Internal signals\n    reg [AW-1:0] addr_reg;\n    reg [DW-1:0] wdata_reg;\n    reg [DW/8-1:0] wstrb_reg;\n    reg [2:0] prot_reg;\n    reg write_reg;\n    reg request_valid;\n    reg request_accepted;\n\n    // Source side logic\n    always @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n        if (!S_PRESETn) begin\n            S_APB_PREADY <= 1'b0;\n            request_valid <= 1'b0;\n            request_accepted <= 1'b0;\n        end else begin\n            if (S_APB_PSEL && S_APB_PENABLE && !request_valid) begin\n                request_valid <= 1'b1;\n                addr_reg <= S_APB_PADDR;\n                wdata_reg <= S_APB_PWDATA;\n                wstrb_reg <= S_APB_PWSTRB;\n                prot_reg <= S_APB_PPROT;\n                write_reg <= S_APB_PWRITE;\n            end\n\n            if (request_accepted && M_APB_PREADY) begin\n                S_APB_PREADY <= 1'b1;\n                request_valid <= 1'b0;\n                request_accepted <= 1'b0;\n            end else begin\n                S_APB_PREADY <= 1'b0;\n            end\n        end\n    end\n\n    // Destination side logic\n    always @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n        if (!S_PRESETn) begin\n            M_PRESETn <= 1'b0;\n            M_APB_PSEL <= 1'b0;\n            M_APB_PENABLE <= 1'b0;\n        end else begin\n            M_PRESETn <= 1'b1;\n\n            if (request_valid && !request_accepted) begin\n                M_APB_PSEL <= 1'b1;\n                M_APB_PENABLE <= 1'b1;\n                request_accepted <= 1'b1;\n            end else if (M_APB_PREADY) begin\n                M_APB_PSEL <= 1'b0;\n                M_APB_PENABLE <= 1'b0;\n            end\n        end\n    end\n\n    // Data and control signals crossing\n    generate\n        if (OPT_REGISTERED) begin : registered_crossing\n            reg [DW-1:0] prdata_reg;\n            reg pslverr_reg;\n\n            always @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n                if (!S_PRESETn) begin\n                    prdata_reg <= 0;\n                    pslverr_reg <= 0;\n                end else if (M_APB_PREADY) begin\n                    prdata_reg <= M_APB_PRDATA;\n                    pslverr_reg <= M_APB_PSLVERR;\n                end\n            end\n\n            assign S_APB_PRDATA = prdata_reg;\n            assign S_APB_PSLVERR = pslverr_reg;\n\n            always @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n                if (!S_PRESETn) begin\n                    M_APB_PADDR <= 0;\n                    M_APB_PWDATA <= 0;\n                    M_APB_PWSTRB <= 0;\n                    M_APB_PPROT <= 0;\n                    M_APB_PWRITE <= 0;\n                end else if (request_valid && !request_accepted) begin\n                    M_APB_PADDR <= addr_reg;\n                    M_APB_PWDATA <= wdata_reg;\n                    M_APB_PWSTRB <= wstrb_reg;\n                    M_APB_PPROT <= prot_reg;\n                    M_APB_PWRITE <= write_reg;\n                end\n            end\n        end else begin : combinational_crossing\n            assign S_APB_PRDATA = M_APB_PRDATA;\n            assign S_APB_PSLVERR = M_APB_PSLVERR;\n\n            assign M_APB_PADDR = addr_reg;\n            assign M_APB_PWDATA = wdata_reg;\n            assign M_APB_PWSTRB = wstrb_reg;\n            assign M_APB_PPROT = prot_reg;\n            assign M_APB_PWRITE = write_reg;\n        end\n    endgenerate\n\nendmodule\n```<|im_end|>",
