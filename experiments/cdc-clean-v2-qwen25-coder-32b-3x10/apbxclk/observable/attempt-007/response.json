t\ts_wstrb_sync <= S_APB_PWSTRB;\n\t\t\ts_prot_sync <= S_APB_PPROT;\n\t\t\ts_req_sync <= 1;\n\t\tend else begin\n\t\t\ts_req_sync <= 0;\n\t\tend\n\tend\nend\n\n// Synchronizer for request signal from S_APB to M_APB\nalways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\ts_req_sync_d <= 0;\n\tend else begin\n\t\ts_req_sync_d <= s_req_sync;\n\tend\nend\n\n// Master side request generation\nalways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\tM_APB_PSEL <= 0;\n\t\tM_APB_PENABLE <= 0;\n\t\tm_addr_reg <= 0;\n\t\tm_write_reg <= 0;\n\t\tm_wdata_reg <= 0;\n\t\tm_wstrb_reg <= 0;\n\t\tm_prot_reg <= 0;\n\t\tm_req_reg <= 0;\n\tend else begin\n\t\tif (s_req_sync_d && !m_req_reg) begin\n\t\t\tm_addr_reg <= s_addr_sync;\n\t\t\tm_write_reg <= s_write_sync;\n\t\t\tm_wdata_reg <= s_wdata_sync;\n\t\t\tm_wstrb_reg <= s_wstrb_sync;\n\t\t\tm_prot_reg <= s_prot_sync;\n\t\t\tm_req_reg <= 1;\n\t\tend else if (M_APB_PREADY) begin\n\t\t\tm_req_reg <= 0;\n\t\tend\n\tend\nend\n\n// Synchronizer for request signal from M_APB to S_APB\nalways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\tm_req_reg_d <= 0;\n\tend else begin\n\t\tm_req_reg_d <= m_req_reg;\n\tend\nend\n\n// Slave side response capture\nalways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\ts_rdata_reg <= 0;\n\t\ts_slverr_reg <= 0;\n\t\ts_rdata_valid <= 0;\n\tend else begin\n\t\tif (m_req_reg_d && M_APB_PREADY) begin\n\t\t\ts_rdata_reg <= M_APB_PRDATA;\n\t\t\ts_slverr_reg <= M_APB_PSLVERR;\n\t\t\ts_rdata_valid <= 1;\n\t\tend else if (S_APB_PENABLE) begin\n\t\t\ts_rdata_valid <= 0;\n\t\tend\n\tend\nend\n\n// Slave side ready signal generation\nalways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\tS_APB_PREADY <= 0;\n\tend else begin\n\t\tif (s_req_sync && !s_rdata_valid) begin\n\t\t\tS_APB_PREADY <= 0;\n\t\tend else if (s_rdata_valid) begin\n\t\t\tS_APB_PREADY <= 1;\n\t\tend\n\