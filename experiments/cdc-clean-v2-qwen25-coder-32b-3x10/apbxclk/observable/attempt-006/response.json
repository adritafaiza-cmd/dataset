  "text": "```verilog\nmodule apbxclk #(\n\t\tparameter\tC_APB_ADDR_WIDTH = 12,\n\t\tparameter\tC_APB_DATA_WIDTH = 32,\n\t\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\t\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\t\tlocalparam\tDW = C_APB_DATA_WIDTH\n\t) (\n\t\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\t\tinput\twire\t\t\tS_APB_PSEL,\n\t\tinput\twire\t\t\tS_APB_PENABLE,\n\t\toutput\treg\t\t\tS_APB_PREADY,\n\t\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\t\tinput\twire\t\t\tS_APB_PWRITE,\n\t\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\t\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\t\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\t\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\t\toutput\twire\t\t\tS_APB_PSLVERR,\n\t\tinput\twire\t\t\tM_APB_PCLK,\n\t\toutput\treg\t\t\tM_PRESETn,\n\t\toutput\treg\t\t\tM_APB_PSEL,\n\t\toutput\treg\t\t\tM_APB_PENABLE,\n\t\tinput\twire\t\t\tM_APB_PREADY,\n\t\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\t\toutput\twire\t\t\tM_APB_PWRITE,\n\t\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\t\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\t\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\t\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\t\tinput\twire\t\t\tM_APB_PSLVERR\n\t);\n\nreg [AW-1:0] s_addr_sync;\nreg s_write_sync;\nreg [DW-1:0] s_wdata_sync;\nreg [DW/8-1:0] s_wstrb_sync;\nreg [2:0] s_prot_sync;\nreg s_req_sync;\nreg s_req_sync_d;\n\nreg [AW-1:0] m_addr;\nreg m_write;\nreg [DW-1:0] m_wdata;\nreg [DW/8-1:0] m_wstrb;\nreg [2:0] m_prot;\nreg m_req;\nreg m_req_d;\n\nreg [DW-1:0] s_rdata;\nreg s_slverr;\n\n// Synchronizers for request fields from S_APB to M_APB\nalways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\ts_addr_sync <= 0;\n\t\ts_write_sync <= 0;\n\t\ts_wdata_sync <= 0;\n\t\ts_wstrb_sync <= 0;\n\t\ts_prot_sync <= 0;\n\t\ts_req_sync <= 0;\n\tend else begin\n\t\ts_addr_sync <= S_APB_PADDR;\n\t\ts_write_sync <= S_APB_PWRITE;\n\t\ts_wdata_sync <= S_APB_PWDATA;\n\t\ts_wstrb_sync <= S_APB_PWSTRB;\n\t\ts_prot_sync <= S_APB_PPROT;\n\t\ts_req_sync <= S_APB_PSEL & S_APB_PENABLE;\n\tend\nend\n\n// Synchronizers for response fields from M_APB to S_APB\nalways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\ts_rdata <= 0;\n\t\ts_slverr <= 0;\n\tend else begin\n\t\ts_rdata <= M_APB_PRDATA;\n\t\ts_slverr <= M_APB_PSLVERR;\n\tend\nend\n\n// Detect request edge in master clock domain\nalways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\ts_req_sync_d <= 0;\n\tend else begin\n\t\ts_req_sync_d <= s_req_sync;\n\tend\nend\n\n// Detect request edge in slave clock domain\nalways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\tm_req_d <= 0;\n\tend else begin\n\t\tm_req_d <= m_req;\n\tend\nend\n\n// Master side logic\nalways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\tM_PRESETn <= 0;\n\t\tM_APB_PSEL <= 0;\n\t\tM_APB_PENABLE <= 0;\n\t\tm_addr <= 0;\n\t\tm_write <= 0;\n\t\tm_wdata <= 0;\n\t\tm_wstrb <= 0;\n\t\tm_prot <= 0;\n\t\tm_req <= 0;\n\tend else begin\n\t\tM_PRESETn <= S_PRESETn;\n\t\tif (s_req_sync & ~s_req_sync_d) begin\n\t\t\tm_addr <= s_addr_sync;\n\t\t\tm_write <= s_write_sync;\n\t\t\tm_wdata <= s_wdata_sync;\n\t\t\tm_wstrb <= s_wstrb_sync;\n\t\t\tm_prot <= s_prot_sync;\n\t\t\tm_req <= 1;\n\t\tend else if (M_APB_PREADY) begin\n\t\t\tm_req <= 0;\n\t\tend\n\t\tM_APB_PSEL <= m_req;\n\t\tM_APB_PENABLE <= m_req;\n\tend\nend\n\n// Slave side logic\nalways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\tif (!S_PRESETn) begin\n\t\tS_APB_PREADY <= 0;\n\tend else begin\n\t\tif (m_req_d & ~m_req & M_APB_PREADY) begin\n\t\t\tS_APB_PREADY <= 1;\n\t\tend else begin\n\t\t\tS_APB_PREADY <= 0;\n\t\tend\n\tend\nend\n\nassign S_APB_PRDATA = s_rdata;\nassign S_APB_PSLVERR = s_slverr;\nassign M_APB_PADDR = m_addr;\nassign M_APB_PWRITE = m_write;\nassign M_APB_PWDATA = m_wdata;\nassign M_APB_PWSTRB = m_wstrb;\nassign M_APB_PPROT = m_prot;\n\nendmodule\n```<|im_end|>",
