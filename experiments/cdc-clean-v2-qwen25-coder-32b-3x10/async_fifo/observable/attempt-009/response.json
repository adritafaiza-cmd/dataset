{
  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWIDTH = ASIZE + 1;\n\n    reg [DSIZE-1:0] mem [DEPTH-1:0];\n\n    reg [AWIDTH-1:0] wptr, rptr;\n    reg [AWIDTH-1:0] wptr_gray, rptr_gray;\n    reg [AWIDTH-1:0] wptr_gray_sync, rptr_gray_sync;\n\n    // Write side logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= 0;\n        end else if (winc && !wfull) begin\n            mem[wptr[ASIZE-1:0]] <= wdata;\n            wptr <= wptr + 1;\n        end\n    end\n\n    // Read side logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= 0;\n        end else if (rinc && !rempty) begin\n            rptr <= rptr + 1;\n        end\n    end\n\n    // Gray code conversion for pointers\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr_gray <= 0;\n        end else begin\n            wptr_gray <= (wptr >> 1) ^ wptr;\n        end\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr_gray <= 0;\n        end else begin\n            rptr_gray <= (rptr >> 1) ^ rptr;\n        end\n    end\n\n    // Cross-domain synchronization\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_sync <= 0;\n        end else begin\n            wptr_gray_sync <= wptr_gray;\n        end\n    end\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_sync <= 0;\n        end else begin\n            rptr_gray_sync <= rptr_gray;\n        end\n    end\n\n    // Binary conversion for synchronized pointers\n    reg [AWIDTH-1:0] wptr_sync_bin, rptr_sync_bin;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_sync_bin <= 0;\n        end else begin\n            wptr_sync_bin <= (wptr_gray_sync ^ (wptr_gray_sync >> 1));\n        end\n    end\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_sync_bin <= 0;\n        end else begin\n            rptr_sync_bin <= (rptr_gray_sync ^ (rptr_gray_sync >> 1));\n        end\n    end\n\n    // Full and empty flags\n    wire [AWIDTH-1:0] wptr_plus1;\n    assign wptr_plus1 = wptr + 1;\n\n    wire [AWIDTH-1:0] wptr_plus1_sync_bin;\n    assign wptr_plus1_sync_bin = (wptr_plus1 ^ (wptr_plus1 >> 1));\n\n    assign wfull = (wptr_plus1_sync_bin == rptr_sync_bin);\n    assign awfull = (wptr_gray == rptr_gray_sync);\n\n    assign rempty = (wptr_sync_bin == rptr);\n    assign arempty = (wptr_gray_sync == rptr_gray);\n\n    // Read data output\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata <= 0;\n        end else if (rinc && !rempty) begin\n            rdata <= mem[rptr[ASIZE-1:0]];\n        end\n    end\n\nendmodule\n```<|im_end|>",
