{
  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 2**ASIZE;\n    localparam AWIDTH = ASIZE + 1;\n\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    reg [AWIDTH-1:0] wptr, rptr;\n    reg [AWIDTH-1:0] wptr_gray, rptr_gray;\n    reg [AWIDTH-1:0] rptr_gray_synced, wptr_gray_synced;\n\n    // Write side logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= 0;\n        end else if (winc && !wfull) begin\n            mem[wptr[ASIZE-1:0]] <= wdata;\n            wptr <= wptr + 1;\n        end\n    end\n\n    // Read side logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= 0;\n        end else if (rinc && !rempty) begin\n            rptr <= rptr + 1;\n        end\n    end\n\n    // Gray code conversion for pointers\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr_gray <= 0;\n        end else begin\n            wptr_gray <= (wptr >> 1) ^ wptr;\n        end\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr_gray <= 0;\n        end else begin\n            rptr_gray <= (rptr >> 1) ^ rptr;\n        end\n    end\n\n    // Synchronize gray pointers across clock domains\n    reg [AWIDTH-1:0] wptr_gray_synced_reg1, wptr_gray_synced_reg2;\n    reg [AWIDTH-1:0] rptr_gray_synced_reg1, rptr_gray_synced_reg2;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_synced_reg1 <= 0;\n            wptr_gray_synced_reg2 <= 0;\n        end else begin\n            wptr_gray_synced_reg1 <= wptr_gray;\n            wptr_gray_synced_reg2 <= wptr_gray_synced_reg1;\n        end\n    end\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_synced_reg1 <= 0;\n            rptr_gray_synced_reg2 <= 0;\n        end else begin\n            rptr_gray_synced_reg1 <= rptr_gray;\n            rptr_gray_synced_reg2 <= rptr_gray_synced_reg1;\n        end\n    end\n\n    assign wptr_gray_synced = wptr_gray_synced_reg2;\n    assign rptr_gray_synced = rptr_gray_synced_reg2;\n\n    // Binary conversion of synchronized gray pointers\n    reg [AWIDTH-1:0] wptr_synced, rptr_synced;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_synced <= 0;\n        end else begin\n            wptr_synced <= gray_to_bin(wptr_gray_synced);\n        end\n    end\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_synced <= 0;\n        end else begin\n            rptr_synced <= gray_to_bin(rptr_gray_synced);\n        end\n    end\n\n    // Gray to binary conversion function\n    function [AWIDTH-1:0] gray_to_bin;\n        input [AWIDTH-1:0] gray;\n        integer i;\n        begin\n            gray_to_bin = gray[AWIDTH-1];\n            for (i = AWIDTH-2; i >= 0; i = i - 1) begin\n                gray_to_bin[i] = gray_to_bin[i+1] ^ gray[i];\n            end\n        end\n    endfunction\n\n    // Full and empty flags\n    assign wfull = (wptr_synced[AWIDTH-1:0] == {rptr_gray_synced[AWIDTH-2:0], ~rptr_gray_synced[AWIDTH-1]});\n    assign rempty = (rptr_synced[AWIDTH-1:0] == {wptr_gray_synced[AWIDTH-2:0], ~wptr_gray_synced[AWIDTH-1]});\n\n    // Almost full and almost empty flags\n    assign awfull = (wptr_synced[AWIDTH-1:0] == {rptr_gray_synced[AWIDTH-2:0], ~rptr_gray_synced[AWIDTH-1]} + 1);\n    assign arempty = (rptr_synced[AWIDTH-1:0] == {wptr_gray_synced[AWIDTH-2:0], ~wptr_gray_synced[AWIDTH-1]} - 1);\n\n    // Read data output\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata <= 0;\n        end else if (rinc && !rempty) begin\n            rdata <= mem[rptr[ASIZE-1:0]];\n        end\n    end\n\nendmodule\n```<|im_end|>",
