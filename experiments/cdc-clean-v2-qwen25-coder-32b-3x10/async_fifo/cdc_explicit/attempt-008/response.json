{
  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWATERMARK = DEPTH - 2;\n    localparam EWATERMARK = 1;\n\n    reg [DSIZE-1:0] mem [DEPTH-1:0];\n\n    reg [ASIZE:0] wptr_gray, wptr_gray_nxt, wptr_bin;\n    reg [ASIZE:0] rptr_gray, rptr_gray_nxt, rptr_bin;\n\n    // Write domain logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr_gray <= 0;\n        end else if (winc && !wfull) begin\n            wptr_gray <= wptr_gray_nxt;\n        end\n    end\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            mem[0] <= 0;\n        end else if (winc && !wfull) begin\n            mem[wptr_bin[ASIZE-1:0]] <= wdata;\n        end\n    end\n\n    assign wptr_gray_nxt = wptr_gray + 1;\n    assign wptr_bin = wptr_gray ^ (wptr_gray >> 1);\n\n    // Read domain logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr_gray <= 0;\n        end else if (rinc && !rempty) begin\n            rptr_gray <= rptr_gray_nxt;\n        end\n    end\n\n    assign rptr_gray_nxt = rptr_gray + 1;\n    assign rptr_bin = rptr_gray ^ (rptr_gray >> 1);\n\n    // Gray to binary conversion for read pointer in write domain\n    reg [ASIZE:0] rptr_bin_wdom;\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_bin_wdom <= 0;\n        end else begin\n            rptr_bin_wdom <= rptr_gray ^ (rptr_gray >> 1);\n        end\n    end\n\n    // Gray to binary conversion for write pointer in read domain\n    reg [ASIZE:0] wptr_bin_rdom;\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_bin_rdom <= 0;\n        end else begin\n            wptr_bin_rdom <= wptr_gray ^ (wptr_gray >> 1);\n        end\n    end\n\n    // FIFO full and almost full logic\n    wire [ASIZE:0] wptr_bin_plus1;\n    assign wptr_bin_plus1 = wptr_bin_wdom + 1;\n    assign wfull = (wptr_bin_plus1[ASIZE:0] == rptr_bin_wdom[ASIZE:0]);\n    assign awfull = (wptr_bin_plus1[ASIZE:0] == (rptr_bin_wdom[ASIZE:0] + AWATERMARK));\n\n    // FIFO empty and almost empty logic\n    wire [ASIZE:0] rptr_bin_plus1;\n    assign rptr_bin_plus1 = rptr_bin_rdom + 1;\n    assign rempty = (wptr_bin_rdom[ASIZE:0] == rptr_bin_rdom[ASIZE:0]);\n    assign arempty = (wptr_bin_rdom[ASIZE:0] == (rptr_bin_rdom[ASIZE:0] + EWATERMARK));\n\n    // Read data output\n    reg [DSIZE-1:0] rdata_reg;\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata_reg <= 0;\n        end else if (rinc && !rempty) begin\n            rdata_reg <= mem[rptr_bin_rdom[ASIZE-1:0]];\n        end else if (FALLTHROUGH && !rempty) begin\n            rdata_reg <= mem[rptr_bin_rdom[ASIZE-1:0]];\n        end\n    end\n\n    assign rdata = rdata_reg;\n\nendmodule\n```<|im_end|>",
