  "text": "// =============================================================================\n// cdc_fifo_gray_clearable.v\n// =============================================================================\n// Clearable valid/ready asynchronous FIFO.\n//\n//   * Standard Gray-coded async FIFO with a two-stage destination pipeline.\n//   * src_clear_i / dst_clear_i request a flush: isolate both sides, drop\n//     stored and in-flight data, then return to empty.\n//   * *_clear_pending_o stays high until that side finishes.\n//   * Clear and reset must not create a destination beat.\n//   * The destination word is one registered sample. dst_valid_o may remain\n//     low for multiple destination clocks after an accepted beat even when\n//     another word is stored.\n//   * A clear resets each binary pointer and the Gray register that feeds its\n//     synchronizer on the same edge.\n// =============================================================================\n\n`timescale 1ns / 1ps\n\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n\n    // ------------------------------------------------------------------\n    // Source domain\n    // ------------------------------------------------------------------\n\n    reg  [PTR_W-1:0] src_wr_ptr_bin;\n    reg  [PTR_W-1:0] src_wr_ptr_gray;\n\n    reg  [PTR_W-1:0] src_rd_ptr_gray_sync;\n    reg  [PTR_W-1:0] src_rd_ptr_gray_sync_next;\n\n    reg  [WIDTH-1:0] mem [0:DEPTH-1];\n\n    wire src_wr_en = src_valid_i & src_ready_o;\n\n    wire [PTR_W-1:0] src_wr_ptr_gray_next = src_wr_ptr_bin ^ (src_wr_ptr_bin >> 1);\n\n    wire src_full = (src_wr_ptr_gray_next == src_rd_ptr_gray_sync) &&\n                    (src_wr_ptr_gray_next[PTR_W-1] != src_rd_ptr_gray_sync[PTR_W-1]);\n\n    wire src_empty = (src_wr_ptr_gray_next == src_rd_ptr_gray_sync);\n\n    wire src_ready_o = !src_full && !src_clear_pending_o;\n\n    // ------------------------------------------------------------------\n    // Destination domain\n    // ------------------------------------------------------------------\n\n    reg  [PTR_W-1:0] dst_rd_ptr_bin;\n    reg  [PTR_W-1:0] dst_rd_ptr_gray;\n\n    reg  [PTR_W-1:0] dst_wr_ptr_gray_sync;\n    reg  [PTR_W-1:0] dst_wr_ptr_gray_sync_next;\n\n    reg  [WIDTH-1:0] dst_pipe_data;\n    reg              dst_pipe_valid;\n\n    wire dst_rd_en = dst_valid_o & dst_ready_i;\n\n    wire [PTR_W-1:0] dst_rd_ptr_gray_next = dst_rd_ptr_bin ^ (dst_rd_ptr_bin >> 1);\n\n    wire dst_full = (dst_rd_ptr_gray_next == dst_wr_ptr_gray_sync) &&\n                    (dst_rd_ptr_gray_next[PTR_W-1] != dst_wr_ptr_gray_sync[PTR_W-1]);\n\n    wire dst_empty = (dst_rd_ptr_gray_next == dst_wr_ptr_gray_sync);\n\n    wire dst_ready = !dst_full && !dst_clear_pending_o;\n\n    // ------------------------------------------------------------------\n    // Clear handshake\n    // ------------------------------------------------------------------\n\n    reg src_clear_pending;\n    reg dst_clear_pending;\n\n    wire src_clear_pending_o = src_clear_pending;\n    wire dst_clear_pending_o = dst_clear_pending;\n\n    wire src_clear_active = src_clear_i || src_clear_pending;\n    wire dst_clear_active = dst_clear_i || dst_clear_pending;\n\n    // ------------------------------------------------------------------\n    // Source clock\n    // ------------------------------------------------------------------\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr_bin <= {PTR_W{1'b0}};\n            src_wr_ptr_gray <= {PTR_W{1'b0}};\n            src_rd_ptr_gray_sync <= {PTR_W{1'b0}};\n            src_rd_ptr_gray_sync_next <= {PTR_W{1'b0}};\n            src_clear_pending <= 1'b0;\n        end else begin\n            if (src_clear_active) begin\n                src_wr_ptr_bin <= {PTR_W{1'b0}};\n                src_wr_ptr_gray <= {PTR_W{1'b0}};\n                src_rd_ptr_gray_sync <= {PTR_W{1'b0}};\n                src_rd_ptr_gray_sync_next <= {PTR_W{1'b0}};\n                src_clear_pending <= 1'b1;\n            end else begin\n                if (src_wr_en) begin\n                    mem[src_wr_ptr_bin[LOG_DEPTH-1:0]] <= src_data_i;\n                    src_wr_ptr_bin <= src_wr_ptr_bin + 1'b1;\n                    src_wr_ptr_gray <= src_wr_ptr_gray_next;\n                end\n\n                src_rd_ptr_gray_sync <= src_rd_ptr_gray_sync_next;\n                src_rd_ptr_gray_sync_next <= dst_rd_ptr_gray_sync;\n\n                if (src_clear_pending && !dst_clear_active)\n                    src_clear_pending <= 1'b0;\n            end\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Destination clock\n    // ------------------------------------------------------------------\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr_bin <= {PTR_W{1'b0}};\n            dst_rd_ptr_gray <= {PTR_W{1'b0}};\n            dst_wr_ptr_gray_sync <= {PTR_W{1'b0}};\n            dst_wr_ptr_gray_sync_next <= {PTR_W{1'b0}};\n            dst_pipe_data <= {WIDTH{1'b0}};\n            dst_pipe_valid <= 1'b0;\n            dst_clear_pending <= 1'b0;\n        end else begin\n            if (dst_clear_active) begin\n                dst_rd_ptr_bin <= {PTR_W{1'b0}};\n                dst_rd_ptr_gray <= {PTR_W{1'b0}};\n                dst_wr_ptr_gray_sync <= {PTR_W{1'b0}};\n                dst_wr_ptr_gray_sync_next <= {PTR_W{1'b0}};\n                dst_pipe_data <= {WIDTH{1'b0}};\n                dst_pipe_valid <= 1'b0;\n                dst_clear_pending <= 1'b1;\n            end else begin\n                if (dst_rd_en) begin\n                    dst_rd_ptr_bin <= dst_rd_ptr_bin + 1'b1;\n                    dst_rd_ptr_gray <= dst_rd_ptr_gray_next;\n                end\n\n                dst_wr_ptr_gray_sync <= dst_wr_ptr_gray_sync_next;\n                dst_wr_ptr_gray_sync_next <= src_wr_ptr_gray_sync;\n\n                if (dst_ready && !dst_empty) begin\n                    dst_pipe_data <= mem[dst_rd_ptr_bin[LOG_DEPTH-1:0]];\n                    dst_pipe_valid <= 1'b1;\n                end else begin\n                    dst_pipe_valid <= 1'b0;\n                end\n\n                if (dst_clear_pending && !src_clear_active)\n                    dst_clear_pending <= 1'b0;\n            end\n        end\n    end\n\n    assign dst_data_o = dst_pipe_data;\n    assign dst_valid_o = dst_pipe_valid;\n\nendmodule<|im_end|>",
