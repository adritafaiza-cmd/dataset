  "text": "// =============================================================================\n// APB Clock Domain Crossing (CDC) Bridge\n// =============================================================================\n//\n// This module bridges APB transfers between two asynchronous clock domains.\n// It uses a FIFO-based approach with Gray-coded pointers for safe CDC.\n//\n// Architecture:\n//   - Source domain: Captures APB requests during access phase, writes to FIFO\n//   - Destination domain: Reads from FIFO, drives APB signals, waits for ready\n//   - Response path: Read data/error returned via FIFO or direct path\n//\n// FIFO Contents (per entry):\n//   - Write flag\n//   - Address\n//   - Write data\n//   - Write strobes\n//   - Protection bits\n//\n// =============================================================================\n\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    localparam FIFO_DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH  = LOG_DEPTH + 1;\n\n    // ========================================================================\n    // FIFO Storage\n    // ========================================================================\n    reg [DATA_WIDTH-1:0] fifo_data [0:FIFO_DEPTH-1];\n    reg [ADDR_WIDTH-1:0] fifo_addr [0:FIFO_DEPTH-1];\n    reg [DATA_WIDTH/8-1:0] fifo_strb [0:FIFO_DEPTH-1];\n    reg [2:0]              fifo_prot [0:FIFO_DEPTH-1];\n    reg                    fifo_write [0:FIFO_DEPTH-1];\n\n    // ========================================================================\n    // FIFO Pointers (Gray-coded for CDC)\n    // ========================================================================\n    reg [PTR_WIDTH-1:0] wr_ptr_bin;\n    reg [PTR_WIDTH-1:0] wr_ptr_gray;\n    reg [PTR_WIDTH-1:0] rd_ptr_bin;\n    reg [PTR_WIDTH-1:0] rd_ptr_gray;\n\n    // Synchronized pointers\n    reg [PTR_WIDTH-1:0] wr_ptr_gray_dst;\n    reg [PTR_WIDTH-1:0] rd_ptr_gray_src;\n\n    // ========================================================================\n    // Source Domain State Machine\n    // ========================================================================\n    localparam SRC_IDLE    = 2'd0;\n    localparam SRC_SETUP   = 2'd1;\n    localparam SRC_ACCESS  = 2'd2;\n\n    reg [1:0] src_state;\n\n    // ========================================================================\n    // Destination Domain State Machine\n    // ========================================================================\n    localparam DST_IDLE    = 2'd0;\n    localparam DST_SETUP   = 2'd1;\n    localparam DST_ACCESS  = 2'd2;\n\n    reg [1:0] dst_state;\n\n    // ========================================================================\n    // Response FIFO (for read data/error)\n    // ========================================================================\n    reg [DATA_WIDTH-1:0] rsp_data [0:FIFO_DEPTH-1];\n    reg                    rsp_err  [0:FIFO_DEPTH-1];\n\n    reg [PTR_WIDTH-1:0] rsp_wr_ptr_bin;\n    reg [PTR_WIDTH-1:0] rsp_wr_ptr_gray;\n    reg [PTR_WIDTH-1:0] rsp_rd_ptr_bin;\n    reg [PTR_WIDTH-1:0] rsp_rd_ptr_gray;\n\n    reg [PTR_WIDTH-1:0] rsp_wr_ptr_gray_src;\n    reg [PTR_WIDTH-1:0] rsp_rd_ptr_gray_dst;\n\n    // ========================================================================\n    // Helper Functions\n    // ========================================================================\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // ========================================================================\n    // Source Domain Logic\n    // ========================================================================\n\n    // Synchronize destination read pointer to source domain\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            rd_ptr_gray_src <= {PTR_WIDTH{1'b0}};\n        else\n            rd_ptr_gray_src <= rd_ptr_gray;\n    end\n\n    // Synchronize response write pointer to source domain\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            rsp_wr_ptr_gray_src <= {PTR_WIDTH{1'b0}};\n        else\n            rsp_wr_ptr_gray_src <= rsp_wr_ptr_gray;\n    end\n\n    // FIFO full check (source domain)\n    wire fifo_full = (wr_ptr_gray == rd_ptr_gray_src) &&\n                     (wr_ptr_bin[PTR_WIDTH-1] != rd_ptr_gray_src[PTR_WIDTH-1]);\n\n    // Response FIFO full check (source domain)\n    wire rsp_fifo_full = (rsp_wr_ptr_gray == rsp_rd_ptr_gray_src) &&\n                         (rsp_wr_ptr_bin[PTR_WIDTH-1] != rsp_rd_ptr_gray_src[PTR_WIDTH-1]);\n\n    // Source APB outputs\n    assign src_pready_o  = (src_state == SRC_IDLE) && !fifo_full;\n    assign src_prdata_o  = rsp_data[rsp_rd_ptr_bin[LOG_DEPTH-1:0]];\n    assign src_pslverr_o = rsp_err[rsp_rd_ptr_bin[LOG_DEPTH-1:0]];\n\n    // Source state machine\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_state    <= SRC_IDLE;\n            wr_ptr_bin   <= {PTR_WIDTH{1'b0}};\n            wr_ptr_gray  <= {PTR_WIDTH{1'b0}};\n            rsp_rd_ptr_bin <= {PTR_WIDTH{1'b0}};\n            rsp_rd_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end else begin\n            case (src_state)\n                SRC_IDLE: begin\n                    if (src_psel_i && !fifo_full) begin\n                        src_state <= SRC_SETUP;\n                    end\n                end\n\n                SRC_SETUP: begin\n                    if (src_psel_i && src_penable_i) begin\n                        // Write request to FIFO\n                        fifo_write[wr_ptr_bin[LOG_DEPTH-1:0]] <= src_pwrite_i;\n                        fifo_addr[wr_ptr_bin[LOG_DEPTH-1:0]]  <= src_paddr_i;\n                        fifo_data[wr_ptr_bin[LOG_DEPTH-1:0]]  <= src_pwdata_i;\n                        fifo_strb[wr_ptr_bin[LOG_DEPTH-1:0]]  <= src_pstrb_i;\n                        fifo_prot[wr_ptr_bin[LOG_DEPTH-1:0]]  <= src_pprot_i;\n\n                        wr_ptr_bin  <= wr_ptr_bin + 1'b1;\n                        wr_ptr_gray <= bin2gray(wr_ptr_bin + 1'b1);\n\n                        src_state <= SRC_ACCESS;\n                    end\n                end\n\n                SRC_ACCESS: begin\n                    // Wait for response\n                    if (!rsp_fifo_full) begin\n                        // Read response from FIFO\n                        rsp_rd_ptr_bin  <= rsp_rd_ptr_bin + 1'b1;\n                        rsp_rd_ptr_gray <= bin2gray(rsp_rd_ptr_bin + 1'b1);\n                        src_state <= SRC_IDLE;\n                    end\n                end\n\n                default: src_state <= SRC_IDLE;\n            endcase\n        end\n    end\n\n    // ========================================================================\n    // Destination Domain Logic\n    // ========================================================================\n\n    // Synchronize source write pointer to destination domain\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            wr_ptr_gray_dst <= {PTR_WIDTH{1'b0}};\n        else\n            wr_ptr_gray_dst <= wr_ptr_gray;\n    end\n\n    // Synchronize response read pointer to destination domain\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            rsp_rd_ptr_gray_dst <= {PTR_WIDTH{1'b0}};\n        else\n            rsp_rd_ptr_gray_dst <= rsp_rd_ptr_gray;\n    end\n\n    // FIFO empty check (destination domain)\n    wire fifo_empty = (rd_ptr_gray == wr_ptr_gray_dst);\n\n    // Response FIFO empty check (destination domain)\n    wire rsp_fifo_empty = (rsp_rd_ptr_gray == rsp_wr_ptr_gray_dst) &&\n                          (rsp_rd_ptr_bin[PTR_WIDTH-1] == rsp_wr_ptr_gray_dst[PTR_WIDTH-1]);\n\n    // Destination APB outputs\n    assign dst_psel_o   = (dst_state != DST_IDLE);\n    assign dst_penable_o = (dst_state == DST_ACCESS);\n    assign dst_pwrite_o = fifo_write[rd_ptr_bin[LOG_DEPTH-1:0]];\n    assign dst_paddr_o  = fifo_addr[rd_ptr_bin[LOG_DEPTH-1:0]];\n    assign dst_pwdata_o = fifo_data[rd_ptr_bin[LOG_DEPTH-1:0]];\n    assign dst_pstrb_o  = fifo_strb[rd_ptr_bin[LOG_DEPTH-1:0]];\n    assign dst_pprot_o  = fifo_prot[rd_ptr_bin[LOG_DEPTH-1:0]];\n\n    // Destination state machine\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_state     <= DST_IDLE;\n            rd_ptr_bin    <= {PTR_WIDTH{1'b0}};\n            rd_ptr_gray   <= {PTR_WIDTH{1'b0}};\n            rsp_wr_ptr_bin  <= {PTR_WIDTH{1'b0}};\n            rsp_wr_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end else begin\n            case (dst_state)\n                DST_IDLE: begin\n                    if (!fifo_empty) begin\n                        dst_state <= DST_SETUP;\n                    end\n                end\n\n                DST_SETUP: begin\n                    dst_state <= DST_ACCESS;\n                end\n\n                DST_ACCESS: begin\n                    if (dst_pready_i) begin\n                        // Write response to FIFO if read\n                        if (!fifo_write[rd_ptr_bin[LOG_DEPTH-1:0]]) begin\n                            rsp_data[rsp_wr_ptr_bin[LOG_DEPTH-1:0]] <= dst_prdata_i;\n                            rsp_err[rsp_wr_ptr_bin[LOG_DEPTH-1:0]]  <= dst_pslverr_i;\n                            rsp_wr_ptr_bin  <= rsp_wr_ptr_bin + 1'b1;\n                            rsp_wr_ptr_gray <= bin2gray(rsp_wr_ptr_bin + 1'b1);\n                        end\n\n                        // Advance read pointer\n                        rd_ptr_bin  <= rd_ptr_bin + 1'b1;\n                        rd_ptr_gray <= bin2gray(rd_ptr_bin + 1'b1);\n\n                        dst_state <= DST_IDLE;\n                    end\n                end\n\n                default: dst_state <= DST_IDLE;\n            endcase\n        end\n    end\n\nendmodule<|im_end|>",
