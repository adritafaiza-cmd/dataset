  "text": "// =============================================================================\n// Copyright (C) 2019-2020 Xilinx, Inc. All rights reserved.\n// SPDX-License-Identifier: MIT\n// =============================================================================\n\n`timescale 1ns / 1ps\n\n`include \"axi_adapter_defines.vh\"\n\n`include \"axi_adapter_pkg.vh\"\n\nmodule axis_adapter #(\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1\n) (\n    input  wire                     clk,\n    input  wire                     rst,\n\n    /*\n     * AXI input\n     */\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n\n    /*\n     * AXI output\n     */\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser\n);\n\n    localparam S_BYTES = (S_DATA_WIDTH+7)/8;\n    localparam M_BYTES = (M_DATA_WIDTH+7)/8;\n\n    localparam S_KEEP_WIDTH_ACTUAL = (S_KEEP_ENABLE ? S_KEEP_WIDTH : 1);\n    localparam M_KEEP_WIDTH_ACTUAL = (M_KEEP_ENABLE ? M_KEEP_WIDTH : 1);\n\n    localparam ID_WIDTH_ACTUAL = (ID_ENABLE ? ID_WIDTH : 1);\n    localparam DEST_WIDTH_ACTUAL = (DEST_ENABLE ? DEST_WIDTH : 1);\n    localparam USER_WIDTH_ACTUAL = (USER_ENABLE ? USER_WIDTH : 1);\n\n    localparam S_BYTES_LOG2 = `AXI_ADAPTER_CLOG2(S_BYTES);\n    localparam M_BYTES_LOG2 = `AXI_ADAPTER_CLOG2(M_BYTES);\n\n    localparam S_BYTES_MASK = (1<<S_BYTES_LOG2)-1;\n    localparam M_BYTES_MASK = (1<<M_BYTES_LOG2)-1;\n\n    localparam S_BYTES_MINUS_1 = S_BYTES-1;\n    localparam M_BYTES_MINUS_1 = M_BYTES-1;\n\n    localparam S_BYTES_MINUS_1_LOG2 = `AXI_ADAPTER_CLOG2(S_BYTES_MINUS_1);\n    localparam M_BYTES_MINUS_1_LOG2 = `AXI_ADAPTER_CLOG2(M_BYTES_MINUS_1);\n\n    localparam S_BYTES_MINUS_1_MASK = (1<<S_BYTES_MINUS_1_LOG2)-1;\n    localparam M_BYTES_MINUS_1_MASK = (1<<M_BYTES_MINUS_1_LOG2)-1;\n\n    localparam S_BYTES_MINUS_1_MINUS_1 = S_BYTES_MINUS_1-1;\n    localparam M_BYTES_MINUS_1_MINUS_1 = M_BYTES_MINUS_1-1;\n\n    localparam S_BYTES_MINUS_1_MINUS_1_LOG2 = `AXI_ADAPTER_CLOG2(S_BYTES_MINUS_1_MINUS_1);\n    localparam M_BYTES_MINUS_1_MINUS_1_LOG2 = `AXI_ADAPTER_CLOG2(M_BYTES_MINUS_1_MINUS_1);\n\n    localparam S_BYTES_MINUS_1_MINUS_1_MASK = (1<<S_BYTES_MINUS_1_MINUS_1_LOG2)-1;\n    localparam M_BYTES_MINUS_1_MINUS_1_MASK = (1<<M_BYTES_MINUS_1_MINUS_1_LOG2)-1;\n\n    localparam S_BYTES_MINUS_1_MINUS_1_MINUS_1 = S_BYTES_MINUS_1_MINUS_1-1;\n    localparam M_BYTES_MINUS_1_MINUS_1_MINUS_1 = M_BYTES_MINUS_1_MINUS_1-1;\n\n    localparam S_BYTES_MINUS_1_MINUS_1_MINUS_1_LOG2 = `AXI_ADAPTER_CLOG2(S_BYTES_MINUS_1_MINUS_1_MINUS_1);\n    localparam M_BYTES_MINUS_1_MINUS_1_MINUS_1_LOG2 = `AXI_ADAPTER_CLOG2(M_BYTES_MINUS_1_MINUS_1_MINUS_1);\n\n    localparam S_BYTES_MINUS_1_MINUS_1_MINUS_1_MASK = (1<<S_BYTES_MINUS_1_MINUS_1_MINUS_1_LOG2)-1;\n    localparam M_BYTES_MINUS_1_MINUS_1_MINUS_1_MASK = (1<<M_BYTES_MINUS_1_MINUS_1_MINUS_1_LOG2)-1;\n\n    localparam S_BYTES_MINUS_1_MINUS_1_MINUS_1_MINUS_1 = 