{
  "text": "```verilog\nmodule pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Domain A: level synchronizer\n    reg [STAGES-1:0] sync_a;\n    integer i;\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            sync_a <= {STAGES{1'b0}};\n        else begin\n            sync_a[0] <= pulseA_i;\n            for (i = 1; i < STAGES; i = i + 1)\n                sync_a[i] <= sync_a[i-1];\n        end\n    end\n\n    // Domain B: level synchronizer\n    reg [STAGES-1:0] sync_b;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            sync_b <= {STAGES{1'b0}};\n        else begin\n            sync_b[0] <= sync_a[STAGES-1];\n            for (i = 1; i < STAGES; i = i + 1)\n                sync_b[i] <= sync_b[i-1];\n        end\n    end\n\n    // Domain B: pulse detection and busy flag\n    reg busy_b;\n    reg pulse_b;\n\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            busy_b  <= 1'b0;\n            pulse_b <= 1'b0;\n        end else begin\n            if (sync_b[STAGES-1] && !busy_b) begin\n                busy_b  <= 1'b1;\n                pulse_b <= 1'b1;\n            end else if (busy_b) begin\n                busy_b  <= 1'b0;\n                pulse_b <= 1'b0;\n            end else begin\n                pulse_b <= 1'b0;\n            end\n        end\n    end\n\n    assign pulseB_o = pulse_b;\n    assign busy_o   = busy_b;\n\nendmodule\n```<|im_end|>",
