  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    wire [S_DATA_WIDTH-1:0] s_data;\n    wire [S_KEEP_WIDTH-1:0] s_keep;\n    wire s_last;\n    wire [ID_WIDTH-1:0] s_id;\n    wire [DEST_WIDTH-1:0] s_dest;\n    wire [USER_WIDTH-1:0] s_user;\n    wire s_valid;\n    wire s_ready;\n\n    // Write pointer (source clock domain)\n    reg [PTR_WIDTH-1:0] w_ptr;\n    // Read pointer (destination clock domain)\n    reg [PTR_WIDTH-1:0] r_ptr;\n\n    // Synchronized read pointer to source domain\n    reg [PTR_WIDTH-1:0] r_ptr_sync1, r_ptr_sync2;\n    // Synchronized write pointer to destination domain\n    reg [PTR_WIDTH-1:0] w_ptr_sync1, w_ptr_sync2;\n\n    // Pause signals\n    reg s_pause_ack_reg;\n    reg m_pause_ack_reg;\n\n    // Status registers\n    reg s_overflow_reg;\n    reg m_overflow_reg;\n    reg s_bad_frame_reg;\n    reg s_good_frame_reg;\n    reg m_bad_frame_reg;\n    reg m_good_frame_reg;\n\n    // Depth calculation\n    wire [PTR_WIDTH-1:0] s_depth_raw = w_ptr - r_ptr_sync2;\n    wire [PTR_WIDTH-1:0] m_depth_raw = w_ptr_sync2 - r_ptr;\n\n    // Assign outputs\n    assign s_axis_tready = s_ready;\n    assign s_pause_ack = s_pause_ack_reg;\n    assign m_pause_ack = m_pause_ack_reg;\n    assign s_status_depth = s_depth_raw;\n    assign s_status_depth_commit = s_depth_raw;\n    assign s_status_overflow = s_overflow_reg;\n    assign s_status_bad_frame = s_bad_frame_reg;\n    assign s_status_good_frame = s_good_frame_reg;\n    assign m_status_depth = m_depth_raw;\n    assign m_status_depth_commit = m_depth_raw;\n    assign m_status_overflow = m_overflow_reg;\n    assign m_status_bad_frame = m_bad_frame_reg;\n    assign m_status_good_frame = m_good_frame_reg;\n\n    // Source clock domain logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_ptr <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            s_pause_ack_reg <= 1'b0;\n            s_overflow_reg <= 1'b0;\n            s_bad_frame_reg <= 1'b0;\n            s_good_frame_reg <= 1'b0;\n        end else begin\n            // Synchronize read pointer\n            r_ptr_sync1 <= r_ptr;\n            r_ptr_sync2 <= r_ptr_sync1;\n\n            // Pause acknowledgment\n            if (PAUSE_ENABLE) begin\n                s_pause_ack_reg <= s_pause_req;\n            end else begin\n                s_pause_ack_reg <= 1'b0;\n            end\n\n            // Write pointer update\n            if (s_valid && s_ready) begin\n                w_ptr <= w_ptr + 1'b1;\n            end\n\n            // Overflow detection\n            if (s_valid && !s_ready) begin\n                s_overflow_reg <= 1'b1;\n            end\n\n            // Frame status\n            if (s_valid && s_ready && s_last) begin\n                s_good_frame_reg <= 1'b1;\n            end\n        end\n    end\n\n    // Destination clock domain logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr <= {PTR_WIDTH-1:0};\n            w_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            m_pause_ack_reg <= 1'b0;\n            m_overflow_reg <= 1'b0;\n            m_bad_frame_reg <= 1'b0;\n            m_good_frame_reg <= 1'b0;\n        end else begin\n            // Synchronize write pointer\n            w_ptr_sync1 <= w_ptr;\n            w_ptr_sync2 <= w_ptr_sync1;\n\n            // Pause acknowledgment\n            if (PAUSE_ENABLE) begin\n                m_pause_ack_reg <= m_pause_req;\n            end else begin\n                m_pause_ack_reg <= 1'b0;\n            end\n\n            // Read pointer update\n            if (m_axis_tvalid && m_axis_tready) begin\n                r_ptr <= r_ptr + 1'b1;\n            end\n\n            // Overflow detection (should not happen in normal operation)\n            if (m_axis_tvalid && !m_axis_tready) begin\n                m_overflow_reg <= 1'b1;\n            end\n\n            // Frame status\n            if (m_axis_tvalid && m_axis_tready && m_axis_tlast) begin\n                m_good_frame_reg <= 1'b1;\n            end\n        end\n    end\n\n    // FIFO full/empty logic\n    wire s_full = (w_ptr - r_ptr_sync2) >= DEPTH;\n    wire m_empty = (w_ptr_sync2 == r_ptr);\n\n    // Source ready logic\n    wire s_ready_internal = !s_full;\n    assign s_ready = s_ready_internal;\n\n    // Destination valid logic\n    wire m_valid_internal = !m_empty;\n    assign m_axis_tvalid = m_valid_internal;\n\n    // Data path: Read from FIFO and adapt width\n    // For simplicity, we assume S_DATA_WIDTH == M_DATA_WIDTH or use a simple pass-through\n    // In a real implementation, you would need a proper width adapter\n    assign m_axis_tdata = s_data;\n    assign m_axis_tkeep = s_keep;\n    assign m_axis_tlast = s_last;\n    assign m_axis_tid = s_id;\n    assign m_axis_tdest = s_dest;\n    assign m_axis_tuser = s_user;\n\n    // Source data assignment\n    assign s_data = s_axis_tdata;\n    assign s_keep = s_axis_tkeep;\n    assign s_last = s_axis_tlast;\n    assign s_id = s_axis_tid;\n    assign s_dest = s_axis_tdest;\n    assign s_user = s_axis_tuser;\n    assign s_valid = s_axis_tvalid;\n\nendmodule\n```<|im_end|>",
