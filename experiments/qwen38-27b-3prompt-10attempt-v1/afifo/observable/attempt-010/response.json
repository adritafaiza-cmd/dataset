  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam PTR_W = LGFIFO + 1;\n\n\t// Write side\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\treg [PTR_W-1:0] wr_ptr;\n\treg [PTR_W-1:0] wr_ptr_gray;\n\treg [PTR_W-1:0] rd_ptr_gray_wr;\n\n\t// Read side\n\treg [PTR_W-1:0] rd_ptr;\n\treg [PTR_W-1:0] rd_ptr_gray;\n\treg [PTR_W-1:0] wr_ptr_gray_rd;\n\n\t// Gray code conversion\n\tfunction [PTR_W-1:0] bin2gray;\n\t\tinput [PTR_W-1:0] bin;\n\t\tbegin\n\t\t\tbin2gray = bin ^ (bin >> 1);\n\t\tend\n\tendfunction\n\n\tfunction [PTR_W-1:0] gray2bin;\n\t\tinput [PTR_W-1:0] gray;\n\t\treg [PTR_W-1:0] bin;\n\t\tbegin\n\t\t\tbin[PTR_W-1] = gray[PTR_W-1];\n\t\t\tfor (integer i = PTR_W-2; i >= 0; i = i - 1)\n\t\t\t\tbin[i] = gray[i] ^ bin[i+1];\n\t\t\tgray2bin = bin;\n\t\tend\n\tendfunction\n\n\t// Write clock domain\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= {PTR_W{1'b0}};\n\t\t\twr_ptr_gray <= {PTR_W{1'b0}};\n\t\t\to_wr_full <= 1'b0;\n\t\tend else begin\n\t\t\tif (i_wr && !o_wr_full) begin\n\t\t\t\tmem[wr_ptr[LGFIFO-1:0]] <= i_wr_data;\n\t\t\t\twr_ptr <= wr_ptr + 1'b1;\n\t\t\t\twr_ptr_gray <= bin2gray(wr_ptr + 1'b1);\n\t\t\tend\n\t\tend\n\tend\n\n\t// Synchronize read pointer gray to write domain\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\trd_ptr_gray_wr <= {PTR_W{1'b0}};\n\t\telse\n\t\t\trd_ptr_gray_wr <= rd_ptr_gray;\n\tend\n\n\t// Full flag in write domain\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\to_wr_full <= 1'b0;\n\t\telse\n\t\t\to_wr_full <= (wr_ptr_gray[PTR_W-1:0] != rd_ptr_gray_wr[PTR_W-1:0]) &&\n\t\t\t\t\t\t (wr_ptr_gray[PTR_W-1:1] == rd_ptr_gray_wr[PTR_W-1:1]);\n\tend\n\n\t// Read clock domain\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= {PTR_W{1'b0}};\n\t\t\trd_ptr_gray <= {PTR_W{1'b0}};\n\t\t\to_rd_empty <= 1'b1;\n\t\t\to_rd_data <= {WIDTH{1'b0}};\n\t\tend else begin\n\t\t\tif (i_rd && !o_rd_empty) begin\n\t\t\t\trd_ptr <= rd_ptr + 1'b1;\n\t\t\t\trd_ptr_gray <= bin2gray(rd_ptr + 1'b1);\n\t\t\tend\n\t\tend\n\tend\n\n\t// Synchronize write pointer gray to read domain\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\twr_ptr_gray_rd <= {PTR_W{1'b0}};\n\t\telse\n\t\t\twr_ptr_gray_rd <= wr_ptr_gray;\n\tend\n\n\t// Empty flag in read domain\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_empty <= 1'b1;\n\t\telse\n\t\t\to_rd_empty <= (rd_ptr_gray[PTR_W-1:0] == wr_ptr_gray_rd[PTR_W-1:0]);\n\tend\n\n\t// Read data output\n\t// Present one stored word at a time. After a read, empty may return high until next word visible.\n\t// We use the current rd_ptr to index memory.\n\t// OPT_REGISTER_READS: if 1, register the read data; if 0, combinational.\n\t// NFF: number of flip-flops for read data pipeline (if OPT_REGISTER_READS is 1).\n\n\twire [WIDTH-1:0] mem_rd_data = mem[rd_ptr[LGFIFO-1:0]];\n\n\t// For OPT_REGISTER_READS = 1, we register the data\n\t// NFF specifies the number of pipeline stages\n\t// We'll implement a simple pipeline of NFF stages\n\n\treg [WIDTH-1:0] rd_data_pipe [0:NFF-1];\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\tfor (integer i = 0; i < NFF; i = i + 1)\n\t\t\t\trd_data_pipe[i] <= {WIDTH{1'b0}};\n\t\tend else begin\n\t\t\trd_data_pipe[0] <= mem_rd_data;\n\t\t\tfor (integer i = 1; i < NFF; i = i + 1)\n\t\t\t\trd_data_pipe[i] <= rd_data_pipe[i-1];\n\t\tend\n\tend\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_data <= {WIDTH{1'b0}};\n\t\telse if (OPT_REGISTER_READS)\n\t\t\to_rd_data <= rd_data_pipe[NFF-1];\n\t\telse\n\t\t\to_rd_data <= mem_rd_data;\n\tend\n\nendmodule\n```<|im_end|>",
