  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam LGFIFO_P1 = LGFIFO + 1;\n\tlocalparam LGFIFO_P2 = LGFIFO + 2;\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam MASK  = DEPTH - 1;\n\n\t// Write side\n\treg [LGFIFO-1:0] wr_ptr;\n\treg [LGFIFO_P1-1:0] wr_ptr_gray;\n\treg [LGFIFO_P1-1:0] wr_ptr_gray_sync;\n\n\t// Read side\n\treg [LGFIFO-1:0] rd_ptr;\n\treg [LGFIFO_P1-1:0] rd_ptr_gray;\n\treg [LGFIFO_P1-1:0] rd_ptr_gray_sync;\n\n\t// Memory\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\n\t// Gray code conversion\n\tfunction [LGFIFO_P1-1:0] bin2gray;\n\t\tinput [LGFIFO_P1-1:0] bin;\n\t\tbegin\n\t\t\tbin2gray = bin ^ (bin >> 1);\n\t\tend\n\tendfunction\n\n\t// Write clock domain\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr      <= {LGFIFO{1'b0}};\n\t\t\twr_ptr_gray <= {LGFIFO_P1{1'b0}};\n\t\tend else if (i_wr && !o_wr_full) begin\n\t\t\twr_ptr      <= wr_ptr + 1'b1;\n\t\t\twr_ptr_gray <= bin2gray(wr_ptr + 1'b1);\n\t\tend\n\tend\n\n\t// Write data storage\n\talways @(posedge i_wclk) begin\n\t\tif (i_wr && !o_wr_full) begin\n\t\t\tmem[wr_ptr] <= i_wr_data;\n\t\tend\n\tend\n\n\t// Synchronize read pointer gray to write domain\n\treg [LGFIFO_P1-1:0] rd_ptr_gray_sync_r1, rd_ptr_gray_sync_r2;\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\trd_ptr_gray_sync_r1 <= {LGFIFO_P1{1'b0}};\n\t\t\trd_ptr_gray_sync_r2 <= {LGFIFO_P1{1'b0}};\n\t\tend else begin\n\t\t\trd_ptr_gray_sync_r1 <= rd_ptr_gray;\n\t\t\trd_ptr_gray_sync_r2 <= rd_ptr_gray_sync_r1;\n\t\tend\n\tend\n\n\t// Full flag\n\twire [LGFIFO_P1-1:0] rd_ptr_gray_sync_w = rd_ptr_gray_sync_r2;\n\twire full = (wr_ptr_gray == {~rd_ptr_gray_sync_w[LGFIFO_P1-1:LGFIFO], rd_ptr_gray_sync_w[LGFIFO-1:0]});\n\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\to_wr_full <= 1'b0;\n\t\telse\n\t\t\to_wr_full <= full;\n\tend\n\n\t// Read clock domain\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr      <= {LGFIFO{1'b0}};\n\t\t\trd_ptr_gray <= {LGFIFO_P1{1'b0}};\n\t\tend else if (i_rd && !o_rd_empty) begin\n\t\t\trd_ptr      <= rd_ptr + 1'b1;\n\t\t\trd_ptr_gray <= bin2gray(rd_ptr + 1'b1);\n\t\tend\n\tend\n\n\t// Synchronize write pointer gray to read domain\n\treg [LGFIFO_P1-1:0] wr_ptr_gray_sync_r1, wr_ptr_gray_sync_r2;\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\twr_ptr_gray_sync_r1 <= {LGFIFO_P1{1'b0}};\n\t\t\twr_ptr_gray_sync_r2 <= {LGFIFO_P1{1'b0}};\n\t\tend else begin\n\t\t\twr_ptr_gray_sync_r1 <= wr_ptr_gray;\n\t\t\twr_ptr_gray_sync_r2 <= wr_ptr_gray_sync_r1;\n\t\tend\n\tend\n\n\t// Empty flag\n\twire [LGFIFO_P1-1:0] wr_ptr_gray_sync_r = wr_ptr_gray_sync_r2;\n\twire empty = (rd_ptr_gray == wr_ptr_gray_sync_r);\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_empty <= 1'b1;\n\t\telse\n\t\t\to_rd_empty <= empty;\n\tend\n\n\t// Read data output\n\treg [WIDTH-1:0] rd_data_reg;\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\trd_data_reg <= {WIDTH{1'b0}};\n\t\telse if (i_rd && !o_rd_empty)\n\t\t\trd_data_reg <= mem[rd_ptr];\n\tend\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_data <= {WIDTH{1'b0}};\n\t\telse if (OPT_REGISTER_READS)\n\t\t\to_rd_data <= rd_data_reg;\n\t\telse\n\t\t\to_rd_data <= mem[rd_ptr];\n\tend\n\nendmodule\n```<|im_end|>",
