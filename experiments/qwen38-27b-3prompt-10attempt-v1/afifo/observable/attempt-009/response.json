  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam AWIDTH = LGFIFO;\n\tlocalparam CWIDTH = LGFIFO + 1;\n\n\t// Write side\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\treg [AWIDTH-1:0] wr_ptr;\n\treg [AWIDTH-1:0] rd_ptr_gray_w;\n\treg [CWIDTH-1:0] wr_ptr_gray;\n\treg [CWIDTH-1:0] rd_ptr_gray_w_sync;\n\treg [CWIDTH-1:0] rd_ptr_gray_w_sync2;\n\treg [CWIDTH-1:0] rd_ptr_gray_w_sync3;\n\treg [CWIDTH-1:0] rd_ptr_gray_w_sync4;\n\n\t// Read side\n\treg [AWIDTH-1:0] rd_ptr;\n\treg [AWIDTH-1:0] wr_ptr_gray_r;\n\treg [CWIDTH-1:0] rd_ptr_gray;\n\treg [CWIDTH-1:0] wr_ptr_gray_r_sync;\n\treg [CWIDTH-1:0] wr_ptr_gray_r_sync2;\n\treg [CWIDTH-1:0] wr_ptr_gray_r_sync3;\n\treg [CWIDTH-1:0] wr_ptr_gray_r_sync4;\n\n\t// Read data pipeline\n\treg [WIDTH-1:0] rd_data_reg;\n\treg [WIDTH-1:0] rd_data_reg2;\n\treg rd_valid;\n\treg rd_valid2;\n\n\t// Gray code conversion\n\tfunction [CWIDTH-1:0] bin2gray;\n\t\tinput [CWIDTH-1:0] bin;\n\t\tbegin\n\t\t\tbin2gray = bin ^ (bin >> 1);\n\t\tend\n\tendfunction\n\n\tfunction [CWIDTH-1:0] gray2bin;\n\t\tinput [CWIDTH-1:0] gray;\n\t\treg [CWIDTH-1:0] bin;\n\t\tbegin\n\t\t\tbin[CWIDTH-1] = gray[CWIDTH-1];\n\t\t\tfor (i = CWIDTH-2; i >= 0; i = i - 1)\n\t\t\t\tbin[i] = gray[i] ^ bin[i+1];\n\t\t\tgray2bin = bin;\n\t\tend\n\tendfunction\n\n\t// Write clock domain\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= {AWIDTH{1'b0}};\n\t\t\twr_ptr_gray <= {CWIDTH{1'b0}};\n\t\tend else begin\n\t\t\tif (i_wr && !o_wr_full) begin\n\t\t\t\tmem[wr_ptr] <= i_wr_data;\n\t\t\t\twr_ptr <= wr_ptr + 1'b1;\n\t\t\t\twr_ptr_gray <= bin2gray(wr_ptr + 1'b1);\n\t\t\tend\n\t\tend\n\tend\n\n\t// Synchronize read pointer gray code to write domain\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\trd_ptr_gray_w_sync <= {CWIDTH{1'b0}};\n\t\t\trd_ptr_gray_w_sync2 <= {CWIDTH{1'b0}};\n\t\t\trd_ptr_gray_w_sync3 <= {CWIDTH{1'b0}};\n\t\t\trd_ptr_gray_w_sync4 <= {CWIDTH{1'b0}};\n\t\tend else begin\n\t\t\trd_ptr_gray_w_sync <= rd_ptr_gray;\n\t\t\trd_ptr_gray_w_sync2 <= rd_ptr_gray_w_sync;\n\t\t\trd_ptr_gray_w_sync3 <= rd_ptr_gray_w_sync2;\n\t\t\trd_ptr_gray_w_sync4 <= rd_ptr_gray_w_sync3;\n\t\tend\n\tend\n\n\t// Full flag in write domain\n\talways @(*) begin\n\t\tif (!i_wr_reset_n)\n\t\t\to_wr_full = 1'b0;\n\t\telse begin\n\t\t\t// Full when write pointer has lapped read pointer by DEPTH\n\t\t\t// wr_ptr_gray and rd_ptr_gray_w_sync4 are both gray codes\n\t\t\t// Full condition: MSB differs, and remaining bits are complement\n\t\t\to_wr_full = (wr_ptr_gray[CWIDTH-1] != rd_ptr_gray_w_sync4[CWIDTH-1]) &&\n\t\t\t\t\t\t(wr_ptr_gray[CWIDTH-2:0] == ~rd_ptr_gray_w_sync4[CWIDTH-2:0]);\n\t\tend\n\tend\n\n\t// Read clock domain\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= {AWIDTH{1'b0}};\n\t\t\trd_ptr_gray <= {CWIDTH{1'b0}};\n\t\tend else begin\n\t\t\tif (i_rd && !o_rd_empty) begin\n\t\t\t\trd_ptr <= rd_ptr + 1'b1;\n\t\t\t\trd_ptr_gray <= bin2gray(rd_ptr + 1'b1);\n\t\t\tend\n\t\tend\n\tend\n\n\t// Synchronize write pointer gray code to read domain\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\twr_ptr_gray_r_sync <= {CWIDTH{1'b0}};\n\t\t\twr_ptr_gray_r_sync2 <= {CWIDTH{1'b0}};\n\t\t\twr_ptr_gray_r_sync3 <= {CWIDTH{1'b0}};\n\t\t\twr_ptr_gray_r_sync4 <= {CWIDTH{1'b0}};\n\t\tend else begin\n\t\t\twr_ptr_gray_r_sync <= wr_ptr_gray;\n\t\t\twr_ptr_gray_r_sync2 <= wr_ptr_gray_r_sync;\n\t\t\twr_ptr_gray_r_sync3 <= wr_ptr_gray_r_sync2;\n\t\t\twr_ptr_gray_r_sync4 <= wr_ptr_gray_r_sync3;\n\t\tend\n\tend\n\n\t// Empty flag in read domain\n\talways @(*) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_empty = 1'b1;\n\t\telse\n\t\t\to_rd_empty = (rd_ptr_gray == wr_ptr_gray_r_sync4);\n\tend\n\n\t// Read data path\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_data_reg <= {WIDTH{1'b0}};\n\t\t\trd_data_reg2 <= {WIDTH{1'b0}};\n\t\t\trd_valid <= 1'b0;\n\t\t\trd_valid2 <= 1'b0;\n\t\tend else begin\n\t\t\tif (i_rd && !o_rd_empty) begin\n\t\t\t\trd_data_reg <= mem[rd_ptr];\n\t\t\t\trd_valid <= 1'b1;\n\t\t\tend else begin\n\t\t\t\trd_valid <= 1'b0;\n\t\t\tend\n\n\t\t\tif (OPT_REGISTER_READS) begin\n\t\t\t\trd_data_reg2 <= rd_data_reg;\n\t\t\t\trd_valid2 <= rd_valid;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Output data\n\talways @(*) begin\n\t\tif (OPT_REGISTER_READS)\n\t\t\to_rd_data = rd_data_reg2;\n\t\telse\n\t\t\to_rd_data = rd_data_reg;\n\tend\n\nendmodule\n```<|im_end|>",
