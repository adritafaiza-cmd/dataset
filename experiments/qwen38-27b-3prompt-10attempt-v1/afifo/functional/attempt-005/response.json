  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam ADDR_W = LGFIFO;\n\tlocalparam CNT_W = LGFIFO + 1;\n\tlocalparam GRAY_W = LGFIFO + 1;\n\n\t// Write domain\n\treg [ADDR_W-1:0] w_addr;\n\treg [ADDR_W-1:0] w_addr_gray;\n\treg [CNT_W-1:0]  w_count;\n\treg [WIDTH-1:0]  mem [0:DEPTH-1];\n\n\t// Read domain\n\treg [ADDR_W-1:0] r_addr;\n\treg [ADDR_W-1:0] r_addr_gray;\n\treg [CNT_W-1:0]  r_count;\n\treg [WIDTH-1:0]  r_data_reg;\n\n\t// Gray code conversion functions\n\tfunction [GRAY_W-1:0] bin2gray;\n\t\tinput [CNT_W-1:0] bin;\n\t\tbegin\n\t\t\tbin2gray = bin ^ (bin >> 1);\n\t\tend\n\tendfunction\n\n\tfunction [CNT_W-1:0] gray2bin;\n\t\tinput [GRAY_W-1:0] gray;\n\t\treg [CNT_W-1:0]   bin;\n\t\tbegin\n\t\t\tbin[GRAY_W-1] = gray[GRAY_W-1];\n\t\t\tfor (i = GRAY_W-2; i >= 0; i = i - 1)\n\t\t\t\tbin[i] = bin[i+1] ^ gray[i];\n\t\tend\n\tendfunction\n\n\t// Write clock domain logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\tw_addr      <= {ADDR_W{1'b0}};\n\t\t\tw_addr_gray <= {GRAY_W{1'b0}};\n\t\t\tw_count     <= {CNT_W{1'b0}};\n\t\t\to_wr_full   <= 1'b0;\n\t\tend else begin\n\t\t\tif (i_wr && !o_wr_full) begin\n\t\t\t\tmem[w_addr] <= i_wr_data;\n\t\t\t\tw_addr <= w_addr + 1'b1;\n\t\t\t\tw_count <= w_count + 1'b1;\n\t\t\tend\n\t\t\tw_addr_gray <= bin2gray(w_addr);\n\t\t\to_wr_full   <= (w_count == DEPTH);\n\t\tend\n\tend\n\n\t// Read clock domain logic\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\tr_addr      <= {ADDR_W{1'b0}};\n\t\t\tr_addr_gray <= {GRAY_W{1'b0}};\n\t\t\tr_count     <= {CNT_W{1'b0}};\n\t\t\tr_data_reg  <= {WIDTH{1'b0}};\n\t\t\to_rd_empty  <= 1'b1;\n\t\t\to_rd_data   <= {WIDTH{1'b0}};\n\t\tend else begin\n\t\t\tif (i_rd && !o_rd_empty) begin\n\t\t\t\tr_addr <= r_addr + 1'b1;\n\t\t\t\tr_count <= r_count + 1'b1;\n\t\t\t\tif (OPT_REGISTER_READS)\n\t\t\t\t\tr_data_reg <= mem[r_addr];\n\t\t\tend\n\t\t\tr_addr_gray <= bin2gray(r_addr);\n\t\t\to_rd_empty  <= (r_count == 0);\n\t\t\tif (OPT_REGISTER_READS)\n\t\t\t\to_rd_data <= r_data_reg;\n\t\t\telse\n\t\t\t\to_rd_data <= mem[r_addr];\n\t\tend\n\tend\n\n\t// Synchronizers for write pointer gray code into read domain\n\treg [GRAY_W-1:0] w_gray_sync [0:NFF-1];\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\tw_gray_sync[0] <= {GRAY_W{1'b0}};\n\t\t\tfor (i = 1; i < NFF; i = i + 1)\n\t\t\t\tw_gray_sync[i] <= {GRAY_W{1'b0}};\n\t\tend else begin\n\t\t\tw_gray_sync[0] <= w_addr_gray;\n\t\t\tfor (i = 1; i < NFF; i = i + 1)\n\t\t\t\tw_gray_sync[i] <= w_gray_sync[i-1];\n\t\tend\n\tend\n\n\t// Synchronizers for read pointer gray code into write domain\n\treg [GRAY_W-1:0] r_gray_sync [0:NFF-1];\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\tr_gray_sync[0] <= {GRAY_W{1'b0}};\n\t\t\tfor (i = 1; i < NFF; i = i + 1)\n\t\t\t\tr_gray_sync[i] <= {GRAY_W{1'b0}};\n\t\tend else begin\n\t\t\tr_gray_sync[0] <= r_addr_gray;\n\t\t\tfor (i = 1; i < NFF; i = i + 1)\n\t\t\t\tr_gray_sync[i] <= r_gray_sync[i-1];\n\t\tend\n\tend\n\n\t// Read domain: compute write count from synchronized gray code\n\twire [CNT_W-1:0] w_count_sync = gray2bin(w_gray_sync[NFF-1]);\n\n\t// Write domain: compute read count from synchronized gray code\n\twire [CNT_W-1:0] r_count_sync = gray2bin(r_gray_sync[NFF-1]);\n\n\t// Update counts in respective domains\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\tr_count <= {CNT_W{1'b0}};\n\t\telse\n\t\t\tr_count <= w_count_sync;\n\tend\n\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\tw_count <= {CNT_W{1'b0}};\n\t\telse\n\t\t\tw_count <= r_count_sync;\n\tend\n\nendmodule\n```<|im_end|>",
