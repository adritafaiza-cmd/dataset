  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam ADDR_W = LGFIFO;\n\tlocalparam CNT_W = LGFIFO + 1;\n\n\t// Memory\n\treg [WIDTH-1:0] mem [0:DEPTH-1];\n\n\t// Write pointer (write clock domain)\n\treg [ADDR_W:0] wptr;\n\t// Read pointer (read clock domain)\n\treg [ADDR_W:0] rptr;\n\n\t// Gray code pointers\n\twire [ADDR_W:0] wptr_gray = wptr ^ (wptr >> 1);\n\twire [ADDR_W:0] rptr_gray = rptr ^ (rptr >> 1);\n\n\t// Synchronizers for write pointer gray into read domain\n\treg [ADDR_W:0] rptr_gray_sync [0:NFF-1];\n\t// Synchronizers for read pointer gray into write domain\n\treg [ADDR_W:0] wptr_gray_sync [0:NFF-1];\n\n\t// Binary read pointer in write domain (for full calculation)\n\treg [ADDR_W:0] rptr_bin_w;\n\t// Binary write pointer in read domain (for empty calculation)\n\treg [ADDR_W:0] wptr_bin_r;\n\n\t// Gray to binary conversion\n\tfunction [ADDR_W:0] gray2bin;\n\t\tinput [ADDR_W:0] gray;\n\t\treg [ADDR_W:0] bin;\n\t\tinteger i;\n\t\tbegin\n\t\t\tbin[ADDR_W] = gray[ADDR_W];\n\t\t\tfor (i = ADDR_W-1; i >= 0; i = i-1)\n\t\t\t\tbin[i] = bin[i+1] ^ gray[i];\n\t\t\tgray2bin = bin;\n\t\tend\n\tendfunction\n\n\t// Write clock domain logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twptr <= {ADDR_W+1{1'b0}};\n\t\tend else if (i_wr && !o_wr_full) begin\n\t\t\twptr <= wptr + 1'b1;\n\t\tend\n\tend\n\n\t// Write to memory\n\talways @(posedge i_wclk) begin\n\t\tif (i_wr && !o_wr_full) begin\n\t\t\tmem[wptr[ADDR_W-1:0]] <= i_wr_data;\n\t\tend\n\tend\n\n\t// Synchronize read pointer gray into write domain\n\talways @(posedge i_wclk) begin\n\t\trptr_gray_sync[0] <= rptr_gray;\n\t\tfor (integer i = 1; i < NFF; i = i+1)\n\t\t\trptr_gray_sync[i] <= rptr_gray_sync[i-1];\n\tend\n\n\t// Convert synchronized gray to binary in write domain\n\talways @(posedge i_wclk) begin\n\t\trptr_bin_w <= gray2bin(rptr_gray_sync[NFF-1]);\n\tend\n\n\t// Full flag: write pointer has lapped read pointer by DEPTH\n\t// Full when wptr[ADDR_W] != rptr_bin_w[ADDR_W] and wptr[ADDR_W-1:0] == rptr_bin_w[ADDR_W-1:0]\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\to_wr_full <= 1'b0;\n\t\telse\n\t\t\to_wr_full <= (wptr[ADDR_W] != rptr_bin_w[ADDR_W]) && \n\t\t\t\t\t\t (wptr[ADDR_W-1:0] == rptr_bin_w[ADDR_W-1:0]);\n\tend\n\n\t// Read clock domain logic\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trptr <= {ADDR_W+1{1'b0}};\n\t\tend else if (i_rd && !o_rd_empty) begin\n\t\t\trptr <= rptr + 1'b1;\n\t\tend\n\tend\n\n\t// Synchronize write pointer gray into read domain\n\talways @(posedge i_rclk) begin\n\t\twptr_gray_sync[0] <= wptr_gray;\n\t\tfor (integer i = 1; i < NFF; i = i+1)\n\t\t\twptr_gray_sync[i] <= wptr_gray_sync[i-1];\n\tend\n\n\t// Convert synchronized gray to binary in read domain\n\talways @(posedge i_rclk) begin\n\t\twptr_bin_r <= gray2bin(wptr_gray_sync[NFF-1]);\n\tend\n\n\t// Empty flag: write pointer equals read pointer\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_empty <= 1'b1;\n\t\telse\n\t\t\to_rd_empty <= (wptr_bin_r == rptr);\n\tend\n\n\t// Read data\n\t// If OPT_REGISTER_READS is 1, register the read data\n\t// If OPT_REGISTER_READS is 0, combinational read\n\twire [WIDTH-1:0] rd_addr = rptr[ADDR_W-1:0];\n\twire [WIDTH-1:0] mem_rd = mem[rd_addr];\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_data <= {WIDTH{1'b0}};\n\t\telse if (OPT_REGISTER_READS)\n\t\t\to_rd_data <= mem_rd;\n\t\telse\n\t\t\to_rd_data <= mem_rd;\n\tend\n\nendmodule\n```<|im_end|>",
