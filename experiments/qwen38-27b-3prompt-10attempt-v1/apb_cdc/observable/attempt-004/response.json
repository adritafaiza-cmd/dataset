  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH;\n\n    // Request FIFO (src -> dst)\n    reg [DATA_WIDTH-1:0] req_fifo [0:DEPTH-1];\n    reg [ADDR_WIDTH-1:0] req_addr_fifo [0:DEPTH-1];\n    reg [DATA_WIDTH/8-1:0] req_strb_fifo [0:DEPTH-1];\n    reg [2:0] req_prot_fifo [0:DEPTH-1];\n    reg req_write_fifo [0:DEPTH-1];\n\n    reg [PTR_WIDTH-1:0] req_wr_ptr;\n    reg [PTR_WIDTH-1:0] req_rd_ptr;\n\n    // Response FIFO (dst -> src)\n    reg [DATA_WIDTH-1:0] rsp_data_fifo [0:DEPTH-1];\n    reg rsp_err_fifo [0:DEPTH-1];\n\n    reg [PTR_WIDTH-1:0] rsp_wr_ptr;\n    reg [PTR_WIDTH-1:0] rsp_rd_ptr;\n\n    // Gray code pointers for CDC\n    reg [PTR_WIDTH:0] req_wr_ptr_gray;\n    reg [PTR_WIDTH:0] req_rd_ptr_gray;\n    reg [PTR_WIDTH:0] rsp_wr_ptr_gray;\n    reg [PTR_WIDTH:0] rsp_rd_ptr_gray;\n\n    // Synchronized pointers\n    reg [PTR_WIDTH:0] req_wr_ptr_gray_dst;\n    reg [PTR_WIDTH:0] req_wr_ptr_gray_dst_d;\n    reg [PTR_WIDTH:0] req_rd_ptr_gray_src;\n    reg [PTR_WIDTH:0] req_rd_ptr_gray_src_d;\n    reg [PTR_WIDTH:0] rsp_wr_ptr_gray_src;\n    reg [PTR_WIDTH:0] rsp_wr_ptr_gray_src_d;\n    reg [PTR_WIDTH:0] rsp_rd_ptr_gray_dst;\n    reg [PTR_WIDTH:0] rsp_rd_ptr_gray_dst_d;\n\n    // Convert binary to gray\n    function [PTR_WIDTH:0] bin2gray;\n        input [PTR_WIDTH:0] bin;\n        begin\n            bin2gray = (bin >> 1) ^ bin;\n        end\n    endfunction\n\n    // Convert gray to binary\n    function [PTR_WIDTH:0] gray2bin;\n        input [PTR_WIDTH:0] gray;\n        reg [PTR_WIDTH:0] bin;\n        integer i;\n        begin\n            bin[PTR_WIDTH] = gray[PTR_WIDTH];\n            for (i = PTR_WIDTH-1; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // FIFO full/empty checks\n    wire req_full;\n    wire req_empty;\n    wire rsp_full;\n    wire rsp_empty;\n\n    wire [PTR_WIDTH:0] req_wr_ptr_gray_dst_sync;\n    wire [PTR_WIDTH:0] req_rd_ptr_gray_src_sync;\n    wire [PTR_WIDTH:0] rsp_wr_ptr_gray_src_sync;\n    wire [PTR_WIDTH:0] rsp_rd_ptr_gray_dst_sync;\n\n    assign req_wr_ptr_gray_dst_sync = req_wr_ptr_gray_dst;\n    assign req_rd_ptr_gray_src_sync = req_rd_ptr_gray_src;\n    assign rsp_wr_ptr_gray_src_sync = rsp_wr_ptr_gray_src;\n    assign rsp_rd_ptr_gray_dst_sync = rsp_rd_ptr_gray_dst;\n\n    // In src domain: check if req FIFO is full\n    // Full when gray write pointer equals gray read pointer with MSB different\n    wire [PTR_WIDTH:0] req_rd_ptr_gray_src_bin;\n    wire [PTR_WIDTH:0] req_wr_ptr_gray_src_bin;\n    assign req_rd_ptr_gray_src_bin = gray2bin(req_rd_ptr_gray_src);\n    assign req_wr_ptr_gray_src_bin = gray2bin(req_wr_ptr_gray);\n\n    // Full condition: write pointer has lapped read pointer\n    // In gray code, full when upper bit differs and lower bits are same\n    wire req_full_src;\n    assign req_full_src = (req_wr_ptr_gray[PTR_WIDTH] != req_rd_ptr_gray_src[PTR_WIDTH]) &&\n                          (req_wr_ptr_gray[PTR_WIDTH-1:0] == req_rd_ptr_gray_src[PTR_WIDTH-1:0]);\n\n    // In dst domain: check if req FIFO is empty\n    wire [PTR_WIDTH:0] req_wr_ptr_gray_dst_bin;\n    wire [PTR_WIDTH:0] req_rd_ptr_gray_dst_bin;\n    assign req_wr_ptr_gray_dst_bin = gray2bin(req_wr_ptr_gray_dst);\n    assign req_rd_ptr_gray_dst_bin = gray2bin(req_rd_ptr_gray);\n\n    wire req_empty_dst;\n    assign req_empty_dst = (req_wr_ptr_gray_dst == req_rd_ptr_gray);\n\n    // In dst domain: check if rsp FIFO is full\n    wire rsp_full_dst;\n    assign rsp_full_dst = (rsp_wr_ptr_gray[PTR_WIDTH] != rsp_rd_ptr_gray_dst[PTR_WIDTH]) &&\n                          (rsp_wr_ptr_gray[PTR_WIDTH-1:0] == rsp_rd_ptr_gray_dst[PTR_WIDTH-1:0]);\n\n    // In src domain: check if rsp FIFO is empty\n    wire rsp_empty_src;\n    assign rsp_empty_src = (rsp_wr_ptr_gray_src == rsp_rd_ptr_gray);\n\n    // Synchronize gray pointers\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            req_wr_ptr_gray_dst <= 0;\n            req_wr_ptr_gray_dst_d <= 0;\n            rsp_rd_ptr_gray_dst <= 0;\n            rsp_rd_ptr_gray_dst_d <= 0;\n        end else begin\n            req_wr_ptr_gray_dst <= req_wr_ptr_gray;\n            req_wr_ptr_gray_dst_d <= req_wr_ptr_gray_dst;\n            rsp_rd_ptr_gray_dst <= rsp_rd_ptr_gray;\n            rsp_rd_ptr_gray_dst_d <= rsp_rd_ptr_gray_dst;\n        end\n    end\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            req_rd_ptr_gray_src <= 0;\n            req_rd_ptr_gray_src_d <= 0;\n            rsp_wr_ptr_gray_src <= 0;\n            rsp_wr_ptr_gray_src_d <= 0;\n        end else begin\n            req_rd_ptr_gray_src <= req_rd_ptr_gray;\n            req_rd_ptr_gray_src_d <= req_rd_ptr_gray_src;\n            rsp_wr_ptr_gray_src <= rsp_wr_ptr_gray;\n            rsp_wr_ptr_gray_src_d <= rsp_wr_ptr_gray_src;\n        end\n    end\n\n    // Use the second stage of synchronization for stability\n    wire req_full = req_full_src;\n    wire req_empty = req_empty_dst;\n    wire rsp_full = rsp_full_dst;\n    wire rsp_empty = rsp_empty_src;\n\n    // Source side: APB slave interface\n    reg src_pready_r;\n    reg [DATA_WIDTH-1:0] src_prdata_r;\n    reg src_pslverr_r;\n\n    assign src_pready_o = src_pready_r;\n    assign src_prdata_o = src_prdata_r;\n    assign src_pslverr_o = src_pslverr_r;\n\n    // Detect setup phase: PSEL high, PENABLE low\n    wire src_setup = src_psel_i && !src_penable_i;\n    // Detect access phase: PSEL high, PENABLE high\n    wire src_access = src_psel_i && src_penable_i;\n\n    // Write request to FIFO during setup phase if not full\n    wire src_req_valid = src_setup && !req_full;\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            req_wr_ptr <= 0;\n            req_wr_ptr_gray <= 0;\n            rsp_rd_ptr <= 0;\n            rsp_rd_ptr_gray <= 0;\n            src_pready_r <= 1'b0;\n            src_prdata_r <= 0;\n            src_pslverr_r <= 1'b0;\n        end else begin\n            // Write request to FIFO\n            if (src_req_valid) begin\n                req_fifo[req_wr_ptr[PTR_WIDTH-1:0]] <= src_pwdata_i;\n                req_addr_fifo[req_wr_ptr[PTR_WIDTH-1:0]] <= src_paddr_i;\n                req_strb_fifo[req_wr_ptr[PTR_WIDTH-1:0]] <= src_pstrb_i;\n                req_prot_fifo[req_wr_ptr[PTR_WIDTH-1:0]] <= src_pprot_i;\n                req_write_fifo[req_wr_ptr[PTR_WIDTH-1:0]] <= src_pwrite_i;\n                req_wr_ptr <= req_wr_ptr + 1'b1;\n                req_wr_ptr_gray <= bin2gray(req_wr_ptr + 1'b1);\n            end\n\n            // Read response from FIFO\n            if (!rsp_empty) begin\n                src_prdata_r <= rsp_data_fifo[rsp_rd_ptr[PTR_WIDTH-1:0]];\n                src_pslverr_r <= rsp_err_fifo[rsp_rd_ptr[PTR_WIDTH-1:0]];\n                rsp_rd_ptr <= rsp_rd_ptr + 1'b1;\n                rsp_rd_ptr_gray <= bin2gray(rsp_rd_ptr + 1'b1);\n            end\n\n            // Pready logic:\n            // During setup: pready = 1 if FIFO not full (can accept new request)\n            // During access: pready = 1 if response is available\n            if (src_setup) begin\n                src_pready_r <= !req_full;\n            end else if (src_access) begin\n                src_pready_r <= !rsp_empty;\n            end else begin\n                src_pready_r <= 1'b0;\n            end\n        end\n    end\n\n    // Destination side: APB master interface\n    reg dst_psel_r;\n    reg dst_penable_r;\n    reg dst_pwrite_r;\n    reg [ADDR_WIDTH-1:0] dst_paddr_r;\n    reg [DATA_WIDTH-1:0] dst_pwdata_r;\n    reg [DATA_WIDTH/8-1:0] dst_pstrb_r;\n    reg [2:0] dst_pprot_r;\n\n    assign dst_psel_o = dst_psel_r;\n    assign dst_penable_o = dst_penable_r;\n    assign dst_pwrite_o = dst_pwrite_r;\n    assign dst_paddr_o = dst_paddr_r;\n    assign dst_pwdata_o = dst_pwdata_r;\n    assign dst_pstrb_o = dst_pstrb_r;\n    assign dst_pprot_o = dst_pprot_r;\n\n    // Detect when request FIFO has data\n    wire dst_req_valid = !req_empty;\n\n    // Detect when response FIFO has space\n    wire dst_rsp_space = !rsp_full;\n\n    // APB master state machine\n    // State 0: Idle (no transaction)\n    // State 1: Setup (PSEL=1, PENABLE=0)\n    // State 2: Access (PSEL=1, PENABLE=1)\n\n    reg [1:0] dst_state;\n    localparam DST_IDLE = 2'b00;\n    localparam DST_SETUP = 2'b01;\n    localparam DST_ACCESS = 2'b10;\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            req_rd_ptr <= 0;\n            req_rd_ptr_gray <= 0;\n            rsp_wr_ptr <= 0;\n            rsp_wr_ptr_gray <= 0;\n            dst_psel_r <= 1'b0;\n            dst_penable_r <= 1'b0;\n            dst_pwrite_r <= 1'b0;\n            dst_paddr_r <= 0;\n            dst_pwdata_r <= 0;\n            dst_pstrb_r <= 0;\n            dst_pprot_r <= 0;\n            dst_state <= DST_IDLE;\n        end else begin\n            case (dst_state)\n                DST_IDLE: begin\n                    dst_psel_r <= 1'b0;\n                    dst_penable_r <= 1'b0;\n                    if (dst_req_valid) begin\n                        // Load request from FIFO\n                        dst_pwrite_r <= req_write_fifo[req_rd_ptr[PTR_WIDTH-1:0]];\n                        dst_paddr_r <= req_addr_fifo[req_rd_ptr[PTR_WIDTH-1:0]];\n                        dst_pwdata_r <= req_fifo[req_rd_ptr[PTR_WIDTH-1:0]];\n                        dst_pstrb_r <= req_strb_fifo[req_rd_ptr[PTR_WIDTH-1:0]];\n                        dst_pprot_r <= req_prot_fifo[req_rd_ptr[PTR_WIDTH-1:0]];\n                        dst_psel_r <= 1'b1;\n                        dst_penable_r <= 1'b0;\n                        dst_state <= DST_SETUP;\n                    end\n                end\n\n                DST_SETUP: begin\n                    dst_psel_r <= 1'b1;\n                    dst_penable_r <= 1'b1;\n                    dst_state <= DST_ACCESS;\n                end\n\n                DST_ACCESS: begin\n                    dst_psel_r <= 1'b1;\n                    dst_penable_r <= 1'b1;\n                    if (dst_pready_i) begin\n                        // Write response to FIFO\n                        if (dst_rsp_space) begin\n                            rsp_data_fifo[rsp_wr_ptr[PTR_WIDTH-1:0]] <= dst_prdata_i;\n                            rsp_err_fifo[rsp_wr_ptr[PTR_WIDTH-1:0]] <= dst_pslverr_i;\n                            rsp_wr_ptr <= rsp_wr_ptr + 1'b1;\n                            rsp_wr_ptr_gray <= bin2gray(rsp_wr_ptr + 1'b1);\n                        end\n                        // Advance read pointer\n                        req_rd_ptr <= req_rd_ptr + 1'b1;\n                        req_rd_ptr_gray <= bin2gray(req_rd_ptr + 1'b1);\n                        dst_state <= DST_IDLE;\n                    end\n                end\n\n                default: begin\n                    dst_state <= DST_IDLE;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
