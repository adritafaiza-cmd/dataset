  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // Source side state\n    reg src_state;\n    localparam SRC_IDLE = 1'b0;\n    localparam SRC_WAIT = 1'b1;\n\n    // Destination side state\n    reg dst_state;\n    localparam DST_IDLE = 1'b0;\n    localparam DST_SETUP = 1'b1;\n    localparam DST_ACCESS = 1'b10;\n\n    // FIFO control signals\n    reg src_wr_en;\n    reg dst_rd_en;\n    reg fifo_empty;\n    reg fifo_full;\n\n    // FIFO data\n    reg [ADDR_WIDTH-1:0] fifo_addr;\n    reg [DATA_WIDTH-1:0] fifo_wdata;\n    reg [DATA_WIDTH/8-1:0] fifo_strb;\n    reg [2:0] fifo_pprot;\n    reg fifo_write;\n\n    // Synchronizers\n    reg [1:0] dst_pready_sync;\n    reg [1:0] dst_pslverr_sync;\n    reg [1:0] dst_prdata_sync; // We'll use a different approach for data\n\n    // Actually, let's use a simpler approach with a single outstanding transaction\n    // and synchronizers for the control signals.\n\n    // Source side: capture request when in IDLE and PSEL is high\n    wire src_req_valid = src_psel_i && !src_penable_i && !src_state;\n\n    // Destination side: generate APB signals\n    assign dst_psel_o = (dst_state == DST_SETUP) || (dst_state == DST_ACCESS);\n    assign dst_penable_o = (dst_state == DST_ACCESS);\n    assign dst_pwrite_o = fifo_write;\n    assign dst_paddr_o = fifo_addr;\n    assign dst_pwdata_o = fifo_wdata;\n    assign dst_pstrb_o = fifo_strb;\n    assign dst_pprot_o = fifo_pprot;\n\n    // Source side outputs\n    assign src_pready_o = (src_state == SRC_IDLE) && !src_psel_i;\n    assign src_prdata_o = dst_prdata_i;\n    assign src_pslverr_o = dst_pslverr_i;\n\n    // Synchronizers for destination ready and error\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_pready_sync <= 2'b00;\n        else\n            dst_pready_sync <= {dst_pready_sync[0], dst_pready_i};\n    end\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_pslverr_sync <= 2'b00;\n        else\n            dst_pslverr_sync <= {dst_pslverr_sync[0], dst_pslverr_i};\n    end\n\n    // Synchronizer for read data - we need to capture it when the transfer completes\n    reg [DATA_WIDTH-1:0] dst_prdata_reg;\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_prdata_reg <= {DATA_WIDTH{1'b0}};\n        else if (dst_state == DST_ACCESS && dst_pready_i)\n            dst_prdata_reg <= dst_prdata_i;\n    end\n\n    // Synchronizer for slave error\n    reg dst_pslverr_reg;\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_pslverr_reg <= 1'b0;\n        else if (dst_state == DST_ACCESS && dst_pready_i)\n            dst_pslverr_reg <= dst_pslverr_i;\n    end\n\n    // Synchronizers to source domain\n    reg [1:0] dst_done_sync;\n    reg [1:0] dst_pslverr_src_sync;\n    reg [DATA_WIDTH-1:0] dst_prdata_src_sync;\n\n    // We need to synchronize the completion signal\n    reg dst_done;\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_done <= 1'b0;\n        else\n            dst_done <= (dst_state == DST_ACCESS) && dst_pready_i;\n    end\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            dst_done_sync <= 2'b00;\n        else\n            dst_done_sync <= {dst_done_sync[0], dst_done};\n    end\n\n    // Synchronize read data and error to source domain\n    // We'll use a simple approach: when dst_done is synchronized, capture the data\n    reg [DATA_WIDTH-1:0] src_prdata_reg;\n    reg src_pslverr_reg;\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_prdata_reg <= {DATA_WIDTH{1'b0}};\n            src_pslverr_reg <= 1'b0;\n        end else if (dst_done_sync[1] && !dst_done_sync[0]) begin\n            // This is a rising edge of the synchronized done signal\n            // But we need the data to be stable. Let's use a different approach.\n        end\n    end\n\n    // Let's use a simpler approach: since we have only one outstanding transaction,\n    // we can synchronize the data and error when the transfer completes.\n    \n    // Actually, let's redesign with a cleaner approach using a FIFO for the request\n    // and synchronizers for the response.\n\n    // Reset the module\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_state <= SRC_IDLE;\n            src_wr_en <= 1'b0;\n        end else begin\n            case (src_state)\n                SRC_IDLE: begin\n                    src_wr_en <= 1'b0;\n                    if (src_psel_i && !src_penable_i) begin\n                        src_wr_en <= 1'b1;\n                        src_state <= SRC_WAIT;\n                    end\n                end\n                SRC_WAIT: begin\n                    src_wr_en <= 1'b0;\n                    if (dst_done_sync[1] && !dst_done_sync[0]) begin\n                        src_state <= SRC_IDLE;\n                    end\n                end\n                default: src_state <= SRC_IDLE;\n            endcase\n        end\n    end\n\n    // Capture request data\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            fifo_addr <= {ADDR_WIDTH{1'b0}};\n            fifo_wdata <= {DATA_WIDTH{1'b0}};\n            fifo_strb <= {(DATA_WIDTH/8){1'b0}};\n            fifo_pprot <= 3'b000;\n            fifo_write <= 1'b0;\n        end else if (src_wr_en) begin\n            fifo_addr <= src_paddr_i;\n            fifo_wdata <= src_pwdata_i;\n            fifo_strb <= src_pstrb_i;\n            fifo_pprot <= src_pprot_i;\n            fifo_write <= src_pwrite_i;\n        end\n    end\n\n    // Destination side state machine\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_state <= DST_IDLE;\n            dst_rd_en <= 1'b0;\n        end else begin\n            dst_rd_en <= 1'b0;\n            case (dst_state)\n                DST_IDLE: begin\n                    if (fifo_empty == 1'b0) begin\n                        dst_state <= DST_SETUP;\n                        dst_rd_en <= 1'b1;\n                    end\n                end\n                DST_SETUP: begin\n                    dst_state <= DST_ACCESS;\n                end\n                DST_ACCESS: begin\n                    if (dst_pready_i) begin\n                        dst_state <= DST_IDLE;\n                    end\n                end\n                default: dst_state <= DST_IDLE;\n            endcase\n        end\n    end\n\n    // Simple FIFO implementation (depth = 2^LOG_DEPTH)\n    // For simplicity, we'll use a single-entry FIFO since LOG_DEPTH=1 means 2 entries\n    // but we only need one outstanding transaction.\n    \n    // Let's use a simple register-based approach since we only have one outstanding transaction\n    reg fifo_valid;\n    \n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            fifo_valid <= 1'b0;\n        else if (src_wr_en)\n            fifo_valid <= 1'b1;\n        else if (dst_rd_en_sync[1] && !dst_rd_en_sync[0])\n            fifo_valid <= 1'b0;\n    end\n\n    // Synchronize dst_rd_en to source domain\n    reg [1:0] dst_rd_en_sync;\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            dst_rd_en_sync <= 2'b00;\n        else\n            dst_rd_en_sync <= {dst_rd_en_sync[0], dst_rd_en};\n    end\n\n    // Synchronize fifo_valid to destination domain\n    reg [1:0] fifo_valid_sync;\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            fifo_valid_sync <= 2'b00;\n        else\n            fifo_valid_sync <= {fifo_valid_sync[0], fifo_valid};\n    end\n\n    assign fifo_empty = !fifo_valid_sync[1];\n    assign fifo_full = fifo_valid;\n\n    // Synchronize read data and error to source domain\n    // We'll use a handshake approach\n    reg [DATA_WIDTH-1:0] src_prdata_reg;\n    reg src_pslverr_reg;\n    reg src_data_valid;\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_prdata_reg <= {DATA_WIDTH{1'b0}};\n            src_pslverr_reg <= 1'b0;\n            src_data_valid <= 1'b0;\n        end else if (dst_done_sync[1] && !dst_done_sync[0]) begin\n            src_prdata_reg <= dst_prdata_reg;\n            src_pslverr_reg <= dst_pslverr_reg;\n            src_data_valid <= 1'b1;\n        end else if (src_state == SRC_IDLE && src_psel_i && !src_penable_i) begin\n            src_data_valid <= 1'b0;\n        end\n    end\n\n    assign src_prdata_o = src_prdata_reg;\n    assign src_pslverr_o = src_pslverr_reg;\n\nendmodule\n```<|im_end|>",
