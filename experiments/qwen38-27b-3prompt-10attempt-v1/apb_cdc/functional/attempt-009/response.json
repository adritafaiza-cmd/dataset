  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // Source side state\n    reg src_state;\n    localparam SRC_IDLE = 1'b0;\n    localparam SRC_WAIT = 1'b1;\n\n    // Destination side state\n    reg dst_state;\n    localparam DST_IDLE = 1'b0;\n    localparam DST_SETUP = 1'b1;\n    localparam DST_ACCESS = 1'b2;\n\n    // Synchronization signals\n    reg [1:0] req_sync;\n    reg [1:0] done_sync;\n\n    // Request FIFO (1 entry)\n    reg req_valid;\n    reg [ADDR_WIDTH-1:0] req_addr;\n    reg [DATA_WIDTH-1:0] req_wdata;\n    reg [DATA_WIDTH/8-1:0] req_strb;\n    reg [2:0] req_prot;\n    reg req_write;\n\n    // Response FIFO (1 entry)\n    reg rsp_valid;\n    reg [DATA_WIDTH-1:0] rsp_data;\n    reg rsp_err;\n\n    // Source side logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_state <= SRC_IDLE;\n            src_pready_o <= 1'b0;\n            src_prdata_o <= {DATA_WIDTH{1'b0}};\n            src_pslverr_o <= 1'b0;\n            req_valid <= 1'b0;\n            req_addr <= {ADDR_WIDTH{1'b0}};\n            req_wdata <= {DATA_WIDTH{1'b0}};\n            req_strb <= {(DATA_WIDTH/8){1'b0}};\n            req_prot <= 3'b0;\n            req_write <= 1'b0;\n            rsp_valid <= 1'b0;\n            rsp_data <= {DATA_WIDTH{1'b0}};\n            rsp_err <= 1'b0;\n        end else begin\n            case (src_state)\n                SRC_IDLE: begin\n                    src_pready_o <= 1'b0;\n                    if (src_psel_i && !src_penable_i) begin\n                        // Setup phase: capture request\n                        req_addr <= src_paddr_i;\n                        req_wdata <= src_pwdata_i;\n                        req_strb <= src_pstrb_i;\n                        req_prot <= src_pprot_i;\n                        req_write <= src_pwrite_i;\n                        req_valid <= 1'b1;\n                        src_state <= SRC_WAIT;\n                    end\n                end\n                SRC_WAIT: begin\n                    src_pready_o <= 1'b0;\n                    if (src_psel_i && src_penable_i) begin\n                        // Access phase: wait for response\n                        if (rsp_valid) begin\n                            src_prdata_o <= rsp_data;\n                            src_pslverr_o <= rsp_err;\n                            src_pready_o <= 1'b1;\n                            rsp_valid <= 1'b0;\n                            req_valid <= 1'b0;\n                            src_state <= SRC_IDLE;\n                        end\n                    end\n                end\n                default: begin\n                    src_state <= SRC_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Synchronize req_valid to destination clock\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            req_sync <= 2'b00;\n        end else begin\n            req_sync <= {req_sync[0], req_valid};\n        end\n    end\n\n    // Synchronize done signal to source clock\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            done_sync <= 2'b00;\n        end else begin\n            done_sync <= {done_sync[0], dst_state == DST_IDLE};\n        end\n    end\n\n    // Destination side logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_state <= DST_IDLE;\n            dst_psel_o <= 1'b0;\n            dst_penable_o <= 1'b0;\n            dst_pwrite_o <= 1'b0;\n            dst_paddr_o <= {ADDR_WIDTH{1'b0}};\n            dst_pwdata_o <= {DATA_WIDTH{1'b0}};\n            dst_pstrb_o <= {(DATA_WIDTH/8){1'b0}};\n            dst_pprot_o <= 3'b0;\n        end else begin\n            case (dst_state)\n                DST_IDLE: begin\n                    dst_psel_o <= 1'b0;\n                    dst_penable_o <= 1'b0;\n                    if (req_sync[1]) begin\n                        // Start setup phase\n                        dst_psel_o <= 1'b1;\n                        dst_penable_o <= 1'b0;\n                        dst_pwrite_o <= req_write;\n                        dst_paddr_o <= req_addr;\n                        dst_pwdata_o <= req_wdata;\n                        dst_pstrb_o <= req_strb;\n                        dst_pprot_o <= req_prot;\n                        dst_state <= DST_SETUP;\n                    end\n                end\n                DST_SETUP: begin\n                    // Move to access phase\n                    dst_psel_o <= 1'b1;\n                    dst_penable_o <= 1'b1;\n                    dst_state <= DST_ACCESS;\n                end\n                DST_ACCESS: begin\n                    if (dst_pready_i) begin\n                        // Transfer complete\n                        dst_psel_o <= 1'b0;\n                        dst_penable_o <= 1'b0;\n                        dst_state <= DST_IDLE;\n                    end\n                end\n                default: begin\n                    dst_state <= DST_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Capture response on destination side\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            rsp_valid <= 1'b0;\n            rsp_data <= {DATA_WIDTH{1'b0}};\n            rsp_err <= 1'b0;\n        end else begin\n            if (dst_state == DST_ACCESS && dst_pready_i) begin\n                rsp_data <= dst_prdata_i;\n                rsp_err <= dst_pslverr_i;\n                rsp_valid <= 1'b1;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
