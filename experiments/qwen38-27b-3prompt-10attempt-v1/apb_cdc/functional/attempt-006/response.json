  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    // Source side state machine\n    localparam SRC_IDLE = 1'b0;\n    localparam SRC_WAIT = 1'b1;\n\n    reg src_state;\n    reg src_pready_r;\n    reg [DATA_WIDTH-1:0] src_prdata_r;\n    reg src_pslverr_r;\n\n    // Destination side state machine\n    localparam DST_IDLE = 2'b00;\n    localparam DST_SETUP = 2'b01;\n    localparam DST_ACCESS = 2'b10;\n\n    reg [1:0] dst_state;\n    reg dst_psel_r;\n    reg dst_penable_r;\n    reg dst_pwrite_r;\n    reg [ADDR_WIDTH-1:0] dst_paddr_r;\n    reg [DATA_WIDTH-1:0] dst_pwdata_r;\n    reg [DATA_WIDTH/8-1:0] dst_pstrb_r;\n    reg [2:0] dst_pprot_r;\n\n    // CDC signals\n    reg src_req_valid;\n    reg [ADDR_WIDTH-1:0] src_req_addr;\n    reg [DATA_WIDTH-1:0] src_req_wdata;\n    reg [DATA_WIDTH/8-1:0] src_req_strb;\n    reg [2:0] src_req_prot;\n    reg src_req_write;\n\n    reg dst_req_valid;\n    reg [ADDR_WIDTH-1:0] dst_req_addr;\n    reg [DATA_WIDTH-1:0] dst_req_wdata;\n    reg [DATA_WIDTH/8-1:0] dst_req_strb;\n    reg [2:0] dst_req_prot;\n    reg dst_req_write;\n\n    reg dst_done;\n    reg [DATA_WIDTH-1:0] dst_done_data;\n    reg dst_done_err;\n\n    // Synchronizers\n    reg [1:0] req_valid_sync;\n    reg [1:0] done_sync;\n\n    // Source clock domain\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_state <= SRC_IDLE;\n            src_pready_r <= 1'b0;\n            src_prdata_r <= {DATA_WIDTH{1'b0}};\n            src_pslverr_r <= 1'b0;\n            src_req_valid <= 1'b0;\n            src_req_addr <= {ADDR_WIDTH{1'b0}};\n            src_req_wdata <= {DATA_WIDTH{1'b0}};\n            src_req_strb <= {(DATA_WIDTH/8){1'b0}};\n            src_req_prot <= 3'b000;\n            src_req_write <= 1'b0;\n        end else begin\n            case (src_state)\n                SRC_IDLE: begin\n                    src_pready_r <= 1'b1;\n                    if (src_psel_i && !src_penable_i) begin\n                        src_state <= SRC_WAIT;\n                        src_pready_r <= 1'b0;\n                        src_req_valid <= 1'b1;\n                        src_req_addr <= src_paddr_i;\n                        src_req_wdata <= src_pwdata_i;\n                        src_req_strb <= src_pstrb_i;\n                        src_req_prot <= src_pprot_i;\n                        src_req_write <= src_pwrite_i;\n                    end\n                end\n                SRC_WAIT: begin\n                    src_pready_r <= 1'b0;\n                    if (done_sync[1]) begin\n                        src_state <= SRC_IDLE;\n                        src_pready_r <= 1'b1;\n                        src_prdata_r <= dst_done_data;\n                        src_pslverr_r <= dst_done_err;\n                        src_req_valid <= 1'b0;\n                    end\n                end\n                default: begin\n                    src_state <= SRC_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Synchronize done signal to source domain\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            done_sync <= 2'b00;\n        end else begin\n            done_sync <= {done_sync[0], dst_done};\n        end\n    end\n\n    // Destination clock domain\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_state <= DST_IDLE;\n            dst_psel_r <= 1'b0;\n            dst_penable_r <= 1'b0;\n            dst_pwrite_r <= 1'b0;\n            dst_paddr_r <= {ADDR_WIDTH{1'b0}};\n            dst_pwdata_r <= {DATA_WIDTH{1'b0}};\n            dst_pstrb_r <= {(DATA_WIDTH/8){1'b0}};\n            dst_pprot_r <= 3'b000;\n            dst_req_valid <= 1'b0;\n            dst_req_addr <= {ADDR_WIDTH{1'b0}};\n            dst_req_wdata <= {DATA_WIDTH{1'b0}};\n            dst_req_strb <= {(DATA_WIDTH/8){1'b0}};\n            dst_req_prot <= 3'b000;\n            dst_req_write <= 1'b0;\n            dst_done <= 1'b0;\n            dst_done_data <= {DATA_WIDTH{1'b0}};\n            dst_done_err <= 1'b0;\n        end else begin\n            case (dst_state)\n                DST_IDLE: begin\n                    dst_psel_r <= 1'b0;\n                    dst_penable_r <= 1'b0;\n                    dst_done <= 1'b0;\n                    if (req_valid_sync[1]) begin\n                        dst_state <= DST_SETUP;\n                        dst_psel_r <= 1'b1;\n                        dst_penable_r <= 1'b0;\n                        dst_pwrite_r <= dst_req_write;\n                        dst_paddr_r <= dst_req_addr;\n                        dst_pwdata_r <= dst_req_wdata;\n                        dst_pstrb_r <= dst_req_strb;\n                        dst_pprot_r <= dst_req_prot;\n                    end\n                end\n                DST_SETUP: begin\n                    dst_psel_r <= 1'b1;\n                    dst_penable_r <= 1'b1;\n                    dst_state <= DST_ACCESS;\n                end\n                DST_ACCESS: begin\n                    dst_psel_r <= 1'b1;\n                    dst_penable_r <= 1'b1;\n                    if (dst_pready_i) begin\n                        dst_state <= DST_IDLE;\n                        dst_psel_r <= 1'b0;\n                        dst_penable_r <= 1'b0;\n                        dst_done <= 1'b1;\n                        dst_done_data <= dst_prdata_i;\n                        dst_done_err <= dst_pslverr_i;\n                    end\n                end\n                default: begin\n                    dst_state <= DST_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Synchronize request valid to destination domain\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            req_valid_sync <= 2'b00;\n        end else begin\n            req_valid_sync <= {req_valid_sync[0], src_req_valid};\n        end\n    end\n\n    // Capture request data in destination domain when valid is synchronized\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req_valid <= 1'b0;\n            dst_req_addr <= {ADDR_WIDTH{1'b0}};\n            dst_req_wdata <= {DATA_WIDTH{1'b0}};\n            dst_req_strb <= {(DATA_WIDTH/8){1'b0}};\n            dst_req_prot <= 3'b000;\n            dst_req_write <= 1'b0;\n        end else begin\n            if (req_valid_sync[1] && !req_valid_sync[0]) begin\n                dst_req_valid <= 1'b1;\n                dst_req_addr <= src_req_addr;\n                dst_req_wdata <= src_req_wdata;\n                dst_req_strb <= src_req_strb;\n                dst_req_prot <= src_req_prot;\n                dst_req_write <= src_req_write;\n            end else if (dst_state == DST_IDLE && req_valid_sync[1]) begin\n                dst_req_valid <= 1'b0;\n            end\n        end\n    end\n\n    // Assign outputs\n    assign src_pready_o = src_pready_r;\n    assign src_prdata_o = src_prdata_r;\n    assign src_pslverr_o = src_pslverr_r;\n    assign dst_psel_o = dst_psel_r;\n    assign dst_penable_o = dst_penable_r;\n    assign dst_pwrite_o = dst_pwrite_r;\n    assign dst_paddr_o = dst_paddr_r;\n    assign dst_pwdata_o = dst_pwdata_r;\n    assign dst_pstrb_o = dst_pstrb_r;\n    assign dst_pprot_o = dst_pprot_r;\n\nendmodule\n```<|im_end|>",
