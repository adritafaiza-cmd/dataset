  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH;\n\n    // Source domain state\n    reg src_state;\n    localparam SRC_IDLE = 1'b0;\n    localparam SRC_WAIT = 1'b1;\n\n    reg [ADDR_WIDTH-1:0] src_addr_reg;\n    reg [DATA_WIDTH-1:0] src_wdata_reg;\n    reg [DATA_WIDTH/8-1:0] src_strb_reg;\n    reg [2:0] src_prot_reg;\n    reg src_write_reg;\n\n    // FIFO pointers\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [PTR_W-1:0] dst_rd_ptr;\n\n    // FIFO valid bits\n    reg [DEPTH-1:0] fifo_valid;\n\n    // FIFO data storage\n    reg [ADDR_WIDTH-1:0] fifo_addr [0:DEPTH-1];\n    reg [DATA_WIDTH-1:0] fifo_wdata [0:DEPTH-1];\n    reg [DATA_WIDTH/8-1:0] fifo_strb [0:DEPTH-1];\n    reg [2:0] fifo_prot [0:DEPTH-1];\n    reg fifo_write [0:DEPTH-1];\n\n    // Destination domain state\n    reg dst_state;\n    localparam DST_IDLE = 1'b0;\n    localparam DST_SETUP = 1'b1;\n    localparam DST_ACCESS = 1'b10;\n\n    reg [ADDR_WIDTH-1:0] dst_addr_reg;\n    reg [DATA_WIDTH-1:0] dst_wdata_reg;\n    reg [DATA_WIDTH/8-1:0] dst_strb_reg;\n    reg [2:0] dst_prot_reg;\n    reg dst_write_reg;\n\n    // Response data\n    reg [DATA_WIDTH-1:0] resp_data_reg;\n    reg resp_err_reg;\n    reg resp_valid_reg;\n\n    // CDC synchronizers\n    // src_wr_ptr -> dst domain\n    reg [PTR_W-1:0] src_wr_ptr_sync1;\n    reg [PTR_W-1:0] src_wr_ptr_sync2;\n    reg [PTR_W-1:0] src_wr_ptr_sync3;\n\n    // dst_rd_ptr -> src domain\n    reg [PTR_W-1:0] dst_rd_ptr_sync1;\n    reg [PTR_W-1:0] dst_rd_ptr_sync2;\n    reg [PTR_W-1:0] dst_rd_ptr_sync3;\n\n    // Response valid -> src domain\n    reg resp_valid_sync1;\n    reg resp_valid_sync2;\n    reg resp_valid_sync3;\n\n    // Response data -> src domain (multi-bit, use handshake or assume stable)\n    // Since we only have one outstanding transaction, we can use a simple\n    // approach: the response data is stable while resp_valid is high.\n    // We'll synchronize the valid bit and capture data when valid transitions.\n\n    // For multi-bit data crossing, we need a safe method.\n    // Since we have only one outstanding transaction, we can use a \n    // \"data valid\" handshake where data is stable when valid is high.\n    // We'll use a simple 2-phase handshake for the response.\n\n    // Actually, let's use a simpler approach: since there's only one \n    // outstanding transaction, we can synchronize the response data \n    // using a \"data ready\" mechanism. But to keep it simple and safe,\n    // let's use a 4-phase handshake for the response data.\n\n    // Let me reconsider. The simplest safe approach for multi-bit data \n    // with one outstanding transaction is to use a \"data valid\" signal \n    // that is synchronized, and the data is guaranteed stable when \n    // valid is high. We can capture the data on the rising edge of \n    // the synchronized valid.\n\n    // Let's implement a simple approach:\n    // - dst domain: when transfer completes, set resp_valid_reg and \n    //   resp_data_reg/resp_err_reg\n    // - src domain: synchronize resp_valid_reg, and when it goes high,\n    //   capture the data (which is stable)\n\n    // But we need to ensure the data is stable. Since we only have one \n    // outstanding transaction, the data won't change until the next \n    // transaction, which won't start until the current one completes.\n\n    // Let's use a 2-phase handshake for the response:\n    // - dst asserts resp_valid\n    // - src synchronizes resp_valid, captures data, then asserts resp_ack\n    // - dst synchronizes resp_ack, deasserts resp_valid\n\n    // This is getting complex. Let's use a simpler approach:\n    // Since we have only one outstanding transaction, we can use a \n    // \"data valid\" signal that is synchronized, and the data is \n    // guaranteed stable. We'll capture the data on the rising edge \n    // of the synchronized valid.\n\n    // Let's implement it this way:\n\n    // Synchronize src_wr_ptr to dst domain\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            src_wr_ptr_sync1 <= {PTR_W{1'b0}};\n            src_wr_ptr_sync2 <= {PTR_W{1'b0}};\n            src_wr_ptr_sync3 <= {PTR_W{1'b0}};\n        end else begin\n            src_wr_ptr_sync1 <= src_wr_ptr;\n            src_wr_ptr_sync2 <= src_wr_ptr_sync1;\n            src_wr_ptr_sync3 <= src_wr_ptr_sync2;\n        end\n    end\n\n    // Synchronize dst_rd_ptr to src domain\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            dst_rd_ptr_sync1 <= {PTR_W{1'b0}};\n            dst_rd_ptr_sync2 <= {PTR_W{1'b0}};\n            dst_rd_ptr_sync3 <= {PTR_W{1'b0}};\n        end else begin\n            dst_rd_ptr_sync1 <= dst_rd_ptr;\n            dst_rd_ptr_sync2 <= dst_rd_ptr_sync1;\n            dst_rd_ptr_sync3 <= dst_rd_ptr_sync2;\n        end\n    end\n\n    // Synchronize resp_valid to src domain\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            resp_valid_sync1 <= 1'b0;\n            resp_valid_sync2 <= 1'b0;\n            resp_valid_sync3 <= 1'b0;\n        end else begin\n            resp_valid_sync1 <= resp_valid_reg;\n            resp_valid_sync2 <= resp_valid_sync1;\n            resp_valid_sync3 <= resp_valid_sync2;\n        end\n    end\n\n    // Synchronize resp_ack to dst domain\n    reg resp_ack_reg;\n    reg resp_ack_sync1;\n    reg resp_ack_sync2;\n    reg resp_ack_sync3;\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            resp_ack_sync1 <= 1'b0;\n            resp_ack_sync2 <= 1'b0;\n            resp_ack_sync3 <= 1'b0;\n        end else begin\n            resp_ack_sync1 <= resp_ack_reg;\n            resp_ack_sync2 <= resp_ack_sync1;\n            resp_ack_sync3 <= resp_ack_sync2;\n        end\n    end\n\n    // Source domain logic\n    wire src_fifo_full = (src_wr_ptr == dst_rd_ptr_sync3) && (fifo_valid[src_wr_ptr[PTR_W-1:0]] == 1'b1);\n    wire src_fifo_empty = (src_wr_ptr == dst_rd_ptr_sync3) && (fifo_valid[src_wr_ptr[PTR_W-1:0]] == 1'b0);\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_state <= SRC_IDLE;\n            src_addr_reg <= {ADDR_WIDTH{1'b0}};\n            src_wdata_reg <= {DATA_WIDTH{1'b0}};\n            src_strb_reg <= {(DATA_WIDTH/8){1'b0}};\n            src_prot_reg <= 3'b000;\n            src_write_reg <= 1'b0;\n            src_wr_ptr <= {PTR_W{1'b0}};\n            fifo_valid <= {DEPTH{1'b0}};\n            resp_ack_reg <= 1'b0;\n        end else begin\n            case (src_state)\n                SRC_IDLE: begin\n                    if (src_psel_i && !src_penable_i && !src_fifo_full) begin\n                        src_state <= SRC_WAIT;\n                        src_addr_reg <= src_paddr_i;\n                        src_wdata_reg <= src_pwdata_i;\n                        src_strb_reg <= src_pstrb_i;\n                        src_prot_reg <= src_pprot_i;\n                        src_write_reg <= src_pwrite_i;\n                        fifo_addr[src_wr_ptr[PTR_W-1:0]] <= src_paddr_i;\n                        fifo_wdata[src_wr_ptr[PTR_W-1:0]] <= src_pwdata_i;\n                        fifo_strb[src_wr_ptr[PTR_W-1:0]] <= src_pstrb_i;\n                        fifo_prot[src_wr_ptr[PTR_W-1:0]] <= src_pprot_i;\n                        fifo_write[src_wr_ptr[PTR_W-1:0]] <= src_pwrite_i;\n                        fifo_valid[src_wr_ptr[PTR_W-1:0]] <= 1'b1;\n                        src_wr_ptr <= src_wr_ptr + 1'b1;\n                    end\n                end\n                SRC_WAIT: begin\n                    if (resp_valid_sync3 && !resp_ack_reg) begin\n                        resp_ack_reg <= 1'b1;\n                    end\n                    if (resp_ack_reg && !resp_valid_sync3) begin\n                        resp_ack_reg <= 1'b0;\n                        src_state <= SRC_IDLE;\n                    end\n                end\n                default: src_state <= SRC_IDLE;\n            endcase\n        end\n    end\n\n    assign src_pready_o = (src_state == SRC_IDLE) && !src_fifo_full;\n    assign src_prdata_o = resp_data_reg;\n    assign src_pslverr_o = resp_err_reg;\n\n    // Destination domain logic\n    wire dst_fifo_empty = (dst_rd_ptr == src_wr_ptr_sync3) && (fifo_valid[dst_rd_ptr[PTR_W-1:0]] == 1'b0);\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_state <= DST_IDLE;\n            dst_addr_reg <= {ADDR_WIDTH{1'b0}};\n            dst_wdata_reg <= {DATA_WIDTH{1'b0}};\n            dst_strb_reg <= {(DATA_WIDTH/8){1'b0}};\n            dst_prot_reg <= 3'b000;\n            dst_write_reg <= 1'b0;\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            resp_data_reg <= {DATA_WIDTH{1'b0}};\n            resp_err_reg <= 1'b0;\n            resp_valid_reg <= 1'b0;\n        end else begin\n            case (dst_state)\n                DST_IDLE: begin\n                    if (!dst_fifo_empty) begin\n                        dst_state <= DST_SETUP;\n                        dst_addr_reg <= fifo_addr[dst_rd_ptr[PTR_W-1:0]];\n                        dst_wdata_reg <= fifo_wdata[dst_rd_ptr[PTR_W-1:0]];\n                        dst_strb_reg <= fifo_strb[dst_rd_ptr[PTR_W-1:0]];\n                        dst_prot_reg <= fifo_prot[dst_rd_ptr[PTR_W-1:0]];\n                        dst_write_reg <= fifo_write[dst_rd_ptr[PTR_W-1:0]];\n                    end\n                end\n                DST_SETUP: begin\n                    dst_state <= DST_ACCESS;\n                end\n                DST_ACCESS: begin\n                    if (dst_pready_i) begin\n                        resp_data_reg <= dst_prdata_i;\n                        resp_err_reg <= dst_pslverr_i;\n                        resp_valid_reg <= 1'b1;\n                        fifo_valid[dst_rd_ptr[PTR_W-1:0]] <= 1'b0;\n                        dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                        dst_state <= DST_IDLE;\n                    end\n                end\n                default: dst_state <= DST_IDLE;\n            endcase\n        end\n    end\n\n    // Clear resp_valid when ack is received\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            resp_valid_reg <= 1'b0;\n        end else if (resp_ack_sync3) begin\n            resp_valid_reg <= 1'b0;\n        end\n    end\n\n    assign dst_psel_o = (dst_state == DST_SETUP) || (dst_state == DST_ACCESS);\n    assign dst_penable_o = (dst_state == DST_ACCESS);\n    assign dst_pwrite_o = dst_write_reg;\n    assign dst_paddr_o = dst_addr_reg;\n    assign dst_pwdata_o = dst_wdata_reg;\n    assign dst_pstrb_o = dst_strb_reg;\n    assign dst_pprot_o = dst_prot_reg;\n\nendmodule\n```<|im_end|>",
