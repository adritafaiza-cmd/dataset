  "text": "```verilog\nmodule apb_cdc #(\n    parameter ADDR_WIDTH = 8,\n    parameter DATA_WIDTH = 32,\n    parameter LOG_DEPTH = 1\n)(\n    input                      src_pclk_i,\n    input                      src_preset_ni,\n    input                      src_psel_i,\n    input                      src_penable_i,\n    input                      src_pwrite_i,\n    input  [ADDR_WIDTH-1:0]    src_paddr_i,\n    input  [DATA_WIDTH-1:0]    src_pwdata_i,\n    input  [DATA_WIDTH/8-1:0]  src_pstrb_i,\n    input  [2:0]               src_pprot_i,\n    output                     src_pready_o,\n    output [DATA_WIDTH-1:0]    src_prdata_o,\n    output                     src_pslverr_o,\n    input                      dst_pclk_i,\n    input                      dst_preset_ni,\n    output                     dst_psel_o,\n    output                     dst_penable_o,\n    output                     dst_pwrite_o,\n    output [ADDR_WIDTH-1:0]    dst_paddr_o,\n    output [DATA_WIDTH-1:0]    dst_pwdata_o,\n    output [DATA_WIDTH/8-1:0]  dst_pstrb_o,\n    output [2:0]               dst_pprot_o,\n    input                      dst_pready_i,\n    input  [DATA_WIDTH-1:0]    dst_prdata_i,\n    input                      dst_pslverr_i\n);\n\n    localparam STRB_WIDTH = DATA_WIDTH/8;\n    localparam FIFO_DEPTH = 1 << LOG_DEPTH;\n    localparam FIFO_ADDR_WIDTH = LOG_DEPTH;\n\n    // Source domain state\n    reg src_idle = 1'b1;\n    reg src_setup = 1'b0;\n    reg src_access = 1'b0;\n    reg src_wait_dst = 1'b0;\n\n    // Source domain registers for request\n    reg [ADDR_WIDTH-1:0] src_addr_reg;\n    reg [DATA_WIDTH-1:0] src_wdata_reg;\n    reg [STRB_WIDTH-1:0] src_strb_reg;\n    reg [2:0] src_pprot_reg;\n    reg src_write_reg;\n\n    // Source domain response registers\n    reg [DATA_WIDTH-1:0] src_rdata_reg;\n    reg src_slverr_reg;\n\n    // FIFO control signals (source domain)\n    reg src_fifo_wr_en;\n    reg [FIFO_ADDR_WIDTH-1:0] src_fifo_wr_ptr;\n    reg [FIFO_ADDR_WIDTH-1:0] src_fifo_rd_ptr;\n    wire src_fifo_full;\n    wire src_fifo_empty;\n\n    // FIFO data bus (source domain write, destination domain read)\n    // We use a simple FIFO with one entry per beat\n    // For LOG_DEPTH=1, we have 1 entry. For larger, we have more.\n    // The FIFO stores: addr, wdata, strb, pprot, write\n    // We'll use a simple synchronous FIFO structure.\n\n    // Actually, let's use a simpler approach: a single-entry buffer with handshake\n    // Since we only have one outstanding transaction, we can use a simple valid/ready handshake\n    // with a 2-phase handshake for the request and a 2-phase handshake for the response.\n\n    // Let's use a 2-phase handshake (valid/ack) for both directions.\n    // Request: src -> dst\n    // Response: dst -> src\n\n    // Request handshake\n    reg src_req_valid = 1'b0;\n    reg [ADDR_WIDTH-1:0] src_req_addr;\n    reg [DATA_WIDTH-1:0] src_req_wdata;\n    reg [STRB_WIDTH-1:0] src_req_strb;\n    reg [2:0] src_req_pprot;\n    reg src_req_write;\n\n    // Request ack from dst domain\n    reg dst_req_ack = 1'b0;\n    reg dst_req_ack_sync1 = 1'b0;\n    reg dst_req_ack_sync2 = 1'b0;\n\n    // Response handshake\n    reg dst_resp_valid = 1'b0;\n    reg [DATA_WIDTH-1:0] dst_resp_rdata;\n    reg dst_resp_slverr;\n\n    // Response ack from src domain\n    reg src_resp_ack = 1'b0;\n    reg src_resp_ack_sync1 = 1'b0;\n    reg src_resp_ack_sync2 = 1'b0;\n\n    // Destination domain state\n    reg dst_idle = 1'b1;\n    reg dst_setup = 1'b0;\n    reg dst_access = 1'b0;\n    reg dst_wait_src = 1'b0;\n\n    // Destination domain registers for request\n    reg [ADDR_WIDTH-1:0] dst_addr_reg;\n    reg [DATA_WIDTH-1:0] dst_wdata_reg;\n    reg [STRB_WIDTH-1:0] dst_strb_reg;\n    reg [2:0] dst_pprot_reg;\n    reg dst_write_reg;\n\n    // Destination domain response registers\n    reg [DATA_WIDTH-1:0] dst_rdata_reg;\n    reg dst_slverr_reg;\n\n    // Source domain outputs\n    assign src_pready_o = src_idle | (src_wait_dst & dst_req_ack_sync2);\n    assign src_prdata_o = src_rdata_reg;\n    assign src_pslverr_o = src_slverr_reg;\n\n    // Destination domain outputs\n    assign dst_psel_o = dst_setup | dst_access;\n    assign dst_penable_o = dst_access;\n    assign dst_pwrite_o = dst_write_reg;\n    assign dst_paddr_o = dst_addr_reg;\n    assign dst_pwdata_o = dst_wdata_reg;\n    assign dst_pstrb_o = dst_strb_reg;\n    assign dst_pprot_o = dst_pprot_reg;\n\n    // Source domain logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_idle <= 1'b1;\n            src_setup <= 1'b0;\n            src_access <= 1'b0;\n            src_wait_dst <= 1'b0;\n            src_addr_reg <= {ADDR_WIDTH{1'b0}};\n            src_wdata_reg <= {DATA_WIDTH{1'b0}};\n            src_strb_reg <= {STRB_WIDTH{1'b0}};\n            src_pprot_reg <= 3'b000;\n            src_write_reg <= 1'b0;\n            src_rdata_reg <= {DATA_WIDTH{1'b0}};\n            src_slverr_reg <= 1'b0;\n            src_req_valid <= 1'b0;\n            src_req_addr <= {ADDR_WIDTH{1'b0}};\n            src_req_wdata <= {DATA_WIDTH{1'b0}};\n            src_req_strb <= {STRB_WIDTH{1'b0}};\n            src_req_pprot <= 3'b000;\n            src_req_write <= 1'b0;\n            src_resp_ack <= 1'b0;\n            src_resp_ack_sync1 <= 1'b0;\n            src_resp_ack_sync2 <= 1'b0;\n        end else begin\n            // Sync dst_req_ack\n            dst_req_ack_sync1 <= dst_req_ack;\n            dst_req_ack_sync2 <= dst_req_ack_sync1;\n\n            // Sync src_resp_ack to dst domain (this is done in dst domain)\n            // src_resp_ack is generated here, synced in dst domain\n\n            if (src_idle) begin\n                if (src_psel_i) begin\n                    src_idle <= 1'b0;\n                    src_setup <= 1'b1;\n                    src_access <= 1'b0;\n                    src_wait_dst <= 1'b0;\n                    src_addr_reg <= src_paddr_i;\n                    src_wdata_reg <= src_pwdata_i;\n                    src_strb_reg <= src_pstrb_i;\n                    src_pprot_reg <= src_pprot_i;\n                    src_write_reg <= src_pwrite_i;\n                    src_rdata_reg <= {DATA_WIDTH{1'b0}};\n                    src_slverr_reg <= 1'b0;\n                    src_req_valid <= 1'b0;\n                    src_resp_ack <= 1'b0;\n                end\n            end else if (src_setup) begin\n                if (src_penable_i) begin\n                    src_setup <= 1'b0;\n                    src_access <= 1'b1;\n                    src_wait_dst <= 1'b1;\n                    // Send request to dst domain\n                    src_req_valid <= 1'b1;\n                    src_req_addr <= src_addr_reg;\n                    src_req_wdata <= src_wdata_reg;\n                    src_req_strb <= src_strb_reg;\n                    src_req_pprot <= src_pprot_reg;\n                    src_req_write <= src_write_reg;\n                end\n            end else if (src_access) begin\n                if (dst_req_ack_sync2) begin\n                    src_access <= 1'b0;\n                    src_wait_dst <= 1'b0;\n                    src_idle <= 1'b1;\n                    src_req_valid <= 1'b0;\n                    // Response should be available\n                    src_rdata_reg <= dst_resp_rdata_sync2;\n                    src_slverr_reg <= dst_resp_slverr_sync2;\n                    src_resp_ack <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Response data from dst domain, synced to src domain\n    reg [DATA_WIDTH-1:0] dst_resp_rdata_sync1;\n    reg [DATA_WIDTH-1:0] dst_resp_rdata_sync2;\n    reg dst_resp_slverr_sync1;\n    reg dst_resp_slverr_sync2;\n    reg dst_resp_valid_sync1;\n    reg dst_resp_valid_sync2;\n\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            dst_resp_rdata_sync1 <= {DATA_WIDTH{1'b0}};\n            dst_resp_rdata_sync2 <= {DATA_WIDTH{1'b0}};\n            dst_resp_slverr_sync1 <= 1'b0;\n            dst_resp_slverr_sync2 <= 1'b0;\n            dst_resp_valid_sync1 <= 1'b0;\n            dst_resp_valid_sync2 <= 1'b0;\n        end else begin\n            dst_resp_rdata_sync1 <= dst_resp_rdata;\n            dst_resp_rdata_sync2 <= dst_resp_rdata_sync1;\n            dst_resp_slverr_sync1 <= dst_resp_slverr;\n            dst_resp_slverr_sync2 <= dst_resp_slverr_sync1;\n            dst_resp_valid_sync1 <= dst_resp_valid;\n            dst_resp_valid_sync2 <= dst_resp_valid_sync1;\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_idle <= 1'b1;\n            dst_setup <= 1'b0;\n            dst_access <= 1'b0;\n            dst_wait_src <= 1'b0;\n            dst_addr_reg <= {ADDR_WIDTH{1'b0}};\n            dst_wdata_reg <= {DATA_WIDTH{1'b0}};\n            dst_strb_reg <= {STRB_WIDTH{1'b0}};\n            dst_pprot_reg <= 3'b000;\n            dst_write_reg <= 1'b0;\n            dst_rdata_reg <= {DATA_WIDTH{1'b0}};\n            dst_slverr_reg <= 1'b0;\n            dst_req_ack <= 1'b0;\n            dst_resp_valid <= 1'b0;\n            dst_resp_rdata <= {DATA_WIDTH{1'b0}};\n            dst_resp_slverr <= 1'b0;\n            src_resp_ack_sync1 <= 1'b0;\n            src_resp_ack_sync2 <= 1'b0;\n        end else begin\n            // Sync src_resp_ack\n            src_resp_ack_sync1 <= src_resp_ack;\n            src_resp_ack_sync2 <= src_resp_ack_sync1;\n\n            // Sync src_req_valid and data\n            // We need to sync the request data when src_req_valid is high\n\n            if (dst_idle) begin\n                if (src_req_valid_sync2) begin\n                    dst_idle <= 1'b0;\n                    dst_setup <= 1'b1;\n                    dst_access <= 1'b0;\n                    dst_wait_src <= 1'b0;\n                    dst_addr_reg <= src_req_addr_sync2;\n                    dst_wdata_reg <= src_req_wdata_sync2;\n                    dst_strb_reg <= src_req_strb_sync2;\n                    dst_pprot_reg <= src_req_pprot_sync2;\n                    dst_write_reg <= src_req_write_sync2;\n                    dst_req_ack <= 1'b1;\n                    dst_resp_valid <= 1'b0;\n                end\n            end else if (dst_setup) begin\n                dst_setup <= 1'b0;\n                dst_access <= 1'b1;\n            end else if (dst_access) begin\n                if (dst_pready_i) begin\n                    dst_access <= 1'b0;\n                    dst_idle <= 1'b1;\n                    dst_req_ack <= 1'b0;\n                    // Capture response\n                    dst_rdata_reg <= dst_prdata_i;\n                    dst_slverr_reg <= dst_pslverr_i;\n                    dst_resp_valid <= 1'b1;\n                    dst_resp_rdata <= dst_prdata_i;\n                    dst_resp_slverr <= dst_pslverr_i;\n                end\n            end\n\n            // Clear response valid when src acks\n            if (dst_resp_valid && src_resp_ack_sync2) begin\n                dst_resp_valid <= 1'b0;\n            end\n        end\n    end\n\n    // Sync src_req_valid and data to dst domain\n    reg src_req_valid_sync1;\n    reg src_req_valid_sync2;\n    reg [ADDR_WIDTH-1:0] src_req_addr_sync1;\n    reg [ADDR_WIDTH-1:0] src_req_addr_sync2;\n    reg [DATA_WIDTH-1:0] src_req_wdata_sync1;\n    reg [DATA_WIDTH-1:0] src_req_wdata_sync2;\n    reg [STRB_WIDTH-1:0] src_req_strb_sync1;\n    reg [STRB_WIDTH-1:0] src_req_strb_sync2;\n    reg [2:0] src_req_pprot_sync1;\n    reg [2:0] src_req_pprot_sync2;\n    reg src_req_write_sync1;\n    reg src_req_write_sync2;\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            src_req_valid_sync1 <= 1'b0;\n            src_req_valid_sync2 <= 1'b0;\n            src_req_addr_sync1 <= {ADDR_WIDTH{1'b0}};\n            src_req_addr_sync2 <= {ADDR_WIDTH{1'b0}};\n            src_req_wdata_sync1 <= {DATA_WIDTH{1'b0}};\n            src_req_wdata_sync2 <= {DATA_WIDTH{1'b0}};\n            src_req_strb_sync1 <= {STRB_WIDTH{1'b0}};\n            src_req_strb_sync2 <= {STRB_WIDTH{1'b0}};\n            src_req_pprot_sync1 <= 3'b000;\n            src_req_pprot_sync2 <= 3'b000;\n            src_req_write_sync1 <= 1'b0;\n            src_req_write_sync2 <= 1'b0;\n        end else begin\n            src_req_valid_sync1 <= src_req_valid;\n            src_req_valid_sync2 <= src_req_valid_sync1;\n            src_req_addr_sync1 <= src_req_addr;\n            src_req_addr_sync2 <= src_req_addr_sync1;\n            src_req_wdata_sync1 <= src_req_wdata;\n            src_req_wdata_sync2 <= src_req_wdata_sync1;\n            src_req_strb_sync1 <= src_req_strb;\n            src_req_strb_sync2 <= src_req_strb_sync1;\n            src_req_pprot_sync1 <= src_req_pprot;\n            src_req_pprot_sync2 <= src_req_pprot_sync1;\n            src_req_write_sync1 <= src_req_write;\n            src_req_write_sync2 <= src_req_write_sync1;\n        end\n    end\n\nendmodule\n```<|im_end|>",
