  "text": "```verilog\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam S_BYTES = S_DATA_WIDTH / 8;\n    localparam M_BYTES = M_DATA_WIDTH / 8;\n    localparam S_KEEP_W = S_KEEP_ENABLE ? S_KEEP_WIDTH : 1;\n    localparam M_KEEP_W = M_KEEP_ENABLE ? M_KEEP_WIDTH : 1;\n    localparam ID_W = ID_ENABLE ? ID_WIDTH : 1;\n    localparam DEST_W = DEST_ENABLE ? DEST_WIDTH : 1;\n    localparam USER_W = USER_ENABLE ? USER_WIDTH : 1;\n\n    // Internal signals\n    wire [S_DATA_WIDTH-1:0] s_tdata;\n    wire [S_KEEP_W-1:0] s_tkeep;\n    wire s_tvalid;\n    wire s_tready;\n    wire s_tlast;\n    wire [ID_W-1:0] s_tid;\n    wire [DEST_W-1:0] s_tdest;\n    wire [USER_W-1:0] s_tuser;\n\n    assign s_tdata = s_axis_tdata;\n    assign s_tkeep = S_KEEP_ENABLE ? s_axis_tkeep : {S_KEEP_W{1'b1}};\n    assign s_tvalid = s_axis_tvalid;\n    assign s_tlast = s_axis_tlast;\n    assign s_tid = ID_ENABLE ? s_axis_tid : {ID_W{1'b0}};\n    assign s_tdest = DEST_ENABLE ? s_axis_tdest : {DEST_W{1'b0}};\n    assign s_tuser = USER_ENABLE ? s_axis_tuser : {USER_W{1'b0}};\n\n    // Write side (s_clk domain)\n    reg [PTR_WIDTH-1:0] w_ptr;\n    reg [ADDR_WIDTH-1:0] w_addr;\n    reg [S_DATA_WIDTH-1:0] w_data;\n    reg [S_KEEP_W-1:0] w_keep;\n    reg w_last;\n    reg [ID_W-1:0] w_id;\n    reg [DEST_W-1:0] w_dest;\n    reg [USER_W-1:0] w_user;\n    reg w_valid;\n    reg w_overflow;\n    reg w_bad_frame;\n    reg w_good_frame;\n\n    // Read side (m_clk domain)\n    reg [PTR_WIDTH-1:0] r_ptr;\n    reg [ADDR_WIDTH-1:0] r_addr;\n    reg [S_DATA_WIDTH-1:0] r_data;\n    reg [S_KEEP_W-1:0] r_keep;\n    reg r_last;\n    reg [ID_W-1:0] r_id;\n    reg [DEST_W-1:0] r_dest;\n    reg [USER_W-1:0] r_user;\n    reg r_valid;\n    reg r_overflow;\n    reg r_bad_frame;\n    reg r_good_frame;\n\n    // Synchronizers\n    reg [PTR_WIDTH-1:0] w_ptr_sync1, w_ptr_sync2, w_ptr_sync3;\n    reg [PTR_WIDTH-1:0] r_ptr_sync1, r_ptr_sync2, r_ptr_sync3;\n\n    // Write pointer synchronization to m_clk\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            w_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            w_ptr_sync1 <= w_ptr;\n            w_ptr_sync2 <= w_ptr_sync1;\n            w_ptr_sync3 <= w_ptr_sync2;\n        end\n    end\n\n    // Read pointer synchronization to s_clk\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            r_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            r_ptr_sync1 <= r_ptr;\n            r_ptr_sync2 <= r_ptr_sync1;\n            r_ptr_sync3 <= r_ptr_sync2;\n        end\n    end\n\n    // Depth calculation\n    wire [PTR_WIDTH-1:0] w_ptr_m = w_ptr_sync3;\n    wire [PTR_WIDTH-1:0] r_ptr_s = r_ptr_sync3;\n    wire [PTR_WIDTH-1:0] depth_s = w_ptr - r_ptr_s;\n    wire [PTR_WIDTH-1:0] depth_m = w_ptr_m - r_ptr;\n\n    // Full/Empty detection\n    wire s_full = (depth_s == DEPTH);\n    wire m_empty = (depth_m == 0);\n\n    // Pause logic\n    wire s_pause = PAUSE_ENABLE ? s_pause_req : 1'b0;\n    wire m_pause = PAUSE_ENABLE ? m_pause_req : 1'b0;\n\n    // Write ready\n    wire s_write_en = s_tvalid && s_tready && !s_pause;\n    assign s_tready = !s_full && !s_pause;\n    assign s_axis_tready = s_tready;\n\n    // Read ready\n    wire m_read_en = m_axis_tready && m_axis_tvalid && !m_pause;\n    assign m_axis_tvalid = r_valid;\n\n    // Write logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_ptr <= {PTR_WIDTH{1'b0}};\n            w_addr <= {ADDR_WIDTH{1'b0}};\n            w_data <= {S_DATA_WIDTH{1'b0}};\n            w_keep <= {S_KEEP_W{1'b0}};\n            w_last <= 1'b0;\n            w_id <= {ID_W{1'b0}};\n            w_dest <= {DEST_W{1'b0}};\n            w_user <= {USER_W{1'b0}};\n            w_valid <= 1'b0;\n            w_overflow <= 1'b0;\n            w_bad_frame <= 1'b0;\n            w_good_frame <= 1'b0;\n        end else begin\n            if (s_write_en) begin\n                w_data <= s_tdata;\n                w_keep <= s_tkeep;\n                w_last <= s_tlast;\n                w_id <= s_tid;\n                w_dest <= s_tdest;\n                w_user <= s_tuser;\n                w_valid <= 1'b1;\n                w_addr <= w_addr + 1'b1;\n                w_ptr <= w_ptr + 1'b1;\n                \n                if (s_tlast) begin\n                    w_good_frame <= 1'b1;\n                    w_bad_frame <= 1'b0;\n                end\n                \n                if (s_full && !DROP_WHEN_FULL) begin\n                    w_overflow <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Read logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr <= {PTR_WIDTH{1'b0}};\n            r_addr <= {ADDR_WIDTH{1'b0}};\n            r_data <= {S_DATA_WIDTH{1'b0}};\n            r_keep <= {S_KEEP_W{1'b0}};\n            r_last <= 1'b0;\n            r_id <= {ID_W{1'b0}};\n            r_dest <= {DEST_W{1'b0}};\n            r_user <= {USER_W{1'b0}};\n            r_valid <= 1'b0;\n            r_overflow <= 1'b0;\n            r_bad_frame <= 1'b0;\n            r_good_frame <= 1'b0;\n        end else begin\n            if (m_read_en) begin\n                r_addr <= r_addr + 1'b1;\n                r_ptr <= r_ptr + 1'b1;\n                r_valid <= 1'b0;\n                \n                if (r_last) begin\n                    r_good_frame <= 1'b1;\n                    r_bad_frame <= 1'b0;\n                end\n            end else if (!m_empty && !r_valid) begin\n                r_valid <= 1'b1;\n            end\n        end\n    end\n\n    // RAM storage\n    reg [S_DATA_WIDTH-1:0] ram_data [0:DEPTH-1];\n    reg [S_KEEP_W-1:0] ram_keep [0:DEPTH-1];\n    reg ram_last [0:DEPTH-1];\n    reg [ID_W-1:0] ram_id [0:DEPTH-1];\n    reg [DEST_W-1:0] ram_dest [0:DEPTH-1];\n    reg [USER_W-1:0] ram_user [0:DEPTH-1];\n\n    // Write to RAM\n    always @(posedge s_clk) begin\n        if (s_write_en) begin\n            ram_data[w_addr] <= s_tdata;\n            ram_keep[w_addr] <= s_tkeep;\n            ram_last[w_addr] <= s_tlast;\n            ram_id[w_addr] <= s_tid;\n            ram_dest[w_addr] <= s_tdest;\n            ram_user[w_addr] <= s_tuser;\n        end\n    end\n\n    // Read from RAM\n    wire [ADDR_WIDTH-1:0] r_addr_ram = r_addr;\n    wire [S_DATA_WIDTH-1:0] ram_rdata = ram_data[r_addr_ram];\n    wire [S_KEEP_W-1:0] ram_rkeep = ram_keep[r_addr_ram];\n    wire ram_rlast = ram_last[r_addr_ram];\n    wire [ID_W-1:0] ram_rid = ram_id[r_addr_ram];\n    wire [DEST_W-1:0] ram_rdest = ram_dest[r_addr_ram];\n    wire [USER_W-1:0] ram_ruser = ram_user[r_addr_ram];\n\n    // Update read registers\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_data <= {S_DATA_WIDTH{1'b0}};\n            r_keep <= {S_KEEP_W{1'b0}};\n            r_last <= 1'b0;\n            r_id <= {ID_W{1'b0}};\n            r_dest <= {DEST_W{1'b0}};\n            r_user <= {USER_W{1'b0}};\n        end else if (!m_empty && !r_valid) begin\n            r_data <= ram_rdata;\n            r_keep <= ram_rkeep;\n            r_last <= ram_rlast;\n            r_id <= ram_rid;\n            r_dest <= ram_rdest;\n            r_user <= ram_ruser;\n        end\n    end\n\n    // Width adapter: S_DATA_WIDTH to M_DATA_WIDTH\n    // For simplicity, assume S_DATA_WIDTH == M_DATA_WIDTH or direct mapping\n    // In a real implementation, this would handle byte alignment and keep signals\n    wire [M_DATA_WIDTH-1:0] m_tdata;\n    wire [M_KEEP_W-1:0] m_tkeep;\n    wire m_tlast;\n    wire [ID_W-1:0] m_tid;\n    wire [DEST_W-1:0] m_tdest;\n    wire [USER_W-1:0] m_tuser;\n\n    // Direct mapping for same width\n    assign m_tdata = (M_DATA_WIDTH == S_DATA_WIDTH) ? r_data[M_DATA_WIDTH-1:0] : {M_DATA_WIDTH{1'b0}};\n    assign m_tkeep = M_KEEP_ENABLE ? (M_KEEP_W == S_KEEP_W ? r_keep : {M_KEEP_W{1'b1}}) : {M_KEEP_W{1'b1}};\n    assign m_tlast = r_last;\n    assign m_tid = r_id;\n    assign m_tdest = r_dest;\n    assign m_tuser = r_user;\n\n    // Output assignments\n    assign m_axis_tdata = m_tdata;\n    assign m_axis_tkeep = m_tkeep;\n    assign m_axis_tlast = m_tlast;\n    assign m_axis_tid = ID_ENABLE ? m_tid : {ID_WIDTH{1'b0}};\n    assign m_axis_tdest = DEST_ENABLE ? m_tdest : {DEST_WIDTH{1'b0}};\n    assign m_axis_tuser = USER_ENABLE ? m_tuser : {USER_WIDTH{1'b0}};\n\n    // Pause acknowledgments\n    assign s_pause_ack = PAUSE_ENABLE ? s_pause_req : 1'b0;\n    assign m_pause_ack = PAUSE_ENABLE ? m_pause_req : 1'b0;\n\n    // Status outputs\n    assign s_status_depth = depth_s;\n    assign s_status_depth_commit = depth_s;\n    assign s_status_overflow = w_overflow;\n    assign s_status_bad_frame = w_bad_frame;\n    assign s_status_good_frame = w_good_frame;\n\n    assign m_status_depth = depth_m;\n    assign m_status_depth_commit = depth_m;\n    assign m_status_overflow = r_overflow;\n    assign m_status_bad_frame = r_bad_frame;\n    assign m_status_good_frame = r_good_frame;\n\nendmodule\n```<|im_end|>",
