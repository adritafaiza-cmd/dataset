  "text": "```verilog\nmodule isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    // Source side state\n    reg src_valid_r;\n    reg src_ready_r;\n\n    // Destination side state\n    reg dst_valid_r;\n    reg dst_ready_r;\n\n    // Synchronizers for signals crossing from source to destination\n    reg [1:0] src_valid_sync;\n    reg [1:0] src_ready_sync;\n\n    // Synchronizers for signals crossing from destination to source\n    reg [1:0] dst_valid_sync;\n    reg [1:0] dst_ready_sync;\n\n    // Synchronize src_valid_i to dst_clk domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_valid_sync <= 2'b00;\n        else\n            src_valid_sync <= {src_valid_sync[0], src_valid_i};\n    end\n\n    // Synchronize src_ready_r to dst_clk domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_ready_sync <= 2'b00;\n        else\n            src_ready_sync <= {src_ready_sync[0], src_ready_r};\n    end\n\n    // Synchronize dst_valid_r to src_clk domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_valid_sync <= 2'b00;\n        else\n            dst_valid_sync <= {dst_valid_sync[0], dst_valid_r};\n    end\n\n    // Synchronize dst_ready_i to src_clk domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_ready_sync <= 2'b00;\n        else\n            dst_ready_sync <= {dst_ready_sync[0], dst_ready_i};\n    end\n\n    // Source side logic\n    // src_ready_o is high when source is ready to accept a new transfer\n    // In four-phase handshake, ready goes high when valid goes low (after completion)\n    // Initially after reset, ready should be high (idle state)\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_valid_r <= 1'b0;\n            src_ready_r <= 1'b1;\n        end else begin\n            // If valid is asserted and ready is asserted, transfer occurs\n            // After transfer, valid deasserts and ready deasserts\n            // When valid deasserts, ready asserts again\n            if (src_valid_r && src_ready_r) begin\n                // Transfer in progress, deassert both\n                src_valid_r <= 1'b0;\n                src_ready_r <= 1'b0;\n            end else if (!src_valid_r && !src_ready_r) begin\n                // Both deasserted, ready to accept new transfer\n                src_ready_r <= 1'b1;\n            end\n        end\n    end\n\n    assign src_ready_o = src_ready_r;\n\n    // Destination side logic\n    // dst_valid_o is high when destination has a valid transfer to report\n    // Initially after reset, valid should be low (idle state)\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_r <= 1'b0;\n            dst_ready_r <= 1'b0;\n        end else begin\n            // If valid is asserted and ready is asserted, transfer completes\n            // After transfer, valid deasserts and ready deasserts\n            // When valid deasserts, ready asserts again\n            if (dst_valid_r && dst_ready_i) begin\n                // Transfer complete, deassert both\n                dst_valid_r <= 1'b0;\n                dst_ready_r <= 1'b0;\n            end else if (!dst_valid_r && !dst_ready_r) begin\n                // Both deasserted, ready to accept new transfer\n                dst_ready_r <= 1'b1;\n            end\n        end\n    end\n\n    assign dst_valid_o = dst_valid_r;\n\n    // Cross-domain coordination\n    // Source asserts valid when it has data and is ready\n    // Destination asserts valid when it sees source valid and is ready\n    // We need to coordinate so that a transfer only occurs when both sides agree\n\n    // Source: assert valid when ready and not currently in a transfer\n    // The source valid should be driven based on the input src_valid_i\n    // But we need to ensure proper four-phase behavior\n\n    // Let me reconsider the design. In a four-phase handshake:\n    // Phase 1: valid=0, ready=0 (idle)\n    // Phase 2: valid=1, ready=0 (request)\n    // Phase 3: valid=1, ready=1 (acknowledge)\n    // Phase 4: valid=0, ready=1 (deassert)\n    // Then back to Phase 1\n\n    // Actually, let me use a simpler approach with explicit state machines\n\n    // Source state machine\n    localparam SRC_IDLE = 2'b00;\n    localparam SRC_WAIT = 2'b01;\n    localparam SRC_ACK  = 2'b10;\n    localparam SRC_DEAS = 2'b11;\n\n    reg [1:0] src_state;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_state <= SRC_IDLE;\n        else begin\n            case (src_state)\n                SRC_IDLE: begin\n                    if (src_valid_i)\n                        src_state <= SRC_WAIT;\n                end\n                SRC_WAIT: begin\n                    if (dst_ready_sync[1])\n                        src_state <= SRC_ACK;\n                end\n                SRC_ACK: begin\n                    src_state <= SRC_DEAS;\n                end\n                SRC_DEAS: begin\n                    src_state <= SRC_IDLE;\n                end\n                default: src_state <= SRC_IDLE;\n            endcase\n        end\n    end\n\n    assign src_ready_o = (src_state == SRC_IDLE) || (src_state == SRC_DEAS);\n\n    // Destination state machine\n    localparam DST_IDLE = 2'b00;\n    localparam DST_WAIT = 2'b01;\n    localparam DST_ACK  = 2'b10;\n    localparam DST_DEAS = 2'b11;\n\n    reg [1:0] dst_state;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_state <= DST_IDLE;\n        else begin\n            case (dst_state)\n                DST_IDLE: begin\n                    if (src_valid_sync[1])\n                        dst_state <= DST_WAIT;\n                end\n                DST_WAIT: begin\n                    if (dst_ready_i)\n                        dst_state <= DST_ACK;\n                end\n                DST_ACK: begin\n                    dst_state <= DST_DEAS;\n                end\n                DST_DEAS: begin\n                    dst_state <= DST_IDLE;\n                end\n                default: dst_state <= DST_IDLE;\n            endcase\n        end\n    end\n\n    assign dst_valid_o = (dst_state == DST_WAIT) || (dst_state == DST_ACK);\n\nendmodule\n```<|im_end|>",
