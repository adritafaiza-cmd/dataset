  "text": "```verilog\nmodule isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    // Synchronize src_valid_i into dst domain\n    reg [2:0] src_valid_sync;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_valid_sync <= 3'b000;\n        else\n            src_valid_sync <= {src_valid_sync[1:0], src_valid_i};\n    end\n    wire src_valid_dst = src_valid_sync[2];\n\n    // Synchronize dst_ready_i into src domain\n    reg [2:0] dst_ready_sync;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_ready_sync <= 3'b000;\n        else\n            dst_ready_sync <= {dst_ready_sync[1:0], dst_ready_i};\n    end\n    wire dst_ready_src = dst_ready_sync[2];\n\n    // Synchronize dst_valid_o into src domain\n    reg [2:0] dst_valid_sync;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_valid_sync <= 3'b000;\n        else\n            dst_valid_sync <= {dst_valid_sync[1:0], dst_valid_o};\n    end\n    wire dst_valid_src = dst_valid_sync[2];\n\n    // Synchronize src_ready_o into dst domain\n    reg [2:0] src_ready_sync;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_ready_sync <= 3'b000;\n        else\n            src_ready_sync <= {src_ready_sync[1:0], src_ready_o};\n    end\n    wire src_ready_dst = src_ready_sync[2];\n\n    // Four-phase handshake state machine in dst domain\n    // States: IDLE, WAIT_SRC_VALID, WAIT_SRC_READY, WAIT_DST_READY\n    localparam S_IDLE          = 2'd0;\n    localparam S_WAIT_SRC_VALID = 2'd1;\n    localparam S_WAIT_SRC_READY = 2'd2;\n    localparam S_WAIT_DST_READY = 2'd3;\n\n    reg [1:0] dst_state;\n    reg       dst_valid_reg;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_state     <= S_IDLE;\n            dst_valid_reg <= 1'b0;\n        end else begin\n            case (dst_state)\n                S_IDLE: begin\n                    if (src_valid_dst) begin\n                        dst_state     <= S_WAIT_SRC_VALID;\n                        dst_valid_reg <= 1'b1;\n                    end\n                end\n                S_WAIT_SRC_VALID: begin\n                    if (src_ready_dst) begin\n                        dst_state     <= S_WAIT_SRC_READY;\n                        dst_valid_reg <= 1'b0;\n                    end\n                end\n                S_WAIT_SRC_READY: begin\n                    if (dst_ready_i) begin\n                        dst_state     <= S_WAIT_DST_READY;\n                    end\n                end\n                S_WAIT_DST_READY: begin\n                    if (!dst_ready_i) begin\n                        dst_state     <= S_IDLE;\n                    end\n                end\n                default: begin\n                    dst_state     <= S_IDLE;\n                    dst_valid_reg <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    assign dst_valid_o = dst_valid_reg;\n\n    // Four-phase handshake state machine in src domain\n    // States: IDLE, WAIT_DST_READY, WAIT_DST_VALID, WAIT_SRC_VALID\n    localparam SRC_IDLE          = 2'd0;\n    localparam SRC_WAIT_DST_READY = 2'd1;\n    localparam SRC_WAIT_DST_VALID = 2'd2;\n    localparam SRC_WAIT_SRC_VALID = 2'd3;\n\n    reg [1:0] src_state;\n    reg       src_ready_reg;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_state     <= SRC_IDLE;\n            src_ready_reg <= 1'b0;\n        end else begin\n            case (src_state)\n                SRC_IDLE: begin\n                    if (dst_ready_src) begin\n                        src_state     <= SRC_WAIT_DST_READY;\n                        src_ready_reg <= 1'b1;\n                    end\n                end\n                SRC_WAIT_DST_READY: begin\n                    if (dst_valid_src) begin\n                        src_state     <= SRC_WAIT_DST_VALID;\n                        src_ready_reg <= 1'b0;\n                    end\n                end\n                SRC_WAIT_DST_VALID: begin\n                    if (src_valid_i) begin\n                        src_state     <= SRC_WAIT_SRC_VALID;\n                    end\n                end\n                SRC_WAIT_SRC_VALID: begin\n                    if (!src_valid_i) begin\n                        src_state     <= SRC_IDLE;\n                    end\n                end\n                default: begin\n                    src_state     <= SRC_IDLE;\n                    src_ready_reg <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    assign src_ready_o = src_ready_reg;\n\nendmodule\n```<|im_end|>",
