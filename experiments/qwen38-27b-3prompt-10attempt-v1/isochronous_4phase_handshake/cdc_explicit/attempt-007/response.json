  "text": "```verilog\nmodule isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    // Source domain state\n    reg src_valid_reg;\n    reg src_ack_reg;\n\n    // Destination domain state\n    reg dst_valid_reg;\n    reg dst_ack_reg;\n\n    // Synchronizers for crossing signals\n    // src_valid crosses to dst domain\n    reg [1:0] src_valid_sync;\n    // src_ack crosses to dst domain\n    reg [1:0] src_ack_sync;\n    // dst_valid crosses to src domain\n    reg [1:0] dst_valid_sync;\n    // dst_ack crosses to src domain\n    reg [1:0] dst_ack_sync;\n\n    // Synchronize src_valid into dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_valid_sync <= 2'b00;\n        else\n            src_valid_sync <= {src_valid_sync[0], src_valid_reg};\n    end\n\n    // Synchronize src_ack into dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_ack_sync <= 2'b00;\n        else\n            src_ack_sync <= {src_ack_sync[0], src_ack_reg};\n    end\n\n    // Synchronize dst_valid into src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_valid_sync <= 2'b00;\n        else\n            dst_valid_sync <= {dst_valid_sync[0], dst_valid_reg};\n    end\n\n    // Synchronize dst_ack into src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_ack_sync <= 2'b00;\n        else\n            dst_ack_sync <= {dst_ack_sync[0], dst_ack_reg};\n    end\n\n    // Source domain logic\n    // src_ready_o is high when source is not waiting for ack or when ack is received\n    // Four-phase handshake:\n    //   Idle: valid=0, ready=1\n    //   Request: valid=1, ready=1\n    //   Ack: valid=1, ready=0\n    //   Deassert: valid=0, ready=0\n    //   Back to Idle: valid=0, ready=1\n\n    // src_ready_o: ready to accept new valid\n    // In four-phase, ready goes low after valid is asserted and stays low until ack is received\n    // Then ready goes high, and valid goes low\n\n    assign src_ready_o = ~src_valid_reg | dst_ack_sync[1];\n\n    // Source valid register: assert when src_valid_i is high and ready, deassert when ack received\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_valid_reg <= 1'b0;\n        else begin\n            if (src_valid_i && src_ready_o)\n                src_valid_reg <= 1'b1;\n            else if (dst_ack_sync[1])\n                src_valid_reg <= 1'b0;\n        end\n    end\n\n    // Source ack register: assert when dst_valid is seen, deassert when src_valid is deasserted\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_ack_reg <= 1'b0;\n        else begin\n            if (dst_valid_sync[1])\n                src_ack_reg <= 1'b1;\n            else if (!src_valid_reg)\n                src_ack_reg <= 1'b0;\n        end\n    end\n\n    // Destination domain logic\n    // dst_valid_o: valid signal to destination\n    // Four-phase handshake on destination side:\n    //   Idle: valid=0, ready=1\n    //   Request: valid=1, ready=1\n    //   Ack: valid=1, ready=0\n    //   Deassert: valid=0, ready=0\n    //   Back to Idle: valid=0, ready=1\n\n    assign dst_valid_o = dst_valid_reg;\n\n    // Destination valid register: assert when src_valid is seen, deassert when dst_ready is high and ack is sent\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_valid_reg <= 1'b0;\n        else begin\n            if (src_valid_sync[1])\n                dst_valid_reg <= 1'b1;\n            else if (dst_ready_i && dst_ack_reg)\n                dst_valid_reg <= 1'b0;\n        end\n    end\n\n    // Destination ack register: assert when dst_valid is high and dst_ready is high, deassert when src_valid is deasserted\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_ack_reg <= 1'b0;\n        else begin\n            if (dst_valid_reg && dst_ready_i)\n                dst_ack_reg <= 1'b1;\n            else if (!src_valid_sync[1])\n                dst_ack_reg <= 1'b0;\n        end\n    end\n\nendmodule\n```<|im_end|>",
