  "text": "```verilog\nmodule isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    // Source domain state\n    reg src_valid_r;\n    reg src_ack_r;\n\n    // Destination domain state\n    reg dst_valid_r;\n    reg dst_ack_r;\n\n    // Synchronizers for crossing from source to destination\n    reg [1:0] src_valid_sync;\n    reg [1:0] src_ack_sync;\n\n    // Synchronizers for crossing from destination to source\n    reg [1:0] dst_valid_sync;\n    reg [1:0] dst_ack_sync;\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_valid_r <= 1'b0;\n            src_ack_r   <= 1'b0;\n        end else begin\n            // Four-phase handshake in source domain\n            // src_valid_r is the local valid signal\n            // src_ack_r is the local ack signal (from dst_ack_r synchronized)\n            \n            // When not valid and not ack, we can assert valid if src_valid_i is high\n            // Actually, let's think about this more carefully.\n            \n            // In a 4-phase handshake:\n            // Phase 0: valid=0, ack=0 (idle)\n            // Phase 1: valid=1, ack=0 (request)\n            // Phase 2: valid=1, ack=1 (acknowledge)\n            // Phase 3: valid=0, ack=1 (deassert valid)\n            // Phase 4: valid=0, ack=0 (deassert ack, back to idle)\n            \n            // src_valid_r tracks the valid signal in source domain\n            // src_ack_r tracks the ack signal in source domain (synchronized from dst)\n            \n            // The source asserts valid when src_valid_i is high and we're in idle state\n            // The source deasserts valid when it sees ack=1 and valid=1\n            // The destination asserts ack when it sees valid=1\n            // The destination deasserts ack when it sees valid=0\n            \n            // Let's use a simpler approach:\n            // src_valid_r: the valid signal driven by source\n            // src_ack_r: the ack signal received from destination (synchronized)\n            \n            // State machine:\n            // If src_valid_r == 0 and src_ack_r == 0:\n            //   If src_valid_i == 1, set src_valid_r = 1\n            // If src_valid_r == 1 and src_ack_r == 0:\n            //   Wait for ack\n            // If src_valid_r == 1 and src_ack_r == 1:\n            //   Set src_valid_r = 0\n            // If src_valid_r == 0 and src_ack_r == 1:\n            //   Wait for ack to deassert (handled by destination)\n            \n            if (src_valid_r == 1'b0 && src_ack_r == 1'b0) begin\n                if (src_valid_i)\n                    src_valid_r <= 1'b1;\n                else\n                    src_valid_r <= 1'b0;\n            end else if (src_valid_r == 1'b1 && src_ack_r == 1'b0) begin\n                src_valid_r <= 1'b1;\n            end else if (src_valid_r == 1'b1 && src_ack_r == 1'b1) begin\n                src_valid_r <= 1'b0;\n            end else if (src_valid_r == 1'b0 && src_ack_r == 1'b1) begin\n                src_valid_r <= 1'b0;\n            end\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_r <= 1'b0;\n            dst_ack_r   <= 1'b0;\n        end else begin\n            // dst_valid_r: the valid signal received from source (synchronized)\n            // dst_ack_r: the ack signal driven by destination\n            \n            // State machine:\n            // If dst_valid_r == 0 and dst_ack_r == 0:\n            //   Wait for valid\n            // If dst_valid_r == 1 and dst_ack_r == 0:\n            //   If dst_ready_i == 1, set dst_ack_r = 1\n            // If dst_valid_r == 1 and dst_ack_r == 1:\n            //   Wait for valid to deassert\n            // If dst_valid_r == 0 and dst_ack_r == 1:\n            //   Set dst_ack_r = 0\n            \n            if (dst_valid_r == 1'b0 && dst_ack_r == 1'b0) begin\n                dst_ack_r <= 1'b0;\n            end else if (dst_valid_r == 1'b1 && dst_ack_r == 1'b0) begin\n                if (dst_ready_i)\n                    dst_ack_r <= 1'b1;\n                else\n                    dst_ack_r <= 1'b0;\n            end else if (dst_valid_r == 1'b1 && dst_ack_r == 1'b1) begin\n                dst_ack_r <= 1'b1;\n            end else if (dst_valid_r == 1'b0 && dst_ack_r == 1'b1) begin\n                dst_ack_r <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronizers: source valid to destination\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_valid_sync <= 2'b00;\n        else\n            src_valid_sync <= {src_valid_sync[0], src_valid_r};\n    end\n\n    // Synchronizers: source ack to destination (actually dst_ack to source)\n    // Wait, I need to synchronize dst_ack_r to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_ack_sync <= 2'b00;\n        else\n            dst_ack_sync <= {dst_ack_sync[0], dst_ack_r};\n    end\n\n    // Synchronizers: dst_valid to source (actually src_valid to dst)\n    // We already have src_valid_sync in dst domain\n    \n    // Synchronizers: dst_ack to source\n    // We already have dst_ack_sync in src domain\n    \n    // Synchronizers: src_valid to dst\n    // We already have src_valid_sync in dst domain\n    \n    // Synchronizers: dst_ack to src\n    // We already have dst_ack_sync in src domain\n    \n    // But wait, I also need to synchronize dst_valid_r to source? No, dst_valid_r is in dst domain.\n    // And src_ack_r is in src domain, synchronized from dst_ack_r.\n    \n    // Let me reconsider the architecture.\n    \n    // Actually, let me redo this with a cleaner approach.\n    \n    // The four-phase handshake involves two signals crossing domains:\n    // 1. valid: from source to destination\n    // 2. ack: from destination to source\n    \n    // Source domain:\n    // - Drives valid (src_valid_r)\n    // - Receives ack (synchronized from dst_ack_r)\n    \n    // Destination domain:\n    // - Receives valid (synchronized from src_valid_r)\n    // - Drives ack (dst_ack_r)\n    \n    // So I need:\n    // - src_valid_r (src domain) -> sync to dst domain -> dst_valid_sync\n    // - dst_ack_r (dst domain) -> sync to src domain -> src_ack_sync\n    \n    // Let me rewrite this properly.\n\nendmodule\n```\n\nWait, I made a mess. Let me redo this cleanly.\n\n```verilog\nmodule isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    // Source domain registers\n    reg src_valid_r;\n    reg src_ack_r;\n\n    // Destination domain registers\n    reg dst_valid_r;\n    reg dst_ack_r;\n\n    // Synchronizer: src_valid_r (src domain) to dst domain\n    reg [1:0] src_valid_sync;\n\n    // Synchronizer: dst_ack_r (dst domain) to src domain\n    reg [1:0] dst_ack_sync;\n\n    // Synchronizer: dst_valid_r (dst domain) to src domain - not needed for 4-phase\n    // Synchronizer: src_ack_r (src domain) to dst domain - not needed for 4-phase\n\n    // Source domain: drive valid, receive ack\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_valid_r <= 1'b0;\n            src_ack_r   <= 1'b0;\n        end else begin\n            // Four-phase handshake source side\n            // src_valid_r: valid signal driven by source\n            // src_ack_r: ack signal received from destination (synchronized)\n            \n            // Phase 0: valid=0, ack=0 -> idle\n            // Phase 1: valid=1, ack=0 -> request\n            // Phase 2: valid=1, ack=1 -> acknowledged\n            // Phase 3: valid=0, ack=1 -> deasserting valid\n            // Phase 4: valid=0, ack=0 -> back to idle\n            \n            if (src_valid_r == 1'b0 && src_ack_r == 1'b0) begin\n                // Idle state\n                if (src_valid_i)\n                    src_valid_r <= 1'b1;\n                else\n                    src_valid_r <= 1'b0;\n            end else if (src_valid_r == 1'b1 && src_ack_r == 1'b0) begin\n                // Request state, wait for ack\n                src_valid_r <= 1'b1;\n            end else if (src_valid_r == 1'b1 && src_ack_r == 1'b1) begin\n                // Acknowledged state, deassert valid\n                src_valid_r <= 1'b0;\n            end else if (src_valid_r == 1'b0 && src_ack_r == 1'b1) begin\n                // Deasserting valid, wait for ack to deassert\n                src_valid_r <= 1'b0;\n            end\n        end\n    end\n\n    // Destination domain: receive valid, drive ack\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_r <= 1'b0;\n            dst_ack_r   <= 1'b0;\n        end else begin\n            // Four-phase handshake destination side\n            // dst_valid_r: valid signal received from source (synchronized)\n            // dst_ack_r: ack signal driven by destination\n            \n            if (dst_valid_r == 1'b0 && dst_ack_r == 1'b0) begin\n                // Idle state\n                dst_ack_r <= 1'b0;\n            end else if (dst_valid_r == 1'b1 && dst_ack_r == 1'b0) begin\n                // Request received, assert ack if ready\n                if (dst_ready_i)\n                    dst_ack_r <= 1'b1;\n                else\n                    dst_ack_r <= 1'b0;\n            end else if (dst_valid_r == 1'b1 && dst_ack_r == 1'b1) begin\n                // Acknowledged, wait for valid to deassert\n                dst_ack_r <= 1'b1;\n            end else if (dst_valid_r == 1'b0 && dst_ack_r == 1'b1) begin\n                // Valid deasserted, deassert ack\n                dst_ack_r <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronize src_valid_r from src domain to dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_valid_sync <= 2'b00;\n        else\n            src_valid_sync <= {src_valid_sync[0], src_valid_r};\n    end\n\n    // Synchronize dst_ack_r from dst domain to src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_ack_sync <= 2'b00;\n        else\n            dst_ack_sync <= {dst_ack_sync[0], dst_ack_r};\n    end\n\n    // Assign synchronized values to domain registers\n    assign dst_valid_r = src_valid_sync[1];\n    assign src_ack_r   = dst_ack_sync[1];\n\n    // Output assignments\n    assign src_ready_o = ~src_valid_r | src_ack_r;\n    assign dst_valid_o = dst_valid_r;\n\nendmodule\n```<|im_end|>",
