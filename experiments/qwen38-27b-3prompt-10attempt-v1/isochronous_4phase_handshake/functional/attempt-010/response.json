{
  "text": "```verilog\nmodule isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    // Source domain state\n    reg src_valid_r;\n    reg src_ready_r;\n\n    // Destination domain state\n    reg dst_valid_r;\n    reg dst_ready_r;\n\n    // Synchronizers for src_valid to dst domain\n    reg [1:0] src_valid_sync;\n\n    // Synchronizers for dst_ready to src domain\n    reg [1:0] dst_ready_sync;\n\n    // Synchronizers for src_ready to dst domain\n    reg [1:0] src_ready_sync;\n\n    // Synchronizers for dst_valid to src domain\n    reg [1:0] dst_valid_sync;\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_valid_r <= 1'b0;\n            src_ready_r <= 1'b1;\n        end else begin\n            // Four-phase handshake in source domain\n            // State 0: idle (valid=0, ready=1)\n            // State 1: valid asserted (valid=1, ready=1)\n            // State 2: ready deasserted (valid=1, ready=0)\n            // State 3: valid deasserted (valid=0, ready=0)\n            // Back to State 0\n\n            case ({src_valid_r, src_ready_r})\n                2'b01: begin\n                    // Idle: wait for src_valid_i\n                    if (src_valid_i) begin\n                        src_valid_r <= 1'b1;\n                        src_ready_r <= 1'b1;\n                    end\n                end\n                2'b11: begin\n                    // Valid asserted, ready high: wait for dst_ready to be seen\n                    if (dst_ready_sync[1]) begin\n                        src_valid_r <= 1'b1;\n                        src_ready_r <= 1'b0;\n                    end\n                end\n                2'b10: begin\n                    // Valid high, ready low: wait for dst_valid to be seen (meaning dst accepted)\n                    if (dst_valid_sync[1]) begin\n                        src_valid_r <= 1'b0;\n                        src_ready_r <= 1'b0;\n                    end\n                end\n                2'b00: begin\n                    // Both low: return to idle\n                    src_valid_r <= 1'b0;\n                    src_ready_r <= 1'b1;\n                end\n                default: begin\n                    src_valid_r <= 1'b0;\n                    src_ready_r <= 1'b1;\n                end\n            endcase\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_r <= 1'b0;\n            dst_ready_r <= 1'b1;\n        end else begin\n            // Four-phase handshake in destination domain\n            case ({dst_valid_r, dst_ready_r})\n                2'b01: begin\n                    // Idle: wait for src_valid to be seen\n                    if (src_valid_sync[1]) begin\n                        dst_valid_r <= 1'b1;\n                        dst_ready_r <= 1'b1;\n                    end\n                end\n                2'b11: begin\n                    // Valid asserted, ready high: wait for dst_ready_i\n                    if (dst_ready_i) begin\n                        dst_valid_r <= 1'b1;\n                        dst_ready_r <= 1'b0;\n                    end\n                end\n                2'b10: begin\n                    // Valid high, ready low: wait for src_ready to be seen\n                    if (src_ready_sync[1]) begin\n                        dst_valid_r <= 1'b0;\n                        dst_ready_r <= 1'b0;\n                    end\n                end\n                2'b00: begin\n                    // Both low: return to idle\n                    dst_valid_r <= 1'b0;\n                    dst_ready_r <= 1'b1;\n                end\n                default: begin\n                    dst_valid_r <= 1'b0;\n                    dst_ready_r <= 1'b1;\n                end\n            endcase\n        end\n    end\n\n    // Synchronizers\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_valid_sync <= 2'b00;\n        end else begin\n            src_valid_sync <= {src_valid_sync[0], src_valid_r};\n        end\n    end\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_ready_sync <= 2'b00;\n        end else begin\n            dst_ready_sync <= {dst_ready_sync[0], dst_ready_r};\n        end\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_ready_sync <= 2'b00;\n        end else begin\n            src_ready_sync <= {src_ready_sync[0], src_ready_r};\n        end\n    end\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_valid_sync <= 2'b00;\n        end else begin\n            dst_valid_sync <= {dst_valid_sync[0], dst_valid_r};\n        end\n    end\n\n    // Outputs\n    assign src_ready_o = src_ready_r;\n    assign dst_valid_o = dst_valid_r;\n\nendmodule\n```<|im_end|>",
