{
  "text": "```verilog\nmodule isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    // Source domain state\n    reg src_valid_reg;\n    reg src_ready_reg;\n\n    // Destination domain state\n    reg dst_valid_reg;\n    reg dst_ready_reg;\n\n    // Synchronizers for src_valid to dst domain\n    reg [1:0] src_valid_sync;\n    wire src_valid_synced = src_valid_sync[1];\n\n    // Synchronizers for dst_ready to src domain\n    reg [1:0] dst_ready_sync;\n    wire dst_ready_synced = dst_ready_sync[1];\n\n    // Synchronizers for dst_valid to src domain\n    reg [1:0] dst_valid_sync;\n    wire dst_valid_synced = dst_valid_sync[1];\n\n    // Synchronizers for src_ready to dst domain\n    reg [1:0] src_ready_sync;\n    wire src_ready_synced = src_ready_sync[1];\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_valid_reg <= 1'b0;\n            src_ready_reg <= 1'b1;\n        end else begin\n            // Four-phase handshake in source domain\n            // State 0: idle (valid=0, ready=1)\n            // State 1: valid asserted (valid=1, ready=1)\n            // State 2: ready deasserted (valid=1, ready=0)\n            // State 3: valid deasserted (valid=0, ready=0)\n            // State 4: ready asserted (valid=0, ready=1) -> back to idle\n\n            if (src_valid_reg == 1'b0 && src_ready_reg == 1'b1) begin\n                // Idle: wait for src_valid_i\n                if (src_valid_i) begin\n                    src_valid_reg <= 1'b1;\n                    // src_ready stays 1\n                end\n            end\n            else if (src_valid_reg == 1'b1 && src_ready_reg == 1'b1) begin\n                // Valid asserted, ready still high: wait for dst to see valid\n                // and then deassert ready\n                if (dst_valid_synced) begin\n                    src_ready_reg <= 1'b0;\n                end\n            end\n            else if (src_valid_reg == 1'b1 && src_ready_reg == 1'b0) begin\n                // Valid asserted, ready deasserted: wait for dst_ready\n                if (dst_ready_synced) begin\n                    src_valid_reg <= 1'b0;\n                end\n            end\n            else if (src_valid_reg == 1'b0 && src_ready_reg == 1'b0) begin\n                // Valid deasserted, ready still low: wait for dst to see valid deasserted\n                if (!dst_valid_synced) begin\n                    src_ready_reg <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_reg <= 1'b0;\n            dst_ready_reg <= 1'b1;\n        end else begin\n            // Four-phase handshake in destination domain\n            if (dst_valid_reg == 1'b0 && dst_ready_reg == 1'b1) begin\n                // Idle: wait for src_valid to be seen\n                if (src_valid_synced) begin\n                    dst_valid_reg <= 1'b1;\n                    // dst_ready stays 1\n                end\n            end\n            else if (dst_valid_reg == 1'b1 && dst_ready_reg == 1'b1) begin\n                // Valid asserted, ready still high: wait for dst_ready_i\n                if (dst_ready_i) begin\n                    dst_ready_reg <= 1'b0;\n                end\n            end\n            else if (dst_valid_reg == 1'b1 && dst_ready_reg == 1'b0) begin\n                // Valid asserted, ready deasserted: wait for src to see ready deasserted\n                if (!src_ready_synced) begin\n                    dst_valid_reg <= 1'b0;\n                end\n            end\n            else if (dst_valid_reg == 1'b0 && dst_ready_reg == 1'b0) begin\n                // Valid deasserted, ready still low: wait for src to see valid deasserted\n                if (!src_valid_synced) begin\n                    dst_ready_reg <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Synchronizer for src_valid to dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_valid_sync <= 2'b00;\n        end else begin\n            src_valid_sync <= {src_valid_sync[0], src_valid_reg};\n        end\n    end\n\n    // Synchronizer for dst_ready to src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_ready_sync <= 2'b00;\n        end else begin\n            dst_ready_sync <= {dst_ready_sync[0], dst_ready_reg};\n        end\n    end\n\n    // Synchronizer for dst_valid to src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_valid_sync <= 2'b00;\n        end else begin\n            dst_valid_sync <= {dst_valid_sync[0], dst_valid_reg};\n        end\n    end\n\n    // Synchronizer for src_ready to dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_ready_sync <= 2'b00;\n        end else begin\n            src_ready_sync <= {src_ready_sync[0], src_ready_reg};\n        end\n    end\n\n    // Output assignments\n    assign src_ready_o = src_ready_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
