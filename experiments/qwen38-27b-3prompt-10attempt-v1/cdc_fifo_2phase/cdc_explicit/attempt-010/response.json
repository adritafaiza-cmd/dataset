{
  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_W = LOG_DEPTH;\n    localparam CNT_W = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [ADDR_W-1:0] wr_ptr;\n    reg [ADDR_W-1:0] rd_ptr_src;\n    reg [ADDR_W-1:0] rd_ptr_src_sync;\n    reg [ADDR_W-1:0] rd_ptr_src_sync2;\n\n    // Destination domain\n    reg [ADDR_W-1:0] rd_ptr;\n    reg [ADDR_W-1:0] wr_ptr_dst;\n    reg [ADDR_W-1:0] wr_ptr_dst_sync;\n    reg [ADDR_W-1:0] wr_ptr_dst_sync2;\n    reg [WIDTH-1:0] dst_reg;\n    reg dst_valid_reg;\n\n    // Synchronizers for read pointer (src -> dst)\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            rd_ptr_src_sync <= {ADDR_W{1'b0}};\n            rd_ptr_src_sync2 <= {ADDR_W{1'b0}};\n        end else begin\n            rd_ptr_src_sync <= rd_ptr_src;\n            rd_ptr_src_sync2 <= rd_ptr_src_sync;\n        end\n    end\n\n    // Synchronizers for write pointer (dst -> src)\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            wr_ptr_dst_sync <= {ADDR_W{1'b0}};\n            wr_ptr_dst_sync2 <= {ADDR_W{1'b0}};\n        end else begin\n            wr_ptr_dst_sync <= wr_ptr_dst;\n            wr_ptr_dst_sync2 <= wr_ptr_dst_sync;\n        end\n    end\n\n    // Source domain logic\n    wire src_wr_en = src_valid_i & src_ready_o;\n    wire [CNT_W-1:0] src_count = {1'b0, wr_ptr} - {1'b0, rd_ptr_src_sync2};\n    wire src_full = (src_count == CNT_W'(DEPTH));\n    assign src_ready_o = !src_full;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            wr_ptr <= {ADDR_W{1'b0}};\n            rd_ptr_src <= {ADDR_W{1'b0}};\n        end else begin\n            if (src_wr_en)\n                mem[wr_ptr] <= src_data_i;\n            if (src_wr_en)\n                wr_ptr <= wr_ptr + 1'b1;\n            if (dst_valid_reg & dst_ready_i)\n                rd_ptr_src <= rd_ptr_src + 1'b1;\n        end\n    end\n\n    // Destination domain logic\n    wire [CNT_W-1:0] dst_count = {1'b0, wr_ptr_dst_sync2} - {1'b0, rd_ptr};\n    wire dst_empty = (dst_count == {CNT_W{1'b0}});\n    wire dst_wr_en = !dst_empty;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            rd_ptr <= {ADDR_W{1'b0}};\n            wr_ptr_dst <= {ADDR_W{1'b0}};\n            dst_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_wr_en) begin\n                dst_reg <= mem[rd_ptr];\n                rd_ptr <= rd_ptr + 1'b1;\n                dst_valid_reg <= 1'b1;\n            end else begin\n                dst_valid_reg <= 1'b0;\n            end\n            if (dst_valid_reg & dst_ready_i)\n                wr_ptr_dst <= wr_ptr_dst + 1'b1;\n        end\n    end\n\n    assign dst_data_o = dst_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
