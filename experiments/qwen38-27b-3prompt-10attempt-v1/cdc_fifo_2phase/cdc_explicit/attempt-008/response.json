  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_WIDTH = LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [ADDR_WIDTH-1:0] wr_ptr;\n    reg [PTR_WIDTH-1:0] wr_ptr_gray;\n    reg [PTR_WIDTH-1:0] rd_ptr_gray_src;\n\n    // Destination domain\n    reg [ADDR_WIDTH-1:0] rd_ptr;\n    reg [PTR_WIDTH-1:0] rd_ptr_gray;\n    reg [PTR_WIDTH-1:0] wr_ptr_gray_dst;\n    reg [WIDTH-1:0] dst_reg;\n    reg dst_valid_reg;\n\n    // Gray code conversion functions\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_WIDTH-1:0] gray2bin;\n        input [PTR_WIDTH-1:0] gray;\n        reg [PTR_WIDTH-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                bin[i] = bin[i+1] ^ gray[i];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source domain logic\n    wire [PTR_WIDTH-1:0] wr_ptr_bin = gray2bin(wr_ptr_gray);\n    wire [ADDR_WIDTH-1:0] wr_addr = wr_ptr_bin[ADDR_WIDTH-1:0];\n    wire [PTR_WIDTH-1:0] rd_ptr_bin_src = gray2bin(rd_ptr_gray_src);\n    wire [ADDR_WIDTH-1:0] rd_addr_src = rd_ptr_bin_src[ADDR_WIDTH-1:0];\n\n    wire src_full = (wr_ptr_gray == rd_ptr_gray_src) && (wr_ptr_bin[PTR_WIDTH-1] != rd_ptr_bin_src[PTR_WIDTH-1]);\n    wire src_can_write = src_valid_i && !src_full;\n\n    assign src_ready_o = !src_full;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            wr_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end else if (src_can_write) begin\n            mem[wr_addr] <= src_data_i;\n            wr_ptr_gray <= bin2gray(wr_ptr_bin + 1'b1);\n        end\n    end\n\n    // Synchronize rd_ptr_gray from dst to src\n    reg [PTR_WIDTH-1:0] rd_ptr_gray_sync1;\n    reg [PTR_WIDTH-1:0] rd_ptr_gray_sync2;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            rd_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            rd_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            rd_ptr_gray_sync1 <= rd_ptr_gray;\n            rd_ptr_gray_sync2 <= rd_ptr_gray_sync1;\n        end\n    end\n\n    assign rd_ptr_gray_src = rd_ptr_gray_sync2;\n\n    // Destination domain logic\n    wire [PTR_WIDTH-1:0] rd_ptr_bin = gray2bin(rd_ptr_gray);\n    wire [ADDR_WIDTH-1:0] rd_addr = rd_ptr_bin[ADDR_WIDTH-1:0];\n    wire [PTR_WIDTH-1:0] wr_ptr_bin_dst = gray2bin(wr_ptr_gray_dst);\n    wire [ADDR_WIDTH-1:0] wr_addr_dst = wr_ptr_bin_dst[ADDR_WIDTH-1:0];\n\n    wire dst_empty = (rd_ptr_gray == wr_ptr_gray_dst);\n    wire dst_can_read = dst_valid_reg && dst_ready_i;\n\n    assign dst_valid_o = dst_valid_reg;\n    assign dst_data_o = dst_reg;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            rd_ptr_gray <= {PTR_WIDTH{1'b0}};\n            dst_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_can_read) begin\n                dst_valid_reg <= 1'b0;\n                rd_ptr_gray <= bin2gray(rd_ptr_bin + 1'b1);\n            end else if (!dst_empty && !dst_valid_reg) begin\n                dst_reg <= mem[rd_addr];\n                dst_valid_reg <= 1'b1;\n            end\n        end\n    end\n\n    // Synchronize wr_ptr_gray from src to dst\n    reg [PTR_WIDTH-1:0] wr_ptr_gray_sync1;\n    reg [PTR_WIDTH-1:0] wr_ptr_gray_sync2;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            wr_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            wr_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            wr_ptr_gray_sync1 <= wr_ptr_gray;\n            wr_ptr_gray_sync2 <= wr_ptr_gray_sync1;\n        end\n    end\n\n    assign wr_ptr_gray_dst = wr_ptr_gray_sync2;\n\nendmodule\n```<|im_end|>",
