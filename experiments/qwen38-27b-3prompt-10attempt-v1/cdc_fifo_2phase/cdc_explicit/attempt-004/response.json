  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam ADDR_W = LOG_DEPTH;\n    localparam CNT_W = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [ADDR_W-1:0] wr_ptr;\n    reg [ADDR_W-1:0] rd_ptr_src; // synchronized read pointer in src domain\n\n    // Destination domain\n    reg [ADDR_W-1:0] rd_ptr;\n    reg [ADDR_W-1:0] wr_ptr_dst; // synchronized write pointer in dst domain\n    reg [WIDTH-1:0] dst_reg;\n    reg dst_valid_reg;\n\n    // Synchronization registers\n    reg [ADDR_W-1:0] wr_ptr_sync1, wr_ptr_sync2;\n    reg [ADDR_W-1:0] rd_ptr_sync1, rd_ptr_sync2;\n\n    // Source domain logic\n    wire src_wr_en = src_valid_i & src_ready_o;\n    wire src_full;\n\n    // Compute src_ready_o: FIFO is not full\n    // Full when wr_ptr == rd_ptr_src and the MSB differs (Gray code comparison)\n    // Using binary pointers: full when (wr_ptr + 1) == rd_ptr_src and MSB differs\n    // Actually, let's use Gray code for CDC safety.\n\n    // Convert binary to Gray\n    function [ADDR_W-1:0] bin2gray;\n        input [ADDR_W-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Source domain: write pointer in Gray\n    wire [ADDR_W-1:0] wr_ptr_gray = bin2gray({1'b0, wr_ptr});\n\n    // Destination domain: read pointer in Gray\n    wire [ADDR_W-1:0] rd_ptr_gray = bin2gray({1'b0, rd_ptr});\n\n    // Synchronize write pointer to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            wr_ptr_sync1 <= {ADDR_W{1'b0}};\n            wr_ptr_sync2 <= {ADDR_W{1'b0}};\n        end else begin\n            wr_ptr_sync1 <= wr_ptr_gray;\n            wr_ptr_sync2 <= wr_ptr_sync1;\n        end\n    end\n\n    // Synchronize read pointer to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            rd_ptr_sync1 <= {ADDR_W{1'b0}};\n            rd_ptr_sync2 <= {ADDR_W{1'b0}};\n        end else begin\n            rd_ptr_sync1 <= rd_ptr_gray;\n            rd_ptr_sync2 <= rd_ptr_sync1;\n        end\n    end\n\n    // Source domain: determine if FIFO is full\n    // Full when wr_ptr_gray == rd_ptr_sync2 and MSB differs\n    // Actually, with Gray code, full when wr_ptr_gray == rd_ptr_sync2 ^ {1'b1, {ADDR_W-1{1'b0}}}\n    // Let's use the standard approach:\n    // Full when (wr_ptr + 1) == rd_ptr in binary, which in Gray means:\n    // wr_ptr_gray == rd_ptr_sync2 and MSB of wr_ptr != MSB of rd_ptr_sync2\n    // Simpler: convert synchronized Gray back to binary and compare\n\n    wire [ADDR_W-1:0] rd_ptr_sync2_bin = gray2bin(rd_ptr_sync2);\n    wire [ADDR_W-1:0] wr_ptr_gray_inv = wr_ptr_gray ^ {1'b1, {ADDR_W-1{1'b0}}};\n\n    // Full condition: wr_ptr_gray == rd_ptr_sync2 and MSB differs\n    // Or equivalently: wr_ptr_gray == (rd_ptr_sync2 + 1) in Gray\n    // Standard: full when wr_ptr_gray == rd_ptr_sync2 and MSB(wr_ptr) != MSB(rd_ptr_sync2)\n    // Let's just use: full when (wr_ptr + 1) == rd_ptr_sync2_bin\n    wire src_full = (wr_ptr + 1'b1) == rd_ptr_sync2_bin;\n\n    assign src_ready_o = !src_full;\n\n    // Write to memory\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            wr_ptr <= {ADDR_W{1'b0}};\n        end else if (src_wr_en) begin\n            mem[wr_ptr] <= src_data_i;\n            wr_ptr <= wr_ptr + 1'b1;\n        end\n    end\n\n    // Destination domain logic\n    wire dst_rd_en = dst_valid_o & dst_ready_i;\n    wire dst_empty;\n\n    // Empty when rd_ptr == wr_ptr_sync2_bin\n    wire [ADDR_W-1:0] wr_ptr_sync2_bin = gray2bin(wr_ptr_sync2);\n    wire dst_empty = (rd_ptr == wr_ptr_sync2_bin);\n\n    // Destination valid: we have data to deliver\n    // dst_valid_o is high when FIFO is not empty\n    assign dst_valid_o = !dst_empty;\n\n    // Read from memory and register output\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            rd_ptr <= {ADDR_W{1'b0}};\n            dst_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_rd_en) begin\n                rd_ptr <= rd_ptr + 1'b1;\n            end\n            if (!dst_empty) begin\n                dst_reg <= mem[rd_ptr];\n                dst_valid_reg <= 1'b1;\n            end else begin\n                dst_valid_reg <= 1'b0;\n            end\n        end\n    end\n\n    assign dst_data_o = dst_reg;\n\n    // Gray to binary conversion\n    function [ADDR_W-1:0] gray2bin;\n        input [ADDR_W-1:0] gray;\n        integer i;\n        begin\n            gray2bin[ADDR_W-1] = gray[ADDR_W-1];\n            for (i = ADDR_W-2; i >= 0; i = i - 1) begin\n                gray2bin[i] = gray2bin[i+1] ^ gray[i];\n            end\n        end\n    endfunction\n\nendmodule\n```<|im_end|>",
