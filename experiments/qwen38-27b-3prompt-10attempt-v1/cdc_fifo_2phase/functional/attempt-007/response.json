{
  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_src;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_src_sync1;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_src_sync2;\n\n    wire src_wr_en = src_valid_i & src_ready_o;\n    wire src_full = (src_wr_ptr[PTR_WIDTH-1] != dst_rd_ptr_src_sync2[PTR_WIDTH-1]) &&\n                    (src_wr_ptr[LOG_DEPTH-1:0] == dst_rd_ptr_src_sync2[LOG_DEPTH-1:0]);\n    assign src_ready_o = ~src_full;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_src <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_src_sync1 <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_src_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_rd_ptr_src_sync1 <= dst_rd_ptr_src;\n            dst_rd_ptr_src_sync2 <= dst_rd_ptr_src_sync1;\n            if (src_wr_en) begin\n                mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n                src_wr_ptr <= src_wr_ptr + 1'b1;\n            end\n        end\n    end\n\n    // Destination domain\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [PTR_WIDTH-1:0] src_wr_ptr_dst;\n    reg [PTR_WIDTH-1:0] src_wr_ptr_dst_sync1;\n    reg [PTR_WIDTH-1:0] src_wr_ptr_dst_sync2;\n    reg dst_valid_reg;\n\n    wire dst_rd_en = dst_valid_o & dst_ready_i;\n    wire dst_empty = (dst_rd_ptr == src_wr_ptr_dst_sync2);\n    assign dst_valid_o = dst_valid_reg | ~dst_empty;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_dst <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_dst_sync1 <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_dst_sync2 <= {PTR_WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            src_wr_ptr_dst_sync1 <= src_wr_ptr_dst;\n            src_wr_ptr_dst_sync2 <= src_wr_ptr_dst_sync1;\n            if (dst_rd_en) begin\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                dst_valid_reg <= 1'b0;\n            end else if (~dst_empty) begin\n                dst_valid_reg <= 1'b1;\n            end\n        end\n    end\n\n    // Cross-domain pointer synchronization\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_dst <= {PTR_WIDTH{1'b0}};\n        end else begin\n            src_wr_ptr_dst <= src_wr_ptr;\n        end\n    end\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_src <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_rd_ptr_src <= dst_rd_ptr;\n        end\n    end\n\n    // Output data\n    assign dst_data_o = mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n\nendmodule\n```<|im_end|>",
