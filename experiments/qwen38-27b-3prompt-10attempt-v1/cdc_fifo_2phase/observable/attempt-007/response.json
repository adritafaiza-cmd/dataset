{
  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Storage\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Source domain pointers\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_sync;\n\n    // Destination domain pointers\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_sync;\n\n    // Synchronizers\n    reg [PTR_WIDTH-1:0] src_wr_ptr_sync1, src_wr_ptr_sync2;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_sync1, dst_rd_ptr_sync2;\n\n    // Destination output register\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Source ready logic\n    wire src_full;\n    wire src_can_write;\n\n    // Destination ready logic\n    wire dst_empty;\n    wire dst_can_read;\n\n    // Calculate full/empty conditions\n    // Full when source write pointer has lapped destination read pointer by DEPTH\n    assign src_full = (src_wr_ptr[PTR_WIDTH-1] != src_rd_ptr_sync[PTR_WIDTH-1]) &&\n                      (src_wr_ptr[PTR_WIDTH-2:0] == src_rd_ptr_sync[PTR_WIDTH-2:0]);\n\n    // Empty when destination read pointer equals source write pointer\n    assign dst_empty = (dst_rd_ptr == dst_wr_ptr_sync);\n\n    assign src_can_write = src_valid_i && !src_full;\n    assign dst_can_read = !dst_empty && dst_ready_i;\n\n    // Source clock domain: write to memory and update write pointer\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (src_can_write) begin\n            mem[src_wr_ptr[PTR_WIDTH-2:0]] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n        end\n    end\n\n    // Synchronize source write pointer to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            src_wr_ptr_sync1 <= src_wr_ptr;\n            src_wr_ptr_sync2 <= src_wr_ptr_sync1;\n        end\n    end\n    assign dst_wr_ptr_sync = src_wr_ptr_sync2;\n\n    // Synchronize destination read pointer to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_rd_ptr_sync1 <= dst_rd_ptr;\n            dst_rd_ptr_sync2 <= dst_rd_ptr_sync1;\n        end\n    end\n    assign src_rd_ptr_sync = dst_rd_ptr_sync2;\n\n    // Destination clock domain: read from memory and update read pointer\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_can_read) begin\n                dst_data_reg <= mem[dst_rd_ptr[PTR_WIDTH-2:0]];\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                dst_valid_reg <= 1'b1;\n            end else begin\n                dst_valid_reg <= 1'b0;\n            end\n        end\n    end\n\n    // Outputs\n    assign src_ready_o = !src_full;\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
