  "text": "```verilog\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Storage\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Source domain pointers\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_sync;\n\n    // Destination domain pointers\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_sync;\n\n    // Synchronizers\n    reg [PTR_WIDTH-1:0] src_wr_ptr_sync1, src_wr_ptr_sync2;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_sync1, dst_rd_ptr_sync2;\n\n    // Destination output register\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Source ready logic\n    wire src_full;\n    wire src_can_write;\n\n    // Destination ready logic\n    wire dst_empty;\n    wire dst_can_read;\n\n    // Compute full/empty\n    // Full: src_wr_ptr - src_rd_ptr_sync == DEPTH\n    // Empty: dst_rd_ptr == dst_wr_ptr_sync\n    assign src_full = (src_wr_ptr[PTR_WIDTH-1:1] == src_rd_ptr_sync[PTR_WIDTH-1:1]) &&\n                      (src_wr_ptr[0] != src_rd_ptr_sync[0]);\n    // Actually, for a 2-phase FIFO with pointer width LOG_DEPTH+1:\n    // Full when the upper bits are equal and the LSBs differ (wr_ptr is one ahead in the wrap-around sense)\n    // Let's use a simpler comparison:\n    // Full: (src_wr_ptr - src_rd_ptr_sync) == DEPTH\n    // Since DEPTH = 2^LOG_DEPTH, and pointers are LOG_DEPTH+1 bits:\n    // Full when src_wr_ptr[LOG_DEPTH:1] == src_rd_ptr_sync[LOG_DEPTH:1] and src_wr_ptr[0] != src_rd_ptr_sync[0]\n    // But actually, the standard way:\n    // Full: src_wr_ptr[PTR_WIDTH-1:1] == src_rd_ptr_sync[PTR_WIDTH-1:1] && src_wr_ptr[0] != src_rd_ptr_sync[0]\n    // This works because when full, the write pointer has wrapped around and is exactly DEPTH ahead.\n\n    // Let me reconsider. With PTR_WIDTH = LOG_DEPTH + 1:\n    // The difference (wr_ptr - rd_ptr) mod 2^(LOG_DEPTH+1) gives the number of entries.\n    // Full when difference == DEPTH = 2^LOG_DEPTH\n    // Empty when difference == 0\n\n    // For full: wr_ptr[LOG_DEPTH:1] == rd_ptr[LOG_DEPTH:1] and wr_ptr[0] != rd_ptr[0]\n    // For empty: wr_ptr == rd_ptr\n\n    assign src_full = (src_wr_ptr[PTR_WIDTH-1:1] == src_rd_ptr_sync[PTR_WIDTH-1:1]) &&\n                      (src_wr_ptr[0] != src_rd_ptr_sync[0]);\n\n    assign dst_empty = (dst_rd_ptr == dst_wr_ptr_sync);\n\n    assign src_can_write = src_valid_i && !src_full;\n    assign dst_can_read = !dst_empty && dst_ready_i;\n\n    // Source clock domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (src_can_write) begin\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n        end\n    end\n\n    assign src_ready_o = !src_full;\n\n    // Synchronize src_wr_ptr to dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_wr_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            src_wr_ptr_sync1 <= src_wr_ptr;\n            src_wr_ptr_sync2 <= src_wr_ptr_sync1;\n        end\n    end\n\n    assign dst_wr_ptr_sync = src_wr_ptr_sync2;\n\n    // Synchronize dst_rd_ptr to src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rd_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_rd_ptr_sync1 <= dst_rd_ptr;\n            dst_rd_ptr_sync2 <= dst_rd_ptr_sync1;\n        end\n    end\n\n    assign src_rd_ptr_sync = dst_rd_ptr_sync2;\n\n    // Destination clock domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (dst_can_read) begin\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                dst_data_reg <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n                dst_valid_reg <= 1'b1;\n            end else begin\n                dst_valid_reg <= 1'b0;\n            end\n        end\n    end\n\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
