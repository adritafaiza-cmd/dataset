  "text": "```systemverilog\nmodule rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    logic [1:0] rst_sync;\n\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            rst_sync <= 2'b00;\n        end else begin\n            rst_sync <= {rst_sync[0], 1'b1};\n        end\n    end\n\n    assign rst_no  = test_mode_i ? 1'b1 : rst_sync[1];\n    assign init_no = rst_sync[1];\n\nendmodule\n```<|im_end|>",
