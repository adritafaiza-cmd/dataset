  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Total data width for storage\n    localparam TOTAL_DATA_WIDTH = DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH + DEST_WIDTH + USER_WIDTH;\n\n    // Storage arrays\n    reg [DATA_WIDTH-1:0] mem_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] mem_keep [0:DEPTH-1];\n    reg                  mem_last [0:DEPTH-1];\n    reg [ID_WIDTH-1:0]   mem_id   [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0] mem_dest [0:DEPTH-1];\n    reg [USER_WIDTH-1:0] mem_user [0:DEPTH-1];\n\n    // Write pointer (source clock domain)\n    reg [PTR_WIDTH-1:0] w_ptr;\n    reg [PTR_WIDTH-1:0] w_ptr_commit;\n\n    // Read pointer (master clock domain)\n    reg [PTR_WIDTH-1:0] r_ptr;\n    reg [PTR_WIDTH-1:0] r_ptr_commit;\n\n    // Synchronizers\n    reg [PTR_WIDTH-1:0] w_ptr_sync_1, w_ptr_sync_2;\n    reg [PTR_WIDTH-1:0] r_ptr_sync_1, r_ptr_sync_2;\n\n    // Status flags\n    reg s_overflow;\n    reg m_overflow;\n    reg s_bad_frame;\n    reg m_bad_frame;\n    reg s_good_frame;\n    reg m_good_frame;\n\n    // Pause logic\n    reg s_paused;\n    reg m_paused;\n\n    // Frame tracking\n    reg s_in_frame;\n    reg m_in_frame;\n    reg s_frame_overflow;\n    reg m_frame_overflow;\n\n    // Output FIFO (if enabled)\n    reg [DATA_WIDTH-1:0] out_fifo_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] out_fifo_keep [0:DEPTH-1];\n    reg                  out_fifo_last [0:DEPTH-1];\n    reg [ID_WIDTH-1:0]   out_fifo_id   [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0] out_fifo_dest [0:DEPTH-1];\n    reg [USER_WIDTH-1:0] out_fifo_user [0:DEPTH-1];\n    reg [PTR_WIDTH-1:0] out_fifo_w_ptr;\n    reg [PTR_WIDTH-1:0] out_fifo_r_ptr;\n\n    // Internal signals\n    wire s_write_en;\n    wire m_read_en;\n    wire s_full;\n    wire m_empty;\n    wire s_depth;\n    wire m_depth;\n\n    // Calculate full/empty\n    assign s_full = (w_ptr_commit - r_ptr_sync_2) >= DEPTH;\n    assign m_empty = (r_ptr_commit - w_ptr_sync_2) == 0;\n\n    // Depth calculations\n    wire [PTR_WIDTH-1:0] s_depth_raw = w_ptr_commit - r_ptr_sync_2;\n    wire [PTR_WIDTH-1:0] m_depth_raw = r_ptr_commit - w_ptr_sync_2;\n\n    assign s_status_depth = s_depth_raw;\n    assign s_status_depth_commit = w_ptr_commit - r_ptr_sync_2;\n    assign m_status_depth = m_depth_raw;\n    assign m_status_depth_commit = r_ptr_commit - w_ptr_sync_2;\n\n    // Synchronizers\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            w_ptr_sync_1 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync_2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            w_ptr_sync_1 <= w_ptr_commit;\n            w_ptr_sync_2 <= w_ptr_sync_1;\n        end\n    end\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            r_ptr_sync_1 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync_2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            r_ptr_sync_1 <= r_ptr_commit;\n            r_ptr_sync_2 <= r_ptr_sync_1;\n        end\n    end\n\n    // Write enable logic\n    wire s_accept = s_axis_tvalid && s_axis_tready && !s_paused;\n    assign s_write_en = s_accept;\n\n    // Read enable logic\n    wire m_accept = m_axis_tvalid && m_axis_tready && !m_paused;\n    assign m_read_en = m_accept;\n\n    // Source side write logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_ptr <= {PTR_WIDTH{1'b0}};\n            w_ptr_commit <= {PTR_WIDTH{1'b0}};\n            s_overflow <= 1'b0;\n            s_bad_frame <= 1'b0;\n            s_good_frame <= 1'b0;\n            s_in_frame <= 1'b0;\n            s_frame_overflow <= 1'b0;\n            s_paused <= 1'b0;\n        end else begin\n            // Pause handling\n            if (s_pause_req) begin\n                s_paused <= 1'b1;\n            end else if (s_paused && !s_pause_req) begin\n                s_paused <= 1'b0;\n            end\n\n            // Write data\n            if (s_write_en) begin\n                mem_data[w_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdata;\n                mem_keep[w_ptr[ADDR_WIDTH-1:0]] <= s_axis_tkeep;\n                mem_last[w_ptr[ADDR_WIDTH-1:0]] <= s_axis_tlast;\n                mem_id[w_ptr[ADDR_WIDTH-1:0]]   <= s_axis_tid;\n                mem_dest[w_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdest;\n                mem_user[w_ptr[ADDR_WIDTH-1:0]] <= s_axis_tuser;\n\n                w_ptr <= w_ptr + 1'b1;\n                w_ptr_commit <= w_ptr + 1'b1;\n\n                // Frame tracking\n                if (s_axis_tlast) begin\n                    s_in_frame <= 1'b0;\n                    s_good_frame <= 1'b1;\n                    s_bad_frame <= 1'b0;\n                end else begin\n                    s_in_frame <= 1'b1;\n                end\n\n                // Overflow detection\n                if (s_full) begin\n                    s_overflow <= 1'b1;\n                    if (DROP_WHEN_FULL) begin\n                        // Drop the beat\n                    end else if (MARK_WHEN_FULL) begin\n                        // Mark as bad\n                        s_bad_frame <= 1'b1;\n                    end\n                end\n            end\n        end\n    end\n\n    // Master side read logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr <= {PTR_WIDTH{1'b0}};\n            r_ptr_commit <= {PTR_WIDTH{1'b0}};\n            m_overflow <= 1'b0;\n            m_bad_frame <= 1'b0;\n            m_good_frame <= 1'b0;\n            m_in_frame <= 1'b0;\n            m_frame_overflow <= 1'b0;\n            m_paused <= 1'b0;\n            out_fifo_w_ptr <= {PTR_WIDTH{1'b0}};\n            out_fifo_r_ptr <= {PTR_WIDTH{1'b0}};\n        end else begin\n            // Pause handling\n            if (m_pause_req) begin\n                m_paused <= 1'b1;\n            end else if (m_paused && !m_pause_req) begin\n                m_paused <= 1'b0;\n            end\n\n            // Read data\n            if (m_read_en) begin\n                r_ptr <= r_ptr + 1'b1;\n                r_ptr_commit <= r_ptr + 1'b1;\n\n                // Frame tracking\n                if (m_axis_tlast) begin\n                    m_in_frame <= 1'b0;\n                    m_good_frame <= 1'b1;\n                    m_bad_frame <= 1'b0;\n                end else begin\n                    m_in_frame <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Output logic\n    if (OUTPUT_FIFO_ENABLE) begin\n        // Use output FIFO\n        wire [ADDR_WIDTH-1:0] out_fifo_r_addr = out_fifo_r_ptr[ADDR_WIDTH-1:0];\n        wire [ADDR_WIDTH-1:0] out_fifo_w_addr = out_fifo_w_ptr[ADDR_WIDTH-1:0];\n\n        assign m_axis_tdata = out_fifo_data[out_fifo_r_addr];\n        assign m_axis_tkeep = out_fifo_keep[out_fifo_r_addr];\n        assign m_axis_tlast = out_fifo_last[out_fifo_r_addr];\n        assign m_axis_tid   = out_fifo_id[out_fifo_r_addr];\n        assign m_axis_tdest = out_fifo_dest[out_fifo_r_addr];\n        assign m_axis_tuser = out_fifo_user[out_fifo_r_addr];\n\n        wire out_fifo_empty = (out_fifo_w_ptr == out_fifo_r_ptr);\n        wire out_fifo_full  = (out_fifo_w_ptr - out_fifo_r_ptr) >= DEPTH;\n\n        assign m_axis_tvalid = !out_fifo_empty;\n\n        // Write to output FIFO when reading from main memory\n        wire main_read_en = !m_empty && !m_paused;\n        always @(posedge m_clk or posedge m_rst) begin\n            if (m_rst) begin\n                // Reset handled above\n            end else if (main_read_en) begin\n                out_fifo_data[out_fifo_w_addr] <= mem_data[r_ptr[ADDR_WIDTH-1:0]];\n                out_fifo_keep[out_fifo_w_addr] <= mem_keep[r_ptr[ADDR_WIDTH-1:0]];\n                out_fifo_last[out_fifo_w_addr] <= mem_last[r_ptr[ADDR_WIDTH-1:0]];\n                out_fifo_id[out_fifo_w_addr]   <= mem_id[r_ptr[ADDR_WIDTH-1:0]];\n                out_fifo_dest[out_fifo_w_addr] <= mem_dest[r_ptr[ADDR_WIDTH-1:0]];\n                out_fifo_user[out_fifo_w_addr] <= mem_user[r_ptr[ADDR_WIDTH-1:0]];\n                out_fifo_w_ptr <= out_fifo_w_ptr + 1'b1;\n            end\n        end\n\n        // Read from output FIFO\n        always @(posedge m_clk or posedge m_rst) begin\n            if (m_rst) begin\n                // Reset handled above\n            end else if (m_read_en) begin\n                out_fifo_r_ptr <= out_fifo_r_ptr + 1'b1;\n            end\n        end\n    end else begin\n        // Direct output from main memory\n        wire [ADDR_WIDTH-1:0] r_addr = r_ptr[ADDR_WIDTH-1:0];\n\n        assign m_axis_tdata = mem_data[r_addr];\n        assign m_axis_tkeep = mem_keep[r_addr];\n        assign m_axis_tlast = mem_last[r_addr];\n        assign m_axis_tid   = mem_id[r_addr];\n        assign m_axis_tdest = mem_dest[r_addr];\n        assign m_axis_tuser = mem_user[r_addr];\n\n        assign m_axis_tvalid = !m_empty;\n    end\n\n    // Source side ready\n    assign s_axis_tready = !s_full && !s_paused;\n\n    // Pause acknowledgments\n    assign s_pause_ack = s_paused;\n    assign m_pause_ack = m_paused;\n\n    // Status outputs\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n\nendmodule\n```<|im_end|>",
