  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n\n    // Total data width for storage\n    localparam TOTAL_DATA_WIDTH = DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH + DEST_WIDTH + USER_WIDTH;\n\n    // RAM storage\n    reg [TOTAL_DATA_WIDTH-1:0] ram [0:DEPTH-1];\n\n    // Write pointer (s_clk domain)\n    reg [PTR_WIDTH-1:0] w_ptr;\n    // Read pointer (m_clk domain)\n    reg [PTR_WIDTH-1:0] r_ptr;\n\n    // Synchronizers for read pointer to s_clk domain\n    reg [PTR_WIDTH-1:0] r_ptr_sync1, r_ptr_sync2, r_ptr_sync3;\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            r_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            r_ptr_sync1 <= r_ptr;\n            r_ptr_sync2 <= r_ptr_sync1;\n            r_ptr_sync3 <= r_ptr_sync2;\n        end\n    end\n\n    // Synchronizers for write pointer to m_clk domain\n    reg [PTR_WIDTH-1:0] w_ptr_sync1, w_ptr_sync2, w_ptr_sync3;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            w_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            w_ptr_sync1 <= w_ptr;\n            w_ptr_sync2 <= w_ptr_sync1;\n            w_ptr_sync3 <= w_ptr_sync2;\n        end\n    end\n\n    // Depth calculations\n    wire [PTR_WIDTH-1:0] s_depth = w_ptr - r_ptr_sync3;\n    wire [PTR_WIDTH-1:0] m_depth = w_ptr_sync3 - r_ptr;\n\n    // Full and empty conditions\n    wire s_full = (s_depth == DEPTH);\n    wire m_empty = (m_depth == 0);\n\n    // Pause logic\n    reg s_paused, m_paused;\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) s_paused <= 1'b0;\n        else if (PAUSE_ENABLE) s_paused <= s_pause_req;\n        else s_paused <= 1'b0;\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) m_paused <= 1'b0;\n        else if (PAUSE_ENABLE) m_paused <= m_pause_req;\n        else m_paused <= 1'b0;\n    end\n\n    assign s_pause_ack = s_paused;\n    assign m_pause_ack = m_paused;\n\n    // Frame tracking in s_clk domain\n    reg s_in_frame;\n    reg s_frame_overflow;\n    reg s_frame_bad;\n    reg s_frame_good;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_in_frame <= 1'b0;\n            s_frame_overflow <= 1'b0;\n            s_frame_bad <= 1'b0;\n            s_frame_good <= 1'b0;\n        end else begin\n            s_frame_overflow <= 1'b0;\n            s_frame_bad <= 1'b0;\n            s_frame_good <= 1'b0;\n\n            if (s_axis_tvalid && s_axis_tready) begin\n                if (s_in_frame) begin\n                    if (s_axis_tlast) begin\n                        s_in_frame <= 1'b0;\n                        s_frame_good <= 1'b1;\n                    end else if (DROP_OVERSIZE_FRAME && s_full) begin\n                        s_frame_overflow <= 1'b1;\n                        s_in_frame <= 1'b0;\n                    end\n                end else begin\n                    if (s_axis_tlast) begin\n                        s_frame_good <= 1'b1;\n                    end else begin\n                        s_in_frame <= 1'b1;\n                    end\n                end\n            end\n        end\n    end\n\n    // Write enable\n    wire s_write_en = s_axis_tvalid && s_axis_tready && !s_paused;\n\n    // Determine if we should drop or mark\n    wire s_drop = (DROP_WHEN_FULL && s_full) || (DROP_OVERSIZE_FRAME && s_in_frame && s_full);\n    wire s_mark = (MARK_WHEN_FULL && s_full) && !s_drop;\n\n    // Actual write to RAM\n    wire s_ram_write = s_write_en && !s_drop;\n\n    // Write address\n    wire [ADDR_WIDTH-1:0] w_addr = w_ptr[ADDR_WIDTH-1:0];\n\n    // Write data\n    wire [TOTAL_DATA_WIDTH-1:0] w_data;\n    assign w_data[DATA_WIDTH-1:0] = s_axis_tdata;\n    assign w_data[DATA_WIDTH +: KEEP_WIDTH] = s_axis_tkeep;\n    assign w_data[DATA_WIDTH + KEEP_WIDTH] = s_axis_tlast;\n    assign w_data[DATA_WIDTH + KEEP_WIDTH + 1 +: ID_WIDTH] = s_axis_tid;\n    assign w_data[DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH +: DEST_WIDTH] = s_axis_tdest;\n    assign w_data[DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH + DEST_WIDTH +: USER_WIDTH] = s_axis_tuser;\n\n    // RAM write\n    always @(posedge s_clk) begin\n        if (s_ram_write) begin\n            ram[w_addr] <= w_data;\n        end\n    end\n\n    // Update write pointer\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) w_ptr <= {PTR_WIDTH{1'b0}};\n        else if (s_ram_write) w_ptr <= w_ptr + 1'b1;\n    end\n\n    // tready logic\n    wire s_tready_base = !s_full && !s_paused;\n    assign s_axis_tready = s_tready_base;\n\n    // Read side\n    wire [ADDR_WIDTH-1:0] r_addr = r_ptr[ADDR_WIDTH-1:0];\n\n    // RAM read\n    reg [TOTAL_DATA_WIDTH-1:0] r_data;\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) r_data <= {TOTAL_DATA_WIDTH{1'b0}};\n        else if (!m_empty) r_data <= ram[r_addr];\n    end\n\n    // Output FIFO for pipeline\n    reg [TOTAL_DATA_WIDTH-1:0] out_fifo [0:1];\n    reg [1:0] out_w_ptr, out_r_ptr;\n    reg out_w_valid, out_r_valid;\n\n    // Read from RAM into output FIFO\n    wire m_ram_read = !m_empty && !out_w_valid && !m_paused;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            out_w_valid <= 1'b0;\n            out_r_valid <= 1'b0;\n            out_w_ptr <= 2'b00;\n            out_r_ptr <= 2'b00;\n        end else begin\n            if (m_ram_read) begin\n                out_fifo[out_w_ptr[0]] <= r_data;\n                out_w_ptr <= out_w_ptr + 1'b1;\n                out_w_valid <= 1'b1;\n            end\n            if (m_axis_tvalid && m_axis_tready) begin\n                out_r_ptr <= out_r_ptr + 1'b1;\n                out_r_valid <= 1'b0;\n            end\n        end\n    end\n\n    // Output data\n    wire [TOTAL_DATA_WIDTH-1:0] m_out_data = out_fifo[out_r_ptr[0]];\n\n    assign m_axis_tdata = m_out_data[DATA_WIDTH-1:0];\n    assign m_axis_tkeep = m_out_data[DATA_WIDTH +: KEEP_WIDTH];\n    assign m_axis_tlast = m_out_data[DATA_WIDTH + KEEP_WIDTH];\n    assign m_axis_tid = m_out_data[DATA_WIDTH + KEEP_WIDTH + 1 +: ID_WIDTH];\n    assign m_axis_tdest = m_out_data[DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH +: DEST_WIDTH];\n    assign m_axis_tuser = m_out_data[DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH + DEST_WIDTH +: USER_WIDTH];\n\n    assign m_axis_tvalid = out_r_valid && !m_paused;\n\n    // Update read pointer\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) r_ptr <= {PTR_WIDTH{1'b0}};\n        else if (m_axis_tvalid && m_axis_tready) r_ptr <= r_ptr + 1'b1;\n    end\n\n    // Status outputs\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth;\n    assign s_status_overflow = s_frame_overflow;\n    assign s_status_bad_frame = s_frame_bad;\n    assign s_status_good_frame = s_frame_good;\n\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth;\n    assign m_status_overflow = 1'b0;\n    assign m_status_bad_frame = 1'b0;\n    assign m_status_good_frame = 1'b0;\n\nendmodule\n```<|im_end|>",
