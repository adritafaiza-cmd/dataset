  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Total data width for storage\n    localparam TOTAL_DATA_WIDTH = DATA_WIDTH + \n        (KEEP_ENABLE ? KEEP_WIDTH : 0) +\n        (LAST_ENABLE ? 1 : 0) +\n        (ID_ENABLE ? ID_WIDTH : 0) +\n        (DEST_ENABLE ? DEST_WIDTH : 0) +\n        (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Internal signals\n    reg [TOTAL_DATA_WIDTH-1:0] mem [0:DEPTH-1];\n    \n    // Write pointer (s_clk domain)\n    reg [PTR_WIDTH-1:0] w_ptr;\n    reg [ADDR_WIDTH-1:0] w_addr;\n    \n    // Read pointer (m_clk domain)\n    reg [PTR_WIDTH-1:0] r_ptr;\n    reg [ADDR_WIDTH-1:0] r_addr;\n    \n    // Synchronizers for write pointer to m_clk domain\n    reg [PTR_WIDTH-1:0] w_ptr_sync1, w_ptr_sync2, w_ptr_sync3;\n    \n    // Synchronizers for read pointer to s_clk domain\n    reg [PTR_WIDTH-1:0] r_ptr_sync1, r_ptr_sync2, r_ptr_sync3;\n    \n    // Depth calculations\n    wire [PTR_WIDTH-1:0] w_ptr_m = w_ptr_sync3;\n    wire [PTR_WIDTH-1:0] r_ptr_s = r_ptr_sync3;\n    \n    wire [PTR_WIDTH-1:0] depth_s = w_ptr - r_ptr_s;\n    wire [PTR_WIDTH-1:0] depth_m = w_ptr_m - r_ptr;\n    \n    // Full and empty conditions\n    wire s_full = (depth_s >= DEPTH);\n    wire m_empty = (depth_m == 0);\n    \n    // Pause logic\n    reg s_paused, m_paused;\n    wire s_pause_active = PAUSE_ENABLE ? (s_pause_req || s_paused) : 1'b0;\n    wire m_pause_active = PAUSE_ENABLE ? (m_pause_req || m_paused) : 1'b0;\n    \n    // Frame tracking\n    reg s_in_frame;\n    reg m_in_frame;\n    \n    // Drop/mark logic\n    wire s_drop = (DROP_WHEN_FULL && s_full) || \n                  (DROP_OVERSIZE_FRAME && s_in_frame && s_full) ||\n                  (DROP_BAD_FRAME && s_in_frame && s_full);\n    wire s_mark = (MARK_WHEN_FULL && s_full) && !s_drop;\n    \n    // Status flags\n    reg s_overflow, s_bad_frame, s_good_frame;\n    reg m_overflow, m_bad_frame, m_good_frame;\n    \n    // Write enable\n    wire s_write_en = s_axis_tvalid && s_axis_tready && !s_pause_active;\n    \n    // Read enable\n    wire m_read_en = m_axis_tvalid && m_axis_tready && !m_pause_active;\n    \n    // Output valid\n    assign m_axis_tvalid = !m_empty && !m_pause_active;\n    \n    // Input ready\n    assign s_axis_tready = !s_full && !s_pause_active;\n    \n    // Pause ack\n    assign s_pause_ack = s_paused;\n    assign m_pause_ack = m_paused;\n    \n    // Status outputs\n    assign s_status_depth = depth_s;\n    assign s_status_depth_commit = depth_s;\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame;\n    assign s_status_good_frame = s_good_frame;\n    \n    assign m_status_depth = depth_m;\n    assign m_status_depth_commit = depth_m;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame;\n    assign m_status_good_frame = m_good_frame;\n    \n    // Data packing\n    wire [TOTAL_DATA_WIDTH-1:0] s_data;\n    assign s_data = {\n        (USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}}),\n        (DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}}),\n        (ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}}),\n        (LAST_ENABLE ? s_axis_tlast : 1'b0),\n        (KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}}),\n        s_axis_tdata\n    };\n    \n    // Data unpacking\n    wire [TOTAL_DATA_WIDTH-1:0] m_data;\n    assign m_axis_tdata = m_data[DATA_WIDTH-1:0];\n    assign m_axis_tkeep = KEEP_ENABLE ? m_data[DATA_WIDTH +: KEEP_WIDTH] : {KEEP_WIDTH{1'b0}};\n    assign m_axis_tlast = LAST_ENABLE ? m_data[DATA_WIDTH + KEEP_ENABLE*KEEP_WIDTH] : 1'b0;\n    assign m_axis_tid = ID_ENABLE ? m_data[DATA_WIDTH + KEEP_ENABLE*KEEP_WIDTH + LAST_ENABLE +: ID_WIDTH] : {ID_WIDTH{1'b0}};\n    assign m_axis_tdest = DEST_ENABLE ? m_data[DATA_WIDTH + KEEP_ENABLE*KEEP_WIDTH + LAST_ENABLE + ID_ENABLE*ID_WIDTH +: DEST_WIDTH] : {DEST_WIDTH{1'b0}};\n    assign m_axis_tuser = USER_ENABLE ? m_data[DATA_WIDTH + KEEP_ENABLE*KEEP_WIDTH + LAST_ENABLE + ID_ENABLE*ID_WIDTH + DEST_ENABLE*DEST_WIDTH +: USER_WIDTH] : {USER_WIDTH{1'b0}};\n    \n    // Write pointer synchronization\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            w_ptr_sync1 <= w_ptr;\n            w_ptr_sync2 <= w_ptr_sync1;\n            w_ptr_sync3 <= w_ptr_sync2;\n        end\n    end\n    \n    // Read pointer synchronization\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            r_ptr_sync1 <= r_ptr;\n            r_ptr_sync2 <= r_ptr_sync1;\n            r_ptr_sync3 <= r_ptr_sync2;\n        end\n    end\n    \n    // Write logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_ptr <= {PTR_WIDTH{1'b0}};\n            w_addr <= {ADDR_WIDTH{1'b0}};\n            s_in_frame <= 1'b0;\n            s_overflow <= 1'b0;\n            s_bad_frame <= 1'b0;\n            s_good_frame <= 1'b0;\n            s_paused <= 1'b0;\n        end else begin\n            if (s_write_en) begin\n                mem[w_addr] <= s_data;\n                w_ptr <= w_ptr + 1'b1;\n                w_addr <= w_addr + 1'b1;\n                \n                if (LAST_ENABLE && s_axis_tlast) begin\n                    s_in_frame <= 1'b0;\n                    s_good_frame <= 1'b1;\n                end else begin\n                    s_in_frame <= 1'b1;\n                end\n            end\n            \n            if (s_pause_req) begin\n                s_paused <= 1'b1;\n            end else if (s_paused && !s_pause_req) begin\n                s_paused <= 1'b0;\n            end\n        end\n    end\n    \n    // Read logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr <= {PTR_WIDTH{1'b0}};\n            r_addr <= {ADDR_WIDTH{1'b0}};\n            m_in_frame <= 1'b0;\n            m_overflow <= 1'b0;\n            m_bad_frame <= 1'b0;\n            m_good_frame <= 1'b0;\n            m_paused <= 1'b0;\n        end else begin\n            if (m_read_en) begin\n                m_data <= mem[r_addr];\n                r_ptr <= r_ptr + 1'b1;\n                r_addr <= r_addr + 1'b1;\n                \n                if (LAST_ENABLE && m_axis_tlast) begin\n                    m_in_frame <= 1'b0;\n                    m_good_frame <= 1'b1;\n                end else begin\n                    m_in_frame <= 1'b1;\n                end\n            end\n            \n            if (m_pause_req) begin\n                m_paused <= 1'b1;\n            end else if (m_paused && !m_pause_req) begin\n                m_paused <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
