nput  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Total width of stored data\n    localparam TOTAL_DATA_WIDTH = DATA_WIDTH + \n                                  (KEEP_ENABLE ? KEEP_WIDTH : 0) +\n                                  (LAST_ENABLE ? 1 : 0) +\n                                  (ID_ENABLE ? ID_WIDTH : 0) +\n                                  (DEST_ENABLE ? DEST_WIDTH : 0) +\n                                  (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Internal signals\n    reg [TOTAL_DATA_WIDTH-1:0] mem [0:DEPTH-1];\n    \n    // Write pointer (s_clk domain)\n    reg [PTR_WIDTH-1:0] w_ptr;\n    reg [ADDR_WIDTH-1:0] w_addr;\n    \n    // Read pointer (m_clk domain)\n    reg [PTR_WIDTH-1:1] r_ptr;\n    reg [ADDR_WIDTH-1:0] r_addr;\n    \n    // CDC synchronizers for write pointer to m_clk domain\n    reg [PTR_WIDTH-1:0] w_ptr_sync1, w_ptr_sync2, w_ptr_sync3;\n    \n    // CDC synchronizers for read pointer to s_clk domain\n    reg [PTR_WIDTH-1:0] r_ptr_sync1, r_ptr_sync2, r_ptr_sync3;\n    \n    // CDC synchronizers for pause signals\n    reg s_pause_req_sync1, s_pause_req_sync2, s_pause_req_sync3;\n    reg m_pause_req_sync1, m_pause_req_sync2, m_pause_req_sync3;\n    \n    // Pause state\n    reg s_paused, m_paused;\n    \n    // Status flags\n    reg s_overflow, m_overflow;\n    reg s_bad_frame, m_bad_frame;\n    reg s_good_frame, m_good_frame;\n    \n    // Frame tracking\n    reg s_in_frame, m_in_frame;\n    reg [USER_WIDTH-1:0] s_frame_user, m_frame_user;\n    \n    // Depth calculation\n    wire [PTR_WIDTH-1:0] w_ptr_m = w_ptr_sync3;\n    wire [PTR_WIDTH-1:0] r_ptr_s = r_ptr_sync3;\n    \n    wire [PTR_WIDTH-1:0] depth_s = w_ptr - r_ptr_s;\n    wire [PTR_WIDTH-1:0] depth_m = w_ptr_m - r_ptr;\n    \n    wire s_full = (depth_s == DEPTH);\n    wire m_empty = (depth_m == 0);\n    \n    // Write enable\n    wire s_write_en = s_axis_tvalid && s_axis_tready && !s_paused;\n    \n    // Read enable\n    wire m_read_en = m_axis_tvalid && m_axis_tready && !m_paused;\n    \n    // Tready generation\n    wire s_tready_base = !s_full || DROP_WHEN_FULL;\n    assign s_axis_tready = s_tready_base && !s_paused;\n    \n    // Tvalid generation\n    assign m_axis_tvalid = !m_empty && !m_paused;\n    \n    // Data output\n    wire [TOTAL_DATA_WIDTH-1:0] r_data = mem[r_addr];\n    \n    assign m_axis_tdata = r_data[DATA_WIDTH-1:0];\n    assign m_axis_tkeep = KEEP_ENABLE ? r_data[DATA_WIDTH +: KEEP_WIDTH] : {KEEP_WIDTH{1'b0}};\n    assign m_axis_tlast = LAST_ENABLE ? r_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0)] : 1'b0;\n    assign m_axis_tid = ID_ENABLE ? r_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) +: ID_WIDTH] : {ID_WIDTH{1'b0}};\n    assign m_axis_tdest = DEST_ENABLE ? r_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) +: DEST_WIDTH] : {DEST_WIDTH{1'b0}};\n    assign m_axis_tuser = USER_ENABLE ? r_data[DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + (LAST_ENABLE ? 1 : 0) + (ID_ENABLE ? ID_WIDTH : 0) + (DEST_ENABLE ? DEST_WIDTH : 0) +: USER_WIDTH] : {USER_WIDTH{1'b0}};\n    \n    // Write data packing\n    wire [TOTAL_DATA_WIDTH-1:0] w_data;\n    assign w_data[DATA_WIDTH-1:0] = s_axis_tdata;\n    assign