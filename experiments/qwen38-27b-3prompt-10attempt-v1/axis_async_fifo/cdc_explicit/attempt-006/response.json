R_BAD_FRAME_VALUE) begin\n                        s_bad_frame <= 1'b1;\n                    end else begin\n                        s_good_frame <= 1'b1;\n                    end\n                end\n            end\n            \n            // Pause handling\n            if (PAUSE_ENABLE) begin\n                if (s_pause_req_sync3) begin\n                    s_paused <= 1'b1;\n                end else if (!s_pause_req_sync3) begin\n                    s_paused <= 1'b0;\n                end\n            end\n        end\n    end\n    \n    // Read pointer update\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr <= {PTR_WIDTH{1'b0}};\n            r_addr <= {ADDR_WIDTH{1'b0}};\n            m_overflow <= 1'b0;\n            m_bad_frame <= 1'b0;\n            m_good_frame <= 1'b0;\n            m_in_frame <= 1'b0;\n            m_frame_user <= {USER_WIDTH{1'b0}};\n            m_paused <= 1'b0;\n        end else begin\n            if (m_read_en) begin\n                r_ptr <= r_ptr + 1'b1;\n                r_addr <= r_addr + 1'b1;\n            end\n            \n            // Frame tracking on read side\n            if (m_read_en) begin\n                if (!m_in_frame) begin\n                    m_in_frame <= 1'b1;\n                    m_frame_user <= USER_ENABLE ? m_axis_tuser : {USER_WIDTH{1'b0}};\n                end\n                if (LAST_ENABLE && m_axis_tlast) begin\n                    m_in_frame <= 1'b0;\n                    if (USER_ENABLE && (m_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        m_bad_frame <= 1'b1;\n                    end else begin\n                        m_good_frame <= 1'b1;\n                    end\n                end\n            end\n            \n            // Pause handling\n            if (PAUSE_ENABLE) begin\n                if (m_pause_req_sync3) begin\n                    m_paused <= 1'b1;\n                end else if (!m_pause_req_sync3)