  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Total data width for storage\n    localparam TOTAL_DATA_WIDTH = DATA_WIDTH + \n                                  (KEEP_ENABLE ? KEEP_WIDTH : 0) +\n                                  (LAST_ENABLE ? 1 : 0) +\n                                  (ID_ENABLE ? ID_WIDTH : 0) +\n                                  (DEST_ENABLE ? DEST_WIDTH : 0) +\n                                  (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Internal signals\n    wire [TOTAL_DATA_WIDTH-1:0] s_axis_tdata_packed;\n    wire [TOTAL_DATA_WIDTH-1:0] m_axis_tdata_packed;\n\n    // Pack input data\n    assign s_axis_tdata_packed = {\n        (USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}}),\n        (DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}}),\n        (ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}}),\n        (LAST_ENABLE ? s_axis_tlast : 1'b0),\n        (KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}}),\n        s_axis_tdata\n    };\n\n    // Unpack output data\n    assign m_axis_tdata = m_axis_tdata_packed[DATA_WIDTH-1:0];\n    assign m_axis_tkeep = KEEP_ENABLE ? m_axis_tdata_packed[DATA_WIDTH + KEEP_WIDTH-1:DATA_WIDTH] : {KEEP_WIDTH{1'b0}};\n    assign m_axis_tlast = LAST_ENABLE ? m_axis_tdata_packed[DATA_WIDTH + KEEP_WIDTH] : 1'b0;\n    assign m_axis_tid = ID_ENABLE ? m_axis_tdata_packed[DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH-1:DATA_WIDTH + KEEP_WIDTH + 1] : {ID_WIDTH{1'b0}};\n    assign m_axis_tdest = DEST_ENABLE ? m_axis_tdata_packed[DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH + DEST_WIDTH-1:DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH] : {DEST_WIDTH{1'b0}};\n    assign m_axis_tuser = USER_ENABLE ? m_axis_tdata_packed[TOTAL_DATA_WIDTH-1:DATA_WIDTH + KEEP_WIDTH + 1 + ID_WIDTH + DEST_WIDTH] : {USER_WIDTH{1'b0}};\n\n    // FIFO control signals\n    wire s_wr_en;\n    wire m_rd_en;\n    wire s_full;\n    wire m_empty;\n    wire [PTR_WIDTH-1:0] s_wr_ptr;\n    wire [PTR_WIDTH-1:0] m_rd_ptr;\n    wire [ADDR_WIDTH-1:0] s_wr_addr;\n    wire [ADDR_WIDTH-1:0] m_rd_addr;\n\n    // RAM interface\n    wire [TOTAL_DATA_WIDTH-1:0] ram_dout;\n    wire [ADDR_WIDTH-1:0] ram_addr;\n    wire ram_we;\n    wire [TOTAL_DATA_WIDTH-1:0] ram_wdata;\n\n    // CDC synchronizers for write pointer\n    reg [PTR_WIDTH-1:0] m_wr_ptr_sync1;\n    reg [PTR_WIDTH-1:0] m_wr_ptr_sync2;\n    reg [PTR_WIDTH-1:0] m_wr_ptr_sync3;\n\n    // CDC synchronizers for read pointer\n    reg [PTR_WIDTH-1:0] s_rd_ptr_sync1;\n    reg [PTR_WIDTH-1:0] s_rd_ptr_sync2;\n    reg [PTR_WIDTH-1:0] s_rd_ptr_sync3;\n\n    // Write pointer in s_clk domain\n    reg [PTR_WIDTH-1:0] s_wr_ptr_reg;\n    wire [PTR_WIDTH-1:0] s_wr_ptr_next;\n    wire s_wr_ptr_inc;\n\n    // Read pointer in m_clk domain\n    reg [PTR_WIDTH-1:0] m_rd_ptr_reg;\n    wire [PTR_WIDTH-1:0] m_rd_ptr_next;\n    wire m_rd_ptr_inc;\n\n    // Status signals\n    reg s_overflow_reg;\n    reg m_overflow_reg;\n    reg s_bad_frame_reg;\n    reg m_bad_frame_reg;\n    reg s_good_frame_reg;\n    reg m_good_frame_reg;\n\n    // Pause signals\n    reg s_pause_ack_reg;\n    reg m_pause_ack_reg;\n\n    // Depth calculation\n    wire [PTR_WIDTH-1:0] s_depth;\n    wire [PTR_WIDTH-1:0] m_depth;\n\n    // Write enable\n    assign s_wr_en = s_axis_tvalid && s_axis_tready;\n    assign m_rd_en = m_axis_tvalid && m_axis_tready;\n\n    // Write pointer increment\n    assign s_wr_ptr_inc = s_wr_en;\n    assign s_wr_ptr_next = s_wr_ptr_reg + s_wr_ptr_inc;\n\n    // Read pointer increment\n    assign m_rd_ptr_inc = m_rd_en;\n    assign m_rd_ptr_next = m_rd_ptr_reg + m_rd_ptr_inc;\n\n    // Write address\n    assign s_wr_addr = s_wr_ptr_reg[ADDR_WIDTH-1:0];\n\n    // Read address\n    assign m_rd_addr = m_rd_ptr_reg[ADDR_WIDTH-1:0];\n\n    // RAM write\n    assign ram_we = s_wr_en;\n    assign ram_wdata = s_axis_tdata_packed;\n\n    // RAM read address (for pipelined RAM)\n    assign ram_addr = m_rd_addr;\n\n    // Full condition (in s_clk domain)\n    // Full when write pointer catches up to read pointer + DEPTH\n    wire [PTR_WIDTH-1:0] m_wr_ptr_synced = m_wr_ptr_sync3;\n    wire [PTR_WIDTH-1:0] s_rd_ptr_synced = s_rd_ptr_sync3;\n\n    // Depth in s_clk domain\n    assign s_depth = s_wr_ptr_reg - s_rd_ptr_synced;\n\n    // Depth in m_clk domain\n    assign m_depth = m_wr_ptr_synced - m_rd_ptr_reg;\n\n    // Full condition\n    assign s_full = (s_depth >= DEPTH);\n\n    // Empty condition\n    assign m_empty = (m_depth == 0);\n\n    // tready logic\n    wire s_tready_base;\n    wire s_tready_drop;\n    wire s_tready_mark;\n\n    assign s_tready_base = !s_full;\n    assign s_tready_drop = DROP_WHEN_FULL;\n    assign s_tready_mark = MARK_WHEN_FULL;\n\n    // If drop when full, always ready\n    // If mark when full, ready but mark overflow\n    // Otherwise, ready when not full\n    assign s_axis_tready = (DROP_WHEN_FULL || MARK_WHEN_FULL) ? 1'b1 : s_tready_base;\n\n    // tvalid logic\n    assign m_axis_tvalid = !m_empty;\n\n    // Write pointer register\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            s_wr_ptr_reg <= {PTR_WIDTH{1'b0}};\n        else\n            s_wr_ptr_reg <= s_wr_ptr_next;\n    end\n\n    // Read pointer register\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            m_rd_ptr_reg <= {PTR_WIDTH{1'b0}};\n        else\n            m_rd_ptr_reg <= m_rd_ptr_next;\n    end\n\n    // CDC synchronizer for write pointer (to m_clk domain)\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_wr_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            m_wr_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            m_wr_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            m_wr_ptr_sync1 <= s_wr_ptr_reg;\n            m_wr_ptr_sync2 <= m_wr_ptr_sync1;\n            m_wr_ptr_sync3 <= m_wr_ptr_sync2;\n        end\n    end\n\n    // CDC synchronizer for read pointer (to s_clk domain)\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_rd_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            s_rd_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            s_rd_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            s_rd_ptr_sync1 <= m_rd_ptr_reg;\n            s_rd_ptr_sync2 <= s_rd_ptr_sync1;\n            s_rd_ptr_sync3 <= s_rd_ptr_sync2;\n        end\n    end\n\n    // RAM implementation\n    reg [TOTAL_DATA_WIDTH-1:0] ram_mem [0:DEPTH-1];\n\n    // Write in s_clk domain\n    always @(posedge s_clk) begin\n        if (ram_we)\n            ram_mem[s_wr_addr] <= ram_wdata;\n    end\n\n    // Read in m_clk domain\n    // For simplicity, use a simple RAM read\n    // In a real implementation, you might use a dual-port RAM\n    always @(posedge m_clk) begin\n        if (!m_empty)\n            ram_dout <= ram_mem[m_rd_addr];\n    end\n\n    // Output data\n    assign m_axis_tdata_packed = ram_dout;\n\n    // Status signals\n    // Overflow detection\n    wire s_overflow_pulse = s_wr_en && s_full && !DROP_WHEN_FULL && !MARK_WHEN_FULL;\n    wire m_overflow_pulse = m_rd_en && m_empty;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            s_overflow_reg <= 1'b0;\n        else if (s_overflow_pulse)\n            s_overflow_reg <= 1'b1;\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            m_overflow_reg <= 1'b0;\n        else if (m_overflow_pulse)\n            m_overflow_reg <= 1'b1;\n    end\n\n    // Frame detection\n    // A frame is complete when tlast is asserted\n    wire s_frame_complete = s_wr_en && s_axis_tlast;\n    wire m_frame_complete = m_rd_en && m_axis_tlast;\n\n    // Bad frame detection (simplified)\n    wire s_bad_frame_pulse = s_frame_complete && (USER_ENABLE ? (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE : 1'b0);\n    wire m_bad_frame_pulse = m_frame_complete && (USER_ENABLE ? (m_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE : 1'b0);\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_bad_frame_reg <= 1'b0;\n            s_good_frame_reg <= 1'b0;\n        end else begin\n            if (s_bad_frame_pulse)\n                s_bad_frame_reg <= 1'b1;\n            else if (s_frame_complete)\n                s_good_frame_reg <= 1'b1;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_bad_frame_reg <= 1'b0;\n            m_good_frame_reg <= 1'b0;\n        end else begin\n            if (m_bad_frame_pulse)\n                m_bad_frame_reg <= 1'b1;\n            else if (m_frame_complete)\n                m_good_frame_reg <= 1'b1;\n        end\n    end\n\n    // Pause signals\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst)\n            s_pause_ack_reg <= 1'b0;\n        else if (PAUSE_ENABLE)\n            s_pause_ack_reg <= s_pause_req;\n        else\n            s_pause_ack_reg <= 1'b0;\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst)\n            m_pause_ack_reg <= 1'b0;\n        else if (PAUSE_ENABLE)\n            m_pause_ack_reg <= m_pause_req;\n        else\n            m_pause_ack_reg <= 1'b0;\n    end\n\n    assign s_pause_ack = s_pause_ack_reg;\n    assign m_pause_ack = m_pause_ack_reg;\n\n    // Status outputs\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth;\n    assign s_status_overflow = s_overflow_reg;\n    assign s_status_bad_frame = s_bad_frame_reg;\n    assign s_status_good_frame = s_good_frame_reg;\n\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth;\n    assign m_status_overflow = m_overflow_reg;\n    assign m_status_bad_frame = m_bad_frame_reg;\n    assign m_status_good_frame = m_good_frame_reg;\n\nendmodule\n```<|im_end|>",
