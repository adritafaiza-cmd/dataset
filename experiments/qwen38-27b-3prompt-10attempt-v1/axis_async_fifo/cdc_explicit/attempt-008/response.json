  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Total sideband width\n    localparam SIDE_WIDTH = (KEEP_ENABLE ? KEEP_WIDTH : 0) +\n                            (LAST_ENABLE ? 1 : 0) +\n                            (ID_ENABLE ? ID_WIDTH : 0) +\n                            (DEST_ENABLE ? DEST_WIDTH : 0) +\n                            (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Internal signal widths\n    localparam TOTAL_DATA_WIDTH = DATA_WIDTH + SIDE_WIDTH;\n\n    // Pack sideband into a single vector for easier handling\n    // Order: keep, last, id, dest, user\n    wire [SIDE_WIDTH-1:0] s_sideband;\n    assign s_sideband = {\n        (USER_ENABLE ? s_axis_tuser : {USER_WIDTH{1'b0}}),\n        (DEST_ENABLE ? s_axis_tdest : {DEST_WIDTH{1'b0}}),\n        (ID_ENABLE ? s_axis_tid : {ID_WIDTH{1'b0}}),\n        (LAST_ENABLE ? s_axis_tlast : 1'b0),\n        (KEEP_ENABLE ? s_axis_tkeep : {KEEP_WIDTH{1'b0}})\n    };\n\n    // Unpack sideband\n    wire [KEEP_WIDTH-1:0] m_sideband_keep;\n    wire                   m_sideband_last;\n    wire [ID_WIDTH-1:0]    m_sideband_id;\n    wire [DEST_WIDTH-1:0]  m_sideband_dest;\n    wire [USER_WIDTH-1:0]  m_sideband_user;\n\n    // We'll use a simple approach: store data and sideband separately in RAM\n    // But for CDC, we need to be careful. Let's use a standard async FIFO structure.\n\n    // Write pointer (s_clk domain)\n    reg [PTR_WIDTH-1:0] s_wr_ptr;\n    reg [PTR_WIDTH-1:0] s_wr_ptr_m; // synchronized to m_clk\n\n    // Read pointer (m_clk domain)\n    reg [PTR_WIDTH-1:0] m_rd_ptr;\n    reg [PTR_WIDTH-1:0] m_rd_ptr_s; // synchronized to s_clk\n\n    // Synchronization registers\n    reg [PTR_WIDTH-1:0] s_wr_ptr_sync1, s_wr_ptr_sync2;\n    reg [PTR_WIDTH-1:0] m_rd_ptr_sync1, m_rd_ptr_sync2;\n\n    // RAM storage\n    reg [DATA_WIDTH-1:0] ram_data [0:DEPTH-1];\n    reg [SIDE_WIDTH-1:0] ram_side [0:DEPTH-1];\n\n    // Write enable\n    wire s_wr_en;\n    wire m_rd_en;\n\n    // Full and empty detection\n    wire s_full;\n    wire m_empty;\n\n    // Depth calculation\n    wire [PTR_WIDTH-1:0] s_wr_ptr_m_sync;\n    wire [PTR_WIDTH-1:0] m_rd_ptr_s_sync;\n\n    // Synchronize write pointer to m_clk domain\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            s_wr_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            s_wr_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            s_wr_ptr_sync1 <= s_wr_ptr;\n            s_wr_ptr_sync2 <= s_wr_ptr_sync1;\n        end\n    end\n\n    // Synchronize read pointer to s_clk domain\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            m_rd_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            m_rd_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            m_rd_ptr_sync1 <= m_rd_ptr;\n            m_rd_ptr_sync2 <= m_rd_ptr_sync1;\n        end\n    end\n\n    assign s_wr_ptr_m = s_wr_ptr_sync2;\n    assign m_rd_ptr_s = m_rd_ptr_sync2;\n\n    // Full condition: write pointer has lapped read pointer by DEPTH\n    assign s_full = (s_wr_ptr[ADDR_WIDTH-1:0] == m_rd_ptr_s[ADDR_WIDTH-1:0]) &&\n                    (s_wr_ptr[ADDR_WIDTH] != m_rd_ptr_s[ADDR_WIDTH]);\n\n    // Empty condition: write pointer equals read pointer\n    assign m_empty = (s_wr_ptr_m == m_rd_ptr);\n\n    // Write logic\n    assign s_wr_en = s_axis_tvalid && s_axis_tready;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_wr_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (s_wr_en) begin\n            s_wr_ptr <= s_wr_ptr + 1'b1;\n            ram_data[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdata;\n            ram_side[s_wr_ptr[ADDR_WIDTH-1:0]] <= s_sideband;\n        end\n    end\n\n    // Read logic\n    assign m_rd_en = m_axis_tvalid && m_axis_tready;\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_rd_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (m_rd_en) begin\n            m_rd_ptr <= m_rd_ptr + 1'b1;\n        end\n    end\n\n    // Read data\n    wire [DATA_WIDTH-1:0] rd_data;\n    wire [SIDE_WIDTH-1:0] rd_side;\n    assign rd_data = ram_data[m_rd_ptr[ADDR_WIDTH-1:0]];\n    assign rd_side = ram_side[m_rd_ptr[ADDR_WIDTH-1:0]];\n\n    // Unpack sideband\n    // Order: user, dest, id, last, keep\n    wire [USER_WIDTH-1:0]   rd_user;\n    wire [DEST_WIDTH-1:0]   rd_dest;\n    wire [ID_WIDTH-1:0]     rd_id;\n    wire                     rd_last;\n    wire [KEEP_WIDTH-1:0]   rd_keep;\n\n    // Extract fields from rd_side\n    // We need to carefully slice based on enables\n    // For simplicity, let's define the offsets\n    localparam KEEP_OFF = 0;\n    localparam LAST_OFF = KEEP_OFF + (KEEP_ENABLE ? KEEP_WIDTH : 0);\n    localparam ID_OFF   = LAST_OFF + (LAST_ENABLE ? 1 : 0);\n    localparam DEST_OFF = ID_OFF + (ID_ENABLE ? ID_WIDTH : 0);\n    localparam USER_OFF = DEST_OFF + (DEST_ENABLE ? DEST_WIDTH : 0);\n\n    assign rd_keep = KEEP_ENABLE ? rd_side[KEEP_OFF + KEEP_WIDTH-1:KEEP_OFF] : {KEEP_WIDTH{1'b0}};\n    assign rd_last = LAST_ENABLE ? rd_side[LAST_OFF] : 1'b0;\n    assign rd_id   = ID_ENABLE ? rd_side[ID_OFF + ID_WIDTH-1:ID_OFF] : {ID_WIDTH{1'b0}};\n    assign rd_dest = DEST_ENABLE ? rd_side[DEST_OFF + DEST_WIDTH-1:DEST_OFF] : {DEST_WIDTH{1'b0}};\n    assign rd_user = USER_ENABLE ? rd_side[USER_OFF + USER_WIDTH-1:USER_OFF] : {USER_WIDTH{1'b0}};\n\n    // Output assignment\n    assign m_axis_tdata = rd_data;\n    assign m_axis_tkeep = rd_keep;\n    assign m_axis_tlast = rd_last;\n    assign m_axis_tid   = rd_id;\n    assign m_axis_tdest = rd_dest;\n    assign m_axis_tuser = rd_user;\n\n    // Valid and ready\n    assign m_axis_tvalid = ~m_empty;\n    assign s_axis_tready = ~s_full;\n\n    // Depth calculation\n    // s_status_depth: depth in s_clk domain\n    wire [PTR_WIDTH-1:0] s_depth_raw;\n    assign s_depth_raw = s_wr_ptr - m_rd_ptr_s;\n    assign s_status_depth = s_depth_raw[ADDR_WIDTH:0];\n\n    // m_status_depth: depth in m_clk domain\n    wire [PTR_WIDTH-1:0] m_depth_raw;\n    assign m_depth_raw = s_wr_ptr_m - m_rd_ptr;\n    assign m_status_depth = m_depth_raw[ADDR_WIDTH:0];\n\n    // Commit depth (same as depth for this simple implementation)\n    assign s_status_depth_commit = s_status_depth;\n    assign m_status_depth_commit = m_status_depth;\n\n    // Status flags\n    // Overflow: write when full\n    reg s_overflow_reg;\n    reg m_overflow_reg;\n\n    wire s_overflow_pulse = s_wr_en && s_full;\n    wire m_overflow_pulse = m_rd_en && m_empty; // This shouldn't happen, but for safety\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_overflow_reg <= 1'b0;\n        end else if (s_overflow_pulse) begin\n            s_overflow_reg <= 1'b1;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_overflow_reg <= 1'b0;\n        end else if (m_overflow_pulse) begin\n            m_overflow_reg <= 1'b1;\n        end\n    end\n\n    assign s_status_overflow = s_overflow_reg;\n    assign m_status_overflow = m_overflow_reg;\n\n    // Frame status (simplified: good frame if last beat is received, bad frame if not)\n    // For this implementation, we'll track frame completion\n    reg s_good_frame_reg;\n    reg s_bad_frame_reg;\n    reg m_good_frame_reg;\n    reg m_bad_frame_reg;\n\n    // Detect last beat in s_clk domain\n    wire s_last_beat = s_wr_en && s_axis_tlast;\n    // Detect last beat in m_clk domain\n    wire m_last_beat = m_rd_en && rd_last;\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_good_frame_reg <= 1'b0;\n            s_bad_frame_reg <= 1'b0;\n        end else if (s_last_beat) begin\n            s_good_frame_reg <= 1'b1;\n            s_bad_frame_reg <= 1'b0;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_good_frame_reg <= 1'b0;\n            m_bad_frame_reg <= 1'b0;\n        end else if (m_last_beat) begin\n            m_good_frame_reg <= 1'b1;\n            m_bad_frame_reg <= 1'b0;\n        end\n    end\n\n    assign s_status_good_frame = s_good_frame_reg;\n    assign s_status_bad_frame = s_bad_frame_reg;\n    assign m_status_good_frame = m_good_frame_reg;\n    assign m_status_bad_frame = m_bad_frame_reg;\n\n    // Pause logic\n    assign s_pause_ack = PAUSE_ENABLE ? s_pause_req : 1'b0;\n    assign m_pause_ack = PAUSE_ENABLE ? m_pause_req : 1'b0;\n\nendmodule\n```<|im_end|>",
