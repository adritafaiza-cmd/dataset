  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    wire [DATA_WIDTH-1:0] ram_data;\n    wire [KEEP_WIDTH-1:0] ram_keep;\n    wire s_axis_tlast_ram;\n    wire [ID_WIDTH-1:0] ram_tid;\n    wire [DEST_WIDTH-1:1:0] ram_tdest;\n    wire [USER_WIDTH-1:0] ram_tuser;\n\n    // Write pointer (s_clk domain)\n    reg [PTR_WIDTH-1:0] w_ptr;\n    reg [ADDR_WIDTH-1:0] w_addr;\n    reg w_valid;\n    reg w_last;\n    reg [DATA_WIDTH-1:0] w_data;\n    reg [KEEP_WIDTH-1:0] w_keep;\n    reg [ID_WIDTH-1:0] w_tid;\n    reg [DEST_WIDTH-1:0] w_tdest;\n    reg [USER_WIDTH-1:0] w_tuser;\n\n    // Read pointer (m_clk domain)\n    reg [PTR_WIDTH-1:0] r_ptr;\n    reg [ADDR_WIDTH-1:0] r_addr;\n    reg r_valid;\n    reg r_last;\n    reg [DATA_WIDTH-1:0] r_data;\n    reg [KEEP_WIDTH-1:0] r_keep;\n    reg [ID_WIDTH-1:0] r_tid;\n    reg [DEST_WIDTH-1:0] r_tdest;\n    reg [USER_WIDTH-1:0] r_tuser;\n\n    // Synchronizers\n    reg [PTR_WIDTH-1:0] w_ptr_sync1, w_ptr_sync2, w_ptr_sync3;\n    reg [PTR_WIDTH-1:0] r_ptr_sync1, r_ptr_sync2, r_ptr_sync3;\n\n    // Status flags\n    reg s_overflow;\n    reg m_overflow;\n    reg s_bad_frame;\n    reg m_bad_frame;\n    reg s_good_frame;\n    reg m_good_frame;\n\n    // Pause logic\n    reg s_paused;\n    reg m_paused;\n\n    // Frame tracking\n    reg s_in_frame;\n    reg m_in_frame;\n    reg s_frame_bad;\n    reg m_frame_bad;\n\n    // Depth calculation\n    wire [PTR_WIDTH-1:0] s_depth;\n    wire [PTR_WIDTH-1:0] m_depth;\n    wire [PTR_WIDTH-1:0] s_depth_commit;\n    wire [PTR_WIDTH-1:0] m_depth_commit;\n\n    assign s_depth = w_ptr - r_ptr_sync3;\n    assign m_depth = r_ptr - w_ptr_sync3;\n    assign s_depth_commit = w_ptr - r_ptr_sync2;\n    assign m_depth_commit = r_ptr - w_ptr_sync2;\n\n    // Synchronizer for write pointer to m_clk\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            w_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            w_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            w_ptr_sync1 <= w_ptr;\n            w_ptr_sync2 <= w_ptr_sync1;\n            w_ptr_sync3 <= w_ptr_sync2;\n        end\n    end\n\n    // Synchronizer for read pointer to s_clk\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            r_ptr_sync1 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync2 <= {PTR_WIDTH{1'b0}};\n            r_ptr_sync3 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            r_ptr_sync1 <= r_ptr;\n            r_ptr_sync2 <= r_ptr_sync1;\n            r_ptr_sync3 <= r_ptr_sync2;\n        end\n    end\n\n    // Write side logic\n    wire s_full = (s_depth == DEPTH);\n    wire s_empty = (s_depth == 0);\n\n    wire s_write_enable = s_axis_tvalid & s_axis_tready & ~s_paused;\n\n    assign s_axis_tready = (DROP_WHEN_FULL || MARK_WHEN_FULL) ? 1'b1 : ~s_full;\n\n    // Pause acknowledgment\n    assign s_pause_ack = s_paused;\n    assign m_pause_ack = m_paused;\n\n    // Pause request handling\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_paused <= 1'b0;\n        end else if (PAUSE_ENABLE) begin\n            if (s_pause_req) begin\n                s_paused <= 1'b1;\n            end else begin\n                s_paused <= 1'b0;\n            end\n        end else begin\n            s_paused <= 1'b0;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_paused <= 1'b0;\n        end else if (PAUSE_ENABLE) begin\n            if (m_pause_req) begin\n                m_paused <= 1'b1;\n            end else begin\n                m_paused <= 1'b0;\n            end\n        end else begin\n            m_paused <= 1'b0;\n        end\n    end\n\n    // Write data capture\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            w_ptr <= {PTR_WIDTH{1'b0}};\n            w_addr <= {ADDR_WIDTH{1'b0}};\n            w_valid <= 1'b0;\n            w_last <= 1'b0;\n            w_data <= {DATA_WIDTH{1'b0}};\n            w_keep <= {KEEP_WIDTH{1'b0}};\n            w_tid <= {ID_WIDTH{1'b0}};\n            w_tdest <= {DEST_WIDTH{1'b0}};\n            w_tuser <= {USER_WIDTH{1'b0}};\n            s_overflow <= 1'b0;\n            s_bad_frame <= 1'b0;\n            s_good_frame <= 1'b0;\n            s_in_frame <= 1'b0;\n            s_frame_bad <= 1'b0;\n        end else begin\n            if (s_write_enable) begin\n                w_data <= s_axis_tdata;\n                w_keep <= s_axis_tkeep;\n                w_tid <= s_axis_tid;\n                w_tdest <= s_axis_tdest;\n                w_tuser <= s_axis_tuser;\n                w_last <= s_axis_tlast;\n                w_valid <= 1'b1;\n                w_addr <= w_addr + 1'b1;\n                w_ptr <= w_ptr + 1'b1;\n\n                // Frame tracking\n                if (FRAME_FIFO) begin\n                    if (!s_in_frame) begin\n                        s_in_frame <= 1'b1;\n                        s_frame_bad <= 1'b0;\n                    end\n                    if (s_axis_tlast) begin\n                        s_in_frame <= 1'b0;\n                        // Check for bad frame\n                        if (USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                            s_frame_bad <= 1'b1;\n                        end\n                    end\n                end\n\n                // Overflow detection\n                if (s_full && !DROP_WHEN_FULL && !MARK_WHEN_FULL) begin\n                    s_overflow <= 1'b1;\n                end\n            end else begin\n                w_valid <= 1'b0;\n            end\n        end\n    end\n\n    // Read side logic\n    wire m_read_enable = m_axis_tvalid & m_axis_tready & ~m_paused;\n\n    // RAM read\n    wire [ADDR_WIDTH-1:0] ram_addr = r_addr;\n\n    // Simple RAM model\n    reg [DATA_WIDTH-1:0] ram_mem [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] ram_keep_mem [0:DEPTH-1];\n    reg ram_last_mem [0:DEPTH-1];\n    reg [ID_WIDTH-1:0] ram_tid_mem [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0] ram_tdest_mem [0:DEPTH-1];\n    reg [USER_WIDTH-1:0] ram_tuser_mem [0:DEPTH-1];\n\n    // Write to RAM\n    always @(posedge s_clk) begin\n        if (s_write_enable) begin\n            ram_mem[w_addr] <= s_axis_tdata;\n            ram_keep_mem[w_addr] <= s_axis_tkeep;\n            ram_last_mem[w_addr] <= s_axis_tlast;\n            ram_tid_mem[w_addr] <= s_axis_tid;\n            ram_tdest_mem[w_addr] <= s_axis_tdest;\n            ram_tuser_mem[w_addr] <= s_axis_tuser;\n        end\n    end\n\n    // Read from RAM\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            r_ptr <= {PTR_WIDTH{1'b0}};\n            r_addr <= {ADDR_WIDTH{1'b0}};\n            r_valid <= 1'b0;\n            r_last <= 1'b0;\n            r_data <= {DATA_WIDTH{1'b0}};\n            r_keep <= {KEEP_WIDTH{1'b0}};\n            r_tid <= {ID_WIDTH{1'b0}};\n            r_tdest <= {DEST_WIDTH{1'b0}};\n            r_tuser <= {USER_WIDTH{1'b0}};\n            m_overflow <= 1'b0;\n            m_bad_frame <= 1'b0;\n            m_good_frame <= 1'b0;\n            m_in_frame <= 1'b0;\n            m_frame_bad <= 1'b0;\n        end else begin\n            if (m_read_enable) begin\n                r_data <= ram_mem[r_addr];\n                r_keep <= ram_keep_mem[r_addr];\n                r_last <= ram_last_mem[r_addr];\n                r_tid <= ram_tid_mem[r_addr];\n                r_tdest <= ram_tdest_mem[r_addr];\n                r_tuser <= ram_tuser_mem[r_addr];\n                r_valid <= 1'b1;\n                r_addr <= r_addr + 1'b1;\n                r_ptr <= r_ptr + 1'b1;\n\n                // Frame tracking\n                if (FRAME_FIFO) begin\n                    if (!m_in_frame) begin\n                        m_in_frame <= 1'b1;\n                        m_frame_bad <= 1'b0;\n                    end\n                    if (ram_last_mem[r_addr]) begin\n                        m_in_frame <= 1'b0;\n                        // Check for bad frame\n                        if (USER_ENABLE && (ram_tuser_mem[r_addr] & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                            m_frame_bad <= 1'b1;\n                        end\n                    end\n                end\n            end else begin\n                r_valid <= 1'b0;\n            end\n        end\n    end\n\n    // Output valid\n    assign m_axis_tvalid = r_valid & ~m_paused;\n\n    // Output data\n    assign m_axis_tdata = r_data;\n    assign m_axis_tkeep = r_keep;\n    assign m_axis_tlast = r_last;\n    assign m_axis_tid = r_tid;\n    assign m_axis_tdest = r_tdest;\n    assign m_axis_tuser = r_tuser;\n\n    // Status outputs\n    assign s_status_depth = s_depth;\n    assign s_status_depth_commit = s_depth_commit;\n    assign s_status_overflow = s_overflow;\n    assign s_status_bad_frame = s_bad_frame | (FRAME_FIFO ? s_frame_bad : 1'b0);\n    assign s_status_good_frame = s_good_frame;\n\n    assign m_status_depth = m_depth;\n    assign m_status_depth_commit = m_depth_commit;\n    assign m_status_overflow = m_overflow;\n    assign m_status_bad_frame = m_bad_frame | (FRAME_FIFO ? m_frame_bad : 1'b0);\n    assign m_status_good_frame = m_good_frame;\n\nendmodule\n```<|im_end|>",
