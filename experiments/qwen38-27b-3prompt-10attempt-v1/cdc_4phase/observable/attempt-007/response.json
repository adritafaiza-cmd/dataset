  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals for the four-phase handshake\n  // req: source -> destination (request)\n  // ack: destination -> source (acknowledge)\n  //\n  // Four-phase protocol:\n  //   Idle: req=0, ack=0\n  //   Transfer: req=1, ack=0 (data valid on dst side)\n  //   Ack: req=1, ack=1 (dst has accepted, src can deassert req)\n  //   Return: req=0, ack=1 (dst deasserts ack, back to idle)\n  //\n  // We use a 2-bit encoded state for each side to track the phase.\n  // Actually, let's use a simpler approach with two 1-bit signals\n  // that are synchronized across the clock domain.\n\n  // Source side state\n  // src_req: the request signal generated by source\n  // src_ack_sync: synchronized version of dst_ack\n  //\n  // Destination side state\n  // dst_req_sync: synchronized version of src_req\n  // dst_ack: the acknowledge signal generated by destination\n\n  // Let's use a 2-bit state machine on each side.\n  // State encoding:\n  //   00: Idle (req=0, ack=0)\n  //   01: Request sent (req=1, ack=0)\n  //   10: Ack received (req=1, ack=1)\n  //   11: Return (req=0, ack=1)\n\n  // Source side\n  reg [1:0] src_state;\n  reg [WIDTH-1:0] src_data_reg;\n  wire src_req;\n  wire src_ack_sync;\n\n  // Destination side\n  reg [1:0] dst_state;\n  reg [WIDTH-1:0] dst_data_reg;\n  wire dst_req_sync;\n  wire dst_ack;\n\n  // The req signal is driven by source, synchronized to dst\n  // The ack signal is driven by dst, synchronized to src\n\n  // Source drives req based on its state\n  assign src_req = (src_state == 2'b01) || (src_state == 2'b10);\n\n  // Destination drives ack based on its state\n  assign dst_ack = (dst_state == 2'b10) || (dst_state == 2'b11);\n\n  // Synchronize src_req to dst clock domain\n  reg [1:0] req_sync_reg;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      req_sync_reg <= 2'b00;\n    else\n      req_sync_reg <= {req_sync_reg[0], src_req};\n  end\n  assign dst_req_sync = req_sync_reg[1];\n\n  // Synchronize dst_ack to src clock domain\n  reg [1:0] ack_sync_reg;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      ack_sync_reg <= 2'b00;\n    else\n      ack_sync_reg <= {ack_sync_reg[0], dst_ack};\n  end\n  assign src_ack_sync = ack_sync_reg[1];\n\n  // Source state machine\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state <= 2'b00;\n      src_data_reg <= {WIDTH{1'b0}};\n    end else begin\n      case (src_state)\n        2'b00: begin\n          // Idle: wait for valid\n          if (src_valid_i) begin\n            src_data_reg <= src_data_i;\n            src_state <= 2'b01;\n          end\n        end\n        2'b01: begin\n          // Request sent: wait for ack\n          if (src_ack_sync) begin\n            src_state <= 2'b10;\n          end\n        end\n        2'b10: begin\n          // Ack received: deassert req\n          src_state <= 2'b11;\n        end\n        2'b11: begin\n          // Return: wait for ack to deassert\n          if (!src_ack_sync) begin\n            src_state <= 2'b00;\n          end\n        end\n        default: src_state <= 2'b00;\n      endcase\n    end\n  end\n\n  // Destination state machine\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state <= 2'b00;\n      dst_data_reg <= {WIDTH{1'b0}};\n    end else begin\n      case (dst_state)\n        2'b00: begin\n          // Idle: wait for req\n          if (dst_req_sync) begin\n            dst_data_reg <= src_data_i; // This is wrong - src_data_i is in src domain\n            dst_state <= 2'b01;\n          end\n        end\n        2'b01: begin\n          // Req received: assert ack\n          dst_state <= 2'b10;\n        end\n        2'b10: begin\n          // Ack asserted: wait for req to deassert\n          if (!dst_req_sync) begin\n            dst_state <= 2'b11;\n          end\n        end\n        2'b11: begin\n          // Return: deassert ack\n          dst_state <= 2'b00;\n        end\n        default: dst_state <= 2'b00;\n      endcase\n    end\n  end\n\n  // Wait, the above approach has issues. The data needs to be transferred\n  // across the clock domain as well. Let me reconsider.\n\n  // Actually, in a four-phase handshake, the data is stable while req is high.\n  // So we can synchronize the data along with req. But data is WIDTH bits,\n  // so we need to synchronize all bits.\n\n  // Let me redo this more carefully.\n\n  // The key insight: in a four-phase handshake, the data is valid and stable\n  // while req is high. So we can use a multi-bit synchronizer for the data,\n  // but we need to ensure the data is stable before we sample it.\n\n  // A better approach: use the four-phase handshake to control when data\n  // is sampled. The data should be synchronized using a pipeline that is\n  // only updated when the handshake indicates data is valid.\n\n  // Let me use a different approach:\n  // 1. Source asserts req when it has valid data\n  // 2. Data is held stable while req is high\n  // 3. Destination synchronizes req and data\n  // 4. When dst sees req go high, it samples the synchronized data\n  // 5. Destination asserts ack\n  // 6. Source sees ack, deasserts req\n  // 7. Destination sees req deassert, deasserts ack\n\n  // For data synchronization, we can use a simple approach:\n  // Since data is stable while req is high, we can synchronize the data\n  // bits using a 2-stage synchronizer, but we need to ensure we only\n  // sample when req is stable high.\n\n  // Actually, the standard approach for four-phase CDC with data is:\n  // - Use the handshake to ensure data is stable\n  // - Synchronize the data bits along with the req signal\n  // - The data is only valid when req is high and stable\n\n  // Let me implement this properly.\n\n  // Source side\n  reg [1:0] src_state;\n  reg [WIDTH-1:0] src_data_hold;\n  wire src_req;\n\n  // Destination side\n  reg [1:0] dst_state;\n  reg [WIDTH-1:0] dst_data_hold;\n  wire dst_ack;\n\n  // Synchronize req from src to dst\n  reg [1:0] req_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      req_sync <= 2'b00;\n    else\n      req_sync <= {req_sync[0], src_req};\n  end\n  wire dst_req = req_sync[1];\n\n  // Synchronize ack from dst to src\n  reg [1:0] ack_sync;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      ack_sync <= 2'b00;\n    else\n      ack_sync <= {ack_sync[0], dst_ack};\n  end\n  wire src_ack = ack_sync[1];\n\n  // Synchronize data from src to dst\n  // Data is stable while req is high, so we can synchronize it\n  reg [WIDTH-1:0] data_sync1;\n  reg [WIDTH-1:0] data_sync2;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      data_sync1 <= {WIDTH{1'b0}};\n      data_sync2 <= {WIDTH{1'b0}};\n    end else begin\n      data_sync1 <= src_data_hold;\n      data_sync2 <= data_sync1;\n    end\n  end\n\n  // Source state machine\n  assign src_req = (src_state == 2'b01) || (src_state == 2'b10);\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state <= 2'b00;\n      src_data_hold <= {WIDTH{1'b0}};\n    end else begin\n      case (src_state)\n        2'b00: begin\n          if (src_valid_i) begin\n            src_data_hold <= src_data_i;\n            src_state <= 2'b01;\n          end\n        end\n        2'b01: begin\n          if (src_ack)\n            src_state <= 2'b10;\n        end\n        2'b10: begin\n          src_state <= 2'b11;\n        end\n        2'b11: begin\n          if (!src_ack)\n            src_state <= 2'b00;\n        end\n        default: src_state <= 2'b00;\n      endcase\n    end\n  end\n\n  // Destination state machine\n  assign dst_ack = (dst_state == 2'b10) || (dst_state == 2'b11);\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state <= 2'b00;\n      dst_data_hold <= {WIDTH{1'b0}};\n    end else begin\n      case (dst_state)\n        2'b00: begin\n          if (dst_req) begin\n            dst_data_hold <= data_sync2;\n            dst_state <= 2'b01;\n          end\n        end\n        2'b01: begin\n          dst_state <= 2'b10;\n        end\n        2'b10: begin\n          if (!dst_req)\n            dst_state <= 2'b11;\n        end\n        2'b11: begin\n          dst_state <= 2'b00;\n        end\n        default: dst_state <= 2'b00;\n      endcase\n    end\n  end\n\n  // Outputs\n  assign src_ready_o = (src_state == 2'b00);\n  assign dst_valid_o = (dst_state == 2'b01) || (dst_state == 2'b10);\n  assign dst_data_o = dst_data_hold;\n\nendmodule\n```<|im_end|>",
