  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire [WIDTH-1:0] src_data_reg;\n  wire src_valid_reg;\n  wire src_ready_int;\n  wire dst_valid_reg;\n  wire dst_ready_int;\n  wire [WIDTH-1:0] dst_data_reg;\n\n  // Source side: register data and valid, generate ready\n  // Destination side: register valid and data, generate ready\n\n  // We use a 4-phase handshake:\n  // Phase 1: src_valid rises (data valid)\n  // Phase 2: dst_ready rises (acknowledge)\n  // Phase 3: src_valid falls (deassert valid)\n  // Phase 4: dst_ready falls (deassert ready)\n\n  // For CDC, we need to synchronize the handshake signals.\n  // The data is transferred when both src_valid and dst_ready are high.\n\n  // Let's implement a simple 4-phase handshake with CDC.\n  // We'll use a 2-stage synchronizer for each signal crossing.\n\n  // Source to destination: src_valid, src_data\n  // Destination to source: dst_ready\n\n  // Synchronizers\n  wire [1:0] src_valid_sync;\n  wire [WIDTH-1:0] src_data_sync;\n  wire [1:0] dst_ready_sync;\n\n  // Synchronize src_valid to dst domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_valid_sync <= 2'b00;\n    else\n      src_valid_sync <= {src_valid_sync[0], src_valid_reg};\n  end\n\n  // Synchronize src_data to dst domain (data is stable when valid is high)\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_data_sync <= {WIDTH{1'b0}};\n    else\n      src_data_sync <= src_data_reg;\n  end\n\n  // Synchronize dst_ready to src domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_ready_sync <= 2'b00;\n    else\n      dst_ready_sync <= {dst_ready_sync[0], dst_ready_int};\n  end\n\n  // Source side logic\n  // src_ready_o is high when we can accept new data\n  // We can accept new data when the previous transfer is complete\n  // i.e., when dst_ready is high (synchronized)\n\n  // For 4-phase: \n  // - When src_valid is low and dst_ready is low: idle, can accept new data\n  // - When src_valid is high and dst_ready is low: waiting for ack\n  // - When src_valid is high and dst_ready is high: transfer in progress\n  // - When src_valid is low and dst_ready is high: deasserting valid\n\n  // Let's use a state machine approach\n  // States: IDLE, WAIT_ACK, DEASSERT_VALID, WAIT_DEASSERT\n\n  localparam [1:0] ST_IDLE = 2'b00;\n  localparam [1:0] ST_WAIT_ACK = 2'b01;\n  localparam [1:0] ST_DEASSERT_VALID = 2'b10;\n  localparam [1:0] ST_WAIT_DEASSERT = 2'b11;\n\n  reg [1:0] src_state;\n  reg [WIDTH-1:0] src_data_latch;\n  reg src_valid_latch;\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state <= ST_IDLE;\n      src_data_latch <= {WIDTH{1'b0}};\n      src_valid_latch <= 1'b0;\n    end else begin\n      case (src_state)\n        ST_IDLE: begin\n          if (src_valid_i) begin\n            src_data_latch <= src_data_i;\n            src_valid_latch <= 1'b1;\n            src_state <= ST_WAIT_ACK;\n          end\n        end\n        ST_WAIT_ACK: begin\n          if (dst_ready_sync[1]) begin\n            src_state <= ST_DEASSERT_VALID;\n          end\n        end\n        ST_DEASSERT_VALID: begin\n          src_valid_latch <= 1'b0;\n          src_state <= ST_WAIT_DEASSERT;\n        end\n        ST_WAIT_DEASSERT: begin\n          if (!dst_ready_sync[1]) begin\n            src_state <= ST_IDLE;\n          end\n        end\n        default: src_state <= ST_IDLE;\n      endcase\n    end\n  end\n\n  assign src_ready_o = (src_state == ST_IDLE);\n  assign src_valid_reg = src_valid_latch;\n  assign src_data_reg = src_data_latch;\n\n  // Destination side logic\n  // dst_valid_o is high when data is available\n  // dst_ready_int is generated based on dst_ready_i and internal state\n\n  localparam [1:0] DST_IDLE = 2'b00;\n  localparam [1:0] DST_WAIT_DATA = 2'b01;\n  localparam [1:0] DST_ACK = 2'b10;\n  localparam [1:0] DST_WAIT_DEASSERT = 2'b11;\n\n  reg [1:0] dst_state;\n  reg [WIDTH-1:0] dst_data_latch;\n  reg dst_valid_latch;\n  reg dst_ready_latch;\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state <= DST_IDLE;\n      dst_data_latch <= {WIDTH{1'b0}};\n      dst_valid_latch <= 1'b0;\n      dst_ready_latch <= 1'b0;\n    end else begin\n      case (dst_state)\n        DST_IDLE: begin\n          if (src_valid_sync[1]) begin\n            dst_data_latch <= src_data_sync;\n            dst_valid_latch <= 1'b1;\n            dst_ready_latch <= 1'b1;\n            dst_state <= DST_ACK;\n          end\n        end\n        DST_ACK: begin\n          if (dst_ready_i) begin\n            dst_state <= DST_WAIT_DEASSERT;\n          end\n        end\n        DST_WAIT_DEASSERT: begin\n          dst_valid_latch <= 1'b0;\n          dst_ready_latch <= 1'b0;\n          dst_state <= DST_IDLE;\n        end\n        default: dst_state <= DST_IDLE;\n      endcase\n    end\n  end\n\n  assign dst_valid_o = dst_valid_latch;\n  assign dst_data_o = dst_data_latch;\n  assign dst_ready_int = dst_ready_latch;\n\nendmodule\n```<|im_end|>",
