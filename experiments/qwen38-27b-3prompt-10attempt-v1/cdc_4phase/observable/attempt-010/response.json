  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals for the four-phase handshake\n  // req: source -> destination (data valid request)\n  // ack: destination -> source (acknowledge)\n  wire req;\n  wire ack;\n\n  // Source side: generate req and accept ack\n  // Destination side: accept req and generate ack\n\n  // We use a 2-bit Gray-coded or binary counter? For four-phase, we use two separate signals.\n  // req is driven by source, sampled by destination.\n  // ack is driven by destination, sampled by source.\n\n  // Source side logic\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_valid_reg;\n  reg src_ready_reg;\n  reg req_reg;\n  reg ack_reg;\n\n  // Destination side logic\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n  reg dst_ready_reg;\n  reg req_reg_dst;\n  reg ack_reg_dst;\n\n  // Synchronize req from source to destination\n  reg [1:0] req_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      req_sync <= 2'b00;\n    else\n      req_sync <= {req_sync[0], req};\n  end\n  wire req_dst = req_sync[1];\n\n  // Synchronize ack from destination to source\n  reg [1:0] ack_sync;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      ack_sync <= 2'b00;\n    else\n      ack_sync <= {ack_sync[0], ack};\n  end\n  wire ack_src = ack_sync[1];\n\n  // Source side state machine\n  // States: IDLE, WAIT_ACK\n  // In IDLE: if src_valid_i and src_ready_o, capture data, assert req, go to WAIT_ACK\n  // In WAIT_ACK: wait for ack_src, then deassert req, go to IDLE\n\n  reg src_state;\n  localparam SRC_IDLE = 1'b0;\n  localparam SRC_WAIT_ACK = 1'b1;\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state <= SRC_IDLE;\n      req_reg <= 1'b0;\n      ack_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n      src_data_reg <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n    end else begin\n      case (src_state)\n        SRC_IDLE: begin\n          req_reg <= 1'b0;\n          ack_reg <= 1'b0;\n          if (src_valid_i) begin\n            src_data_reg <= src_data_i;\n            src_valid_reg <= 1'b1;\n            req_reg <= 1'b1;\n            src_ready_reg <= 1'b0;\n            src_state <= SRC_WAIT_ACK;\n          end else begin\n            src_ready_reg <= 1'b1;\n          end\n        end\n        SRC_WAIT_ACK: begin\n          if (ack_src) begin\n            req_reg <= 1'b0;\n            ack_reg <= 1'b1;\n            src_ready_reg <= 1'b1;\n            src_valid_reg <= 1'b0;\n            src_state <= SRC_IDLE;\n          end else begin\n            // Stay in WAIT_ACK\n          end\n        end\n        default: begin\n          src_state <= SRC_IDLE;\n          req_reg <= 1'b0;\n          ack_reg <= 1'b0;\n          src_ready_reg <= 1'b1;\n        end\n      endcase\n    end\n  end\n\n  assign src_ready_o = src_ready_reg;\n  assign req = req_reg;\n\n  // Destination side state machine\n  // States: IDLE, WAIT_ACK\n  // In IDLE: if req_dst, capture data, assert ack, go to WAIT_ACK\n  // In WAIT_ACK: wait for dst_ready_i, then deassert ack, go to IDLE\n\n  reg dst_state;\n  localparam DST_IDLE = 1'b0;\n  localparam DST_WAIT_ACK = 1'b1;\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state <= DST_IDLE;\n      ack_reg_dst <= 1'b0;\n      req_reg_dst <= 1'b0;\n      dst_valid_reg <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n    end else begin\n      case (dst_state)\n        DST_IDLE: begin\n          ack_reg_dst <= 1'b0;\n          req_reg_dst <= 1'b0;\n          if (req_dst) begin\n            dst_data_reg <= src_data_reg; // This is wrong, we need to capture the data from source\n            dst_valid_reg <= 1'b1;\n            ack_reg_dst <= 1'b1;\n            dst_state <= DST_WAIT_ACK;\n          end\n        end\n        DST_WAIT_ACK: begin\n          if (dst_ready_i) begin\n            ack_reg_dst <= 1'b0;\n            req_reg_dst <= 1'b0;\n            dst_valid_reg <= 1'b0;\n            dst_state <= DST_IDLE;\n          end\n        end\n        default: begin\n          dst_state <= DST_IDLE;\n          ack_reg_dst <= 1'b0;\n          req_reg_dst <= 1'b0;\n          dst_valid_reg <= 1'b0;\n        end\n      endcase\n    end\n  end\n\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_data_o = dst_data_reg;\n  assign ack = ack_reg_dst;\n\nendmodule\n```<|im_end|>",
