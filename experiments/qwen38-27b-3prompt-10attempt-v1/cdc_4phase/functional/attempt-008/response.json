  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_valid_reg;\n  reg             src_ready_int;\n  reg             src_ack_reg;\n\n  // Destination domain signals\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_valid_reg;\n  reg             dst_ack_reg;\n\n  // CDC synchronizers\n  reg [1:0] src_valid_sync;\n  reg [1:0] src_ack_sync;\n  reg [1:0] dst_ack_sync;\n\n  // Source domain: synchronizer for dst_ack\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_ack_sync <= 2'b00;\n    end else begin\n      dst_ack_sync <= {dst_ack_sync[0], dst_ack_reg};\n    end\n  end\n\n  // Destination domain: synchronizer for src_valid\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_valid_sync <= 2'b00;\n    end else begin\n      src_valid_sync <= {src_valid_sync[0], src_valid_reg};\n    end\n  end\n\n  // Source domain: synchronizer for src_ack (from dst)\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ack_sync <= 2'b00;\n    end else begin\n      src_ack_sync <= {src_ack_sync[0], dst_ack_reg};\n    end\n  end\n\n  // Destination domain: synchronizer for dst_ack (to src)\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_ack_sync <= 2'b00;\n    end else begin\n      src_ack_sync <= {src_ack_sync[0], src_ack_reg};\n    end\n  end\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg  <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_ready_int <= 1'b1;\n      src_ack_reg   <= 1'b0;\n    end else begin\n      // Check if destination has acknowledged\n      if (src_ack_sync[1]) begin\n        // Destination acknowledged, clear valid and set ready\n        src_valid_reg <= 1'b0;\n        src_ready_int <= 1'b1;\n        src_ack_reg   <= 1'b0;\n      end else if (src_valid_reg) begin\n        // Valid is high, wait for ack\n        // src_ready_int stays low\n      end else begin\n        // Not valid, can accept new data\n        if (src_valid_i) begin\n          src_data_reg  <= src_data_i;\n          src_valid_reg <= 1'b1;\n          src_ready_int <= 1'b0;\n        end else begin\n          src_ready_int <= 1'b1;\n        end\n      end\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= SEND_RESET_MSG ? RESET_MSG : {WIDTH{1'b0}};\n      dst_valid_reg <= SEND_RESET_MSG ? 1'b1 : 1'b0;\n      dst_ack_reg   <= 1'b0;\n    end else begin\n      if (dst_valid_reg) begin\n        if (dst_ready_i) begin\n          // Handshake complete, acknowledge to source\n          dst_ack_reg   <= 1'b1;\n          dst_valid_reg <= 1'b0;\n        end else begin\n          // Wait for ready\n          dst_ack_reg <= 1'b0;\n        end\n      end else begin\n        // Not valid, check if source has new data\n        if (src_valid_sync[1]) begin\n          dst_data_reg  <= src_data_reg;\n          dst_valid_reg <= 1'b1;\n          dst_ack_reg   <= 1'b0;\n        end else begin\n          dst_ack_reg <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // Output assignments\n  assign src_ready_o = src_ready_int;\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
