  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_valid_reg;\n  reg             src_ready_reg;\n  reg             src_ack_reg;\n\n  // Destination domain signals\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_valid_reg;\n  reg             dst_ack_reg;\n\n  // CDC synchronizers for valid signal (src -> dst)\n  reg [2:0] valid_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      valid_sync <= 3'b000;\n    else\n      valid_sync <= {valid_sync[1:0], src_valid_reg};\n  end\n\n  // CDC synchronizers for ack signal (dst -> src)\n  reg [2:0] ack_sync;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      ack_sync <= 3'b000;\n    else\n      ack_sync <= {ack_sync[1:0], dst_ack_reg};\n  end\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg  <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n      src_ack_reg   <= 1'b0;\n    end else begin\n      // Track ack from destination\n      src_ack_reg <= ack_sync[2];\n\n      if (src_valid_i && src_ready_reg) begin\n        // Accept new data\n        src_data_reg  <= src_data_i;\n        src_valid_reg <= 1'b1;\n        src_ready_reg <= 1'b0;\n      end else if (src_valid_reg && src_ack_reg) begin\n        // Previous transfer completed\n        src_valid_reg <= 1'b0;\n        src_ready_reg <= 1'b1;\n      end\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n      dst_ack_reg   <= 1'b0;\n    end else begin\n      if (valid_sync[2] && !dst_valid_reg) begin\n        // New valid from source\n        dst_data_reg  <= src_data_reg;\n        dst_valid_reg <= 1'b1;\n        dst_ack_reg   <= 1'b0;\n      end else if (dst_valid_reg && dst_ready_i) begin\n        // Destination accepted\n        dst_valid_reg <= 1'b0;\n        dst_ack_reg   <= 1'b1;\n      end\n    end\n  end\n\n  // Outputs\n  assign src_ready_o = src_ready_reg;\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
