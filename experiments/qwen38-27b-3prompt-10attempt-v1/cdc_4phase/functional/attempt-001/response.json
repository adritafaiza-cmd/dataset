  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire [WIDTH-1:0] src_data_reg;\n  wire src_valid_reg;\n  wire src_ready_int;\n  wire dst_valid_int;\n  wire [WIDTH-1:0] dst_data_int;\n  wire dst_ready_int;\n\n  // Source domain: register data and valid when handshake occurs\n  // Destination domain: register data and valid when handshake occurs\n\n  // We use a 4-phase handshake:\n  // Phase 1: src_valid=1, src_ready=0 -> src_ready goes to 1\n  // Phase 2: src_valid=1, src_ready=1 -> data transferred, src_valid goes to 0\n  // Phase 3: src_valid=0, src_ready=1 -> src_ready goes to 0\n  // Phase 4: src_valid=0, src_ready=0 -> idle\n\n  // For CDC, we need to synchronize the handshake signals.\n  // The standard approach is to use a 2-phase or 4-phase handshake with proper synchronization.\n\n  // Let's implement a proper 4-phase handshake with CDC.\n  // Source side:\n  // - src_valid_i is the input valid\n  // - src_ready_o is the output ready\n  // - When both are high, data is accepted\n\n  // Destination side:\n  // - dst_valid_o is the output valid\n  // - dst_ready_i is the input ready\n  // - When both are high, data is consumed\n\n  // For CDC, we'll use a simple approach:\n  // 1. Source registers data and valid\n  // 2. Destination registers data and valid\n  // 3. Use synchronized handshake signals\n\n  // Let's use a different approach: a simple FIFO-like structure with handshake.\n\n  // Actually, let's implement a proper 4-phase handshake with CDC using\n  // synchronized request and acknowledge signals.\n\n  // Source domain signals\n  reg [WIDTH-1:0] src_data_r;\n  reg src_valid_r;\n  reg src_ready_r;\n\n  // Destination domain signals\n  reg [WIDTH-1:0] dst_data_r;\n  reg dst_valid_r;\n  reg dst_ready_r;\n\n  // Synchronization signals\n  // req: source to destination\n  // ack: destination to source\n\n  reg req_src;\n  reg ack_dst;\n\n  // Synchronized versions\n  reg [1:0] req_sync;\n  reg [1:0] ack_sync;\n\n  // Source domain: generate req when valid and ready\n  // Destination domain: generate ack when valid and ready\n\n  // Let's think about this more carefully.\n\n  // A simpler approach: use a 2-stage synchronizer for each direction.\n  // Source sends data and a \"send\" signal.\n  // Destination receives data and a \"send\" signal, then sends back an \"ack\".\n  // Source waits for ack before accepting new data.\n\n  // For DECOUPLED=1, we can pipeline this.\n\n  // Let's implement a basic version first.\n\n  // Source domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_r <= {WIDTH{1'b0}};\n      src_valid_r <= 1'b0;\n      src_ready_r <= 1'b0;\n      req_src <= 1'b0;\n    end else begin\n      // If not valid and ready is low, we can accept new data\n      if (!src_valid_r && !src_ready_r) begin\n        // Idle state\n        if (src_valid_i) begin\n          src_data_r <= src_data_i;\n          src_valid_r <= 1'b1;\n          req_src <= 1'b1;\n        end\n      end else if (src_valid_r && !src_ready_r) begin\n        // Waiting for ready\n        if (ack_sync[1]) begin\n          src_ready_r <= 1'b1;\n        end\n      end else if (src_valid_r && src_ready_r) begin\n        // Handshake complete, clear valid\n        src_valid_r <= 1'b0;\n        req_src <= 1'b0;\n        src_ready_r <= 1'b0;\n      end else if (!src_valid_r && src_ready_r) begin\n        // Clear ready\n        src_ready_r <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize req to destination domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync <= 2'b00;\n    end else begin\n      req_sync <= {req_sync[0], req_src};\n    end\n  end\n\n  // Synchronize ack to source domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync <= 2'b00;\n    end else begin\n      ack_sync <= {ack_sync[0], ack_dst};\n    end\n  end\n\n  // Destination domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_r <= {WIDTH{1'b0}};\n      dst_valid_r <= 1'b0;\n      dst_ready_r <= 1'b0;\n      ack_dst <= 1'b0;\n    end else begin\n      if (!dst_valid_r && !dst_ready_r) begin\n        // Idle state\n        if (req_sync[1]) begin\n          dst_data_r <= src_data_r;\n          dst_valid_r <= 1'b1;\n          ack_dst <= 1'b1;\n        end\n      end else if (dst_valid_r && !dst_ready_r) begin\n        // Waiting for ready\n        if (dst_ready_i) begin\n          dst_ready_r <= 1'b1;\n        end\n      end else if (dst_valid_r && dst_ready_r) begin\n        // Handshake complete, clear valid\n        dst_valid_r <= 1'b0;\n        ack_dst <= 1'b0;\n        dst_ready_r <= 1'b0;\n      end else if (!dst_valid_r && dst_ready_r) begin\n        // Clear ready\n        dst_ready_r <= 1'b0;\n      end\n    end\n  end\n\n  // Outputs\n  assign src_ready_o = src_ready_r;\n  assign dst_data_o = dst_data_r;\n  assign dst_valid_o = dst_valid_r;\n\nendmodule\n```<|im_end|>",
