  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Four-phase handshake signals\n  // req: source to destination (request)\n  // ack: destination to source (acknowledge)\n  // Each is synchronized across the clock domain boundary.\n\n  // Source domain: req generation\n  // Destination domain: ack generation\n\n  // We use a 4-phase handshake:\n  // Idle: req=0, ack=0\n  // Phase 1: req=1, ack=0 (source asserts req)\n  // Phase 2: req=1, ack=1 (destination asserts ack)\n  // Phase 3: req=0, ack=1 (source deasserts req)\n  // Phase 4: req=0, ack=0 (destination deasserts ack) -> back to idle\n\n  // Source domain registers\n  reg src_req;\n  reg src_ack;\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_valid_reg;\n  reg src_ready_int;\n\n  // Destination domain registers\n  reg dst_req;\n  reg dst_ack;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n\n  // Synchronization of req from source to destination\n  reg [2:0] req_sync;\n  wire req_dst = req_sync[2];\n\n  // Synchronization of ack from destination to source\n  reg [2:0] ack_sync;\n  wire ack_src = ack_sync[2];\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_req <= 1'b0;\n      src_ack <= 1'b0;\n      src_data_reg <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_ready_int <= 1'b1;\n    end else begin\n      // Four-phase handshake in source domain\n      // State is determined by src_req and src_ack\n      // Idle: src_req=0, src_ack=0\n      // Phase 1: src_req=1, src_ack=0\n      // Phase 2: src_req=1, src_ack=1\n      // Phase 3: src_req=0, src_ack=1\n\n      if (src_req == 1'b0 && src_ack == 1'b0) begin\n        // Idle state\n        if (src_valid_i) begin\n          // Accept new item\n          src_req <= 1'b1;\n          src_data_reg <= src_data_i;\n          src_valid_reg <= 1'b1;\n          src_ready_int <= 1'b0;\n        end else begin\n          src_ready_int <= 1'b1;\n        end\n      end else if (src_req == 1'b1 && src_ack == 1'b0) begin\n        // Phase 1: waiting for ack\n        src_ready_int <= 1'b0;\n        if (ack_src) begin\n          // Move to phase 2\n          src_ack <= 1'b1;\n        end\n      end else if (src_req == 1'b1 && src_ack == 1'b1) begin\n        // Phase 2: waiting to deassert req\n        src_ready_int <= 1'b0;\n        src_req <= 1'b0;\n      end else if (src_req == 1'b0 && src_ack == 1'b1) begin\n        // Phase 3: waiting for ack to deassert\n        src_ready_int <= 1'b0;\n        if (!ack_src) begin\n          // Back to idle\n          src_ack <= 1'b0;\n          src_ready_int <= 1'b1;\n        end\n      end\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_req <= 1'b0;\n      dst_ack <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n    end else begin\n      // Four-phase handshake in destination domain\n      // State is determined by dst_req and dst_ack\n      // Idle: dst_req=0, dst_ack=0\n      // Phase 1: dst_req=1, dst_ack=0\n      // Phase 2: dst_req=1, dst_ack=1\n      // Phase 3: dst_req=0, dst_ack=1\n\n      if (dst_req == 1'b0 && dst_ack == 1'b0) begin\n        // Idle state\n        if (req_dst) begin\n          // Move to phase 1\n          dst_req <= 1'b1;\n          dst_valid_reg <= 1'b1;\n        end\n      end else if (dst_req == 1'b1 && dst_ack == 1'b0) begin\n        // Phase 1: waiting to assert ack\n        dst_ack <= 1'b1;\n      end else if (dst_req == 1'b1 && dst_ack == 1'b1) begin\n        // Phase 2: waiting for req to deassert\n        if (!req_dst) begin\n          // Move to phase 3\n          dst_req <= 1'b0;\n        end\n      end else if (dst_req == 1'b0 && dst_ack == 1'b1) begin\n        // Phase 3: waiting to deassert ack\n        dst_ack <= 1'b0;\n        dst_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize req from source to destination\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync <= 3'b000;\n    end else begin\n      req_sync <= {req_sync[1:0], src_req};\n    end\n  end\n\n  // Synchronize ack from destination to source\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync <= 3'b000;\n    end else begin\n      ack_sync <= {ack_sync[1:0], dst_ack};\n    end\n  end\n\n  // Data path: capture data when req is asserted in destination domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg <= {WIDTH{1'b0}};\n    end else begin\n      if (req_dst && !dst_req) begin\n        // Capture data when new request arrives\n        dst_data_reg <= src_data_reg;\n      end\n    end\n  end\n\n  // Outputs\n  assign src_ready_o = src_ready_int;\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
