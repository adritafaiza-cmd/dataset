  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire [WIDTH-1:0] src_data_reg;\n  wire src_valid_reg;\n  wire src_ready_int;\n  wire dst_valid_int;\n  wire [WIDTH-1:0] dst_data_int;\n  wire dst_ready_int;\n\n  // Source domain: register data and valid when handshake occurs\n  // Destination domain: register data and valid when handshake occurs\n\n  // We use a 4-phase handshake:\n  // Phase 1: src_valid high, src_ready low -> data stable\n  // Phase 2: src_valid high, src_ready high -> transfer accepted\n  // Phase 3: src_valid low, src_ready high -> source deasserts valid\n  // Phase 4: src_valid low, src_ready low -> ready deasserts, back to idle\n\n  // For CDC, we need to synchronize the handshake signals.\n  // The key insight: we can use a simple approach where:\n  // - Source holds data and valid until destination acknowledges\n  // - Destination samples data when it sees valid, then acknowledges\n  // - Source deasserts valid when it sees acknowledgment\n  // - Destination deasserts valid when it sees source deasserted valid\n\n  // Let's use a different approach: a simple FIFO-like structure with\n  // a single entry buffer and 4-phase handshake.\n\n  // Source side:\n  // - When src_valid_i && src_ready_o, capture data\n  // - Hold data and valid until dst_ack comes back\n  // - When dst_ack, deassert valid, then deassert ready\n\n  // Destination side:\n  // - When src_valid_synced, capture data, assert dst_valid\n  // - When dst_valid && dst_ready_i, deassert dst_valid, assert dst_ack\n  // - When src_valid_synced deasserts, deassert dst_ack\n\n  // Synchronization:\n  // - src_valid -> dst domain: 2-FF synchronizer\n  // - dst_ack -> src domain: 2-FF synchronizer\n  // - Data: must be stable while src_valid is high, so we can use a\n  //   multi-bit synchronizer or ensure data is stable. Since data is\n  //   stable while src_valid is high, we can sample it in the dst domain\n  //   when src_valid_synced is high.\n\n  // Let's implement this:\n\n  // Source domain registers\n  reg [WIDTH-1:0] src_data_hold;\n  reg src_valid_hold;\n  reg src_ready_hold;\n  reg dst_ack_synced;\n\n  // Destination domain registers\n  reg [WIDTH-1:0] dst_data_hold;\n  reg dst_valid_hold;\n  reg dst_ack_hold;\n  reg src_valid_synced;\n\n  // Synchronizers\n  // src_valid to dst domain\n  reg [1:0] src_valid_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_valid_sync <= 2'b00;\n    else\n      src_valid_sync <= {src_valid_sync[0], src_valid_hold};\n  end\n  assign src_valid_synced = src_valid_sync[1];\n\n  // dst_ack to src domain\n  reg [1:0] dst_ack_sync;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_ack_sync <= 2'b00;\n    else\n      dst_ack_sync <= {dst_ack_sync[0], dst_ack_hold};\n  end\n  assign dst_ack_synced = dst_ack_sync[1];\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_hold <= {WIDTH{1'b0}};\n      src_valid_hold <= 1'b0;\n      src_ready_hold <= 1'b0;\n    end else begin\n      if (src_valid_hold) begin\n        // Valid is high\n        if (dst_ack_synced) begin\n          // Ack received, deassert valid\n          src_valid_hold <= 1'b0;\n          src_ready_hold <= 1'b0;\n        end\n      end else begin\n        // Valid is low\n        if (src_valid_i) begin\n          // New valid from source\n          src_data_hold <= src_data_i;\n          src_valid_hold <= 1'b1;\n          src_ready_hold <= 1'b1;\n        end else if (src_ready_hold) begin\n          // Ready was high, deassert it\n          src_ready_hold <= 1'b0;\n        end\n      end\n    end\n  end\n\n  assign src_ready_o = src_ready_hold;\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_hold <= {WIDTH{1'b0}};\n      dst_valid_hold <= 1'b0;\n      dst_ack_hold <= 1'b0;\n    end else begin\n      if (dst_valid_hold) begin\n        // Valid is high\n        if (dst_ready_i) begin\n          // Handshake complete, deassert valid, assert ack\n          dst_valid_hold <= 1'b0;\n          dst_ack_hold <= 1'b1;\n        end\n      end else begin\n        // Valid is low\n        if (src_valid_synced) begin\n          // New valid from source, capture data\n          dst_data_hold <= src_data_hold;\n          dst_valid_hold <= 1'b1;\n          dst_ack_hold <= 1'b0;\n        end else if (dst_ack_hold) begin\n          // Ack was high, deassert it\n          dst_ack_hold <= 1'b0;\n        end\n      end\n    end\n  end\n\n  assign dst_data_o = dst_data_hold;\n  assign dst_valid_o = dst_valid_hold;\n\nendmodule\n```<|im_end|>",
