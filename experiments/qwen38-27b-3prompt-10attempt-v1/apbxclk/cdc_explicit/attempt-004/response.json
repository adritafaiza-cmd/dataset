  "text": "```verilog\nmodule apbxclk #(\n\tparameter\tC_APB_ADDR_WIDTH = 12,\n\tparameter\tC_APB_DATA_WIDTH = 32,\n\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\tlocalparam\tDW = C_APB_DATA_WIDTH\n) (\n\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\tinput\twire\t\t\tS_APB_PSEL,\n\tinput\twire\t\t\tS_APB_PENABLE,\n\toutput\treg\t\t\tS_APB_PREADY,\n\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\tinput\twire\t\t\tS_APB_PWRITE,\n\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\toutput\twire\t\t\tS_APB_PSLVERR,\n\tinput\twire\t\t\tM_APB_PCLK,\n\toutput\treg\t\t\tM_PRESETn,\n\toutput\treg\t\t\tM_APB_PSEL,\n\toutput\treg\t\t\tM_APB_PENABLE,\n\tinput\twire\t\t\tM_APB_PREADY,\n\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\toutput\twire\t\t\tM_APB_PWRITE,\n\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\tinput\twire\t\t\tM_APB_PSLVERR\n);\n\n\t// ------------------------------------------------------------------\n\t// Reset synchronization for M_APB_PCLK domain\n\t// ------------------------------------------------------------------\n\treg [1:0] m_reset_sync;\n\treg       m_reset_active;\n\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_reset_sync   <= 2'b00;\n\t\t\tm_reset_active <= 1'b1;\n\t\tend else begin\n\t\t\tm_reset_sync   <= {m_reset_sync[0], 1'b1};\n\t\t\tm_reset_active <= ~m_reset_sync[1];\n\t\tend\n\tend\n\n\tassign M_PRESETn = ~m_reset_active;\n\n\t// ------------------------------------------------------------------\n\t// Source-side (S_APB_PCLK) state machine\n\t// ------------------------------------------------------------------\n\tlocalparam S_IDLE  = 1'b0;\n\tlocalparam S_BUSY  = 1'b1;\n\n\treg       s_state;\n\treg       s_req_valid;\n\n\t// Handshake signals to M domain\n\treg       s_to_m_req;\n\treg       s_to_m_ack;\n\n\t// Capture of source request fields (held stable during transfer)\n\treg [AW-1:0] s_addr;\n\treg          s_write;\n\treg [DW-1:0] s_wdata;\n\treg [DW/8-1:0] s_wstrb;\n\treg [2:0]    s_pprot;\n\n\t// Response from M domain (synchronized back)\n\treg [DW-1:0] s_rdata;\n\treg          s_pslverr;\n\n\t// ------------------------------------------------------------------\n\t// Destination-side (M_APB_PCLK) state machine\n\t// ------------------------------------------------------------------\n\tlocalparam M_IDLE  = 1'b0;\n\tlocalparam M_SETUP = 1'b1;\n\tlocalparam M_ACCESS= 1'b2;\n\n\treg [1:0] m_state;\n\treg       m_req_valid;\n\n\t// Handshake signals from S domain\n\treg       m_to_s_req;\n\treg       m_to_s_ack;\n\n\t// Captured request fields in M domain\n\treg [AW-1:0] m_addr;\n\treg          m_write;\n\treg [DW-1:0] m_wdata;\n\treg [DW/8-1:0] m_wstrb;\n\treg [2:0]    m_pprot;\n\n\t// Response to S domain\n\treg [DW-1:0] m_rdata;\n\treg          m_pslverr;\n\n\t// ------------------------------------------------------------------\n\t// S_APB_PCLK domain logic\n\t// ------------------------------------------------------------------\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_state     <= S_IDLE;\n\t\t\ts_req_valid <= 1'b0;\n\t\t\ts_to_m_req  <= 1'b0;\n\t\t\ts_to_m_ack  <= 1'b0;\n\t\t\ts_addr      <= {AW{1'b0}};\n\t\t\ts_write     <= 1'b0;\n\t\t\ts_wdata     <= {DW{1'b0}};\n\t\t\ts_wstrb     <= {(DW/8){1'b0}};\n\t\t\ts_pprot     <= 3'b000;\n\t\t\ts_rdata     <= {DW{1'b0}};\n\t\t\ts_pslverr   <= 1'b0;\n\t\t\tS_APB_PREADY<= 1'b0;\n\t\tend else begin\n\t\t\tcase (s_state)\n\t\t\t\tS_IDLE: begin\n\t\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\t\t\tif (S_APB_PSEL && S_APB_PENABLE) begin\n\t\t\t\t\t\t// Capture request\n\t\t\t\t\t\ts_addr    <= S_APB_PADDR;\n\t\t\t\t\t\ts_write   <= S_APB_PWRITE;\n\t\t\t\t\t\ts_wdata   <= S_APB_PWDATA;\n\t\t\t\t\t\ts_wstrb   <= S_APB_PWSTRB;\n\t\t\t\t\t\ts_pprot   <= S_APB_PPROT;\n\t\t\t\t\t\ts_req_valid <= 1'b1;\n\t\t\t\t\t\ts_to_m_req  <= 1'b1;\n\t\t\t\t\t\ts_state     <= S_BUSY;\n\t\t\t\t\t\tS_APB_PREADY<= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tS_BUSY: begin\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tif (s_to_m_ack) begin\n\t\t\t\t\t\t// Transfer complete, return response\n\t\t\t\t\t\ts_rdata     <= m_rdata;\n\t\t\t\t\t\ts_pslverr   <= m_pslverr;\n\t\t\t\t\t\ts_to_m_req  <= 1'b0;\n\t\t\t\t\t\ts_req_valid <= 1'b0;\n\t\t\t\t\t\ts_state     <= S_IDLE;\n\t\t\t\t\t\tS_APB_PREADY<= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: begin\n\t\t\t\t\ts_state <= S_IDLE;\n\t\t\t\tend\n\t\t\tendcase\n\t\tend\n\tend\n\n\t// ------------------------------------------------------------------\n\t// M_APB_PCLK domain logic\n\t// ------------------------------------------------------------------\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_state     <= M_IDLE;\n\t\t\tm_req_valid <= 1'b0;\n\t\t\tm_to_s_req  <= 1'b0;\n\t\t\tm_to_s_ack  <= 1'b0;\n\t\t\tm_addr      <= {AW{1'b0}};\n\t\t\tm_write     <= 1'b0;\n\t\t\tm_wdata     <= {DW{1'b0}};\n\t\t\tm_wstrb     <= {(DW/8){1'b0}};\n\t\t\tm_pprot     <= 3'b000;\n\t\t\tm_rdata     <= {DW{1'b0}};\n\t\t\tm_pslverr   <= 1'b0;\n\t\t\tM_APB_PSEL  <= 1'b0;\n\t\t\tM_APB_PENABLE<= 1'b0;\n\t\tend else begin\n\t\t\tcase (m_state)\n\t\t\t\tM_IDLE: begin\n\t\t\t\t\tM_APB_PSEL    <= 1'b0;\n\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\t\tif (s_to_m_req) begin\n\t\t\t\t\t\t// Capture request from S domain\n\t\t\t\t\t\tm_addr      <= s_addr;\n\t\t\t\t\t\tm_write     <= s_write;\n\t\t\t\t\t\tm_wdata     <= s_wdata;\n\t\t\t\t\t\tm_wstrb     <= s_wstrb;\n\t\t\t\t\t\tm_pprot     <= s_pprot;\n\t\t\t\t\t\tm_req_valid <= 1'b1;\n\t\t\t\t\t\tm_to_s_req  <= 1'b1;\n\t\t\t\t\t\tm_state     <= M_SETUP;\n\t\t\t\t\t\tM_APB_PSEL  <= 1'b1;\n\t\t\t\t\t\tM_APB_PENABLE<= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tM_SETUP: begin\n\t\t\t\t\tM_APB_PSEL    <= 1'b1;\n\t\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\t\tm_state       <= M_ACCESS;\n\t\t\t\tend\n\t\t\t\tM_ACCESS: begin\n\t\t\t\t\tM_APB_PSEL    <= 1'b1;\n\t\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t\t// Transfer complete\n\t\t\t\t\t\tm_rdata     <= M_APB_PRDATA;\n\t\t\t\t\t\tm_pslverr   <= M_APB_PSLVERR;\n\t\t\t\t\t\tm_to_s_ack  <= 1'b1;\n\t\t\t\t\t\tm_req_valid <= 1'b0;\n\t\t\t\t\t\tm_state     <= M_IDLE;\n\t\t\t\t\t\tM_APB_PSEL  <= 1'b0;\n\t\t\t\t\t\tM_APB_PENABLE<= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: begin\n\t\t\t\t\tm_state       <= M_IDLE;\n\t\t\t\t\tM_APB_PSEL    <= 1'b0;\n\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\tend\n\t\t\tendcase\n\t\tend\n\tend\n\n\t// ------------------------------------------------------------------\n\t// Output assignments\n\t// ------------------------------------------------------------------\n\tassign M_APB_PADDR  = m_addr;\n\tassign M_APB_PWRITE = m_write;\n\tassign M_APB_PWDATA = m_wdata;\n\tassign M_APB_PWSTRB = m_wstrb;\n\tassign M_APB_PPROT  = m_pprot;\n\n\tassign S_APB_PRDATA  = s_rdata;\n\tassign S_APB_PSLVERR = s_pslverr;\n\nendmodule\n```<|im_end|>",
