 or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\ts_rst_sync <= 2'b00;\n\t\telse\n\t\t\ts_rst_sync <= {s_rst_sync[0], 1'b1};\n\tend\n\n\t// M-domain reset synchronizer for M_PRESETn\n\treg [1:0] m_rst_sync;\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn)\n\t\t\tm_rst_sync <= 2'b00;\n\t\telse\n\t\t\tm_rst_sync <= {m_rst_sync[0], 1'b1};\n\tend\n\n\t// M_PRESETn is derived from S_PRESETn synchronized to M domain\n\t// We use a simple synchronizer chain from S_PRESETn to M domain\n\t// But since M_PRESETn is an output, we need to generate it in M domain\n\t// based on S_PRESETn. We'll use a 2-stage synchronizer in M domain.\n\t\n\t// Actually, let's use a proper reset synchronizer.\n\t// S_PRESETn is active-low. We need to synchronize its release to M domain.\n\t// We'll create a synchronized version of S_PRESETn in M domain.\n\t\n\treg [1:0] m_s_presetn_sync;\n\talways @(posedge M_APB_PCLK) begin\n\t\tm_s_presetn_sync <= {m_s_presetn_sync[0], S_PRESETn};\n\tend\n\n\t// M_PRESETn is active-low, so it's low when S_PRESETn is low (after sync)\n\t// We'll assert M_PRESETn when the synchronized S_PRESETn is low\n\talways @(posedge M_APB_PCLK) begin\n\t\tM_PRESETn <= m_s_presetn_sync[1];\n\tend\n\n\t// S-domain: Capture request when S_APB_PSEL is asserted\n\t// and not busy\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_req_pending <= 1'b0;\n\t\t\ts_req_valid <= 1'b0;\n\t\t\ts_req_ack <= 1'b0;\n\t\t\ts_done_valid <= 1'b0;\n\t\t\ts_done_ack <= 1'b0;\n\t\t\ts_rdata_reg <= {DW{1'b0}};\n\t\t\ts_slverr_reg <= 1'b0;\n\t\t\ts_setup <= 1'b0;\n\t\t\ts_access <= 1'b0;\n\t\t\ts_busy <= 1'b0;\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\tend else begin\n\t\t\t// Handle done ack from M domain\n\t\t\tif (s_done_valid && s_done_ack) begin\n\t\t\t\ts_done_valid <= 1'b0;\n\t\t\t\ts_done_ack <= 1'b0;\n\t\t\tend\n\n\t\t\t// Handle request ack from M domain\n\t\t\tif (s_req_valid && s_req_ack) begin\n\t\t\t\ts_req_valid <= 1'b0;\n\t\t\t\ts_req_ack <= 1'b0;\n\t\t\tend\n\n\t\t\t// APB state machine\n\t\t\tif (!s_busy) begin\n\t\t\t\tif (S_APB_PSEL) begin\n\t\t\t\t\ts_setup <= 1'b1;\n\t\t\t\t\ts_busy <= 1'b1;\n\t\t\t\t\t// Capture request\n\t\t\t\t\ts_req_valid <= 1'b1;\n\t\t\t\t\tm_addr_reg <= S_APB_PADDR;\n\t\t\t\t\tm_write_reg <= S_APB_PWRITE;\n\t\t\t\t\tm_wdata_reg <= S_APB_PWDATA;\n\t\t\t\t\tm_wstrb_reg <= S_APB_PWSTRB;\n\t\t\t\t\tm_pprot_reg <= S_APB_PPROT;\n\t\t\t\tend else begin\n\t\t\t\t\ts_setup <= 1'b0;\n\t\t\t\t\ts_access <= 1'b0;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\tif (s_setup) begin\n\t\t\t\t\tif (S_APB_PENABLE) begin\n\t\t\t\t\t\ts_setup <= 1'b0;\n\t\t\t\t\t\ts_access <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend else if (s_access) begin\n\t\t\t\t\tif (S_APB_PREADY) begin\n\t\t\t\t\t\ts_access <= 1'b0;\n\t\t\t\t\t\ts_busy <= 1'b0;\n\t\t\t\t\t\t// Capture response\n\t\t\t\t\t\tif (s_done_valid) begin\n\t\t\t\t\t\t\ts_rdata_reg <= m_rdata_reg;\n\t\t\t\t\t\t\ts_slverr_reg <= m_slverr_reg;\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\n\t\t\t// S_APB_PREADY is asserted when in access phase and done is valid\n\t\t\tif (s_access && s_done_valid)\n\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\telse\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\tend\n\tend\n\n\t// M-domain: APB state machine\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_req_valid <= 1'b0;\n\t\t\tm_req_ack <= 1'b0;\n\t\t\tm_done_valid <= 1'b0;\n\t\t\tm_done_ack <= 1'b0;\n\t\t\tm_rdata_reg <= {DW{1'b0}};\n\t\t\tm_slverr_reg <= 1'b0;\n\t\t\tm_setup <= 1'b0;\n\t\t\tm_access <= 1'b0;\n\t\t\tm_busy <= 1'b0;\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\tend else begin\n\t\t\t// Handle request ack from S domain\n\t\t\tif (m_req_valid && m_req_ack) begin\n\t\t\t\tm_req_valid <= 1'b0;\n\t\t\t\tm_req_ack <= 1'b0;\n\t\t\tend\n\n\t\t\t// Handle done ack from S domain\n\t\t\tif (m_done_valid && m_done_ack) begin\n\t\t\t\tm_done_valid <= 1'b0;\n\t\t\t\tm_done_ack <= 1'b0;\n\t\t\tend\n\n\t\t\t// APB state machine\n\t\t\tif (!m_busy) begin\n\t\t\t\tif (m_req_valid) begin\n\t\t\t\t\tm_setup <= 1'b1;\n\t\t\t\t\tm_busy <= 1'b1;\n\t\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\tend else begin\n\t\t\t\t\tm_setup <= 1'b0;\n\t\t\t\t\tm_access <= 1'b0;\n\t\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\tif (m_setup) begin\n\t\t\t\t\tm_access <= 1'b1;\n\t\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\tend else if (m_access) begin\n\t\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t\tm_access <= 1'b0;\n\t\t\t\t\t\tm_busy <= 1'b0;\n\t\t\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\t\t\t// Capture response and signal done\n\t\t\t\t\t\tm_rdata_reg <= M_APB_PRDATA;\n\t\t\t\t\t\tm_slverr_reg <= M_APB_PSLVERR;\n\t\t\t\t\t\tm_done_valid <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// Handshake: S-domain request to M-domain\n\t// s_req_valid is set in S domain, m_req_ack is set in M domain\n\t// We need to synchronize these across domains.\n\t\n\t// S-domain: m_req_ack synchronized to S domain\n\treg [1:0] s_m_req_ack_sync;\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\ts_m_req_ack_sync <= 2'b00;\n\t\telse\n\t\t\ts_m_req_ack_sync <= {s_m_req_ack_sync[0], m_req_ack};\n\tend\n\tassign s_req_ack = s_m_req_ack_sync[1];\n\n\t// M-domain: s_req_valid synchronized to M domain\n\treg [1:0] m_s_req_valid_sync;\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn)\n\t\t\tm_s_req_valid_sync <= 2'b00;\n\t\telse\n\t\t\tm_s_req_valid_sync <= {m_s_req_valid_sync[0], s_req_valid};\n\tend\n\tassign m_req_valid = m_s_req_valid_sync[1];\n\n\t// Handshake: M-domain done to S-domain\n\t// m_done_valid is set in M domain, s_done_ack is set in S domain\n\t\n\t// S-domain: m_done_valid synchronized to S domain\n\treg [1:0] s_m_done_valid_sync;\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\ts_m_done_valid_sync <= 2'b00;\n\t\telse\n\t\t\ts_m_done_valid_sync <= {s_m_done_valid_sync[0], m_done_valid};\n\tend\n\tassign s_done_valid = s_m_done_valid_sync[1];\n\n\t// M-domain: s_done_ack synchronized to M domain\n\treg [1:0] m_s_done_ack_sync;\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn)\n\t\t\tm_s_done_ack_sync <= 2'b00;\n\t\telse\n\t\t\tm_s_done_ack_sync <= {m_s_done_ack_sync[0], s_done_ack};\n\tend\n\tassign m_done_ack = m_s_done_ack_sync[1];\n\n\t// Data crossing: S to M (request data)\n\t// The data is captured in S domain and held stable.\n\t// We need to synchronize the data to M domain.\n\t// Since the data is held stable until ack, we can use a simple synchronizer\n\t// but for multi-bit data, we need to ensure coherence.\n\t// We'll use a 2-stage synchronizer for each bit, but that's not ideal for multi-bit.\n\t// Instead, we'll use a handshake-based approach where the data is captured\n\t// in M domain when the request is accepted.\n\t\n\t// Actually, the data is already registered in S domain (m_addr_reg, etc.)\n\t// and held stable. We can use a simple 2-stage synchronizer for each signal\n\t// since they are held stable during the transfer.\n\t\n\t// For OPT_REGISTERED, we add an extra register stage.\n\t// For simplicity, we'll use 2-stage synchronizers for all crossing signals.\n\t\n\t// S to M: address\n\treg [AW-1:0] m_addr_sync1, m_addr_sync2;\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_addr_sync1 <= {AW{1'b0}};\n\t\t\tm_addr_sync2 <= {AW{1'b0}};\n\t\tend else begin\n\t\t\tm_addr_sync1 <= m_addr_reg;\n\t\t\tm_addr_sync2 <= m_addr_sync1;\n\t\tend\n\tend\n\tassign M_APB_PADDR = m_addr_sync2;\n\n\t// S to M: write\n\treg m_write_sync1, m_write_sync2;\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_write_sync1 <= 1'b0;\n\t\t\tm_write_sync2 <= 1'b0;\n\t\tend else begin\n\t\t\tm_write_sync1 <= m_write_reg;\n\t\t\tm_write_sync2 <= m_write_sync1;\n\t\tend\n\tend\n\tassign M_APB_PWRITE = m_write_sync2;\n\n\t// S to M: wdata\n\treg [DW-1:0] m_wdata_sync1, m_wdata_sync2;\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_wdata_sync1 <= {DW{1'b0}};\n\t\t\tm_wdata_sync2 <= {DW{1'b0}};\n\t\tend else begin\n\t\t\tm_wdata_sync1 <= m_wdata_reg;\n\t\t\tm_wdata_sync2 <= m_wdata_sync1;\n\t\tend\n\tend\n\tassign M_APB_PWDATA = m_wdata_sync2;\n\n\t// S to M: wstrb\n\treg [DW/8-1:0] m_wstrb_sync1, m_wstrb_sync2;\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_wstrb_sync1 <= {DW/8{1'b0}};\n\t\t\tm_wstrb_sync2 <= {DW/8{1'b0}};\n\t\tend else begin\n\t\t\tm_wstrb_sync1 <= m_wstrb_reg;\n\t\t\tm_wstrb_sync2 <= m_wstrb_sync1;\n\t\tend\n\tend\n\tassign M_APB_PWSTRB = m_wstrb_sync2;\n\n\t// S to M: pprot\n\treg [2:0] m_pprot_sync1, m_pprot_sync2;\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_pprot_sync1 <= 3'b000;\n\t\t\tm_pprot_sync2 <= 3'b000;\n\t\tend else begin\n\t\t\tm_pprot_sync1 <= m_pprot_reg;\n\t\t\tm_pprot_sync2 <= m_pprot_sync1;\n\t\tend\n\tend\n\tassign M_APB_PPROT = m_pprot_sync2;\n\n\t// M to S: rdata\n\treg [DW-1:0] s_rdata_sync1, s_rdata_sync2;\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_rdata_sync1 <= {DW{1'b0}};\n\t\t\ts_rdata_sync2 <= {DW{1'b0}};\n\t\tend else begin\n\t\t\ts_rdata_sync1 <= m_rdata_reg;\n\t\t\ts_rdata_sync2 <= s_rdata_sync1;\n\t\tend\n\tend\n\tassign S_APB_PRDATA = s_rdata_sync2;\n\n\t// M to S: slverr\n\treg s_slverr_sync1, s_slverr_sync2;\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_slverr_sync1 <= 1'b0;\n\t\t\ts_slverr_sync2 <= 1'b0;\n\t\tend else begin\n\t\t\ts_slverr_sync1 <= m_slverr_reg;\n\t\t\ts_slverr_sync2 <= s_slverr_sync1;\n\t\tend\n\tend\n\tassign S_APB_