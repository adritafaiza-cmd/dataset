 [AW-1:0] m_addr;\n\treg m_write;\n\treg [DW-1:0] m_wdata;\n\treg [DW/8-1:0] m_wstrb;\n\treg [2:0] m_pprot;\n\n\t// Slave-side response registers (captured in slave clock)\n\treg [DW-1:0] s_rdata;\n\treg s_rslverr;\n\n\t// Synchronization of m_rdata and m_rslverr into slave clock domain\n\treg [DW-1:0] m_rdata_sync;\n\treg m_rslverr_sync;\n\treg [DW-1:0] m_rdata_d1;\n\treg m_rslverr_d1;\n\treg [DW-1:0] m_rdata_d2;\n\treg m_rslverr_d2;\n\n\t// Synchronization of s_req into master clock domain\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\ts_req_d1 <= 1'b0;\n\t\t\ts_req_d2 <= 1'b0;\n\t\tend else begin\n\t\t\ts_req_d1 <= s_req;\n\t\t\ts_req_d2 <= s_req_d1;\n\t\tend\n\tend\n\tassign s_req_sync = {s_req_d2, s_req_d1, s_req};\n\n\t// Synchronization of m_ack into slave clock domain\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_ack_d1 <= 1'b0;\n\t\t\tm_ack_d2 <= 1'b0;\n\t\tend else begin\n\t\t\tm_ack_d1 <= m_ack;\n\t\t\tm_ack_d2 <= m_ack_d1;\n\t\tend\n\tend\n\tassign m_ack_sync = {m_ack_d2, m_ack_d1, m_ack};\n\n\t// Synchronization of m_rdata and m_rslverr into slave clock domain\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_rdata_d1 <= {DW{1'b0}};\n\t\t\tm_rslverr_d1 <= 1'b0;\n\t\t\tm_rdata_d2 <= {DW{1'b0}};\n\t\t\tm_rslverr_d2 <= 1'b0;\n\t\tend else begin\n\t\t\tm_rdata_d1 <= m_rdata;\n\t\t\tm_rslverr_d1 <= m_rslverr;\n\t\t\tm_rdata_d2 <= m_rdata_d1;\n\t\t\tm_rslverr_d2 <= m_rslverr_d1;\n\t\tend\n\tend\n\tassign m_rdata_sync = m_rdata_d2;\n\tassign m_rslverr_sync = m_rslverr_d2;\n\n\t// Slave-side logic\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_state <= S_IDLE;\n\t\t\ts_req <= 1'b0;\n\t\t\ts_addr <= {AW{1'b0}};\n\t\t\ts_write <= 1'b0;\n\t\t\ts_wdata <= {DW{1'b0}};\n\t\t\ts_wstrb <= {(DW/8){1'b0}};\n\t\t\ts_pprot <= 3'b0;\n\t\t\ts_rdata <= {DW{1'b0}};\n\t\t\ts_rslverr <= 1'b0;\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\tend else begin\n\t\t\tcase (s_state)\n\t\t\t\tS_IDLE: begin\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tif (S_APB_PSEL) begin\n\t\t\t\t\t\ts_addr <= S_APB_PADDR;\n\t\t\t\t\t\ts_write <= S_APB_PWRITE;\n\t\t\t\t\t\ts_wdata <= S_APB_PWDATA;\n\t\t\t\t\t\ts_wstrb <= S_APB_PWSTRB;\n\t\t\t\t\t\ts_pprot <= S_APB_PPROT;\n\t\t\t\t\t\ts_req <= 1'b1;\n\t\t\t\t\t\ts_state <= S_SETUP;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tS_SETUP: begin\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tif (S_APB_PSEL && S_APB_PENABLE) begin\n\t\t\t\t\t\ts_state <= S_ACCESS;\n\t\t\t\t\tend else if (!S_APB_PSEL) begin\n\t\t\t\t\t\ts_req <= 1'b0;\n\t\t\t\t\t\ts_state <= S_IDLE;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tS_ACCESS: begin\n\t\t\t\t\tif (m_ack_sync[2] && m_ack_sync[1] && m_ack_sync[0]) begin\n\t\t\t\t\t\ts_rdata <= m_rdata_sync;\n\t\t\t\t\t\ts_rslverr <= m_rslverr_sync;\n\t\t\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\t\t\t\ts_req <= 1'b0;\n\t\t\t\t\t\ts_state <= S_IDLE;\n\t\t\t\t\tend else begin\n\t\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: begin\n\t\t\t\t\ts_state <= S_IDLE;\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\tend\n\t\t\tendcase\n\t\tend\n\tend\n\n\t// Master-side logic\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_state <= M_IDLE;\n\t\t\tm_ack <= 1'b0;\n\t\t\tm_addr <= {AW{1'b0}};\n\t\t\tm_write <= 1'b0;\n\t\t\tm_wdata <= {DW{1'b0}};\n\t\t\tm_wstrb <= {(DW/8){1'b0}};\n\t\t\tm_pprot <= 3'b0;\n\t\t\tm_rdata <= {DW{1'b0}};\n\t\t\tm_rslverr <= 1'b0;\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\tend else begin\n\t\t\tcase (m_state)\n\t\t\t\tM_IDLE: begin\n\t\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\t\tm_ack <= 1'b0;\n\t\t\t\t\tif (s_req_sync[2] && s_req_sync[1] && s_req_sync[0]) begin\n\t\t\t\t\t\tm_addr <= s_addr;\n\t\t\t\t\t\tm_write <= s_write;\n\t\t\t\t\t\tm_wdata <= s_wdata;\n\t\t\t\t\t\tm_wstrb <= s_wstrb;\n\t\t\t\t\t\tm_pprot <= s_pprot;\