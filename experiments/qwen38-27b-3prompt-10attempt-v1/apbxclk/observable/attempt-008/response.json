'b00;\n\t\telse\n\t\t\ts2m_req_sync <= {s2m_req_sync[0], s_state == S_SETUP};\n\tend\n\n\t// Synchronizer for done from master to slave\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\tm2s_done_sync <= 2'b00;\n\t\telse\n\t\t\tm2s_done_sync <= {m2s_done_sync[0], m_state == M_IDLE && m_req_pending};\n\tend\n\n\t// Master-side reset\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn)\n\t\t\tM_PRESETn <= 1'b0;\n\t\telse\n\t\t\tM_PRESETn <= 1'b1;\n\tend\n\n\t// Master-side state machine\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_state <= M_IDLE;\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\tm_req_pending <= 1'b0;\n\t\tend else begin\n\t\t\tcase (m_state)\n\t\t\t\tM_IDLE: begin\n\t\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\t\tif (s2m_req_sync[1]) begin\n\t\t\t\t\t\tm_state <= M_SETUP;\n\t\t\t\t\t\tm_req_pending <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tM_SETUP: begin\n\t\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\t\tm_state <= M_ACCESS;\n\t\t\t\tend\n\t\t\t\tM_ACCESS: begin\n\t\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t\tm_state <= M_IDLE;\n\t\t\t\t\t\tm_req_pending <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: m_state <= M_IDLE;\n\t\t\tendcase\n\t\tend\n\tend\n\n\t// Master-side payload registers\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_addr_reg <= {AW{1'b0}};\n\t\t\tm_write_reg <= 1'b0;\n\t\t\tm_wdata_reg <= {DW{1'b0}};\n\t\t\tm_wstrb_reg <= {(DW/8){1'b0}};\n\t\t\tm_pprot_reg <= 3'b000;\n\t\tend else if (m_state == M_IDLE && s2m_req_sync[1]) begin\n\t\t\tm_addr_reg <= S_APB_PADDR;\n\t\t\tm_write_reg <= S_APB_PWRITE;\n\t\t\tm_wdata_reg <= S_APB_PWDATA;\n\t\t\tm_wstrb_reg <= S_APB_PWSTRB;\n\t\t\tm_pprot_reg <= S_APB_PPROT;\n\t\tend\n\tend\n\n\t// Master-side outputs\n\tassign M_APB_PADDR = m_addr_reg;\n\tassign M_APB_PWRITE = m_write_reg;\n\tassign M_APB_PWDATA = m_wdata_reg;\n\tassign M_APB_PWSTRB = m_wstrb_reg;\n\tassign M_APB_PPROT = m_pprot_reg;\n\n\t// Slave-side state machine\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_state <= S_IDLE;\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\ts_resp_pending <= 1'b0;\n\t\tend else begin\n\t\t\tcase (s_state)\n\t\t\t\tS_IDLE: begin\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tif (S_APB_PSEL) begin\n\t\t\t\t\t\ts_state <= S_SETUP;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tS_SETUP: begin\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\ts_state <= S_ACCESS;\n\t\t\t\tend\n\t\t\t\tS_ACCESS: begin\n\t\t\t\t\tif (m2s_done_sync[1]) begin\n\t\t\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\t\t\t\ts_resp_pending <= 1'b1;\n\t\t\t\t\t\ts_state <= S_IDLE;\n\t\t\t\t\tend else begin\n\t\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: s_state <= S_IDLE;\n\t\t\tendcase\n\t\tend\n\tend\n\n\t// Slave-side response registers\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_rdata_reg <= {DW{1'b0}};\n\t\t\ts_pslverr_reg <= 1'b0;\n\t\tend else if (m2s_done_sync[1]) begin\n\t\t\ts_rdata_reg <= M_APB_PRDATA;\n\t\t\ts_pslverr_reg <= M_APB_PSLVERR;\n\t\tend\n\tend\n\n\t// Slave-side outputs\n\tassign S_APB_PRDATA = s_rdata_reg;\n\tassign S_APB_PSLVERR = s_pslverr_reg;\n\nendmodule\n```<|im_end|>",
