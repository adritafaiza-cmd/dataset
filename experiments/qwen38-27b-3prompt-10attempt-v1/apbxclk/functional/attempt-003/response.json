  "text": "```verilog\nmodule apbxclk #(\n\tparameter\tC_APB_ADDR_WIDTH = 12,\n\tparameter\tC_APB_DATA_WIDTH = 32,\n\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\tlocalparam\tDW = C_APB_DATA_WIDTH\n) (\n\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\tinput\twire\t\t\tS_APB_PSEL,\n\tinput\twire\t\t\tS_APB_PENABLE,\n\toutput\treg\t\t\tS_APB_PREADY,\n\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\tinput\twire\t\t\tS_APB_PWRITE,\n\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\toutput\twire\t\t\tS_APB_PSLVERR,\n\tinput\twire\t\t\tM_APB_PCLK,\n\toutput\treg\t\t\tM_PRESETn,\n\toutput\treg\t\t\tM_APB_PSEL,\n\toutput\treg\t\t\tM_APB_PENABLE,\n\tinput\twire\t\t\tM_APB_PREADY,\n\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\toutput\twire\t\t\tM_APB_PWRITE,\n\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\tinput\twire\t\t\tM_APB_PSLVERR\n);\n\n\t// Synchronous reset for M domain\n\treg [1:0] m_reset_sync;\n\treg m_reset_n;\n\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_reset_sync <= 2'b00;\n\t\t\tm_reset_n <= 1'b0;\n\t\tend else begin\n\t\t\tm_reset_sync <= {m_reset_sync[0], 1'b1};\n\t\t\tm_reset_n <= m_reset_sync[1];\n\t\tend\n\tend\n\n\tassign M_PRESETn = m_reset_n;\n\n\t// Handshake signals\n\treg s_req;\n\treg m_ack;\n\treg m_req;\n\treg s_ack;\n\n\t// S domain: detect new APB transaction start\n\t// A new transaction starts when PSEL is high and PENABLE is low (setup phase)\n\t// We need to capture the request when it's valid and not already in progress\n\treg s_busy;\n\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_busy <= 1'b0;\n\t\t\ts_req <= 1'b0;\n\t\t\ts_ack <= 1'b0;\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\tend else begin\n\t\t\t// Detect start of a new APB transaction\n\t\t\t// PSEL high, PENABLE low means setup phase\n\t\t\t// We start a new transaction if not busy\n\t\t\tif (!s_busy && S_APB_PSEL && !S_APB_PENABLE) begin\n\t\t\t\ts_busy <= 1'b1;\n\t\t\t\ts_req <= 1'b1;\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\tend else if (s_busy) begin\n\t\t\t\t// Wait for m_ack to complete the transaction\n\t\t\t\tif (m_ack) begin\n\t\t\t\t\ts_busy <= 1'b0;\n\t\t\t\t\ts_req <= 1'b0;\n\t\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// M domain: generate APB signals\n\treg [AW-1:0] m_addr;\n\treg m_write;\n\treg [DW-1:0] m_wdata;\n\treg [DW/8-1:0] m_wstrb;\n\treg [2:0] m_pprot;\n\treg m_sel;\n\treg m_enable;\n\n\talways @(posedge M_APB_PCLK or negedge m_reset_n) begin\n\t\tif (!m_reset_n) begin\n\t\t\tm_sel <= 1'b0;\n\t\t\tm_enable <= 1'b0;\n\t\t\tm_req <= 1'b0;\n\t\t\tm_ack <= 1'b0;\n\t\t\tm_addr <= {AW{1'b0}};\n\t\t\tm_write <= 1'b0;\n\t\t\tm_wdata <= {DW{1'b0}};\n\t\t\tm_wstrb <= {(DW/8){1'b0}};\n\t\t\tm_pprot <= 3'b000;\n\t\tend else begin\n\t\t\t// Handle handshake\n\t\t\tif (s_req && !m_req) begin\n\t\t\t\t// New request from S domain\n\t\t\t\tm_req <= 1'b1;\n\t\t\t\tm_sel <= 1'b1;\n\t\t\t\tm_enable <= 1'b0;\n\t\t\t\tm_addr <= S_APB_PADDR;\n\t\t\t\tm_write <= S_APB_PWRITE;\n\t\t\t\tm_wdata <= S_APB_PWDATA;\n\t\t\t\tm_wstrb <= S_APB_PWSTRB;\n\t\t\t\tm_pprot <= S_APB_PPROT;\n\t\t\tend else if (m_req) begin\n\t\t\t\t// In progress\n\t\t\t\tif (!m_enable) begin\n\t\t\t\t\t// Setup phase, move to access phase\n\t\t\t\t\tm_enable <= 1'b1;\n\t\t\t\tend else begin\n\t\t\t\t\t// Access phase, wait for PREADY\n\t\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\t\tm_req <= 1'b0;\n\t\t\t\t\t\tm_sel <= 1'b0;\n\t\t\t\t\t\tm_enable <= 1'b0;\n\t\t\t\t\t\tm_ack <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\tm_ack <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\tassign M_APB_PSEL = m_sel;\n\tassign M_APB_PENABLE = m_enable;\n\tassign M_APB_PADDR = m_addr;\n\tassign M_APB_PWRITE = m_write;\n\tassign M_APB_PWDATA = m_wdata;\n\tassign M_APB_PWSTRB = m_wstrb;\n\tassign M_APB_PPROT = m_pprot;\n\n\t// Response path: M domain to S domain\n\t// Capture read data and error when transaction completes\n\treg [DW-1:0] s_rdata;\n\treg s_pslverr;\n\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_rdata <= {DW{1'b0}};\n\t\t\ts_pslverr <= 1'b0;\n\t\tend else begin\n\t\t\t// Capture response when m_ack is asserted\n\t\t\tif (m_ack) begin\n\t\t\t\ts_rdata <= M_APB_PRDATA;\n\t\t\t\ts_pslverr <= M_APB_PSLVERR;\n\t\t\tend\n\t\tend\n\tend\n\n\tassign S_APB_PRDATA = s_rdata;\n\tassign S_APB_PSLVERR = s_pslverr;\n\nendmodule\n```<|im_end|>",
