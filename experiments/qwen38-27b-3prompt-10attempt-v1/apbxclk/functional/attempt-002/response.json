_APB_PADDR = m_addr;\n\tassign M_APB_PWRITE = m_write;\n\tassign M_APB_PWDATA = m_wdata;\n\tassign M_APB_PWSTRB = m_wstrb;\n\tassign M_APB_PPROT = m_pprot;\n\n\t// S domain: synchronize m_done\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tm_done_sync <= 2'b00;\n\t\tend else begin\n\t\t\tm_done_sync <= {m_done_sync[0], m_done};\n\t\tend\n\tend\n\treg [1:0] m_done_sync;\n\tassign s_done = m_done_sync[1];\n\n\t// S domain: APB slave state machine\n\t// States: IDLE, SETUP, ACCESS\n\tlocalparam S_IDLE = 2'b00;\n\tlocalparam S_SETUP = 2'b01;\n\tlocalparam S_ACCESS = 2'b10;\n\n\treg [1:0] s_state;\n\treg s_sel;\n\treg s_enable;\n\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_state <= S_IDLE;\n\t\t\ts_sel <= 1'b0;\n\t\t\ts_enable <= 1'b0;\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\ts_rdata <= {DW{1'b0}};\n\t\t\ts_pslverr <= 1'b0;\n\t\t\ts_req <= 1'b0;\n\t\tend else begin\n\t\t\ts_req <= 1'b0;\n\t\t\tcase (s_state)\n\t\t\t\tS_IDLE: begin\n\t\t\t\t\ts_sel <= 1'b0;\n\t\t\t\t\ts_enable <= 1'b0;\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tif (S_APB_PSEL) begin\n\t\t\t\t\t\ts_state <= S_SETUP;\n\t\t\t\t\t\ts_sel <= 1'b1;\n\t\t\t\t\t\ts_enable <= 1'b0;\n\t\t\t\t\t\ts_req <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tS_SETUP: begin\n\t\t\t\t\ts_sel <= 1'b1;\n\t\t\t\t\ts_enable <= 1'b1;\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\ts_state <= S_ACCESS;\n\t\t\t\tend\n\t\t\t\tS_ACCESS: begin\n\t\t\t\t\ts_sel <= 1'b1;\n\t\t\t\t\ts_enable <= 1'b1;\n\t\t\t\t\tif (s_done) begin\n\t\t\t\t\t\ts_state <= S_IDLE;\n\t\t\t\t\t\ts_sel <= 1'b0;\n\t\t\t\t\t\ts_enable <= 1'b0;\n\t\t\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\t\t\t\ts_rdata <= M_APB_PRDATA;\n\t\t\t\t\t\ts_pslverr <= M_APB_PSLVERR;\n\t\t\t\t\tend else begin\n\t\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: begin\n\t\t\t\t\ts_state <= S_IDLE;\n\t\t\t\t\ts_sel <= 1'b0;\n\t\t\t\t\ts_enable <= 1'b0;\n\t\t\t\t\tS_APB_PREADY <= 1'b