  "text": "```verilog\nmodule apbxclk #(\n\t\tparameter\tC_APB_ADDR_WIDTH = 12,\n\t\tparameter\tC_APB_DATA_WIDTH = 32,\n\t\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\t\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\t\tlocalparam\tDW = C_APB_DATA_WIDTH\n\t) (\n\t\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\t\tinput\twire\t\t\tS_APB_PSEL,\n\t\tinput\twire\t\t\tS_APB_PENABLE,\n\t\toutput\treg\t\t\tS_APB_PREADY,\n\t\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\t\tinput\twire\t\t\tS_APB_PWRITE,\n\t\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\t\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\t\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\t\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\t\toutput\twire\t\t\tS_APB_PSLVERR,\n\t\tinput\twire\t\t\tM_APB_PCLK,\n\t\toutput\treg\t\t\tM_PRESETn,\n\t\toutput\treg\t\t\tM_APB_PSEL,\n\t\toutput\treg\t\t\tM_APB_PENABLE,\n\t\tinput\twire\t\t\tM_APB_PREADY,\n\t\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\t\toutput\twire\t\t\tM_APB_PWRITE,\n\t\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\t\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\t\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\t\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\t\tinput\twire\t\t\tM_APB_PSLVERR\n\t);\n\n\t// Synchronous reset for M domain\n\treg [2:0] m_reset_sync;\n\treg m_reset_n;\n\n\talways @(posedge M_APB_PCLK) begin\n\t\tm_reset_sync <= {m_reset_sync[1:0], S_PRESETn};\n\tend\n\n\tassign M_PRESETn = m_reset_sync[2];\n\n\t// Handshake signals\n\treg s_req;\n\treg [1:0] m_ack;\n\treg m_req;\n\treg [1:0] s_ack;\n\n\t// S domain: detect setup phase start\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_req <= 1'b0;\n\t\t\ts_ack <= 2'b00;\n\t\tend else begin\n\t\t\tif (S_APB_PSEL && !S_APB_PENABLE) begin\n\t\t\t\ts_req <= 1'b1;\n\t\t\tend else if (s_req && s_ack[1]) begin\n\t\t\t\ts_req <= 1'b0;\n\t\t\tend\n\t\t\tif (s_ack[0] && !s_ack[1]) begin\n\t\t\t\ts_ack <= 2'b10;\n\t\t\tend else if (s_ack[1] && !s_req) begin\n\t\t\t\ts_ack <= 2'b00;\n\t\t\tend\n\t\tend\n\tend\n\n\t// M domain: capture request and drive APB\n\treg m_sel;\n\treg m_enable;\n\treg [AW-1:0] m_addr;\n\treg m_write;\n\treg [DW-1:0] m_wdata;\n\treg [DW/8-1:0] m_wstrb;\n\treg [2:0] m_pprot;\n\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_ack <= 2'b00;\n\t\t\tm_req <= 1'b0;\n\t\t\tm_sel <= 1'b0;\n\t\t\tm_enable <= 1'b0;\n\t\t\tm_addr <= {AW{1'b0}};\n\t\t\tm_write <= 1'b0;\n\t\t\tm_wdata <= {DW{1'b0}};\n\t\t\tm_wstrb <= {(DW/8){1'b0}};\n\t\t\tm_pprot <= 3'b000;\n\t\tend else begin\n\t\t\t// Handshake\n\t\t\tif (m_req && m_ack[1]) begin\n\t\t\t\tm_req <= 1'b0;\n\t\t\tend\n\t\t\tif (m_ack[0] && !m_ack[1]) begin\n\t\t\t\tm_ack <= 2'b10;\n\t\t\tend else if (m_ack[1] && !m_req) begin\n\t\t\t\tm_ack <= 2'b00;\n\t\t\tend\n\n\t\t\t// APB state machine\n\t\t\tif (m_sel && !m_enable) begin\n\t\t\t\t// Setup phase: capture request\n\t\t\t\tif (s_req) begin\n\t\t\t\t\tm_addr <= S_APB_PADDR;\n\t\t\t\t\tm_write <= S_APB_PWRITE;\n\t\t\t\t\tm_wdata <= S_APB_PWDATA;\n\t\t\t\t\tm_wstrb <= S_APB_PWSTRB;\n\t\t\t\t\tm_pprot <= S_APB_PPROT;\n\t\t\t\t\tm_sel <= 1'b1;\n\t\t\t\t\tm_enable <= 1'b1;\n\t\t\t\t\tm_req <= 1'b1;\n\t\t\t\tend\n\t\t\tend else if (m_sel && m_enable) begin\n\t\t\t\t// Access phase: wait for PREADY\n\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\tm_sel <= 1'b0;\n\t\t\t\t\tm_enable <= 1'b0;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\tm_sel <= 1'b0;\n\t\t\t\tm_enable <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\tassign M_APB_PSEL = m_sel;\n\tassign M_APB_PENABLE = m_enable;\n\tassign M_APB_PADDR = m_addr;\n\tassign M_APB_PWRITE = m_write;\n\tassign M_APB_PWDATA = m_wdata;\n\tassign M_APB_PWSTRB = m_wstrb;\n\tassign M_APB_PPROT = m_pprot;\n\n\t// Response capture in M domain\n\treg [DW-1:0] m_rdata;\n\treg m_rslverr;\n\treg m_resp_valid;\n\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_rdata <= {DW{1'b0}};\n\t\t\tm_rslverr <= 1'b0;\n\t\t\tm_resp_valid <= 1'b0;\n\t\tend else begin\n\t\t\tif (m_sel && m_enable && M_APB_PREADY) begin\n\t\t\t\tm_rdata <= M_APB_PRDATA;\n\t\t\t\tm_rslverr <= M_APB_PSLVERR;\n\t\t\t\tm_resp_valid <= 1'b1;\n\t\t\tend else if (m_resp_valid && s_ack[1]) begin\n\t\t\t\tm_resp_valid <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// S domain: capture response\n\treg [DW-1:0] s_rdata;\n\treg s_rslverr;\n\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\ts_rdata <= {DW{1'b0}};\n\t\t\ts_rslverr <= 1'b0;\n\t\tend else begin\n\t\t\tif (m_resp_valid) begin\n\t\t\t\ts_rdata <= m_rdata;\n\t\t\t\ts_rslverr <= m_rslverr;\n\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\tend else begin\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\tassign S_APB_PRDATA = s_rdata;\n\tassign S_APB_PSLVERR = s_rslverr;\n\nendmodule\n```<|im_end|>",
