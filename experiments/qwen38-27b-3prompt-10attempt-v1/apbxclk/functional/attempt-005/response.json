  "text": "```verilog\nmodule apbxclk #(\n\tparameter\tC_APB_ADDR_WIDTH = 12,\n\tparameter\tC_APB_DATA_WIDTH = 32,\n\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\tlocalparam\tDW = C_APB_DATA_WIDTH\n) (\n\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\tinput\twire\t\t\tS_APB_PSEL,\n\tinput\twire\t\t\tS_APB_PENABLE,\n\toutput\treg\t\t\tS_APB_PREADY,\n\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\tinput\twire\t\t\tS_APB_PWRITE,\n\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\toutput\twire\t\t\tS_APB_PSLVERR,\n\tinput\twire\t\t\tM_APB_PCLK,\n\toutput\treg\t\t\tM_PRESETn,\n\toutput\treg\t\t\tM_APB_PSEL,\n\toutput\treg\t\t\tM_APB_PENABLE,\n\tinput\twire\t\t\tM_APB_PREADY,\n\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\toutput\twire\t\t\tM_APB_PWRITE,\n\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\tinput\twire\t\t\tM_APB_PSLVERR\n);\n\n\t// Synchronization signals\n\treg [2:0] s2m_sync;\n\treg [2:0] m2s_sync;\n\treg s2m_req;\n\treg m2s_ack;\n\treg m2s_done;\n\n\t// M domain state\n\treg m_busy;\n\treg m_sel;\n\treg m_enable;\n\treg [AW-1:0] m_addr;\n\treg m_write;\n\treg [DW-1:0] m_wdata;\n\treg [DW/8-1:0] m_wstrb;\n\treg [2:0] m_pprot;\n\treg m_rdata_valid;\n\treg [DW-1:0] m_rdata;\n\treg m_pslverr;\n\n\t// S domain state\n\treg s_busy;\n\treg [DW-1:0] s_rdata;\n\treg s_pslverr;\n\n\t// Synchronization logic\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts2m_sync <= 3'b000;\n\t\t\ts2m_req <= 1'b0;\n\t\tend else begin\n\t\t\ts2m_sync <= {s2m_sync[1:0], m2s_ack};\n\t\t\ts2m_req <= m2s_ack;\n\t\tend\n\tend\n\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm2s_sync <= 3'b000;\n\t\t\tm2s_ack <= 1'b0;\n\t\t\tm2s_done <= 1'b0;\n\t\tend else begin\n\t\t\tm2s_sync <= {m2s_sync[1:0], s2m_req};\n\t\t\tm2s_ack <= s2m_req;\n\t\t\tm2s_done <= s2m_req;\n\t\tend\n\tend\n\n\t// M domain control\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tM_PRESETn <= 1'b0;\n\t\t\tm_busy <= 1'b0;\n\t\t\tm_sel <= 1'b0;\n\t\t\tm_enable <= 1'b0;\n\t\t\tm_addr <= {AW{1'b0}};\n\t\t\tm_write <= 1'b0;\n\t\t\tm_wdata <= {DW{1'b0}};\n\t\t\tm_wstrb <= {(DW/8){1'b0}};\n\t\t\tm_pprot <= 3'b000;\n\t\t\tm_rdata_valid <= 1'b0;\n\t\t\tm_rdata <= {DW{1'b0}};\n\t\t\tm_pslverr <= 1'b0;\n\t\tend else begin\n\t\t\tM_PRESETn <= 1'b1;\n\t\t\t\n\t\t\tif (m2s_ack && !m_busy) begin\n\t\t\t\t// Start new transaction\n\t\t\t\tm_busy <= 1'b1;\n\t\t\t\tm_sel <= 1'b1;\n\t\t\t\tm_enable <= 1'b0;\n\t\t\t\tm_addr <= S_APB_PADDR;\n\t\t\t\tm_write <= S_APB_PWRITE;\n\t\t\t\tm_wdata <= S_APB_PWDATA;\n\t\t\t\tm_wstrb <= S_APB_PWSTRB;\n\t\t\t\tm_pprot <= S_APB_PPROT;\n\t\t\t\tm_rdata_valid <= 1'b0;\n\t\t\tend else if (m_busy) begin\n\t\t\t\tif (!m_enable) begin\n\t\t\t\t\t// Setup phase complete, move to access\n\t\t\t\t\tm_enable <= 1'b1;\n\t\t\t\tend else if (M_APB_PREADY) begin\n\t\t\t\t\t// Access phase complete\n\t\t\t\t\tm_busy <= 1'b0;\n\t\t\t\t\tm_sel <= 1'b0;\n\t\t\t\t\tm_enable <= 1'b0;\n\t\t\t\t\tm_rdata_valid <= 1'b1;\n\t\t\t\t\tm_rdata <= M_APB_PRDATA;\n\t\t\t\t\tm_pslverr <= M_APB_PSLVERR;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// M domain outputs\n\tassign M_APB_PSEL = m_sel;\n\tassign M_APB_PENABLE = m_enable;\n\tassign M_APB_PADDR = m_addr;\n\tassign M_APB_PWRITE = m_write;\n\tassign M_APB_PWDATA = m_wdata;\n\tassign M_APB_PWSTRB = m_wstrb;\n\tassign M_APB_PPROT = m_pprot;\n\n\t// S domain control\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\ts_busy <= 1'b0;\n\t\t\ts_rdata <= {DW{1'b0}};\n\t\t\ts_pslverr <= 1'b0;\n\t\tend else begin\n\t\t\tif (s2m_sync[2] && !s_busy) begin\n\t\t\t\t// New transaction request from M domain\n\t\t\t\ts_busy <= 1'b1;\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\tend else if (s_busy) begin\n\t\t\t\tif (s2m_sync[2] && m2s_done) begin\n\t\t\t\t\t// Transaction complete\n\t\t\t\t\ts_busy <= 1'b0;\n\t\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\t\t\ts_rdata <= m_rdata;\n\t\t\t\t\ts_pslverr <= m_pslverr;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// S domain outputs\n\tassign S_APB_PRDATA = s_rdata;\n\tassign S_APB_PSLVERR = s_pslverr;\n\nendmodule\n```<|im_end|>",
