{
  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWFULL_THRESH = DEPTH - 2;\n    localparam AEMPTY_THRESH = 2;\n\n    // Write pointer (ASIZE+1 bits: MSB is extra bit for full detection)\n    reg [ASIZE:0] wptr;\n    // Read pointer (ASIZE+1 bits)\n    reg [ASIZE:0] rptr;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wvalid = winc & ~wfull;\n\n    // Read enable\n    wire rvalid = rinc & ~rempty;\n\n    // Write pointer increment\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr <= 0;\n        else if (wvalid)\n            wptr <= wptr + 1;\n    end\n\n    // Read pointer increment\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr <= 0;\n        else if (rvalid)\n            rptr <= rptr + 1;\n    end\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (wvalid)\n            mem[wptr[ASIZE-1:0]] <= wdata;\n    end\n\n    // Gray code conversion for write pointer\n    wire [ASIZE:0] wptr_gray = wptr ^ {wptr[ASIZE:0], 1'b0}[ASIZE+1:1];\n    // Actually, standard gray code: gray = bin ^ (bin >> 1)\n    wire [ASIZE:0] wptr_gray_calc = wptr ^ (wptr >> 1);\n\n    // Gray code conversion for read pointer\n    wire [ASIZE:0] rptr_gray_calc = rptr ^ (rptr >> 1);\n\n    // Synchronize write pointer gray to read domain\n    reg [ASIZE:0] wptr_gray_r1, wptr_gray_r2;\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_r1 <= 0;\n            wptr_gray_r2 <= 0;\n        end else begin\n            wptr_gray_r1 <= wptr_gray_calc;\n            wptr_gray_r2 <= wptr_gray_r1;\n        end\n    end\n\n    // Synchronize read pointer gray to write domain\n    reg [ASIZE:0] rptr_gray_r1, rptr_gray_r2;\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_r1 <= 0;\n            rptr_gray_r2 <= 0;\n        end else begin\n            rptr_gray_r1 <= rptr_gray_calc;\n            rptr_gray_r2 <= rptr_gray_r1;\n        end\n    end\n\n    // Convert synchronized gray codes back to binary\n    // Gray to binary conversion\n    function [ASIZE:0] gray2bin;\n        input [ASIZE:0] gray;\n        integer i;\n        begin\n            gray2bin[ASIZE] = gray[ASIZE];\n            for (i = ASIZE-1; i >= 0; i = i-1)\n                gray2bin[i] = gray2bin[i+1] ^ gray[i];\n        end\n    endfunction\n\n    wire [ASIZE:0] wptr_gray_synced = gray2bin(wptr_gray_r2);\n    wire [ASIZE:0] rptr_gray_synced = gray2bin(rptr_gray_r2);\n\n    // Full condition: write pointer MSB differs from read pointer MSB,\n    // and lower bits are equal\n    wire wfull = (wptr[ASIZE] != rptr_gray_synced[ASIZE]) &&\n                 (wptr[ASIZE-1:0] == rptr_gray_synced[ASIZE-1:0]);\n\n    // Empty condition: read pointer MSB differs from write pointer MSB,\n    // and lower bits are equal\n    wire rempty = (rptr[ASIZE] != wptr_gray_synced[ASIZE]) &&\n                  (rptr[ASIZE-1:0] == wptr_gray_synced[ASIZE-1:0]);\n\n    // Almost full: number of entries >= AWFULL_THRESH\n    // Count = wptr - rptr (mod 2^(ASIZE+1))\n    // In the write domain, we have wptr and rptr_gray_synced\n    // We need to compute the fill level in the write domain\n    wire [ASIZE:0] fill_level_w = wptr - rptr_gray_synced;\n    wire awfull = (fill_level_w >= AWFULL_THRESH);\n\n    // Almost empty: number of entries <= AEMPTY_THRESH\n    // In the read domain, we have rptr and wptr_gray_synced\n    wire [ASIZE:0] fill_level_r = wptr_gray_synced - rptr;\n    wire arempty = (fill_level_r <= AEMPTY_THRESH);\n\n    // Read data\n    // For fall-through: rdata is the current oldest unread word\n    // For non-fall-through: rdata is registered\n    reg [DSIZE-1:0] rdata_reg;\n    wire [DSIZE-1:0] mem_rdata = mem[rptr[ASIZE-1:0]];\n\n    assign rdata = (FALLTHROUGH == \"TRUE\") ? mem_rdata : rdata_reg;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rdata_reg <= 0;\n        else if (rvalid)\n            rdata_reg <= mem[rptr[ASIZE-1:0]];\n    end\n\nendmodule\n```<|im_end|>",
