  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWFULL_THRESH = DEPTH - 2;\n    localparam AEMPTY_THRESH = 1;\n\n    // Write pointer (ASIZE+1 bits)\n    reg [ASIZE:0] wptr;\n    // Read pointer (ASIZE+1 bits)\n    reg [ASIZE:0] rptr;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Gray code pointers\n    wire [ASIZE:0] wptr_gray = wptr ^ {1'b0, wptr[ASIZE-1:0]} ^ {1'b0, wptr[ASIZE-1:0]};\n    // Proper gray code: gray[i] = ptr[i] ^ ptr[i+1]\n    // Let's compute properly\n    wire [ASIZE:0] wptr_gray_calc;\n    assign wptr_gray_calc[0] = wptr[0];\n    genvar gi;\n    generate\n        for (gi = 1; gi <= ASIZE; gi = gi + 1) begin : gen_wgray\n            assign wptr_gray_calc[gi] = wptr[gi] ^ wptr[gi-1];\n        end\n    endgenerate\n\n    wire [ASIZE:0] rptr_gray_calc;\n    assign rptr_gray_calc[0] = rptr[0];\n    generate\n        for (gi = 1; gi <= ASIZE; gi = gi + 1) begin : gen_rgray\n            assign rptr_gray_calc[gi] = rptr[gi] ^ rptr[gi-1];\n        end\n    endgenerate\n\n    // Synchronizers\n    // Write domain: sync read pointer gray\n    reg [ASIZE:0] rptr_gray_sync1, rptr_gray_sync2;\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_sync1 <= {(ASIZE+1){1'b0}};\n            rptr_gray_sync2 <= {(ASIZE+1){1'b0}};\n        end else begin\n            rptr_gray_sync1 <= rptr_gray_calc;\n            rptr_gray_sync2 <= rptr_gray_sync1;\n        end\n    end\n\n    // Read domain: sync write pointer gray\n    reg [ASIZE:0] wptr_gray_sync1, wptr_gray_sync2;\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_sync1 <= {(ASIZE+1){1'b0}};\n            wptr_gray_sync2 <= {(ASIZE+1){1'b0}};\n        end else begin\n            wptr_gray_sync1 <= wptr_gray_calc;\n            wptr_gray_sync2 <= wptr_gray_sync1;\n        end\n    end\n\n    // Convert gray to binary for comparison\n    // Gray to binary: bin[MSB] = gray[MSB], bin[i] = bin[i+1] ^ gray[i]\n    function [ASIZE:0] gray2bin;\n        input [ASIZE:0] gray;\n        integer i;\n        begin\n            gray2bin[ASIZE] = gray[ASIZE];\n            for (i = ASIZE-1; i >= 0; i = i - 1) begin\n                gray2bin[i] = gray2bin[i+1] ^ gray[i];\n            end\n        end\n    endfunction\n\n    wire [ASIZE:0] rptr_gray_bin = gray2bin(rptr_gray_sync2);\n    wire [ASIZE:0] wptr_gray_bin = gray2bin(wptr_gray_sync2);\n\n    // Write enable\n    wire wvalid = winc & ~wfull;\n    // Read enable\n    wire rvalid = rinc & ~rempty;\n\n    // Full condition: write pointer MSB differs from read pointer MSB, and lower bits equal\n    // wfull: wptr[ASIZE] != rptr_gray_bin[ASIZE] && wptr[ASIZE-1:0] == rptr_gray_bin[ASIZE-1:0]\n    assign wfull = (wptr[ASIZE] != rptr_gray_bin[ASIZE]) && (wptr[ASIZE-1:0] == rptr_gray_bin[ASIZE-1:0]);\n\n    // Almost full: count of entries >= AWFULL_THRESH\n    // Number of entries = (wptr - rptr_gray_bin) mod DEPTH\n    // We can compute the difference\n    wire [ASIZE:0] wdiff = wptr - rptr_gray_bin;\n    assign awfull = (wdiff >= AWFULL_THRESH);\n\n    // Empty condition: read pointer MSB differs from write pointer MSB, and lower bits equal\n    // rempty: rptr[ASIZE] != wptr_gray_bin[ASIZE] && rptr[ASIZE-1:0] == wptr_gray_bin[ASIZE-1:0]\n    assign rempty = (rptr[ASIZE] != wptr_gray_bin[ASIZE]) && (rptr[ASIZE-1:0] == wptr_gray_bin[ASIZE-1:0]);\n\n    // Almost empty: count of entries <= AEMPTY_THRESH\n    wire [ASIZE:0] rdiff = wptr_gray_bin - rptr;\n    assign arempty = (rdiff <= AEMPTY_THRESH);\n\n    // Write pointer update\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr <= {(ASIZE+1){1'b0}};\n        else if (wvalid)\n            wptr <= wptr + 1'b1;\n    end\n\n    // Read pointer update\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr <= {(ASIZE+1){1'b0}};\n        else if (rvalid)\n            rptr <= rptr + 1'b1;\n    end\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (wvalid)\n            mem[wptr[ASIZE-1:0]] <= wdata;\n    end\n\n    // Read data\n    // For fall-through: rdata is the data at the current read pointer (oldest unread word)\n    // For non-fall-through: rdata is registered, updated on accepted read\n    reg [DSIZE-1:0] rdata_reg;\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rdata_reg <= {DSIZE{1'b0}};\n        else if (rvalid)\n            rdata_reg <= mem[rptr[ASIZE-1:0]];\n    end\n\n    // Fall-through: combinational read from memory at current rptr\n    wire [DSIZE-1:0] rdata_comb = mem[rptr[ASIZE-1:0]];\n\n    assign rdata = (FALLTHROUGH == \"TRUE\") ? rdata_comb : rdata_reg;\n\nendmodule\n```<|im_end|>",
