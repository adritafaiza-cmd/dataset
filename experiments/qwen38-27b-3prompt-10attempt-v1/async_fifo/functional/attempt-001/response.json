{
  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWFULL_THRESH = DEPTH - 2;\n    localparam AEMPTY_THRESH = 2;\n\n    // Write pointer (binary)\n    reg [ASIZE:0] wptr;\n    // Read pointer (binary)\n    reg [ASIZE:0] rptr;\n\n    // Synchronizers for read pointer in write domain\n    reg [ASIZE:0] rptr_sync1, rptr_sync2;\n    // Synchronizers for write pointer in read domain\n    reg [ASIZE:0] wptr_sync1, wptr_sync2;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wvalid = winc & ~wfull;\n\n    // Read enable\n    wire rvalid = rinc & ~rempty;\n\n    // Write pointer increment\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr <= 0;\n        else if (wvalid)\n            wptr <= wptr + 1;\n    end\n\n    // Read pointer increment\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr <= 0;\n        else if (rvalid)\n            rptr <= rptr + 1;\n    end\n\n    // Synchronize read pointer to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_sync1 <= 0;\n            rptr_sync2 <= 0;\n        end\n        else begin\n            rptr_sync1 <= rptr;\n            rptr_sync2 <= rptr_sync1;\n        end\n    end\n\n    // Synchronize write pointer to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_sync1 <= 0;\n            wptr_sync2 <= 0;\n        end\n        else begin\n            wptr_sync1 <= wptr;\n            wptr_sync2 <= wptr_sync1;\n        end\n    end\n\n    // Full condition: write pointer has lapped read pointer by DEPTH\n    // In Gray code, full when wptr_gray == rptr_gray with MSB different\n    // Using binary: full when (wptr - rptr_sync2) == DEPTH\n    // But since we're using binary pointers with ASIZE+1 bits, \n    // full when upper bits match and lower bits differ by DEPTH\n    // Actually, with ASIZE+1 bits, full when wptr[ASIZE] != rptr_sync2[ASIZE] \n    // and wptr[ASIZE-1:0] == rptr_sync2[ASIZE-1:0]\n    // This is the standard Gray code full condition applied to binary.\n    // Let's use the standard approach: convert to Gray and compare.\n    \n    // Actually, let's use the simpler binary comparison:\n    // The FIFO is full when the write pointer has advanced DEPTH positions \n    // beyond the read pointer. With ASIZE+1 bits, this means:\n    // wptr[ASIZE] != rptr_sync2[ASIZE] && wptr[ASIZE-1:0] == rptr_sync2[ASIZE-1:0]\n    \n    wire wfull_internal = (wptr[ASIZE] != rptr_sync2[ASIZE]) && \n                          (wptr[ASIZE-1:0] == rptr_sync2[ASIZE-1:0]);\n    \n    assign wfull = wfull_internal;\n\n    // Almost full: number of entries >= AWFULL_THRESH\n    // Count = wptr - rptr_sync2 (mod 2^(ASIZE+1))\n    // We need to check if count >= AWFULL_THRESH\n    // count = wptr - rptr_sync2\n    wire [ASIZE:0] wcount = wptr - rptr_sync2;\n    \n    // awfull when wcount >= AWFULL_THRESH\n    // Since wcount is ASIZE+1 bits and AWFULL_THRESH = DEPTH - 2 = 2^ASIZE - 2\n    // awfull when wcount[ASIZE] == 1 && wcount[ASIZE-1:0] >= (2^ASIZE - 2)\n    // Or more simply, awfull when wcount >= AWFULL_THRESH\n    // Let's use a comparator\n    wire awfull_internal = (wcount >= AWFULL_THRESH[ASIZE:0]);\n    \n    assign awfull = awfull_internal;\n\n    // Empty condition: write pointer equals read pointer\n    wire rempty_internal = (wptr_sync2 == rptr);\n    \n    assign rempty = rempty_internal;\n\n    // Almost empty: number of entries <= AEMPTY_THRESH\n    // count = wptr_sync2 - rptr\n    wire [ASIZE:0] rcount = wptr_sync2 - rptr;\n    \n    // arempty when rcount <= AEMPTY_THRESH\n    // AEMPTY_THRESH = 2\n    wire arempty_internal = (rcount <= AEMPTY_THRESH[ASIZE:0]);\n    \n    assign arempty = arempty_internal;\n\n    // Write to memory\n    always @(posedge wclk) begin\n        if (wvalid)\n            mem[wptr[ASIZE-1:0]] <= wdata;\n    end\n\n    // Read from memory\n    // For FALLTHROUGH = \"TRUE\": rdata is the current oldest unread word\n    // For FALLTHROUGH = \"FALSE\": rdata is updated by an accepted read\n    \n    reg [DSIZE-1:0] rdata_reg;\n    \n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rdata_reg <= 0;\n        else if (rvalid)\n            rdata_reg <= mem[rptr[ASIZE-1:0]];\n    end\n\n    // For fall-through, rdata is the word at the current read pointer\n    // For non-fall-through, rdata is the registered output\n    wire [DSIZE-1:0] rdata_ft = mem[rptr[ASIZE-1:0]];\n    \n    assign rdata = (FALLTHROUGH == \"TRUE\") ? rdata_ft : rdata_reg;\n\nendmodule\n```<|im_end|>",
