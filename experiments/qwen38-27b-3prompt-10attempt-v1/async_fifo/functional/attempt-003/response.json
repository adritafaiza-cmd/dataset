{
  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWFULL_THRESH = DEPTH - 2;\n    localparam AEMPTY_THRESH = 1;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write domain\n    reg [ASIZE:0] wptr;\n    reg [ASIZE:0] rptr_w;\n    reg [ASIZE:0] rptr_w_sync1;\n    reg [ASIZE:0] rptr_w_sync2;\n\n    // Read domain\n    reg [ASIZE:0] rptr;\n    reg [ASIZE:0] wptr_r;\n    reg [ASIZE:0] wptr_r_sync1;\n    reg [ASIZE:0] wptr_r_sync2;\n\n    // Write enable\n    wire wvalid = winc & ~wfull;\n\n    // Read enable\n    wire rvalid = rinc & ~rempty;\n\n    // Write pointer update\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr <= {(ASIZE+1){1'b0}};\n        else if (wvalid)\n            wptr <= wptr + 1'b1;\n    end\n\n    // Read pointer update\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr <= {(ASIZE+1){1'b0}};\n        else if (rvalid)\n            rptr <= rptr + 1'b1;\n    end\n\n    // Synchronize read pointer to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_w_sync1 <= {(ASIZE+1){1'b0}};\n            rptr_w_sync2 <= {(ASIZE+1){1'b0}};\n        end\n        else begin\n            rptr_w_sync1 <= rptr;\n            rptr_w_sync2 <= rptr_w_sync1;\n        end\n    end\n\n    // Synchronize write pointer to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_r_sync1 <= {(ASIZE+1){1'b0}};\n            wptr_r_sync2 <= {(ASIZE+1){1'b0}};\n        end\n        else begin\n            wptr_r_sync1 <= wptr;\n            wptr_r_sync2 <= wptr_r_sync1;\n        end\n    end\n\n    // Write full: wptr - rptr_w_sync2 == DEPTH\n    wire wfull = (wptr[ASIZE] != rptr_w_sync2[ASIZE]) &&\n                 (wptr[ASIZE-1:0] == rptr_w_sync2[ASIZE-1:0]);\n\n    // Read empty: rptr - wptr_r_sync2 == 0\n    wire rempty = (rptr == wptr_r_sync2);\n\n    // Almost full: wptr - rptr_w_sync2 >= DEPTH - 2\n    wire [ASIZE:0] wdiff = wptr - rptr_w_sync2;\n    wire awfull = (wdiff >= AWFULL_THRESH);\n\n    // Almost empty: wptr_r_sync2 - rptr <= 1\n    wire [ASIZE:0] rdiff = wptr_r_sync2 - rptr;\n    wire arempty = (rdiff <= AEMPTY_THRESH);\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (wvalid)\n            mem[wptr[ASIZE-1:0]] <= wdata;\n    end\n\n    // Read data\n    reg [DSIZE-1:0] rdata_reg;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rdata_reg <= {DSIZE{1'b0}};\n        else if (rvalid)\n            rdata_reg <= mem[rptr[ASIZE-1:0]];\n    end\n\n    // Fall-through: combinational read of current oldest word\n    wire [DSIZE-1:0] rdata_comb = mem[rptr[ASIZE-1:0]];\n\n    assign rdata = (FALLTHROUGH == \"TRUE\") ? rdata_comb : rdata_reg;\n\nendmodule\n```<|im_end|>",
