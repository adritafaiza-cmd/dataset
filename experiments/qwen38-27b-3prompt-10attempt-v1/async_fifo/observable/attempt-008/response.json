  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWIDTH = ASIZE + 1;\n    localparam AWIDTH_M1 = ASIZE;\n\n    // Write domain\n    reg  [AWIDTH-1:0] wptr;\n    reg  [AWIDTH-1:0] wptr_gray;\n    reg  [AWIDTH-1:0] rptr_gray_w;\n    reg  [AWIDTH-1:0] rptr_gray_w_sync1;\n    reg  [AWIDTH-1:0] rptr_gray_w_sync2;\n\n    // Read domain\n    reg  [AWIDTH-1:0] rptr;\n    reg  [AWIDTH-1:0] rptr_gray;\n    reg  [AWIDTH-1:0] wptr_gray_r;\n    reg  [AWIDTH-1:0] wptr_gray_r_sync1;\n    reg  [AWIDTH-1:0] wptr_gray_r_sync2;\n\n    // Memory\n    reg  [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wfull_local;\n    wire awfull_local;\n    wire winc_eff;\n\n    // Read enable\n    wire rempty_local;\n    wire arempty_local;\n    wire rinc_eff;\n\n    // Gray code conversion\n    function [AWIDTH-1:0] bin2gray;\n        input [AWIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [AWIDTH-1:0] gray2bin;\n        input [AWIDTH-1:0] gray;\n        reg [AWIDTH-1:0] bin;\n        integer i;\n        begin\n            bin[AWIDTH-1] = gray[AWIDTH-1];\n            for (i = AWIDTH-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Write domain logic\n    assign wfull_local = (wptr_gray == rptr_gray_w_sync2) && (wptr[AWIDTH-1] != rptr_gray_w_sync2[AWIDTH-1]);\n    assign awfull_local = (wptr_gray == rptr_gray_w_sync2) || (wptr_gray == rptr_gray_w_sync2 ^ {{(AWIDTH-1){1'b0}}, 1'b1});\n\n    assign winc_eff = winc && !wfull_local;\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {AWIDTH{1'b0}};\n            wptr_gray <= {AWIDTH{1'b0}};\n        end else if (winc_eff) begin\n            wptr <= wptr + 1'b1;\n            wptr_gray <= bin2gray(wptr + 1'b1);\n        end\n    end\n\n    // Synchronize read pointer gray to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_w <= {AWIDTH{1'b0}};\n            rptr_gray_w_sync1 <= {AWIDTH{1'b0}};\n            rptr_gray_w_sync2 <= {AWIDTH{1'b0}};\n        end else begin\n            rptr_gray_w <= rptr_gray;\n            rptr_gray_w_sync1 <= rptr_gray_w;\n            rptr_gray_w_sync2 <= rptr_gray_w_sync1;\n        end\n    end\n\n    // Read domain logic\n    assign rempty_local = (rptr_gray == wptr_gray_r_sync2);\n    assign arempty_local = (rptr_gray == wptr_gray_r_sync2) || (rptr_gray == wptr_gray_r_sync2 ^ {{(AWIDTH-1){1'b0}}, 1'b1});\n\n    assign rinc_eff = rinc && !rempty_local;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {AWIDTH{1'b0}};\n            rptr_gray <= {AWIDTH{1'b0}};\n        end else if (rinc_eff) begin\n            rptr <= rptr + 1'b1;\n            rptr_gray <= bin2gray(rptr + 1'b1);\n        end\n    end\n\n    // Synchronize write pointer gray to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_r <= {AWIDTH{1'b0}};\n            wptr_gray_r_sync1 <= {AWIDTH{1'b0}};\n            wptr_gray_r_sync2 <= {AWIDTH{1'b0}};\n        end else begin\n            wptr_gray_r <= wptr_gray;\n            wptr_gray_r_sync1 <= wptr_gray_r;\n            wptr_gray_r_sync2 <= wptr_gray_r_sync1;\n        end\n    end\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (winc_eff)\n            mem[wptr[AWIDTH_M1-1:0]] <= wdata;\n    end\n\n    // Memory read\n    reg [DSIZE-1:0] rdata_reg;\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rdata_reg <= {DSIZE{1'b0}};\n        else if (rinc_eff)\n            rdata_reg <= mem[rptr[AWIDTH_M1-1:0]];\n    end\n\n    assign rdata = rdata_reg;\n\n    // Outputs\n    assign wfull = wfull_local;\n    assign awfull = awfull_local;\n    assign rempty = rempty_local;\n    assign arempty = arempty_local;\n\nendmodule\n```<|im_end|>",
