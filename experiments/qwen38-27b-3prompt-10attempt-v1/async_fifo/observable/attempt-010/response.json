  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam AWIDTH = ASIZE;\n    localparam DEPTH  = 1 << ASIZE;\n    localparam AWIDTH_PLUS_1 = ASIZE + 1;\n\n    // Write domain\n    reg  [AWIDTH-1:0] wptr;\n    reg  [AWIDTH_PLUS_1-1:0] wptr_gray;\n    reg  [AWIDTH_PLUS_1-1:0] wptr_gray_next;\n    reg  [AWIDTH_PLUS_1-1:0] rptr_gray_w;\n    reg  [AWIDTH_PLUS_1-1:0] rptr_gray_w1;\n    reg  [AWIDTH_PLUS_1-1:0] rptr_gray_w2;\n\n    // Read domain\n    reg  [AWIDTH-1:0] rptr;\n    reg  [AWIDTH_PLUS_1-1:0] rptr_gray;\n    reg  [AWIDTH_PLUS_1-1:0] rptr_gray_next;\n    reg  [AWIDTH_PLUS_1-1:0] wptr_gray_r;\n    reg  [AWIDTH_PLUS_1-1:0] wptr_gray_r1;\n    reg  [AWIDTH_PLUS_1-1:0] wptr_gray_r2;\n\n    // Memory\n    reg  [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wfull_local;\n    wire awfull_local;\n    wire winc_eff;\n\n    // Read enable\n    wire rempty_local;\n    wire arempty_local;\n    wire rinc_eff;\n\n    // Gray code conversion\n    function [AWIDTH_PLUS_1-1:0] bin2gray;\n        input [AWIDTH_PLUS_1-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Write pointer update\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {AWIDTH{1'b0}};\n            wptr_gray <= {AWIDTH_PLUS_1{1'b0}};\n        end else begin\n            wptr <= wptr + (winc_eff ? 1'b1 : 1'b0);\n            wptr_gray <= wptr_gray_next;\n        end\n    end\n\n    assign wptr_gray_next = bin2gray(wptr + (winc_eff ? 1'b1 : 1'b0));\n\n    // Read pointer update\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {AWIDTH{1'b0}};\n            rptr_gray <= {AWIDTH_PLUS_1{1'b0}};\n        end else begin\n            rptr <= rptr + (rinc_eff ? 1'b1 : 1'b0);\n            rptr_gray <= rptr_gray_next;\n        end\n    end\n\n    assign rptr_gray_next = bin2gray(rptr + (rinc_eff ? 1'b1 : 1'b0));\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (winc_eff) begin\n            mem[wptr] <= wdata;\n        end\n    end\n\n    // Memory read\n    reg [DSIZE-1:0] rdata_reg;\n    always @(posedge rclk) begin\n        if (rinc_eff) begin\n            rdata_reg <= mem[rptr];\n        end\n    end\n\n    // Fall-through logic\n    wire fallthrough_en = (FALLTHROUGH == \"TRUE\");\n    wire fallthrough_valid = fallthrough_en & rempty_local & winc_eff;\n    assign rdata = fallthrough_valid ? wdata : rdata_reg;\n\n    // Synchronize read pointer gray to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_w <= {AWIDTH_PLUS_1{1'b0}};\n            rptr_gray_w1 <= {AWIDTH_PLUS_1{1'b0}};\n            rptr_gray_w2 <= {AWIDTH_PLUS_1{1'b0}};\n        end else begin\n            rptr_gray_w <= rptr_gray;\n            rptr_gray_w1 <= rptr_gray_w;\n            rptr_gray_w2 <= rptr_gray_w1;\n        end\n    end\n\n    // Synchronize write pointer gray to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_r <= {AWIDTH_PLUS_1{1'b0}};\n            wptr_gray_r1 <= {AWIDTH_PLUS_1{1'b0}};\n            wptr_gray_r2 <= {AWIDTH_PLUS_1{1'b0}};\n        end else begin\n            wptr_gray_r <= wptr_gray;\n            wptr_gray_r1 <= wptr_gray_r;\n            wptr_gray_r2 <= wptr_gray_r1;\n        end\n    end\n\n    // Full/empty detection in write domain\n    // Full: write pointer gray MSB differs from read pointer gray MSB, and lower bits are complement\n    wire [AWIDTH_PLUS_1-1:0] wptr_gray_w2;\n    assign wptr_gray_w2 = wptr_gray;\n\n    wire wfull_raw = (wptr_gray_w2[AWIDTH] != rptr_gray_w2[AWIDTH]) &&\n                     (wptr_gray_w2[AWIDTH-1:0] == ~rptr_gray_w2[AWIDTH-1:0]);\n\n    // Almost full: one less than full\n    wire [AWIDTH_PLUS_1-1:0] wptr_gray_next_w2;\n    assign wptr_gray_next_w2 = wptr_gray_next;\n\n    wire awfull_raw = (wptr_gray_next_w2[AWIDTH] != rptr_gray_w2[AWIDTH]) &&\n                      (wptr_gray_next_w2[AWIDTH-1:0] == ~rptr_gray_w2[AWIDTH-1:0]);\n\n    assign wfull = wfull_raw;\n    assign awfull = awfull_raw;\n\n    // Empty detection in read domain\n    wire rempty_raw = (wptr_gray_r2 == rptr_gray);\n\n    // Almost empty: one more than empty\n    wire [AWIDTH_PLUS_1-1:0] rptr_gray_next_r2;\n    assign rptr_gray_next_r2 = rptr_gray_next;\n\n    wire arempty_raw = (wptr_gray_r2 == rptr_gray_next_r2);\n\n    assign rempty = rempty_raw;\n    assign arempty = arempty_raw;\n\n    // Effective write enable: only write if not full\n    assign winc_eff = winc & ~wfull;\n\n    // Effective read enable: only read if not empty\n    assign rinc_eff = rinc & ~rempty;\n\nendmodule\n```<|im_end|>",
