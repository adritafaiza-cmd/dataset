{
  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWIDTH = ASIZE + 1;\n    localparam AWIDTH_MINUS_1 = AWIDTH - 1;\n\n    // Write domain\n    reg [AWIDTH_MINUS_1:0] wptr;\n    reg [AWIDTH_MINUS_1:0] wptr_gray;\n    reg [AWIDTH_MINUS_1:0] wptr_gray_next;\n    reg [AWIDTH_MINUS_1:0] rptr_gray_w;\n    reg [AWIDTH_MINUS_1:0] rptr_gray_w_sync1;\n    reg [AWIDTH_MINUS_1:0] rptr_gray_w_sync2;\n\n    // Read domain\n    reg [AWIDTH_MINUS_1:0] rptr;\n    reg [AWIDTH_MINUS_1:0] rptr_gray;\n    reg [AWIDTH_MINUS_1:0] rptr_gray_next;\n    reg [AWIDTH_MINUS_1:0] wptr_gray_r;\n    reg [AWIDTH_MINUS_1:0] wptr_gray_r_sync1;\n    reg [AWIDTH_MINUS_1:0] wptr_gray_r_sync2;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wfull_local;\n    wire awfull_local;\n    wire winc_valid;\n\n    // Read enable\n    wire rempty_local;\n    wire arempty_local;\n    wire rinc_valid;\n\n    // Gray code conversion\n    function [AWIDTH_MINUS_1:0] bin2gray;\n        input [AWIDTH_MINUS_1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [AWIDTH_MINUS_1:0] gray2bin;\n        input [AWIDTH_MINUS_1:0] gray;\n        reg [AWIDTH_MINUS_1:0] bin;\n        integer i;\n        begin\n            bin[AWIDTH_MINUS_1] = gray[AWIDTH_MINUS_1];\n            for (i = AWIDTH_MINUS_1 - 1; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Write domain logic\n    assign wfull_local = (wptr_gray_next == rptr_gray_w_sync2) && (wptr[AWIDTH_MINUS_1] != rptr_gray_w_sync2[AWIDTH_MINUS_1]);\n    assign awfull_local = (wptr_gray_next == rptr_gray_w_sync2) || (wptr_gray_next == rptr_gray_w_sync2 ^ (1 << (AWIDTH_MINUS_1 - 1)));\n    \n    // Actually, let's use the standard approach:\n    // wfull: wptr_gray_next == rptr_gray_w_sync2 and MSB differs\n    // awfull: wptr_gray_next == rptr_gray_w_sync2 or wptr_gray_next == rptr_gray_w_sync2 with one bit different (almost full)\n    \n    // Let me recalculate:\n    // wptr_gray_next is the gray code of wptr + 1\n    // wfull when wptr_gray_next == rptr_gray_w_sync2 and the MSB of wptr differs from MSB of rptr_gray_w_sync2\n    // awfull when wptr_gray_next == rptr_gray_w_sync2 or wptr_gray_next == rptr_gray_w_sync2 ^ (1 << (AWIDTH_MINUS_1 - 1))\n    \n    // Actually, the standard CDC FIFO approach:\n    // wfull: wptr_gray_next == rptr_gray_w_sync2 && wptr[MSB] != rptr_gray_w_sync2[MSB]\n    // awfull: wptr_gray_next == rptr_gray_w_sync2 || wptr_gray_next == rptr_gray_w_sync2 ^ (1 << (AWIDTH_MINUS_1 - 1))\n    \n    // But we need to be careful. Let me use a cleaner approach.\n    \n    // Write pointer increment\n    wire winc_accepted = winc && !wfull_local;\n    \n    // Read pointer increment\n    wire rinc_accepted = rinc && !rempty_local;\n    \n    // Write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {AWIDTH{1'b0}};\n            wptr_gray <= {AWIDTH{1'b0}};\n            wptr_gray_next <= {AWIDTH{1'b0}};\n            rptr_gray_w_sync1 <= {AWIDTH{1'b0}};\n            rptr_gray_w_sync2 <= {AWIDTH{1'b0}};\n        end else begin\n            if (winc_accepted) begin\n                wptr <= wptr + 1'b1;\n            end\n            wptr_gray <= bin2gray(wptr);\n            wptr_gray_next <= bin2gray(wptr + 1'b1);\n            rptr_gray_w_sync1 <= rptr_gray_w_sync2;\n            rptr_gray_w_sync2 <= rptr_gray_r;\n        end\n    end\n    \n    // Read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {AWIDTH{1'b0}};\n            rptr_gray <= {AWIDTH{1'b0}};\n            rptr_gray_next <= {AWIDTH{1'b0}};\n            wptr_gray_r_sync1 <= {AWIDTH{1'b0}};\n            wptr_gray_r_sync2 <= {AWIDTH{1'b0}};\n        end else begin\n            if (rinc_accepted) begin\n                rptr <= rptr + 1'b1;\n            end\n            rptr_gray <= bin2gray(rptr);\n            rptr_gray_next <= bin2gray(rptr + 1'b1);\n            wptr_gray_r_sync1 <= wptr_gray_r_sync2;\n            wptr_gray_r_sync2 <= wptr_gray_w;\n        end\n    end\n    \n    // Memory write\n    always @(posedge wclk) begin\n        if (winc_accepted) begin\n            mem[wptr[ASIZE-1:0]] <= wdata;\n        end\n    end\n    \n    // Memory read\n    reg [DSIZE-1:0] rdata_reg;\n    always @(posedge rclk) begin\n        if (rinc_accepted) begin\n            rdata_reg <= mem[rptr[ASIZE-1:0]];\n        end\n    end\n    \n    // Flags\n    assign wfull = wfull_local;\n    assign awfull = awfull_local;\n    assign rempty = rempty_local;\n    assign arempty = arempty_local;\n    assign rdata = rdata_reg;\n    \n    // Cross-domain pointer sync\n    assign wptr_gray_w = wptr_gray;\n    assign rptr_gray_r = rptr_gray;\n    \n    // Full/Empty detection\n    // wfull: wptr_gray_next == rptr_gray_w_sync2 and MSB differs\n    assign wfull_local = (wptr_gray_next == rptr_gray_w_sync2) && (wptr[AWIDTH_MINUS_1] != rptr_gray_w_sync2[AWIDTH_MINUS_1]);\n    \n    // awfull: almost full, one more write would make it full\n    // This is when wptr_gray_next == rptr_gray_w_sync2 ^ (1 << (AWIDTH_MINUS_1 - 1))\n    assign awfull_local = (wptr_gray_next == rptr_gray_w_sync2) || (wptr_gray_next == (rptr_gray_w_sync2 ^ (1 << (AWIDTH_MINUS_1 - 1))));\n    \n    // rempty: rptr_gray_next == wptr_gray_r_sync2\n    assign rempty_local = (rptr_gray_next == wptr_gray_r_sync2);\n    \n    // arempty: almost empty, one more read would make it empty\n    assign arempty_local = (rptr_gray_next == wptr_gray_r_sync2) || (rptr_gray_next == (wptr_gray_r_sync2 ^ (1 << (AWIDTH_MINUS_1 - 1))));\n\nendmodule\n```<|im_end|>",
