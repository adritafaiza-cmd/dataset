  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWIDTH = ASIZE + 1;\n    localparam FULL_THRESHOLD = DEPTH - 1;\n    localparam EMPTY_THRESHOLD = 1;\n\n    // Write domain\n    reg [AWIDTH-1:0] wptr;\n    reg [ASIZE-1:0]  wptr_gray;\n    reg [ASIZE-1:0]  rptr_gray_w;\n    reg [ASIZE-1:0]  rptr_gray_w_sync1;\n    reg [ASIZE-1:0]  rptr_gray_w_sync2;\n\n    // Read domain\n    reg [AWIDTH-1:0] rptr;\n    reg [ASIZE-1:0]  rptr_gray;\n    reg [ASIZE-1:0]  wptr_gray_r;\n    reg [ASIZE-1:0]  wptr_gray_r_sync1;\n    reg [ASIZE-1:0]  wptr_gray_r_sync2;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wvalid = winc & ~wfull;\n\n    // Read enable\n    wire rvalid = rinc & ~rempty;\n\n    // Gray code conversion\n    function [ASIZE-1:0] bin2gray;\n        input [ASIZE-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Write pointer update\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {AWIDTH{1'b0}};\n        end else if (wvalid) begin\n            wptr <= wptr + 1'b1;\n        end\n    end\n\n    // Write pointer gray code\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr_gray <= {ASIZE{1'b0}};\n        end else begin\n            wptr_gray <= bin2gray(wptr[ASIZE:1]);\n        end\n    end\n\n    // Read pointer gray code\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {AWIDTH{1'b0}};\n        end else if (rvalid) begin\n            rptr <= rptr + 1'b1;\n        end\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr_gray <= {ASIZE{1'b0}};\n        end else begin\n            rptr_gray <= bin2gray(rptr[ASIZE:1]);\n        end\n    end\n\n    // Synchronize read pointer gray to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_w_sync1 <= {ASIZE{1'b0}};\n            rptr_gray_w_sync2 <= {ASIZE{1'b0}};\n        end else begin\n            rptr_gray_w_sync1 <= rptr_gray;\n            rptr_gray_w_sync2 <= rptr_gray_w_sync1;\n        end\n    end\n\n    // Synchronize write pointer gray to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_r_sync1 <= {ASIZE{1'b0}};\n            wptr_gray_r_sync2 <= {ASIZE{1'b0}};\n        end else begin\n            wptr_gray_r_sync1 <= wptr_gray;\n            wptr_gray_r_sync2 <= wptr_gray_r_sync1;\n        end\n    end\n\n    // Full detection in write domain\n    // Full when write pointer has lapped read pointer by DEPTH\n    // In gray code, full when wptr_gray[ASIZE] == rptr_gray_sync[ASIZE] and wptr_gray[ASIZE-1:0] == ~rptr_gray_sync[ASIZE-1:0]\n    wire [ASIZE:0] wptr_gray_ext = {wptr[ASIZE], wptr_gray};\n    wire [ASIZE:0] rptr_gray_w_ext = {rptr_gray_w_sync2[ASIZE-1], rptr_gray_w_sync2};\n    \n    // Actually, let's use the standard approach:\n    // Full when the MSB of write pointer equals MSB of read pointer, and the lower bits are inverted\n    wire wfull_internal = (wptr[ASIZE] == rptr_gray_w_sync2[ASIZE-1]) && \n                          (wptr[ASIZE-1:0] == ~rptr_gray_w_sync2);\n    \n    // Wait, the standard gray code full detection:\n    // wptr_gray has ASIZE+1 bits conceptually, but we only store ASIZE bits of gray\n    // Let me reconsider. The write pointer is AWIDTH bits. The gray code of the upper ASIZE bits is stored.\n    // Full condition: wptr[ASIZE] == rptr_gray_sync[ASIZE-1] && wptr[ASIZE-1:0] == ~rptr_gray_sync[ASIZE-1:0]\n    \n    assign wfull = wfull_internal;\n\n    // Almost full: DEPTH - FULL_THRESHOLD words remaining\n    // awfull when (wptr - rptr_sync) >= FULL_THRESHOLD\n    // In terms of distance: awfull when the difference is >= FULL_THRESHOLD\n    // We can compute this by checking if wptr[ASIZE:1] - rptr_gray_sync[ASIZE:1] >= FULL_THRESHOLD\n    // But since we're in gray code, it's easier to convert back or use a different approach.\n    \n    // Let's use a simpler approach: awfull when the number of free slots <= 1\n    // i.e., when wptr - rptr_sync >= DEPTH - 1\n    // This is equivalent to wfull being about to happen, so awfull = wfull_internal or one step before\n    \n    // Actually, let's compute the distance properly.\n    // The distance in write domain: wptr - rptr_sync (where rptr_sync is the synchronized read pointer)\n    // We need to convert rptr_gray_sync back to binary, or use the property that\n    // awfull when wptr[ASIZE:1] - rptr_gray_sync[ASIZE:1] >= FULL_THRESHOLD\n    \n    // For simplicity and correctness, let's use a counter-based approach or direct comparison.\n    // Since ASIZE is small, we can afford a small combinational logic.\n    \n    // Convert rptr_gray_sync to binary for distance calculation\n    function [ASIZE-1:0] gray2bin;\n        input [ASIZE-1:0] gray;\n        integer i;\n        begin\n            gray2bin[ASIZE-1] = gray[ASIZE-1];\n            for (i = ASIZE-2; i >= 0; i = i - 1)\n                gray2bin[i] = gray2bin[i+1] ^ gray[i];\n        end\n    endfunction\n\n    wire [ASIZE-1:0] rptr_bin_w = gray2bin(rptr_gray_w_sync2);\n    wire [ASIZE-1:0] wptr_low = wptr[ASIZE-1:0];\n    \n    // Distance = wptr - rptr_sync (mod DEPTH)\n    // awfull when distance >= FULL_THRESHOLD\n    wire [ASIZE:0] dist_w = {1'b0, wptr_low} - {1'b0, rptr_bin_w};\n    assign awfull = (dist_w >= FULL_THRESHOLD[ASIZE:0]);\n\n    // Empty detection in read domain\n    wire rempty_internal = (rptr[ASIZE] == wptr_gray_r_sync2[ASIZE-1]) && \n                           (rptr[ASIZE-1:0] == wptr_gray_r_sync2);\n    assign rempty = rempty_internal;\n\n    // Almost empty: DEPTH - EMPTY_THRESHOLD words remaining\n    // arempty when (wptr_sync - rptr) <= EMPTY_THRESHOLD\n    // i.e., when distance <= 1\n    wire [ASIZE-1:0] wptr_bin_r = gray2bin(wptr_gray_r_sync2);\n    wire [ASIZE-1:0] rptr_low = rptr[ASIZE-1:0];\n    wire [ASIZE:0] dist_r = {1'b0, wptr_bin_r} - {1'b0, rptr_low};\n    assign arempty = (dist_r <= EMPTY_THRESHOLD[ASIZE:0]);\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (wvalid) begin\n            mem[wptr[ASIZE-1:0]] <= wdata;\n        end\n    end\n\n    // Read data\n    wire [ASIZE-1:0] raddr = rptr[ASIZE-1:0];\n    wire [DSIZE-1:0] mem_rdata = mem[raddr];\n\n    // Fall-through logic\n    reg [DSIZE-1:0] rdata_reg;\n    \n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata_reg <= {DSIZE{1'b0}};\n        end else if (rvalid) begin\n            rdata_reg <= mem_rdata;\n        end\n    end\n\n    assign rdata = (FALLTHROUGH == \"TRUE\") ? mem_rdata : rdata_reg;\n\nendmodule\n```<|im_end|>",
