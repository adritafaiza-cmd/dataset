  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWIDTH = ASIZE + 1;\n    localparam FULL_THRESHOLD = DEPTH - 1;\n    localparam EMPTY_THRESHOLD = 1;\n\n    // Write domain\n    reg [AWIDTH-1:0] wptr;\n    reg [ASIZE-1:0]  wptr_gray;\n    reg [ASIZE-1:0]  rptr_gray_w;\n    reg [ASIZE-1:0]  rptr_gray_w_sync1;\n    reg [ASIZE-1:0]  rptr_gray_w_sync2;\n\n    // Read domain\n    reg [AWIDTH-1:0] rptr;\n    reg [ASIZE-1:0]  rptr_gray;\n    reg [ASIZE-1:0]  wptr_gray_r;\n    reg [ASIZE-1:0]  wptr_gray_r_sync1;\n    reg [ASIZE-1:0]  wptr_gray_r_sync2;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wvalid = winc & ~wfull;\n    wire rvalid = rinc & ~rempty;\n\n    // Gray code conversion\n    function [ASIZE-1:0] bin2gray;\n        input [AWIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Write pointer update\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {AWIDTH{1'b0}};\n        end else if (wvalid) begin\n            wptr <= wptr + 1'b1;\n        end\n    end\n\n    // Write pointer gray code\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr_gray <= {ASIZE{1'b0}};\n        end else begin\n            wptr_gray <= bin2gray(wptr)[ASIZE-1:0];\n        end\n    end\n\n    // Read pointer gray code (read domain)\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {AWIDTH{1'b0}};\n        end else if (rvalid) begin\n            rptr <= rptr + 1'b1;\n        end\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr_gray <= {ASIZE{1'b0}};\n        end else begin\n            rptr_gray <= bin2gray(rptr)[ASIZE-1:1];\n        end\n    end\n\n    // Synchronize read pointer gray to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_w_sync1 <= {ASIZE{1'b0}};\n            rptr_gray_w_sync2 <= {ASIZE{1'b0}};\n        end else begin\n            rptr_gray_w_sync1 <= rptr_gray;\n            rptr_gray_w_sync2 <= rptr_gray_w_sync1;\n        end\n    end\n\n    // Synchronize write pointer gray to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_r_sync1 <= {ASIZE{1'b0}};\n            wptr_gray_r_sync2 <= {ASIZE{1'b0}};\n        end else begin\n            wptr_gray_r_sync1 <= wptr_gray;\n            wptr_gray_r_sync2 <= wptr_gray_r_sync1;\n        end\n    end\n\n    // Full detection in write domain\n    // Full when write pointer has lapped read pointer by DEPTH\n    // In gray code: wptr_gray == rptr_gray_w_sync2 with MSB of wptr != MSB of rptr\n    wire [ASIZE-1:0] wptr_gray_full = bin2gray(wptr)[ASIZE-1:0];\n    wire wfull_internal = (wptr_gray_full == rptr_gray_w_sync2) && \n                          (wptr[ASIZE] != rptr_gray_w_sync2[ASIZE-1]);\n    assign wfull = wfull_internal;\n\n    // Almost full: one less than full\n    wire [AWIDTH-1:0] wptr_next = wptr + 1'b1;\n    wire [ASIZE-1:0] wptr_gray_next = bin2gray(wptr_next)[ASIZE-1:0];\n    wire awfull_internal = (wptr_gray_next == rptr_gray_w_sync2) && \n                           (wptr_next[ASIZE] != rptr_gray_w_sync2[ASIZE-1]);\n    assign awfull = awfull_internal;\n\n    // Empty detection in read domain\n    // Empty when read pointer == write pointer\n    wire [ASIZE-1:0] rptr_gray_empty = bin2gray(rptr)[ASIZE-1:0];\n    wire rempty_internal = (rptr_gray_empty == wptr_gray_r_sync2) && \n                           (rptr[ASIZE] == wptr_gray_r_sync2[ASIZE-1]);\n    assign rempty = rempty_internal;\n\n    // Almost empty: one more than empty\n    wire [AWIDTH-1:0] rptr_next = rptr + 1'b1;\n    wire [ASIZE-1:0] rptr_gray_next = bin2gray(rptr_next)[ASIZE-1:0];\n    wire arempty_internal = (rptr_gray_next == wptr_gray_r_sync2) && \n                            (rptr_next[ASIZE] == wptr_gray_r_sync2[ASIZE-1]);\n    assign arempty = arempty_internal;\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (wvalid) begin\n            mem[wptr[ASIZE-1:0]] <= wdata;\n        end\n    end\n\n    // Read data output\n    reg [DSIZE-1:0] rdata_reg;\n    wire [ASIZE-1:0] raddr = rptr[ASIZE-1:0];\n\n    if (FALLTHROUGH == \"TRUE\") begin\n        assign rdata = mem[raddr];\n    end else begin\n        always @(posedge rclk or negedge rrst_n) begin\n            if (!rrst_n) begin\n                rdata_reg <= {DSIZE{1'b0}};\n            end else if (rvalid) begin\n                rdata_reg <= mem[raddr];\n            end\n        end\n        assign rdata = rdata_reg;\n    end\n\nendmodule\n```<|im_end|>",
