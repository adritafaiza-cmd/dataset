  "text": "```verilog\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam DEPTH = 1 << ASIZE;\n    localparam AWIDTH = ASIZE + 1;\n    localparam AWIDTH_M1 = AWIDTH - 1;\n\n    // Write domain\n    reg [AWIDTH-1:0] wptr;\n    reg [ASIZE-1:0]  wptr_gray;\n    reg [ASIZE-1:0]  rptr_gray_w;\n    reg [ASIZE-1:0]  rptr_gray_w_sync1;\n    reg [ASIZE-1:0]  rptr_gray_w_sync2;\n\n    // Read domain\n    reg [AWIDTH-1:0] rptr;\n    reg [ASIZE-1:0]  rptr_gray;\n    reg [ASIZE-1:0]  wptr_gray_r;\n    reg [ASIZE-1:0]  wptr_gray_r_sync1;\n    reg [ASIZE-1:0]  wptr_gray_r_sync2;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wfull_int;\n    wire winc_eff;\n    wire wfull;\n    wire awfull;\n\n    // Read enable\n    wire rempty_int;\n    wire rinc_eff;\n    wire rempty;\n    wire arempty;\n\n    // Gray code conversion functions\n    function [ASIZE-1:0] bin2gray;\n        input [ASIZE-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [ASIZE-1:0] gray2bin;\n        input [ASIZE-1:0] gray;\n        reg [ASIZE-1:0] bin;\n        integer i;\n        begin\n            bin[ASIZE-1] = gray[ASIZE-1];\n            for (i = ASIZE-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Write domain logic\n    assign wfull_int = (wptr_gray == rptr_gray_w_sync2) && (wptr[ASIZE-1] != rptr_gray_w_sync2[ASIZE-1]);\n    assign wfull = wfull_int;\n    assign awfull = wfull_int || (wptr[ASIZE-1] == rptr_gray_w_sync2[ASIZE-1] && wptr[ASIZE-2:0] == rptr_gray_w_sync2[ASIZE-2:0] && wptr[ASIZE-1] == 1'b1);\n    // Simpler almost full: one less than full\n    assign awfull = (wptr_gray == rptr_gray_w_sync2) && (wptr[ASIZE-1] != rptr_gray_w_sync2[ASIZE-1]) || \n                    (wptr[ASIZE-1] == rptr_gray_w_sync2[ASIZE-1] && wptr[ASIZE-2:0] == rptr_gray_w_sync2[ASIZE-2:0] && wptr[ASIZE-1] == 1'b1);\n\n    // Let me redo the almost full logic properly\n    // Full: wptr_gray == rptr_gray_w_sync2 AND wptr[ASIZE-1] != rptr_gray_w_sync2[ASIZE-1]\n    // Almost full: one write away from full\n    // This means: (wptr_gray == rptr_gray_w_sync2) && (wptr[ASIZE-1] == rptr_gray_w_sync2[ASIZE-1]) && (wptr[ASIZE-2:0] == rptr_gray_w_sync2[ASIZE-2:0] - 1)\n    // Or more simply, check if the next write would make it full\n\n    // Let me use a cleaner approach\n    wire [AWIDTH-1:0] wptr_bin;\n    wire [AWIDTH-1:0] rptr_bin_w;\n    wire [AWIDTH-1:0] rptr_bin_r;\n    wire [AWIDTH-1:0] wptr_bin_r;\n\n    assign wptr_bin = wptr;\n    assign rptr_bin_w = {1'b0, gray2bin(rptr_gray_w_sync2)};\n    assign rptr_bin_r = rptr;\n    assign wptr_bin_r = {1'b0, gray2bin(wptr_gray_r_sync2)};\n\n    // Full condition: write pointer has lapped read pointer by exactly DEPTH\n    assign wfull_int = (wptr[ASIZE-1] != rptr_gray_w_sync2[ASIZE-1]) && (wptr_gray == rptr_gray_w_sync2);\n    assign wfull = wfull_int;\n\n    // Almost full: one less than full\n    // wptr - rptr == DEPTH - 1\n    // In gray code terms, this is trickier. Let's use binary comparison.\n    // wptr_bin - rptr_bin_w == DEPTH - 1\n    // Since we're in write domain, rptr_bin_w is the synchronized read pointer\n    assign awfull = (wptr[ASIZE-1] == rptr_gray_w_sync2[ASIZE-1]) && \n                    (wptr[ASIZE-2:0] == rptr_gray_w_sync2[ASIZE-2:0] - 1'b1) ||\n                    (wptr[ASIZE-1] != rptr_gray_w_sync2[ASIZE-1]) && \n                    (wptr_gray == rptr_gray_w_sync2);\n\n    // Hmm, this is getting complicated. Let me use a simpler approach with binary counters.\n\n    // Actually, let me restart with a cleaner design using binary pointers and gray code for CDC.\n\n    // Write domain\n    reg [AWIDTH-1:0] wptr_bin;\n    reg [ASIZE-1:0]  wptr_gray;\n    reg [ASIZE-1:0]  rptr_gray_w_sync1;\n    reg [ASIZE-1:0]  rptr_gray_w_sync2;\n\n    // Read domain\n    reg [AWIDTH-1:0] rptr_bin;\n    reg [ASIZE-1:0]  rptr_gray;\n    reg [ASIZE-1:0]  wptr_gray_r_sync1;\n    reg [ASIZE-1:0]  wptr_gray_r_sync2;\n\n    // Memory\n    reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wfull_int;\n    wire winc_eff;\n\n    // Read enable\n    wire rempty_int;\n    wire rinc_eff;\n\n    // Gray code conversion\n    function [ASIZE-1:0] bin2gray;\n        input [ASIZE-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [ASIZE-1:0] gray2bin;\n        input [ASIZE-1:0] gray;\n        reg [ASIZE-1:0] bin;\n        integer i;\n        begin\n            bin[ASIZE-1] = gray[ASIZE-1];\n            for (i = ASIZE-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Write domain\n    assign wfull_int = (wptr_bin[ASIZE-1] != rptr_gray_w_sync2[ASIZE-1]) && \n                       (wptr_gray == rptr_gray_w_sync2);\n    assign wfull = wfull_int;\n    assign winc_eff = winc && !wfull;\n\n    // Almost full: one write away from full\n    // wptr_bin - rptr_bin == DEPTH - 1\n    // rptr_bin in write domain = {1'b0, gray2bin(rptr_gray_w_sync2)}\n    wire [AWIDTH-1:0] rptr_bin_w;\n    assign rptr_bin_w = {1'b0, gray2bin(rptr_gray_w_sync2)};\n    assign awfull = (wptr_bin - rptr_bin_w == DEPTH - 1);\n\n    // Read domain\n    assign rempty_int = (wptr_gray_r_sync2 == rptr_gray) && \n                        (wptr_gray_r_sync2[ASIZE-1] == rptr_bin[ASIZE-1]);\n    assign rempty = rempty_int;\n    assign rinc_eff = rinc && !rempty;\n\n    // Almost empty: one read away from empty\n    // wptr_bin - rptr_bin == 1\n    wire [AWIDTH-1:0] wptr_bin_r;\n    assign wptr_bin_r = {1'b0, gray2bin(wptr_gray_r_sync2)};\n    assign arempty = (wptr_bin_r - rptr_bin == 1);\n\n    // Write pointer update\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr_bin <= {AWIDTH{1'b0}};\n            wptr_gray <= {ASIZE{1'b0}};\n        end else if (winc_eff) begin\n            wptr_bin <= wptr_bin + 1'b1;\n            wptr_gray <= bin2gray(wptr_bin[ASIZE-1:0] + 1'b1);\n        end\n    end\n\n    // Read pointer update\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr_bin <= {AWIDTH{1'b0}};\n            rptr_gray <= {ASIZE{1'b0}};\n        end else if (rinc_eff) begin\n            rptr_bin <= rptr_bin + 1'b1;\n            rptr_gray <= bin2gray(rptr_bin[ASIZE-1:0] + 1'b1);\n        end\n    end\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (winc_eff)\n            mem[wptr_bin[ASIZE-1:0]] <= wdata;\n    end\n\n    // Memory read\n    wire [ASIZE-1:0] raddr;\n    assign raddr = rptr_bin[ASIZE-1:0];\n\n    // Read data\n    reg [DSIZE-1:0] rdata_reg;\n    always @(posedge rclk) begin\n        if (rinc_eff)\n            rdata_reg <= mem[raddr];\n    end\n\n    assign rdata = (FALLTHROUGH == \"TRUE\") ? mem[raddr] : rdata_reg;\n\n    // CDC: write pointer gray to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_r_sync1 <= {ASIZE{1'b0}};\n            wptr_gray_r_sync2 <= {ASIZE{1'b0}};\n        end else begin\n            wptr_gray_r_sync1 <= wptr_gray;\n            wptr_gray_r_sync2 <= wptr_gray_r_sync1;\n        end\n    end\n\n    // CDC: read pointer gray to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_w_sync1 <= {ASIZE{1'b0}};\n            rptr_gray_w_sync2 <= {ASIZE{1'b0}};\n        end else begin\n            rptr_gray_w_sync1 <= rptr_gray;\n            rptr_gray_w_sync2 <= rptr_gray_w_sync1;\n        end\n    end\n\nendmodule\n```<|im_end|>",
