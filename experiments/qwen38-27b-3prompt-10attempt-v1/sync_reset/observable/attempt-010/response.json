{
  "text": "```verilog\nmodule sync_reset #\n(\n    parameter N = 2\n)\n(\n    input  wire clk,\n    input  wire rst,\n    output wire out\n);\n\n    localparam WIDTH = (N > 0) ? N : 1;\n\n    reg [WIDTH-1:0] sync_reg;\n    reg             out_reg;\n\n    // Synchronize rst into clk domain\n    always @(posedge clk) begin\n        sync_reg <= {sync_reg[WIDTH-2:0], rst};\n    end\n\n    // Count down from N-1 to 0 after sync_reg[WIDTH-1] goes high\n    // When counter reaches 0, deassert out\n    reg [WIDTH-1:0] counter;\n\n    always @(posedge clk) begin\n        if (rst) begin\n            out_reg <= 1'b1;\n            counter <= {WIDTH{1'b0}};\n        end\n        else if (sync_reg[WIDTH-1]) begin\n            if (counter == {WIDTH{1'b0}}) begin\n                out_reg <= 1'b0;\n            end\n            else begin\n                counter <= counter - 1'b1;\n                out_reg <= 1'b1;\n            end\n        end\n        else begin\n            out_reg <= 1'b1;\n            counter <= {WIDTH{1'b0}};\n        end\n    end\n\n    assign out = out_reg;\n\nendmodule\n```<|im_end|>",
