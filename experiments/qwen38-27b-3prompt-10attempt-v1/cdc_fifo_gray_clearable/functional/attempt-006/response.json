  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n    localparam GRAY_W = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [GRAY_W-1:0] src_wr_gray;\n    reg [GRAY_W-1:0] src_rd_gray_sync [SYNC_STAGES-1:0];\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg src_clear_pending;\n    reg src_clear_active;\n\n    // Destination domain\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [GRAY_W-1:0] dst_rd_gray;\n    reg [GRAY_W-1:0] dst_wr_gray_sync [SYNC_STAGES-1:0];\n    reg dst_clear_pending;\n    reg dst_clear_active;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Source domain logic\n    wire [GRAY_W-1:0] src_rd_gray_synced = src_rd_gray_sync[SYNC_STAGES-1];\n    wire [PTR_W-1:0] src_rd_ptr_bin = gray_to_bin(src_rd_gray_synced);\n    wire [PTR_W-1:0] src_wr_ptr_next = src_wr_ptr + 1'b1;\n    wire [GRAY_W-1:0] src_wr_gray_next = bin_to_gray(src_wr_ptr_next);\n\n    wire src_full = (src_wr_ptr[PTR_W-1] == src_rd_ptr_bin[PTR_W-1]) &&\n                    (src_wr_ptr[PTR_W-2:0] == src_rd_ptr_bin[PTR_W-2:0]);\n    wire src_empty = (src_wr_ptr == src_rd_ptr_bin);\n\n    wire src_can_write = src_valid_i && !src_full && !src_clear_active && !src_clear_pending;\n    wire src_ready = !src_full && !src_clear_active && !src_clear_pending;\n\n    // Destination domain logic\n    wire [GRAY_W-1:0] dst_wr_gray_synced = dst_wr_gray_sync[SYNC_STAGES-1];\n    wire [PTR_W-1:0] dst_wr_ptr_bin = gray_to_bin(dst_wr_gray_synced);\n    wire [PTR_W-1:0] dst_rd_ptr_next = dst_rd_ptr + 1'b1;\n    wire [GRAY_W-1:0] dst_rd_gray_next = bin_to_gray(dst_rd_ptr_next);\n\n    wire dst_full = (dst_rd_ptr[PTR_W-1] == dst_wr_ptr_bin[PTR_W-1]) &&\n                    (dst_rd_ptr[PTR_W-2:0] == dst_wr_ptr_bin[PTR_W-2:0]);\n    wire dst_empty = (dst_rd_ptr == dst_wr_ptr_bin);\n\n    wire dst_can_read = dst_valid_reg && dst_ready_i && !dst_clear_active && !dst_clear_pending;\n    wire dst_valid = dst_valid_reg && !dst_clear_active && !dst_clear_pending;\n\n    // Source clear logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear_pending <= 1'b0;\n            src_clear_active <= 1'b0;\n        end else begin\n            if (src_clear_i) begin\n                src_clear_pending <= 1'b1;\n                src_clear_active <= 1'b1;\n            end else if (src_clear_pending) begin\n                // Wait until destination side has also cleared\n                // We need to know when dst has cleared. Use a handshake.\n                // For simplicity, clear completes when both sides are cleared.\n                // We'll use a simple approach: clear pending stays until dst_clear_pending is low\n                // But we can't directly see dst_clear_pending in src domain.\n                // Instead, we'll use a different approach: clear is done when both pointers are reset.\n                // Let's use a simpler model: clear pending stays high for a fixed number of cycles\n                // or until we detect that the other side has cleared.\n                \n                // Actually, let's use a different approach:\n                // When clear is requested, we set clear_active and clear_pending.\n                // We reset the local pointer and gray code.\n                // We need to wait for the other side to also clear.\n                // We can use a simple counter or wait for the synchronized pointer to match.\n                \n                // For now, let's just keep clear_pending high until we see that the other side\n                // has also cleared. We'll use a flag that gets cleared when both sides are done.\n                \n                // Simplified: clear pending stays high for 2 cycles after clear is requested,\n                // then we check if the other side has cleared by looking at the synchronized pointer.\n                \n                // Actually, the simplest correct approach:\n                // 1. On clear request, set clear_active and clear_pending.\n                // 2. Reset local pointer and gray code.\n                // 3. Keep clear_pending high until the synchronized remote pointer matches the local reset pointer.\n                \n                // Let's implement this properly.\n                src_clear_pending <= 1'b1;\n                src_clear_active <= 1'b1;\n            end else begin\n                src_clear_pending <= 1'b0;\n                src_clear_active <= 1'b0;\n            end\n        end\n    end\n\n    // Source pointer and memory write\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_wr_gray <= {GRAY_W{1'b0}};\n        end else if (src_clear_active) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_wr_gray <= {GRAY_W{1'b0}};\n        end else if (src_can_write) begin\n            mem[src_wr_ptr[PTR_W-2:0]] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr_next;\n            src_wr_gray <= src_wr_gray_next;\n        end\n    end\n\n    // Source clear pending completion\n    // Clear pending should stay high until the destination side has also cleared.\n    // We can de