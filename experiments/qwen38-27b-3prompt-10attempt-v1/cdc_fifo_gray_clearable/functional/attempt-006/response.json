ear_done = (dst_wr_ptr_bin == {PTR_W{1'b0}});\n    \n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear_pending <= 1'b0;\n        end else if (dst_clear_pending && dst_clear_done) begin\n            dst_clear_pending <= 1'b0;\n        end\n    end\n\n    // Synchronizers\n    integer i;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            for (i = 0; i < SYNC_STAGES; i = i + 1)\n                src_rd_gray_sync[i] <= {GRAY_W{1'b0}};\n        end else begin\n            src_rd_gray_sync[0] <= dst_rd_gray;\n            for (i = 1; i < SYNC_STAGES; i = i + 1)\n                src_rd_gray_sync[i] <= src_rd_gray_sync[i-1];\n        end\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            for (i = 0; i < SYNC_STAGES; i = i + 1)\n                dst_wr_gray_sync[i] <= {GRAY_W{1'b0}};\n        end else begin\n            dst_wr_gray_sync[0] <= src_wr_gray;\n            for (i = 1; i < SYNC_STAGES; i = i + 1)\n                dst_wr_gray_sync[i] <= dst_wr_gray_sync[i-1];\n        end\n    end\n\n    // Outputs\n    assign src_ready_o = src_ready;\n    assign src_clear_pending_o = src_clear_pending;\n    assign dst_valid_o = dst_valid;\n    assign dst_data_o = dst_data_reg;\n    assign dst_clear_pending_o = dst_clear_pending;\n\n    // Gray code conversion functions\n    function [GRAY_W-1:0] bin_to_gray;\n        input [PTR_W-1:0] bin;\n        begin\n            bin_to_gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_W-1:0] gray_to_bin;\n        input [GRAY_W-1:0] gray;\n        reg [PTR_W-1:0] bin;\n        begin\n            bin[PTR_W-1] = gray[PTR_W-1];\n            for (i = PTR_W-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray_to_bin = bin;\n        end\n    endfunction\n\nendmodule\n```<|im_end|>",
