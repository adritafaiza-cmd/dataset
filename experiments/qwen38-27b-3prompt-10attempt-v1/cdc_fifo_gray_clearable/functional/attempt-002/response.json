  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Source domain signals\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] src_wr_ptr_gray;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_gray_sync;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_gray_sync1;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_gray_sync2;\n    reg [WIDTH-1:0] src_mem [0:DEPTH-1];\n    reg src_clear_pending;\n    reg src_clear_in_progress;\n\n    // Destination domain signals\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_gray;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_gray_sync;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_gray_sync1;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_gray_sync2;\n    reg dst_clear_pending;\n    reg dst_clear_in_progress;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Helper functions\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_WIDTH-1:0] gray2bin;\n        input [PTR_WIDTH-1:0] gray;\n        reg [PTR_WIDTH-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source domain: clear handling\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear_pending <= 1'b0;\n            src_clear_in_progress <= 1'b0;\n        end else begin\n            if (src_clear_i && !src_clear_in_progress) begin\n                src_clear_in_progress <= 1'b1;\n                src_clear_pending <= 1'b1;\n            end else if (src_clear_in_progress) begin\n                // Wait until destination side has also cleared\n                // We need to know when dst has cleared. Use a simple handshake:\n                // src_clear_in_progress stays high until dst_clear_pending goes low\n                // But we can't directly see dst_clear_pending in src domain.\n                // Instead, we'll use a different approach: both sides clear independently,\n                // and pending stays high until the local side is done.\n                // For src side: done when we've reset pointers and memory is considered empty.\n                // Since we're just resetting pointers, it's done in one cycle after clear request.\n                src_clear_in_progress <= 1'b0;\n                src_clear_pending <= 1'b0;\n            end\n        end\n    end\n\n    // Source domain: write pointer and memory\n    wire src_full;\n    wire src_empty;\n    wire src_can_write;\n\n    assign src_full = (src_wr_ptr_gray == src_rd_ptr_gray_sync) && \n                      (src_wr_ptr[PTR_WIDTH-1] != src_rd_ptr_gray_sync[PTR_WIDTH-1]);\n    assign src_empty = (src_wr_ptr_gray == src_rd_ptr_gray_sync);\n    assign src_can_write = !src_full && !src_clear_in_progress && !src_clear_pending;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end else if (src_clear_i || src_clear_in_progress) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end else if (src_valid_i && src_can_write) begin\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n            src_wr_ptr_gray <= bin2gray(src_wr_ptr + 1'b1);\n            src_mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n        end\n    end\n\n    // Source domain: synchronize destination read pointer\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_rd_ptr_gray_sync <= {PTR_WIDTH{1'b0}};\n            src_rd_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            src_rd_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            src_rd_ptr_gray_sync <= dst_rd_ptr_gray;\n            src_rd_ptr_gray_sync1 <= src_rd_ptr_gray_sync;\n            src_rd_ptr_gray_sync2 <= src_rd_ptr_gray_sync1;\n        end\n    end\n\n    assign src_ready_o = src_can_write;\n    assign src_clear_pending_o = src_clear_pending;\n\n    // Destination domain: clear handling\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear_pending <= 1'b0;\n            dst_clear_in_progress <= 1'b0;\n        end else begin\n            if (dst_clear_i && !dst_clear_in_progress) begin\n                dst_clear_in_progress <= 1'b1;\n                dst_clear_pending <= 1'b1;\n            end else if (dst_clear_in_progress) begin\n                dst_clear_in_progress <= 1'b0;\n                dst_clear_pending <= 1'b0;\n            end\n        end\n    end\n\n    // Destination domain: read pointer\n    wire dst_full;\n    wire dst_empty;\n    wire dst_can_read;\n\n    assign dst_full = (dst_rd_ptr_gray == dst_wr_ptr_gray_sync) && \n                      (dst_rd_ptr[PTR_WIDTH-1] != dst_wr_ptr_gray_sync[PTR_WIDTH-1]);\n    assign dst_empty = (dst_rd_ptr_gray == dst_wr_ptr_gray_sync);\n    assign dst_can_read = !dst_empty && !dst_clear_in_progress && !dst_clear_pending;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end else if (dst_clear_i || dst_clear_in_progress) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end else if (dst_valid_reg && dst_ready_i) begin\n            dst_rd_ptr <= dst_rd_ptr + 1'b1;\n            dst_rd_ptr_gray <= bin2gray(dst_rd_ptr + 1'b1);\n        end\n    end\n\n    // Destination domain: synchronize source write pointer\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_wr_ptr_gray_sync <= {PTR_WIDTH{1'b0}};\n            dst_wr_ptr_gray_sync1 <= {PTR_WIDTH{1'b0}};\n            dst_wr_ptr_gray_sync2 <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_wr_ptr_gray_sync <= src_wr_ptr_gray;\n            dst_wr_ptr_gray_sync1 <= dst_wr_ptr_gray_sync;\n            dst_wr_ptr_gray_sync2 <= dst_wr_ptr_gray_sync1;\n        end\n    end\n\n    // Destination domain: output data and valid\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else if (dst_clear_i || dst_clear_in_progress) begin\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else if (dst_can_read) begin\n            dst_data_reg <= src_mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n            dst_valid_reg <= 1'b1;\n        end else if (dst_valid_reg && dst_ready_i) begin\n            dst_valid_reg <= 1'b0;\n        end\n    end\n\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n    assign dst_clear_pending_o = dst_clear_pending;\n\nendmodule\n```<|im_end|>",
