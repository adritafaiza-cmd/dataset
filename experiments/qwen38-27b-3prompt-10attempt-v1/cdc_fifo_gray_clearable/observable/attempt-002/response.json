  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] src_wr_ptr_gray;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_gray_sync;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_gray_sync_next;\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg src_clear_pending;\n\n    // Destination domain\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_gray;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_gray_sync;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_gray_sync_next;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n    reg dst_clear_pending;\n\n    // Binary to Gray conversion\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Gray to Binary conversion\n    function [PTR_WIDTH-1:0] gray2bin;\n        input [PTR_WIDTH-1:0] gray;\n        reg [PTR_WIDTH-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source domain logic\n    wire [PTR_WIDTH-1:0] src_rd_ptr_bin = gray2bin(src_rd_ptr_gray_sync);\n    wire src_full = (src_wr_ptr_gray == src_rd_ptr_gray_sync) && \n                    (src_wr_ptr[PTR_WIDTH-1] != src_rd_ptr_bin[PTR_WIDTH-1]);\n    wire src_empty = (src_wr_ptr_gray == src_rd_ptr_gray_sync) && \n                     (src_wr_ptr[PTR_WIDTH-1] == src_rd_ptr_bin[PTR_WIDTH-1]);\n\n    assign src_ready_o = ~src_full && ~src_clear_pending;\n\n    // Clear pending logic in source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_clear_pending <= 1'b0;\n        else if (src_clear_i)\n            src_clear_pending <= 1'b1;\n        else if (src_clear_pending && src_rd_ptr_gray_sync == src_wr_ptr_gray)\n            src_clear_pending <= 1'b0;\n    end\n\n    assign src_clear_pending_o = src_clear_pending;\n\n    // Write pointer update\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end\n        else if (src_clear_i) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end\n        else if (src_valid_i && src_ready_o) begin\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n            src_wr_ptr_gray <= bin2gray(src_wr_ptr + 1'b1);\n        end\n    end\n\n    // Memory write\n    always @(posedge src_clk_i) begin\n        if (src_valid_i && src_ready_o)\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n    end\n\n    // Synchronize read pointer gray from destination domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_rd_ptr_gray_sync <= {PTR_WIDTH{1'b0}};\n        else\n            src_rd_ptr_gray_sync <= src_rd_ptr_gray_sync_next;\n    end\n\n    // Synchronizer chain for read pointer gray\n    reg [SYNC_STAGES-1:0][PTR_WIDTH-1:0] src_rd_ptr_gray_sync_chain;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            for (integer i = 0; i < SYNC_STAGES; i = i + 1)\n                src_rd_ptr_gray_sync_chain[i] <= {PTR_WIDTH{1'b0}};\n        end\n        else begin\n            src_rd_ptr_gray_sync_chain[0] <= dst_rd_ptr_gray;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1)\n                src_rd_ptr_gray_sync_chain[i] <= src_rd_ptr_gray_sync_chain[i-1];\n        end\n    end\n    assign src_rd_ptr_gray_sync_next = src_rd_ptr_gray_sync_chain[SYNC_STAGES-1];\n\n    // Destination domain logic\n    wire [PTR_WIDTH-1:0] dst_wr_ptr_bin = gray2bin(dst_wr_ptr_gray_sync);\n    wire dst_full = (dst_rd_ptr_gray == dst_wr_ptr_gray_sync) && \n                    (dst_rd_ptr[PTR_WIDTH-1] != dst_wr_ptr_bin[PTR_WIDTH-1]);\n    wire dst_empty = (dst_rd_ptr_gray == dst_wr_ptr_gray_sync) && \n                     (dst_rd_ptr[PTR_WIDTH-1] == dst_wr_ptr_bin[PTR_WIDTH-1]);\n\n    // Clear pending logic in destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_clear_pending <= 1'b0;\n        else if (dst_clear_i)\n            dst_clear_pending <= 1'b1;\n        else if (dst_clear_pending && dst_wr_ptr_gray_sync == dst_rd_ptr_gray)\n            dst_clear_pending <= 1'b0;\n    end\n\n    assign dst_clear_pending_o = dst_clear_pending;\n\n    // Read pointer update\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end\n        else if (dst_clear_i) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_gray <= {PTR_WIDTH{1'b0}};\n        end\n        else if (dst_valid_reg && dst_ready_i) begin\n            dst_rd_ptr <= dst_rd_ptr + 1'b1;\n            dst_rd_ptr_gray <= bin2gray(dst_rd_ptr + 1'b1);\n        end\n    end\n\n    // Synchronize write pointer gray from source domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_wr_ptr_gray_sync <= {PTR_WIDTH{1'b0}};\n        else\n            dst_wr_ptr_gray_sync <= dst_wr_ptr_gray_sync_next;\n    end\n\n    // Synchronizer chain for write pointer gray\n    reg [SYNC_STAGES-1:0][PTR_WIDTH-1:0] dst_wr_ptr_gray_sync_chain;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            for (integer i = 0; i < SYNC_STAGES; i = i + 1)\n                dst_wr_ptr_gray_sync_chain[i] <= {PTR_WIDTH{1'b0}};\n        end\n        else begin\n            dst_wr_ptr_gray_sync_chain[0] <= src_wr_ptr_gray;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1)\n                dst_wr_ptr_gray_sync_chain[i] <= dst_wr_ptr_gray_sync_chain[i-1];\n        end\n    end\n    assign dst_wr_ptr_gray_sync_next = dst_wr_ptr_gray_sync_chain[SYNC_STAGES-1];\n\n    // Output data and valid\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\n    // Data read and valid register update\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end\n        else if (dst_clear_i) begin\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end\n        else if (dst_valid_reg && dst_ready_i) begin\n            // Current beat is being consumed; check if there's another word\n            if (!dst_empty) begin\n                dst_data_reg <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n                dst_valid_reg <= 1'b1;\n            end\n            else begin\n                dst_valid_reg <= 1'b0;\n            end\n        end\n        else if (!dst_valid_reg && !dst_empty) begin\n            dst_data_reg <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n            dst_valid_reg <= 1'b1;\n        end\n    end\n\nendmodule\n```<|im_end|>",
