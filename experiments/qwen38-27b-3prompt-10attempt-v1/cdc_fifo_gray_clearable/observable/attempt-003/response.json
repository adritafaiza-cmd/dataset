  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n    localparam GRAY_W = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [GRAY_W-1:0] src_wr_gray;\n    reg [GRAY_W-1:0] src_rd_gray_sync [SYNC_STAGES-1:0];\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg src_clear_pending;\n\n    // Destination domain\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [GRAY_W-1:0] dst_rd_gray;\n    reg [GRAY_W-1:0] dst_wr_gray_sync [SYNC_STAGES-1:0];\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n    reg dst_clear_pending;\n\n    // Gray code conversion functions\n    function [GRAY_W-1:0] bin2gray;\n        input [PTR_W-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_W-1:0] gray2bin;\n        input [GRAY_W-1:0] gray;\n        reg [PTR_W-1:0] bin;\n        integer i;\n        begin\n            bin[GRAY_W-1] = gray[GRAY_W-1];\n            for (i = GRAY_W-2; i >= 0; i = i - 1)\n                bin[i] = bin[i+1] ^ gray[i];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source domain logic\n    wire [PTR_W-1:0] src_wr_ptr_next;\n    wire [GRAY_W-1:0] src_wr_gray_next;\n    wire [PTR_W-1:0] src_rd_ptr_sync;\n   