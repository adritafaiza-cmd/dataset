  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n    localparam GRAY_WIDTH = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [GRAY_WIDTH-1:0] src_wr_gray;\n    reg [GRAY_WIDTH-1:0] src_rd_gray_sync [0:SYNC_STAGES-1];\n    reg [GRAY_WIDTH-1:0] src_rd_gray_sync_next;\n    reg src_clear_pending;\n\n    // Destination domain\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [GRAY_WIDTH-1:0] dst_rd_gray;\n    reg [GRAY_WIDTH-1:0] dst_wr_gray_sync [0:SYNC_STAGES-1];\n    reg [GRAY_WIDTH-1:0] dst_wr_gray_sync_next;\n    reg dst_clear_pending;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Gray code conversion functions\n    function [GRAY_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_WIDTH-1:0] gray2bin;\n        input [GRAY_WIDTH-1:0] gray;\n        reg [PTR_WIDTH-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                bin[i] = bin[i+1] ^ gray[i];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source domain logic\n    wire [PTR_WIDTH-1:0] src_rd_ptr_sync = gray2bin(src_rd_gray_sync[SYNC_STAGES-1]);\n    wire [PTR_WIDTH-1:0] src_wr_ptr_next = src_wr_ptr + 1'b1;\n    wire [GRAY_WIDTH-1:0] src_wr_gray_next = bin2gray(src_wr_ptr_next);\n    wire src_full = (src_wr_ptr_next[LOG_DEPTH-1:0] == src_rd_ptr_sync[LOG_DEPTH-1:0]) &&\n                    (src_wr_ptr_next[LOG_DEPTH] != src_rd_ptr_sync[LOG_DEPTH]);\n    wire src_can_write = src_valid_i && !src_full && !src_clear_pending;\n    wire src_ready = !src_full && !src_clear_pending;\n\n    // Destination domain logic\n    wire [PTR_WIDTH-1:0] dst_wr_ptr_sync = gray2bin(dst_wr_gray_sync[SYNC_STAGES-1]);\n    wire [PTR_WIDTH-1:0] dst_rd_ptr_next = dst_rd_ptr + 1'b1;\n    wire [GRAY_WIDTH-1:0] dst_rd_gray_next = bin2gray(dst_rd_ptr_next);\n    wire dst_empty = (dst_rd_ptr == dst_wr_ptr_sync);\n    wire dst_can_read = dst_valid_reg && dst_ready_i && !dst_clear_pending;\n    wire dst_has_data = !dst_empty && !dst_clear_pending;\n\n    // Source clock domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n            src_wr_gray <= {GRAY_WIDTH{1'b0}};\n            src_clear_pending <= 1'b0;\n            for (integer i = 0; i < SYNC_STAGES; i = i + 1)\n                src_rd_gray_sync[i] <= {GRAY_WIDTH{1'b0}};\n        end else begin\n            if (src_clear_i) begin\n                src_clear_pending <= 1'b1;\n            end else if (src_clear_pending) begin\n                // Wait for destination to acknowledge clear\n                if (dst_clear_pending_sync) begin\n                    src_clear_pending <= 1'b0;\n                    src_wr_ptr <= {PTR_WIDTH{1'b0}};\n                    src_wr_gray <= {GRAY_WIDTH{1'b0}};\n                end\n            end else begin\n                if (src_can_write) begin\n                    mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n                    src_wr_ptr <= src_wr_ptr_next;\n                    src_wr_gray <= src_wr_gray_next;\n                end\n            end\n            // Synchronize read pointer gray code\n            for (integer i = 0; i < SYNC_STAGES-1; i = i + 1)\n                src_rd_gray_sync[i] <= src_rd_gray_sync[i+1];\n            src_rd_gray_sync[SYNC_STAGES-1] <= dst_rd_gray;\n        end\n    end\n\n    assign src_clear_pending_o = src_clear_pending;\n\n    // Destination clock domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_rd_gray <= {GRAY_WIDTH{1'b0}};\n            dst_clear_pending <= 1'b0;\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n            for (integer i = 0; i < SYNC_STAGES; i = i + 1)\n                dst_wr_gray_sync[i] <= {GRAY_WIDTH{1'b0}};\n        end else begin\n            if (dst_clear_i) begin\n                dst_clear_pending <= 1'b1;\n                dst_valid_reg <= 1'b0;\n            end else if (dst_clear_pending) begin\n                // Wait for source to acknowledge clear\n                if (src_clear_pending_sync) begin\n                    dst_clear_pending <= 1'b0;\n                    dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n                    dst_rd_gray <= {GRAY_WIDTH{1'b0}};\n                    dst_valid_reg <= 1'b0;\n                end\n            end else begin\n                if (dst_can_read) begin\n                    dst_rd_ptr <= dst_rd_ptr_next;\n                    dst_rd_gray <= dst_rd_gray_next;\n                    dst_valid_reg <= 1'b0;\n                end else if (dst_has_data && !dst_valid_reg) begin\n                    dst_data_reg <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n                    dst_valid_reg <= 1'b1;\n                end\n            end\n            // Synchronize write pointer gray code\n            for (integer i = 0; i < SYNC_STAGES-1; i = i + 1)\n                dst_wr_gray_sync[i] <= dst_wr_gray_sync[i+1];\n            dst_wr_gray_sync[SYNC_STAGES-1] <= src_wr_gray;\n        end\n    end\n\n    assign dst_clear_pending_o = dst_clear_pending;\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n    assign src_ready_o = src_ready;\n\n    // Cross-domain clear pending signals\n    // src_clear_pending_sync: dst_clear_pending synchronized to src domain\n    reg [1:0] dst_clear_pending_sync_reg;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_clear_pending_sync_reg <= 2'b00;\n        else\n            dst_clear_pending_sync_reg <= {dst_clear_pending_sync_reg[0], dst_clear_pending};\n    end\n    wire dst_clear_pending_sync = dst_clear_pending_sync_reg[1];\n\n    // dst_clear_pending_sync: src_clear_pending synchronized to dst domain\n    reg [1:0] src_clear_pending_sync_reg;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_clear_pending_sync_reg <= 2'b00;\n        else\n            src_clear_pending_sync_reg <= {src_clear_pending_sync_reg[0], src_clear_pending};\n    end\n    wire src_clear_pending_sync = src_clear_pending_sync_reg[1];\n\nendmodule\n```<|im_end|>",
