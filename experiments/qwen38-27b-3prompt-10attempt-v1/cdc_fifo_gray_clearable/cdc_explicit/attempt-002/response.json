  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n\n    // Source domain signals\n    reg  [PTR_W-1:0] src_wr_ptr;\n    reg  [PTR_W-1:0] src_rd_ptr_gray_sync;\n    reg  [WIDTH-1:0] mem [0:DEPTH-1];\n    reg              src_clear_pending;\n    reg              src_clear_active;\n\n    // Destination domain signals\n    reg  [PTR_W-1:0] dst_rd_ptr;\n    reg  [PTR_W-1:0] dst_wr_ptr_gray_sync;\n    reg  [WIDTH-1:0] dst_data_reg;\n    reg              dst_valid_reg;\n    reg              dst_clear_pending;\n    reg              dst_clear_active;\n\n    // Gray code conversion functions\n    function [PTR_W-1:0] bin2gray;\n        input [PTR_W-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_W-1:0] gray2bin;\n        input [PTR_W-1:0] gray;\n        reg [PTR_W-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_W-1] = gray[PTR_W-1];\n            for (i = PTR_W-2; i >= 0; i = i - 1)\n                bin[i] = bin[i+1] ^ gray[i];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source domain: write pointer and memory\n    wire [PTR_W-1:0] src_wr_ptr_gray = bin2gray(src_wr_ptr);\n    wire [PTR_W-1:0] src_rd_ptr_bin = gray2bin(src_rd_ptr_gray_sync);\n\n    wire src_full = (src_wr_ptr_gray == src_rd_ptr_gray_sync) && (src_wr_ptr[PTR_W-1] != src_rd_ptr_bin[PTR_W-1]);\n    wire src_empty = (src_wr_ptr == src_rd_ptr_bin);\n\n    // Source clear logic\n    wire src_clear_req = src_clear_i | src_clear_active;\n    wire src_clear_done = src_clear_active && src_empty;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n            src_clear_pending <= 1'b0;\n            src_clear_active <= 1'b0;\n        end else begin\n            if (src_clear_i) begin\n                src_clear_active <= 1'b1;\n                src_clear_pending <= 1'b1;\n            end else if (src_clear_active) begin\n                if (src_empty) begin\n                    src_clear_active <= 1'b0;\n                    src_clear_pending <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // Source write\n    wire src_write_en = src_valid_i & src_ready_o & ~src_clear_active;\n    wire src_ready = ~src_full & ~src_clear_active;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n        end else if (src_write_en) begin\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n        end\n    end\n\n    // Destination domain: read pointer and output\n    wire [PTR_W-1:0] dst_rd_ptr_gray = bin2gray(dst_rd_ptr);\n    wire [PTR_W-1:0] dst_wr_ptr_bin = gray2bin(dst_wr_ptr_gray_sync);\n\n    wire dst_full = (dst_rd_ptr_gray == dst_wr_ptr_gray_sync) && (dst_rd_ptr[PTR_W-1] != dst_wr_ptr_bin[PTR_W-1]);\n    wire dst_empty = (dst_rd_ptr == dst_wr_ptr_bin);\n\n    // Destination clear logic\n    wire dst_clear_req = dst_clear_i | dst_clear_active;\n    wire dst_clear_done = dst_clear_active && dst_empty;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)