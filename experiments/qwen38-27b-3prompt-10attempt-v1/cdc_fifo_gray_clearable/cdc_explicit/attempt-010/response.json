  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n    localparam GRAY_WIDTH = LOG_DEPTH + 1;\n\n    // Source domain signals\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [GRAY_WIDTH-1:0] src_wr_ptr_gray;\n    reg [GRAY_WIDTH-1:0] src_rd_ptr_gray_sync;\n    reg [GRAY_WIDTH-1:0] src_rd_ptr_gray_sync_next;\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg src_clear_pending;\n    reg src_clear_pending_next;\n    reg src_ready;\n    reg src_ready_next;\n    reg src_valid;\n    reg src_valid_next;\n    reg src_data_reg [WIDTH-1:0];\n    reg src_data_reg_next [WIDTH-1:0];\n\n    // Destination domain signals\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [GRAY_WIDTH-1:0] dst_rd_ptr_gray;\n    reg [GRAY_WIDTH-1:0] dst_wr_ptr_gray_sync;\n    reg [GRAY_WIDTH-1:0] dst_wr_ptr_gray_sync_next;\n    reg dst_clear_pending;\n    reg dst_clear_pending_next;\n    reg dst_valid;\n    reg dst_valid_next;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg [WIDTH-1:0] dst_data_reg_next;\n\n    // Helper functions\n    function [GRAY_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_WIDTH-1:0] gray2bin;\n        input [GRAY_WIDTH-1:0] gray;\n        reg [PTR_WIDTH-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                bin[i] = bin[i+1] ^ gray[i];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n            src_wr_ptr_gray <= {GRAY_WIDTH{1'b0}};\n            src_rd_ptr_gray_sync <= {GRAY_WIDTH{1'b0}};\n            src_rd_ptr_gray_sync_next <= {GRAY_WIDTH{1'b0}};\n            src_clear_pending <= 1'b0;\n            src_clear_pending_next <= 1'b0;\n            src_ready <= 1'b1;\n            src_ready_next <= 1'b1;\n            src_valid <= 1'b0;\n            src_valid_next <= 1'b0;\n            src_data_reg <= {WIDTH{1'b0}};\n            src_data_reg_next <= {WIDTH{1'b0}};\n        end else begin\n            src_rd_ptr_gray_sync <= src_rd_ptr_gray_sync_next;\n            src_clear_pending <= src_clear_pending_next;\n            src_ready <= src_ready_next;\n            src_valid <= src_valid_next;\n            src_data_reg <= src_data_reg_next;\n\n            if (src_clear_i) begin\n                src_clear_pending_next <= 1'b1;\n                src_ready_next <= 1'b0;\n                src_valid_next <= 1'b0;\n                src_data_reg_next <= {WIDTH{1'b0}};\n                src_wr_ptr <= {PTR_WIDTH{1'b0}};\n                src_wr_ptr_gray <= {GRAY_WIDTH{1'b0}};\n            end else if (src_clear_pending) begin\n                src_clear_pending_next <= 1'b0;\n                src_ready_next <= 1'b1;\n                src_valid_next <= 1'b0;\n                src_data_reg_next <= {WIDTH{1'b0}};\n            end else begin\n                src_clear_pending_next <= 1'b0;\n                if (src_valid_i && src_ready) begin\n                    src_ready_next <= 1'b0;\n                    src_valid_next <= 1'b1;\n                    src_data_reg_next <= src_data_i;\n                    mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n                    src_wr_ptr <= src_wr_ptr + 1'b1;\n                    src_wr_ptr_gray <= bin2gray(src_wr_ptr + 1'b1);\n                end else begin\n                    src_ready_next <= 1'b1;\n                    src_valid_next <= 1'b0;\n                    src_data_reg_next <= {WIDTH{1'b0}};\n                end\n            end\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n            dst_rd_ptr_gray <= {GRAY_WIDTH{1'b0}};\n            dst_wr_ptr_gray_sync <= {GRAY_WIDTH{1'b0}};\n            dst_wr_ptr_gray_sync_next <= {GRAY_WIDTH{1'b0}};\n            dst_clear_pending <= 1'b0;\n            dst_clear_pending_next <= 1'b0;\n            dst_valid <= 1'b0;\n            dst_valid_next <= 1'b0;\n            dst_data_reg <= {WIDTH{1'b0}};\n            dst_data_reg_next <= {WIDTH{1'b0}};\n        end else begin\n            dst_wr_ptr_gray_sync <= dst_wr_ptr_gray_sync_next;\n            dst_clear_pending <= dst_clear_pending_next;\n            dst_valid <= dst_valid_next;\n            dst_data_reg <= dst_data_reg_next;\n\n            if (dst_clear_i) begin\n                dst_clear_pending_next <= 1'b1;\n                dst_valid_next <= 1'b0;\n                dst_data_reg_next <= {WIDTH{1'b0}};\n                dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n                dst_rd_ptr_gray <= {GRAY_WIDTH{1'b0}};\n            end else if (dst_clear_pending) begin\n                dst_clear_pending_next <= 1'b0;\n                dst_valid_next <= 1'b0;\n                dst_data_reg_next <= {WIDTH{1'b0}};\n            end else begin\n                dst_clear_pending_next <= 1'b0;\n                if (dst_valid && dst_ready_i) begin\n                    dst_valid_next <= 1'b0;\n                    dst_data_reg_next <= {WIDTH{1'b0}};\n                    dst_rd_ptr <= dst_rd_ptr + 1'b1;\n                    dst_rd_ptr_gray <= bin2gray(dst_rd_ptr + 1'b1);\n                end else begin\n                    dst_valid_next <= 1'b0;\n                    dst_data_reg_next <= {WIDTH{1'b0}};\n                end\n            end\n        end\n    end\n\n    // Synchronizers\n    // Source side: synchronize dst_rd_ptr_gray to src domain\n    reg [GRAY_WIDTH-1:0] src_sync_stage [0:SYNC_STAGES-1];\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            for (integer i = 0; i < SYNC_STAGES; i = i + 1)\n                src_sync_stage[i] <= {GRAY_WIDTH{1'b0}};\n        end else begin\n            src_sync_stage[0] <= dst_rd_ptr_gray;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1)\n                src_sync_stage[i] <= src_sync_stage[i-1];\n        end\n    end\n\n    // Destination side: synchronize src_wr_ptr_gray to dst domain\n    reg [GRAY_WIDTH-1:0] dst_sync_stage [0:SYNC_STAGES-1];\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            for (integer i = 0; i < SYNC_STAGES; i = i + 1)\n                dst_sync_stage[i] <= {GRAY_WIDTH{1'b0}};\n        end else begin\n            dst_sync_stage[0] <= src_wr_ptr_gray;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1)\n                dst_sync_stage[i] <= dst_sync_stage[i-1];\n        end\n    end\n\n    // Compute next values for synchronizer outputs\n    always @(*) begin\n        src_rd_ptr_gray_sync_next = src_sync_stage[SYNC_STAGES-1];\n        dst_wr_ptr_gray_sync_next = dst_sync_stage[SYNC_STAGES-1];\n    end\n\n    // Compute FIFO full/empty\n    wire [PTR_WIDTH-1:0] src_wr_ptr_bin = src_wr_ptr;\n    wire [PTR_WIDTH-1:0] src_rd_ptr_bin = gray2bin(src_rd_ptr_gray_sync);\n    wire [PTR_WIDTH-1:0] dst_rd_ptr_bin = dst_rd_ptr;\n    wire [PTR_WIDTH-1:0] dst_wr_ptr_bin = gray2bin(dst_wr_ptr_gray_sync);\n\n    wire src_fifo_full = (src_wr_ptr_bin == src_rd_ptr_bin) ? 1'b0 : \n                         (src_wr_ptr_bin[LOG_DEPTH] != src_rd_ptr_bin[LOG_DEPTH]) && \n                         (src_wr_ptr_bin[LOG_DEPTH-1:0] == src_rd_ptr_bin[LOG_DEPTH-1:0]);\n    wire dst_fifo_empty = (dst_rd_ptr_bin == dst_wr_ptr_bin);\n\n    // Update ready and valid based on FIFO status\n    always @(*) begin\n        if (src_clear_i || src_clear_pending) begin\n            src_ready = 1'b0;\n        end else begin\n            src_ready = ~src_fifo_full;\n        end\n\n        if (dst_clear_i || dst_clear_pending) begin\n            dst_valid = 1'b0;\n        end else begin\n            dst_valid = ~dst_fifo_empty;\n        end\n    end\n\n    // Read data from memory when destination is ready and valid\n    wire dst_read_enable = dst_valid && dst_ready_i && !dst_clear_i && !dst_clear_pending;\n    wire [WIDTH-1:0] mem_read_data = mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n\n    always @(*) begin\n        if (dst_read_enable) begin\n            dst_data_reg_next = mem_read_data;\n        end else begin\n            dst_data_reg_next = dst_data_reg;\n        end\n    end\n\n    // Assign outputs\n    assign src_clear_pending_o = src_clear_pending;\n    assign src_ready_o = src_ready;\n    assign dst_clear_pending_o = dst_clear_pending;\n    assign dst_data_o = dst_data_reg;\n    assign dst_valid_o = dst_valid;\n\nendmodule\n```<|im_end|>",
