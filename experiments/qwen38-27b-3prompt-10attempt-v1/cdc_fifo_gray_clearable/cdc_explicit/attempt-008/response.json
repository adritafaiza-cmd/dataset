  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n\n    // Source domain signals\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [PTR_W-1:0] src_rd_ptr_gray;\n    reg [PTR_W-1:0] src_rd_ptr_gray_sync;\n    reg [PTR_W-1:0] src_rd_ptr_gray_sync2;\n    reg [PTR_W-1:0] src_rd_ptr_gray_sync3;\n    reg src_clear_pending;\n    reg src_clear_sync;\n    reg src_clear_sync2;\n    reg src_clear_sync3;\n    reg src_clear_done;\n\n    // Destination domain signals\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [PTR_W-1:0] dst_wr_ptr_gray;\n    reg [PTR_W-1:0] dst_wr_ptr_gray_sync;\n    reg [PTR_W-1:0] dst_wr_ptr_gray_sync2;\n    reg [PTR_W-1:0] dst_wr_ptr_gray_sync3;\n    reg dst_clear_pending;\n    reg dst_clear_sync;\n    reg dst_clear_sync2;\n    reg dst_clear_sync3;\n    reg dst_clear_done;\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // Clear synchronization chains\n    // Source clear to destination\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear_sync  <= 1'b0;\n            dst_clear_sync2 <= 1'b0;\n            dst_clear_sync3 <= 1'b0;\n        end else begin\n            dst_clear_sync  <= src_clear_i;\n            dst_clear_sync2 <= dst_clear_sync;\n            dst_clear_sync3 <= dst_clear_sync2;\n        end\n    end\n\n    // Destination clear to source\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear_sync  <= 1'b0;\n            src_clear_sync2 <= 1'b0;\n            src_clear_sync3 <= 1'b0;\n        end else begin\n            src_clear_sync  <= dst_clear_i;\n            src_clear_sync2 <= src_clear_sync;\n            src_clear_sync3 <= src_clear_sync2;\n        end\n    end\n\n    // Clear pending logic\n    // Source side: pending when local clear or remote clear (synced) is active\n    wire src_clear_active = src_clear_i | src_clear_sync3;\n    wire dst_clear_active = dst_clear_i | dst_clear_sync3;\n\n    // Source clear pending: high when clear is active and not yet done\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_clear_pending <= 1'b0;\n            src_clear_done    <= 1'b0;\n        end else begin\n            if (src_clear_active) begin\n                src_clear_pending <= 1'b1;\n                src_clear_done    <= 1'b0;\n            end else if (src_clear_pending && !src_clear_active) begin\n                // Clear has been deasserted, wait for it to propagate\n                src_clear_pending <= 1'b0;\n                src_clear_done    <= 1'b1;\n            end\n        end\n    end\n\n    // Destination clear pending\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_clear_pending <= 1'b0;\n            dst_clear_done    <= 1'b0;\n        end else begin\n            if (dst_clear_active) begin\n                dst_clear_pending <= 1'b1;\n                dst_clear_done    <= 1'b0;\n            end else if (dst_clear_pending && !dst_clear_active) begin\n                dst_clear_pending <= 1'b0;\n                dst_clear_done    <= 1'b1;\n            end\n        end\n    end\n\n    assign src_clear_pending_o = src_clear_pending;\n    assign dst_clear_pending_o = dst_clear_pending;\n\n    // Gray code conversion\n    function [PTR_W-1:0] bin2gray;\n        input [PTR_W-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Source write pointer and memory\n    wire src_wr_ptr_gray = bin2gray(src_wr_ptr);\n\n    // Synchronize source write pointer gray to destination\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_wr_ptr_gray_sync  <= {PTR_W{1'b0}};\n            dst_wr_ptr_gray_sync2 <= {PTR_W{1'b0}};\n            dst_wr_ptr_gray_sync3 <= {PTR_W{1'b0}};\n        end else begin\n            dst_wr_ptr_gray_sync  <= src_wr_ptr_gray;\n            dst_wr_ptr_gray_sync2 <= dst_wr_ptr_gray_sync;\n            dst_wr_ptr_gray_sync3 <= dst_wr_ptr_gray_sync2;\n        end\n    end\n\n    // Synchronize destination read pointer gray to source\n    wire dst_rd_ptr_gray = bin2gray(dst_rd_ptr);\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_rd_ptr_gray_sync  <= {PTR_W{1'b0}};\n            src_rd_ptr_gray_sync2 <= {PTR_W{1'b0}};\n            src_rd_ptr_gray_sync3 <= {PTR_W{1'b0}};\n        end else begin\n            src_rd_ptr_gray_sync  <= dst_rd_ptr_gray;\n            src_rd_ptr_gray_sync2 <= src_rd_ptr_gray_sync;\n            src_rd_ptr_gray_sync3 <= src_rd_ptr_gray_sync2;\n        end\n    end\n\n    // Convert synchronized gray to binary for comparison\n    function [PTR_W-1:0] gray2bin;\n        input [PTR_W-1:0] gray;\n        integer i;\n        begin\n            gray2bin[PTR_W-1] = gray[PTR_W-1];\n            for (i = PTR_W-2; i >= 0; i = i - 1)\n                gray2bin[i] = gray2bin[i+1] ^ gray[i];\n        end\n    endfunction\n\n    wire [PTR_W-1:0] src_rd_ptr_bin = gray2bin(src_rd_ptr_gray_sync3);\n    wire [PTR_W-1:0] dst_wr_ptr_bin = gray2bin(dst_wr_ptr_gray_sync3);\n\n    // FIFO full/empty\n    wire src_fifo_full  = (src_wr_ptr[PTR_W-1:1] == src_rd_ptr_bin[PTR_W-1:1]) &&\n                          (src_wr_ptr[0] != src_rd_ptr_bin[0]);\n    wire dst_fifo_empty = (dst_rd_ptr == dst_wr_ptr_bin);\n\n    // Source ready: not full and not in clear\n    assign src_ready_o = !src_fifo_full && !src_clear_active;\n\n    // Source write\n    wire src_write = src_valid_i && src_ready_o;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n        end else if (src_clear_active) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n        end else if (src_write) begin\n            mem[src_wr_ptr[PTR_W-2:0]] <= src_data_i;\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n        end\n    end\n\n    // Destination read\n    wire dst_read = dst_valid_reg && dst_ready_i;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr    <= {PTR_W{1'b0}};\n            dst_data_reg  <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else if (dst_clear_active) begin\n            dst_rd_ptr    <= {PTR_W{1'b0}};\n            dst_data_reg  <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            if (!dst_fifo_empty) begin\n                dst_data_reg  <= mem[dst_rd_ptr[PTR_W-2:0]];\n                dst_valid_reg <= 1'b1;\n                dst_rd_ptr    <= dst_rd_ptr + 1'b1;\n            end else begin\n                dst_valid_reg <= 1'b0;\n            end\n        end\n    end\n\n    assign dst_data_o  = dst_data_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
