  "text": "```verilog\nmodule axis_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   pause_req,\n    output wire                   pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] status_depth,\n    output wire [$clog2(DEPTH):0] status_depth_commit,\n    output wire                   status_overflow,\n    output wire                   status_bad_frame,\n    output wire                   status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_POW2 = (DEPTH == (1 << ADDR_WIDTH)) ? DEPTH : (1 << (ADDR_WIDTH + 1));\n    localparam PTR_WIDTH = (DEPTH == (1 << ADDR_WIDTH)) ? ADDR_WIDTH : (ADDR_WIDTH + 1);\n    localparam DEPTH_MASK = DEPTH_POW2 - 1;\n\n    // Total sideband width\n    localparam SIDE_WIDTH = (KEEP_ENABLE ? KEEP_WIDTH : 0) +\n                            (LAST_ENABLE ? 1 : 0) +\n                            (ID_ENABLE ? ID_WIDTH : 0) +\n                            (DEST_ENABLE ? DEST_WIDTH : 0) +\n                            (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Build combined sideband vector\n    wire [SIDE_WIDTH-1:0] s_sideband;\n    wire [SIDE_WIDTH-1:0] m_sideband;\n\n    // Pack sidebands\n    generate\n        if (SIDE_WIDTH > 0) begin : gen_sideband_pack\n            reg [SIDE_WIDTH-1:0] s_sideband_reg;\n            reg [SIDE_WIDTH-1:0] m_sideband_reg;\n            integer i;\n            genvar k;\n            localparam SIDE_OFFSET_KEEP = 0;\n            localparam SIDE_OFFSET_LAST = (KEEP_ENABLE ? KEEP_WIDTH : 0);\n            localparam SIDE_OFFSET_ID   = SIDE_OFFSET_LAST + (LAST_ENABLE ? 1 : 0);\n            localparam SIDE_OFFSET_DEST = SIDE_OFFSET_ID + (ID_ENABLE ? ID_WIDTH : 0);\n            localparam SIDE_OFFSET_USER = SIDE_OFFSET_DEST + (DEST_ENABLE ? DEST_WIDTH : 0);\n\n            always @(*) begin\n                s_sideband_reg = {SIDE_WIDTH{1'b0}};\n                if (KEEP_ENABLE)\n                    s_sideband_reg[SIDE_OFFSET_KEEP +: KEEP_WIDTH] = s_axis_tkeep;\n                if (LAST_ENABLE)\n                    s_sideband_reg[SIDE_OFFSET_LAST] = s_axis_tlast;\n                if (ID_ENABLE)\n                    s_sideband_reg[SIDE_OFFSET_ID +: ID_WIDTH] = s_axis_tid;\n                if (DEST_ENABLE)\n                    s_sideband_reg[SIDE_OFFSET_DEST +: DEST_WIDTH] = s_axis_tdest;\n                if (USER_ENABLE)\n                    s_sideband_reg[SIDE_OFFSET_USER +: USER_WIDTH] = s_axis_tuser;\n            end\n            assign s_sideband = s_sideband_reg;\n\n            always @(*) begin\n                m_sideband_reg = {SIDE_WIDTH{1'b0}};\n                if (KEEP_ENABLE)\n                    m_sideband_reg[SIDE_OFFSET_KEEP +: KEEP_WIDTH] = m_axis_tkeep;\n                if (LAST_ENABLE)\n                    m_sideband_reg[SIDE_OFFSET_LAST] = m_axis_tlast;\n                if (ID_ENABLE)\n                    m_sideband_reg[SIDE_OFFSET_ID +: ID_WIDTH] = m_axis_tid;\n                if (DEST_ENABLE)\n                    m_sideband_reg[SIDE_OFFSET_DEST +: DEST_WIDTH] = m_axis_tdest;\n                if (USER_ENABLE)\n                    m_sideband_reg[SIDE_OFFSET_USER +: USER_WIDTH] = m_axis_tuser;\n            end\n        end\n        else begin : gen_sideband_empty\n            assign s_sideband = {SIDE_WIDTH{1'b0}};\n            assign m_sideband = {SIDE_WIDTH{1'b0}};\n        end\n    endgenerate\n\n    // Unpack sidebands from output\n    generate\n        if (SIDE_WIDTH > 0) begin : gen_sideband_unpack\n            localparam SIDE_OFFSET_KEEP = 0;\n            localparam SIDE_OFFSET_LAST = (KEEP_ENABLE ? KEEP_WIDTH : 0);\n            localparam SIDE_OFFSET_ID   = SIDE_OFFSET_LAST + (LAST_ENABLE ? 1 : 0);\n            localparam SIDE_OFFSET_DEST = SIDE_OFFSET_ID + (ID_ENABLE ? ID_WIDTH : 0);\n            localparam SIDE_OFFSET_USER = SIDE_OFFSET_DEST + (DEST_ENABLE ? DEST_WIDTH : 0);\n\n            assign m_axis_tkeep  = KEEP_ENABLE  ? m_sideband[SIDE_OFFSET_KEEP +: KEEP_WIDTH]  : {KEEP_WIDTH{1'b0}};\n            assign m_axis_tlast  = LAST_ENABLE  ? m_sideband[SIDE_OFFSET_LAST]                 : 1'b0;\n            assign m_axis_tid    = ID_ENABLE    ? m_sideband[SIDE_OFFSET_ID +: ID_WIDTH]       : {ID_WIDTH{1'b0}};\n            assign m_axis_tdest  = DEST_ENABLE  ? m_sideband[SIDE_OFFSET_DEST +: DEST_WIDTH]   : {DEST_WIDTH{1'b0}};\n            assign m_axis_tuser  = USER_ENABLE  ? m_sideband[SIDE_OFFSET_USER +: USER_WIDTH]   : {USER_WIDTH{1'b0}};\n        end\n        else begin : gen_sideband_unpack_empty\n            assign m_axis_tkeep  = {KEEP_WIDTH{1'b0}};\n            assign m_axis_tlast  = 1'b0;\n            assign m_axis_tid    = {ID_WIDTH{1'b0}};\n            assign m_axis_tdest  = {DEST_WIDTH{1'b0}};\n            assign m_axis_tuser  = {USER_WIDTH{1'b0}};\n        end\n    endgenerate\n\n    // RAM data width\n    localparam RAM_DATA_WIDTH = DATA_WIDTH + SIDE_WIDTH;\n\n    // Internal signals\n    wire [RAM_DATA_WIDTH-1:0] ram_wdata;\n    wire [RAM_DATA_WIDTH-1:0] ram_rdata;\n    wire [ADDR_WIDTH-1:0]     ram_waddr;\n    wire [ADDR_WIDTH-1:0]     ram_raddr;\n    wire                      ram_wen;\n    wire                      ram_ren;\n\n    // Write pointer\n    reg [PTR_WIDTH-1:0] wr_ptr;\n    // Read pointer\n    reg [PTR_WIDTH-1:0] rd_ptr;\n\n    // Frame tracking\n    reg in_frame;\n    reg frame_bad;\n    reg frame_oversize;\n\n    // Pause state\n    reg paused;\n    reg pause_pending;\n\n    // Status latches\n    reg status_overflow_r;\n    reg status_bad_frame_r;\n    reg status_good_frame_r;\n\n    // Handshake\n    wire wr_valid = s_axis_tvalid;\n    wire rd_valid = m_axis_tvalid;\n    wire rd_ready = m_axis_tready;\n\n    // FIFO full/empty\n    wire fifo_full  = (wr_ptr - rd_ptr == DEPTH);\n    wire fifo_empty = (wr_ptr == rd_ptr);\n\n    // Pause logic\n    wire pause_active = PAUSE_ENABLE ? (paused || pause_pending) : 1'b0;\n    wire frame_pause_active = (FRAME_PAUSE && in_frame) ? 1'b0 : pause_active;\n\n    // Write enable\n    wire wr_en = wr_valid && s_axis_tready && !frame_pause_active;\n\n    // Read enable\n    wire rd_en = rd_valid && rd_ready;\n\n    // Frame boundary detection\n    wire is_last = LAST_ENABLE ? s_axis_tlast : 1'b0;\n\n    // Bad frame detection\n    wire bad_frame_det = (USER_ENABLE && USER_BAD_FRAME_MASK != 0) ?\n                         ((s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) : 1'b0;\n\n    // Oversize detection: frame exceeds DEPTH\n    // We track frame length\n    reg [PTR_WIDTH-1:0] frame_len;\n\n    // Determine if we should drop\n    wire drop_frame = (DROP_OVERSIZE_FRAME && frame_oversize) ||\n                      (DROP_BAD_FRAME && frame_bad);\n\n    // When full behavior\n    wire drop_when_full = (DROP_WHEN_FULL && fifo_full);\n    wire mark_when_full = (MARK_WHEN_FULL && fifo_full);\n\n    // Effective write ready\n    wire s_axis_tready_internal = !fifo_full && !frame_pause_active;\n    assign s_axis_tready = s_axis_tready_internal;\n\n    // Effective read valid\n    assign m_axis_tvalid = !fifo_empty;\n\n    // Pause ack\n    assign pause_ack = PAUSE_ENABLE ? (paused || pause_pending) : 1'b0;\n\n    // Build write data\n    assign ram_wdata = {s_sideband, s_axis_tdata};\n\n    // RAM address\n    assign ram_waddr = wr_ptr[ADDR_WIDTH-1:0];\n    assign ram_raddr = rd_ptr[ADDR_WIDTH-1:0];\n\n    // RAM enable\n    assign ram_wen = wr_en;\n    assign ram_ren = rd_en;\n\n    // RAM read data\n    wire [RAM_DATA_WIDTH-1:0] ram_rdata_internal;\n    assign ram_rdata = ram_rdata_internal;\n\n    // Simple synchronous RAM\n    reg [RAM_DATA_WIDTH-1:0] ram_mem [0:DEPTH_POW2-1];\n\n    always @(posedge clk) begin\n        if (ram_wen)\n            ram_mem[ram_waddr] <= ram_wdata;\n    end\n\n    always @(posedge clk) begin\n        ram_rdata_internal <= ram_mem[ram_raddr];\n    end\n\n    // Output data\n    assign m_axis_tdata = ram_rdata[DATA_WIDTH-1:0];\n    assign m_sideband   = ram_rdata[DATA_WIDTH +: SIDE_WIDTH];\n\n    // Pointer updates\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            wr_ptr <= {PTR_WIDTH{1'b0}};\n            rd_ptr <= {PTR_WIDTH{1'b0}};\n            in_frame <= 1'b0;\n            frame_bad <= 1'b0;\n            frame_oversize <= 1'b0;\n            frame_len <= {PTR_WIDTH{1'b0}};\n            paused <= 1'b0;\n            pause_pending <= 1'b0;\n            status_overflow_r <= 1'b0;\n            status_bad_frame_r <= 1'b0;\n            status_good_frame_r <= 1'b0;\n        end else begin\n            // Write pointer\n            if (wr_en) begin\n                wr_ptr <= wr_ptr + 1'b1;\n            end\n\n            // Read pointer\n            if (rd_en) begin\n                rd_ptr <= rd_ptr + 1'b1;\n            end\n\n            // Frame tracking\n            if (wr_en) begin\n                if (!in_frame) begin\n                    // Start of new frame\n                    in_frame <= 1'b1;\n                    frame_bad <= bad_frame_det;\n                    frame_len <= 1'b1;\n                    frame_oversize <= 1'b0;\n                end else begin\n                    // Continue frame\n                    frame_len <= frame_len + 1'b1;\n                    if (frame_len + 1'b1 > DEPTH)\n                        frame_oversize <= 1'b1;\n                    if (bad_frame_det)\n                        frame_bad <= 1'b1;\n                end\n            end\n\n            if (rd_en) begin\n                // Check if this is the last beat of a frame\n                wire rd_is_last = LAST_ENABLE ? m_axis_tlast : 1'b0;\n                if (rd_is_last) begin\n                    in_frame <= 1'b0;\n                    frame_bad <= 1'b0;\n                    frame_oversize <= 1'b0;\n                    frame_len <= {PTR_WIDTH{1'b0}};\n                end\n            end\n\n            // Pause logic\n            if (PAUSE_ENABLE) begin\n                if (pause_req && !paused && !pause_pending) begin\n                    pause_pending <= 1'b1;\n                end\n                if (pause_pending && !in_frame) begin\n                    paused <= 1'b1;\n                    pause_pending <= 1'b0;\n                end\n                if (!pause_req && paused) begin\n                    paused <= 1'b0;\n                end\n            end\n\n            // Status\n            if (wr_en && fifo_full)\n                status_overflow_r <= 1'b1;\n\n            if (rd_en) begin\n                wire rd_is_last = LAST_ENABLE ? m_axis_tlast : 1'b0;\n                if (rd_is_last) begin\n                    if (frame_bad || frame_oversize)\n                        status_bad_frame_r <= 1'b1;\n                    else\n                        status_good_frame_r <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Status outputs\n    assign status_overflow   = status_overflow_r;\n    assign status_bad_frame  = status_bad_frame_r;\n    assign status_good_frame = status_good_frame_r;\n\n    // Depth calculation\n    wire [PTR_WIDTH:0] depth_raw = wr_ptr - rd_ptr;\n    assign status_depth = depth_raw[$clog2(DEPTH):0];\n    assign status_depth_commit = depth_raw[$clog2(DEPTH):0];\n\nendmodule\n```<|im_end|>",
