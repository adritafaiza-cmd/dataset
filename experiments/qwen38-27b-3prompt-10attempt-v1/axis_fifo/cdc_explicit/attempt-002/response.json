  "text": "```verilog\nmodule axis_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   pause_req,\n    output wire                   pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] status_depth,\n    output wire [$clog2(DEPTH):0] status_depth_commit,\n    output wire                   status_overflow,\n    output wire                   status_bad_frame,\n    output wire                   status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_POW2 = (1 << ADDR_WIDTH);\n    localparam DEPTH_MASK = DEPTH_POW2 - 1;\n\n    // Sideband width calculation\n    localparam SIDE_KEEP_W = KEEP_ENABLE ? KEEP_WIDTH : 0;\n    localparam SIDE_LAST_W = LAST_ENABLE ? 1 : 0;\n    localparam SIDE_ID_W   = ID_ENABLE ? ID_WIDTH : 0;\n    localparam SIDE_DEST_W = DEST_ENABLE ? DEST_WIDTH : 0;\n    localparam SIDE_USER_W = USER_ENABLE ? USER_WIDTH : 0;\n    localparam SIDE_W = SIDE_KEEP_W + SIDE_LAST_W + SIDE_ID_W + SIDE_DEST_W + SIDE_USER_W;\n\n    // Total word width\n    localparam WORD_W = DATA_WIDTH + SIDE_W;\n\n    // Internal signals\n    wire [WORD_W-1:0] wr_data;\n    wire [WORD_W-1:0] rd_data;\n    wire              wr_en;\n    wire              rd_en;\n    wire [ADDR_WIDTH:0] wr_ptr;\n    wire [ADDR_WIDTH:0] rd_ptr;\n    wire [ADDR_WIDTH:0] depth;\n    wire              full;\n    wire              empty;\n    wire              overflow;\n    wire              underflow;\n\n    // Frame tracking\n    reg               in_frame;\n    reg [ADDR_WIDTH:0] frame_count;\n    wire              frame_overflow;\n    wire              frame_bad;\n    wire              frame_good;\n    wire              drop_frame;\n    wire              mark_frame;\n\n    // Pause logic\n    reg               pause_active;\n    wire              pause_block_wr;\n    wire              pause_block_rd;\n\n    // Status latches\n    reg               status_overflow_reg;\n    reg               status_bad_frame_reg;\n    reg               status_good_frame_reg;\n\n    // Build write data\n    assign wr_data = {\n        SIDE_USER_W'(s_axis_tuser),\n        SIDE_DEST_W'(s_axis_tdest),\n        SIDE_ID_W'(s_axis_tid),\n        SIDE_LAST_W'(s_axis_tlast),\n        SIDE_KEEP_W'(s_axis_tkeep),\n        s_axis_tdata\n    };\n\n    // Extract read data\n    wire [DATA_WIDTH-1:0] rd_tdata = rd_data[DATA_WIDTH-1:0];\n    wire [KEEP_WIDTH-1:0] rd_tkeep = KEEP_ENABLE ? rd_data[DATA_WIDTH + SIDE_KEEP_W - 1 : DATA_WIDTH] : {KEEP_WIDTH{1'b0}};\n    wire                  rd_tlast = LAST_ENABLE ? rd_data[DATA_WIDTH + SIDE_KEEP_W] : 1'b0;\n    wire [ID_WIDTH-1:0]   rd_tid   = ID_ENABLE ? rd_data[DATA_WIDTH + SIDE_KEEP_W + SIDE_LAST_W + SIDE_ID_W - 1 : DATA_WIDTH + SIDE_KEEP_W + SIDE_LAST_W] : {ID_WIDTH{1'b0}};\n    wire [DEST_WIDTH-1:0] rd_tdest = DEST_ENABLE ? rd_data[DATA_WIDTH + SIDE_KEEP_W + SIDE_LAST_W + SIDE_ID_W + SIDE_DEST_W - 1 : DATA_WIDTH + SIDE_KEEP_W + SIDE_LAST_W + SIDE_ID_W] : {DEST_WIDTH{1'b0}};\n    wire [USER_WIDTH-1:0] rd_tuser = USER_ENABLE ? rd_data[WORD_W-1 : DATA_WIDTH + SIDE_KEEP_W + SIDE_LAST_W + SIDE_ID_W + SIDE_DEST_W] : {USER_WIDTH{1'b0}};\n\n    // Frame bad detection\n    wire frame_bad_user = USER_ENABLE && (rd_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE;\n    assign frame_bad = FRAME_FIFO && frame_bad_user;\n\n    // Frame overflow detection\n    assign frame_overflow = FRAME_FIFO && (frame_count >= DEPTH);\n\n    // Drop/mark logic\n    assign drop_frame = (DROP_OVERSIZE_FRAME && frame_overflow) || (DROP_BAD_FRAME && frame_bad);\n    assign mark_frame = MARK_WHEN_FULL && full;\n\n    // Pause logic\n    wire pause_req_eff = PAUSE_ENABLE ? pause_req : 1'b0;\n    wire frame_pause_eff = FRAME_PAUSE ? in_frame : 1'b0;\n    assign pause_block_wr = pause_req_eff || (FRAME_PAUSE && in_frame);\n    assign pause_block_rd = pause_req_eff;\n\n    // Handshake\n    wire wr_allowed = s_axis_tvalid && !full && !pause_block_wr && !drop_frame;\n    wire rd_allowed = m_axis_tready && !empty && !pause_block_rd;\n\n    assign s_axis_tready = !full && !pause_block_wr && !drop_frame;\n    assign m_axis_tvalid = !empty && !pause_block_rd;\n\n    // Write enable\n    assign wr_en = wr_allowed;\n\n    // Read enable\n    assign rd_en = rd_allowed;\n\n    // FIFO core\n    fifo_core #(\n        .DEPTH (DEPTH),\n        .WIDTH (WORD_W)\n    ) u_fifo (\n        .clk     (clk),\n        .rst     (rst),\n        .wr_en   (wr_en),\n        .wr_data (wr_data),\n        .rd_en   (rd_en),\n        .rd_data (rd_data),\n        .full    (full),\n        .empty   (empty),\n        .depth   (depth),\n        .overflow(overflow),\n        .underflow(underflow)\n    );\n\n    // Frame tracking\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            in_frame <= 1'b0;\n            frame_count <= {(ADDR_WIDTH+1){1'b0}};\n        end else begin\n            if (wr_en) begin\n                if (s_axis_tlast) begin\n                    in_frame <= 1'b0;\n                    frame_count <= {(ADDR_WIDTH+1){1'b0}};\n                end else begin\n                    in_frame <= 1'b1;\n                    frame_count <= frame_count + 1'b1;\n                end\n            end else if (rd_en) begin\n                if (rd_tlast) begin\n                    in_frame <= 1'b0;\n                    frame_count <= {(ADDR_WIDTH+1){1'b0}};\n                end else begin\n                    in_frame <= 1'b1;\n                    frame_count <= frame_count + 1'b1;\n                end\n            end\n        end\n    end\n\n    // Status latches\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            status_overflow_reg <= 1'b0;\n            status_bad_frame_reg <= 1'b0;\n            status_good_frame_reg <= 1'b0;\n        end else begin\n            if (overflow) status_overflow_reg <= 1'b1;\n            if (rd_en && frame_bad) status_bad_frame_reg <= 1'b1;\n            if (rd_en && rd_tlast && !frame_bad) status_good_frame_reg <= 1'b1;\n        end\n    end\n\n    // Pause ack\n    assign pause_ack = pause_active;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            pause_active <= 1'b0;\n        end else begin\n            pause_active <= pause_req_eff;\n        end\n    end\n\n    // Outputs\n    assign m_axis_tdata = rd_tdata;\n    assign m_axis_tkeep = rd_tkeep;\n    assign m_axis_tlast = rd_tlast;\n    assign m_axis_tid   = rd_tid;\n    assign m_axis_tdest = rd_tdest;\n    assign m_axis_tuser = rd_tuser;\n\n    assign status_depth = depth;\n    assign status_depth_commit = depth;\n    assign status_overflow = status_overflow_reg;\n    assign status_bad_frame = status_bad_frame_reg;\n    assign status_good_frame = status_good_frame_reg;\n\nendmodule\n\nmodule fifo_core #(\n    parameter DEPTH = 4096,\n    parameter WIDTH = 8\n) (\n    input  wire                  clk,\n    input  wire                  rst,\n    input  wire                  wr_en,\n    input  wire [WIDTH-1:0]      wr_data,\n    input  wire                  rd_en,\n    output reg  [WIDTH-1:0]      rd_data,\n    output wire                  full,\n    output wire                  empty,\n    output wire [$clog2(DEPTH):0] depth,\n    output wire                  overflow,\n    output wire                  underflow\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_POW2 = (1 << ADDR_WIDTH);\n    localparam DEPTH_MASK = DEPTH_POW2 - 1;\n\n    reg [WIDTH-1:0] mem [0:DEPTH_POW2-1];\n    reg [ADDR_WIDTH:0] wr_ptr;\n    reg [ADDR_WIDTH:0] rd_ptr;\n\n    wire [ADDR_WIDTH:0] depth_calc = wr_ptr - rd_ptr;\n    wire full = (depth_calc == DEPTH);\n    wire empty = (depth_calc == 0);\n\n    wire overflow = wr_en && full;\n    wire underflow = rd_en && empty;\n\n    assign depth = depth_calc;\n\n    always @(posedge clk) begin\n        if (wr_en && !full) begin\n            mem[wr_ptr[ADDR_WIDTH-1:0]] <= wr_data;\n            wr_ptr <= wr_ptr + 1'b1;\n        end\n    end\n\n    always @(posedge clk) begin\n        if (rd_en && !empty) begin\n            rd_data <= mem[rd_ptr[ADDR_WIDTH-1:0]];\n            rd_ptr <= rd_ptr + 1'b1;\n        end\n    end\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            wr_ptr <= {(ADDR_WIDTH+1){1'b0}};\n            rd_ptr <= {(ADDR_WIDTH+1){1'b0}};\n            rd_data <= {WIDTH{1'b0}};\n        end\n    end\n\nendmodule\n```<|im_end|>",
