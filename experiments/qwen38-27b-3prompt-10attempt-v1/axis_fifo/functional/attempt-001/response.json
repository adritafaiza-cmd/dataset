  "text": "```verilog\nmodule axis_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   pause_req,\n    output wire                   pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] status_depth,\n    output wire [$clog2(DEPTH):0] status_depth_commit,\n    output wire                   status_overflow,\n    output wire                   status_bad_frame,\n    output wire                   status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signal widths\n    localparam KEEP_W = KEEP_ENABLE ? KEEP_WIDTH : 0;\n    localparam ID_W   = ID_ENABLE   ? ID_WIDTH   : 0;\n    localparam DEST_W = DEST_ENABLE ? DEST_WIDTH : 0;\n    localparam USER_W = USER_ENABLE ? USER_WIDTH : 0;\n\n    // RAM storage\n    reg [DATA_WIDTH-1:0] ram_data [0:DEPTH-1];\n    reg [KEEP_W-1:0]     ram_keep [0:DEPTH-1];\n    reg                  ram_last [0:DEPTH-1];\n    reg [ID_W-1:0]       ram_id   [0:DEPTH-1];\n    reg [DEST_W-1:0]     ram_dest [0:DEPTH-1];\n    reg [USER_W-1:0]     ram_user [0:DEPTH-1];\n\n    // Pointers\n    reg [ADDR_WIDTH:0] wr_ptr;\n    reg [ADDR_WIDTH:0] rd_ptr;\n\n    // Control signals\n    wire wr_en;\n    wire rd_en;\n    wire full;\n    wire empty;\n\n    // Frame tracking\n    reg in_frame;\n    reg frame_bad;\n    reg frame_oversize;\n    reg [ADDR_WIDTH:0] frame_count;\n\n    // Pause logic\n    reg pause_active;\n    reg pause_at_frame_end;\n\n    // Status latches\n    reg status_overflow_reg;\n    reg status_bad_frame_reg;\n    reg status_good_frame_reg;\n\n    // Output registers\n    reg [DATA_WIDTH-1:0] out_data;\n    reg [KEEP_W-1:0]     out_keep;\n    reg                  out_last;\n    reg [ID_W-1:0]       out_id;\n    reg [DEST_W-1:0]     out_dest;\n    reg [USER_W-1:0]     out_user;\n    reg                  out_valid;\n\n    // Pipeline registers for RAM read\n    reg [ADDR_WIDTH:0] rd_ptr_pipe;\n    reg [DATA_WIDTH-1:0] pipe_data;\n    reg [KEEP_W-1:0]     pipe_keep;\n    reg                  pipe_last;\n    reg [ID_W-1:0]       pipe_id;\n    reg [DEST_W-1:0]     pipe_dest;\n    reg [USER_W-1:0]     pipe_user;\n    reg                  pipe_valid;\n\n    // Depth calculation\n    wire [$clog2(DEPTH):0] depth = wr_ptr - rd_ptr;\n    wire [$clog2(DEPTH):0] depth_commit = wr_ptr - rd_ptr;\n\n    // Full and empty\n    assign full  = (wr_ptr[ADDR_WIDTH] != rd_ptr[ADDR_WIDTH]) && \n                   (wr_ptr[ADDR_WIDTH-1:0] == rd_ptr[ADDR_WIDTH-1:0]);\n    assign empty = (wr_ptr == rd_ptr);\n\n    // Write address\n    wire [ADDR_WIDTH-1:0] wr_addr = wr_ptr[ADDR_WIDTH-1:0];\n    wire [ADDR_WIDTH-1:0] rd_addr = rd_ptr[ADDR_WIDTH-1:0];\n\n    // Read address for pipeline\n    wire [ADDR_WIDTH-1:0] rd_addr_pipe = rd_ptr_pipe[ADDR_WIDTH-1:0];\n\n    // Handshake\n    wire s_axis_tready_internal;\n    wire m_axis_tready_internal;\n\n    // Determine if we can accept new data\n    wire can_write = !full && !pause_active;\n    \n    // Frame oversize check\n    wire frame_oversize_check = FRAME_FIFO && in_frame && (frame_count >= DEPTH[$clog2(DEPTH):0]);\n\n    // Bad frame detection\n    wire bad_frame_check = USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE;\n\n    // Write enable logic\n    wire do_write = s_axis_tvalid && s_axis_tready_internal;\n\n    // Drop logic\n    wire drop_oversize = DROP_OVERSIZE_FRAME && in_frame && frame_oversize_check;\n    wire drop_bad = DROP_BAD_FRAME && bad_frame_check;\n    wire drop_when_full = DROP_WHEN_FULL && full;\n    wire mark_when_full = MARK_WHEN_FULL && full;\n\n    // Should we actually write to RAM?\n    wire write_to_ram = do_write && !drop_oversize && !drop_bad && !drop_when_full;\n\n    // Assign s_axis_tready\n    assign s_axis_tready = s_axis_tready_internal;\n\n    // Determine s_axis_tready_internal\n    // If dropping, we still accept to consume the data\n    // If not dropping, we need space\n    assign s_axis_tready_internal = !full && !pause_active;\n\n    // Read enable\n    assign rd_en = m_axis_tvalid && m_axis_tready;\n\n    // Output valid\n    assign m_axis_tvalid = out_valid;\n\n    // Output data\n    assign m_axis_tdata = out_data;\n    assign m_axis_tkeep = out_keep;\n    assign m_axis_tlast = out_last;\n    assign m_axis_tid   = out_id;\n    assign m_axis_tdest = out_dest;\n    assign m_axis_tuser = out_user;\n\n    // Pause\n    assign pause_ack = pause_active;\n\n    // Status\n    assign status_depth = depth;\n    assign status_depth_commit = depth_commit;\n    assign status_overflow = status_overflow_reg;\n    assign status_bad_frame = status_bad_frame_reg;\n    assign status_good_frame = status_good_frame_reg;\n\n    // RAM write\n    always @(posedge clk) begin\n        if (rst) begin\n            wr_ptr <= 0;\n            rd_ptr <= 0;\n            in_frame <= 0;\n            frame_bad <= 0;\n            frame_oversize <= 0;\n            frame_count <= 0;\n            pause_active <= 0;\n            pause_at_frame_end <= 0;\n            status_overflow_reg <= 0;\n            status_bad_frame_reg <= 0;\n            status_good_frame_reg <= 0;\n            out_data <= 0;\n            out_keep <= 0;\n            out_last <= 0;\n            out_id <= 0;\n            out_dest <= 0;\n            out_user <= 0;\n            out_valid <= 0;\n            rd_ptr_pipe <= 0;\n            pipe_data <= 0;\n            pipe_keep <= 0;\n            pipe_last <= 0;\n            pipe_id <= 0;\n            pipe_dest <= 0;\n            pipe_user <= 0;\n            pipe_valid <= 0;\n        end else begin\n            // Handle pause\n            if (PAUSE_ENABLE) begin\n                if (pause_req && !pause_active) begin\n                    pause_active <= 1;\n                    if (FRAME_PAUSE) begin\n                        pause_at_frame_end <= 1;\n                    end else begin\n                        pause_at_frame_end <= 0;\n                    end\n                end else if (!pause_req && pause_active) begin\n                    if (!FRAME_PAUSE || !in_frame || s_axis_tlast) begin\n                        pause_active <= 0;\n                        pause_at_frame_end <= 0;\n                    end\n                end\n            end\n\n            // Write to RAM\n            if (write_to_ram) begin\n                ram_data[wr_addr] <= s_axis_tdata;\n                if (KEEP_ENABLE) ram_keep[wr_addr] <= s_axis_tkeep;\n                if (LAST_ENABLE) ram_last[wr_addr] <= s_axis_tlast;\n                if (ID_ENABLE)   ram_id[wr_addr]   <= s_axis_tid;\n                if (DEST_ENABLE) ram_dest[wr_addr] <= s_axis_tdest;\n                if (USER_ENABLE) ram_user[wr_addr] <= s_axis_tuser;\n            end\n\n            // Update write pointer\n            if (do_write) begin\n                wr_ptr <= wr_ptr + 1;\n            end\n\n            // Frame tracking\n            if (do_write) begin\n                if (!in_frame) begin\n                    in_frame <= 1;\n                    frame_count <= 1;\n                    frame_bad <= 0;\n                    frame_oversize <= 0;\n                end else begin\n                    frame_count <= frame_count + 1;\n                    if (FRAME_FIFO && frame_count >= DEPTH[$clog2(DEPTH):0]) begin\n                        frame_oversize <= 1;\n                    end\n                    if (USER_ENABLE && bad_frame_check) begin\n                        frame_bad <= 1;\n                    end\n                end\n\n                if (s_axis_tlast) begin\n                    // Frame complete\n                    if (frame_bad || (DROP_OVERSIZE_FRAME && frame_oversize)) begin\n                        status_bad_frame_reg <= 1;\n                    end else begin\n                        status_good_frame_reg <= 1;\n                    end\n                    in_frame <= 0;\n                    frame_count <= 0;\n                    frame_bad <= 0;\n                    frame_oversize <= 0;\n                end\n            end\n\n            // Overflow detection\n            if (s_axis_tvalid && !s_axis_tready) begin\n                status_overflow_reg <= 1;\n            end\n\n            // Read from RAM (pipeline)\n            if (RAM_PIPELINE) begin\n                // Pipeline stage 1: read address\n                if (!empty) begin\n                    rd_ptr_pipe <= rd_ptr;\n                    pipe_data <= ram_data[rd_addr];\n                    if (KEEP_ENABLE) pipe_keep <= ram_keep[rd_addr];\n                    if (LAST_ENABLE) pipe_last <= ram_last[rd_addr];\n                    if (ID_ENABLE)   pipe_id   <= ram_id[rd_addr];\n                    if (DEST_ENABLE) pipe_dest  <= ram_dest[rd_addr];\n                    if (USER_ENABLE) pipe_user  <= ram_user[rd_addr];\n                    pipe_valid <= 1;\n                end else begin\n                    pipe_valid <= 0;\n                end\n\n                // Pipeline stage 2: output\n                if (pipe_valid) begin\n                    out_data <= pipe_data;\n                    out_keep <= pipe_keep;\n                    out_last <= pipe_last;\n                    out_id   <= pipe_id;\n                    out_dest <= pipe_dest;\n                    out_user <= pipe_user;\n                    out_valid <= 1;\n                end else begin\n                    out_valid <= 0;\n                end\n\n                // Update read pointer\n                if (rd_en) begin\n                    rd_ptr <= rd_ptr + 1;\n                end\n            end else begin\n                // No pipeline\n                if (!empty) begin\n                    out_data <= ram_data[rd_addr];\n                    if (KEEP_ENABLE) out_keep <= ram_keep[rd_addr];\n                    if (LAST_ENABLE) out_last <= ram_last[rd_addr];\n                    if (ID_ENABLE)   out_id   <= ram_id[rd_addr];\n                    if (DEST_ENABLE) out_dest <= ram_dest[rd_addr];\n                    if (USER_ENABLE) out_user <= ram_user[rd_addr];\n                    out_valid <= 1;\n                end else begin\n                    out_valid <= 0;\n                end\n\n                if (rd_en) begin\n                    rd_ptr <= rd_ptr + 1;\n                end\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
