  "text": "```verilog\nmodule axis_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   pause_req,\n    output wire                   pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] status_depth,\n    output wire [$clog2(DEPTH):0] status_depth_commit,\n    output wire                   status_overflow,\n    output wire                   status_bad_frame,\n    output wire                   status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    reg [ADDR_WIDTH:0] wr_ptr;\n    reg [ADDR_WIDTH:0] rd_ptr;\n    reg [ADDR_WIDTH:0] depth_reg;\n    reg [ADDR_WIDTH:0] depth_commit_reg;\n\n    // RAM storage\n    reg [DATA_WIDTH-1:0] ram_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] ram_keep [0:DEPTH-1];\n    reg                  ram_last [0:DEPTH-1];\n    reg [ID_WIDTH-1:0]   ram_id   [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0] ram_dest [0:DEPTH-1];\n    reg [USER_WIDTH-1:0] ram_user [0:DEPTH-1];\n\n    // Write side\n    wire wr_en = s_axis_tvalid & s_axis_tready;\n    wire [ADDR_WIDTH-1:0] wr_addr = wr_ptr[ADDR_WIDTH-1:0];\n\n    // Read side\n    wire [ADDR_WIDTH-1:0] rd_addr = rd_ptr[ADDR_WIDTH-1:0];\n    wire rd_en = m_axis_tvalid & m_axis_tready;\n\n    // Output FIFO (if enabled)\n    reg [DATA_WIDTH-1:0] out_data;\n    reg [KEEP_WIDTH-1:0] out_keep;\n    reg                  out_last;\n    reg [ID_WIDTH-1:0]   out_id;\n    reg [DEST_WIDTH-1:0] out_dest;\n    reg [USER_WIDTH-1:0] out_user;\n    reg                  out_valid;\n\n    // Frame tracking\n    reg                  in_frame;\n    reg                  frame_bad;\n    reg                  frame_oversize;\n    reg [ADDR_WIDTH:0]   frame_count;\n\n    // Pause logic\n    reg                  pause_active;\n\n    // Status pulses\n    reg                  overflow_pulse;\n    reg                  bad_frame_pulse;\n    reg                  good_frame_pulse;\n\n    // RAM read pipeline\n    reg [DATA_WIDTH-1:0] ram_rd_data;\n    reg [KEEP_WIDTH-1:0] ram_rd_keep;\n    reg                  ram_rd_last;\n    reg [ID_WIDTH-1:0]   ram_rd_id;\n    reg [DEST_WIDTH-1:0] ram_rd_dest;\n    reg [USER_WIDTH-1:0] ram_rd_user;\n    reg                  ram_rd_valid;\n\n    // Compute depth\n    wire [ADDR_WIDTH:0] depth = wr_ptr - rd_ptr;\n\n    // Full and empty\n    wire full = (depth == DEPTH);\n    wire empty = (depth == 0);\n\n    // Pause logic\n    wire pause_effective = PAUSE_ENABLE ? pause_req : 1'b0;\n    wire frame_pause_active = FRAME_PAUSE ? (in_frame & pause_effective) : pause_effective;\n\n    // Write ready\n    wire wr_ready_base = !full;\n    wire wr_ready_pause = !frame_pause_active;\n    wire wr_ready_drop = DROP_WHEN_FULL ? 1'b1 : wr_ready_base;\n    wire s_axis_tready_internal = wr_ready_drop & wr_ready_pause;\n    assign s_axis_tready = s_axis_tready_internal;\n\n    // Overflow detection\n    wire overflow = s_axis_tvalid & full & !DROP_WHEN_FULL;\n    assign status_overflow = overflow;\n\n    // Frame tracking\n    wire frame_start = s_axis_tvalid & s_axis_tready & !in_frame;\n    wire frame_end = s_axis_tvalid & s_axis_tready & s_axis_tlast;\n\n    // Bad frame detection\n    wire bad_frame_det = USER_ENABLE & (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE;\n    wire bad_frame_event = s_axis_tvalid & s_axis_tready & bad_frame_det;\n\n    // Oversize frame detection\n    wire oversize_det = (frame_count == DEPTH) & !s_axis_tlast;\n    wire oversize_event = s_axis_tvalid & s_axis_tready & oversize_det;\n\n    // Drop logic\n    wire drop_frame = (DROP_OVERSIZE_FRAME & frame_oversize) | (DROP_BAD_FRAME & frame_bad);\n    wire drop_word = drop_frame;\n\n    // Mark when full\n    wire mark_full = MARK_WHEN_FULL & full & s_axis_tvalid & s_axis_tready;\n\n    // Write to RAM\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            wr_ptr <= 0;\n            rd_ptr <= 0;\n            depth_reg <= 0;\n            depth_commit_reg <= 0;\n            in_frame <= 0;\n            frame_bad <= 0;\n            frame_oversize <= 0;\n            frame_count <= 0;\n            pause_active <= 0;\n            overflow_pulse <= 0;\n            bad_frame_pulse <= 0;\n            good_frame_pulse <= 0;\n            ram_rd_valid <= 0;\n            out_valid <= 0;\n        end else begin\n            // Update pointers\n            if (wr_en & !drop_word) begin\n                wr_ptr <= wr_ptr + 1;\n            end\n            if (rd_en) begin\n                rd_ptr <= rd_ptr + 1;\n            end\n\n            // Update depth\n            depth_reg <= depth;\n            depth_commit_reg <= depth;\n\n            // Frame tracking\n            if (frame_start) begin\n                in_frame <= 1;\n                frame_bad <= 0;\n                frame_oversize <= 0;\n                frame_count <= 1;\n            end else if (in_frame) begin\n                if (frame_end) begin\n                    in_frame <= 0;\n                    frame_count <= 0;\n                end else if (wr_en & !drop_word) begin\n                    frame_count <= frame_count + 1;\n                    if (frame_count == DEPTH) begin\n                        frame_oversize <= 1;\n                    end\n                end\n            end\n\n            // Bad frame tracking\n            if (bad_frame_event) begin\n                frame_bad <= 1;\n            end\n\n            // Pause\n            pause_active <= pause_effective;\n\n            // Status pulses\n            overflow_pulse <= overflow;\n            bad_frame_pulse <= bad_frame_event;\n            good_frame_pulse <= frame_end & !frame_bad & !frame_oversize;\n        end\n    end\n\n    // RAM write\n    always @(posedge clk) begin\n        if (wr_en & !drop_word) begin\n            ram_data[wr_addr] <= s_axis_tdata;\n            ram_keep[wr_addr] <= s_axis_tkeep;\n            ram_last[wr_addr] <= s_axis_tlast;\n            ram_id[wr_addr]   <= s_axis_tid;\n            ram_dest[wr_addr] <= s_axis_tdest;\n            ram_user[wr_addr] <= s_axis_tuser;\n        end\n    end\n\n    // RAM read\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            ram_rd_valid <= 0;\n        end else begin\n            if (rd_en) begin\n                ram_rd_valid <= 1;\n                ram_rd_data  <= ram_data[rd_addr];\n                ram_rd_keep  <= ram_keep[rd_addr];\n                ram_rd_last  <= ram_last[rd_addr];\n                ram_rd_id    <= ram_id[rd_addr];\n                ram_rd_dest  <= ram_dest[rd_addr];\n                ram_rd_user  <= ram_user[rd_addr];\n            end else begin\n                ram_rd_valid <= 0;\n            end\n        end\n    end\n\n    // Output FIFO\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            out_valid <= 0;\n        end else begin\n            if (OUTPUT_FIFO_ENABLE) begin\n                if (ram_rd_valid & !out_valid) begin\n                    out_valid <= 1;\n                    out_data  <= ram_rd_data;\n                    out_keep  <= ram_rd_keep;\n                    out_last  <= ram_rd_last;\n                    out_id    <= ram_rd_id;\n                    out_dest  <= ram_rd_dest;\n                    out_user  <= ram_rd_user;\n                end else if (out_valid & m_axis_tready) begin\n                    out_valid <= 0;\n                end\n            end else begin\n                out_valid <= ram_rd_valid;\n                if (ram_rd_valid) begin\n                    out_data  <= ram_rd_data;\n                    out_keep  <= ram_rd_keep;\n                    out_last  <= ram_rd_last;\n                    out_id    <= ram_rd_id;\n                    out_dest  <= ram_rd_dest;\n                    out_user  <= ram_rd_user;\n                end\n            end\n        end\n    end\n\n    // Output assignments\n    assign m_axis_tvalid = out_valid;\n    assign m_axis_tdata  = out_data;\n    assign m_axis_tkeep  = out_keep;\n    assign m_axis_tlast  = out_last;\n    assign m_axis_tid    = out_id;\n    assign m_axis_tdest  = out_dest;\n    assign m_axis_tuser  = out_user;\n\n    // Pause ack\n    assign pause_ack = PAUSE_ENABLE ? pause_active : 1'b0;\n\n    // Status outputs\n    assign status_depth = depth_reg;\n    assign status_depth_commit = depth_commit_reg;\n    assign status_bad_frame = bad_frame_pulse;\n    assign status_good_frame = good_frame_pulse;\n\nendmodule\n```<|im_end|>",
