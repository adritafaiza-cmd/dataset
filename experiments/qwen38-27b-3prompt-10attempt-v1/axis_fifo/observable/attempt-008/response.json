  "text": "```verilog\nmodule axis_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   pause_req,\n    output wire                   pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] status_depth,\n    output wire [$clog2(DEPTH):0] status_depth_commit,\n    output wire                   status_overflow,\n    output wire                   status_bad_frame,\n    output wire                   status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    wire [DATA_WIDTH-1:0]  ram_dout;\n    wire [KEEP_WIDTH-1:0]  ram_keep_dout;\n    wire                    ram_last_dout;\n    wire [ID_WIDTH-1:0]    ram_id_dout;\n    wire [DEST_WIDTH-1:0]  ram_dest_dout;\n    wire [USER_WIDTH-1:0]  ram_user_dout;\n\n    wire                    ram_we;\n    wire [ADDR_WIDTH-1:0]  ram_waddr;\n    wire [ADDR_WIDTH-1:0]  ram_raddr;\n\n    wire                    fifo_empty;\n    wire                    fifo_full;\n    wire [$clog2(DEPTH):0]  fifo_count;\n\n    // Frame tracking\n    reg                     in_frame;\n    reg [ADDR_WIDTH:0]      frame_beats;\n    reg                     frame_overflow;\n    reg                     frame_bad;\n\n    // Drop/mark logic\n    reg                     drop_current_frame;\n    reg                     mark_current_frame;\n\n    // Pause logic\n    reg                     pause_active;\n\n    // Status latches\n    reg                     status_overflow_reg;\n    reg                     status_bad_frame_reg;\n    reg                     status_good_frame_reg;\n\n    // Output register\n    reg [DATA_WIDTH-1:0]  out_data;\n    reg [KEEP_WIDTH-1:0]  out_keep;\n    reg                    out_last;\n    reg [ID_WIDTH-1:0]    out_id;\n    reg [DEST_WIDTH-1:0]  out_dest;\n    reg [USER_WIDTH-1:0]  out_user;\n    reg                    out_valid;\n\n    // Write pointer\n    reg [ADDR_WIDTH-1:0]  wptr;\n    // Read pointer\n    reg [ADDR_WIDTH-1:0]  rptr;\n\n    // RAM storage\n    reg [DATA_WIDTH-1:0]  ram_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0]  ram_keep [0:DEPTH-1];\n    reg                    ram_last [0:DEPTH-1];\n    reg [ID_WIDTH-1:0]    ram_id   [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0]  ram_dest [0:DEPTH-1];\n    reg [USER_WIDTH-1:0]  ram_user [0:DEPTH-1];\n\n    // Determine if we should accept a beat\n    wire beat_accepted = s_axis_tvalid && s_axis_tready;\n\n    // Determine if we should read from FIFO\n    wire read_enabled = out_valid && m_axis_tready;\n\n    // Frame size limit: DEPTH beats max per frame\n    wire frame_oversized = (frame_beats == DEPTH[ADDR_WIDTH:0]) && !s_axis_tlast;\n\n    // Determine if current frame should be dropped\n    wire should_drop = drop_current_frame || \n                       (DROP_OVERSIZE_FRAME && frame_oversized) ||\n                       (DROP_BAD_FRAME && frame_bad);\n\n    // Determine if current frame should be marked\n    wire should_mark = mark_current_frame ||\n                       (MARK_WHEN_FULL && fifo_full && !DROP_WHEN_FULL);\n\n    // Input ready logic\n    wire input_ready_base = !fifo_full && !pause_active;\n    wire input_ready_frame = !in_frame || !frame_oversized;\n    \n    assign s_axis_tready = input_ready_base && input_ready_frame;\n\n    // Pause logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            pause_active <= 1'b0;\n        end else if (PAUSE_ENABLE) begin\n            if (pause_req) begin\n                pause_active <= 1'b1;\n            end else if (!pause_req && !out_valid) begin\n                pause_active <= 1'b0;\n            end\n        end else begin\n            pause_active <= 1'b0;\n        end\n    end\n\n    assign pause_ack = pause_active;\n\n    // Write to RAM\n    assign ram_we = beat_accepted;\n    assign ram_waddr = wptr;\n\n    always @(posedge clk) begin\n        if (ram_we) begin\n            ram_data[wptr] <= s_axis_tdata;\n            ram_keep[wptr] <= s_axis_tkeep;\n            ram_last[wptr] <= s_axis_tlast;\n            ram_id[wptr]   <= s_axis_tid;\n            ram_dest[wptr] <= s_axis_tdest;\n            ram_user[wptr] <= s_axis_tuser;\n        end\n    end\n\n    // Read from RAM\n    assign ram_raddr = rptr;\n\n    always @(posedge clk) begin\n        ram_dout      <= ram_data[ram_raddr];\n        ram_keep_dout <= ram_keep[ram_raddr];\n        ram_last_dout <= ram_last[ram_raddr];\n        ram_id_dout   <= ram_id[ram_raddr];\n        ram_dest_dout <= ram_dest[ram_raddr];\n        ram_user_dout <= ram_user[ram_raddr];\n    end\n\n    // FIFO pointers\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            wptr <= {ADDR_WIDTH{1'b0}};\n            rptr <= {ADDR_WIDTH{1'b0}};\n        end else begin\n            if (ram_we) begin\n                wptr <= wptr + 1'b1;\n            end\n            if (read_enabled) begin\n                rptr <= rptr + 1'b1;\n            end\n        end\n    end\n\n    // FIFO status\n    assign fifo_count = wptr - rptr;\n    assign fifo_empty = (wptr == rptr);\n    assign fifo_full  = (fifo_count == DEPTH[ADDR_WIDTH:0]);\n\n    // Frame tracking\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            in_frame         <= 1'b0;\n            frame_beats      <= {(ADDR_WIDTH+1){1'b0}};\n            frame_overflow   <= 1'b0;\n            frame_bad        <= 1'b0;\n            drop_current_frame <= 1'b0;\n            mark_current_frame <= 1'b0;\n        end else begin\n            if (beat_accepted) begin\n                if (!in_frame) begin\n                    // Start of new frame\n                    in_frame         <= 1'b1;\n                    frame_beats      <= 1'b1;\n                    frame_overflow   <= 1'b0;\n                    frame_bad        <= 1'b0;\n                    drop_current_frame <= 1'b0;\n                    mark_current_frame <= 1'b0;\n                end else begin\n                    frame_beats <= frame_beats + 1'b1;\n                    if (frame_beats == DEPTH[ADDR_WIDTH:0]) begin\n                        frame_overflow <= 1'b1;\n                    end\n                end\n\n                if (s_axis_tlast) begin\n                    // End of frame\n                    in_frame <= 1'b0;\n                    frame_beats <= {(ADDR_WIDTH+1){1'b0}};\n                end\n            end\n        end\n    end\n\n    // Detect bad frame based on user signal\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            frame_bad <= 1'b0;\n        end else begin\n            if (beat_accepted && in_frame) begin\n                if (s_axis_tuser[0] == USER_BAD_FRAME_VALUE) begin\n                    frame_bad <= 1'b1;\n                end\n            end\n            if (s_axis_tlast && beat_accepted) begin\n                frame_bad <= 1'b0;\n            end\n        end\n    end\n\n    // Update drop/mark flags when frame starts\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            drop_current_frame <= 1'b0;\n            mark_current_frame <= 1'b0;\n        end else begin\n            if (beat_accepted && !in_frame) begin\n                // New frame starting\n                drop_current_frame <= (DROP_OVERSIZE_FRAME && 1'b0) || \n                                      (DROP_BAD_FRAME && 1'b0);\n                mark_current_frame <= (MARK_WHEN_FULL && fifo_full && !DROP_WHEN_FULL);\n            end\n        end\n    end\n\n    // Output logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            out_data  <= {DATA_WIDTH{1'b0}};\n            out_keep  <= {KEEP_WIDTH{1'b0}};\n            out_last  <= 1'b0;\n            out_id    <= {ID_WIDTH{1'b0}};\n            out_dest  <= {DEST_WIDTH{1'b0}};\n            out_user  <= {USER_WIDTH{1'b0}};\n            out_valid <= 1'b0;\n        end else begin\n            if (read_enabled) begin\n                out_valid <= 1'b0;\n            end\n            if (!out_valid && !fifo_empty) begin\n                out_data  <= ram_dout;\n                out_keep  <= ram_keep_dout;\n                out_last  <= ram_last_dout;\n                out_id    <= ram_id_dout;\n                out_dest  <= ram_dest_dout;\n                out_user  <= ram_user_dout;\n                out_valid <= 1'b1;\n            end\n        end\n    end\n\n    // Apply drop/mark to output\n    wire [USER_WIDTH-1:0] modified_user;\n    assign modified_user = should_drop ? \n                           (out_user & ~USER_BAD_FRAME_MASK) | (USER_BAD_FRAME_VALUE & USER_BAD_FRAME_MASK) :\n                           out_user;\n\n    assign m_axis_tdata  = out_data;\n    assign m_axis_tkeep  = out_keep;\n    assign m_axis_tvalid = out_valid;\n    assign m_axis_tlast  = out_last;\n    assign m_axis_tid    = out_id;\n    assign m_axis_tdest  = out_dest;\n    assign m_axis_tuser  = modified_user;\n\n    // Status\n    assign status_depth = fifo_count;\n    assign status_depth_commit = fifo_count;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            status_overflow_reg   <= 1'b0;\n            status_bad_frame_reg  <= 1'b0;\n            status_good_frame_reg <= 1'b0;\n        end else begin\n            if (fifo_full && s_axis_tvalid) begin\n                status_overflow_reg <= 1'b1;\n            end\n            if (beat_accepted && s_axis_tlast) begin\n                if (frame_bad || frame_overflow) begin\n                    status_bad_frame_reg <= 1'b1;\n                end else begin\n                    status_good_frame_reg <= 1'b1;\n                end\n            end\n        end\n    end\n\n    assign status_overflow   = status_overflow_reg;\n    assign status_bad_frame  = status_bad_frame_reg;\n    assign status_good_frame = status_good_frame_reg;\n\nendmodule\n```<|im_end|>",
