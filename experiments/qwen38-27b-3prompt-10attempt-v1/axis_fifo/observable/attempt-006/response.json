  "text": "```verilog\nmodule axis_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   pause_req,\n    output wire                   pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] status_depth,\n    output wire [$clog2(DEPTH):0] status_depth_commit,\n    output wire                   status_overflow,\n    output wire                   status_bad_frame,\n    output wire                   status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    wire [DATA_WIDTH-1:0]  ram_data;\n    wire [KEEP_WIDTH-1:0]  ram_keep;\n    wire                    ram_last;\n    wire [ID_WIDTH-1:0]    ram_tid;\n    wire [DEST_WIDTH-1:0]  ram_tdest;\n    wire [USER_WIDTH-1:0]  ram_tuser;\n\n    // Write pointer and read pointer\n    reg [ADDR_WIDTH:0] wptr;\n    reg [ADDR_WIDTH:0] rptr;\n\n    // RAM storage\n    reg [DATA_WIDTH-1:0]  mem_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0]  mem_keep [0:DEPTH-1];\n    reg                    mem_last [0:DEPTH-1];\n    reg [ID_WIDTH-1:0]    mem_tid [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0]  mem_tdest [0:DEPTH-1];\n    reg [USER_WIDTH-1:0]  mem_tuser [0:DEPTH-1];\n\n    // Frame tracking\n    reg frame_active;\n    reg [ADDR_WIDTH:0] frame_start_ptr;\n    reg frame_oversize;\n    reg frame_bad;\n\n    // Status registers\n    reg status_overflow_reg;\n    reg status_bad_frame_reg;\n    reg status_good_frame_reg;\n\n    // Pause logic\n    reg pause_active;\n\n    // Write enable\n    wire write_en;\n    wire read_en;\n\n    // Depth calculation\n    wire [$clog2(DEPTH):0] depth;\n    wire [$clog2(DEPTH):0] depth_commit;\n\n    // Full and empty\n    wire full;\n    wire empty;\n\n    // Frame drop logic\n    wire drop_frame;\n    wire mark_frame;\n\n    // Output valid\n    wire out_valid;\n\n    // Calculate depth\n    assign depth = wptr - rptr;\n    assign depth_commit = wptr - rptr;\n\n    assign full = (depth == DEPTH);\n    assign empty = (depth == 0);\n\n    // Pause logic\n    assign pause_ack = pause_active;\n\n    // Determine if we should accept input\n    wire can_accept;\n    wire should_drop;\n    wire should_mark;\n\n    assign should_drop = (DROP_WHEN_FULL && full) || (DROP_OVERSIZE_FRAME && frame_oversize) || (DROP_BAD_FRAME && frame_bad);\n    assign should_mark = (MARK_WHEN_FULL && full);\n\n    // Frame oversize detection: if frame_active and we've written DEPTH beats without tlast\n    // Actually, oversize means the frame exceeds DEPTH. We track this by counting beats in current frame.\n    // Simpler: if frame is active and depth reaches DEPTH, the frame is oversize.\n    \n    // Let's use a frame beat counter\n    reg [ADDR_WIDTH:0] frame_beat_count;\n\n    // Write logic\n    assign write_en = s_axis_tvalid && s_axis_tready && !rst;\n\n    // Read logic\n    assign read_en = m_axis_tvalid && m_axis_tready && !rst;\n\n    // Output valid: we have data and not paused\n    assign out_valid = !empty && !pause_active;\n    assign m_axis_tvalid = out_valid;\n\n    // Read address\n    wire [ADDR_WIDTH-1:0] raddr;\n    assign raddr = rptr[ADDR_WIDTH-1:0];\n\n    // RAM read\n    assign ram_data  = mem_data[raddr];\n    assign ram_keep  = mem_keep[raddr];\n    assign ram_last  = mem_last[raddr];\n    assign ram_tid   = mem_tid[raddr];\n    assign ram_tdest = mem_tdest[raddr];\n    assign ram_tuser = mem_tuser[raddr];\n\n    // Output data\n    assign m_axis_tdata  = ram_data;\n    assign m_axis_tkeep  = ram_keep;\n    assign m_axis_tlast  = ram_last;\n    assign m_axis_tid    = ram_tid;\n    assign m_axis_tdest  = ram_tdest;\n    assign m_axis_tuser  = ram_tuser;\n\n    // Write address\n    wire [ADDR_WIDTH-1:0] waddr;\n    assign waddr = wptr[ADDR_WIDTH-1:0];\n\n    // Determine if this write completes a frame\n    wire write_is_last;\n    assign write_is_last = s_axis_tlast;\n\n    // Frame state machine\n    // When not in a frame, first beat starts a frame\n    // When in a frame, track beats until tlast\n\n    // Determine if we're starting a new frame\n    wire start_frame;\n    assign start_frame = !frame_active && write_en;\n\n    // Determine if we're ending a frame\n    wire end_frame;\n    assign end_frame = frame_active && write_en && write_is_last;\n\n    // Frame oversize: if frame is active and we're about to write beyond DEPTH\n    // Actually, if frame_active and depth == DEPTH, the next write would make it oversize\n    // But we can only hold DEPTH beats total. So if frame is active and depth reaches DEPTH, \n    // the frame is oversize (it needs more than DEPTH beats).\n    \n    // Let's track: if frame_active and depth == DEPTH, mark as oversize\n    wire frame_oversize_det;\n    assign frame_oversize_det = frame_active && (depth == DEPTH);\n\n    // Frame bad detection: based on user sideband\n    wire frame_bad_det;\n    assign frame_bad_det = (USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE);\n\n    // Determine if we should drop this frame\n    // Drop if: (DROP_OVERSIZE_FRAME && frame_oversize) || (DROP_BAD_FRAME && frame_bad)\n    // But we need to decide at the start of the frame or during?\n    // Typically, we decide when we see the frame is bad/oversize.\n    // For simplicity, we'll drop the entire frame if any beat in the frame triggers drop condition.\n    // Actually, let's drop the frame if the frame is marked as bad or oversize.\n    // We'll track frame_bad and frame_oversize as latched values.\n\n    // Latch frame_bad when frame starts or when we see a bad user signal\n    // Latch frame_oversize when depth reaches DEPTH while frame is active\n\n    // For drop/mark when full: this applies to the current beat, not the whole frame\n    // DROP_WHEN_FULL: if FIFO is full, drop the incoming beat\n    // MARK_WHEN_FULL: if FIFO is full, mark the incoming beat (set user bit)\n\n    // Let's simplify: \n    // - If DROP_WHEN_FULL and full, don't accept the beat (tready=0)\n    // - If MARK_WHEN_FULL and full, accept the beat but mark it\n    // - Frame drop: if DROP_OVERSIZE_FRAME and frame becomes oversize, drop all beats of this frame\n    // - Frame bad: if DROP_BAD_FRAME and frame is bad, drop all beats of this frame\n\n    // For frame drop, we need to know if the current frame should be dropped.\n    // We'll set a flag when the frame is determined to be bad/oversize, and then drop all subsequent beats of that frame.\n\n    // Let's use a \"drop_current_frame\" flag\n    reg drop_current_frame;\n\n    // Determine if we should accept the current beat\n    wire accept_beat;\n    \n    // If we're dropping the current frame, don't accept\n    // If DROP_WHEN_FULL and full, don't accept\n    // Otherwise, accept if not full (or if we're marking)\n\n    assign accept_beat = write_en && !drop_current_frame && !(DROP_WHEN_FULL && full);\n\n    // tready\n    assign s_axis_tready = !rst && !full && !pause_active && !drop_current_frame && !(DROP_WHEN_FULL && full);\n\n    // Actually, tready should be high when we can accept. Let's refine:\n    // tready = !rst && !pause_active && !drop_current_frame && !(DROP_WHEN_FULL && full)\n    // But if MARK_WHEN_FULL, we still accept even when full? No, if full, we can't write.\n    // MARK_WHEN_FULL probably means: if the FIFO is full, mark the beat as bad but still try to write? \n    // That doesn't make sense if FIFO is full. Let's assume MARK_WHEN_FULL means:\n    // if the FIFO is full, mark the incoming beat with a bad frame indicator, but still accept it\n    // (implying the FIFO has some backpressure handling). But if FIFO is full, we can't write.\n    // Let's assume MARK_WHEN_FULL is used in conjunction with not dropping, so we accept and mark.\n    // But if FIFO is full, we can't accept. So maybe MARK_WHEN_FULL means:\n    // when the FIFO is about to become full (depth == DEPTH-1), mark the next beat.\n    // Let's interpret: MARK_WHEN_FULL means if depth == DEPTH-1, mark the incoming beat.\n\n    // Let's redefine:\n    // DROP_WHEN_FULL: if depth == DEPTH, don't accept (tready=0)\n    // MARK_WHEN_FULL: if depth == DEPTH-1, accept but mark the beat as bad\n\n    wire mark_beat;\n    assign mark_beat = MARK_WHEN_FULL && (depth == DEPTH - 1) && write_en;\n\n    // Update tready\n    assign s_axis_tready = !rst && !pause_active && !drop_current_frame && !(DROP_WHEN_FULL && full);\n\n    // Write to RAM\n    always @(posedge clk) begin\n        if (rst) begin\n            wptr <= 0;\n            rptr <= 0;\n            frame_active <= 0;\n            frame_start_ptr <= 0;\n            frame_beat_count <= 0;\n            frame_oversize <= 0;\n            frame_bad <= 0;\n            drop_current_frame <= 0;\n            status_overflow_reg <= 0;\n            status_bad_frame_reg <= 0;\n            status_good_frame_reg <= 0;\n            pause_active <= 0;\n        end else begin\n            // Update pointers\n            if (write_en && accept_beat) begin\n                mem_data[waddr]  <= s_axis_tdata;\n                mem_keep[waddr]  <= s_axis_tkeep;\n                mem_last[waddr]  <= s_axis_tlast;\n                mem_tid[waddr]   <= s_axis_tid;\n                mem_tdest[waddr] <= s_axis_tdest;\n                \n                // Mark if needed\n                if (mark_beat) begin\n                    mem_tuser[waddr] <= (s_axis_tuser | USER_BAD_FRAME_MASK);\n                end else begin\n                    mem_tuser[waddr] <= s_axis_tuser;\n                end\n                \n                wptr <= wptr + 1;\n            end\n\n            if (read_en) begin\n                rptr <= rptr + 1;\n            end\n\n            // Frame tracking\n            if (write_en && accept_beat) begin\n                if (!frame_active) begin\n                    // Start new frame\n                    frame_active <= 1;\n                    frame_start_ptr <= wptr;\n                    frame_beat_count <= 1;\n                    frame_oversize <= 0;\n                    frame_bad <= frame_bad_det;\n                    drop_current_frame <= (DROP_BAD_FRAME && frame_bad_det);\n                end else begin\n                    // Continue frame\n                    frame_beat_count <= frame_beat_count + 1;\n                    \n                    // Check for oversize\n                    if (frame_beat_count == DEPTH - 1) begin\n                        frame_oversize <= 1;\n                        if (DROP_OVERSIZE_FRAME) begin\n                            drop_current_frame <= 1;\n                        end\n                    end\n                    \n                    // Check for bad\n                    if (frame_bad_det) begin\n                        frame_bad <= 1;\n                        if (DROP_BAD_FRAME) begin\n                            drop_current_frame <= 1;\n                        end\n                    end\n                end\n            end\n\n            if (end_frame) begin\n                // End of frame\n                frame_active <= 0;\n                frame_beat_count <= 0;\n                frame_oversize <= 0;\n                frame_bad <= 0;\n                drop_current_frame <= 0;\n                \n                // Update status\n                if (frame_bad || frame_oversize) begin\n                    status_bad_frame_reg <= 1;\n                end else begin\n                    status_good_frame_reg <= 1;\n                end\n            end\n\n            // Overflow status\n            if (s_axis_tvalid && !s_axis_tready) begin\n                status_overflow_reg <= 1;\n            end\n\n            // Pause\n            if (PAUSE_ENABLE) begin\n                if (pause_req) begin\n                    pause_active <= 1;\n                end else if (empty) begin\n                    pause_active <= 0;\n                end\n            end\n        end\n    end\n\n    // Status outputs\n    assign status_depth = depth;\n    assign status_depth_commit = depth_commit;\n    assign status_overflow = status_overflow_reg;\n    assign status_bad_frame = status_bad_frame_reg;\n    assign status_good_frame = status_good_frame_reg;\n\nendmodule\n```<|im_end|>",
