  "text": "```verilog\nmodule axis_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   pause_req,\n    output wire                   pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] status_depth,\n    output wire [$clog2(DEPTH):0] status_depth_commit,\n    output wire                   status_overflow,\n    output wire                   status_bad_frame,\n    output wire                   status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    reg [DATA_WIDTH-1:0] mem_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] mem_keep [0:DEPTH-1];\n    reg                  mem_last [0:DEPTH-1];\n    reg [ID_WIDTH-1:0]   mem_tid  [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0] mem_tdest[0:DEPTH-1];\n    reg [USER_WIDTH-1:0] mem_tuser[0:DEPTH-1];\n\n    reg [ADDR_WIDTH:0] wr_ptr;\n    reg [ADDR_WIDTH:0] rd_ptr;\n    reg [ADDR_WIDTH:0] rd_ptr_commit;\n\n    wire [ADDR_WIDTH:0] depth = wr_ptr - rd_ptr;\n    wire [ADDR_WIDTH:0] depth_commit = wr_ptr - rd_ptr_commit;\n\n    assign status_depth = depth;\n    assign status_depth_commit = depth_commit;\n\n    // Frame tracking\n    reg in_frame;\n    reg [ADDR_WIDTH:0] frame_count;\n    reg frame_overflow;\n\n    // Status flags\n    reg status_overflow_reg;\n    reg status_bad_frame_reg;\n    reg status_good_frame_reg;\n\n    assign status_overflow = status_overflow_reg;\n    assign status_bad_frame = status_bad_frame_reg;\n    assign status_good_frame = status_good_frame_reg;\n\n    // Pause logic\n    reg pause_active;\n    assign pause_ack = pause_active;\n\n    // Write enable\n    wire wr_en = s_axis_tvalid && s_axis_tready && !pause_active;\n\n    // Read enable\n    wire rd_en = m_axis_tvalid && m_axis_tready;\n\n    // FIFO full\n    wire fifo_full = (depth == DEPTH);\n\n    // Frame full (for FRAME_FIFO mode)\n    wire frame_full = (frame_count == DEPTH);\n\n    // Determine if we should accept a write\n    wire can_write;\n    wire drop_write;\n    wire mark_write;\n\n    generate\n        if (DROP_WHEN_FULL) begin\n            assign can_write = !fifo_full && !pause_active;\n            assign drop_write = fifo_full && s_axis_tvalid;\n            assign mark_write = 1'b0;\n        end\n        else if (MARK_WHEN_FULL) begin\n            assign can_write = !pause_active;\n            assign drop_write = 1'b0;\n            assign mark_write = fifo_full && s_axis_tvalid;\n        end\n        else begin\n            assign can_write = !fifo_full && !pause_active;\n            assign drop_write = 1'b0;\n            assign mark_write = 1'b0;\n        end\n    endgenerate\n\n    // Frame FIFO logic\n    generate\n        if (FRAME_FIFO) begin\n            // Frame overflow detection\n            wire frame_oversize = in_frame && (frame_count == DEPTH) && s_axis_tvalid && s_axis_tready;\n            \n            // Drop oversize frame\n            wire drop_oversize = DROP_OVERSIZE_FRAME && frame_oversize;\n            \n            // Bad frame detection based on user signal\n            wire bad_frame = (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE;\n            \n            // Drop bad frame\n            wire drop_bad = DROP_BAD_FRAME && bad_frame && s_axis_tlast;\n            \n            // Effective write enable considering frame drops\n            wire eff_wr_en = wr_en && !drop_oversize && !drop_bad;\n            \n            // Frame pause\n            wire frame_pause_active = FRAME_PAUSE && in_frame && frame_full;\n            \n            assign s_axis_tready = can_write && !frame_pause_active;\n            \n            // Update frame tracking\n            always @(posedge clk or posedge rst) begin\n                if (rst) begin\n                    in_frame <= 1'b0;\n                    frame_count <= {ADDR_WIDTH+1{1'b0}};\n                    frame_overflow <= 1'b0;\n                end else begin\n                    if (eff_wr_en) begin\n                        if (s_axis_tlast) begin\n                            in_frame <= 1'b0;\n                            frame_count <= {ADDR_WIDTH+1{1'b0}};\n                        end else begin\n                            in_frame <= 1'b1;\n                            frame_count <= frame_count + 1'b1;\n                        end\n                    end\n                    if (frame_oversize) begin\n                        frame_overflow <= 1'b1;\n                    end\n                end\n            end\n            \n            // Status updates for frame FIFO\n            always @(posedge clk or posedge rst) begin\n                if (rst) begin\n                    status_overflow_reg <= 1'b0;\n                    status_bad_frame_reg <= 1'b0;\n                    status_good_frame_reg <= 1'b0;\n                end else begin\n                    if (frame_oversize) begin\n                        status_overflow_reg <= 1'b1;\n                    end\n                    if (drop_bad) begin\n                        status_bad_frame_reg <= 1'b1;\n                    end\n                    if (eff_wr_en && s_axis_tlast && !drop_bad && !drop_oversize) begin\n                        status_good_frame_reg <= 1'b1;\n                    end\n                end\n            end\n            \n            // Memory write\n            always @(posedge clk) begin\n                if (eff_wr_en) begin\n                    mem_data[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdata;\n                    mem_keep[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tkeep;\n                    mem_last[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tlast;\n                    mem_tid[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tid;\n                    mem_tdest[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdest;\n                    mem_tuser[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tuser;\n                end\n            end\n            \n            // Write pointer\n            always @(posedge clk or posedge rst) begin\n                if (rst) begin\n                    wr_ptr <= {ADDR_WIDTH+1{1'b0}};\n                end else if (eff_wr_en) begin\n                    wr_ptr <= wr_ptr + 1'b1;\n                end\n            end\n            \n        end\n        else begin\n            // Non-frame FIFO mode\n            assign s_axis_tready = can_write;\n            \n            // Status updates\n            always @(posedge clk or posedge rst) begin\n                if (rst) begin\n                    status_overflow_reg <= 1'b0;\n                    status_bad_frame_reg <= 1'b0;\n                    status_good_frame_reg <= 1'b0;\n                end else begin\n                    if (drop_write) begin\n                        status_overflow_reg <= 1'b1;\n                    end\n                    if (mark_write) begin\n                        status_overflow_reg <= 1'b1;\n                    end\n                end\n            end\n            \n            // Memory write\n            always @(posedge clk) begin\n                if (wr_en) begin\n                    mem_data[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdata;\n                    mem_keep[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tkeep;\n                    mem_last[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tlast;\n                    mem_tid[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tid;\n                    mem_tdest[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tdest;\n                    mem_tuser[wr_ptr[ADDR_WIDTH-1:0]] <= s_axis_tuser;\n                end\n            end\n            \n            // Write pointer\n            always @(posedge clk or posedge rst) begin\n                if (rst) begin\n                    wr_ptr <= {ADDR_WIDTH+1{1'b0}};\n                end else if (wr_en) begin\n                    wr_ptr <= wr_ptr + 1'b1;\n                end\n            end\n        end\n    endgenerate\n\n    // Read logic\n    wire [ADDR_WIDTH-1:0] rd_addr = rd_ptr[ADDR_WIDTH-1:0];\n    wire [ADDR_WIDTH-1:0] rd_addr_commit = rd_ptr_commit[ADDR_WIDTH-1:0];\n\n    // Output data\n    wire [DATA_WIDTH-1:0] out_data;\n    wire [KEEP_WIDTH-1:0] out_keep;\n    wire                  out_last;\n    wire [ID_WIDTH-1:0]   out_tid;\n    wire [DEST_WIDTH-1:0] out_tdest;\n    wire [USER_WIDTH-1:0] out_tuser;\n\n    generate\n        if (RAM_PIPELINE) begin\n            // Pipelined read\n            reg [DATA_WIDTH-1:0] pipe_data;\n            reg [KEEP_WIDTH-1:0] pipe_keep;\n            reg                  pipe_last;\n            reg [ID_WIDTH-1:0]   pipe_tid;\n            reg [DEST_WIDTH-1:0] pipe_tdest;\n            reg [USER_WIDTH-1:0] pipe_tuser;\n            reg                  pipe_valid;\n\n            always @(posedge clk or posedge rst) begin\n                if (rst) begin\n                    pipe_valid <= 1'b0;\n                end else begin\n                    if (rd_en) begin\n                        pipe_valid <= 1'b0;\n                    end else if (!pipe_valid) begin\n                        pipe_valid <= (depth > 0);\n                        pipe_data <= mem_data[rd_addr];\n                        pipe_keep <= mem_keep[rd_addr];\n                        pipe_last <= mem_last[rd_addr];\n                        pipe_tid <= mem_tid[rd_addr];\n                        pipe_tdest <= mem_tdest[rd_addr];\n                        pipe_tuser <= mem_tuser[rd_addr];\n                    end\n                end\n            end\n\n            assign out_data = pipe_data;\n            assign out_keep = pipe_keep;\n            assign out_last = pipe_last;\n            assign out_tid = pipe_tid;\n            assign out_tdest = pipe_tdest;\n            assign out_tuser = pipe_tuser;\n            assign m_axis_tvalid = pipe_valid;\n            \n        end\n        else begin\n            // Non-pipelined read\n            assign out_data = mem_data[rd_addr];\n            assign out_keep = mem_keep[rd_addr];\n            assign out_last = mem_last[rd_addr];\n            assign out_tid = mem_tid[rd_addr];\n            assign out_tdest = mem_tdest[rd_addr];\n            assign out_tuser = mem_tuser[rd_addr];\n            assign m_axis_tvalid = (depth > 0);\n        end\n    endgenerate\n\n    // Output assignments\n    assign m_axis_tdata = out_data;\n    assign m_axis_tkeep = out_keep;\n    assign m_axis_tlast = out_last;\n    assign m_axis_tid = out_tid;\n    assign m_axis_tdest = out_tdest;\n    assign m_axis_tuser = out_tuser;\n\n    // Read pointer update\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            rd_ptr <= {ADDR_WIDTH+1{1'b0}};\n            rd_ptr_commit <= {ADDR_WIDTH+1{1'b0}};\n        end else begin\n            if (rd_en) begin\n                rd_ptr <= rd_ptr + 1'b1;\n                rd_ptr_commit <= rd_ptr_commit + 1'b1;\n            end\n        end\n    end\n\n    // Pause logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            pause_active <= 1'b0;\n        end else begin\n            if (PAUSE_ENABLE) begin\n                pause_active <= pause_req;\n            end else begin\n                pause_active <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
