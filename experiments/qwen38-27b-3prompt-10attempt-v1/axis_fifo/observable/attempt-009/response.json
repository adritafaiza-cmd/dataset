  "text": "```verilog\nmodule axis_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   pause_req,\n    output wire                   pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] status_depth,\n    output wire [$clog2(DEPTH):0] status_depth_commit,\n    output wire                   status_overflow,\n    output wire                   status_bad_frame,\n    output wire                   status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal signals\n    reg [DATA_WIDTH-1:0] mem_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] mem_keep [0:DEPTH-1];\n    reg                  mem_last [0:DEPTH-1];\n    reg [ID_WIDTH-1:0]   mem_tid  [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0] mem_tdest[0:DEPTH-1];\n    reg [USER_WIDTH-1:0] mem_tuser[0:DEPTH-1];\n\n    reg [ADDR_WIDTH:0] wr_ptr;\n    reg [ADDR_WIDTH:0] rd_ptr;\n    reg [ADDR_WIDTH:0] rd_ptr_commit;\n\n    wire [ADDR_WIDTH:0] depth = wr_ptr - rd_ptr;\n    wire [ADDR_WIDTH:0] depth_commit = wr_ptr - rd_ptr_commit;\n\n    wire full = (depth == DEPTH);\n    wire empty = (rd_ptr == rd_ptr_commit);\n\n    // Frame tracking\n    reg in_frame;\n    reg [ADDR_WIDTH:0] frame_len;\n    reg frame_overflow;\n    reg frame_bad;\n\n    // Status latches\n    reg status_overflow_reg;\n    reg status_bad_frame_reg;\n    reg status_good_frame_reg;\n\n    // Write enable\n    wire wr_en = s_axis_tvalid && s_axis_tready;\n\n    // Read enable\n    wire rd_en = m_axis_tvalid && m_axis_tready;\n\n    // Pause logic\n    reg pause_active;\n    wire pause_allowed = PAUSE_ENABLE;\n    wire pause_req_eff = pause_allowed ? pause_req : 1'b0;\n\n    // Frame pause logic\n    reg frame_pause_active;\n    wire frame_pause_allowed = FRAME_PAUSE;\n    wire frame_pause_req = frame_pause_allowed && in_frame;\n\n    // Combined pause\n    wire pause_eff = pause_req_eff || frame_pause_active;\n\n    // Input ready\n    wire input_blocked = full || pause_eff;\n    assign s_axis_tready = !input_blocked;\n\n    // Output valid\n    assign m_axis_tvalid = !empty;\n\n    // Read data\n    wire [ADDR_WIDTH-1:0] rd_addr = rd_ptr[ADDR_WIDTH-1:0];\n    wire [ADDR_WIDTH-1:0] rd_addr_commit = rd_ptr_commit[ADDR_WIDTH-1:0];\n\n    // Combinational read for output\n    wire [DATA_WIDTH-1:0] rd_data = mem_data[rd_addr];\n    wire [KEEP_WIDTH-1:0] rd_keep = mem_keep[rd_addr];\n    wire                  rd_last = mem_last[rd_addr];\n    wire [ID_WIDTH-1:0]   rd_tid  = mem_tid[rd_addr];\n    wire [DEST_WIDTH-1:0] rd_tdest= mem_tdest[rd_addr];\n    wire [USER_WIDTH-1:0] rd_tuser= mem_tuser[rd_addr];\n\n    // Output assignments\n    assign m_axis_tdata  = rd_data;\n    assign m_axis_tkeep  = rd_keep;\n    assign m_axis_tlast  = rd_last;\n    assign m_axis_tid    = rd_tid;\n    assign m_axis_tdest  = rd_tdest;\n    assign m_axis_tuser  = rd_tuser;\n\n    // Pause ack\n    assign pause_ack = pause_active;\n\n    // Status outputs\n    assign status_depth = depth;\n    assign status_depth_commit = depth_commit;\n    assign status_overflow = status_overflow_reg;\n    assign status_bad_frame = status_bad_frame_reg;\n    assign status_good_frame = status_good_frame_reg;\n\n    // Write address\n    wire [ADDR_WIDTH-1:0] wr_addr = wr_ptr[ADDR_WIDTH-1:0];\n\n    // Frame length tracking\n    wire frame_len_overflow = (frame_len == DEPTH) && wr_en && !s_axis_tlast;\n\n    // Determine if current beat is bad frame\n    wire beat_bad_frame = (USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE);\n\n    // Frame drop conditions\n    wire drop_frame = (DROP_OVERSIZE_FRAME && frame_overflow) || (DROP_BAD_FRAME && frame_bad);\n\n    // Write data to memory\n    always @(posedge clk) begin\n        if (rst) begin\n            wr_ptr <= 0;\n            rd_ptr <= 0;\n            rd_ptr_commit <= 0;\n            in_frame <= 0;\n            frame_len <= 0;\n            frame_overflow <= 0;\n            frame_bad <= 0;\n            status_overflow_reg <= 0;\n            status_bad_frame_reg <= 0;\n            status_good_frame_reg <= 0;\n            pause_active <= 0;\n            frame_pause_active <= 0;\n        end else begin\n            // Pause logic\n            if (pause_req_eff && !pause_active) begin\n                pause_active <= 1;\n            end else if (!pause_req_eff && pause_active) begin\n                pause_active <= 0;\n            end\n\n            if (frame_pause_req && !frame_pause_active) begin\n                frame_pause_active <= 1;\n            end else if (!frame_pause_req && frame_pause_active) begin\n                frame_pause_active <= 0;\n            end\n\n            // Write\n            if (wr_en) begin\n                mem_data[wr_addr]  <= s_axis_tdata;\n                mem_keep[wr_addr]  <= s_axis_tkeep;\n                mem_last[wr_addr]  <= s_axis_tlast;\n                mem_tid[wr_addr]   <= s_axis_tid;\n                mem_tdest[wr_addr] <= s_axis_tdest;\n                mem_tuser[wr_addr] <= s_axis_tuser;\n                wr_ptr <= wr_ptr + 1;\n\n                // Frame tracking\n                if (!in_frame) begin\n                    in_frame <= 1;\n                    frame_len <= 1;\n                    frame_overflow <= 0;\n                    frame_bad <= beat_bad_frame;\n                end else begin\n                    frame_len <= frame_len + 1;\n                    if (frame_len_overflow) begin\n                        frame_overflow <= 1;\n                    end\n                    if (beat_bad_frame) begin\n                        frame_bad <= 1;\n                    end\n                    if (s_axis_tlast) begin\n                        in_frame <= 0;\n                        frame_len <= 0;\n                        frame_overflow <= 0;\n                        frame_bad <= 0;\n                    end\n                end\n\n                // Overflow status\n                if (full) begin\n                    status_overflow_reg <= 1;\n                end\n            end\n\n            // Read\n            if (rd_en) begin\n                rd_ptr <= rd_ptr + 1;\n            end\n\n            // Commit read pointer\n            if (rd_en) begin\n                rd_ptr_commit <= rd_ptr_commit + 1;\n            end\n\n            // Frame completion status\n            if (rd_en && rd_last) begin\n                if (drop_frame) begin\n                    status_bad_frame_reg <= 1;\n                end else begin\n                    status_good_frame_reg <= 1;\n                end\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
