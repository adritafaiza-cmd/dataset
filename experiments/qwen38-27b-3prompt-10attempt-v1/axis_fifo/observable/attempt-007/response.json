  "text": "```verilog\nmodule axis_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   pause_req,\n    output wire                   pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] status_depth,\n    output wire [$clog2(DEPTH):0] status_depth_commit,\n    output wire                   status_overflow,\n    output wire                   status_bad_frame,\n    output wire                   status_good_frame\n);\n\n    localparam ADDR_WIDTH = $clog2(DEPTH);\n    localparam DEPTH_MASK = DEPTH - 1;\n\n    // Internal FIFO storage\n    reg [DATA_WIDTH-1:0] mem_data [0:DEPTH-1];\n    reg [KEEP_WIDTH-1:0] mem_keep [0:DEPTH-1];\n    reg                  mem_last [0:DEPTH-1];\n    reg [ID_WIDTH-1:0]   mem_id   [0:DEPTH-1];\n    reg [DEST_WIDTH-1:0] mem_dest [0:DEPTH-1];\n    reg [USER_WIDTH-1:0] mem_user [0:DEPTH-1];\n\n    // Write pointer and read pointer\n    reg [ADDR_WIDTH:0] wptr;\n    reg [ADDR_WIDTH:0] rptr;\n\n    // Frame tracking\n    reg frame_active;\n    reg [ADDR_WIDTH:0] frame_start_ptr;\n    reg frame_oversize;\n    reg frame_bad;\n\n    // Status registers\n    reg status_overflow_reg;\n    reg status_bad_frame_reg;\n    reg status_good_frame_reg;\n\n    // Pause logic\n    reg pause_active;\n\n    // Write enable\n    wire write_en;\n    wire read_en;\n\n    // Full and empty conditions\n    wire fifo_full;\n    wire fifo_empty;\n\n    // Frame full condition (for frame-based FIFO)\n    wire frame_full;\n\n    // Calculate depth\n    wire [$clog2(DEPTH):0] depth = wptr - rptr;\n\n    // Determine if FIFO is full\n    assign fifo_full = (wptr[ADDR_WIDTH] != rptr[ADDR_WIDTH]) && \n                       (wptr[ADDR_WIDTH-1:0] == rptr[ADDR_WIDTH-1:0]);\n\n    // Determine if FIFO is empty\n    assign fifo_empty = (wptr == rptr);\n\n    // Frame full: if frame is active and we've filled the frame\n    wire frame_at_capacity;\n    assign frame_at_capacity = frame_active && (depth >= DEPTH[ADDR_WIDTH-1:0]);\n\n    // Write enable logic\n    wire can_write;\n    assign can_write = s_axis_tvalid && !rst && \n                       (!fifo_full || DROP_WHEN_FULL || MARK_WHEN_FULL) &&\n                       (!pause_active || !PAUSE_ENABLE) &&\n                       (!frame_active || !frame_at_capacity || DROP_OVERSIZE_FRAME);\n\n    assign write_en = can_write;\n\n    // Read enable\n    assign read_en = m_axis_tready && !fifo_empty && !rst;\n\n    // Frame oversize detection\n    wire frame_oversize_det;\n    assign frame_oversize_det = frame_active && s_axis_tlast && \n                                (depth + 1 > DEPTH[ADDR_WIDTH-1:0]);\n\n    // Frame bad detection based on user signal\n    wire frame_bad_det;\n    assign frame_bad_det = frame_active && s_axis_tlast && \n                           (USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE);\n\n    // Determine if we should drop the frame\n    wire drop_frame;\n    assign drop_frame = (DROP_OVERSIZE_FRAME && frame_oversize_det) ||\n                        (DROP_BAD_FRAME && frame_bad_det);\n\n    // Determine if we should mark the frame as bad\n    wire mark_frame_bad;\n    assign mark_frame_bad = (MARK_WHEN_FULL && fifo_full && s_axis_tvalid) ||\n                            (DROP_BAD_FRAME == 0 && frame_bad_det);\n\n    // Write data to memory\n    always @(posedge clk) begin\n        if (rst) begin\n            wptr <= 0;\n            rptr <= 0;\n            frame_active <= 0;\n            frame_start_ptr <= 0;\n            frame_oversize <= 0;\n            frame_bad <= 0;\n            status_overflow_reg <= 0;\n            status_bad_frame_reg <= 0;\n            status_good_frame_reg <= 0;\n            pause_active <= 0;\n        end else begin\n            // Handle pause\n            if (PAUSE_ENABLE) begin\n                if (pause_req) begin\n                    pause_active <= 1;\n                end else if (m_axis_tready && !fifo_empty) begin\n                    pause_active <= 0;\n                end\n            end\n\n            // Write to FIFO\n            if (write_en) begin\n                mem_data[wptr[ADDR_WIDTH-1:0]] <= s_axis_tdata;\n                mem_keep[wptr[ADDR_WIDTH-1:0]] <= s_axis_tkeep;\n                mem_last[wptr[ADDR_WIDTH-1:0]] <= s_axis_tlast;\n                mem_id[wptr[ADDR_WIDTH-1:0]]   <= s_axis_tid;\n                mem_dest[wptr[ADDR_WIDTH-1:0]] <= s_axis_tdest;\n                mem_user[wptr[ADDR_WIDTH-1:0]] <= s_axis_tuser;\n\n                // Update frame tracking\n                if (!frame_active) begin\n                    frame_active <= 1;\n                    frame_start_ptr <= wptr;\n                    frame_oversize <= 0;\n                    frame_bad <= 0;\n                end else begin\n                    if (s_axis_tlast) begin\n                        frame_active <= 0;\n                    end\n                end\n\n                // Check for oversize\n                if (frame_active && !s_axis_tlast) begin\n                    if (depth + 1 >= DEPTH[ADDR_WIDTH-1:0]) begin\n                        frame_oversize <= 1;\n                    end\n                end\n\n                // Check for bad frame\n                if (frame_active && s_axis_tlast) begin\n                    if (USER_ENABLE && (s_axis_tuser & USER_BAD_FRAME_MASK) == USER_BAD_FRAME_VALUE) begin\n                        frame_bad <= 1;\n                    end\n                end\n\n                wptr <= wptr + 1;\n            end\n\n            // Read from FIFO\n            if (read_en) begin\n                rptr <= rptr + 1;\n            end\n\n            // Status updates\n            if (write_en && fifo_full && !DROP_WHEN_FULL && !MARK_WHEN_FULL) begin\n                status_overflow_reg <= 1;\n            end\n\n            if (frame_active && s_axis_tlast && write_en) begin\n                if (frame_bad || (DROP_BAD_FRAME && frame_bad_det)) begin\n                    status_bad_frame_reg <= 1;\n                end else begin\n                    status_good_frame_reg <= 1;\n                end\n            end\n        end\n    end\n\n    // Output data\n    assign m_axis_tdata = mem_data[rptr[ADDR_WIDTH-1:0]];\n    assign m_axis_tkeep = mem_keep[rptr[ADDR_WIDTH-1:0]];\n    assign m_axis_tlast = mem_last[rptr[ADDR_WIDTH-1:0]];\n    assign m_axis_tid   = mem_id[rptr[ADDR_WIDTH-1:0]];\n    assign m_axis_tdest = mem_dest[rptr[ADDR_WIDTH-1:0]];\n    assign m_axis_tuser = mem_user[rptr[ADDR_WIDTH-1:0]];\n\n    // Output valid\n    assign m_axis_tvalid = !fifo_empty && !rst;\n\n    // Input ready\n    assign s_axis_tready = !rst && \n                           (!fifo_full || DROP_WHEN_FULL || MARK_WHEN_FULL) &&\n                           (!pause_active || !PAUSE_ENABLE) &&\n                           (!frame_active || !frame_at_capacity || DROP_OVERSIZE_FRAME);\n\n    // Pause acknowledge\n    assign pause_ack = pause_active;\n\n    // Status outputs\n    assign status_depth = depth;\n    assign status_depth_commit = depth;\n    assign status_overflow = status_overflow_reg;\n    assign status_bad_frame = status_bad_frame_reg;\n    assign status_good_frame = status_good_frame_reg;\n\nendmodule\n```<|im_end|>",
