{
  "text": "```verilog\nmodule data_sync #(\n    parameter STAGES = 2,\n    parameter DWIDTH = 8\n)(\n    input                  clk,\n    input                  rstn,\n    input  [DWIDTH-1:0]    din,\n    input                  dready_i,\n    output reg [DWIDTH-1:0] dout,\n    output reg             dready_o\n);\n\n    // Synchronize din\n    reg [DWIDTH-1:0] din_sync [0:STAGES-1];\n\n    // Synchronize dready_i\n    reg dready_i_sync [0:STAGES-1];\n\n    // Track previous synchronized dready_i to detect rising edge\n    reg dready_i_prev;\n\n    // Internal ready flag\n    reg internal_ready;\n\n    // Synchronize din through STAGES flip-flops\n    integer i;\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            for (i = 0; i < STAGES; i = i + 1) begin\n                din_sync[i] <= {DWIDTH{1'b0}};\n            end\n        end else begin\n            din_sync[0] <= din;\n            for (i = 1; i < STAGES; i = i + 1) begin\n                din_sync[i] <= din_sync[i-1];\n            end\n        end\n    end\n\n    // Synchronize dready_i through STAGES flip-flops\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            for (i = 0; i < STAGES; i = i + 1) begin\n                dready_i_sync[i] <= 1'b0;\n            end\n        end else begin\n            dready_i_sync[0] <= dready_i;\n            for (i = 1; i < STAGES; i = i + 1) begin\n                dready_i_sync[i] <= dready_i_sync[i-1];\n            end\n        end\n    end\n\n    // Detect rising edge of synchronized dready_i\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            dready_i_prev <= 1'b0;\n        end else begin\n            dready_i_prev <= dready_i_sync[STAGES-1];\n        end\n    end\n\n    wire dready_i_rise = dready_i_sync[STAGES-1] & ~dready_i_prev;\n\n    // Internal ready: set when dready_i rises, cleared when we output\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            internal_ready <= 1'b0;\n        end else begin\n            if (dready_i_rise) begin\n                internal_ready <= 1'b1;\n            end else if (internal_ready) begin\n                internal_ready <= 1'b0;\n            end\n        end\n    end\n\n    // Output logic\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            dout     <= {DWIDTH{1'b0}};\n            dready_o <= 1'b0;\n        end else begin\n            if (internal_ready) begin\n                dout     <= din_sync[STAGES-1];\n                dready_o <= 1'b1;\n            end else begin\n                dready_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
