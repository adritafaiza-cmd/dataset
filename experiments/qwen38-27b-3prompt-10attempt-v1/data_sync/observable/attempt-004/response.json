{
  "text": "```verilog\nmodule data_sync #(\n    parameter STAGES = 2,\n    parameter DWIDTH = 8\n)(\n    input                  clk,\n    input                  rstn,\n    input  [DWIDTH-1:0]    din,\n    input                  dready_i,\n    output reg [DWIDTH-1:0] dout,\n    output reg             dready_o\n);\n\n    // Synchronize din\n    reg [DWIDTH-1:0] din_sync [0:STAGES];\n    // Synchronize dready_i\n    reg dready_i_sync [0:STAGES];\n\n    // Pipeline registers for data\n    reg [DWIDTH-1:0] data_pipe [0:STAGES];\n    // Pipeline registers for ready flag\n    reg ready_pipe [0:STAGES];\n\n    // Synchronization of din\n    integer i;\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            for (i = 0; i < STAGES; i = i + 1) begin\n                din_sync[i] <= {DWIDTH{1'b0}};\n            end\n        end else begin\n            din_sync[0] <= din;\n            for (i = 1; i < STAGES; i = i + 1) begin\n                din_sync[i] <= din_sync[i-1];\n            end\n        end\n    end\n\n    // Synchronization of dready_i\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            for (i = 0; i < STAGES; i = i + 1) begin\n                dready_i_sync[i] <= 1'b0;\n            end\n        end else begin\n            dready_i_sync[0] <= dready_i;\n            for (i = 1; i < STAGES; i = i + 1) begin\n                dready_i_sync[i] <= dready_i_sync[i-1];\n            end\n        end\n    end\n\n    // Pipeline data and ready through STAGES stages\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            for (i = 0; i < STAGES; i = i + 1) begin\n                data_pipe[i] <= {DWIDTH{1'b0}};\n                ready_pipe[i] <= 1'b0;\n            end\n            dout <= {DWIDTH{1'b0}};\n            dready_o <= 1'b0;\n        end else begin\n            // Stage 0: capture synchronized values\n            data_pipe[0] <= din_sync[STAGES-1];\n            ready_pipe[0] <= dready_i_sync[STAGES-1];\n\n            // Propagate through pipeline\n            for (i = 1; i < STAGES; i = i + 1) begin\n                data_pipe[i] <= data_pipe[i-1];\n                ready_pipe[i] <= ready_pipe[i-1];\n            end\n\n            // Output from last stage\n            dout <= data_pipe[STAGES-1];\n            dready_o <= ready_pipe[STAGES-1];\n        end\n    end\n\nendmodule\n```<|im_end|>",
