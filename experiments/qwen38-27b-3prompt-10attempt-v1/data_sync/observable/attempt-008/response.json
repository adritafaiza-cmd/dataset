{
  "text": "```verilog\nmodule data_sync #(\n    parameter STAGES = 2,\n    parameter DWIDTH = 8\n)(\n    input                  clk,\n    input                  rstn,\n    input  [DWIDTH-1:0]    din,\n    input                  dready_i,\n    output reg [DWIDTH-1:0] dout,\n    output reg             dready_o\n);\n\n    localparam SYNC_BITS = (STAGES > 0) ? STAGES : 1;\n\n    reg [SYNC_BITS-1:0] din_sync;\n    reg [SYNC_BITS-1:0] dready_sync;\n\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            din_sync    <= {SYNC_BITS{1'b0}};\n            dready_sync <= {SYNC_BITS{1'b0}};\n        end else begin\n            din_sync    <= {din_sync[SYNC_BITS-2:0], din};\n            dready_sync <= {dready_sync[SYNC_BITS-2:0], dready_i};\n        end\n    end\n\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            dout     <= {DWIDTH{1'b0}};\n            dready_o <= 1'b0;\n        end else begin\n            dout     <= din_sync[SYNC_BITS-1];\n            dready_o <= dready_sync[SYNC_BITS-1];\n        end\n    end\n\nendmodule\n```<|im_end|>",
