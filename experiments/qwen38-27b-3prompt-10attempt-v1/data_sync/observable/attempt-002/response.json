{
  "text": "```verilog\nmodule data_sync #(\n    parameter STAGES = 2,\n    parameter DWIDTH = 8\n)(\n    input                  clk,\n    input                  rstn,\n    input  [DWIDTH-1:0]    din,\n    input                  dready_i,\n    output reg [DWIDTH-1:0] dout,\n    output reg             dready_o\n);\n\n    localparam SYNC_STAGES = (STAGES > 1) ? STAGES : 2;\n\n    reg [SYNC_STAGES-1:0] dready_sync;\n    reg [SYNC_STAGES-1:0] dready_sync_next;\n    reg [DWIDTH-1:0]      din_sync;\n    reg [DWIDTH-1:0]      din_sync_next;\n\n    // Synchronize dready_i through STAGES flip-flops\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            dready_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            dready_sync <= dready_sync_next;\n        end\n    end\n\n    always @* begin\n        dready_sync_next[0] = dready_i;\n        for (integer i = 1; i < SYNC_STAGES; i = i + 1) begin\n            dready_sync_next[i] = dready_sync[i-1];\n        end\n    end\n\n    // Synchronize din through STAGES flip-flops\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            din_sync <= {DWIDTH{1'b0}};\n        end else begin\n            din_sync <= din_sync_next;\n        end\n    end\n\n    always @* begin\n        din_sync_next = din;\n    end\n\n    // Output: use the last stage of synchronization\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            dout     <= {DWIDTH{1'b0}};\n            dready_o <= 1'b0;\n        end else begin\n            dout     <= din_sync[SYNC_STAGES-1];\n            dready_o <= dready_sync[SYNC_STAGES-1];\n        end\n    end\n\nendmodule\n```<|im_end|>",
