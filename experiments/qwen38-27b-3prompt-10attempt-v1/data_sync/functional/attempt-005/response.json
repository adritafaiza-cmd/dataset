{
  "text": "```verilog\nmodule data_sync #(\n    parameter STAGES = 2,\n    parameter DWIDTH = 8\n)(\n    input                  clk,\n    input                  rstn,\n    input  [DWIDTH-1:0]    din,\n    input                  dready_i,\n    output reg [DWIDTH-1:0] dout,\n    output reg             dready_o\n);\n\n    // Choose a safe crossing depth: at least 2 stages for metastability\n    localparam SYNC_STAGES = (STAGES < 2) ? 2 : STAGES;\n\n    // Synchronizer flip-flops\n    reg [SYNC_STAGES-1:0] sync_ff;\n    reg [DWIDTH-1:0]      data_ff;\n\n    // Pipeline registers for data and ready\n    reg [DWIDTH-1:0]      data_pipe [0:SYNC_STAGES-1];\n    reg                   ready_pipe [0:SYNC_STAGES-1];\n\n    integer i;\n\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            sync_ff    <= {SYNC_STAGES{1'b0}};\n            data_ff    <= {DWIDTH{1'b0}};\n            dout       <= {DWIDTH{1'b0}};\n            dready_o   <= 1'b0;\n            for (i = 0; i < SYNC_STAGES; i = i + 1) begin\n                data_pipe[i]  <= {DWIDTH{1'b0}};\n                ready_pipe[i] <= 1'b0;\n            end\n        end else begin\n            // Synchronize the ready signal\n            sync_ff[0] <= dready_i;\n            for (i = 1; i < SYNC_STAGES; i = i + 1) begin\n                sync_ff[i] <= sync_ff[i-1];\n            end\n\n            // Pipeline data and ready through the stages\n            // Stage 0: capture data when dready_i is high\n            if (dready_i) begin\n                data_pipe[0]  <= din;\n                ready_pipe[0] <= 1'b1;\n            end else begin\n                data_pipe[0]  <= data_pipe[0];\n                ready_pipe[0] <= 1'b0;\n            end\n\n            // Subsequent stages\n            for (i = 1; i < SYNC_STAGES; i = i + 1) begin\n                data_pipe[i]  <= data_pipe[i-1];\n                ready_pipe[i] <= ready_pipe[i-1];\n            end\n\n            // Output from the last stage\n            dout     <= data_pipe[SYNC_STAGES-1];\n            dready_o <= ready_pipe[SYNC_STAGES-1];\n        end\n    end\n\nendmodule\n```<|im_end|>",
