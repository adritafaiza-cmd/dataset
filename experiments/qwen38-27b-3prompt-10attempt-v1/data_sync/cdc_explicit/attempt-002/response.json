{
  "text": "```verilog\nmodule data_sync #(\n    parameter STAGES = 2,\n    parameter DWIDTH = 8\n)(\n    input                  clk,\n    input                  rstn,\n    input  [DWIDTH-1:0]    din,\n    input                  dready_i,\n    output reg [DWIDTH-1:0] dout,\n    output reg             dready_o\n);\n\n    // Use a safe minimum of 2 stages for synchronization\n    localparam SYNC_STAGES = (STAGES < 2) ? 2 : STAGES;\n\n    // Synchronization registers for the ready signal\n    reg [SYNC_STAGES-1:0] dready_sync;\n\n    // Synchronize dready_i into the local clock domain\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            dready_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            dready_sync[0] <= dready_i;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1) begin\n                dready_sync[i] <= dready_sync[i-1];\n            end\n        end\n    end\n\n    // The synchronized ready signal\n    wire dready_synced = dready_sync[SYNC_STAGES-1];\n\n    // Data register to hold the coherent multi-bit data\n    reg [DWIDTH-1:0] data_reg;\n\n    // Capture data when synchronized ready is high\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            data_reg <= {DWIDTH{1'b0}};\n        end else if (dready_synced) begin\n            data_reg <= din;\n        end\n    end\n\n    // Output assignments\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            dout <= {DWIDTH{1'b0}};\n            dready_o <= 1'b0;\n        end else begin\n            dout <= data_reg;\n            dready_o <= dready_synced;\n        end\n    end\n\nendmodule\n```<|im_end|>",
