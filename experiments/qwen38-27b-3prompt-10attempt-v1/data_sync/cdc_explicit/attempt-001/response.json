{
  "text": "```verilog\nmodule data_sync #(\n    parameter STAGES = 2,\n    parameter DWIDTH = 8\n)(\n    input                  clk,\n    input                  rstn,\n    input  [DWIDTH-1:0]    din,\n    input                  dready_i,\n    output reg [DWIDTH-1:0] dout,\n    output reg             dready_o\n);\n\n    // Use a minimum of 2 stages for safe CDC\n    localparam SYNC_STAGES = (STAGES < 2) ? 2 : STAGES;\n\n    // Synchronizer chain for the handshake signal\n    reg [SYNC_STAGES-1:0] sync_chain;\n\n    // Latch the data when the handshake is detected\n    reg [DWIDTH-1:0] data_latch;\n    reg              data_valid;\n\n    // Synchronize the handshake signal\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            sync_chain <= {SYNC_STAGES{1'b0}};\n        end else begin\n            sync_chain[0] <= dready_i;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1) begin\n                sync_chain[i] <= sync_chain[i-1];\n            end\n        end\n    end\n\n    // Detect rising edge of the synchronized handshake\n    wire sync_rise = sync_chain[SYNC_STAGES-1] & ~sync_chain[SYNC_STAGES-2];\n\n    // Latch data and generate output pulse\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            data_latch <= {DWIDTH{1'b0}};\n            data_valid <= 1'b0;\n            dout       <= {DWIDTH{1'b0}};\n            dready_o   <= 1'b0;\n        end else begin\n            if (sync_rise) begin\n                data_latch <= din;\n                data_valid <= 1'b1;\n            end else begin\n                data_valid <= 1'b0;\n            end\n\n            if (data_valid) begin\n                dout     <= data_latch;\n                dready_o <= 1'b1;\n            end else begin\n                dready_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
