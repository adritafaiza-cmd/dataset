{
  "text": "```verilog\nmodule data_sync #(\n    parameter STAGES = 2,\n    parameter DWIDTH = 8\n)(\n    input                  clk,\n    input                  rstn,\n    input  [DWIDTH-1:0]    din,\n    input                  dready_i,\n    output reg [DWIDTH-1:0] dout,\n    output reg             dready_o\n);\n\n    // Ensure minimum 2 stages for safe multi-bit synchronization\n    localparam SYNC_STAGES = (STAGES < 2) ? 2 : STAGES;\n\n    // Synchronizer chain for the handshake signal\n    reg [SYNC_STAGES-1:0] sync_chain;\n\n    // Latched data and valid flag\n    reg [DWIDTH-1:0] data_latch;\n    reg              valid_latch;\n\n    // Internal ready signal (synchronized version of dready_i)\n    wire sync_ready = sync_chain[SYNC_STAGES-1];\n\n    // Detect rising edge of synchronized ready\n    reg sync_ready_d;\n    wire sync_ready_rise = sync_ready & ~sync_ready_d;\n\n    // Synchronize the valid flag and data using a handshake approach\n    // Since we have a single clock, we can use a simple synchronizer for the control signal\n    // and latch the data when the control signal transitions.\n\n    // Synchronize dready_i\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            sync_chain <= {SYNC_STAGES{1'b0}};\n        end else begin\n            sync_chain[0] <= dready_i;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1) begin\n                sync_chain[i] <= sync_chain[i-1];\n            end\n        end\n    end\n\n    // Track previous synchronized ready\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            sync_ready_d <= 1'b0;\n        end else begin\n            sync_ready_d <= sync_ready;\n        end\n    end\n\n    // Latch data and set valid when synchronized ready rises\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            data_latch  <= {DWIDTH{1'b0}};\n            valid_latch <= 1'b0;\n            dout        <= {DWIDTH{1'b0}};\n            dready_o    <= 1'b0;\n        end else begin\n            if (sync_ready_rise) begin\n                data_latch  <= din;\n                valid_latch <= 1'b1;\n            end\n            if (valid_latch) begin\n                dout     <= data_latch;\n                dready_o <= 1'b1;\n                valid_latch <= 1'b0;\n            end else begin\n                dready_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
