  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 2'd0;\n    localparam S_WAIT_WR = 2'd1;\n    localparam S_SHIFT   = 2'd2;\n    localparam S_DONE    = 2'd3;\n\n    reg [1:0] state;\n    reg [1:0] state_next;\n\n    // Data registers\n    reg [N-1:0] tx_data;\n    reg [N-1:0] rx_data;\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n\n    // Bit counter\n    reg [$clog2(N)-1:0] bit_cnt;\n\n    // SCLK divider counter\n    reg [$clog2(SPI_2X_CLK_DIV)-1:0] clk_div_cnt;\n    reg sclk_phase;\n\n    // Handshake signals\n    reg wr_ack_int;\n    reg do_valid_int;\n\n    // Synchronous reset for pclk domain\n    reg [1:0] rst_sync_p;\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            rst_sync_p <= 2'b11;\n        else\n            rst_sync_p <= {rst_sync_p[0], 1'b0};\n    end\n    wire rst_p = rst_sync_p[1];\n\n    // Synchronous reset for sclk domain\n    reg [1:0] rst_sync_s;\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            rst_sync_s <= 2'b11;\n        else\n            rst_sync_s <= {rst_sync_s[0], 1'b0};\n    end\n    wire rst_s = rst_sync_s[1];\n\n    // PCLK domain: handle write handshake and data loading\n    always @(posedge pclk_i or posedge rst_p) begin\n        if (rst_p) begin\n            wr_ack_o   <= 1'b0;\n            di_req_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o       <= {N{1'b0}};\n            tx_data    <= {N{1'b0}};\n            state      <= S_IDLE;\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                    if (wren_i) begin\n                        tx_data <= di_i;\n                        state   <= S_WAIT_WR;\n                    end\n                end\n                S_WAIT_WR: begin\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b1;\n                    do_valid_o <= 1'b0;\n                    state <= S_SHIFT;\n                end\n                S_SHIFT: begin\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                    // Wait for shift to complete (signaled from sclk domain)\n                    if (do_valid_int) begin\n                        do_o       <= rx_data;\n                        do_valid_o <= 1'b1;\n                        state      <= S_DONE;\n                    end\n                end\n                S_DONE: begin\n                    di_req_o <= 1'b1;\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                    if (wren_i) begin\n                        tx_data <= di_i;\n                        state   <= S_WAIT_WR;\n                    end else begin\n                        state <= S_IDLE;\n                    end\n                end\n                default: state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // SCLK domain: SPI shifting logic\n    always @(posedge sclk_i or posedge rst_s) begin\n        if (rst_s) begin\n            spi_ssel_o  <= 1'b0;\n            spi_sck_o   <= 1'b0;\n            spi_mosi_o  <= 1'b0;\n            bit_cnt     <= {($clog2(N)){1'b0}};\n            clk_div_cnt <= {($clog2(SPI_2X_CLK_DIV)){1'b0}};\n            sclk_phase  <= 1'b0;\n            tx_shift    <= {N{1'b0}};\n            rx_shift    <= {N{1'b0}};\n            rx_data     <= {N{1'b0}};\n            do_valid_int <= 1'b0;\n        end else begin\n            // Default: clear handshake\n            do_valid_int <= 1'b0;\n\n            case (state)\n                S_IDLE, S_WAIT_WR: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o  <= 1'b0;\n                    spi_mosi_o <= 1'b0;\n                    clk_div_cnt <= {($clog2(SPI_2X_CLK_DIV)){1'b0}};\n                    sclk_phase  <= 1'b0;\n                    bit_cnt     <= {($clog2(N)){1'b0}};\n                end\n                S_SHIFT: begin\n                    // Load data at start of shift\n                    if (bit_cnt == {($clog2(N)){1'b0}} && clk_div_cnt == {($clog2(SPI_2X_CLK_DIV)){1'b0}} && sclk_phase == 1'b0) begin\n                        tx_shift <= tx_data;\n                        rx_shift <= {N{1'b0}};\n                        spi_ssel_o <= 1'b1;\n                    end\n\n                    // Clock divider\n                    if (clk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                        clk_div_cnt <= {($clog2(SPI_2X_CLK_DIV)){1'b0}};\n                        sclk_phase  <= ~sclk_phase;\n\n                        if (sclk_phase == 1'b0) begin\n                            // Rising edge of SCK: shift out MSB, capture MISO\n                            spi_sck_o <= 1'b1;\n                            spi_mosi_o <= tx_shift[N-1];\n                            rx_shift <= {spi_miso_i, rx_shift[N-1:1]};\n                            tx_shift <= {tx_shift[N-2:0], 1'b0};\n\n                            if (bit_cnt == N - 1) begin\n                                // Last bit\n                                rx_data <= {spi_miso_i, rx_shift[N-1:1]};\n                                do_valid_int <= 1'b1;\n                                spi_ssel_o <= 1'b0;\n                                spi_sck_o  <= 1'b0;\n                                bit_cnt    <= {($clog2(N)){1'b0}};\n                            end else begin\n                                bit_cnt <= bit_cnt + 1'b1;\n                            end\n                        end else begin\n                            // Falling edge of SCK\n                            spi_sck_o <= 1'b0;\n                        end\n                    end else begin\n                        clk_div_cnt <= clk_div_cnt + 1'b1;\n                    end\n                end\n                S_DONE: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o  <= 1'b0;\n                    spi_mosi_o <= 1'b0;\n                end\n                default: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o  <= 1'b0;\n                    spi_mosi_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
