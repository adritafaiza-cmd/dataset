{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 2'd0;\n    localparam S_WAIT_WR = 2'd1;\n    localparam S_SHIFT   = 2'd2;\n    localparam S_DONE    = 2'd3;\n\n    reg [1:0] state;\n    reg [N-1:0] tx_shift_reg;\n    reg [N-1:0] rx_shift_reg;\n    reg [N-1:0] bit_count;\n    reg [N-1:0] tx_data;\n    reg         tx_valid;\n\n    // SCLK divider counter\n    reg [31:0] sclk_div_cnt;\n    reg        sclk_phase;\n\n    // Synchronizers for pclk domain signals\n    reg [1:0] wren_sync;\n    reg [N-1:0] di_sync;\n    reg [1:0] di_req_sync;\n\n    // Synchronizers for sclk domain signals\n    reg [1:0] do_valid_sync;\n    reg [N-1:0] do_sync;\n\n    // PCLK domain logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_sync <= 2'b00;\n            di_sync <= {N{1'b0}};\n            di_req_sync <= 2'b00;\n        end else begin\n            wren_sync <= {wren_sync[0], wren_i};\n            di_sync <= {di_sync[N-2:0], di_i[0]};\n            di_req_sync <= {di_req_sync[0], di_req_o};\n        end\n    end\n\n    // SCLK domain logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= S_IDLE;\n            spi_ssel_o <= 1'b0;\n            spi_sck_o <= 1'b0;\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n            tx_shift_reg <= {N{1'b0}};\n            rx_shift_reg <= {N{1'b0}};\n            bit_count <= {N{1'b0}};\n            tx_data <= {N{1'b0}};\n            tx_valid <= 1'b0;\n            sclk_div_cnt <= 32'd0;\n            sclk_phase <= 1'b0;\n        end else begin\n            // Default: clear one-shot signals\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                    di_req_o <= 1'b0;\n                    // Check if write is available\n                    if (wren_sync[1]) begin\n                        tx_data <= di_sync;\n                        tx_valid <= 1'b1;\n                        state <= S_WAIT_WR;\n                    end\n                end\n\n                S_WAIT_WR: begin\n                    // Wait for write to be stable, then start transfer\n                    if (wren_sync[1]) begin\n                        tx_data <= di_sync;\n                        tx_valid <= 1'b1;\n                        spi_ssel_o <= 1'b1;\n                        tx_shift_reg <= tx_data;\n                        rx_shift_reg <= {N{1'b0}};\n                        bit_count <= {N{1'b0}};\n                        sclk_div_cnt <= 32'd0;\n                        sclk_phase <= 1'b0;\n                        state <= S_SHIFT;\n                    end\n                end\n\n                S_SHIFT: begin\n                    spi_ssel_o <= 1'b1;\n                    // Generate SCLK\n                    if (sclk_div_cnt >= SPI_2X_CLK_DIV - 1) begin\n                        sclk_div_cnt <= 32'd0;\n                        sclk_phase <= ~sclk_phase;\n                        if (sclk_phase) begin\n                            // Rising edge of SCLK: shift out MSB, capture MISO\n                            spi_sck_o <= 1'b1;\n                            spi_mosi_o <= tx_shift_reg[N-1];\n                            rx_shift_reg <= {spi_miso_i, rx_shift_reg[N-1:1]};\n                            tx_shift_reg <= {tx_shift_reg[N-2:0], 1'b0};\n                            bit_count <= bit_count + 1'b1;\n                            if (bit_count == N - 1) begin\n                                state <= S_DONE;\n                            end\n                        end else begin\n                            // Falling edge of SCLK\n                            spi_sck_o <= 1'b0;\n                        end\n                    end else begin\n                        sclk_div_cnt <= sclk_div_cnt + 1'b1;\n                    end\n                end\n\n                S_DONE: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                    do_o <= rx_shift_reg;\n                    do_valid_o <= 1'b1;\n                    di_req_o <= 1'b1;\n                    state <= S_IDLE;\n                end\n\n                default: begin\n                    state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // MOSI output\n    assign spi_mosi_o = tx_shift_reg[N-1];\n\nendmodule\n```<|im_end|>",
