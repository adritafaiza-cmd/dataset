  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 2'd0;\n    localparam S_WAIT_WR = 2'd1;\n    localparam S_SHIFT   = 2'd2;\n    localparam S_DONE    = 2'd3;\n\n    reg [1:0] state;\n    reg [N-1:0] tx_shift_reg;\n    reg [N-1:0] rx_shift_reg;\n    reg [N-1:0] bit_count;\n    reg [N-1:0] tx_word;\n    reg         tx_valid;\n\n    // SCLK divider counter\n    reg [3:0] clk_div_cnt;\n    reg       clk_div_tick;\n\n    // SCK phase control\n    reg       sck_phase;\n\n    // Asynchronous reset for sclk domain\n    reg       rst_sclk;\n    reg       rst_sclk_d;\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rst_sclk <= 1'b1;\n            rst_sclk_d <= 1'b1;\n        end else begin\n            rst_sclk <= 1'b0;\n            rst_sclk_d <= 1'b0;\n        end\n    end\n\n    // Generate tick for SCK generation\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            clk_div_cnt <= 4'd0;\n            clk_div_tick <= 1'b0;\n        end else begin\n            if (clk_div_cnt >= SPI_2X_CLK_DIV - 1) begin\n                clk_div_cnt <= 4'd0;\n                clk_div_tick <= 1'b1;\n            end else begin\n                clk_div_cnt <= clk_div_cnt + 4'd1;\n                clk_div_tick <= 1'b0;\n            end\n        end\n    end\n\n    // SPI state machine in sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= S_IDLE;\n            spi_ssel_o <= 1'b0;\n            spi_sck_o <= 1'b0;\n            tx_shift_reg <= {N{1'b0}};\n            rx_shift_reg <= {N{1'b0}};\n            bit_count <= {N{1'b0}};\n            sck_phase <= 1'b0;\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                    if (tx_valid) begin\n                        state <= S_SHIFT;\n                        spi_ssel_o <= 1'b1;\n                        tx_shift_reg <= tx_word;\n                        rx_shift_reg <= {N{1'b0}};\n                        bit_count <= {N{1'b0}};\n                        sck_phase <= 1'b0;\n                    end\n                end\n\n                S_SHIFT: begin\n                    if (clk_div_tick) begin\n                        if (sck_phase == 1'b0) begin\n                            // Rising edge of SCK\n                            spi_sck_o <= 1'b1;\n                            sck_phase <= 1'b1;\n                            // Capture MISO on rising edge (SPI mode 0)\n                            rx_shift_reg <= {spi_miso_i, rx_shift_reg[N-1:1]};\n                        end else begin\n                            // Falling edge of SCK\n                            spi_sck_o <= 1'b0;\n                            sck_phase <= 1'b0;\n                            // Shift out next bit on falling edge\n                            if (bit_count == N - 1) begin\n                                state <= S_DONE;\n                                spi_ssel_o <= 1'b0;\n                            end else begin\n                                bit_count <= bit_count + 1'b1;\n                                tx_shift_reg <= {1'b0, tx_shift_reg[N-1:1]};\n                            end\n                        end\n                    end\n                end\n\n                S_DONE: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                    state <= S_IDLE;\n                end\n\n                default: begin\n                    state <= S_IDLE;\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // MOSI output\n    assign spi_mosi_o = tx_shift_reg[N-1];\n\n    // PCLK domain: handshake and data transfer\n    reg [N-1:0] rx_word_pclk;\n    reg         rx_valid_pclk;\n    reg         rx_valid_pclk_d;\n\n    // Synchronize rx_valid from sclk domain to pclk domain\n    reg         rx_valid_sync1;\n    reg         rx_valid_sync2;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rx_valid_sync1 <= 1'b0;\n            rx_valid_sync2 <= 1'b0;\n        end else begin\n            rx_valid_sync1 <= rx_valid;\n            rx_valid_sync2 <= rx_valid_sync1;\n        end\n    end\n\n    // Synchronize rx_shift_reg from sclk domain to pclk domain\n    reg [N-1:0] rx_shift_reg_sync1;\n    reg [N-1:0] rx_shift_reg_sync2;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rx_shift_reg_sync1 <= {N{1'b0}};\n            rx_shift_reg_sync2 <= {N{1'b0}};\n        end else begin\n            rx_shift_reg_sync1 <= rx_shift_reg;\n            rx_shift_reg_sync2 <= rx_shift_reg_sync1;\n        end\n    end\n\n    // Generate rx_valid in sclk domain when shift is complete\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rx_valid <= 1'b0;\n        end else begin\n            if (state == S_DONE) begin\n                rx_valid <= 1'b1;\n            end else begin\n                rx_valid <= 1'b0;\n            end\n        end\n    end\n\n    // PCLK domain state machine for parallel interface\n    reg [1:0] p_state;\n    localparam P_IDLE    = 2'd0;\n    localparam P_WAIT_WR = 2'd1;\n    localparam P_WAIT_RX = 2'd2;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            p_state <= P_IDLE;\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n            tx_word <= {N{1'b0}};\n            tx_valid <= 1'b0;\n        end else begin\n            case (p_state)\n                P_IDLE: begin\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                    if (wren_i) begin\n                        p_state <= P_WAIT_WR;\n                    end\n                end\n\n                P_WAIT_WR: begin\n                    if (wren_i) begin\n                        tx_word <= di_i;\n                        tx_valid <= 1'b1;\n                        wr_ack_o <= 1'b1;\n                        p_state <= P_WAIT_RX;\n                    end else begin\n                        p_state <= P_IDLE;\n                    end\n                end\n\n                P_WAIT_RX: begin\n                    wr_ack_o <= 1'b0;\n                    if (rx_valid_sync2) begin\n                        do_o <= rx_shift_reg_sync2;\n                        do_valid_o <= 1'b1;\n                        p_state <= P_IDLE;\n                    end\n                end\n\n                default: begin\n                    p_state <= P_IDLE;\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // Clear tx_valid after it has been consumed by sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            tx_valid <= 1'b0;\n        end else begin\n            if (state == S_SHIFT && bit_count == 0 && sck_phase == 1'b0) begin\n                tx_valid <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
