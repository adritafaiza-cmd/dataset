  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 2'd0;\n    localparam S_WAIT_WR = 2'd1;\n    localparam S_SHIFT   = 2'd2;\n    localparam S_DONE    = 2'd3;\n\n    reg [1:0] state;\n    reg [1:0] state_next;\n\n    // Shift register and counter\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [N-1:0] bit_count;\n\n    // SCLK divider counter\n    reg [3:0] clk_div_cnt;\n    reg       clk_div_done;\n\n    // Handshake signals\n    reg       wr_ack_int;\n    reg       do_valid_int;\n\n    // SCLK phase control\n    reg       sclk_phase;\n\n    // Synchronize reset for sclk domain\n    reg [1:0] rst_sync;\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            rst_sync <= 2'b11;\n        else\n            rst_sync <= {rst_sync[0], 1'b0};\n    end\n    wire rst_sclk = rst_sync[1];\n\n    // Synchronize wren_i and di_i to sclk domain\n    reg [1:0] wren_sync;\n    reg [N-1:0] di_sync;\n    always @(posedge sclk_i) begin\n        wren_sync <= {wren_sync[0], wren_i};\n        di_sync   <= di_i;\n    end\n    wire wren_sclk = wren_sync[1];\n    wire [N-1:0] di_sclk = di_sync;\n\n    // Synchronize do_valid and do_o to pclk domain\n    reg [1:0] do_valid_sync;\n    reg [N-1:0] do_sync;\n    always @(posedge pclk_i) begin\n        do_valid_sync <= {do_valid_sync[0], do_valid_int};\n        do_sync       <= do_o;\n    end\n    wire do_valid_pclk = do_valid_sync[1];\n    wire [N-1:0] do_pclk = do_sync;\n\n    // Synchronize di_req to pclk domain\n    reg [1:0] di_req_sync;\n    always @(posedge pclk_i) begin\n        di_req_sync <= {di_req_sync[0], di_req_o};\n    end\n    wire di_req_pclk = di_req_sync[1];\n\n    // Synchronize wr_ack to pclk domain\n    reg [1:0] wr_ack_sync;\n    always @(posedge pclk_i) begin\n        wr_ack_sync <= {wr_ack_sync[0], wr_ack_int};\n    end\n    wire wr_ack_pclk = wr_ack_sync[1];\n\n    // SCLK generation logic\n    always @(posedge sclk_i or posedge rst_sclk) begin\n        if (rst_sclk) begin\n            clk_div_cnt  <= 4'd0;\n            clk_div_done <= 1'b0;\n            sclk_phase   <= 1'b0;\n            spi_sck_o    <= 1'b0;\n        end else begin\n            clk_div_done <= 1'b0;\n            if (state == S_SHIFT) begin\n                if (clk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                    clk_div_cnt  <= 4'd0;\n                    clk_div_done <= 1'b1;\n                    sclk_phase   <= ~sclk_phase;\n                    spi_sck_o    <= sclk_phase;\n                end else begin\n                    clk_div_cnt <= clk_div_cnt + 1'b1;\n                end\n            end else begin\n                clk_div_cnt <= 4'd0;\n                sclk_phase  <= 1'b0;\n                spi_sck_o   <= 1'b0;\n            end\n        end\n    end\n\n    // Main state machine\n    always @(posedge sclk_i or posedge rst_sclk) begin\n        if (rst_sclk) begin\n            state        <= S_IDLE;\n            spi_ssel_o   <= 1'b0;\n            di_req_o     <= 1'b0;\n            wr_ack_int   <= 1'b0;\n            do_valid_int <= 1'b0;\n            do_o         <= {N{1'b0}};\n            tx_shift     <= {N{1'b0}};\n            rx_shift     <= {N{1'b0}};\n            bit_count    <= {N{1'b0}};\n        end else begin\n            wr_ack_int   <= 1'b0;\n            do_valid_int <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    spi_ssel_o <= 1'b0;\n                    di_req_o   <= 1'b0;\n                    if (wren_sclk) begin\n                        state      <= S_WAIT_WR;\n                        di_req_o   <= 1'b1;\n                    end\n                end\n\n                S_WAIT_WR: begin\n                    di_req_o <= 1'b0;\n                    if (wren_sclk) begin\n                        tx_shift   <= di_sclk;\n                        rx_shift   <= {N{1'b0}};\n                        bit_count  <= {N{1'b0}};\n                        spi_ssel_o <= 1'b1;\n                        wr_ack_int <= 1'b1;\n                        state      <= S_SHIFT;\n                    end\n                end\n\n                S_SHIFT: begin\n                    spi_ssel_o <= 1'b1;\n                    if (clk_div_done) begin\n                        // On rising edge of SCLK (sclk_phase transitions 0->1), capture MISO\n                        if (sclk_phase == 1'b1) begin\n                            rx_shift <= {spi_miso_i, rx_shift[N-1:1]};\n                        end\n                        // On falling edge of SCLK (sclk_phase transitions 1->0), shift MOSI\n                        if (sclk_phase == 1'b0) begin\n                            tx_shift <= {tx_shift[N-2:0], 1'b0};\n                        end\n                        if (bit_count == N - 1) begin\n                            do_o         <= rx_shift;\n                            do_valid_int <= 1'b1;\n                            state        <= S_DONE;\n                        end else begin\n                            bit_count <= bit_count + 1'b1;\n                        end\n                    end\n                end\n\n                S_DONE: begin\n                    spi_ssel_o <= 1'b0;\n                    state      <= S_IDLE;\n                end\n\n                default: begin\n                    state      <= S_IDLE;\n                    spi_ssel_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // MOSI output\n    assign spi_mosi_o = tx_shift[N-1];\n\n    // PCLK domain outputs\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o       <= {N{1'b0}};\n        end else begin\n            wr_ack_o   <= wr_ack_pclk;\n            do_valid_o <= do_valid_pclk;\n            do_o       <= do_pclk;\n        end\n    end\n\nendmodule\n```<|im_end|>",
