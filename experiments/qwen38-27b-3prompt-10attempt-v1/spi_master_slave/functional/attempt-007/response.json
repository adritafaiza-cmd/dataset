  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE    = 2'd0;\n    localparam S_WAIT_WR = 2'd1;\n    localparam S_SHIFT   = 2'd2;\n    localparam S_DONE    = 2'd3;\n\n    reg [1:0] state;\n    reg [1:0] state_next;\n\n    // Data registers\n    reg [N-1:0] tx_data;\n    reg [N-1:0] rx_data;\n    reg [N-1:0] shift_reg;\n\n    // Bit counter\n    reg [$clog2(N)-1:0] bit_cnt;\n\n    // SPI clock divider counter\n    reg [$clog2(SPI_2X_CLK_DIV)-1:0] clk_div_cnt;\n    reg clk_div_done;\n\n    // SCK phase control\n    reg sck_phase;\n\n    // MOSI output\n    assign spi_mosi_o = shift_reg[N-1];\n\n    // Synchronous reset for pclk domain\n    reg rst_pclk;\n    reg rst_pclk_d;\n    always @(posedge pclk_i) begin\n        rst_pclk <= rst_i;\n        rst_pclk_d <= rst_pclk;\n    end\n\n    // Synchronous reset for sclk domain\n    reg rst_sclk;\n    reg rst_sclk_d;\n    always @(posedge sclk_i) begin\n        rst_sclk <= rst_i;\n        rst_sclk_d <= rst_sclk;\n    end\n\n    // Use the sclk domain for SPI timing\n    wire rst_active = rst_sclk;\n\n    // State machine - sclk domain\n    always @(posedge sclk_i) begin\n        if (rst_active) begin\n            state <= S_IDLE;\n        end else begin\n            state <= state_next;\n        end\n    end\n\n    always @(*) begin\n        state_next = state;\n        case (state)\n            S_IDLE: begin\n                if (wren_i) begin\n                    state_next = S_WAIT_WR;\n                end\n            end\n            S_WAIT_WR: begin\n                if (wren_i) begin\n                    state_next = S_SHIFT;\n                end\n            end\n            S_SHIFT: begin\n                if (bit_cnt == N-1 && clk_div_done) begin\n                    state_next = S_DONE;\n                end\n            end\n            S_DONE: begin\n                state_next = S_IDLE;\n            end\n            default: state_next = S_IDLE;\n        endcase\n    end\n\n    // Clock divider - sclk domain\n    always @(posedge sclk_i) begin\n        if (rst_active) begin\n            clk_div_cnt <= 0;\n            clk_div_done <= 1'b0;\n        end else if (state == S_SHIFT) begin\n            if (clk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                clk_div_cnt <= 0;\n                clk_div_done <= 1'b1;\n            end else begin\n                clk_div_cnt <= clk_div_cnt + 1'b1;\n                clk_div_done <= 1'b0;\n            end\n        end else begin\n            clk_div_cnt <= 0;\n            clk_div_done <= 1'b0;\n        end\n    end\n\n    // SCK generation - sclk domain\n    always @(posedge sclk_i) begin\n        if (rst_active) begin\n            spi_sck_o <= 1'b0;\n            sck_phase <= 1'b0;\n        end else if (state == S_SHIFT) begin\n            if (clk_div_done) begin\n                spi_sck_o <= ~sck_phase;\n                sck_phase <= ~sck_phase;\n            end\n        end else begin\n            spi_sck_o <= 1'b0;\n            sck_phase <= 1'b0;\n        end\n    end\n\n    // SSel control - sclk domain\n    always @(posedge sclk_i) begin\n        if (rst_active) begin\n            spi_ssel_o <= 1'b1; // Inactive high\n        end else if (state == S_SHIFT) begin\n            spi_ssel_o <= 1'b0; // Active low\n        end else begin\n            spi_ssel_o <= 1'b1;\n        end\n    end\n\n    // Bit counter and shift register - sclk domain\n    always @(posedge sclk_i) begin\n        if (rst_active) begin\n            bit_cnt <= 0;\n            shift_reg <= 0;\n            tx_data <= 0;\n            rx_data <= 0;\n        end else begin\n            case (state)\n                S_WAIT_WR: begin\n                    if (wren_i) begin\n                        tx_data <= di_i;\n                        shift_reg <= di_i;\n                        bit_cnt <= 0;\n                    end\n                end\n                S_SHIFT: begin\n                    if (clk_div_done) begin\n                        // On rising edge of SCK (sck_phase transitions 0->1), capture MISO\n                        // On falling edge of SCK (sck_phase transitions 1->0), shift out\n                        if (sck_phase == 1'b0) begin\n                            // Rising edge of SCK: capture MISO\n                            rx_data[N-1] <= spi_miso_i;\n                            rx_data[N-2:0] <= rx_data[N-1:1];\n                            // Shift out next bit\n                            shift_reg <= {shift_reg[N-2:0], 1'b0};\n                            if (bit_cnt == N-1) begin\n                                bit_cnt <= 0;\n                            end else begin\n                                bit_cnt <= bit_cnt + 1'b1;\n                            end\n                        end\n                    end\n                end\n                default: begin\n                    bit_cnt <= 0;\n                    shift_reg <= 0;\n                end\n            endcase\n        end\n    end\n\n    // pclk domain outputs\n    // wr_ack_o: acknowledge write when wren_i is high and we're in WAIT_WR or IDLE\n    always @(posedge pclk_i) begin\n        if (rst_pclk) begin\n            wr_ack_o <= 1'b0;\n            di_req_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= 0;\n        end else begin\n            // wr_ack_o: pulse when accepting a write\n            if (wren_i && (state == S_IDLE || state == S_WAIT_WR)) begin\n                wr_ack_o <= 1'b1;\n            end else begin\n                wr_ack_o <= 1'b0;\n            end\n\n            // di_req_o: request next word when idle\n            if (state == S_IDLE) begin\n                di_req_o <= 1'b1;\n            end else begin\n                di_req_o <= 1'b0;\n            end\n\n            // do_valid_o and do_o: valid when shift is complete\n            if (state == S_DONE) begin\n                do_valid_o <= 1'b1;\n                do_o <= rx_data;\n            end else begin\n                do_valid_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
