{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State machine states\n    localparam S_IDLE = 2'd0;\n    localparam S_WAIT_WRITE = 2'd1;\n    localparam S_SHIFT = 2'd2;\n    localparam S_DONE = 2'd3;\n\n    reg [1:0] state;\n    reg [1:0] state_next;\n\n    // Shift register and counter\n    reg [N-1:0] shift_reg;\n    reg [N-1:0] rx_reg;\n    reg [$clog2(N):0] bit_count;\n\n    // Clock divider counter for SPI clock generation\n    reg [$clog2(SPI_2X_CLK_DIV):0] clk_div_cnt;\n    reg sck_phase;\n\n    // Synchronizers for asynchronous signals\n    reg [1:0] wren_sync;\n    reg [1:0] di_sync;\n    reg [1:0] miso_sync;\n\n    // Synchronize wren_i\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            wren_sync <= 2'b00;\n        else\n            wren_sync <= {wren_sync[0], wren_i};\n    end\n\n    // Synchronize di_i\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            di_sync <= 2'b00;\n        else\n            di_sync <= {di_sync[0], di_i[0]};\n    end\n\n    // Synchronize miso_i\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            miso_sync <= 2'b00;\n        else\n            miso_sync <= {miso_sync[0], spi_miso_i};\n    end\n\n    // State machine\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= S_IDLE;\n        end else begin\n            state <= state_next;\n        end\n    end\n\n    always @(*) begin\n        state_next = state;\n        case (state)\n            S_IDLE: begin\n                if (wren_sync[1])\n                    state_next = S_WAIT_WRITE;\n            end\n            S_WAIT_WRITE: begin\n                if (wren_sync[1])\n                    state_next = S_SHIFT;\n            end\n            S_SHIFT: begin\n                if (bit_count == N)\n                    state_next = S_DONE;\n            end\n            S_DONE: begin\n                state_next = S_IDLE;\n            end\n            default: state_next = S_IDLE;\n        endcase\n    end\n\n    // SPI clock generation\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            clk_div_cnt <= 0;\n            sck_phase <= 1'b0;\n            spi_sck_o <= 1'b0;\n        end else if (state == S_SHIFT) begin\n            if (clk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                clk_div_cnt <= 0;\n                sck_phase <= ~sck_phase;\n                spi_sck_o <= sck_phase;\n            end else begin\n                clk_div_cnt <= clk_div_cnt + 1;\n            end\n        end else begin\n            clk_div_cnt <= 0;\n            sck_phase <= 1'b0;\n            spi_sck_o <= 1'b0;\n        end\n    end\n\n    // SPI chip select\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            spi_ssel_o <= 1'b1;\n        else if (state == S_SHIFT)\n            spi_ssel_o <= 1'b0;\n        else\n            spi_ssel_o <= 1'b1;\n    end\n\n    // MOSI output\n    assign spi_mosi_o = shift_reg[N-1];\n\n    // Shift register and receive register\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            shift_reg <= {N{1'b0}};\n            rx_reg <= {N{1'b0}};\n            bit_count <= 0;\n        end else if (state == S_SHIFT) begin\n            if (sck_phase == 1'b1 && clk_div_cnt == 0) begin\n                // On rising edge of SCK, shift out and capture\n                shift_reg <= {shift_reg[N-2:0], 1'b0};\n                rx_reg <= {rx_reg[N-2:0], miso_sync[1]};\n                bit_count <= bit_count + 1;\n            end\n        end else if (state == S_WAIT_WRITE) begin\n            if (wren_sync[1]) begin\n                shift_reg <= di_i;\n                bit_count <= 0;\n            end\n        end\n    end\n\n    // Parallel interface handshake\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n        end else begin\n            // Default\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            case (state)\n                S_IDLE: begin\n                    di_req_o <= 1'b1;\n                end\n                S_WAIT_WRITE: begin\n                    if (wren_i) begin\n                        wr_ack_o <= 1'b1;\n                    end\n                end\n                S_DONE: begin\n                    do_valid_o <= 1'b1;\n                    do_o <= rx_reg;\n                end\n                default: ;\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
