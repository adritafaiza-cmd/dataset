  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // ========================================================================\n    // Reset Synchronization\n    // ========================================================================\n    \n    // Sclk domain reset synchronizer\n    reg [1:0] sclk_rst_sync;\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            sclk_rst_sync <= 2'b11;\n        else\n            sclk_rst_sync <= {sclk_rst_sync[0], 1'b0};\n    end\n    wire sclk_rst = sclk_rst_sync[1];\n\n    // Pclk domain reset synchronizer\n    reg [1:0] pclk_rst_sync;\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            pclk_rst_sync <= 2'b11;\n        else\n            pclk_rst_sync <= {pclk_rst_sync[0], 1'b0};\n    end\n    wire pclk_rst = pclk_rst_sync[1];\n\n    // ========================================================================\n    // Pclk Domain: Parallel Interface and Handshake\n    // ========================================================================\n    \n    // State machine for parallel interface\n    localparam ST_IDLE = 2'b00;\n    localparam ST_WAIT_ACK = 2'b01;\n    localparam ST_WAIT_REQ = 2'b10;\n    \n    reg [1:0] p_state;\n    reg [N-1:0] tx_word_reg;\n    reg [N-1:0] rx_word_reg;\n    reg         tx_valid_p;\n    reg         rx_valid_p;\n    \n    // Handshake signals to sclk domain\n    reg         tx_req_p;   // Request to send a word to sclk domain\n    reg         rx_ack_p;   // Acknowledge receipt of word from sclk domain\n    \n    // Handshake signals from sclk domain (synchronized)\n    reg         tx_ack_s_sync;\n    reg         rx_req_s_sync;\n    \n    // Synchronizers for signals from sclk domain\n    reg [1:0] tx_ack_sync;\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst)\n            tx_ack_sync <= 2'b00;\n        else\n            tx_ack_sync <= {tx_ack_sync[0], tx_ack_s_sync};\n    end\n    wire tx_ack_p = tx_ack_sync[1];\n    \n    reg [1:0] rx_req_sync;\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst)\n            rx_req_sync <= 2'b00;\n        else\n            rx_req_sync <= {rx_req_sync[0], rx_req_s_sync};\n    end\n    wire rx_req_p = rx_req_sync[1];\n\n    // Pclk domain state machine\n    always @(posedge pclk_i or posedge pclk_rst) begin\n        if (pclk_rst) begin\n            p_state <= ST_IDLE;\n            tx_word_reg <= {N{1'b0}};\n            rx_word_reg <= {N{1'b0}};\n            tx_valid_p <= 1'b0;\n            rx_valid_p <= 1'b0;\n            tx_req_p <= 1'b0;\n            rx_ack_p <= 1'b0;\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n        end else begin\n            case (p_state)\n                ST_IDLE: begin\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                    tx_req_p <= 1'b0;\n                    rx_ack_p <= 1'b0;\n                    \n                    if (wren_i) begin\n                        tx_word_reg <= di_i;\n                        tx_valid_p <= 1'b1;\n                        tx_req_p <= 1'b1;\n                        p_state <= ST_WAIT_ACK;\n                    end else if (rx_req_p) begin\n                        rx_word_reg <= rx_word_reg; // Will be updated by sclk domain\n                        rx_valid_p <= 1'b1;\n                        rx_ack_p <= 1'b1;\n                        p_state <= ST_WAIT_REQ;\n                    end\n                end\n                \n                ST_WAIT_ACK: begin\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                    \n                    if (tx_ack_p) begin\n                        tx_req_p <= 1'b0;\n                        tx_valid_p <= 1'b0;\n                        wr_ack_o <= 1'b1;\n                        p_state <= ST_IDLE;\n                    end\n                end\n                \n                ST_WAIT_REQ: begin\n                    di_req_o <= 1'b0;\n                    wr_ack_o <= 1'b0;\n                    do_valid_o <= 1'b0;\n                    \n                    if (rx_req_p) begin\n                        rx_ack_p <= 1'b0;\n                        rx_valid_p <= 1'b0;\n                        do_valid_o <= 1'b1;\n                        do_o <= rx_word_reg;\n                        p_state <= ST_IDLE;\n                    end\n                end\n                \n                default: begin\n                    p_state <= ST_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // ========================================================================\n    // Sclk Domain: SPI Master Logic\n    // ========================================================================\n    \n    // Synchronizers for signals from pclk domain\n    reg [1:0] tx_req_sync;\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst)\n            tx_req_sync <= 2'b00;\n        else\n            tx_req_sync <= {tx_req_sync[0], tx_req_p};\n    end\n    wire tx_req_s = tx_req_sync[1];\n    \n    reg [1:0] rx_ack_sync;\n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst)\n            rx_ack_sync <= 2'b00;\n        else\n            rx_ack_sync <= {rx_ack_sync[0], rx_ack_p};\n    end\n    wire rx_ack_s = rx_ack_sync[1];\n\n    // Sclk domain state machine\n    localparam S_IDLE = 3'b000;\n    localparam S_TX = 3'b001;\n    localparam S_RX = 3'b010;\n    localparam S_DONE = 3'b011;\n    \n    reg [2:0] s_state;\n    reg [N-1:0] s_tx_word;\n    reg [N-1:0] s_rx_word;\n    reg [N-1:0] s_shift_reg;\n    reg [N-1:0] s_bit_counter;\n    reg         s_tx_valid;\n    reg         s_rx_valid;\n    \n    // SPI signals\n    reg         s_ssel;\n    reg         s_sck;\n    reg         s_mosi;\n    \n    // Handshake signals to pclk domain\n    reg         s_tx_ack;\n    reg         s_rx_req;\n\n    // SPI clock divider\n    reg [31:0] sclk_div_counter;\n    reg        sclk_phase;\n    \n    always @(posedge sclk_i or posedge sclk_rst) begin\n        if (sclk_rst) begin\n            s_state <= S_IDLE;\n            s_tx_word <= {N{1'b0}};\n            s_rx_word <= {N{1'b0}};\n            s_shift_reg <= {N{1'b0}};\n            s_bit_counter <= {N{1'b0}};\n            s_tx_valid <= 1'b0;\n            s_rx_valid <= 1'b0;\n            s_ssel <= 1'b0;\n            s_sck <= 1'b0;\n            s_mosi <= 1'b0;\n            s_tx_ack <= 1'b0;\n            s_rx_req <= 1'b0;\n            sclk_div_counter <= 32'd0;\n            sclk_phase <= 1'b0;\n        end else begin\n            case (s_state)\n                S_IDLE: begin\n                    s_ssel <= 1'b0;\n                    s_sck <= 1'b0;\n                    s_mosi <= 1'b0;\n                    s_tx_ack <= 1'b0;\n                    s_rx_req <= 1'b0;\n                    \n                    if (tx_req_s) begin\n                        s_tx_word <= tx_word_reg;\n                        s_tx_valid <= 1'b1;\n                        s_ssel <= 1'b1;\n                        s_state <= S_TX;\n                    end else if (rx_ack_s) begin\n                        s_rx_word <= rx_word_reg;\n                        s_rx_valid <= 1'b1;\n                        s_ssel <= 1'b1;\n                        s_state <= S_RX;\n                    end\n                end\n                \n                S_TX: begin\n                    s_ssel <= 1'b1;\n                    \n                    // Generate SPI clock\n                    if (sclk_div_counter == SPI_2X_CLK_DIV - 1) begin\n                        sclk_div_counter <= 32'd0;\n                        sclk_phase <= ~sclk_phase;\n                        \n                        if (sclk_phase) begin\n                            // Rising edge: shift out MSB\n                            s_mosi <= s_shift_reg[N-1];\n                            s_shift_reg <= {s_shift_reg[N-2:0], 1'b0};\n                            s_bit_counter <= s_bit_counter + 1'b1;\n                            \n                            if (s_bit_counter == N - 1) begin\n                                s_sck <= 1'b0;\n                                s_ssel <= 1'b0;\n                                s_tx_ack <= 1'b1;\n                                s_state <= S_IDLE;\n                            end\n                        end else begin\n                            s_sck <= 1'b1;\n                        end\n                    end else begin\n                        sclk_div_counter <= sclk_div_counter + 1'b1;\n                    end\n                    \n                    // Initialize shift register on first cycle\n                    if (sclk_div_counter == 0 && sclk_phase == 1'b0) begin\n                        s_shift_reg <= s_tx_word;\n                        s_bit_counter <= {N{1'b0}};\n                        s_sck <= 1'b0;\n                    end\n                end\n                \n                S_RX: begin\n                    s_ssel <= 1'b1;\n                    \n                    // Generate SPI clock\n                    if (sclk_div_counter == SPI_2X_CLK_DIV - 1) begin\n                        sclk_div_counter <= 32'd0;\n                        sclk_phase <= ~sclk_phase;\n                        \n                        if (sclk_phase) begin\n                            // Rising edge: capture MISO\n                            s_rx_word <= {spi_miso_i, s_rx_word[N-1:1]};\n                            s_bit_counter <= s_bit_counter + 1'b1;\n                            \n                            if (s_bit_counter == N - 1) begin\n                                s_sck <= 1'b0;\n                                s_ssel <= 1'b0;\n                                s_rx_req <= 1'b1;\n                                s_state <= S_IDLE;\n                            end\n                        end else begin\n                            s_sck <= 1'b1;\n                        end\n                    end else begin\n                        sclk_div_counter <= sclk_div_counter + 1'b1;\n                    end\n                    \n                    // Initialize on first cycle\n                    if (sclk_div_counter == 0 && sclk_phase == 1'b0) begin\n                        s_rx_word <= {N{1'b0}};\n                        s_bit_counter <= {N{1'b0}};\n                        s_sck <= 1'b0;\n                    end\n                end\n                \n                default: begin\n                    s_state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // ========================================================================\n    // Output Assignments\n    // ========================================================================\n    \n    assign spi_ssel_o = s_ssel;\n    assign spi_sck_o = s_sck;\n    assign spi_mosi_o = s_mosi;\n\nendmodule\n```<|im_end|>",
