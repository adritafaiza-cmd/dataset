  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // SPI clock divider\n    localparam SPI_CLK_DIV = SPI_2X_CLK_DIV;\n    reg [3:0] spi_clk_cnt;\n    wire spi_clk_en;\n    wire spi_clk_pulse;\n\n    // Generate SPI clock enable and pulse\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_clk_cnt <= 0;\n        end else begin\n            spi_clk_cnt <= spi_clk_cnt + 1;\n        end\n    end\n\n    assign spi_clk_en = (spi_clk_cnt == SPI_CLK_DIV - 1);\n    assign spi_clk_pulse = (spi_clk_cnt == SPI_CLK_DIV - 1);\n\n    // SPI state machine\n    localparam S_IDLE = 2'd0;\n    localparam S_TX   = 2'd1;\n    localparam S_RX   = 2'd2;\n\n    reg [1:0] spi_state;\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [3:0] bit_cnt;\n    reg spi_sck_reg;\n    reg spi_ssel_reg;\n    reg spi_mosi_reg;\n\n    // Parallel side registers\n    reg [N-1:0] di_reg;\n    reg wren_reg;\n    reg di_req_reg;\n    reg wr_ack_reg;\n    reg do_valid_reg;\n    reg [N-1:0] do_reg;\n\n    // Clock domain crossing: sclk to pclk\n    reg [1:0] spi_state_sync;\n    reg [1:0] spi_state_sync2;\n    wire [1:0] spi_state_pclk;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_state_sync  <= 0;\n            spi_state_sync2 <= 0;\n        end else begin\n            spi_state_sync  <= spi_state;\n            spi_state_sync2 <= spi_state_sync;\n        end\n    end\n    assign spi_state_pclk = spi_state_sync2;\n\n    // Clock domain crossing: pclk to sclk\n    reg wren_sync;\n    reg wren_sync2;\n    wire wren_sclk;\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wren_sync  <= 0;\n            wren_sync2 <= 0;\n        end else begin\n            wren_sync  <= wren_i;\n            wren_sync2 <= wren_sync;\n        end\n    end\n    assign wren_sclk = wren_sync2;\n\n    // SPI master logic in sclk domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_state    <= S_IDLE;\n            spi_sck_reg  <= 0;\n            spi_ssel_reg <= 1;\n            spi_mosi_reg <= 0;\n            tx_shift     <= 0;\n            rx_shift     <= 0;\n            bit_cnt      <= 0;\n        end else begin\n            case (spi_state)\n                S_IDLE: begin\n                    spi_sck_reg  <= 0;\n                    spi_ssel_reg <= 1;\n                    spi_mosi_reg <= 0;\n                    if (wren_sclk) begin\n                        spi_state    <= S_TX;\n                        spi_ssel_reg <= 0;\n                        tx_shift     <= di_i;\n                        bit_cnt      <= 0;\n                        spi_mosi_reg <= di_i[N-1];\n                    end\n                end\n                S_TX: begin\n                    if (spi_clk_pulse) begin\n                        if (bit_cnt == N-1) begin\n                            spi_state    <= S_RX;\n                            spi_sck_reg  <= 0;\n                            bit_cnt      <= 0;\n                            rx_shift     <= 0;\n                        end else begin\n                            bit_cnt      <= bit_cnt + 1;\n                            spi_sck_reg  <= ~spi_sck_reg;\n                            tx_shift     <= {tx_shift[N-2:0], 1'b0};\n                            spi_mosi_reg <= tx_shift[N-2];\n                        end\n                    end\n                end\n                S_RX: begin\n                    if (spi_clk_pulse) begin\n                        if (bit_cnt == N-1) begin\n                            spi_state    <= S_IDLE;\n                            spi_ssel_reg <= 1;\n                            spi_sck_reg  <= 0;\n                            bit_cnt      <= 0;\n                        end else begin\n                            bit_cnt      <= bit_cnt + 1;\n                            spi_sck_reg  <= ~spi_sck_reg;\n                            rx_shift     <= {rx_shift[N-2:0], spi_miso_i};\n                        end\n                    end\n                end\n                default: begin\n                    spi_state    <= S_IDLE;\n                    spi_sck_reg  <= 0;\n                    spi_ssel_reg <= 1;\n                    spi_mosi_reg <= 0;\n                end\n            endcase\n        end\n    end\n\n    assign spi_ssel_o = spi_ssel_reg;\n    assign spi_sck_o  = spi_sck_reg;\n    assign spi_mosi_o = spi_mosi_reg;\n\n    // Parallel side logic in pclk domain\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_reg   <= 0;\n            wr_ack_reg   <= 0;\n            do_valid_reg <= 0;\n            do_reg       <= 0;\n        end else begin\n            // Default: deassert one-cycle pulses\n            di_req_reg   <= 0;\n            wr_ack_reg   <= 0;\n            do_valid_reg <= 0;\n\n            case (spi_state_pclk)\n                S_IDLE: begin\n                    if (wren_i) begin\n                        di_req_reg <= 1;\n                    end\n                end\n                S_TX: begin\n                    // Handshake: acknowledge write request\n                    if (wren_i) begin\n                        wr_ack_reg <= 1;\n                    end\n                end\n                S_RX: begin\n                    // When RX completes, output received data\n                    if (spi_state_pclk == S_RX && spi_state_sync == S_IDLE) begin\n                        do_valid_reg <= 1;\n                        do_reg       <= rx_shift;\n                    end\n                end\n                default: ;\n            endcase\n        end\n    end\n\n    assign di_req_o   = di_req_reg;\n    assign wr_ack_o   = wr_ack_reg;\n    assign do_valid_o = do_valid_reg;\n    assign do_o       = do_reg;\n\nendmodule\n```<|im_end|>",
