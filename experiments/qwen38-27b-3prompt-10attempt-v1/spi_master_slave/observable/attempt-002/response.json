  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // SCLK domain state\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [N-1:0] bit_cnt;\n    reg         sclk_active;\n    reg         sclk_phase;\n    reg [SPI_2X_CLK_DIV-1:0] sclk_div_cnt;\n    reg         sclk_edge;\n\n    // PCLK domain state\n    reg [N-1:0] p_tx_word;\n    reg         p_tx_valid;\n    reg         p_rx_valid;\n    reg [N-1:0] p_rx_word;\n    reg         p_busy;\n\n    // Synchronizers\n    reg [1:0] sync_tx_valid;\n    reg [1:0] sync_rx_valid;\n    reg [1:0] sync_busy;\n\n    // SCLK domain: synchronizer for pclk signals\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sync_tx_valid <= 2'b00;\n            sync_rx_valid <= 2'b00;\n            sync_busy     <= 2'b00;\n        end else begin\n            sync_tx_valid <= {sync_tx_valid[0], p_tx_valid};\n            sync_rx_valid <= {sync_rx_valid[0], p_rx_valid};\n            sync_busy     <= {sync_busy[0], p_busy};\n        end\n    end\n\n    // PCLK domain: synchronizer for sclk signals\n    reg [1:0] sync_sclk_active;\n    reg [1:0] sync_sclk_done;\n    reg [N-1:0] sync_rx_word;\n    reg [N-1:0] sync_rx_word_d1;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sync_sclk_active <= 2'b00;\n            sync_sclk_done   <= 2'b00;\n            sync_rx_word     <= {N{1'b0}};\n            sync_rx_word_d1  <= {N{1'b0}};\n        end else begin\n            sync_sclk_active <= {sync_sclk_active[0], sclk_active};\n            sync_sclk_done   <= {sync_sclk_done[0], sclk_active & (bit_cnt == N[MSB:0])};\n            sync_rx_word     <= rx_shift;\n            sync_rx_word_d1  <= sync_rx_word;\n        end\n    end\n\n    // SCLK domain: SPI state machine\n    // SPI mode 0: CPOL=0, CPHA=0\n    // sck idle low, data changes on falling edge, sampled on rising edge\n    // We generate sck from sclk_i using a divider\n\n    wire [N-1:0] full_cnt = N[MSB:0];\n\n    // Generate SPI clock from sclk_i\n    // SPI_2X_CLK_DIV is the number of sclk_i cycles per SPI bit\n    // We need to generate a clock that is SPI_2X_CLK_DIV times slower\n    // Actually, let's think about this differently.\n    \n    // The parameter SPI_2X_CLK_DIV suggests that the SPI clock frequency is \n    // sclk_i / SPI_2X_CLK_DIV. So for each SPI bit, we need SPI_2X_CLK_DIV \n    // cycles of sclk_i.\n    \n    // Let's use a counter to generate the SPI clock edges.\n    // We'll count up to SPI_2X_CLK_DIV/2 for each half-cycle.\n    \n    // Actually, let's simplify: we'll use a state machine that advances \n    // on sclk_i edges and generates the SPI signals.\n    \n    // Let me reconsider the approach. We'll have a state machine in the \n    // sclk_i domain that:\n    // 1. Waits for a valid word from the pclk domain\n    // 2. Shifts out the word over N SPI bits\n    // 3. Shifts in the received word\n    // 4. Signals completion to the pclk domain\n    \n    // SPI clock generation:\n    // We'll generate spi_sck_o by toggling it every SPI_2X_CLK_DIV/2 sclk_i cycles\n    // during active transfer.\n    \n    // Let's define the states:\n    // IDLE: waiting for a word\n    // ACTIVE: shifting data\n    \n    reg [1:0] state;\n    localparam S_IDLE   = 2'd0;\n    localparam S_ACTIVE = 2'd1;\n\n    // SPI clock divider counter\n    reg [SPI_2X_CLK_DIV-1:0] clk_div;\n\n    // MOSI output\n    assign spi_mosi_o = tx_shift[N-1];\n\n    // SCLK domain main logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state        <= S_IDLE;\n            tx_shift     <= {N{1'b0}};\n            rx_shift     <= {N{1'b0}};\n            bit_cnt      <= {N{1'b0}};\n            sclk_active  <= 1'b0;\n            sclk_phase   <= 1'b0;\n            clk_div      <= {SPI_2X_CLK_DIV{1'b0}};\n            spi_ssel_o   <= 1'b1;\n            spi_sck_o    <= 1'b0;\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o  <= 1'b0;\n                    sclk_active <= 1'b0;\n                    clk_div <= {SPI_2X_CLK_DIV{1'b0}};\n                    \n                    if (sync_tx_valid[1]) begin\n                        // Load the word and start transfer\n                        tx_shift    <= p_tx_word;\n                        rx_shift    <= {N{1'b0}};\n                        bit_cnt     <= {N{1'b0}};\n                        sclk_active <= 1'b1;\n                        sclk_phase  <= 1'b0;\n                        clk_div     <= {SPI_2X_CLK_DIV{1'b0}};\n                        spi_ssel_o  <= 1'b0;\n                        state       <= S_ACTIVE;\n                    end\n                end\n                \n                S_ACTIVE: begin\n                    // Generate SPI clock\n                    clk_div <= clk_div + 1'b1;\n                    \n                    if (clk_div == SPI_2X_CLK_DIV[MSB:0] - 1) begin\n                        clk_div <= {SPI_2X_CLK_DIV{1'b0}};\n                        \n                        // Toggle SCK\n                        if (sclk_phase == 1'b0) begin\n                            // Rising edge of SPI SCK\n                            spi_sck_o  <= 1'b1;\n                            sclk_phase <= 1'b1;\n                            \n                            // Sample MISO on rising edge (SPI mode 0)\n                            rx_shift <= {spi_miso_i, rx_shift[N-1:1]};\n                        end else begin\n                            // Falling edge of SPI SCK\n                            spi_sck_o  <= 1'b0;\n                            sclk_phase <= 1'b0;\n                            \n                            // Shift out next bit on falling edge (SPI mode 0)\n                            tx_shift <= {tx_shift[N-2:0], 1'b0};\n                            \n                            // Check if we're done\n                            if (bit_cnt == N[MSB:0] - 1) begin\n                                // Transfer complete\n                                sclk_active <= 1'b0;\n                                spi_ssel_o  <= 1'b1;\n                                spi_sck_o   <= 1'b0;\n                                state       <= S_IDLE;\n                            end else begin\n                                bit_cnt <= bit_cnt + 1'b1;\n                            end\n                        end\n                    end\n                end\n                \n                default: begin\n                    state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // PCLK domain: parallel interface logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            p_tx_word  <= {N{1'b0}};\n            p_tx_valid <= 1'b0;\n            p_rx_valid <= 1'b0;\n            p_rx_word  <= {N{1'b0}};\n            p_busy     <= 1'b0;\n            di_req_o   <= 1'b0;\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o       <= {N{1'b0}};\n        end else begin\n            // Default: deassert single-cycle signals\n            di_req_o   <= 1'b0;\n            wr_ack_o   <= 1'b0;\n            do_valid_o <= 1'b0;\n            \n            // Handle incoming word\n            if (wren_i && !p_busy) begin\n                p_tx_word  <= di_i;\n                p_tx_valid <= 1'b1;\n                p_busy     <= 1'b1;\n                di_req_o   <= 1'b1;\n            end else begin\n                p_tx_valid <= 1'b0;\n            end\n            \n            // Handle completion from SCLK domain\n            if (sync_sclk_done[1] && !sync_sclk_done[0]) begin\n                // Rising edge of done signal\n                p_rx_word  <= sync_rx_word_d1;\n                p_rx_valid <= 1'b1;\n                p_busy     <= 1'b0;\n                do_valid_o <= 1'b1;\n                do_o       <= sync_rx_word_d1;\n            end else begin\n                p_rx_valid <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
