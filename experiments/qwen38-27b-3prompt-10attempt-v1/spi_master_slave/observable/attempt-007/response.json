  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // SPI clock divider counter\n    localparam SPI_CLK_DIV_MAX = SPI_2X_CLK_DIV - 1;\n    reg [31:0] spi_clk_cnt;\n    reg spi_clk_phase;\n\n    // SPI state machine\n    localparam SPI_IDLE = 2'd0;\n    localparam SPI_TX   = 2'd1;\n    localparam SPI_RX   = 2'd2;\n    localparam SPI_DONE = 2'd3;\n    reg [1:0] spi_state;\n\n    // SPI shift registers\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [31:0] bit_cnt;\n\n    // Parallel interface FIFO (simple 2-entry)\n    reg [N-1:0] fifo_mem [0:1];\n    reg [1:0] fifo_wr_ptr;\n    reg [1:0] fifo_rd_ptr;\n    reg fifo_empty;\n    reg fifo_full;\n\n    // Synchronization for reset\n    reg rst_sync_1, rst_sync_2;\n\n    // Synchronization for wren_i\n    reg wren_sync_1, wren_sync_2, wren_sync_3;\n\n    // Synchronization for di_i\n    reg [N-1:0] di_sync_1, di_sync_2;\n\n    // Synchronization for spi_miso_i\n    reg miso_sync_1, miso_sync_2;\n\n    // Internal signals\n    wire spi_clk_edge;\n    wire spi_clk_rising;\n    wire spi_clk_falling;\n\n    // Reset synchronization\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            rst_sync_1 <= 1'b1;\n            rst_sync_2 <= 1'b1;\n        end else begin\n            rst_sync_1 <= 1'b0;\n            rst_sync_2 <= rst_sync_1;\n        end\n    end\n\n    wire rst_sync = rst_sync_2;\n\n    // Wren synchronization\n    always @(posedge pclk_i) begin\n        wren_sync_1 <= wren_i;\n        wren_sync_2 <= wren_sync_1;\n        wren_sync_3 <= wren_sync_2;\n    end\n\n    wire wren_sync = wren_sync_2;\n    wire wren_rise = wren_sync & ~wren_sync_3;\n\n    // DI synchronization\n    always @(posedge pclk_i) begin\n        di_sync_1 <= di_i;\n        di_sync_2 <= di_sync_1;\n    end\n\n    wire [N-1:0] di_sync = di_sync_2;\n\n    // MISO synchronization\n    always @(posedge sclk_i) begin\n        miso_sync_1 <= spi_miso_i;\n        miso_sync_2 <= miso_sync_1;\n    end\n\n    wire miso_sync = miso_sync_2;\n\n    // SPI clock generation\n    always @(posedge sclk_i or posedge rst_sync) begin\n        if (rst_sync) begin\n            spi_clk_cnt <= 0;\n            spi_clk_phase <= 1'b0;\n        end else begin\n            if (spi_clk_cnt == SPI_CLK_DIV_MAX) begin\n                spi_clk_cnt <= 0;\n                spi_clk_phase <= ~spi_clk_phase;\n            end else begin\n                spi_clk_cnt <= spi_clk_cnt + 1;\n            end\n        end\n    end\n\n    // Detect rising and falling edges of generated SPI clock\n    reg spi_clk_phase_prev;\n    always @(posedge sclk_i) begin\n        spi_clk_phase_prev <= spi_clk_phase;\n    end\n\n    wire spi_clk_rising = spi_clk_phase & ~spi_clk_phase_prev;\n    wire spi_clk_falling = ~spi_clk_phase & spi_clk_phase_prev;\n\n    // SPI state machine\n    always @(posedge sclk_i or posedge rst_sync) begin\n        if (rst_sync) begin\n            spi_state <= SPI_IDLE;\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            tx_shift <= {N{1'b0}};\n            rx_shift <= {N{1'b0}};\n            bit_cnt <= 0;\n        end else begin\n            case (spi_state)\n                SPI_IDLE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o <= 1'b0;\n                    if (fifo_empty == 1'b0) begin\n                        spi_state <= SPI_TX;\n                        spi_ssel_o <= 1'b0;\n                        tx_shift <= fifo_mem[fifo_rd_ptr];\n                        bit_cnt <= 0;\n                    end\n                end\n                SPI_TX: begin\n                    spi_ssel_o <= 1'b0;\n                    if (spi_clk_rising) begin\n                        spi_sck_o <= 1'b1;\n                        tx_shift <= {tx_shift[N-2:0], 1'b0};\n                        if (bit_cnt == N-1) begin\n                            spi_state <= SPI_RX;\n                            bit_cnt <= 0;\n                        end else begin\n                            bit_cnt <= bit_cnt + 1;\n                        end\n                    end else if (spi_clk_falling) begin\n                        spi_sck_o <= 1'b0;\n                        rx_shift <= {rx_shift[N-2:0], miso_sync};\n                        if (bit_cnt == N-1) begin\n                            spi_state <= SPI_DONE;\n                        end else begin\n                            bit_cnt <= bit_cnt + 1;\n                        end\n                    end\n                end\n                SPI_RX: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                    spi_state <= SPI_DONE;\n                end\n                SPI_DONE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o <= 1'b0;\n                    spi_state <= SPI_IDLE;\n                end\n                default: begin\n                    spi_state <= SPI_IDLE;\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // MOSI output\n    assign spi_mosi_o = tx_shift[N-1];\n\n    // Parallel interface FIFO management\n    always @(posedge pclk_i or posedge rst_sync) begin\n        if (rst_sync) begin\n            fifo_wr_ptr <= 0;\n            fifo_rd_ptr <= 0;\n            fifo_empty <= 1'b1;\n            fifo_full <= 1'b0;\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n        end else begin\n            // Default: clear one-cycle pulses\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n\n            // Check if SPI is idle and FIFO is not full\n            if (spi_state == SPI_IDLE && fifo_full == 1'b0) begin\n                di_req_o <= 1'b1;\n            end\n\n            // Accept data when wren is high and we're requesting\n            if (wren_rise && di_req_o) begin\n                fifo_mem[fifo_wr_ptr] <= di_sync;\n                fifo_wr_ptr <= fifo_wr_ptr + 1;\n                wr_ack_o <= 1'b1;\n                if (fifo_wr_ptr == 1) begin\n                    fifo_full <= 1'b1;\n                    fifo_empty <= 1'b0;\n                end else begin\n                    fifo_empty <= 1'b0;\n                end\n            end\n\n            // Read from FIFO when SPI starts transmitting\n            if (spi_state == SPI_IDLE && fifo_empty == 1'b0) begin\n                fifo_rd_ptr <= fifo_rd_ptr + 1;\n                if (fifo_rd_ptr == 1) begin\n                    fifo_empty <= 1'b1;\n                    fifo_full <= 1'b0;\n                end else begin\n                    fifo_full <= 1'b0;\n                end\n            end\n\n            // Output received data when SPI completes\n            if (spi_state == SPI_DONE) begin\n                do_o <= rx_shift;\n                do_valid_o <= 1'b1;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
