{
  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // SPI clock domain signals\n    reg [N-1:0] tx_shift_reg;\n    reg [N-1:0] rx_shift_reg;\n    reg [N-1:0] bit_counter;\n    reg         spi_active;\n    reg         spi_sck_int;\n    reg         spi_ssel_int;\n    reg         spi_mosi_int;\n    reg         spi_clk_div_cnt;\n    reg         spi_clk_phase;\n\n    // Parallel clock domain signals\n    reg         di_req_int;\n    reg         wr_ack_int;\n    reg         do_valid_int;\n    reg [N-1:0] do_int;\n    reg         wren_sync1;\n    reg         wren_sync2;\n    reg         wren_sync3;\n    reg         wren_pulse;\n    reg         di_req_sync1;\n    reg         di_req_sync2;\n    reg         di_req_pulse;\n    reg         wr_ack_sync1;\n    reg         wr_ack_sync2;\n    reg         wr_ack_pulse;\n    reg         do_valid_sync1;\n    reg         do_valid_sync2;\n    reg         do_valid_pulse;\n    reg [N-1:0] do_sync1;\n    reg [N-1:0] do_sync2;\n    reg [N-1:0] do_sync3;\n\n    // SPI clock generation\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_clk_div_cnt <= 0;\n            spi_clk_phase   <= 0;\n            spi_sck_int     <= 0;\n        end else begin\n            if (spi_active) begin\n                spi_clk_div_cnt <= spi_clk_div_cnt + 1;\n                if (spi_clk_div_cnt == SPI_2X_CLK_DIV - 1) begin\n                    spi_clk_div_cnt <= 0;\n                    spi_clk_phase   <= ~spi_clk_phase;\n                    spi_sck_int     <= spi_clk_phase;\n                end\n            end else begin\n                spi_clk_div_cnt <= 0;\n                spi_clk_phase   <= 0;\n                spi_sck_int     <= 0;\n            end\n        end\n    end\n\n    // SPI state machine\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_active    <= 0;\n            spi_ssel_int  <= 1;\n            spi_mosi_int  <= 0;\n            tx_shift_reg  <= 0;\n            rx_shift_reg  <= 0;\n            bit_counter   <= 0;\n        end else begin\n            if (spi_active) begin\n                // On rising edge of SPI clock, shift in MISO and shift out MOSI\n                if (spi_sck_int) begin\n                    // Shift in MISO\n                    rx_shift_reg <= {rx_shift_reg[N-2:0], spi_miso_i};\n                    // Shift out MOSI\n                    tx_shift_reg <= {tx_shift_reg[N-2:0], 1'b0};\n                    spi_mosi_int <= tx_shift_reg[N-1];\n                    \n                    if (bit_counter == N-1) begin\n                        spi_active   <= 0;\n                        spi_ssel_int <= 1;\n                        spi_mosi_int <= 0;\n                    end else begin\n                        bit_counter <= bit_counter + 1;\n                    end\n                end\n            end else begin\n                // Wait for new word from parallel domain\n                if (di_req_pulse) begin\n                    spi_active   <= 1;\n                    spi_ssel_int <= 0;\n                    tx_shift_reg <= di_i;\n                    spi_mosi_int <= di_i[N-1];\n                    rx_shift_reg <= 0;\n                    bit_counter  <= 0;\n                end\n            end\n        end\n    end\n\n    // Assign SPI outputs\n    assign spi_ssel_o = spi_ssel_int;\n    assign spi_sck_o  = spi_sck_int;\n    assign spi_mosi_o = spi_mosi_int;\n\n    // Parallel clock domain: synchronize SPI signals\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_sync1   <= 0;\n            di_req_sync2   <= 0;\n            di_req_pulse   <= 0;\n            wr_ack_sync1   <= 0;\n            wr_ack_sync2   <= 0;\n            wr_ack_pulse   <= 0;\n            do_valid_sync1 <= 0;\n            do_valid_sync2 <= 0;\n            do_valid_pulse <= 0;\n            do_sync1       <= 0;\n            do_sync2       <= 0;\n            do_sync3       <= 0;\n        end else begin\n            // Synchronize di_req from SPI domain\n            di_req_sync1 <= di_req_int;\n            di_req_sync2 <= di_req_sync1;\n            di_req_pulse <= di_req_sync1 & ~di_req_sync2;\n\n            // Synchronize wr_ack from SPI domain\n            wr_ack_sync1 <= wr_ack_int;\n            wr_ack_sync2 <= wr_ack_sync1;\n            wr_ack_pulse <= wr_ack_sync1 & ~wr_ack_sync2;\n\n            // Synchronize do_valid from SPI domain\n            do_valid_sync1 <= do_valid_int;\n            do_valid_sync2 <= do_valid_sync1;\n            do_valid_pulse <= do_valid_sync1 & ~do_valid_sync2;\n\n            // Synchronize do data\n            do_sync1 <= do_int;\n            do_sync2 <= do_sync1;\n            do_sync3 <= do_sync2;\n        end\n    end\n\n    // Parallel clock domain: control logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_int   <= 0;\n            wr_ack_int   <= 0;\n            do_valid_int <= 0;\n            do_int       <= 0;\n            di_req_o     <= 0;\n            wr_ack_o     <= 0;\n            do_valid_o   <= 0;\n            do_o         <= 0;\n        end else begin\n            // Generate di_req when wren is asserted and not currently transferring\n            if (wren_i && !spi_active) begin\n                di_req_int <= 1;\n            end else begin\n                di_req_int <= 0;\n            end\n\n            // Generate wr_ack when SPI transfer completes\n            if (do_valid_pulse) begin\n                wr_ack_int <= 1;\n            end else begin\n                wr_ack_int <= 0;\n            end\n\n            // Generate do_valid when SPI transfer completes\n            if (do_valid_pulse) begin\n                do_valid_int <= 1;\n            end else begin\n                do_valid_int <= 0;\n            end\n\n            // Capture received data\n            if (do_valid_pulse) begin\n                do_int <= rx_shift_reg;\n            end\n\n            // Drive outputs\n            di_req_o   <= di_req_int;\n            wr_ack_o   <= wr_ack_int;\n            do_valid_o <= do_valid_int;\n            do_o       <= do_sync3;\n        end\n    end\n\n    // SPI clock domain: generate signals for parallel domain\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_int   <= 0;\n            wr_ack_int   <= 0;\n            do_valid_int <= 0;\n            do_int       <= 0;\n        end else begin\n            // di_req is generated in parallel domain, but we need to acknowledge it\n            // Actually, di_req_int is driven by parallel domain, so we just use it\n            // For SPI domain, we need to generate wr_ack and do_valid when transfer completes\n            \n            if (spi_active && spi_sck_int && bit_counter == N-1) begin\n                // Transfer complete\n                wr_ack_int   <= 1;\n                do_valid_int <= 1;\n                do_int       <= rx_shift_reg;\n            end else begin\n                wr_ack_int   <= 0;\n                do_valid_int <= 0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
