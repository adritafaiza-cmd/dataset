{
  "text": "```verilog\nmodule sync_wedge #(\n    parameter STAGES = 2\n)(\n    input  clk_i,\n    input  rst_ni,\n    input  en_i,\n    input  serial_i,\n    output r_edge_o,\n    output f_edge_o,\n    output serial_o\n);\n\n    // Synchronizer chain\n    reg [STAGES-1:0] sync_reg;\n    reg              sync_prev;\n\n    // Edge detection registers\n    reg              r_edge_reg;\n    reg              f_edge_reg;\n\n    // Synchronize the asynchronous input\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            sync_reg <= {STAGES{1'b0}};\n        end else begin\n            sync_reg[0] <= serial_i;\n            if (STAGES > 1) begin\n                sync_reg[1] <= sync_reg[0];\n            end\n            if (STAGES > 2) begin\n                sync_reg[2] <= sync_reg[1];\n            end\n            if (STAGES > 3) begin\n                sync_reg[3] <= sync_reg[2];\n            end\n        end\n    end\n\n    // The synchronized output is the last stage of the synchronizer\n    wire sync_bit = sync_reg[STAGES-1];\n\n    // Track the previous value of the synchronized bit for edge detection\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            sync_prev <= 1'b0;\n        end else begin\n            sync_prev <= sync_bit;\n        end\n    end\n\n    // Edge detection\n    wire rising_edge  = sync_bit & ~sync_prev;\n    wire falling_edge = ~sync_bit & sync_prev;\n\n    // Edge outputs gated by enable\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            r_edge_reg <= 1'b0;\n            f_edge_reg <= 1'b0;\n        end else begin\n            r_edge_reg <= en_i & rising_edge;\n            f_edge_reg <= en_i & falling_edge;\n        end\n    end\n\n    assign serial_o = sync_bit;\n    assign r_edge_o = r_edge_reg;\n    assign f_edge_o = f_edge_reg;\n\nendmodule\n```<|im_end|>",
