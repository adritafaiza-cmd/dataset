{
  "text": "```verilog\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Storage\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Source side pointers\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_synced;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_synced_reg;\n\n    // Destination side pointers\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_synced;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_synced_reg;\n\n    // Gray code conversion\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_WIDTH-1:0] gray2bin;\n        input [PTR_WIDTH-1:0] gray;\n        reg [PTR_WIDTH-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source side: write pointer in gray\n    wire [PTR_WIDTH-1:0] src_wr_ptr_gray = bin2gray(src_wr_ptr);\n\n    // Destination side: read pointer in gray\n    wire [PTR_WIDTH-1:0] dst_rd_ptr_gray = bin2gray(dst_rd_ptr);\n\n    // Synchronize src_wr_ptr_gray to dst domain\n    reg [PTR_WIDTH-1:0] src_wr_ptr_gray_sync [0:SYNC_STAGES-1];\n    integer i;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            for (i = 0; i < SYNC_STAGES; i = i + 1)\n                src_wr_ptr_gray_sync[i] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            src_wr_ptr_gray_sync[0] <= src_wr_ptr_gray;\n            for (i = 1; i < SYNC_STAGES; i = i + 1)\n                src_wr_ptr_gray_sync[i] <= src_wr_ptr_gray_sync[i-1];\n        end\n    end\n\n    // Synchronize dst_rd_ptr_gray to src domain\n    reg [PTR_WIDTH-1:0] dst_rd_ptr_gray_sync [0:SYNC_STAGES-1];\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            for (i = 0; i < SYNC_STAGES; i = i + 1)\n                dst_rd_ptr_gray_sync[i] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            dst_rd_ptr_gray_sync[0] <= dst_rd_ptr_gray;\n            for (i = 1; i < SYNC_STAGES; i = i + 1)\n                dst_rd_ptr_gray_sync[i] <= dst_rd_ptr_gray_sync[i-1];\n        end\n    end\n\n    // Convert synchronized gray to binary\n    wire [PTR_WIDTH-1:0] dst_wr_ptr_synced = gray2bin(src_wr_ptr_gray_sync[SYNC_STAGES-1]);\n    wire [PTR_WIDTH-1:0] src_rd_ptr_synced = gray2bin(dst_rd_ptr_gray_sync[SYNC_STAGES-1]);\n\n    // Full/empty detection\n    // FIFO is full when the upper bit of write pointer equals upper bit of read pointer\n    // and the lower LOG_DEPTH bits are equal\n    wire src_full = (src_wr_ptr[PTR_WIDTH-1] == src_rd_ptr_synced[PTR_WIDTH-1]) &&\n                    (src_wr_ptr[LOG_DEPTH-1:0] == src_rd_ptr_synced[LOG_DEPTH-1:0]);\n\n    wire dst_empty = (dst_rd_ptr[PTR_WIDTH-1] == dst_wr_ptr_synced[PTR_WIDTH-1]) &&\n                     (dst_rd_ptr[LOG_DEPTH-1:0] == dst_wr_ptr_synced[LOG_DEPTH-1:0]);\n\n    // Source side logic\n    wire src_write_en = src_valid_i & src_ready_o;\n    assign src_ready_o = ~src_full;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (src_write_en) begin\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n        end\n    end\n\n    // Destination side logic\n    wire dst_read_en = dst_valid_o & dst_ready_i;\n    assign dst_valid_o = ~dst_empty;\n    assign dst_data_o = mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n        end else if (dst_read_en) begin\n            dst_rd_ptr <= dst_rd_ptr + 1'b1;\n        end\n    end\n\nendmodule\n```<|im_end|>",
