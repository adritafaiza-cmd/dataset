  "text": "```verilog\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_WIDTH = LOG_DEPTH + 1;\n\n    // Source side\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_WIDTH-1:0] src_wr_ptr;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_synced;\n    reg [PTR_WIDTH-1:0] src_rd_ptr_gray_synced;\n\n    // Destination side\n    reg [PTR_WIDTH-1:0] dst_rd_ptr;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_synced;\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_gray_synced;\n\n    // Gray code conversion functions\n    function [PTR_WIDTH-1:0] bin2gray;\n        input [PTR_WIDTH-1:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    function [PTR_WIDTH-1:0] gray2bin;\n        input [PTR_WIDTH-1:0] gray;\n        reg [PTR_WIDTH-1:0] bin;\n        integer i;\n        begin\n            bin[PTR_WIDTH-1] = gray[PTR_WIDTH-1];\n            for (i = PTR_WIDTH-2; i >= 0; i = i - 1)\n                bin[i] = gray[i] ^ bin[i+1];\n            gray2bin = bin;\n        end\n    endfunction\n\n    // Source side: write pointer and memory\n    wire src_wr_ptr_gray = bin2gray(src_wr_ptr);\n    wire src_full = (src_wr_ptr_gray == src_rd_ptr_gray_synced) &&\n                    (src_wr_ptr[PTR_WIDTH-1] != src_rd_ptr_synced[PTR_WIDTH-1]);\n    assign src_ready_o = ~src_full;\n\n    wire src_write_en = src_valid_i & src_ready_o;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_wr_ptr <= {PTR_WIDTH{1'b0}};\n        else if (src_write_en)\n            src_wr_ptr <= src_wr_ptr + 1'b1;\n    end\n\n    always @(posedge src_clk_i) begin\n        if (src_write_en)\n            mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n    end\n\n    // Destination side: read pointer\n    wire dst_rd_ptr_gray = bin2gray(dst_rd_ptr);\n    wire dst_empty = (dst_rd_ptr_gray == dst_wr_ptr_gray_synced) &&\n                     (dst_rd_ptr[PTR_WIDTH-1] == dst_wr_ptr_synced[PTR_WIDTH-1]);\n    assign dst_valid_o = ~dst_empty;\n\n    wire dst_read_en = dst_valid_o & dst_ready_i;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_rd_ptr <= {PTR_WIDTH{1'b0}};\n        else if (dst_read_en)\n            dst_rd_ptr <= dst_rd_ptr + 1'b1;\n    end\n\n    assign dst_data_o = mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n\n    // CDC: source write pointer gray -> destination domain\n    reg [PTR_WIDTH-1:0] dst_wr_ptr_gray_sync [0:SYNC_STAGES-1];\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_wr_ptr_gray_sync[0] <= {PTR_WIDTH{1'b0}};\n            dst_wr_ptr_gray_sync[1] <= {PTR_WIDTH{1'b0}};\n            if (SYNC_STAGES > 2) begin\n                integer i;\n                for (i = 2; i < SYNC_STAGES; i = i + 1)\n                    dst_wr_ptr_gray_sync[i] <= {PTR_WIDTH{1'b0}};\n            end\n        end\n        else begin\n            dst_wr_ptr_gray_sync[0] <= src_wr_ptr_gray;\n            dst_wr_ptr_gray_sync[1] <= dst_wr_ptr_gray_sync[0];\n            if (SYNC_STAGES > 2) begin\n                integer i;\n                for (i = 2; i < SYNC_STAGES; i = i + 1)\n                    dst_wr_ptr_gray_sync[i] <= dst_wr_ptr_gray_sync[i-1];\n            end\n        end\n    end\n\n    assign dst_wr_ptr_gray_synced = dst_wr_ptr_gray_sync[SYNC_STAGES-1];\n    assign dst_wr_ptr_synced = gray2bin(dst_wr_ptr_gray_synced);\n\n    // CDC: destination read pointer gray -> source domain\n    reg [PTR_WIDTH-1:0] src_rd_ptr_gray_sync [0:SYNC_STAGES-1];\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_rd_ptr_gray_sync[0] <= {PTR_WIDTH{1'b0}};\n            src_rd_ptr_gray_sync[1] <= {PTR_WIDTH{1'b0}};\n            if (SYNC_STAGES > 2) begin\n                integer i;\n                for (i = 2; i < SYNC_STAGES; i = i + 1)\n                    src_rd_ptr_gray_sync[i] <= {PTR_WIDTH{1'b0}};\n            end\n        end\n        else begin\n            src_rd_ptr_gray_sync[0] <= dst_rd_ptr_gray;\n            src_rd_ptr_gray_sync[1] <= src_rd_ptr_gray_sync[0];\n            if (SYNC_STAGES > 2) begin\n                integer i;\n                for (i = 2; i < SYNC_STAGES; i = i + 1)\n                    src_rd_ptr_gray_sync[i] <= src_rd_ptr_gray_sync[i-1];\n            end\n        end\n    end\n\n    assign src_rd_ptr_gray_synced = src_rd_ptr_gray_sync[SYNC_STAGES-1];\n    assign src_rd_ptr_synced = gray2bin(src_rd_ptr_gray_synced);\n\nendmodule\n```<|im_end|>",
