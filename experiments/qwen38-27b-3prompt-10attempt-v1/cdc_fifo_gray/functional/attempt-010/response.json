  "text": "```verilog\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam PTR_W = LOG_DEPTH + 1;\n\n    // Source domain\n    reg [WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_W-1:0] src_wr_ptr;\n    reg [PTR_W-1:0] dst_rd_ptr_synced;\n\n    // Destination domain\n    reg [PTR_W-1:0] dst_rd_ptr;\n    reg [PTR_W-1:0] src_wr_ptr_synced;\n\n    // Synchronizer registers for write pointer (src -> dst)\n    reg [PTR_W-1:0] wr_ptr_sync [0:SYNC_STAGES-1];\n\n    // Synchronizer registers for read pointer (dst -> src)\n    reg [PTR_W-1:0] rd_ptr_sync [0:SYNC_STAGES-1];\n\n    // Full/Empty flags\n    wire src_full;\n    wire dst_empty;\n\n    // Write enable\n    wire src_wr_en;\n\n    // Read enable\n    wire dst_rd_en;\n\n    // Source domain logic\n    assign src_wr_en = src_valid_i & src_ready_o;\n    assign src_ready_o = ~src_full;\n\n    // Destination domain logic\n    assign dst_rd_en = dst_valid_o & dst_ready_i;\n    assign dst_valid_o = ~dst_empty;\n\n    // Full condition: write pointer has lapped read pointer by DEPTH\n    assign src_full = (src_wr_ptr[PTR_W-1] != dst_rd_ptr_synced[PTR_W-1]) &&\n                      (src_wr_ptr[LOG_DEPTH-1:0] == dst_rd_ptr_synced[LOG_DEPTH-1:0]);\n\n    // Empty condition: read pointer equals write pointer\n    assign dst_empty = (dst_rd_ptr == src_wr_ptr_synced);\n\n    // Write to memory in source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_wr_ptr <= {PTR_W{1'b0}};\n        end else begin\n            if (src_wr_en) begin\n                mem[src_wr_ptr[LOG_DEPTH-1:0]] <= src_data_i;\n                src_wr_ptr <= src_wr_ptr + 1'b1;\n            end\n        end\n    end\n\n    // Read from memory in destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_rd_ptr <= {PTR_W{1'b0}};\n            dst_data_o <= {WIDTH{1'b0}};\n        end else begin\n            if (dst_rd_en) begin\n                dst_rd_ptr <= dst_rd_ptr + 1'b1;\n            end\n            if (!dst_empty) begin\n                dst_data_o <= mem[dst_rd_ptr[LOG_DEPTH-1:0]];\n            end\n        end\n    end\n\n    // Synchronize write pointer from src to dst\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            wr_ptr_sync[0] <= {PTR_W{1'b0}};\n            wr_ptr_sync[1] <= {PTR_W{1'b0}};\n            if (SYNC_STAGES > 2) begin\n                wr_ptr_sync[2] <= {PTR_W{1'b0}};\n            end\n            if (SYNC_STAGES > 3) begin\n                wr_ptr_sync[3] <= {PTR_W{1'b0}};\n            end\n        end else begin\n            wr_ptr_sync[0] <= src_wr_ptr;\n            wr_ptr_sync[1] <= wr_ptr_sync[0];\n            if (SYNC_STAGES > 2) begin\n                wr_ptr_sync[2] <= wr_ptr_sync[1];\n            end\n            if (SYNC_STAGES > 3) begin\n                wr_ptr_sync[3] <= wr_ptr_sync[2];\n            end\n        end\n    end\n\n    assign src_wr_ptr_synced = (SYNC_STAGES == 2) ? wr_ptr_sync[1] :\n                               (SYNC_STAGES == 3) ? wr_ptr_sync[2] :\n                               wr_ptr_sync[3];\n\n    // Synchronize read pointer from dst to src\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            rd_ptr_sync[0] <= {PTR_W{1'b0}};\n            rd_ptr_sync[1] <= {PTR_W{1'b0}};\n            if (SYNC_STAGES > 2) begin\n                rd_ptr_sync[2] <= {PTR_W{1'b0}};\n            end\n            if (SYNC_STAGES > 3) begin\n                rd_ptr_sync[3] <= {PTR_W{1'b0}};\n            end\n        end else begin\n            rd_ptr_sync[0] <= dst_rd_ptr;\n            rd_ptr_sync[1] <= rd_ptr_sync[0];\n            if (SYNC_STAGES > 2) begin\n                rd_ptr_sync[2] <= rd_ptr_sync[1];\n            end\n            if (SYNC_STAGES > 3) begin\n                rd_ptr_sync[3] <= rd_ptr_sync[2];\n            end\n        end\n    end\n\n    assign dst_rd_ptr_synced = (SYNC_STAGES == 2) ? rd_ptr_sync[1] :\n                               (SYNC_STAGES == 3) ? rd_ptr_sync[2] :\n                               rd_ptr_sync[3];\n\nendmodule\n```<|im_end|>",
