{
  "text": "```verilog\nmodule pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Synchronizer registers for the request signal (A -> B)\n    reg [STAGES-1:0] req_sync;\n\n    // Synchronizer registers for the acknowledge signal (B -> A)\n    reg [STAGES-1:0] ack_sync;\n\n    // Internal state in domain A\n    reg req_a;\n    reg ack_a;\n    reg busy_a;\n\n    // Internal state in domain B\n    reg req_b;\n    reg ack_b;\n    reg busy_b;\n\n    // Synchronize request from A to B\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            req_sync <= {STAGES{1'b0}};\n        else\n            req_sync <= {req_sync[STAGES-2:0], req_a};\n    end\n\n    // Synchronize acknowledge from B to A\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            ack_sync <= {STAGES{1'b0}};\n        else\n            ack_sync <= {ack_sync[STAGES-2:0], ack_b};\n    end\n\n    // Domain A logic\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a) begin\n            req_a  <= 1'b0;\n            ack_a  <= 1'b0;\n            busy_a <= 1'b0;\n        end else begin\n            ack_a <= ack_sync[STAGES-1];\n\n            if (busy_a) begin\n                if (ack_a) begin\n                    busy_a <= 1'b0;\n                    req_a  <= 1'b0;\n                end\n            end else begin\n                if (pulseA_i) begin\n                    busy_a <= 1'b1;\n                    req_a  <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Domain B logic\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            req_b  <= 1'b0;\n            ack_b  <= 1'b0;\n            busy_b <= 1'b0;\n        end else begin\n            req_b <= req_sync[STAGES-1];\n\n            if (busy_b) begin\n                if (!req_b) begin\n                    busy_b <= 1'b0;\n                    ack_b  <= 1'b0;\n                end\n            end else begin\n                if (req_b) begin\n                    busy_b <= 1'b1;\n                    ack_b  <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Output pulse in domain B: one cycle when req_b transitions from 0 to 1\n    reg req_b_d;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            req_b_d <= 1'b0;\n        else\n            req_b_d <= req_b;\n    end\n\n    assign pulseB_o = req_b & ~req_b_d;\n    assign busy_o   = busy_b;\n\nendmodule\n```<|im_end|>",
