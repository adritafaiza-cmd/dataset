{
  "text": "```verilog\nmodule pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Synchronizer for pulseA_i into clk_b domain\n    reg [STAGES-1:0] sync_a2b;\n    integer i;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            sync_a2b <= {STAGES{1'b0}};\n        else begin\n            sync_a2b[0] <= pulseA_i;\n            for (i = 1; i < STAGES; i = i + 1)\n                sync_a2b[i] <= sync_a2b[i-1];\n        end\n    end\n\n    // Detect rising edge of synchronized signal\n    reg sync_a2b_d;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            sync_a2b_d <= 1'b0;\n        else\n            sync_a2b_d <= sync_a2b[STAGES-1];\n    end\n\n    wire edge_a2b = sync_a2b[STAGES-1] & ~sync_a2b_d;\n\n    // Busy flag in clk_b domain\n    reg busy_b;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            busy_b <= 1'b0;\n        else if (edge_a2b)\n            busy_b <= 1'b1;\n        else if (pulseB_o)\n            busy_b <= 1'b0;\n    end\n\n    // Generate pulseB_o: one cycle pulse when edge detected and not busy\n    assign pulseB_o = edge_a2b & ~busy_b;\n\n    // Synchronize busy_b back to clk_a domain\n    reg [STAGES-1:0] sync_b2a;\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            sync_b2a <= {STAGES{1'b0}};\n        else begin\n            sync_b2a[0] <= busy_b;\n            for (i = 1; i < STAGES; i = i + 1)\n                sync_b2a[i] <= sync_b2a[i-1];\n        end\n    end\n\n    assign busy_o = sync_b2a[STAGES-1];\n\nendmodule\n```<|im_end|>",
