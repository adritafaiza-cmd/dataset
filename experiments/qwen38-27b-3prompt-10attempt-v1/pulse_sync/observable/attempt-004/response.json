{
  "text": "```verilog\nmodule pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Synchronizer for pulseA_i into clk_b domain\n    reg [STAGES-1:0] sync_reg;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            sync_reg <= {STAGES{1'b0}};\n        else\n            sync_reg <= {sync_reg[STAGES-2:0], pulseA_i};\n    end\n\n    // Detect rising edge of synchronized signal\n    reg sync_prev;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            sync_prev <= 1'b0;\n        else\n            sync_prev <= sync_reg[STAGES-1];\n    end\n\n    wire sync_rise = sync_reg[STAGES-1] & ~sync_prev;\n\n    // Busy flag in clk_b domain\n    reg busy_b;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            busy_b <= 1'b0;\n        else if (sync_rise)\n            busy_b <= 1'b1;\n        else if (pulseB_o)\n            busy_b <= 1'b0;\n    end\n\n    // Generate one-pulse output in clk_b domain\n    reg pulseB_reg;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            pulseB_reg <= 1'b0;\n        else if (sync_rise && !busy_b)\n            pulseB_reg <= 1'b1;\n        else\n            pulseB_reg <= 1'b0;\n    end\n\n    assign pulseB_o = pulseB_reg;\n    assign busy_o   = busy_b;\n\nendmodule\n```<|im_end|>",
