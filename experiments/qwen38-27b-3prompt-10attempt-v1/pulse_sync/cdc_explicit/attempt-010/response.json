{
  "text": "```verilog\nmodule pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Domain A: handshake request\n    reg req_a;\n    reg ack_a;\n    reg ack_a_d1;\n    reg ack_a_d2;\n\n    // Domain B: handshake acknowledge\n    reg ack_b;\n    reg req_b_d1;\n    reg req_b_d2;\n\n    // Synchronize ack from B to A (2 stages)\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a) begin\n            ack_a_d1 <= 1'b0;\n            ack_a_d2 <= 1'b0;\n        end else begin\n            ack_a_d1 <= ack_b;\n            ack_a_d2 <= ack_a_d1;\n        end\n    end\n\n    // Synchronize req from A to B (2 stages)\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            req_b_d1 <= 1'b0;\n            req_b_d2 <= 1'b0;\n        end else begin\n            req_b_d1 <= req_a;\n            req_b_d2 <= req_b_d1;\n        end\n    end\n\n    // Domain A: request generation and clear\n    // req_a is set when pulseA_i is high and not busy\n    // req_a is cleared when ack_a_d2 (synchronized ack) is high\n    wire busy_a = req_a & ~ack_a_d2;\n    wire can_send = !busy_a;\n\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a) begin\n            req_a <= 1'b0;\n        end else begin\n            if (pulseA_i && can_send) begin\n                req_a <= 1'b1;\n            end else if (ack_a_d2) begin\n                req_a <= 1'b0;\n            end\n        end\n    end\n\n    // Domain B: acknowledge generation and clear\n    // ack_b is set when req_b_d2 (synchronized req) is high\n    // ack_b is cleared when req_b_d2 is low (req_a has been cleared)\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            ack_b <= 1'b0;\n        end else begin\n            if (req_b_d2) begin\n                ack_b <= 1'b1;\n            end else begin\n                ack_b <= 1'b0;\n            end\n        end\n    end\n\n    // Generate pulseB_o: one-cycle pulse when req_b_d2 transitions from 0 to 1\n    reg req_b_d2_prev;\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            req_b_d2_prev <= 1'b0;\n        end else begin\n            req_b_d2_prev <= req_b_d2;\n        end\n    end\n\n    assign pulseB_o = req_b_d2 & ~req_b_d2_prev;\n\n    // busy_o is high while a pulse is in flight (req_a is high)\n    assign busy_o = req_a;\n\nendmodule\n```<|im_end|>",
