{
  "text": "```verilog\nmodule pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Domain A: level synchronizer\n    reg [STAGES-1:0] sync_a;\n    reg level_a;\n\n    // Domain B: level synchronizer\n    reg [STAGES-1:0] sync_b;\n    reg level_b;\n    reg level_b_prev;\n\n    // Generate pulse in domain B\n    assign pulseB_o = level_b & ~level_b_prev;\n\n    // Busy signal: high while pulse is in flight (level_b is high)\n    assign busy_o = level_b;\n\n    // Domain A: synchronize pulseA_i into a level\n    // When pulseA_i is high and not busy, set level_a\n    // level_a is cleared when level_b is synchronized back to domain A\n    reg level_a_sync;\n    reg [STAGES-1:0] sync_b_to_a;\n\n    // Synchronize level_b back to domain A\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            sync_b_to_a <= {STAGES{1'b0}};\n        else\n            sync_b_to_a <= {sync_b_to_a[STAGES-2:0], level_b};\n    end\n\n    assign level_a_sync = sync_b_to_a[STAGES-1];\n\n    // Set level_a when pulseA_i is asserted and not busy\n    // Clear level_a when level_b is synchronized back\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            level_a <= 1'b0;\n        else if (pulseA_i && !level_a_sync)\n            level_a <= 1'b1;\n        else if (level_a_sync)\n            level_a <= 1'b0;\n    end\n\n    // Synchronize level_a to domain B\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            sync_b <= {STAGES{1'b0}};\n        else\n            sync_b <= {sync_b[STAGES-2:0], level_a};\n    end\n\n    assign level_b = sync_b[STAGES-1];\n\n    // Track previous level_b for pulse generation\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            level_b_prev <= 1'b0;\n        else\n            level_b_prev <= level_b;\n    end\n\nendmodule\n```<|im_end|>",
