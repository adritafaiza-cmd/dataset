{
  "text": "```verilog\nmodule pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Domain A: handshake request\n    reg req_a;\n    reg ack_a;\n\n    // Domain B: handshake response\n    reg req_b;\n    reg ack_b;\n\n    // Synchronizers\n    reg [STAGES-1:0] req_sync;\n    reg [STAGES-1:0] ack_sync;\n\n    // Generate pulseB_o from req_b edge\n    reg req_b_d;\n    wire pulseB_o = req_b & ~req_b_d;\n\n    // busy_o is high when req_a is asserted (pulse in flight)\n    assign busy_o = req_a;\n\n    // Domain A logic\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a) begin\n            req_a <= 1'b0;\n            ack_a <= 1'b0;\n        end else begin\n            if (pulseA_i && !req_a && !ack_a)\n                req_a <= 1'b1;\n            if (req_a && ack_a) begin\n                req_a <= 1'b0;\n                ack_a <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronize req_a to domain B\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            req_sync <= {STAGES{1'b0}};\n        else\n            req_sync <= {req_sync[STAGES-2:0], req_a};\n    end\n\n    // Domain B logic\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            req_b <= 1'b0;\n            ack_b <= 1'b0;\n            req_b_d <= 1'b0;\n        end else begin\n            req_b <= req_sync[STAGES-1];\n            req_b_d <= req_b;\n\n            if (req_b && !ack_b)\n                ack_b <= 1'b1;\n            if (req_b && ack_b) begin\n                req_b <= 1'b0;\n                ack_b <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronize ack_b to domain A\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            ack_sync <= {STAGES{1'b0}};\n        else\n            ack_sync <= {ack_sync[STAGES-2:0], ack_b};\n    end\n\n    // Update ack_a from synchronized ack_b\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            ack_a <= 1'b0;\n        else\n            ack_a <= ack_sync[STAGES-1];\n    end\n\nendmodule\n```<|im_end|>",
