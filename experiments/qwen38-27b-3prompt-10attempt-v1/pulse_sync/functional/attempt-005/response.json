{
  "text": "```verilog\nmodule pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Domain A: level set on pulse, cleared when domain B acknowledges\n    reg level_a;\n    reg ack_a;\n    reg ack_a_d1;\n    reg ack_a_d2;\n\n    // Domain B: level set when synchronized level_a is high, cleared on pulse\n    reg level_b;\n    reg ack_b;\n    reg ack_b_d1;\n    reg ack_b_d2;\n\n    // Synchronize level_a into domain B\n    reg level_a_sync1;\n    reg level_a_sync2;\n\n    // Synchronize ack_b into domain A\n    reg ack_b_sync1;\n    reg ack_b_sync2;\n\n    // Domain A logic\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a) begin\n            level_a <= 1'b0;\n            ack_a   <= 1'b0;\n        end else begin\n            // Set level_a on pulse if not already busy\n            if (pulseA_i && !level_a)\n                level_a <= 1'b1;\n            // Clear level_a when ack_b is synchronized back\n            if (ack_b_sync2)\n                level_a <= 1'b0;\n        end\n    end\n\n    // Synchronize ack_b into domain A\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a) begin\n            ack_b_sync1 <= 1'b0;\n            ack_b_sync2 <= 1'b0;\n        end else begin\n            ack_b_sync1 <= ack_b;\n            ack_b_sync2 <= ack_b_sync1;\n        end\n    end\n\n    // Synchronize level_a into domain B\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            level_a_sync1 <= 1'b0;\n            level_a_sync2 <= 1'b0;\n        end else begin\n            level_a_sync1 <= level_a;\n            level_a_sync2 <= level_a_sync1;\n        end\n    end\n\n    // Domain B logic\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            level_b <= 1'b0;\n            ack_b   <= 1'b0;\n        end else begin\n            // Set level_b when synchronized level_a is high\n            if (level_a_sync2 && !level_b)\n                level_b <= 1'b1;\n            // Clear level_b and set ack_b when level_b is high (pulse out)\n            if (level_b) begin\n                level_b <= 1'b0;\n                ack_b   <= 1'b1;\n            end\n            // Clear ack_b when level_b is low and ack_b was set\n            if (!level_b && ack_b)\n                ack_b   <= 1'b0;\n        end\n    end\n\n    // Outputs\n    assign pulseB_o = level_b;\n    assign busy_o   = level_a;\n\nendmodule\n```<|im_end|>",
