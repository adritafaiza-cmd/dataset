  "text": "```verilog\nmodule wbxclk #(\n\tparameter\tAW=32,\n\t\t\tDW=32,\n\t\t\tLGFIFO = 5\n\t) (\n\tinput\twire\t\t\ti_wb_clk, i_reset,\n\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\toutput\twire\t\t\to_wb_stall,\n\toutput\treg\t\t\to_wb_ack,\n\toutput\treg\t[(DW/8-1):0]\to_wb_data,\n\toutput\treg\t\t\to_wb_err,\n\tinput\twire\t\t\ti_xclk_clk,\n\toutput\treg\t\t\to_xclk_cyc,\n\toutput\treg\t\t\to_xclk_stb,\n\toutput\treg\t\t\to_xclk_we,\n\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\tinput\twire\t\t\ti_xclk_stall,\n\tinput\twire\t\t\ti_xclk_ack,\n\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\tinput\twire\t[(DW/8-1):0]\ti_xclk_err\n\t);\n\n\t// FIFO depth\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_ADDR_W = LGFIFO;\n\n\t// Request FIFO (Wishbone side -> XCLK side)\n\t// Store: cyc, stb, we, addr, data, sel\n\tlocalparam REQ_W = 1 + 1 + 1 + AW + DW + DW/8;\n\n\treg [REQ_W-1:0] req_fifo_mem [0:FIFO_DEPTH-1];\n\treg [FIFO_ADDR_W:0] req_wr_ptr, req_rd_ptr;\n\treg [FIFO_ADDR_W:0] req_count;\n\n\t// Response FIFO (XCLK side -> Wishbone side)\n\t// Store: data, err\n\tlocalparam RSP_W = DW + 1;\n\n\treg [RSP_W-1:0] rsp_fifo_mem [0:FIFO_DEPTH-1];\n\treg [FIFO_ADDR_W:0] rsp_wr_ptr, rsp_rd_ptr;\n\treg [FIFO_ADDR_W:0] rsp_count;\n\n\t// Request FIFO full/empty\n\twire req_full = (req_count == FIFO_DEPTH);\n\twire req_empty = (req_count == 0);\n\n\t// Response FIFO full/empty\n\twire rsp_full = (rsp_count == FIFO_DEPTH);\n\twire rsp_empty = (rsp_count == 0);\n\n\t// o_wb_stall is the outstanding-request count\n\tassign o_wb_stall = (req_count != 0);\n\n\t// Wishbone side: accept request when not full\n\twire wb_accept = i_wb_cyc && i_wb_stb && !req_full;\n\n\t// Write to request FIFO on wb_clk\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr <= 0;\n\t\t\treq_rd_ptr <= 0;\n\t\t\treq_count <= 0;\n\t\tend else begin\n\t\t\tif (wb_accept) begin\n\t\t\t\treq_fifo_mem[req_wr_ptr[FIFO_ADDR_W-1:0]] <= {i_wb_cyc, i_wb_stb, i_wb_we, i_wb_addr, i_wb_data, i_wb_sel};\n\t\t\t\treq_wr_ptr <= req_wr_ptr + 1;\n\t\t\tend\n\t\t\tif (!req_empty && !i_xclk_stall) begin\n\t\t\t\treq_rd_ptr <= req_rd_ptr + 1;\n\t\t\tend\n\t\t\tif (wb_accept && (!req_empty || i_xclk_stall)) begin\n\t\t\t\t// both write and read happen\n\t\t\t\tif (!req_empty && !i_xclk_stall) begin\n\t\t\t\t\treq_count <= req_count; // net zero\n\t\t\t\tend else begin\n\t\t\t\t\treq_count <= req_count + 1;\n\t\t\t\tend\n\t\t\tend else if (wb_accept) begin\n\t\t\t\treq_count <= req_count + 1;\n\t\t\tend else if (!req_empty && !i_xclk_stall) begin\n\t\t\t\treq_count <= req_count - 1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// XCLK side: read from request FIFO\n\t// We need to synchronize the read pointer and data across clock domains.\n\t// Use a simple approach: the XCLK side reads when it has capacity and the FIFO is not empty.\n\t// We need to detect non-empty in XCLK domain. Use a Gray-coded pointer or a simple sync.\n\n\t// For simplicity and correctness with independent clocks, use Gray-coded pointers for CDC.\n\t// Let's redo with Gray-coded pointers.\n\n\t// Actually, let's use a simpler approach: since this is a bridge, we can use a\n\t// handshake-based FIFO with Gray-coded pointers for CDC.\n\n\t// Let me restructure with proper Gray-coded FIFO pointers.\n\n\t// Request FIFO with Gray-coded pointers\n\treg [FIFO_ADDR_W:0] req_wr_ptr_gray, req_rd_ptr_gray;\n\treg [FIFO_ADDR_W:0] req_wr_ptr_gray_sync1, req_wr_ptr_gray_sync2;\n\treg [FIFO_ADDR_W:0] req_rd_ptr_gray_sync1, req_rd_ptr_gray_sync2;\n\n\t// Convert binary to Gray\n\tfunction [FIFO_ADDR_W:0] bin2gray;\n\t\tinput [FIFO_ADDR_W:0] bin;\n\t\tbegin\n\t\t\tbin2gray = bin ^ (bin >> 1);\n\t\tend\n\tendfunction\n\n\t// Response FIFO with Gray-coded pointers\n\treg [FIFO_ADDR_W:0] rsp_wr_ptr_gray, rsp_rd_ptr_gray;\n\treg [FIFO_ADDR_W:0] rsp_wr_ptr_gray_sync1, rsp_wr_ptr_gray_sync2;\n\treg [FIFO_ADDR_W:0] rsp_rd_ptr_gray_sync1, rsp_rd_ptr_gray_sync2;\n\n\t// Request FIFO: write side (wb_clk)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr <= 0;\n\t\t\treq_wr_ptr_gray <= 0;\n\t\tend else if (wb_accept) begin\n\t\t\treq_wr_ptr <= req_wr_ptr + 1;\n\t\t\treq_wr_ptr_gray <= bin2gray(req_wr_ptr + 1);\n\t\tend\n\tend\n\n\t// Request FIFO: read side (xclk_clk)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr <= 0;\n\t\t\treq_rd_ptr_gray <= 0;\n\t\tend else if (!req_empty_xclk && !i_xclk_stall) begin\n\t\t\treq_rd_ptr <= req_rd_ptr + 1;\n\t\t\treq_rd_ptr_gray <= bin2gray(req_rd_ptr + 1);\n\t\tend\n\tend\n\n\t// Synchronize req_wr_ptr_gray to xclk domain\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr_gray_sync1 <= 0;\n\t\t\treq_wr_ptr_gray_sync2 <= 0;\n\t\tend else begin\n\t\t\treq_wr_ptr_gray_sync1 <= req_wr_ptr_gray;\n\t\t\treq_wr_ptr_gray_sync2 <= req_wr_ptr_gray_sync1;\n\t\tend\n\tend\n\n\t// Synchronize req_rd_ptr_gray to wb domain\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr_gray_sync1 <= 0;\n\t\t\treq_rd_ptr_gray_sync2 <= 0;\n\t\tend else begin\n\t\t\treq_rd_ptr_gray_sync1 <= req_rd_ptr_gray;\n\t\t\treq_rd_ptr_gray_sync2 <= req_rd_ptr_gray_sync1;\n\t\tend\n\tend\n\n\t// Compute req_count in wb domain (for o_wb_stall)\n\twire [FIFO_ADDR_W:0] req_wr_ptr_bin_sync = req_wr_ptr; // local\n\twire [FIFO_ADDR_W:0] req_rd_ptr_bin_sync = req_rd_ptr_gray_sync2; // This is Gray, need to convert\n\n\t// Actually, let's compute count differently. Use the Gray pointers to determine full/empty.\n\t// For a FIFO with depth 2^N, full when wr_gray == rd_gray with MSB different (for 2^N depth)\n\t// Empty when wr_gray == rd_gray\n\n\t// Let's use a simpler approach: track count in each domain separately with careful CDC.\n\n\t// I'll use a different strategy: use a simple 2-flop synchronizer for a \"valid\" signal\n\t// and use a handshake protocol.\n\n\t// Let me restart with a cleaner design using a standard async FIFO with Gray-coded pointers.\n\n\t// Request FIFO\n\treg [FIFO_ADDR_W:0] req_wr_ptr_bin, req_rd_ptr_bin;\n\treg [FIFO_ADDR_W:0] req_wr_ptr_g, req_rd_ptr_g;\n\n\t// Write side (wb_clk)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr_bin <= 0;\n\t\t\treq_wr_ptr_g <= 0;\n\t\tend else if (wb_accept) begin\n\t\t\treq_wr_ptr_bin <= req_wr_ptr_bin + 1;\n\t\t\treq_wr_ptr_g <= bin2gray(req_wr_ptr_bin + 1);\n\t\tend\n\tend\n\n\t// Read side (xclk_clk)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr_bin <= 0;\n\t\t\treq_rd_ptr_g <= 0;\n\t\tend else if (!req_empty_xclk && !i_xclk_stall) begin\n\t\t\treq_rd_ptr_bin <= req_rd_ptr_bin + 1;\n\t\t\treq_rd_ptr_g <= bin2gray(req_rd_ptr_bin + 1);\n\t\tend\n\tend\n\n\t// Sync wr_ptr_g to xclk\n\treg [FIFO_ADDR_W:0] req_wr_g_s1, req_wr_g_s2;\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_g_s1 <= 0;\n\t\t\treq_wr_g_s2 <= 0;\n\t\tend else begin\n\t\t\treq_wr_g_s1 <= req_wr_ptr_g;\n\t\t\treq_wr_g_s2 <= req_wr_g_s1;\n\t\tend\n\tend\n\n\t// Sync rd_ptr_g to wb\n\treg [FIFO_ADDR_W:0] req_rd_g_s1, req_rd_g_s2;\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_g_s1 <= 0;\n\t\t\treq_rd_g_s2 <= 0;\n\t\tend else begin\n\t\t\treq_rd_g_s1 <= req_rd_ptr_g;\n\t\t\treq_rd_g_s2 <= req_rd_g_s1;\n\t\tend\n\tend\n\n\t// Determine empty in xclk domain\n\twire req_empty_xclk = (req_wr_g_s2 == req_rd_ptr_g);\n\n\t// Determine full in wb domain\n\t// Full when wr_g and rd_g differ only in the top bit (for 2^N depth)\n\twire req_full_wb = (req_wr_ptr_g == {~req_rd_g_s2[FIFO_ADDR_W], req_rd_g_s2[FIFO_ADDR_W-1:0]});\n\n\t// o_wb_stall: outstanding request count > 0\n\t// We can use: not empty in wb domain\n\twire req_not_empty_wb = (req_wr_ptr_g != req_rd_g_s2);\n\tassign o_wb_stall = req_not_empty_wb;\n\n\t// Read data from request FIFO in xclk domain\n\twire [REQ_W-1:0] req_rd_data = req_fifo_mem[req_rd_ptr_bin[FIFO_ADDR_W-1:0]];\n\n\t// XCLK side outputs\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend else if (!req_empty_xclk && !i_xclk_stall) begin\n\t\t\to_xclk_cyc <= req_rd_data[REQ_W-1];\n\t\t\to_xclk_stb <= req_rd_data[REQ_W-2];\n\t\t\to_xclk_we <= req_rd_data[REQ_W-3];\n\t\t\to_xclk_addr <= req_rd_data[REQ_W-3-1:AW];\n\t\t\to_xclk_data <= req_rd_data[AW-1:DW];\n\t\t\to_xclk_sel <= req_rd_data[DW-1:0];\n\t\tend\n\tend\n\n\t// Response FIFO: write side (xclk_clk)\n\twire xclk_ack_valid = i_xclk_ack;\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_wr_ptr_bin <= 0;\n\t\t\trsp_wr_ptr_g <= 0;\n\t\tend else if (xclk_ack_valid && !rsp_full_xclk) begin\n\t\t\trsp_fifo_mem[rsp_wr_ptr_bin[FIFO_ADDR_W-1:0]] <= {i_xclk_data, i_xclk_err};\n\t\t\trsp_wr_ptr_bin <= rsp_wr_ptr_bin + 1;\n\t\t\trsp_wr_ptr_g <= bin2gray(rsp_wr_ptr_bin + 1);\n\t\tend\n\tend\n\n\t// Response FIFO: read side (wb_clk)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_rd_ptr_bin <= 0;\n\t\t\trsp_rd_ptr_g <= 0;\n\t\tend else if (!rsp_empty_wb) begin\n\t\t\trsp_rd_ptr_bin <= rsp_rd_ptr_bin + 1;\n\t\t\trsp_rd_ptr_g <= bin2gray(rsp_rd_ptr_bin + 1);\n\t\tend\n\tend\n\n\t// Sync rsp_wr_ptr_g to wb\n\treg [FIFO_ADDR_W:0] rsp_wr_g_s1, rsp_wr_g_s2;\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_wr_g_s1 <= 0;\n\t\t\trsp_wr_g_s2 <= 0;\n\t\tend else begin\n\t\t\trsp_wr_g_s1 <= rsp_wr_ptr_g;\n\t\t\trsp_wr_g_s2 <= rsp_wr_g_s1;\n\t\tend\n\tend\n\n\t// Sync rsp_rd_ptr_g to xclk\n\treg [FIFO_ADDR_W:0] rsp_rd_g_s1, rsp_rd_g_s2;\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_rd_g_s1 <= 0;\n\t\t\trsp_rd_g_s2 <= 0;\n\t\tend else begin\n\t\t\trsp_rd_g_s1 <= rsp_rd_ptr_g;\n\t\t\trsp_rd_g_s2 <= rsp_rd_g_s1;\n\t\tend\n\tend\n\n\t// Determine empty in wb domain\n\twire rsp_empty_wb = (rsp_wr_g_s2 == rsp_rd_ptr_g);\n\n\t// Determine full in xclk domain\n\twire rsp_full_xclk = (rsp_wr_ptr_g == {~rsp_rd_g_s2[FIFO_ADDR_W], rsp_rd_g_s2[FIFO_ADDR_W-1:0]});\n\n\t// Read data from response FIFO in wb domain\n\twire [RSP_W-1:0] rsp_rd_data = rsp_fifo_mem[rsp_rd_ptr_bin[FIFO_ADDR_W-1:0]];\n\n\t// Wishbone side outputs\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend else if (!rsp_empty_wb) begin\n\t\t\to_wb_ack <= 1;\n\t\t\to_wb_data <= rsp_rd_data[RSP_W-1:1];\n\t\t\to_wb_err <= rsp_rd_data[0];\n\t\tend else begin\n\t\t\to_wb_ack <= 0;\n\t\tend\n\tend\n\n\t// Declare the response FIFO pointers\n\treg [FIFO_ADDR_W:0] rsp_wr_ptr_bin, rsp_rd_ptr_bin;\n\treg [FIFO_ADDR_W:0] rsp_wr_ptr_g, rsp_rd_ptr_g;\n\nendmodule\n```<|im_end|>",
