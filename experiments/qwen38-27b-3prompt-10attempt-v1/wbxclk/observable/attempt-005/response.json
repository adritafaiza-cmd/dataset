  "text": "```verilog\nmodule wbxclk #(\n\tparameter\tAW=32,\n\t\t\tDW=32,\n\t\t\tLGFIFO = 5\n) (\n\tinput\twire\t\t\ti_wb_clk, i_reset,\n\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\toutput\twire\t\t\to_wb_stall,\n\toutput\treg\t\t\to_wb_ack,\n\toutput\treg\t[(DW/1):0]\to_wb_data,\n\toutput\treg\t\t\to_wb_err,\n\tinput\twire\t\t\ti_xclk_clk,\n\toutput\treg\t\t\to_xclk_cyc,\n\toutput\treg\t\t\to_xclk_stb,\n\toutput\treg\t\t\to_xclk_we,\n\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\tinput\twire\t\t\ti_xclk_stall,\n\tinput\twire\t\t\ti_xclk_ack,\n\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\tinput\twire\t\t\ti_xclk_err\n);\n\n\t// FIFO depth\n\tlocalparam FIFO_DEPTH = 2**LGFIFO;\n\tlocalparam FIFO_ADDR_W = LGFIFO;\n\n\t// Request FIFO (Wishbone -> xclk)\n\treg\t[(DW+AW+DW/8+1)-1:0] req_fifo [0:FIFO_DEPTH-1];\n\treg\t[FIFO_ADDR_W-1:0] req_wr_ptr, req_rd_ptr;\n\treg\t[FIFO_ADDR_W:0] req_count;\n\n\t// Response FIFO (xclk -> Wishbone)\n\treg\t[(DW+1)-1:0] rsp_fifo [0:FIFO_DEPTH-1];\n\treg\t[FIFO_ADDR_W-1:0] rsp_wr_ptr, rsp_rd_ptr;\n\treg\t[FIFO_ADDR_W:0] rsp_count;\n\n\t// Request FIFO write (Wishbone clock domain)\n\twire req_wr_en = i_wb_cyc && i_wb_stb && (req_count < FIFO_DEPTH);\n\twire req_full = (req_count == FIFO_DEPTH);\n\n\t// Request FIFO read (xclk clock domain)\n\twire req_rd_en = (req_count > 0) && !i_xclk_stall && !o_xclk_cyc;\n\twire req_empty = (req_count == 0);\n\n\t// Response FIFO write (xclk clock domain)\n\twire rsp_wr_en = i_xclk_ack;\n\twire rsp_full = (rsp_count == FIFO_DEPTH);\n\n\t// Response FIFO read (Wishbone clock domain)\n\twire rsp_rd_en = (rsp_count > 0) && !o_wb_ack;\n\twire rsp_empty = (rsp_count == 0);\n\n\t// Request FIFO write data\n\twire [(DW+AW+DW/8+1)-1:0] req_wr_data = {i_wb_we, i_wb_addr, i_wb_data, i_wb_sel};\n\n\t// Request FIFO read data\n\twire [(DW+AW+DW/8+1)-1:0] req_rd_data = req_fifo[req_rd_ptr];\n\twire req_we = req_rd_data[DW+AW+DW/8];\n\twire [(AW-1):0] req_addr = req_rd_data[DW+AW+DW/8-1:DW+DW/8];\n\twire [(DW-1):0] req_data = req_rd_data[DW+DW/8-1:DW/8];\n\twire [(DW/8-1):0] req_sel = req_rd_data[DW/8-1:0];\n\n\t// Response FIFO write data\n\twire [(DW+1)-1:0] rsp_wr_data = {i_xclk_err, i_xclk_data};\n\n\t// Response FIFO read data\n\twire [(DW+1)-1:0] rsp_rd_data = rsp_fifo[rsp_rd_ptr];\n\twire rsp_err = rsp_rd_data[DW];\n\twire [(DW-1):0] rsp_data = rsp_rd_data[DW-1:0];\n\n\t// Request FIFO write pointer (Wishbone clock)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\treq_wr_ptr <= {FIFO_ADDR_W{1'b0}};\n\t\telse if (req_wr_en)\n\t\t\treq_wr_ptr <= req_wr_ptr + 1'b1;\n\tend\n\n\t// Request FIFO read pointer (xclk clock)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\treq_rd_ptr <= {FIFO_ADDR_W{1'b0}};\n\t\telse if (req_rd_en)\n\t\t\treq_rd_ptr <= req_rd_ptr + 1'b1;\n\tend\n\n\t// Request FIFO count (synchronous to each clock for its side)\n\t// We need a single count that is updated in both domains.\n\t// Use a Gray-coded pointer approach or a simple counter with CDC.\n\t// For simplicity, use a counter that is incremented in WB domain and decremented in xclk domain.\n\t// This requires careful handling. Let's use a different approach:\n\t// Maintain count in a register that is updated in both domains.\n\t// Actually, let's use a standard async FIFO with Gray-coded pointers.\n\n\t// Let me redo this with proper Gray-coded async FIFO.\n\n\t// Gray code conversion\n\tfunction [FIFO_ADDR_W:0] bin2gray;\n\t\tinput [FIFO_ADDR_W:0] bin;\n\t\tbegin\n\t\t\tbin2gray = bin ^ (bin >> 1);\n\t\tend\n\tendfunction\n\n\tfunction [FIFO_ADDR_W:0] gray2bin;\n\t\tinput [FIFO_ADDR_W:0] gray;\n\t\treg [FIFO_ADDR_W:0] bin;\n\t\tbegin\n\t\t\tbin[FIFO_ADDR_W] = gray[FIFO_ADDR_W];\n\t\t\tfor (i = FIFO_ADDR_W-1; i >= 0; i = i - 1)\n\t\t\t\tbin[i] = gray[i] ^ bin[i+1];\n\t\tend\n\tendfunction\n\n\t// Request FIFO Gray-coded pointers\n\treg [FIFO_ADDR_W:0] req_wr_ptr_gray, req_rd_ptr_gray;\n\treg [FIFO_ADDR_W:0] req_wr_ptr_gray_sync, req_rd_ptr_gray_sync;\n\n\t// Response FIFO Gray-coded pointers\n\treg [FIFO_ADDR_W:0] rsp_wr_ptr_gray, rsp_rd_ptr_gray;\n\treg [FIFO_ADDR_W:0] rsp_wr_ptr_gray_sync, rsp_rd_ptr_gray_sync;\n\n\t// Request FIFO write pointer (Wishbone clock)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\treq_wr_ptr_gray <= {FIFO_ADDR_W+1{1'b0}};\n\t\telse if (req_wr_en)\n\t\t\treq_wr_ptr_gray <= req_wr_ptr_gray + 1'b1;\n\tend\n\n\t// Request FIFO read pointer (xclk clock)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\treq_rd_ptr_gray <= {FIFO_ADDR_W+1{1'b0}};\n\t\telse if (req_rd_en)\n\t\t\treq_rd_ptr_gray <= req_rd_ptr_gray + 1'b1;\n\tend\n\n\t// Synchronize request write pointer to xclk domain\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\treq_wr_ptr_gray_sync <= {FIFO_ADDR_W+1{1'b0}};\n\t\telse\n\t\t\treq_wr_ptr_gray_sync <= req_wr_ptr_gray;\n\tend\n\n\t// Synchronize request read pointer to WB domain\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\treq_rd_ptr_gray_sync <= {FIFO_ADDR_W+1{1'b0}};\n\t\telse\n\t\t\treq_rd_ptr_gray_sync <= req_rd_ptr_gray;\n\tend\n\n\t// Request FIFO full/empty\n\twire req_full_gray = (req_wr_ptr_gray == req_rd_ptr_gray_sync) && \n\t                     (req_wr_ptr_gray[FIFO_ADDR_W] != req_rd_ptr_gray_sync[FIFO_ADDR_W]);\n\twire req_empty_gray = (req_wr_ptr_gray_sync == req_rd_ptr_gray);\n\n\t// Response FIFO write pointer (xclk clock)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\trsp_wr_ptr_gray <= {FIFO_ADDR_W+1{1'b0}};\n\t\telse if (rsp_wr_en)\n\t\t\trsp_wr_ptr_gray <= rsp_wr_ptr_gray + 1'b1;\n\tend\n\n\t// Response FIFO read pointer (Wishbone clock)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\trsp_rd_ptr_gray <= {FIFO_ADDR_W+1{1'b0}};\n\t\telse if (rsp_rd_en)\n\t\t\trsp_rd_ptr_gray <= rsp_rd_ptr_gray + 1'b1;\n\tend\n\n\t// Synchronize response write pointer to WB domain\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\trsp_wr_ptr_gray_sync <= {FIFO_ADDR_W+1{1'b0}};\n\t\telse\n\t\t\trsp_wr_ptr_gray_sync <= rsp_wr_ptr_gray;\n\tend\n\n\t// Synchronize response read pointer to xclk domain\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\trsp_rd_ptr_gray_sync <= {FIFO_ADDR_W+1{1'b0}};\n\t\telse\n\t\t\trsp_rd_ptr_gray_sync <= rsp_rd_ptr_gray;\n\tend\n\n\t// Response FIFO full/empty\n\twire rsp_full_gray = (rsp_wr_ptr_gray == rsp_rd_ptr_gray_sync) && \n\t                     (rsp_wr_ptr_gray[FIFO_ADDR_W] != rsp_rd_ptr_gray_sync[FIFO_ADDR_W]);\n\twire rsp_empty_gray = (rsp_wr_ptr_gray_sync == rsp_rd_ptr_gray);\n\n\t// Update FIFO storage\n\t// Request FIFO write (Wishbone clock)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\t;\n\t\telse if (req_wr_en)\n\t\t\treq_fifo[req_wr_ptr_gray[FIFO_ADDR_W-1:0]] <= req_wr_data;\n\tend\n\n\t// Response FIFO write (xclk clock)\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset)\n\t\t\t;\n\t\telse if (rsp_wr_en)\n\t\t\trsp_fifo[rsp_wr_ptr_gray[FIFO_ADDR_W-1:0]] <= rsp_wr_data;\n\tend\n\n\t// xclk side: drive request\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_xclk_cyc <= 1'b0;\n\t\t\to_xclk_stb <= 1'b0;\n\t\t\to_xclk_we <= 1'b0;\n\t\t\to_xclk_addr <= {AW{1'b0}};\n\t\t\to_xclk_data <= {DW{1'b0}};\n\t\t\to_xclk_sel <= {(DW/8){1'b0}};\n\t\tend else begin\n\t\t\tif (o_xclk_cyc) begin\n\t\t\t\tif (i_xclk_ack) begin\n\t\t\t\t\to_xclk_cyc <= 1'b0;\n\t\t\t\t\to_xclk_stb <= 1'b0;\n\t\t\t\tend\n\t\t\tend else if (!req_empty_gray && !i_xclk_stall) begin\n\t\t\t\to_xclk_cyc <= 1'b1;\n\t\t\t\to_xclk_stb <= 1'b1;\n\t\t\t\to_xclk_we <= req_we;\n\t\t\t\to_xclk_addr <= req_addr;\n\t\t\t\to_xclk_data <= req_data;\n\t\t\t\to_xclk_sel <= req_sel;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Wishbone side: drive response\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_wb_ack <= 1'b0;\n\t\t\to_wb_data <= {DW{1'b0}};\n\t\t\to_wb_err <= 1'b0;\n\t\tend else begin\n\t\t\tif (o_wb_ack) begin\n\t\t\t\to_wb_ack <= 1'b0;\n\t\t\tend else if (!rsp_empty_gray) begin\n\t\t\t\to_wb_ack <= 1'b1;\n\t\t\t\to_wb_data <= rsp_data;\n\t\t\t\to_wb_err <= rsp_err;\n\t\t\tend\n\t\tend\n\tend\n\n\t// o_wb_stall is the outstanding request count\n\t// Convert Gray to binary for count\n\twire [FIFO_ADDR_W:0] req_wr_bin = gray2bin(req_wr_ptr_gray);\n\twire [FIFO_ADDR_W:0] req_rd_bin_sync = gray2bin(req_rd_ptr_gray_sync);\n\twire [FIFO_ADDR_W:0] req_count_bin = req_wr_bin - req_rd_bin_sync;\n\n\tassign o_wb_stall = (req_count_bin > 0);\n\nendmodule\n```<|im_end|>",
