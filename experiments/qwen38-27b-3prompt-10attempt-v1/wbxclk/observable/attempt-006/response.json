  "text": "```verilog\nmodule wbxclk #(\n\tparameter\tAW=32,\n\t\t\tDW=32,\n\t\t\tLGFIFO = 5\n) (\n\tinput\twire\t\t\ti_wb_clk, i_reset,\n\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\toutput\twire\t\t\to_wb_stall,\n\toutput\treg\t\t\to_wb_ack,\n\toutput\treg\t[(DW/8-1):0]\to_wb_data,\n\toutput\treg\t\t\to_wb_err,\n\tinput\twire\t\t\ti_xclk_clk,\n\toutput\treg\t\t\to_xclk_cyc,\n\toutput\treg\t\t\to_xclk_stb,\n\toutput\treg\t\t\to_xclk_we,\n\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\tinput\twire\t\t\ti_xclk_stall,\n\tinput\twire\t\t\ti_xclk_ack,\n\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\tinput\twire\t[(DW-8-1):0]\ti_xclk_err\n);\n\n\t// FIFO depth\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_WIDTH = AW + DW + (DW/8) + 1; // addr + data + sel + we\n\n\t// Request FIFO: WB side writes, XCLK side reads\n\treg [FIFO_WIDTH-1:0] req_fifo [0:FIFO_DEPTH-1];\n\treg [LGFIFO:0] req_wr_ptr, req_rd_ptr;\n\treg [LGFIFO:0] req_count;\n\n\t// Response FIFO: XCLK side writes, WB side reads\n\treg [DW+1:0] rsp_fifo [0:FIFO_DEPTH-1]; // data + err\n\treg [LGFIFO:0] rsp_wr_ptr, rsp_rd_ptr;\n\treg [LGFIFO:0] rsp_count;\n\n\t// WB side: request valid\n\twire req_valid = i_wb_cyc && i_wb_stb;\n\twire req_full = (req_count == FIFO_DEPTH);\n\twire req_can_write = req_valid && !req_full;\n\n\t// XCLK side: request read\n\twire req_empty = (req_count == 0);\n\twire req_can_read = !req_empty && !i_xclk_stall;\n\n\t// WB side: response read\n\twire rsp_empty = (rsp_count == 0);\n\twire rsp_can_read = !rsp_empty;\n\n\t// XCLK side: response write\n\twire rsp_full = (rsp_count == FIFO_DEPTH);\n\twire rsp_can_write = i_xclk_ack && !rsp_full;\n\n\t// o_wb_stall is the outstanding-request count\n\tassign o_wb_stall = (req_count != 0);\n\n\t// WB clock domain: request FIFO write\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr <= 0;\n\t\t\treq_count <= 0;\n\t\tend else begin\n\t\t\tif (req_can_write) begin\n\t\t\t\treq_fifo[req_wr_ptr[LGFIFO-1:0]] <= {i_wb_addr, i_wb_data, i_wb_sel, i_wb_we};\n\t\t\t\treq_wr_ptr <= req_wr_ptr + 1;\n\t\t\tend\n\t\t\tif (req_can_read) begin\n\t\t\t\treq_count <= req_count - 1;\n\t\t\tend\n\t\t\tif (req_can_write && req_can_read) begin\n\t\t\t\t// both happen, count stays same\n\t\t\tend else if (req_can_write) begin\n\t\t\t\treq_count <= req_count + 1;\n\t\t\tend else if (req_can_read) begin\n\t\t\t\treq_count <= req_count - 1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// WB clock domain: response FIFO read\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_rd_ptr <= 0;\n\t\t\trsp_count <= 0;\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend else begin\n\t\t\tif (rsp_can_read) begin\n\t\t\t\to_wb_ack <= 1;\n\t\t\t\to_wb_data <= rsp_fifo[rsp_rd_ptr[LGFIFO-1:0]][DW:1];\n\t\t\t\to_wb_err <= rsp_fifo[rsp_rd_ptr[LGFIFO-1:0]][0];\n\t\t\t\trsp_rd_ptr <= rsp_rd_ptr + 1;\n\t\t\t\trsp_count <= rsp_count - 1;\n\t\t\tend else begin\n\t\t\t\to_wb_ack <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// XCLK clock domain: request FIFO read\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr <= 0;\n\t\t\treq_count <= 0;\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend else begin\n\t\t\tif (req_can_read) begin\n\t\t\t\to_xclk_cyc <= 1;\n\t\t\t\to_xclk_stb <= 1;\n\t\t\t\to_xclk_we <= req_fifo[req_rd_ptr[LGFIFO-1:0]][0];\n\t\t\t\to_xclk_sel <= req_fifo[req_rd_ptr[LGFIFO-1:0]][DW+1:DW+2];\n\t\t\t\to_xclk_data <= req_fifo[req_rd_ptr[LGFIFO-1:0]][DW+DW+1:DW+2];\n\t\t\t\to_xclk_addr <= req_fifo[req_rd_ptr[LGFIFO-1:0]][FIFO_WIDTH-1:DW+DW+2];\n\t\t\t\treq_rd_ptr <= req_rd_ptr + 1;\n\t\t\t\treq_count <= req_count - 1;\n\t\t\tend else begin\n\t\t\t\to_xclk_cyc <= 0;\n\t\t\t\to_xclk_stb <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// XCLK clock domain: response FIFO write\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_wr_ptr <= 0;\n\t\t\trsp_count <= 0;\n\t\tend else begin\n\t\t\tif (rsp_can_write) begin\n\t\t\t\trsp_fifo[rsp_wr_ptr[LGFIFO-1:0]] <= {i_xclk_data, i_xclk_err};\n\t\t\t\trsp_wr_ptr <= rsp_wr_ptr + 1;\n\t\t\t\trsp_count <= rsp_count + 1;\n\t\t\tend\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
