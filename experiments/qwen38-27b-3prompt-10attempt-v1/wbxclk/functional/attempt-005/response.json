  "text": "```verilog\nmodule wbxclk #(\n\tparameter\tAW=32,\n\t\t\tDW=32,\n\t\t\tLGFIFO = 5\n) (\n\tinput\twire\t\t\ti_wb_clk, i_reset,\n\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\toutput\twire\t\t\to_wb_stall,\n\toutput\treg\t\t\to_wb_ack,\n\toutput\treg\t[(DW-1):0]\to_wb_data,\n\toutput\treg\t\t\to_wb_err,\n\tinput\twire\t\t\ti_xclk_clk,\n\toutput\treg\t\t\to_xclk_cyc,\n\toutput\treg\t\t\to_xclk_stb,\n\toutput\treg\t\t\to_xclk_we,\n\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\tinput\twire\t\t\ti_xclk_stall,\n\tinput\twire\t\t\ti_xclk_ack,\n\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\tinput\twire\t[(DW/8-1):0]\ti_xclk_err\n);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_PTR_W = LGFIFO;\n\n\t// Request FIFO (wb -> xclk)\n\treg [DW*2+AW+1:0] req_fifo [0:FIFO_DEPTH-1];\n\treg [FIFO_PTR_W:0] req_wr_ptr, req_rd_ptr;\n\twire req_full = (req_wr_ptr[FIFO_PTR_W] != req_rd_ptr[FIFO_PTR_W]) &&\n\t                 (req_wr_ptr[FIFO_PTR_W-1:0] == req_rd_ptr[FIFO_PTR_W-1:0]);\n\twire req_empty = (req_wr_ptr == req_rd_ptr);\n\n\t// Response FIFO (xclk -> wb)\n\treg [DW+1:0] rsp_fifo [0:FIFO_DEPTH-1];\n\treg [FIFO_PTR_W:0] rsp_wr_ptr, rsp_rd_ptr;\n\twire rsp_full = (rsp_wr_ptr[FIFO_PTR_W] != rsp_rd_ptr[FIFO_PTR_W]) &&\n\t                 (rsp_wr_ptr[FIFO_PTR_W-1:0] == rsp_rd_ptr[FIFO_PTR_W-1:0]);\n\twire rsp_empty = (rsp_wr_ptr == rsp_rd_ptr);\n\n\t// Outstanding request count\n\treg [FIFO_PTR_W:0] outstanding;\n\n\t// WB side: accept request\n\twire wb_accept = i_wb_cyc && i_wb_stb && !req_full;\n\n\t// WB side: write to request FIFO\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr <= 0;\n\t\t\toutstanding <= 0;\n\t\tend else begin\n\t\t\tif (wb_accept) begin\n\t\t\t\treq_fifo[req_wr_ptr[FIFO_PTR_W-1:0]] <= {i_wb_we, i_wb_addr, i_wb_data, i_wb_sel};\n\t\t\t\treq_wr_ptr <= req_wr_ptr + 1;\n\t\t\t\toutstanding <= outstanding + 1;\n\t\t\tend\n\t\t\tif (rsp_empty == 0 && !rsp_full) begin\n\t\t\t\t// Read response from FIFO\n\t\t\t\trsp_rd_ptr <= rsp_rd_ptr + 1;\n\t\t\t\toutstanding <= outstanding - 1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// WB side: output response\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend else begin\n\t\t\tif (!rsp_empty) begin\n\t\t\t\to_wb_ack <= 1;\n\t\t\t\to_wb_data <= rsp_fifo[rsp_rd_ptr[FIFO_PTR_W-1:0]][DW:0];\n\t\t\t\to_wb_err <= rsp_fifo[rsp_rd_ptr[FIFO_PTR_W-1:0]][DW+1];\n\t\t\tend else begin\n\t\t\t\to_wb_ack <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\tassign o_wb_stall = req_full;\n\n\t// XCLK side: read from request FIFO and drive outputs\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_rd_ptr <= 0;\n\t\t\trsp_wr_ptr <= 0;\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend else begin\n\t\t\tif (!req_empty && !i_xclk_stall) begin\n\t\t\t\t// Drive request to xclk\n\t\t\t\to_xclk_cyc <= 1;\n\t\t\t\to_xclk_stb <= 1;\n\t\t\t\to_xclk_we <= req_fifo[req_rd_ptr[FIFO_PTR_W-1:0]][DW*2+AW];\n\t\t\t\to_xclk_addr <= req_fifo[req_rd_ptr[FIFO_PTR_W-1:0]][DW*2+AW-1:DW*2];\n\t\t\t\to_xclk_data <= req_fifo[req_rd_ptr[FIFO_PTR_W-1:0]][DW*2-1:DW];\n\t\t\t\to_xclk_sel <= req_fifo[req_rd_ptr[FIFO_PTR_W-1:0]][DW-1:0];\n\t\t\t\treq_rd_ptr <= req_rd_ptr + 1;\n\t\t\tend else begin\n\t\t\t\to_xclk_cyc <= 0;\n\t\t\t\to_xclk_stb <= 0;\n\t\t\tend\n\n\t\t\t// Write response to FIFO\n\t\t\tif (i_xclk_ack && !rsp_full) begin\n\t\t\t\trsp_fifo[rsp_wr_ptr[FIFO_PTR_W-1:0]] <= {i_xclk_err, i_xclk_data};\n\t\t\t\trsp_wr_ptr <= rsp_wr_ptr + 1;\n\t\t\tend\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>",
