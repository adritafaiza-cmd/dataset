  "text": "```verilog\nmodule wbxclk #(\n\t\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n\t) (\n\t\tinput\twire\t\t\ti_wb_clk, i_reset,\n\t\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\t\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\t\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\t\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\t\toutput\twire\t\t\to_wb_stall,\n\t\toutput\treg\t\t\to_wb_ack,\n\t\toutput\treg\t[(DW-1):0]\to_wb_data,\n\t\toutput\treg\t\t\to_wb_err,\n\t\tinput\twire\t\t\ti_xclk_clk,\n\t\toutput\treg\t\t\to_xclk_cyc,\n\t\toutput\treg\t\t\to_xclk_stb,\n\t\toutput\treg\t\t\to_xclk_we,\n\t\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\t\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\t\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\t\tinput\twire\t\t\ti_xclk_stall,\n\t\tinput\twire\t\t\ti_xclk_ack,\n\t\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\t\tinput\twire\t\t\ti_xclk_err\n\t);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam FIFO_ADDR_WIDTH = LGFIFO;\n\n\t// Request FIFO (wb -> xclk)\n\treg [DW-1:0] req_fifo_data [0:FIFO_DEPTH-1];\n\treg [AW-1:0] req_fifo_addr [0:FIFO_DEPTH-1];\n\treg [DW/8-1:0] req_fifo_sel [0:FIFO_DEPTH-1];\n\treg req_fifo_we [0:FIFO_DEPTH-1];\n\treg [FIFO_ADDR_WIDTH-1:0] req_wr_ptr, req_rd_ptr;\n\treg [FIFO_ADDR_WIDTH:0] req_count;\n\n\t// Response FIFO (xclk -> wb)\n\treg [DW-1:0] rsp_fifo_data [0:FIFO_DEPTH-1];\n\treg rsp_fifo_err [0:FIFO_DEPTH-1];\n\treg [FIFO_ADDR_WIDTH-1:0] rsp_wr_ptr, rsp_rd_ptr;\n\treg [FIFO_ADDR_WIDTH:0] rsp_count;\n\n\t// Handshake signals\n\treg req_wr_en, req_rd_en;\n\treg rsp_wr_en, rsp_rd_en;\n\n\t// Synchronizers for request FIFO full/empty\n\treg [2:0] req_full_sync, req_empty_sync;\n\treg req_full, req_empty;\n\n\t// Synchronizers for response FIFO full/empty\n\treg [2:0] rsp_full_sync, rsp_empty_sync;\n\treg rsp_full, rsp_empty;\n\n\t// Request FIFO write logic (wb_clk domain)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_wr_ptr <= 0;\n\t\t\treq_count <= 0;\n\t\t\treq_wr_en <= 0;\n\t\tend else begin\n\t\t\treq_wr_en <= i_wb_cyc && i_wb_stb && !req_full;\n\t\t\tif (req_wr_en) begin\n\t\t\t\treq_fifo_data[req_wr_ptr] <= i_wb_data;\n\t\t\t\treq_fifo_addr[req_wr_ptr] <= i_wb_addr;\n\t\t\t\treq_fifo_sel[req_wr_ptr] <= i_wb_sel;\n\t\t\t\treq_fifo_we[req_wr_ptr] <= i_wb_we;\n\t\t\t\treq_wr_ptr <= req_wr_ptr + 1;\n\t\t\tend\n\t\t\tif (req_wr_en && !req_rd_en)\n\t\t\t\treq_count <= req_count + 1;\n\t\t\telse if (!req_wr_en && req_rd_en)\n\t\t\t\treq_count <= req_count - 1;\n\t\tend\n\tend\n\n\t// Request FIFO read logic (xclk_clk domain)\n\talways @(posedge i_xclk_clk) begin\n\t\treq_rd_en <= !req_empty && !i_xclk_stall;\n\t\tif (req_rd_en) begin\n\t\t\treq_rd_ptr <= req_rd_ptr + 1;\n\t\tend\n\tend\n\n\t// Response FIFO write logic (xclk_clk domain)\n\talways @(posedge i_xclk_clk) begin\n\t\trsp_wr_en <= i_xclk_ack && !rsp_full;\n\t\tif (rsp_wr_en) begin\n\t\t\trsp_fifo_data[rsp_wr_ptr] <= i_xclk_data;\n\t\t\trsp_fifo_err[rsp_wr_ptr] <= i_xclk_err;\n\t\t\trsp_wr_ptr <= rsp_wr_ptr + 1;\n\t\tend\n\t\tif (rsp_wr_en && !rsp_rd_en)\n\t\t\trsp_count <= rsp_count + 1;\n\t\telse if (!rsp_wr_en && rsp_rd_en)\n\t\t\trsp_count <= rsp_count - 1;\n\tend\n\n\t// Response FIFO read logic (wb_clk domain)\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\trsp_rd_ptr <= 0;\n\t\t\trsp_rd_en <= 0;\n\t\t\to_wb_ack <= 0;\n\t\t\to_wb_data <= 0;\n\t\t\to_wb_err <= 0;\n\t\tend else begin\n\t\t\trsp_rd_en <= !rsp_empty;\n\t\t\tif (rsp_rd_en) begin\n\t\t\t\to_wb_ack <= 1;\n\t\t\t\to_wb_data <= rsp_fifo_data[rsp_rd_ptr];\n\t\t\t\to_wb_err <= rsp_fifo_err[rsp_rd_ptr];\n\t\t\t\trsp_rd_ptr <= rsp_rd_ptr + 1;\n\t\t\tend else begin\n\t\t\t\to_wb_ack <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Output xclk signals\n\talways @(posedge i_xclk_clk) begin\n\t\tif (req_rd_en) begin\n\t\t\to_xclk_cyc <= 1;\n\t\t\to_xclk_stb <= 1;\n\t\t\to_xclk_we <= req_fifo_we[req_rd_ptr];\n\t\t\to_xclk_addr <= req_fifo_addr[req_rd_ptr];\n\t\t\to_xclk_data <= req_fifo_data[req_rd_ptr];\n\t\t\to_xclk_sel <= req_fifo_sel[req_rd_ptr];\n\t\tend else begin\n\t\t\to_xclk_cyc <= 0;\n\t\t\to_xclk_stb <= 0;\n\t\t\to_xclk_we <= 0;\n\t\t\to_xclk_addr <= 0;\n\t\t\to_xclk_data <= 0;\n\t\t\to_xclk_sel <= 0;\n\t\tend\n\tend\n\n\t// Synchronizers\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\treq_full_sync <= 0;\n\t\t\treq_empty_sync <= 0;\n\t\t\trsp_full_sync <= 0;\n\t\t\trsp_empty_sync <= 0;\n\t\tend else begin\n\t\t\treq_full_sync <= {req_full_sync[1:0], (req_count == FIFO_DEPTH)};\n\t\t\treq_empty_sync <= {req_empty_sync[1:0], (req_count == 0)};\n\t\t\trsp_full_sync <= {rsp_full_sync[1:0], (rsp_count == FIFO_DEPTH)};\n\t\t\trsp_empty_sync <= {rsp_empty_sync[1:0], (rsp_count == 0)};\n\t\tend\n\tend\n\n\talways @(posedge i_xclk_clk) begin\n\t\treq_full_sync <= {req_full_sync[1:0], (req_count == FIFO_DEPTH)};\n\t\treq_empty_sync <= {req_empty_sync[1:0], (req_count == 0)};\n\t\trsp_full_sync <= {rsp_full_sync[1:0], (rsp_count == FIFO_DEPTH)};\n\t\trsp_empty_sync <= {rsp_empty_sync[1:0], (rsp_count == 0)};\n\tend\n\n\tassign req_full = req_full_sync[2];\n\tassign req_empty = req_empty_sync[2];\n\tassign rsp_full = rsp_full_sync[2];\n\tassign rsp_empty = rsp_empty_sync[2];\n\n\tassign o_wb_stall = req_full;\n\nendmodule\n```<|im_end|>",
