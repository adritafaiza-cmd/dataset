  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE    = 3'd0;\n    localparam S_ISOLATE = 3'd1;\n    localparam S_CLEAR   = 3'd2;\n\n    // A-side state\n    reg [2:0] a_state;\n    reg       a_isolate_o_r;\n    reg       a_clear_o_r;\n\n    // B-side state\n    reg [2:0] b_state;\n    reg       b_isolate_o_r;\n    reg       b_clear_o_r;\n\n    // A-side: B's isolate request (synchronized)\n    reg [SYNC_STAGES-1:0] b_isolate_req_sync;\n    reg                   b_isolate_req;\n\n    // A-side: B's clear request (synchronized)\n    reg [SYNC_STAGES-1:0] b_clear_req_sync;\n    reg                   b_clear_req;\n\n    // B-side: A's isolate request (synchronized)\n    reg [SYNC_STAGES-1:0] a_isolate_req_sync;\n    reg                   a_isolate_req;\n\n    // B-side: A's clear request (synchronized)\n    reg [SYNC_STAGES-1:0] a_clear_req_sync;\n    reg                   a_clear_req;\n\n    // A-side: B's isolate ack (synchronized)\n    reg [SYNC_STAGES-1:0] b_isolate_ack_sync;\n    reg                   b_isolate_ack;\n\n    // A-side: B's clear ack (synchronized)\n    reg [SYNC_STAGES-1:0] b_clear_ack_sync;\n    reg                   b_clear_ack;\n\n    // B-side: A's isolate ack (synchronized)\n    reg [SYNC_STAGES-1:0] a_isolate_ack_sync;\n    reg                   a_isolate_ack;\n\n    // B-side: A's clear ack (synchronized)\n    reg [SYNC_STAGES-1:0] a_clear_ack_sync;\n    reg                   a_clear_ack;\n\n    // Synchronizers for A-side\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_isolate_req_sync <= {SYNC_STAGES{1'b0}};\n            b_clear_req_sync   <= {SYNC_STAGES{1'b0}};\n            b_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n            b_clear_ack_sync   <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_isolate_req_sync <= {b_isolate_req_sync[SYNC_STAGES-2:0], b_isolate_o_r};\n            b_clear_req_sync   <= {b_clear_req_sync[SYNC_STAGES-2:0], b_clear_o_r};\n            b_isolate_ack_sync <= {b_isolate_ack_sync[SYNC_STAGES-2:0], b_isolate_ack_i};\n            b_clear_ack_sync   <= {b_clear_ack_sync[SYNC_STAGES-2:0], b_clear_ack_i};\n        end\n    end\n\n    assign b_isolate_req = b_isolate_req_sync[SYNC_STAGES-1];\n    assign b_clear_req   = b_clear_req_sync[SYNC_STAGES-1];\n    assign b_isolate_ack = b_isolate_ack_sync[SYNC_STAGES-1];\n    assign b_clear_ack   = b_clear_ack_sync[SYNC_STAGES-1];\n\n    // Synchronizers for B-side\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_isolate_req_sync <= {SYNC_STAGES{1'b0}};\n            a_clear_req_sync   <= {SYNC_STAGES{1'b0}};\n            a_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n            a_clear_ack_sync   <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_isolate_req_sync <= {a_isolate_req_sync[SYNC_STAGES-2:0], a_isolate_o_r};\n            a_clear_req_sync   <= {a_clear_req_sync[SYNC_STAGES-2:0], a_clear_o_r};\n            a_isolate_ack_sync <= {a_isolate_ack_sync[SYNC_STAGES-2:0], a_isolate_ack_i};\n            a_clear_ack_sync   <= {a_clear_ack_sync[SYNC_STAGES-2:0], a_clear_ack_i};\n        end\n    end\n\n    assign a_isolate_req = a_isolate_req_sync[SYNC_STAGES-1];\n    assign a_clear_req   = a_clear_req_sync[SYNC_STAGES-1];\n    assign a_isolate_ack = a_isolate_ack_sync[SYNC_STAGES-1];\n    assign a_clear_ack   = a_clear_ack_sync[SYNC_STAGES-1];\n\n    // A-side state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state       <= S_IDLE;\n            a_isolate_o_r <= 1'b0;\n            a_clear_o_r   <= 1'b0;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r   <= 1'b0;\n                    if (a_clear_i || b_isolate_req) begin\n                        a_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b0;\n                    if (a_isolate_ack_i && b_isolate_ack) begin\n                        a_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    a_isolate_o_r <= 1'b1;\n                    a_clear_o_r   <= 1'b1;\n                    if (a_clear_ack_i && b_clear_ack) begin\n                        a_state <= S_IDLE;\n                    end\n                end\n                default: begin\n                    a_state       <= S_IDLE;\n                    a_isolate_o_r <= 1'b0;\n                    a_clear_o_r   <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    // B-side state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state       <= S_IDLE;\n            b_isolate_o_r <= 1'b0;\n            b_clear_o_r   <= 1'b0;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r   <= 1'b0;\n                    if (b_clear_i || a_isolate_req) begin\n                        b_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b0;\n                    if (b_isolate_ack_i && a_isolate_ack) begin\n                        b_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    b_isolate_o_r <= 1'b1;\n                    b_clear_o_r   <= 1'b1;\n                    if (b_clear_ack_i && a_clear_ack) begin\n                        b_state <= S_IDLE;\n                    end\n                end\n                default: begin\n                    b_state       <= S_IDLE;\n                    b_isolate_o_r <= 1'b0;\n                    b_clear_o_r   <= 1'b0;\n                end\n            endcase\n        end\n    end\n\n    assign a_isolate_o = a_isolate_o_r;\n    assign a_clear_o   = a_clear_o_r;\n    assign b_isolate_o = b_isolate_o_r;\n    assign b_clear_o   = b_clear_o_r;\n\nendmodule\n```<|im_end|>",
