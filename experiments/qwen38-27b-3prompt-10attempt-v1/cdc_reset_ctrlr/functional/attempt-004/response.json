{
  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE    = 2'd0;\n    localparam S_ISOLATE = 2'd1;\n    localparam S_CLEAR   = 2'd2;\n\n    // A domain state\n    reg [1:0] a_state;\n    // B domain state\n    reg [1:0] b_state;\n\n    // Synchronization signals: A -> B\n    // a_isolate_req_sync: synchronized version of a_isolate_o\n    // a_clear_req_sync: synchronized version of a_clear_o\n    reg [SYNC_STAGES-1:0] a_isolate_req_sync_pipe;\n    reg [SYNC_STAGES-1:0] a_clear_req_sync_pipe;\n    wire a_isolate_req_sync = a_isolate_req_sync_pipe[SYNC_STAGES-1];\n    wire a_clear_req_sync   = a_clear_req_sync_pipe[SYNC_STAGES-1];\n\n    // Synchronization signals: B -> A\n    // b_isolate_req_sync: synchronized version of b_isolate_o\n    // b_clear_req_sync: synchronized version of b_clear_o\n    reg [SYNC_STAGES-1:0] b_isolate_req_sync_pipe;\n    reg [SYNC_STAGES-1:0] b_clear_req_sync_pipe;\n    wire b_isolate_req_sync = b_isolate_req_sync_pipe[SYNC_STAGES-1];\n    wire b_clear_req_sync   = b_clear_req_sync_pipe[SYNC_STAGES-1];\n\n    // A domain: synchronize B's outputs to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_isolate_req_sync_pipe <= {SYNC_STAGES{1'b0}};\n            b_clear_req_sync_pipe   <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_isolate_req_sync_pipe <= {b_isolate_req_sync_pipe[SYNC_STAGES-2:0], b_isolate_o};\n            b_clear_req_sync_pipe   <= {b_clear_req_sync_pipe[SYNC_STAGES-2:0], b_clear_o};\n        end\n    end\n\n    // B domain: synchronize A's outputs to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_isolate_req_sync_pipe <= {SYNC_STAGES{1'b0}};\n            a_clear_req_sync_pipe   <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_isolate_req_sync_pipe <= {a_isolate_req_sync_pipe[SYNC_STAGES-2:0], a_isolate_o};\n            a_clear_req_sync_pipe   <= {a_clear_req_sync_pipe[SYNC_STAGES-2:0], a_clear_o};\n        end\n    end\n\n    // A domain state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state <= S_IDLE;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    if (a_clear_i || b_clear_req_sync) begin\n                        a_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    // Wait for both isolate acks (local and peer)\n                    if (a_isolate_ack_i && b_isolate_req_sync) begin\n                        a_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    // Wait for both clear acks (local and peer)\n                    if (a_clear_ack_i && b_clear_req_sync) begin\n                        a_state <= S_IDLE;\n                    end\n                end\n                default: a_state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // B domain state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state <= S_IDLE;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    if (b_clear_i || a_clear_req_sync) begin\n                        b_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    // Wait for both isolate acks (local and peer)\n                    if (b_isolate_ack_i && a_isolate_req_sync) begin\n                        b_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    // Wait for both clear acks (local and peer)\n                    if (b_clear_ack_i && a_clear_req_sync) begin\n                        b_state <= S_IDLE;\n                    end\n                end\n                default: b_state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // A domain outputs\n    assign a_isolate_o = (a_state == S_ISOLATE) || (a_state == S_CLEAR);\n    assign a_clear_o   = (a_state == S_CLEAR);\n\n    // B domain outputs\n    assign b_isolate_o = (b_state == S_ISOLATE) || (b_state == S_CLEAR);\n    assign b_clear_o   = (b_state == S_CLEAR);\n\nendmodule\n```<|im_end|>",
