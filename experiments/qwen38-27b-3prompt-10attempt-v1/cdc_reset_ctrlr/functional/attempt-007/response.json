{
  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State encoding\n    localparam S_IDLE     = 2'd0;\n    localparam S_ISOLATE  = 2'd1;\n    localparam S_CLEAR    = 2'd2;\n    localparam S_RELEASE  = 2'd3;\n\n    // Local state registers\n    reg [1:0] a_state;\n    reg [1:0] b_state;\n\n    // Synchronized peer state\n    reg [1:0] a_peer_state_sync;\n    reg [1:0] b_peer_state_sync;\n\n    // Synchronization chains for peer state\n    // A side synchronizes B's state\n    reg [1:0] b_state_sync_1;\n    reg [1:0] b_state_sync_2;\n    reg [1:0] b_state_sync_3;\n\n    // B side synchronizes A's state\n    reg [1:0] a_state_sync_1;\n    reg [1:0] a_state_sync_2;\n    reg [1:0] a_state_sync_3;\n\n    // Synchronize B state into A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_state_sync_1 <= 2'd0;\n            b_state_sync_2 <= 2'd0;\n            b_state_sync_3 <= 2'd0;\n        end else begin\n            b_state_sync_1 <= b_state;\n            b_state_sync_2 <= b_state_sync_1;\n            b_state_sync_3 <= b_state_sync_2;\n        end\n    end\n\n    // Synchronize A state into B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_state_sync_1 <= 2'd0;\n            a_state_sync_2 <= 2'd0;\n            a_state_sync_3 <= 2'd0;\n        end else begin\n            a_state_sync_1 <= a_state;\n            a_state_sync_2 <= a_state_sync_1;\n            a_state_sync_3 <= a_state_sync_2;\n        end\n    end\n\n    // A domain state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state <= S_IDLE;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    if (a_clear_i) begin\n                        a_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    // Wait for both isolate acks: local ack and peer in ISOLATE or beyond\n                    if (a_isolate_ack_i && (b_state_sync_3 == S_ISOLATE || b_state_sync_3 == S_CLEAR || b_state_sync_3 == S_RELEASE)) begin\n                        a_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    // Wait for both clear acks: local ack and peer in CLEAR or beyond\n                    if (a_clear_ack_i && (b_state_sync_3 == S_CLEAR || b_state_sync_3 == S_RELEASE)) begin\n                        a_state <= S_RELEASE;\n                    end\n                end\n                S_RELEASE: begin\n                    // Wait for peer to return to IDLE\n                    if (b_state_sync_3 == S_IDLE) begin\n                        a_state <= S_IDLE;\n                    end\n                end\n                default: a_state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // B domain state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state <= S_IDLE;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    if (b_clear_i) begin\n                        b_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    // Wait for both isolate acks: local ack and peer in ISOLATE or beyond\n                    if (b_isolate_ack_i && (a_state_sync_3 == S_ISOLATE || a_state_sync_3 == S_CLEAR || a_state_sync_3 == S_RELEASE)) begin\n                        b_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    // Wait for both clear acks: local ack and peer in CLEAR or beyond\n                    if (b_clear_ack_i && (a_state_sync_3 == S_CLEAR || a_state_sync_3 == S_RELEASE)) begin\n                        b_state <= S_RELEASE;\n                    end\n                end\n                S_RELEASE: begin\n                    // Wait for peer to return to IDLE\n                    if (a_state_sync_3 == S_IDLE) begin\n                        b_state <= S_IDLE;\n                    end\n                end\n                default: b_state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // Output assignments\n    assign a_isolate_o = (a_state == S_ISOLATE) || (a_state == S_CLEAR);\n    assign a_clear_o   = (a_state == S_CLEAR);\n    assign b_isolate_o = (b_state == S_ISOLATE) || (b_state == S_CLEAR);\n    assign b_clear_o   = (b_state == S_CLEAR);\n\nendmodule\n```<|im_end|>",
