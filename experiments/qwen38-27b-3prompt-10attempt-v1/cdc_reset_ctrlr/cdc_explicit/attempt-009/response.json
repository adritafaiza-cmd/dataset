  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // Internal state for domain A\n    reg a_isolate_req;\n    reg a_clear_req;\n    reg a_peer_isolate_done;\n    reg a_peer_clear_done;\n\n    // Internal state for domain B\n    reg b_isolate_req;\n    reg b_clear_req;\n    reg b_peer_isolate_done;\n    reg b_peer_clear_done;\n\n    // Synchronizers for signals crossing from A to B\n    reg [SYNC_STAGES-1:0] a_isolate_req_sync;\n    reg [SYNC_STAGES-1:0] a_clear_req_sync;\n    reg [SYNC_STAGES-1:0] a_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] a_clear_ack_sync;\n\n    // Synchronizers for signals crossing from B to A\n    reg [SYNC_STAGES-1:0] b_isolate_req_sync;\n    reg [SYNC_STAGES-1:0] b_clear_req_sync;\n    reg [SYNC_STAGES-1:0] b_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] b_clear_ack_sync;\n\n    // Synchronized versions\n    wire a_isolate_req_b = a_isolate_req_sync[SYNC_STAGES-1];\n    wire a_clear_req_b   = a_clear_req_sync[SYNC_STAGES-1];\n    wire a_isolate_ack_b = a_isolate_ack_sync[SYNC_STAGES-1];\n    wire a_clear_ack_b   = a_clear_ack_sync[SYNC_STAGES-1];\n\n    wire b_isolate_req_a = b_isolate_req_sync[SYNC_STAGES-1];\n    wire b_clear_req_a   = b_clear_req_sync[SYNC_STAGES-1];\n    wire b_isolate_ack_a = b_isolate_ack_sync[SYNC_STAGES-1];\n    wire b_clear_ack_a   = b_clear_ack_sync[SYNC_STAGES-1];\n\n    // Synchronizer for A to B: a_isolate_req\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_isolate_req_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_isolate_req_sync <= {a_isolate_req_sync[SYNC_STAGES-2:0], a_isolate_req};\n    end\n\n    // Synchronizer for A to B: a_clear_req\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_clear_req_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_clear_req_sync <= {a_clear_req_sync[SYNC_STAGES-2:0], a_clear_req};\n    end\n\n    // Synchronizer for A to B: a_isolate_ack\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_isolate_ack_sync <= {a_isolate_ack_sync[SYNC_STAGES-2:0], a_isolate_ack_i};\n    end\n\n    // Synchronizer for A to B: a_clear_ack\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_clear_ack_sync <= {a_clear_ack_sync[SYNC_STAGES-2:0], a_clear_ack_i};\n    end\n\n    // Synchronizer for B to A: b_isolate_req\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_isolate_req_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_isolate_req_sync <= {b_isolate_req_sync[SYNC_STAGES-2:0], b_isolate_req};\n    end\n\n    // Synchronizer for B to A: b_clear_req\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_clear_req_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_clear_req_sync <= {b_clear_req_sync[SYNC_STAGES-2:0], b_clear_req};\n    end\n\n    // Synchronizer for B to A: b_isolate_ack\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_isolate_ack_sync <= {b_isolate_ack_sync[SYNC_STAGES-2:0], b_isolate_ack_i};\n    end\n\n    // Synchronizer for B to A: b_clear_ack\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_clear_ack_sync <= {b_clear_ack_sync[SYNC_STAGES-2:0], b_clear_ack_i};\n    end\n\n    // Domain A logic\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_isolate_req        <= 1'b0;\n            a_clear_req          <= 1'b0;\n            a_peer_isolate_done  <= 1'b0;\n            a_peer_clear_done    <= 1'b0;\n        end else begin\n            // Check if peer (B) has completed isolate\n            if (b_isolate_req_a && b_isolate_ack_a)\n                a_peer_isolate_done <= 1'b1;\n            else if (!b_isolate_req_a)\n                a_peer_isolate_done <= 1'b0;\n\n            // Check if peer (B) has completed clear\n            if (b_clear_req_a && b_clear_ack_a)\n                a_peer_clear_done <= 1'b1;\n            else if (!b_clear_req_a)\n                a_peer_clear_done <= 1'b0;\n\n            // State machine for domain A\n            if (a_clear_i) begin\n                // Request isolate\n                a_isolate_req <= 1'b1;\n                a_clear_req   <= 1'b0;\n            end else if (a_isolate_req && a_peer_isolate_done) begin\n                // Both sides isolated, now request clear\n                a_isolate_req <= 1'b1;\n                a_clear_req   <= 1'b1;\n            end else if (a_clear_req && a_peer_clear_done) begin\n                // Both sides cleared, release\n                a_isolate_req <= 1'b0;\n                a_clear_req   <= 1'b0;\n            end else begin\n                // Hold current state\n            end\n        end\n    end\n\n    // Domain B logic\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_isolate_req        <= 1'b0;\n            b_clear_req          <= 1'b0;\n            b_peer_isolate_done  <= 1'b0;\n            b_peer_clear_done    <= 1'b0;\n        end else begin\n            // Check if peer (A) has completed isolate\n            if (a_isolate_req_b && a_isolate_ack_b)\n                b_peer_isolate_done <= 1'b1;\n            else if (!a_isolate_req_b)\n                b_peer_isolate_done <= 1'b0;\n\n            // Check if peer (A) has completed clear\n            if (a_clear_req_b && a_clear_ack_b)\n                b_peer_clear_done <= 1'b1;\n            else if (!a_clear_req_b)\n                b_peer_clear_done <= 1'b0;\n\n            // State machine for domain B\n            if (b_clear_i) begin\n                // Request isolate\n                b_isolate_req <= 1'b1;\n                b_clear_req   <= 1'b0;\n            end else if (b_isolate_req && b_peer_isolate_done) begin\n                // Both sides isolated, now request clear\n                b_isolate_req <= 1'b1;\n                b_clear_req   <= 1'b1;\n            end else if (b_clear_req && b_peer_clear_done) begin\n                // Both sides cleared, release\n                b_isolate_req <= 1'b0;\n                b_clear_req   <= 1'b0;\n            end else begin\n                // Hold current state\n            end\n        end\n    end\n\n    // Outputs\n    assign a_isolate_o = a_isolate_req;\n    assign a_clear_o   = a_clear_req;\n    assign b_isolate_o = b_isolate_req;\n    assign b_clear_o   = b_clear_req;\n\nendmodule\n```<|im_end|>",
