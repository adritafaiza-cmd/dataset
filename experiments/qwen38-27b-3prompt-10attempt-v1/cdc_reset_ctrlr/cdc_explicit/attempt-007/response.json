  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // State machine states\n    localparam S_IDLE      = 3'd0;\n    localparam S_ISOLATE   = 3'd1;\n    localparam S_CLEAR     = 3'd2;\n    localparam S_RELEASE   = 3'd3;\n\n    // Internal state registers\n    reg [2:0] a_state;\n    reg [2:0] b_state;\n\n    // Synchronization registers for state crossing\n    reg [SYNC_STAGES*3-1:0] a_state_sync;\n    reg [SYNC_STAGES*3-1:0] b_state_sync;\n\n    // Synchronized state values\n    wire [2:0] a_state_synced = a_state_sync[SYNC_STAGES*3-1 -: 3];\n    wire [2:0] b_state_synced = b_state_sync[SYNC_STAGES*3-1 -: 3];\n\n    // Synchronization registers for clear request\n    reg [SYNC_STAGES-1:0] a_clear_req_sync;\n    reg [SYNC_STAGES-1:0] b_clear_req_sync;\n\n    // Synchronized clear request values\n    wire a_clear_req_synced = a_clear_req_sync[SYNC_STAGES-1];\n    wire b_clear_req_synced = b_clear_req_sync[SYNC_STAGES-1];\n\n    // Synchronization registers for isolate ack\n    reg [SYNC_STAGES-1:0] a_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] b_isolate_ack_sync;\n\n    // Synchronized isolate ack values\n    wire a_isolate_ack_synced = a_isolate_ack_sync[SYNC_STAGES-1];\n    wire b_isolate_ack_synced = b_isolate_ack_sync[SYNC_STAGES-1];\n\n    // Synchronization registers for clear ack\n    reg [SYNC_STAGES-1:0] a_clear_ack_sync;\n    reg [SYNC_STAGES-1:0] b_clear_ack_sync;\n\n    // Synchronized clear ack values\n    wire a_clear_ack_synced = a_clear_ack_sync[SYNC_STAGES-1];\n    wire b_clear_ack_synced = b_clear_ack_sync[SYNC_STAGES-1];\n\n    // Synchronization registers for isolate output (to inform peer)\n    reg [SYNC_STAGES-1:0] a_isolate_out_sync;\n    reg [SYNC_STAGES-1:0] b_isolate_out_sync;\n\n    // Synchronized isolate output values\n    wire a_isolate_out_synced = a_isolate_out_sync[SYNC_STAGES-1];\n    wire b_isolate_out_synced = b_isolate_out_sync[SYNC_STAGES-1];\n\n    // Synchronization registers for clear output (to inform peer)\n    reg [SYNC_STAGES-1:0] a_clear_out_sync;\n    reg [SYNC_STAGES-1:0] b_clear_out_sync;\n\n    // Synchronized clear output values\n    wire a_clear_out_synced = a_clear_out_sync[SYNC_STAGES-1];\n    wire b_clear_out_synced = b_clear_out_sync[SYNC_STAGES-1];\n\n    // A domain state machine\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_state <= S_IDLE;\n        end else begin\n            case (a_state)\n                S_IDLE: begin\n                    if (a_clear_i || b_clear_req_synced) begin\n                        a_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    if (a_isolate_ack_i && b_isolate_ack_synced) begin\n                        a_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    if (a_clear_ack_i && b_clear_ack_synced) begin\n                        a_state <= S_RELEASE;\n                    end\n                end\n                S_RELEASE: begin\n                    a_state <= S_IDLE;\n                end\n                default: a_state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // B domain state machine\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_state <= S_IDLE;\n        end else begin\n            case (b_state)\n                S_IDLE: begin\n                    if (b_clear_i || a_clear_req_synced) begin\n                        b_state <= S_ISOLATE;\n                    end\n                end\n                S_ISOLATE: begin\n                    if (b_isolate_ack_i && a_isolate_ack_synced) begin\n                        b_state <= S_CLEAR;\n                    end\n                end\n                S_CLEAR: begin\n                    if (b_clear_ack_i && a_clear_ack_synced) begin\n                        b_state <= S_RELEASE;\n                    end\n                end\n                S_RELEASE: begin\n                    b_state <= S_IDLE;\n                end\n                default: b_state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // A domain outputs\n    assign a_isolate_o = (a_state == S_ISOLATE) || (a_state == S_CLEAR) || (a_state == S_RELEASE);\n    assign a_clear_o   = (a_state == S_CLEAR) || (a_state == S_RELEASE);\n\n    // B domain outputs\n    assign b_isolate_o = (b_state == S_ISOLATE) || (b_state == S_CLEAR) || (b_state == S_RELEASE);\n    assign b_clear_o   = (b_state == S_CLEAR) || (b_state == S_RELEASE);\n\n    // Synchronize A state to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_state_sync <= {SYNC_STAGES{3'd0}};\n        end else begin\n            a_state_sync <= {a_state_sync[SYNC_STAGES*3-2:0], a_state};\n        end\n    end\n\n    // Synchronize B state to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_state_sync <= {SYNC_STAGES{3'd0}};\n        end else begin\n            b_state_sync <= {b_state_sync[SYNC_STAGES*3-2:0], b_state};\n        end\n    end\n\n    // Synchronize A clear request to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_clear_req_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_clear_req_sync <= {a_clear_req_sync[SYNC_STAGES-2:0], a_clear_i};\n        end\n    end\n\n    // Synchronize B clear request to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_clear_req_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_clear_req_sync <= {b_clear_req_sync[SYNC_STAGES-2:0], b_clear_i};\n        end\n    end\n\n    // Synchronize A isolate ack to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_isolate_ack_sync <= {a_isolate_ack_sync[SYNC_STAGES-2:0], a_isolate_ack_i};\n        end\n    end\n\n    // Synchronize B isolate ack to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_isolate_ack_sync <= {b_isolate_ack_sync[SYNC_STAGES-2:0], b_isolate_ack_i};\n        end\n    end\n\n    // Synchronize A clear ack to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_clear_ack_sync <= {a_clear_ack_sync[SYNC_STAGES-2:0], a_clear_ack_i};\n        end\n    end\n\n    // Synchronize B clear ack to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_clear_ack_sync <= {b_clear_ack_sync[SYNC_STAGES-2:0], b_clear_ack_i};\n        end\n    end\n\n    // Synchronize A isolate output to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_isolate_out_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_isolate_out_sync <= {a_isolate_out_sync[SYNC_STAGES-2:0], a_isolate_o};\n        end\n    end\n\n    // Synchronize B isolate output to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_isolate_out_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_isolate_out_sync <= {b_isolate_out_sync[SYNC_STAGES-2:0], b_isolate_o};\n        end\n    end\n\n    // Synchronize A clear output to B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_clear_out_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_clear_out_sync <= {a_clear_out_sync[SYNC_STAGES-2:0], a_clear_o};\n        end\n    end\n\n    // Synchronize B clear output to A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_clear_out_sync <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_clear_out_sync <= {b_clear_out_sync[SYNC_STAGES-2:0], b_clear_o};\n        end\n    end\n\nendmodule\n```<|im_end|>",
