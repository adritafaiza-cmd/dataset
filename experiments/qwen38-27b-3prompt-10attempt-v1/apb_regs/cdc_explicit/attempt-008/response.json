  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Local parameters\n  localparam int unsigned ADDR_SHIFT = $clog2(AddrOffset);\n  localparam int unsigned REG_INDEX_WIDTH = $clog2(NoApbRegs);\n\n  // APB signal extraction (assuming standard APB3/4 structure)\n  // We need to extract: psel, penable, pwrite, paddr, pwdata, pready, preslverr\n  // Since req_t and resp_t are parameterized types, we assume they have standard APB fields.\n  // For a generic implementation, we'll use direct field access assuming the types\n  // are structured with standard APB signal names.\n\n  // Extract APB signals from req_t\n  wire psel;\n  wire penable;\n  wire pwrite;\n  wire [ApbAddrWidth-1:0] paddr;\n  wire [ApbDataWidth-1:0] pwdata;\n\n  assign psel    = req_i.psel;\n  assign penable = req_i.penable;\n  assign pwrite  = req_i.pwrite;\n  assign paddr   = req_i.paddr;\n  assign pwdata  = req_i.pwdata;\n\n  // Response signals\n  wire pready;\n  wire preslverr;\n\n  assign resp_o.pready    = pready;\n  assign resp_o.preslverr = preslverr;\n\n  // Register file\n  reg_data_t [NoApbRegs-1:0] reg_q;\n\n  // Address decoding\n  // Calculate register index from address\n  wire [ApbAddrWidth-1:0] addr_offset = paddr - base_addr_i;\n  wire [REG_INDEX_WIDTH-1:0] reg_index = (AddrOffset == 1) ? \n    addr_offset[REG_INDEX_WIDTH-1:0] : \n    addr_offset[ADDR_SHIFT + REG_INDEX_WIDTH-1:ADDR_SHIFT];\n\n  wire addr_valid = (reg_index < NoApbRegs);\n\n  // Write enable\n  wire write_en = psel & penable & pwrite & addr_valid;\n\n  // Read data\n  reg_data_t read_data;\n  assign read_data = reg_q[reg_index];\n\n  // Register update logic\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        reg_q[i] <= reg_init_i[i];\n      end\n    end else begin\n      if (write_en) begin\n        if (!ReadOnly[reg_index]) begin\n          reg_q[reg_index] <= pwdata[RegDataWidth-1:0];\n        end\n      end\n    end\n  end\n\n  // Drive output\n  always @(*) begin\n    for (int i = 0; i < NoApbRegs; i++) begin\n      reg_q_o[i] = reg_q[i];\n    end\n  end\n\n  // APB ready and error\n  assign pready    = 1'b1;\n  assign preslverr = 1'b0;\n\nendmodule\n```<|im_end|>",
