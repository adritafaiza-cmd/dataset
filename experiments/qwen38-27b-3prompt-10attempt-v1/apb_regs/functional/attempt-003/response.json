  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract fields from APB request\n  // Assuming standard APB3/4 structure:\n  // req_i.psel, req_i.penable, req_i.pwrite, req_i.paddr, req_i.pwdata, req_i.pstrb\n  // But since req_t is a type parameter, we need to access fields generically.\n  // However, the problem states \"req_i / resp_o use the APB request and response types supplied by the testbench.\"\n  // This implies req_t and resp_t are structured types with known fields.\n  // Common APB fields: psel, penable, pwrite, paddr, pwdata, pstrb\n  // For response: pready, pslverr, prdata\n\n  // Since we don't know the exact structure, we'll assume standard APB field names.\n  // Let's define local signals to extract what we need.\n\n  // APB phases:\n  // Setup phase: psel=1, penable=0\n  // Access phase: psel=1, penable=1\n\n  // We need to detect when a valid APB transaction is in the access phase\n  // and determine if it's a read or write.\n\n  // Let's assume req_t has fields: psel, penable, pwrite, paddr, pwdata, pstrb\n  // And resp_t has fields: pready, pslverr, prdata\n\n  // For simplicity and to match typical APB register file implementations,\n  // we'll assume the following field names in the types:\n  // req_i.psel, req_i.penable, req_i.pwrite, req_i.paddr, req_i.pwdata, req_i.pstrb\n  // resp_o.pready, resp_o.pslverr, resp_o.prdata\n\n  // However, since these are type parameters, we need to be careful.\n  // Let's use direct field access assuming standard naming.\n\n  // Detect access phase\n  wire access_phase = req_i.psel & req_i.penable;\n\n  // Determine register index from address\n  // Address offset from base\n  apb_addr_t addr_offset;\n  assign addr_offset = req_i.paddr - base_addr_i;\n\n  // Convert byte offset to register index\n  // Each register is AddrOffset bytes apart\n  // Register index = addr_offset / AddrOffset\n  // We need to handle the division. Since AddrOffset is a parameter, we can use a shift if it's a power of 2,\n  // but for generality, we'll use a simple approach.\n\n  // Let's compute the register index\n  logic [ApbAddrWidth-1:0] reg_index_raw;\n  assign reg_index_raw = addr_offset / AddrOffset;\n\n  // Check if the address is valid (within range and aligned)\n  wire addr_valid = (reg_index_raw < NoApbRegs) && \n                    (addr_offset % AddrOffset == 0);\n\n  // Register index as integer\n  int unsigned reg_idx;\n  assign reg_idx = int'(reg_index_raw);\n\n  // Write enable for each register\n  wire [NoApbRegs-1:0] write_en;\n  for (genvar i = 0; i < NoApbRegs; i++) begin : gen_write_en\n    assign write_en[i] = access_phase & req_i.pwrite & addr_valid & (reg_idx == i) & ~ReadOnly[i];\n  end\n\n  // Read data\n  reg_data_t read_data;\n  assign read_data = reg_q_o[reg_idx];\n\n  // Response\n  // pready: always ready (no wait states)\n  // pslverr: error if address is invalid\n  // prdata: read data\n\n  // We need to assign to resp_o fields\n  // Assuming resp_t has fields: pready, pslverr, prdata\n\n  // For the response, we'll assign based on the access phase\n  // In APB, the response is valid during the access phase\n\n  // Let's assign the response fields\n  // Since resp_o is an output of type resp_t, we need to assign to its fields\n\n  // We'll use a continuous assignment for each field\n\n  // pready: always 1 (no wait states)\n  // pslverr: 1 if address is invalid during access phase\n  // prdata: the read data\n\n  // However, we need to be careful about when to drive these.\n  // In APB, the slave should drive pready, pslverr, and prdata during the access phase.\n\n  // Let's use a combinational block to assign the response\n\n  always_comb begin\n    // Default values\n    resp_o.pready = 1'b1;\n    resp_o.pslverr = 1'b0;\n    resp_o.prdata = '0;\n\n    if (access_phase) begin\n      if (addr_valid) begin\n        resp_o.pslverr = 1'b0;\n        if (!req_i.pwrite) begin\n          resp_o.prdata = read_data;\n        end\n      end else begin\n        resp_o.pslverr = 1'b1;\n      end\n    end\n  end\n\n  // Register file\n  always_ff @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        reg_q_o[i] <= reg_init_i[i];\n      end\n    end else begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (write_en[i]) begin\n          reg_q_o[i] <= req_i.pwdata;\n        end\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>",
