  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract APB fields from req_t\n  // Assuming req_t has fields: psel, penable, pwrite, paddr, pwdata, pstrb\n  // We need to handle the APB protocol\n\n  // APB signals\n  wire        psel;\n  wire        penable;\n  wire        pwrite;\n  wire [ApbAddrWidth-1:0] paddr;\n  wire [ApbDataWidth-1:0] pwdata;\n  wire [ApbDataWidth/8-1:0] pstrb;\n\n  // Extract from req_t - assuming it's a struct with these fields\n  assign psel    = req_t'('0); // This won't work directly, need to handle type\n  // Since req_t is a parameter type, we need to use a different approach\n  // Let's assume req_t is a struct with fields: psel, penable, pwrite, paddr, pwdata, pstrb\n\n  // Actually, since req_t is a parameter type, we need to cast or use a different method\n  // Let's assume the testbench provides req_t as a struct with these fields\n  // We'll use a typedef approach or direct field access\n\n  // For now, let's assume we can access fields directly\n  // This is a common pattern in APB register files\n\n  // Let's define the APB signals from req_t\n  // Assuming req_t is a struct with: psel, penable, pwrite, paddr, pwdata, pstrb\n  assign psel    = req_t.psel;\n  assign penable = req_t.penable;\n  assign pwrite  = req_t.pwrite;\n  assign paddr   = req_t.paddr;\n  assign pwdata  = req_t.pwdata;\n  assign pstrb   = req_t.pstrb;\n\n  // APB response signals\n  wire [ApbDataWidth-1:0] prdata;\n  wire        pready;\n  wire        pslverr;\n\n  // Register file\n  reg_data_t [NoApbRegs-1:0] reg_q;\n\n  // Address decoding\n  // Calculate register index from address\n  // addr = base_addr + index * AddrOffset\n  // index = (addr - base_addr) / AddrOffset\n\n  wire [ApbAddrWidth-1:0] addr_offset;\n  wire [ApbAddrWidth-1:0] addr_diff;\n  wire [ApbAddrWidth-1:0] reg_index;\n  wire                    addr_valid;\n\n  assign addr_offset = paddr - base_addr_i;\n  assign addr_diff   = addr_offset;\n  assign reg_index   = addr_diff / AddrOffset;\n  assign addr_valid  = (reg_index < NoApbRegs) && (addr_offset % AddrOffset == 0);\n\n  // Read data\n  wire [RegDataWidth-1:0] read_data;\n  assign read_data = addr_valid ? reg_q[reg_index] : '0;\n\n  // Convert read data to APB data width\n  wire [ApbDataWidth-1:0] prdata_wire;\n  assign prdata_wire = (ApbDataWidth >= RegDataWidth) ? \n                       {{(ApbDataWidth-RegDataWidth){1'b0}}, read_data} : \n                       read_data[ApbDataWidth-1:0];\n\n  assign prdata = prdata_wire;\n\n  // Write enable\n  wire        write_en;\n  wire [ApbDataWidth-1:0] write_data;\n  wire [RegDataWidth-1:0] write_data_reg;\n\n  assign write_en = psel & penable & pwrite & addr_valid;\n  assign write_data = pwdata;\n  assign write_data_reg = (RegDataWidth >= ApbDataWidth) ? \n                          {{(RegDataWidth-ApbDataWidth){1'b0}}, write_data} : \n                          write_data[RegDataWidth-1:0];\n\n  // Apply read-only mask\n  wire [RegDataWidth-1:0] ro_mask;\n  assign ro_mask = ReadOnly[reg_index] ? '1 : '0;\n\n  // Register update\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        reg_q[i] <= reg_init_i[i];\n      end\n    end else begin\n      if (write_en) begin\n        // Apply read-only mask: keep original bits where RO is set\n        reg_q[reg_index] <= (reg_q[reg_index] & ro_mask) | (write_data_reg & ~ro_mask);\n      end\n    end\n  end\n\n  // Drive output\n  assign reg_q_o = reg_q;\n\n  // APB response\n  assign pready  = 1'b1;\n  assign pslverr = 1'b0;\n\n  // Build response\n  // Assuming resp_t is a struct with: pready, pslverr, prdata\n  assign resp_o = resp_t'{\n    pready:  pready,\n    pslverr: pslverr,\n    prdata:  prdata\n  };\n\nendmodule\n```<|im_end|>",
