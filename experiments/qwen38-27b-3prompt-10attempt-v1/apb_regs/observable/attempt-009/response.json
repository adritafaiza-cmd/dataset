  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  localparam int unsigned ADDR_SHIFT = (AddrOffset == 0) ? 0 : $clog2(AddrOffset);\n  localparam int unsigned REG_INDEX_WIDTH = (NoApbRegs <= 1) ? 1 : $clog2(NoApbRegs);\n\n  // Extract APB signals from req_t\n  wire        psel   = req_i[0];\n  wire        penable= req_i[1];\n  wire        pwrite = req_i[2];\n  wire [ApbAddrWidth-1:0] paddr = req_i[ApbAddrWidth+2:3];\n  wire [ApbDataWidth-1:0] pwdata = req_i[ApbDataWidth+ApbAddrWidth+2:3];\n\n  // Compute register index from address\n  wire [ApbAddrWidth-1:0] offset_addr = paddr - base_addr_i;\n  wire [REG_INDEX_WIDTH-1:0] reg_index = (REG_INDEX_WIDTH == 1) ? 1'b0 : offset_addr[ADDR_SHIFT +: REG_INDEX_WIDTH];\n\n  // Check if address is valid (within range)\n  wire addr_valid = (NoApbRegs == 0) ? 1'b0 :\n                    (REG_INDEX_WIDTH == 1) ? 1'b1 :\n                    (reg_index < NoApbRegs);\n\n  // Read data\n  wire [RegDataWidth-1:0] rdata = (NoApbRegs == 0) ? '0 : reg_q_o[reg_index];\n\n  // Write enable\n  wire write_en = psel & penable & pwrite & addr_valid;\n\n  // Register file\n  always_ff @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        reg_q_o[i] <= reg_init_i[i];\n      end\n    end else begin\n      if (write_en) begin\n        if (!ReadOnly[reg_index]) begin\n          reg_q_o[reg_index] <= pwdata[RegDataWidth-1:0];\n        end\n      end\n    end\n  end\n\n  // APB response\n  always_comb begin\n    resp_o = '0;\n    if (psel & penable) begin\n      if (pwrite) begin\n        resp_o[0] = addr_valid; // PREADY\n      end else begin\n        resp_o[0] = addr_valid; // PREADY\n        resp_o[ApbDataWidth+1:1] = rdata[ApbDataWidth-1:0]; // PRDATA\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>",
