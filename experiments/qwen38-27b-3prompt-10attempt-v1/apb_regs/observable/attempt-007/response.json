{
  "text": "```systemverilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Extract APB signals from req_t\n  wire        pwrite   = req_i.pwrite;\n  wire        psel     = req_i.psel;\n  wire        penable  = req_i.penable;\n  wire [31:0] paddr    = req_i.paddr;\n  wire [31:0] pwdata   = req_i.pwdata;\n  wire [3:0]  pstrb    = req_i.pstrb;\n\n  // Extract APB signals from resp_t\n  resp_o.pready  = 1'b1;\n  resp_o.pslverr = 1'b0;\n  resp_o.prdata  = 32'h0;\n\n  // Compute register index from address\n  wire [ApbAddrWidth-1:0] addr_offset = paddr - base_addr_i;\n  wire [ApbAddrWidth-1:0] reg_index   = addr_offset / AddrOffset;\n  wire [ApbAddrWidth-1:0] byte_offset = addr_offset % AddrOffset;\n\n  // Check if address is valid (within range)\n  wire addr_valid = (reg_index < NoApbRegs) && (byte_offset == 0);\n\n  // Read data\n  reg_data_t read_data;\n  assign read_data = addr_valid ? reg_q_o[reg_index] : '0;\n\n  // Write data with byte strobes\n  reg_data_t write_data;\n  if (RegDataWidth == 32) begin\n    write_data = {\n      (pstrb[3] ? pwdata[31:24] : reg_q_o[reg_index][31:24]),\n      (pstrb[2] ? pwdata[23:16] : reg_q_o[reg_index][23:16]),\n      (pstrb[1] ? pwdata[15:8]  : reg_q_o[reg_index][15:8]),\n      (pstrb[0] ? pwdata[7:0]   : reg_q_o[reg_index][7:0])\n    };\n  end else begin\n    write_data = reg_data_t'(pwdata);\n  end\n\n  // Write enable\n  wire write_en = psel & penable & pwrite & addr_valid;\n\n  // Register update logic\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        reg_q_o[i] <= reg_init_i[i];\n      end\n    end else begin\n      if (write_en) begin\n        if (!ReadOnly[reg_index]) begin\n          reg_q_o[reg_index] <= write_data;\n        end\n      end\n    end\n  end\n\n  // Read data output\n  always @(*) begin\n    if (psel & penable & !pwrite) begin\n      resp_o.prdata = 32'(read_data);\n    end else begin\n      resp_o.prdata = 32'h0;\n    end\n  end\n\nendmodule\n```<|im_end|>",
