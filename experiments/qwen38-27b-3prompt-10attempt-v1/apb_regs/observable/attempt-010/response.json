/ AddrOffset] = 1'b1;\n    end\n  end\n\n  // Register file\n  reg_data_t [NoApbRegs-1:0] reg_q;\n\n  always_ff @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        reg_q[i] <= reg_init_i[i];\n      end\n    end else begin\n      if (psel && penable && pwrite && addr_valid) begin\n        for (int i = 0; i < NoApbRegs; i++) begin\n          if (reg_sel[i] && !ReadOnly[i]) begin\n            // Byte-lane write enable\n            for (int b = 0; b < RegDataWidth/8; b++) begin\n              if (pstrb[b]) begin\n                reg_q[i][b*8 +: 8] <= pwdata[b*8 +: 8];\n              end\n            end\n          end\n        end\n      end\n    end\n  end\n\n  assign reg_q_o = reg_q;\n\n  // Read data\n  always_comb begin\n    prdata = '0;\n    if (addr_valid) begin\n      for (int i = 0; i < NoApbRegs; i++) begin\n        if (reg_sel[i]) begin\n          prdata = reg_q[i][0 +: ApbDataWidth];\n        end\n      end\n    end\n  end\n\n  // Ready and error\n  assign pready  = 1'b1;\n  assign pslverr = 1'b0;\n\nendmodule\n```<|im_end|>",
