  "text": "```verilog\nmodule isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output [WIDTH-1:0] dst_data_o\n);\n\n    // Source clock domain state\n    reg [WIDTH-1:0] src_buf0;\n    reg [WIDTH-1:0] src_buf1;\n    reg             src_buf0_valid;\n    reg             src_buf1_valid;\n\n    // Destination clock domain state\n    reg [WIDTH-1:0] dst_buf0;\n    reg [WIDTH-1:0] dst_buf1;\n    reg             dst_buf0_valid;\n    reg             dst_buf1_valid;\n\n    // Synchronization signals\n    // src_to_dst: source has data available (either buf0 or buf1 valid)\n    reg             src_has_data;\n    reg             src_has_data_sync1;\n    reg             src_has_data_sync2;\n\n    // dst_to_src: destination has space available (either buf0 or buf1 not valid)\n    reg             dst_has_space;\n    reg             dst_has_space_sync1;\n    reg             dst_has_space_sync2;\n\n    // Synchronize src_has_data to dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_has_data_sync1 <= 1'b0;\n            src_has_data_sync2 <= 1'b0;\n        end else begin\n            src_has_data_sync1 <= src_has_data;\n            src_has_data_sync2 <= src_has_data_sync1;\n        end\n    end\n\n    // Synchronize dst_has_space to src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_has_space_sync1 <= 1'b0;\n            dst_has_space_sync2 <= 1'b0;\n        end else begin\n            dst_has_space_sync1 <= dst_has_space;\n            dst_has_space_sync2 <= dst_has_space_sync1;\n        end\n    end\n\n    // Compute src_has_data in source domain\n    assign src_has_data = src_buf0_valid | src_buf1_valid;\n\n    // Compute dst_has_space in destination domain\n    assign dst_has_space = ~(dst_buf0_valid & dst_buf1_valid);\n\n    // Source domain: accept data when there's space in destination\n    // We can accept if destination has space (synchronized)\n    wire src_can_accept = dst_has_space_sync2;\n\n    assign src_ready_o = src_can_accept;\n\n    // Source domain: write data into source buffers\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_buf0_valid <= 1'b0;\n            src_buf1_valid <= 1'b0;\n            src_buf0       <= {WIDTH{1'b0}};\n            src_buf1       <= {WIDTH{1'b0}};\n        end else begin\n            if (src_valid_i && src_ready_o) begin\n                if (!src_buf0_valid) begin\n                    src_buf0       <= src_data_i;\n                    src_buf0_valid <= 1'b1;\n                end else if (!src_buf1_valid) begin\n                    src_buf1       <= src_data_i;\n                    src_buf1_valid <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Destination domain: read from source buffers (synchronized)\n    // We need to synchronize the buffer contents and valid bits to dst domain\n    // Since the source buffers are written in src domain, we need to sync them to dst domain\n\n    // Synchronize src_buf0_valid\n    reg src_buf0_valid_sync1;\n    reg src_buf0_valid_sync2;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_buf0_valid_sync1 <= 1'b0;\n            src_buf0_valid_sync2 <= 1'b0;\n        end else begin\n            src_buf0_valid_sync1 <= src_buf0_valid;\n            src_buf0_valid_sync2 <= src_buf0_valid_sync1;\n        end\n    end\n\n    // Synchronize src_buf1_valid\n    reg src_buf1_valid_sync1;\n    reg src_buf1_valid_sync2;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_buf1_valid_sync1 <= 1'b0;\n            src_buf1_valid_sync2 <= 1'b0;\n        end else begin\n            src_buf1_valid_sync1 <= src_buf1_valid;\n            src_buf1_valid_sync2 <= src_buf1_valid_sync1;\n        end\n    end\n\n    // Synchronize src_buf0 data\n    reg [WIDTH-1:0] src_buf0_sync1;\n    reg [WIDTH-1:0] src_buf0_sync2;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_buf0_sync1 <= {WIDTH{1'b0}};\n            src_buf0_sync2 <= {WIDTH{1'b0}};\n        end else begin\n            src_buf0_sync1 <= src_buf0;\n            src_buf0_sync2 <= src_buf0_sync1;\n        end\n    end\n\n    // Synchronize src_buf1 data\n    reg [WIDTH-1:0] src_buf1_sync1;\n    reg [WIDTH-1:0] src_buf1_sync2;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_buf1_sync1 <= {WIDTH{1'b0}};\n            src_buf1_sync2 <= {WIDTH{1'b0}};\n        end else begin\n            src_buf1_sync1 <= src_buf1;\n            src_buf1_sync2 <= src_buf1_sync1;\n        end\n    end\n\n    // Destination domain: manage destination buffers\n    // When dst_ready, pop from dst buffers\n    // When src has data (synchronized), push into dst buffers\n\n    wire dst_can_push = src_has_data_sync2;\n    wire dst_can_pop  = dst_ready_i;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_buf0_valid <= 1'b0;\n            dst_buf1_valid <= 1'b0;\n            dst_buf0       <= {WIDTH{1'b0}};\n            dst_buf1       <= {WIDTH{1'b0}};\n        end else begin\n            // Pop logic\n            if (dst_can_pop) begin\n                if (dst_buf0_valid) begin\n                    dst_buf0_valid <= 1'b0;\n                    if (dst_buf1_valid) begin\n                        dst_buf0       <= dst_buf1;\n                        dst_buf1_valid <= 1'b0;\n                    end\n                end\n            end\n\n            // Push logic\n            if (dst_can_push) begin\n                if (!dst_buf0_valid) begin\n                    if (src_buf0_valid_sync2) begin\n                        dst_buf0       <= src_buf0_sync2;\n                        dst_buf0_valid <= 1'b1;\n                    end else if (src_buf1_valid_sync2) begin\n                        dst_buf0       <= src_buf1_sync2;\n                        dst_buf0_valid <= 1'b1;\n                    end\n                end else if (!dst_buf1_valid) begin\n                    if (src_buf0_valid_sync2) begin\n                        dst_buf1       <= src_buf0_sync2;\n                        dst_buf1_valid <= 1'b1;\n                    end else if (src_buf1_valid_sync2) begin\n                        dst_buf1       <= src_buf1_sync2;\n                        dst_buf1_valid <= 1'b1;\n                    end\n                end\n            end\n        end\n    end\n\n    // Destination output\n    assign dst_valid_o = dst_buf0_valid;\n    assign dst_data_o  = dst_buf0;\n\nendmodule\n```<|im_end|>",
