  "text": "```verilog\nmodule isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output [WIDTH-1:0] dst_data_o\n);\n\n    // Source clock domain\n    reg [WIDTH-1:0] src_reg0;\n    reg             src_reg0_valid;\n    reg [WIDTH-1:0] src_reg1;\n    reg             src_reg1_valid;\n\n    // Destination clock domain\n    reg [WIDTH-1:0] dst_reg0;\n    reg             dst_reg0_valid;\n    reg [WIDTH-1:0] dst_reg1;\n    reg             dst_reg1_valid;\n\n    // Synchronization of source valid signals to destination domain\n    reg [1:0] src_reg0_valid_sync;\n    reg [1:0] src_reg1_valid_sync;\n\n    // Synchronization of destination valid signals to source domain\n    reg [1:0] dst_reg0_valid_sync;\n    reg [1:0] dst_reg1_valid_sync;\n\n    // Synchronization of destination ready to source domain\n    reg [1:0] dst_ready_sync;\n\n    // Synchronization of source ready to destination domain\n    reg [1:0] src_ready_sync;\n\n    // Source domain logic\n    wire src_can_accept = !src_reg0_valid || !src_reg1_valid;\n    assign src_ready_o = src_can_accept;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_reg0_valid <= 1'b0;\n            src_reg1_valid <= 1'b0;\n            src_reg0       <= {WIDTH{1'b0}};\n            src_reg1       <= {WIDTH{1'b0}};\n        end else begin\n            if (src_valid_i && src_ready_o) begin\n                if (!src_reg0_valid) begin\n                    src_reg0       <= src_data_i;\n                    src_reg0_valid <= 1'b1;\n                end else if (!src_reg1_valid) begin\n                    src_reg1       <= src_data_i;\n                    src_reg1_valid <= 1'b1;\n                end\n            end\n        end\n    end\n\n    // Destination domain logic\n    wire dst_can_accept = !dst_reg0_valid || !dst_reg1_valid;\n    assign dst_valid_o = dst_reg0_valid || dst_reg1_valid;\n    assign dst_data_o  = dst_reg0_valid ? dst_reg0 : dst_reg1;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_reg0_valid <= 1'b0;\n            dst_reg1_valid <= 1'b0;\n            dst_reg0       <= {WIDTH{1'b0}};\n            dst_reg1       <= {WIDTH{1'b0}};\n        end else begin\n            // Accept from source if destination has space\n            if (dst_can_accept) begin\n                if (!dst_reg0_valid && src_reg0_valid_sync[1]) begin\n                    dst_reg0       <= src_reg0;\n                    dst_reg0_valid <= 1'b1;\n                end else if (!dst_reg1_valid && src_reg1_valid_sync[1]) begin\n                    dst_reg1       <= src_reg1;\n                    dst_reg1_valid <= 1'b1;\n                end\n            end\n\n            // Pop to destination if ready\n            if (dst_valid_o && dst_ready_i) begin\n                if (dst_reg0_valid) begin\n                    dst_reg0_valid <= 1'b0;\n                    if (dst_reg1_valid) begin\n                        dst_reg0       <= dst_reg1;\n                        dst_reg1_valid <= 1'b0;\n                    end\n                end else if (dst_reg1_valid) begin\n                    dst_reg1_valid <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // Synchronizers: source valid to destination\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_reg0_valid_sync <= 2'b00;\n            src_reg1_valid_sync <= 2'b00;\n        end else begin\n            src_reg0_valid_sync <= {src_reg0_valid_sync[0], src_reg0_valid};\n            src_reg1_valid_sync <= {src_reg1_valid_sync[0], src_reg1_valid};\n        end\n    end\n\n    // Synchronizers: destination valid to source\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_reg0_valid_sync <= 2'b00;\n            dst_reg1_valid_sync <= 2'b00;\n        end else begin\n            dst_reg0_valid_sync <= {dst_reg0_valid_sync[0], dst_reg0_valid};\n            dst_reg1_valid_sync <= {dst_reg1_valid_sync[0], dst_reg1_valid};\n        end\n    end\n\n    // Synchronizers: destination ready to source\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_ready_sync <= 2'b00;\n        end else begin\n            dst_ready_sync <= {dst_ready_sync[0], dst_ready_i};\n        end\n    end\n\n    // Synchronizers: source ready to destination\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_ready_sync <= 2'b00;\n        end else begin\n            src_ready_sync <= {src_ready_sync[0], src_ready_o};\n        end\n    end\n\nendmodule\n```<|im_end|>",
