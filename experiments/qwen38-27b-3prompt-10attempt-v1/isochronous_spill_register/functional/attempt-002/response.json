{
  "text": "```verilog\nmodule isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output [WIDTH-1:0] dst_data_o\n);\n\n    // Stage 0 (first register)\n    reg [WIDTH-1:0] stage0_data;\n    reg             stage0_valid;\n\n    // Stage 1 (second register)\n    reg [WIDTH-1:0] stage1_data;\n    reg             stage1_valid;\n\n    // Source domain: stage0\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            stage0_valid <= 1'b0;\n            stage0_data  <= {WIDTH{1'b0}};\n        end else begin\n            if (src_valid_i && src_ready_o) begin\n                stage0_valid <= 1'b1;\n                stage0_data  <= src_data_i;\n            end else if (stage0_valid && stage1_ready) begin\n                stage0_valid <= 1'b0;\n            end\n        end\n    end\n\n    // Destination domain: stage1\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            stage1_valid <= 1'b0;\n            stage1_data  <= {WIDTH{1'b0}};\n        end else begin\n            if (stage1_valid && dst_ready_i) begin\n                stage1_valid <= 1'b0;\n            end else if (!stage1_valid && stage0_valid) begin\n                stage1_valid <= 1'b1;\n                stage1_data  <= stage0_data;\n            end\n        end\n    end\n\n    // Outputs\n    assign src_ready_o = !stage0_valid || stage1_ready;\n    assign dst_valid_o = stage1_valid;\n    assign dst_data_o  = stage1_data;\n\n    // Internal signal: stage1 ready (from destination domain perspective)\n    wire stage1_ready = !stage1_valid || dst_ready_i;\n\nendmodule\n```<|im_end|>",
