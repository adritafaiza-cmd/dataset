{
  "text": "```verilog\nmodule isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output [WIDTH-1:0] dst_data_o\n);\n\n    // Synchronizers for reset signals\n    reg [1:0] src_rst_ni_sync;\n    reg [1:0] dst_rst_ni_sync;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_rst_ni_sync <= 2'b00;\n        else\n            src_rst_ni_sync <= {src_rst_ni_sync[0], src_rst_ni};\n    end\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_rst_ni_sync <= 2'b00;\n        else\n            dst_rst_ni_sync <= {dst_rst_ni_sync[0], dst_rst_ni};\n    end\n\n    // Synchronized reset signals\n    wire src_rst_ni_synced = src_rst_ni_sync[1];\n    wire dst_rst_ni_synced = dst_rst_ni_sync[1];\n\n    // Synchronizers for valid/ready handshake signals\n    // src_valid_i needs to be synchronized to dst domain\n    reg [1:0] src_valid_sync;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_valid_sync <= 2'b00;\n        else\n            src_valid_sync <= {src_valid_sync[0], src_valid_i};\n    end\n    wire src_valid_synced = src_valid_sync[1];\n\n    // dst_ready_i needs to be synchronized to src domain\n    reg [1:0] dst_ready_sync;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_ready_sync <= 2'b00;\n        else\n            dst_ready_sync <= {dst_ready_sync[0], dst_ready_i};\n    end\n    wire dst_ready_synced = dst_ready_sync[1];\n\n    // Synchronizers for data\n    // Data is only valid when src_valid is asserted, so we synchronize data\n    // along with a valid indicator to ensure coherence\n    reg [WIDTH-1:0] src_data_sync;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_data_sync <= {WIDTH{1'b0}};\n        else\n            src_data_sync <= src_data_i;\n    end\n\n    // Buffer state in destination domain\n    reg [WIDTH-1:0] buf_data;\n    reg             buf_valid;\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            buf_valid <= 1'b0;\n            buf_data  <= {WIDTH{1'b0}};\n        end else begin\n            if (dst_ready_i && buf_valid) begin\n                // Destination consumed the data\n                if (src_valid_synced) begin\n                    // New data available from source\n                    buf_data  <= src_data_sync;\n                    buf_valid <= 1'b1;\n                end else begin\n                    // No new data\n                    buf_valid <= 1'b0;\n                end\n            end else if (!buf_valid && src_valid_synced) begin\n                // Buffer empty, new data available\n                buf_data  <= src_data_sync;\n                buf_valid <= 1'b1;\n            end\n        end\n    end\n\n    // Source domain logic\n    // src_ready_o indicates that the source can send data\n    // The source can send if the buffer is not full (i.e., destination can accept)\n    // Since we have a 1-deep buffer, src_ready is high when the buffer is empty\n    // or when the destination is ready to accept the current data\n\n    // We need to track whether the buffer has data in the source domain\n    // Synchronize buf_valid to source domain\n    reg [1:0] buf_valid_sync;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            buf_valid_sync <= 2'b00;\n        else\n            buf_valid_sync <= {buf_valid_sync[0], buf_valid};\n    end\n    wire buf_valid_synced = buf_valid_sync[1];\n\n    // src_ready_o: source can send if buffer is empty or destination is ready\n    // To be safe, we only allow source to send when buffer is empty\n    // This ensures no data loss\n    assign src_ready_o = !buf_valid_synced;\n\n    // dst_valid_o: destination has valid data\n    assign dst_valid_o = buf_valid;\n\n    // dst_data_o: destination data\n    assign dst_data_o = buf_data;\n\nendmodule\n```<|im_end|>",
