{
  "text": "```verilog\nmodule isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output [WIDTH-1:0] dst_data_o\n);\n\n    // Source-domain registers\n    reg  [WIDTH-1:0] src_data_reg;\n    reg              src_valid_reg;\n    reg              src_ready_reg;\n\n    // Destination-domain registers\n    reg  [WIDTH-1:0] dst_data_reg;\n    reg              dst_valid_reg;\n    reg              dst_ready_reg;\n\n    // Synchronizers for valid signal (src -> dst)\n    reg              valid_sync_1;\n    reg              valid_sync_2;\n\n    // Synchronizers for ready signal (dst -> src)\n    reg              ready_sync_1;\n    reg              ready_sync_2;\n\n    // Synchronizers for reset (src -> dst)\n    reg              src_rst_sync_1;\n    reg              src_rst_sync_2;\n\n    // Synchronizers for reset (dst -> src)\n    reg              dst_rst_sync_1;\n    reg              dst_rst_sync_2;\n\n    // Synchronizers for data (src -> dst) - use 2-stage synchronizer per bit\n    // Since clocks are related (integer ratio), we can use a simpler approach:\n    // The data is stable when valid is asserted, and we synchronize the valid\n    // signal. When the synchronized valid transitions from 0 to 1, we capture\n    // the data. However, for multi-bit data with related clocks, we need to\n    // ensure data coherence.\n\n    // For related clocks with integer ratio, the data will be stable for at\n    // least one destination clock cycle when the valid is asserted. We can\n    // use a 2-stage synchronizer for the valid signal and capture the data\n    // when the synchronized valid rises.\n\n    // Actually, for a 2-deep spill buffer with related clocks, the standard\n    // approach is to use a handshake protocol. Let's implement a proper\n    // valid/ready handshake with synchronizers.\n\n    // Source domain:\n    // - src_ready_o is high when the buffer is not full (i.e., dst is ready to accept)\n    // - When src_valid_i and src_ready_o are both high, data is accepted\n    // - The data is stored in src_data_reg and src_valid_reg is set\n\n    // Destination domain:\n    // - dst_valid_o is high when there is data to send\n    // - When dst_valid_o and dst_ready_i are both high, data is sent\n    // - dst_ready_o is fed back to source domain to indicate buffer is not full\n\n    // For related clocks, we can use a simpler synchronization scheme.\n    // The key insight is that with related clocks, the data will be stable\n    // for a sufficient number of destination clock cycles.\n\n    // Let's implement a 2-stage synchronizer for the valid signal and\n    // capture the data when the synchronized valid rises.\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_data_reg  <= {WIDTH{1'b0}};\n            src_valid_reg <= 1'b0;\n            src_ready_reg <= 1'b0;\n        end else begin\n            // Accept data when valid and ready\n            if (src_valid_i && src_ready_o) begin\n                src_data_reg  <= src_data_i;\n                src_valid_reg <= 1'b1;\n            end else if (src_valid_reg && ready_sync_2) begin\n                // Data has been consumed by destination\n                src_valid_reg <= 1'b0;\n            end\n        end\n    end\n\n    // Source ready: high when destination is ready to accept new data\n    // This is the synchronized version of dst_ready\n    assign src_ready_o = ready_sync_2;\n\n    // Synchronize dst_ready to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            ready_sync_1 <= 1'b0;\n            ready_sync_2 <= 1'b0;\n        end else begin\n            ready_sync_1 <= dst_ready_reg;\n            ready_sync_2 <= ready_sync_1;\n        end\n    end\n\n    // Synchronize src_valid to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            valid_sync_1 <= 1'b0;\n            valid_sync_2 <= 1'b0;\n        end else begin\n            valid_sync_1 <= src_valid_reg;\n            valid_sync_2 <= valid_sync_1;\n        end\n    end\n\n    // Synchronize src_rst_ni to destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_rst_sync_1 <= 1'b0;\n            src_rst_sync_2 <= 1'b0;\n        end else begin\n            src_rst_sync_1 <= src_rst_ni;\n            src_rst_sync_2 <= src_rst_sync_1;\n        end\n    end\n\n    // Synchronize dst_rst_ni to source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_rst_sync_1 <= 1'b0;\n            dst_rst_sync_2 <= 1'b0;\n        end else begin\n            dst_rst_sync_1 <= dst_rst_ni;\n            dst_rst_sync_2 <= dst_rst_sync_1;\n        end\n    end\n\n    // Destination domain logic\n    // dst_valid_o is high when there is valid data to send\n    // We use the synchronized valid signal and track when data has been sent\n\n    reg dst_data_sent;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_reg  <= {WIDTH{1'b0}};\n            dst_valid_reg <= 1'b0;\n            dst_ready_reg <= 1'b0;\n            dst_data_sent <= 1'b0;\n        end else begin\n            // When synchronized valid rises, capture data\n            if (valid_sync_2 && !valid_sync_1) begin\n                dst_data_reg  <= src_data_reg;\n                dst_valid_reg <= 1'b1;\n                dst_data_sent <= 1'b0;\n            end else if (dst_valid_reg && dst_ready_i) begin\n                // Data has been consumed\n                dst_valid_reg <= 1'b0;\n                dst_data_sent <= 1'b1;\n            end\n        end\n    end\n\n    assign dst_valid_o = dst_valid_reg;\n    assign dst_data_o  = dst_data_reg;\n\n    // dst_ready_reg indicates that the destination is ready to accept new data\n    // This is high when there is no valid data pending\n    assign dst_ready_reg = !dst_valid_reg;\n\nendmodule\n```<|im_end|>",
