{
  "text": "```verilog\nmodule isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output [WIDTH-1:0] dst_data_o\n);\n\n    // Source domain: capture data and generate a pulse\n    reg [WIDTH-1:0] src_data_reg;\n    reg             src_data_valid;\n    reg             src_pulse;\n\n    wire src_accept = src_valid_i & src_ready_o;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_data_reg   <= {WIDTH{1'b0}};\n            src_data_valid <= 1'b0;\n            src_pulse      <= 1'b0;\n        end else begin\n            if (src_accept) begin\n                src_data_reg   <= src_data_i;\n                src_data_valid <= 1'b1;\n                src_pulse      <= 1'b1;\n            end else begin\n                src_data_valid <= 1'b0;\n                src_pulse      <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronize the pulse into the destination domain\n    reg [2:0] pulse_sync;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            pulse_sync <= 3'b000;\n        end else begin\n            pulse_sync <= {pulse_sync[1:0], src_pulse};\n        end\n    end\n\n    // Detect rising edge of the synchronized pulse\n    wire pulse_rise = pulse_sync[1] & ~pulse_sync[0];\n\n    // Destination domain: two-stage buffer\n    reg [WIDTH-1:0] buf0_data;\n    reg             buf0_valid;\n    reg [WIDTH-1:0] buf1_data;\n    reg             buf1_valid;\n\n    wire dst_accept = dst_valid_o & dst_ready_i;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            buf0_data  <= {WIDTH{1'b0}};\n            buf0_valid <= 1'b0;\n            buf1_data  <= {WIDTH{1'b0}};\n            buf1_valid <= 1'b0;\n        end else begin\n            // Stage 0: accept new data from source\n            if (pulse_rise) begin\n                buf0_data  <= src_data_reg;\n                buf0_valid <= 1'b1;\n            end else if (buf0_valid & buf1_valid) begin\n                // Both stages full, cannot accept new data\n                // (should not happen if src_ready is properly managed)\n            end else if (buf0_valid & ~buf1_valid) begin\n                // Move stage 0 to stage 1\n                buf1_data  <= buf0_data;\n                buf1_valid <= 1'b1;\n                buf0_valid <= 1'b0;\n            end else if (~buf0_valid & buf1_valid) begin\n                // Stage 0 empty, stage 1 has data\n                // If stage 1 is being consumed, it will be cleared\n            end\n\n            // Stage 1: output\n            if (dst_accept) begin\n                buf1_valid <= 1'b0;\n            end\n        end\n    end\n\n    // Output\n    assign dst_valid_o = buf1_valid;\n    assign dst_data_o  = buf1_data;\n\n    // Source ready: can accept if stage 0 is empty\n    assign src_ready_o = ~buf0_valid;\n\nendmodule\n```<|im_end|>",
