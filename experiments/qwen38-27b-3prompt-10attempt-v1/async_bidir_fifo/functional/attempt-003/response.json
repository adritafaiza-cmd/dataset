  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam PTR_W = ASIZE + 1;\n  localparam AFULL_THRESH  = DEPTH - 2;\n  localparam AEMPTY_THRESH = 1;\n\n  // Internal FIFO storage\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  // Side A pointers (in A clock domain)\n  reg [PTR_W-1:0] a_wr_ptr;\n  reg [PTR_W-1:0] a_rd_ptr;\n\n  // Side B pointers (in B clock domain)\n  reg [PTR_W-1:0] b_wr_ptr;\n  reg [PTR_W-1:0] b_rd_ptr;\n\n  // Gray code pointers for CDC\n  wire [PTR_W-1:0] a_wr_ptr_gray;\n  wire [PTR_W-1:0] a_rd_ptr_gray;\n  wire [PTR_W-1:0] b_wr_ptr_gray;\n  wire [PTR_W-1:0] b_rd_ptr_gray;\n\n  assign a_wr_ptr_gray = a_wr_ptr ^ {1'b0, a_wr_ptr[ASIZE-1:0]};\n  assign a_rd_ptr_gray = a_rd_ptr ^ {1'b0, a_rd_ptr[ASIZE-1:0]};\n  assign b_wr_ptr_gray = b_wr_ptr ^ {1'b0, b_wr_ptr[ASIZE-1:0]};\n  assign b_rd_ptr_gray = b_rd_ptr ^ {1'b0, b_rd_ptr[ASIZE-1:0]};\n\n  // Synchronizers for A-side pointers into B domain\n  reg [PTR_W-1:0] a_wr_ptr_gray_b_sync1, a_wr_ptr_gray_b_sync2;\n  reg [PTR_W-1:0] a_rd_ptr_gray_b_sync1, a_rd_ptr_gray_b_sync2;\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_gray_b_sync1 <= {PTR_W{1'b0}};\n      a_wr_ptr_gray_b_sync2 <= {PTR_W{1'b0}};\n      a_rd_ptr_gray_b_sync1 <= {PTR_W{1'b0}};\n      a_rd_ptr_gray_b_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      a_wr_ptr_gray_b_sync1 <= a_wr_ptr_gray;\n      a_wr_ptr_gray_b_sync2 <= a_wr_ptr_gray_b_sync1;\n      a_rd_ptr_gray_b_sync1 <= a_rd_ptr_gray;\n      a_rd_ptr_gray_b_sync2 <= a_rd_ptr_gray_b_sync1;\n    end\n  end\n\n  // Synchronizers for B-side pointers into A domain\n  reg [PTR_W-1:0] b_wr_ptr_gray_a_sync1, b_wr_ptr_gray_a_sync2;\n  reg [PTR_W-1:0] b_rd_ptr_gray_a_sync1, b_rd_ptr_gray_a_sync2;\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_gray_a_sync1 <= {PTR_W{1'b0}};\n      b_wr_ptr_gray_a_sync2 <= {PTR_W{1'b0}};\n      b_rd_ptr_gray_a_sync1 <= {PTR_W{1'b0}};\n      b_rd_ptr_gray_a_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      b_wr_ptr_gray_a_sync1 <= b_wr_ptr_gray;\n      b_wr_ptr_gray_a_sync2 <= b_wr_ptr_gray_a_sync1;\n      b_rd_ptr_gray_a_sync1 <= b_rd_ptr_gray;\n      b_rd_ptr_gray_a_sync2 <= b_rd_ptr_gray_a_sync1;\n    end\n  end\n\n  // Convert gray to binary\n  function [PTR_W-1:0] gray2bin;\n    input [PTR_W-1:0] gray;\n    integer i;\n    begin\n      gray2bin[PTR_W-1] = gray[PTR_W-1];\n      for (i = PTR_W-2; i >= 0; i = i - 1)\n        gray2bin[i] = gray2bin[i+1] ^ gray[i];\n    end\n  endfunction\n\n  wire [PTR_W-1:0] a_wr_ptr_b_bin = gray2bin(a_wr_ptr_gray_b_sync2);\n  wire [PTR_W-1:0] a_rd_ptr_b_bin = gray2bin(a_rd_ptr_gray_b_sync2);\n  wire [PTR_W-1:0] b_wr_ptr_a_bin = gray2bin(b_wr_ptr_gray_a_sync2);\n  wire [PTR_W-1:0] b_rd_ptr_a_bin = gray2bin(b_rd_ptr_gray_a_sync2);\n\n  // Determine effective write/read operations on each side\n  // Side A: a_dir=1 means write, a_dir=0 means read\n  wire a_do_write = a_dir & a_winc & ~a_full;\n  wire a_do_read  = ~a_dir & a_rinc & ~a_empty;\n\n  // Side B: b_dir=1 means write, b_dir=0 means read\n  wire b_do_write = b_dir & b_winc & ~b_full;\n  wire b_do_read  = ~b_dir & b_rinc & ~b_empty;\n\n  // Write to memory\n  always @(posedge a_clk) begin\n    if (a_do_write)\n      mem[a_wr_ptr[ASIZE-1:0]] <= a_wdata;\n  end\n\n  always @(posedge b_clk) begin\n    if (b_do_write)\n      mem[b_wr_ptr[ASIZE-1:0]] <= b_wdata;\n  end\n\n  // Update pointers\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {PTR_W{1'b0}};\n      a_rd_ptr <= {PTR_W{1'b0}};\n    end else begin\n      if (a_do_write)\n        a_wr_ptr <= a_wr_ptr + 1'b1;\n      if (a_do_read)\n        a_rd_ptr <= a_rd_ptr + 1'b1;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {PTR_W{1'b0}};\n      b_rd_ptr <= {PTR_W{1'b0}};\n    end else begin\n      if (b_do_write)\n        b_wr_ptr <= b_wr_ptr + 1'b1;\n      if (b_do_read)\n        b_rd_ptr <= b_rd_ptr + 1'b1;\n    end\n  end\n\n  // Read data\n  reg [DSIZE-1:0] a_rdata_reg;\n  reg [DSIZE-1:0] b_rdata_reg;\n\n  always @(posedge a_clk) begin\n    if (a_do_read)\n      a_rdata_reg <= mem[a_rd_ptr[ASIZE-1:0]];\n  end\n\n  always @(posedge b_clk) begin\n    if (b_do_read)\n      b_rdata_reg <= mem[b_rd_ptr[ASIZE-1:0]];\n  end\n\n  // Full/Empty flags\n  // A side: full when a_wr_ptr - b_rd_ptr_a_bin == DEPTH\n  // A side: empty when a_wr_ptr == b_rd_ptr_a_bin\n  wire a_full_internal  = (a_wr_ptr == (b_rd_ptr_a_bin + DEPTH));\n  wire a_empty_internal = (a_wr_ptr == b_rd_ptr_a_bin);\n\n  // B side: full when b_wr_ptr - a_rd_ptr_b_bin == DEPTH\n  // B side: empty when b_wr_ptr == a_rd_ptr_b_bin\n  wire b_full_internal  = (b_wr_ptr == (a_rd_ptr_b_bin + DEPTH));\n  wire b_empty_internal = (b_wr_ptr == a_rd_ptr_b_bin);\n\n  assign a_full  = a_full_internal;\n  assign a_empty = a_empty_internal;\n  assign b_full  = b_full_internal;\n  assign b_empty = b_empty_internal;\n\n  // Almost full/empty\n  wire [PTR_W-1:0] a_count = a_wr_ptr - b_rd_ptr_a_bin;\n  wire [PTR_W-1:0] b_count = b_wr_ptr - a_rd_ptr_b_bin;\n\n  assign a_afull   = (a_count >= AFULL_THRESH);\n  assign a_aempty  = (a_count <= AEMPTY_THRESH);\n  assign b_afull   = (b_count >= AFULL_THRESH);\n  assign b_aempty  = (b_count <= AEMPTY_THRESH);\n\n  // Output data\n  assign a_rdata = a_rdata_reg;\n  assign b_rdata = b_rdata_reg;\n\nendmodule\n```<|im_end|>",
