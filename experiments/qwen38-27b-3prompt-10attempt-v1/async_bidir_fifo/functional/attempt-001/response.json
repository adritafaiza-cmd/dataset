  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam PTR_W = ASIZE + 1;\n  localparam AFULL_THRESH = DEPTH - 2;\n  localparam AEMPTY_THRESH = 1;\n\n  // Internal signals for A-to-B FIFO\n  wire a2b_winc = a_dir & a_winc;\n  wire a2b_rinc = ~b_dir & b_rinc;\n  wire [DSIZE-1:0] a2b_wdata = a_wdata;\n  wire [DSIZE-1:0] a2b_rdata;\n  wire a2b_full;\n  wire a2b_afull;\n  wire a2b_empty;\n  wire a2b_aempty;\n\n  // Internal signals for B-to-A FIFO\n  wire b2a_winc = b_dir & b_winc;\n  wire b2a_rinc = ~a_dir & a_rinc;\n  wire [DSIZE-1:0] b2a_wdata = b_wdata;\n  wire [DSIZE-1:0] b2a_rdata;\n  wire b2a_full;\n  wire b2a_afull;\n  wire b2a_empty;\n  wire b2a_aempty;\n\n  // Instantiate A-to-B FIFO\n  async_fifo #(\n    .DSIZE(DSIZE),\n    .ASIZE(ASIZE),\n    .FALLTHROUGH(FALLTHROUGH)\n  ) u_a2b_fifo (\n    .wclk(a_clk),\n    .wrst_n(a_rst_n),\n    .winc(a2b_winc),\n    .wdata(a2b_wdata),\n    .rclk(b_clk),\n    .rrst_n(b_rst_n),\n    .rinc(a2b_rinc),\n    .rdata(a2b_rdata),\n    .full(a2b_full),\n    .afull(a2b_afull),\n    .empty(a2b_empty),\n    .aempty(a2b_aempty)\n  );\n\n  // Instantiate B-to-A FIFO\n  async_fifo #(\n    .DSIZE(DSIZE),\n    .ASIZE(ASIZE),\n    .FALLTHROUGH(FALLTHROUGH)\n  ) u_b2a_fifo (\n    .wclk(b_clk),\n    .wrst_n(b_rst_n),\n    .winc(b2a_winc),\n    .wdata(b2a_wdata),\n    .rclk(a_clk),\n    .rrst_n(a_rst_n),\n    .rinc(b2a_rinc),\n    .rdata(b2a_rdata),\n    .full(b2a_full),\n    .afull(b2a_afull),\n    .empty(b2a_empty),\n    .aempty(b2a_aempty)\n  );\n\n  // A side outputs\n  assign a_rdata = a_dir ? a2b_rdata : b2a_rdata;\n  assign a_full  = a_dir ? a2b_full  : b2a_full;\n  assign a_afull = a_dir ? a2b_afull : b2a_afull;\n  assign a_empty = a_dir ? a2b_empty : b2a_empty;\n  assign a_aempty = a_dir ? a2b_aempty : b2a_aempty;\n\n  // B side outputs\n  assign b_rdata = b_dir ? b2a_rdata : a2b_rdata;\n  assign b_full  = b_dir ? b2a_full  : a2b_full;\n  assign b_afull = b_dir ? b2a_afull : a2b_afull;\n  assign b_empty = b_dir ? b2a_empty : a2b_empty;\n  assign b_aempty = b_dir ? b2a_aempty : a2b_aempty;\n\nendmodule\n\nmodule async_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              wclk,\n       input wire              wrst_n,\n       input wire              winc,\n       input wire [DSIZE-1:0]  wdata,\n       input wire              rclk,\n       input wire              rrst_n,\n       input wire              rinc,\n       output wire [DSIZE-1:0] rdata,\n       output wire             full,\n       output wire             afull,\n       output wire             empty,\n       output wire             aempty\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam PTR_W = ASIZE + 1;\n  localparam AFULL_THRESH = DEPTH - 2;\n  localparam AEMPTY_THRESH = 1;\n\n  // Memory\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  // Write pointer (write clock domain)\n  reg [PTR_W-1:0] wptr;\n  // Read pointer (read clock domain)\n  reg [PTR_W-1:0] rptr;\n\n  // Gray code pointers for CDC\n  reg [ASIZE-1:0] wptr_gray;\n  reg [ASIZE-1:0] rptr_gray;\n\n  // Synchronized read pointer in write clock domain\n  reg [ASIZE-1:0] rptr_gray_sync1;\n  reg [ASIZE-1:0] rptr_gray_sync2;\n\n  // Synchronized write pointer in read clock domain\n  reg [ASIZE-1:0] wptr_gray_sync1;\n  reg [ASIZE-1:0] wptr_gray_sync2;\n\n  // Binary read pointer synchronized to write clock domain\n  reg [PTR_W-1:0] rptr_bin_sync1;\n  reg [PTR_W-1:0] rptr_bin_sync2;\n\n  // Binary write pointer synchronized to read clock domain\n  reg [PTR_W-1:0] wptr_bin_sync1;\n  reg [PTR_W-1:0] wptr_bin_sync2;\n\n  // Gray to binary conversion\n  function [ASIZE-1:0] gray_to_bin;\n    input [ASIZE-1:0] gray;\n    integer i;\n    begin\n      gray_to_bin[ASIZE-1] = gray[ASIZE-1];\n      for (i = ASIZE-2; i >= 0; i = i - 1)\n        gray_to_bin[i] = gray_to_bin[i+1] ^ gray[i];\n    end\n  endfunction\n\n  // Binary to gray conversion\n  function [ASIZE-1:0] bin_to_gray;\n    input [ASIZE-1:0] bin;\n    begin\n      bin_to_gray = bin ^ (bin >> 1);\n    end\n  endfunction\n\n  // Write clock domain\n  always @(posedge wclk or negedge wrst_n) begin\n    if (!wrst_n) begin\n      wptr <= {PTR_W{1'b0}};\n      wptr_gray <= {ASIZE{1'b0}};\n    end else if (winc && !full) begin\n      wptr <= wptr + 1'b1;\n      wptr_gray <= bin_to_gray(wptr[ASIZE-1:0] + 1'b1);\n    end\n  end\n\n  // Read clock domain\n  always @(posedge rclk or negedge rrst_n) begin\n    if (!rrst_n) begin\n      rptr <= {PTR_W{1'b0}};\n      rptr_gray <= {ASIZE{1'b0}};\n    end else if (rinc && !empty) begin\n      rptr <= rptr + 1'b1;\n      rptr_gray <= bin_to_gray(rptr[ASIZE-1:0] + 1'b1);\n    end\n  end\n\n  // Synchronize read pointer gray to write clock domain\n  always @(posedge wclk or negedge wrst_n) begin\n    if (!wrst_n) begin\n      rptr_gray_sync1 <= {ASIZE{1'b0}};\n      rptr_gray_sync2 <= {ASIZE{1'b0}};\n    end else begin\n      rptr_gray_sync1 <= rptr_gray;\n      rptr_gray_sync2 <= rptr_gray_sync1;\n    end\n  end\n\n  // Synchronize write pointer gray to read clock domain\n  always @(posedge rclk or negedge rrst_n) begin\n    if (!rrst_n) begin\n      wptr_gray_sync1 <= {ASIZE{1'b0}};\n      wptr_gray_sync2 <= {ASIZE{1'b0}};\n    end else begin\n      wptr_gray_sync1 <= wptr_gray;\n      wptr_gray_sync2 <= wptr_gray_sync1;\n    end\n  end\n\n  // Synchronize read pointer binary to write clock domain\n  always @(posedge wclk or negedge wrst_n) begin\n    if (!wrst_n) begin\n      rptr_bin_sync1 <= {PTR_W{1'b0}};\n      rptr_bin_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      rptr_bin_sync1 <= rptr;\n      rptr_bin_sync2 <= rptr_bin_sync1;\n    end\n  end\n\n  // Synchronize write pointer binary to read clock domain\n  always @(posedge rclk or negedge rrst_n) begin\n    if (!rrst_n) begin\n      wptr_bin_sync1 <= {PTR_W{1'b0}};\n      wptr_bin_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      wptr_bin_sync1 <= wptr;\n      wptr_bin_sync2 <= wptr_bin_sync1;\n    end\n  end\n\n  // Write memory\n  always @(posedge wclk) begin\n    if (winc && !full)\n      mem[wptr[ASIZE-1:0]] <= wdata;\n  end\n\n  // Read data\n  reg [DSIZE-1:0] rdata_reg;\n  always @(posedge rclk or negedge rrst_n) begin\n    if (!rrst_n)\n      rdata_reg <= {DSIZE{1'b0}};\n    else\n      rdata_reg <= mem[rptr[ASIZE-1:0]];\n  end\n\n  assign rdata = rdata_reg;\n\n  // Full flag (write clock domain)\n  // Full when write pointer has lapped read pointer by DEPTH\n  wire [PTR_W-1:0] rptr_bin_from_gray = {1'b0, gray_to_bin(rptr_gray_sync2)};\n  // Need to reconstruct full binary read pointer\n  // The MSB of the binary pointer is the wrap bit\n  // We use the synchronized binary pointer\n  wire [PTR_W-1:0] rptr_sync = rptr_bin_sync2;\n  wire full_internal = (wptr[ASIZE-1:0] == rptr_sync[ASIZE-1:0]) && \n                       (wptr[ASIZE] != rptr_sync[ASIZE]);\n  assign full = full_internal;\n\n  // Almost full flag\n  wire [PTR_W-1:0] diff = wptr - rptr_sync;\n  assign afull = (diff >= AFULL_THRESH);\n\n  // Empty flag (read clock domain)\n  wire [PTR_W-1:0] wptr_sync = wptr_bin_sync2;\n  wire empty_internal = (wptr_sync == rptr);\n  assign empty = empty_internal;\n\n  // Almost empty flag\n  wire [PTR_W-1:0] diff_read = wptr_sync - rptr;\n  assign aempty = (diff_read <= AEMPTY_THRESH);\n\nendmodule\n```<|im_end|>",
