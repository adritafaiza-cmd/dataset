  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam PTR_W = ASIZE + 1;\n  localparam AFULL_THRESH = DEPTH - 2;\n  localparam AEMPTY_THRESH = 2;\n\n  // Internal FIFO storage\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  // Side A pointers (in A clock domain)\n  reg [PTR_W-1:0] a_wr_ptr;\n  reg [PTR_W-1:0] a_rd_ptr;\n\n  // Side B pointers (in B clock domain)\n  reg [PTR_W-1:0] b_wr_ptr;\n  reg [PTR_W-1:0] b_rd_ptr;\n\n  // Gray code pointers for CDC\n  wire [ASIZE-1:0] a_wr_ptr_gray;\n  wire [ASIZE-1:0] a_rd_ptr_gray;\n  wire [ASIZE-1:0] b_wr_ptr_gray;\n  wire [ASIZE-1:0] b_rd_ptr_gray;\n\n  // Synchronized gray code pointers\n  reg [ASIZE-1:0] a_wr_ptr_gray_sync1, a_wr_ptr_gray_sync2;\n  reg [ASIZE-1:0] a_rd_ptr_gray_sync1, a_rd_ptr_gray_sync2;\n  reg [ASIZE-1:0] b_wr_ptr_gray_sync1, b_wr_ptr_gray_sync2;\n  reg [ASIZE-1:0] b_rd_ptr_gray_sync1, b_rd_ptr_gray_sync2;\n\n  // Binary conversion of synchronized gray codes\n  wire [PTR_W-1:0] a_wr_ptr_bin_sync;\n  wire [PTR_W-1:0] a_rd_ptr_bin_sync;\n  wire [PTR_W-1:0] b_wr_ptr_bin_sync;\n  wire [PTR_W-1:0] b_rd_ptr_bin_sync;\n\n  // Write enable signals\n  wire a_write_en;\n  wire b_write_en;\n  wire a_read_en;\n  wire b_read_en;\n\n  assign a_write_en = a_dir & a_winc & ~a_full;\n  assign b_write_en = b_dir & b_winc & ~b_full;\n  assign a_read_en  = ~a_dir & a_rinc & ~a_empty;\n  assign b_read_en  = ~b_dir & b_rinc & ~b_empty;\n\n  // Gray code conversion\n  function [ASIZE-1:0] bin2gray;\n    input [PTR_W-1:0] bin;\n    begin\n      bin2gray = bin ^ (bin >> 1);\n    end\n  endfunction\n\n  function [PTR_W-1:0] gray2bin;\n    input [ASIZE-1:0] gray;\n    reg [PTR_W-1:0] bin;\n    integer i;\n    begin\n      bin[PTR_W-1] = gray[ASIZE-1];\n      for (i = ASIZE-2; i >= 0; i = i - 1)\n        bin[i] = bin[i+1] ^ gray[i];\n      gray2bin = bin;\n    end\n  endfunction\n\n  assign a_wr_ptr_gray = bin2gray(a_wr_ptr);\n  assign a_rd_ptr_gray = bin2gray(a_rd_ptr);\n  assign b_wr_ptr_gray = bin2gray(b_wr_ptr);\n  assign b_rd_ptr_gray = bin2gray(b_rd_ptr);\n\n  // Synchronize A write pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_gray_sync1 <= {ASIZE{1'b0}};\n      a_wr_ptr_gray_sync2 <= {ASIZE{1'b0}};\n    end else begin\n      a_wr_ptr_gray_sync1 <= a_wr_ptr_gray;\n      a_wr_ptr_gray_sync2 <= a_wr_ptr_gray_sync1;\n    end\n  end\n\n  // Synchronize A read pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_rd_ptr_gray_sync1 <= {ASIZE{1'b0}};\n      a_rd_ptr_gray_sync2 <= {ASIZE{1'b0}};\n    end else begin\n      a_rd_ptr_gray_sync1 <= a_rd_ptr_gray;\n      a_rd_ptr_gray_sync2 <= a_rd_ptr_gray_sync1;\n    end\n  end\n\n  // Synchronize B write pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_gray_sync1 <= {ASIZE{1'b0}};\n      b_wr_ptr_gray_sync2 <= {ASIZE{1'b0}};\n    end else begin\n      b_wr_ptr_gray_sync1 <= b_wr_ptr_gray;\n      b_wr_ptr_gray_sync2 <= b_wr_ptr_gray_sync1;\n    end\n  end\n\n  // Synchronize B read pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_rd_ptr_gray_sync1 <= {ASIZE{1'b0}};\n      b_rd_ptr_gray_sync2 <= {ASIZE{1'b0}};\n    end else begin\n      b_rd_ptr_gray_sync1 <= b_rd_ptr_gray;\n      b_rd_ptr_gray_sync2 <= b_rd_ptr_gray_sync1;\n    end\n  end\n\n  // Convert synchronized gray codes to binary\n  assign a_wr_ptr_bin_sync = gray2bin(a_wr_ptr_gray_sync2);\n  assign a_rd_ptr_bin_sync = gray2bin(a_rd_ptr_gray_sync2);\n  assign b_wr_ptr_bin_sync = gray2bin(b_wr_ptr_gray_sync2);\n  assign b_rd_ptr_bin_sync = gray2bin(b_rd_ptr_gray_sync2);\n\n  // Update pointers\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {PTR_W{1'b0}};\n      a_rd_ptr <= {PTR_W{1'b0}};\n    end else begin\n      if (a_write_en)\n        a_wr_ptr <= a_wr_ptr + 1'b1;\n      if (a_read_en)\n        a_rd_ptr <= a_rd_ptr + 1'b1;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {PTR_W{1'b0}};\n      b_rd_ptr <= {PTR_W{1'b0}};\n    end else begin\n      if (b_write_en)\n        b_wr_ptr <= b_wr_ptr + 1'b1;\n      if (b_read_en)\n        b_rd_ptr <= b_rd_ptr + 1'b1;\n    end\n  end\n\n  // Memory write\n  always @(posedge a_clk) begin\n    if (a_write_en)\n      mem[a_wr_ptr[ASIZE-1:0]] <= a_wdata;\n  end\n\n  always @(posedge b_clk) begin\n    if (b_write_en)\n      mem[b_wr_ptr[ASIZE-1:0]] <= b_wdata;\n  end\n\n  // Memory read\n  wire [DSIZE-1:0] a_mem_rdata;\n  wire [DSIZE-1:0] b_mem_rdata;\n\n  assign a_mem_rdata = mem[a_rd_ptr[ASIZE-1:0]];\n  assign b_mem_rdata = mem[b_rd_ptr[ASIZE-1:0]];\n\n  // Output data\n  assign a_rdata = a_mem_rdata;\n  assign b_rdata = b_mem_rdata;\n\n  // Status flags\n  // A side: full when A write pointer catches up to B read pointer (synchronized)\n  // Empty when A read pointer catches up to B write pointer (synchronized)\n  wire a_full_internal;\n  wire a_empty_internal;\n  wire b_full_internal;\n  wire b_empty_internal;\n\n  assign a_full_internal  = (a_wr_ptr == b_rd_ptr_bin_sync);\n  assign a_empty_internal = (a_rd_ptr == b_wr_ptr_bin_sync);\n  assign b_full_internal  = (b_wr_ptr == a_rd_ptr_bin_sync);\n  assign b_empty_internal = (b_rd_ptr == a_wr_ptr_bin_sync);\n\n  assign a_full   = a_full_internal;\n  assign b_full   = b_full_internal;\n  assign a_empty  = a_empty_internal;\n  assign b_empty  = b_empty_internal;\n\n  // Almost full/empty\n  wire [PTR_W-1:0] a_fill_level;\n  wire [PTR_W-1:0] b_fill_level;\n\n  assign a_fill_level = a_wr_ptr - b_rd_ptr_bin_sync;\n  assign b_fill_level = b_wr_ptr - a_rd_ptr_bin_sync;\n\n  assign a_afull   = (a_fill_level >= AFULL_THRESH);\n  assign b_afull   = (b_fill_level >= AFULL_THRESH);\n  assign a_aempty  = (a_fill_level <= AEMPTY_THRESH);\n  assign b_aempty  = (b_fill_level <= AEMPTY_THRESH);\n\nendmodule\n```<|im_end|>",
