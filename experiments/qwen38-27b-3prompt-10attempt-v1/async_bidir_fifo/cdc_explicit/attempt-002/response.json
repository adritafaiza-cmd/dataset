  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam PTR_W = ASIZE + 1;\n  localparam AFULL_THRESH  = DEPTH - 2;\n  localparam AEMPTY_THRESH = 1;\n\n  // Internal FIFO storage\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  // Pointers in A domain\n  reg [PTR_W-1:0] a_wr_ptr;\n  reg [PTR_W-1:0] a_rd_ptr;\n\n  // Pointers in B domain\n  reg [PTR_W-1:0] b_wr_ptr;\n  reg [PTR_W-1:0] b_rd_ptr;\n\n  // Synchronized pointers\n  reg [PTR_W-1:0] a_wr_ptr_sync1, a_wr_ptr_sync2;\n  reg [PTR_W-1:0] a_rd_ptr_sync1, a_rd_ptr_sync2;\n  reg [PTR_W-1:0] b_wr_ptr_sync1, b_wr_ptr_sync2;\n  reg [PTR_W-1:0] b_rd_ptr_sync1, b_rd_ptr_sync2;\n\n  // Synchronized reset signals\n  reg a_rst_n_sync1, a_rst_n_sync2;\n  reg b_rst_n_sync1, b_rst_n_sync2;\n\n  // Direction signals synchronized to opposite domain\n  reg a_dir_sync1, a_dir_sync2;\n  reg b_dir_sync1, b_dir_sync2;\n\n  // Write enable signals\n  wire a_write_en;\n  wire b_write_en;\n  wire a_read_en;\n  wire b_read_en;\n\n  // Full/Empty flags\n  wire a_full_int;\n  wire a_empty_int;\n  wire b_full_int;\n  wire b_empty_int;\n\n  // Almost full/empty\n  wire a_afull_int;\n  wire a_aempty_int;\n  wire b_afull_int;\n  wire b_aempty_int;\n\n  // Read data\n  wire [DSIZE-1:0] a_rdata_int;\n  wire [DSIZE-1:0] b_rdata_int;\n\n  // Determine write/read enables based on direction\n  assign a_write_en = a_dir & a_winc;\n  assign a_read_en  = ~a_dir & a_rinc;\n  assign b_write_en = b_dir & b_winc;\n  assign b_read_en  = ~b_dir & b_rinc;\n\n  // Full/Empty detection\n  // A side: full when a_wr_ptr - a_rd_ptr_sync2 == DEPTH\n  // A side: empty when a_wr_ptr_sync2 == a_rd_ptr\n  // B side: full when b_wr_ptr - b_rd_ptr_sync2 == DEPTH\n  // B side: empty when b_wr_ptr_sync2 == b_rd_ptr\n\n  wire [PTR_W-1:0] a_wr_diff;\n  wire [PTR_W-1:0] b_wr_diff;\n\n  assign a_wr_diff = a_wr_ptr - a_rd_ptr_sync2;\n  assign b_wr_diff = b_wr_ptr - b_rd_ptr_sync2;\n\n  assign a_full_int  = (a_wr_diff == DEPTH);\n  assign a_empty_int = (a_wr_ptr_sync2 == a_rd_ptr);\n  assign b_full_int  = (b_wr_diff == DEPTH);\n  assign b_empty_int = (b_wr_ptr_sync2 == b_rd_ptr);\n\n  assign a_afull_int  = (a_wr_diff >= AFULL_THRESH);\n  assign a_aempty_int = (a_wr_diff <= AEMPTY_THRESH);\n  assign b_afull_int  = (b_wr_diff >= AFULL_THRESH);\n  assign b_aempty_int = (b_wr_diff <= AEMPTY_THRESH);\n\n  // Read data\n  assign a_rdata_int = mem[a_rd_ptr[ASIZE-1:0]];\n  assign b_rdata_int = mem[b_rd_ptr[ASIZE-1:0]];\n\n  // Output assignments\n  assign a_rdata  = a_rdata_int;\n  assign a_full   = a_full_int;\n  assign a_afull  = a_afull_int;\n  assign a_empty  = a_empty_int;\n  assign a_aempty = a_aempty_int;\n  assign b_rdata  = b_rdata_int;\n  assign b_full   = b_full_int;\n  assign b_afull  = b_afull_int;\n  assign b_empty  = b_empty_int;\n  assign b_aempty = b_aempty_int;\n\n  // Reset synchronization for A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_rst_n_sync1 <= 1'b0;\n      a_rst_n_sync2 <= 1'b0;\n    end else begin\n      a_rst_n_sync1 <= 1'b1;\n      a_rst_n_sync2 <= a_rst_n_sync1;\n    end\n  end\n\n  // Reset synchronization for B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_rst_n_sync1 <= 1'b0;\n      b_rst_n_sync2 <= 1'b0;\n    end else begin\n      b_rst_n_sync1 <= 1'b1;\n      b_rst_n_sync2 <= b_rst_n_sync1;\n    end\n  end\n\n  // Direction synchronization: a_dir to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_dir_sync1 <= 1'b0;\n      a_dir_sync2 <= 1'b0;\n    end else begin\n      a_dir_sync1 <= a_dir;\n      a_dir_sync2 <= a_dir_sync1;\n    end\n  end\n\n  // Direction synchronization: b_dir to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_dir_sync1 <= 1'b0;\n      b_dir_sync2 <= 1'b0;\n    end else begin\n      b_dir_sync1 <= b_dir;\n      b_dir_sync2 <= b_dir_sync1;\n    end\n  end\n\n  // Pointer synchronization: a_wr_ptr to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_sync1 <= {PTR_W{1'b0}};\n      a_wr_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      a_wr_ptr_sync1 <= a_wr_ptr;\n      a_wr_ptr_sync2 <= a_wr_ptr_sync1;\n    end\n  end\n\n  // Pointer synchronization: a_rd_ptr to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_rd_ptr_sync1 <= {PTR_W{1'b0}};\n      a_rd_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      a_rd_ptr_sync1 <= a_rd_ptr;\n      a_rd_ptr_sync2 <= a_rd_ptr_sync1;\n    end\n  end\n\n  // Pointer synchronization: b_wr_ptr to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_sync1 <= {PTR_W{1'b0}};\n      b_wr_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      b_wr_ptr_sync1 <= b_wr_ptr;\n      b_wr_ptr_sync2 <= b_wr_ptr_sync1;\n    end\n  end\n\n  // Pointer synchronization: b_rd_ptr to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_rd_ptr_sync1 <= {PTR_W-1:0}'(0);\n      b_rd_ptr_sync2 <= {PTR_W-1:0}'(0);\n    end else begin\n      b_rd_ptr_sync1 <= b_rd_ptr;\n      b_rd_ptr_sync2 <= b_rd_ptr_sync1;\n    end\n  end\n\n  // A domain: write pointer and memory write\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {PTR_W{1'b0}};\n    end else if (a_write_en && !a_full_int) begin\n      mem[a_wr_ptr[ASIZE-1:0]] <= a_wdata;\n      a_wr_ptr <= a_wr_ptr + 1'b1;\n    end\n  end\n\n  // A domain: read pointer\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_rd_ptr <= {PTR_W{1'b0}};\n    end else if (a_read_en && !a_empty_int) begin\n      a_rd_ptr <= a_rd_ptr + 1'b1;\n    end\n  end\n\n  // B domain: write pointer and memory write\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {PTR_W{1'b0}};\n    end else if (b_write_en && !b_full_int) begin\n      mem[b_wr_ptr[ASIZE-1:0]] <= b_wdata;\n      b_wr_ptr <= b_wr_ptr + 1'b1;\n    end\n  end\n\n  // B domain: read pointer\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_rd_ptr <= {PTR_W{1'b0}};\n    end else if (b_read_en && !b_empty_int) begin\n      b_rd_ptr <= b_rd_ptr + 1'b1;\n    end\n  end\n\nendmodule\n```<|im_end|>",
