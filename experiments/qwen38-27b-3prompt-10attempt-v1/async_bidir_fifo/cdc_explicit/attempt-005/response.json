  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam PTR_W = ASIZE + 1;\n  localparam AFULL_THRESH  = DEPTH - 2;\n  localparam AEMPTY_THRESH = 1;\n\n  // Internal FIFO storage\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  // Side A pointers (in A clock domain)\n  reg [PTR_W-1:0] a_wr_ptr;\n  reg [PTR_W-1:0] a_rd_ptr;\n\n  // Side B pointers (in B clock domain)\n  reg [PTR_W-1:0] b_wr_ptr;\n  reg [PTR_W-1:0] b_rd_ptr;\n\n  // Synchronized pointers\n  reg [PTR_W-1:0] a_wr_ptr_sync1, a_wr_ptr_sync2;\n  reg [PTR_W-1:0] a_rd_ptr_sync1, a_rd_ptr_sync2;\n  reg [PTR_W-1:0] b_wr_ptr_sync1, b_wr_ptr_sync2;\n  reg [PTR_W-1:0] b_rd_ptr_sync1, b_rd_ptr_sync2;\n\n  // Synchronized direction signals\n  reg a_dir_sync1, a_dir_sync2;\n  reg b_dir_sync1, b_dir_sync2;\n\n  // Synchronized write enable signals\n  reg a_winc_sync1, a_winc_sync2;\n  reg b_winc_sync1, b_winc_sync2;\n\n  // Synchronized read enable signals\n  reg a_rinc_sync1, a_rinc_sync2;\n  reg b_rinc_sync1, b_rinc_sync2;\n\n  // Synchronized write data\n  reg [DSIZE-1:0] a_wdata_sync1, a_wdata_sync2;\n  reg [DSIZE-1:0] b_wdata_sync1, b_wdata_sync2;\n\n  // Effective write/read enables\n  wire a_write_en = a_dir & a_winc;\n  wire a_read_en  = ~a_dir & a_rinc;\n  wire b_write_en = b_dir & b_winc;\n  wire b_read_en  = ~b_dir & b_rinc;\n\n  // Full/empty calculations\n  wire [PTR_W-1:0] a_wr_ptr_sync = a_wr_ptr_sync2;\n  wire [PTR_W-1:0] a_rd_ptr_sync = a_rd_ptr_sync2;\n  wire [PTR_W-1:0] b_wr_ptr_sync = b_wr_ptr_sync2;\n  wire [PTR_W-1:0] b_rd_ptr_sync = b_rd_ptr_sync2;\n\n  // A side: full when write pointer has lapped read pointer by DEPTH\n  wire a_full  = (a_wr_ptr[ASIZE-1:0] == a_rd_ptr_sync[ASIZE-1:0]) &&\n                 (a_wr_ptr[ASIZE] != a_rd_ptr_sync[ASIZE]);\n  wire a_afull = (a_wr_ptr[ASIZE-1:0] == a_rd_ptr_sync[ASIZE-1:0]) &&\n                 (a_wr_ptr[ASIZE] != a_rd_ptr_sync[ASIZE]) ||\n                 ((a_wr_ptr[ASIZE-1:0] + 1) == a_rd_ptr_sync[ASIZE-1:0]) &&\n                 (a_wr_ptr[ASIZE] != a_rd_ptr_sync[ASIZE]);\n\n  // A side: empty when write pointer equals read pointer\n  wire a_empty  = (a_wr_ptr_sync[ASIZE-1:0] == a_rd_ptr[ASIZE-1:0]) &&\n                  (a_wr_ptr_sync[ASIZE] == a_rd_ptr[ASIZE]);\n  wire a_aempty = (a_wr_ptr_sync[ASIZE-1:0] == a_rd_ptr[ASIZE-1:0]) &&\n                  (a_wr_ptr_sync[ASIZE] == a_rd_ptr[ASIZE]) ||\n                  ((a_wr_ptr_sync[ASIZE-1:0] + 1) == a_rd_ptr[ASIZE-1:0]) &&\n                  (a_wr_ptr_sync[ASIZE] == a_rd_ptr[ASIZE]);\n\n  // B side: full when write pointer has lapped read pointer by DEPTH\n  wire b_full  = (b_wr_ptr[ASIZE-1:0] == b_rd_ptr_sync[ASIZE-1:0]) &&\n                 (b_wr_ptr[ASIZE] != b_rd_ptr_sync[ASIZE]);\n  wire b_afull = (b_wr_ptr[ASIZE-1:0] == b_rd_ptr_sync[ASIZE-1:0]) &&\n                 (b_wr_ptr[ASIZE] != b_rd_ptr_sync[ASIZE]) ||\n                 ((b_wr_ptr[ASIZE-1:0] + 1) == b_rd_ptr_sync[ASIZE-1:0]) &&\n                 (b_wr_ptr[ASIZE] != b_rd_ptr_sync[ASIZE]);\n\n  // B side: empty when write pointer equals read pointer\n  wire b_empty  = (b_wr_ptr_sync[ASIZE-1:0] == b_rd_ptr[ASIZE-1:0]) &&\n                  (b_wr_ptr_sync[ASIZE] == b_rd_ptr[ASIZE]);\n  wire b_aempty = (b_wr_ptr_sync[ASIZE-1:0] == b_rd_ptr[ASIZE-1:0]) &&\n                  (b_wr_ptr_sync[ASIZE] == b_rd_ptr[ASIZE]) ||\n                  ((b_wr_ptr_sync[ASIZE-1:0] + 1) == b_rd_ptr[ASIZE-1:0]) &&\n                  (b_wr_ptr_sync[ASIZE] == b_rd_ptr[ASIZE]);\n\n  // Read data\n  wire [DSIZE-1:0] a_rdata_internal = mem[a_rd_ptr[ASIZE-1:0]];\n  wire [DSIZE-1:0] b_rdata_internal = mem[b_rd_ptr[ASIZE-1:0]];\n\n  assign a_rdata = a_rdata_internal;\n  assign b_rdata = b_rdata_internal;\n\n  assign a_full   = a_full;\n  assign a_afull  = a_afull;\n  assign a_empty  = a_empty;\n  assign a_aempty = a_aempty;\n  assign b_full   = b_full;\n  assign b_afull  = b_afull;\n  assign b_empty  = b_empty;\n  assign b_aempty = b_aempty;\n\n  // A clock domain: update pointers\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {PTR_W{1'b0}};\n      a_rd_ptr <= {PTR_W{1'b0}};\n    end else begin\n      if (a_write_en && !a_full)\n        a_wr_ptr <= a_wr_ptr + 1'b1;\n      if (a_read_en && !a_empty)\n        a_rd_ptr <= a_rd_ptr + 1'b1;\n    end\n  end\n\n  // B clock domain: update pointers\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {PTR_W{1'b0}};\n      b_rd_ptr <= {PTR_W{1'b0}};\n    end else begin\n      if (b_write_en && !b_full)\n        b_wr_ptr <= b_wr_ptr + 1'b1;\n      if (b_read_en && !b_empty)\n        b_rd_ptr <= b_rd_ptr + 1'b1;\n    end\n  end\n\n  // Memory writes\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      // No action needed for memory\n    end else if (a_write_en && !a_full) begin\n      mem[a_wr_ptr[ASIZE-1:0]] <= a_wdata;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      // No action needed for memory\n    end else if (b_write_en && !b_full) begin\n      mem[b_wr_ptr[ASIZE-1:0]] <= b_wdata;\n    end\n  end\n\n  // Synchronize A write pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_sync1 <= {PTR_W{1'b0}};\n      a_wr_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      a_wr_ptr_sync1 <= a_wr_ptr;\n      a_wr_ptr_sync2 <= a_wr_ptr_sync1;\n    end\n  end\n\n  // Synchronize A read pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_rd_ptr_sync1 <= {PTR_W{1'b0}};\n      a_rd_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      a_rd_ptr_sync1 <= a_rd_ptr;\n      a_rd_ptr_sync2 <= a_rd_ptr_sync1;\n    end\n  end\n\n  // Synchronize B write pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_sync1 <= {PTR_W{1'b0}};\n      b_wr_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      b_wr_ptr_sync1 <= b_wr_ptr;\n      b_wr_ptr_sync2 <= b_wr_ptr_sync1;\n    end\n  end\n\n  // Synchronize B read pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_rd_ptr_sync1 <= {PTR_W{1'b0}};\n      b_rd_ptr_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      b_rd_ptr_sync1 <= b_rd_ptr;\n      b_rd_ptr_sync2 <= b_rd_ptr_sync1;\n    end\n  end\n\nendmodule\n```<|im_end|>",
