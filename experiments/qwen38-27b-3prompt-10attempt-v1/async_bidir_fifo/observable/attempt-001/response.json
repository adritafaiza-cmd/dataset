  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam AWIDTH = ASIZE;\n  localparam DEPTH  = 1 << AWIDTH;\n  localparam AFULL_THRESH  = DEPTH - 2;\n  localparam AEMPTY_THRESH = 1;\n\n  // Internal FIFO memory\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  // Direction registers (synchronized to each clock domain)\n  reg a_dir_reg;\n  reg b_dir_reg;\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_dir_reg <= 1'b0;\n    else\n      a_dir_reg <= a_dir;\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_dir_reg <= 1'b0;\n    else\n      b_dir_reg <= b_dir;\n  end\n\n  // Write pointer in A domain\n  reg [AWIDTH:0] a_wr_ptr;\n  // Read pointer in A domain\n  reg [AWIDTH:0] a_rd_ptr;\n\n  // Write pointer in B domain\n  reg [AWIDTH:0] b_wr_ptr;\n  // Read pointer in B domain\n  reg [AWIDTH:0] b_rd_ptr;\n\n  // Synchronized pointers for status generation\n  // A domain: synchronized B pointers\n  reg [AWIDTH:0] b_wr_ptr_sync1, b_wr_ptr_sync2, b_wr_ptr_sync3;\n  reg [AWIDTH:0] b_rd_ptr_sync1, b_rd_ptr_sync2, b_rd_ptr_sync3;\n\n  // B domain: synchronized A pointers\n  reg [AWIDTH:0] a_wr_ptr_sync1, a_wr_ptr_sync2, a_wr_ptr_sync3;\n  reg [AWIDTH:0] a_rd_ptr_sync1, a_rd_ptr_sync2, a_rd_ptr_sync3;\n\n  // Synchronize B write pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_sync1 <= {(AWIDTH+1){1'b0}};\n      b_wr_ptr_sync2 <= {(AWIDTH+1){1'b0}};\n      b_wr_ptr_sync3 <= {(AWIDTH+1){1'b0}};\n    end else begin\n      b_wr_ptr_sync1 <= b_wr_ptr;\n      b_wr_ptr_sync2 <= b_wr_ptr_sync1;\n      b_wr_ptr_sync3 <= b_wr_ptr_sync2;\n    end\n  end\n\n  // Synchronize B read pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_rd_ptr_sync1 <= {(AWIDTH+1){1'b0}};\n      b_rd_ptr_sync2 <= {(AWIDTH+1){1'b0}};\n      b_rd_ptr_sync3 <= {(AWIDTH+1){1'b0}};\n    end else begin\n      b_rd_ptr_sync1 <= b_rd_ptr;\n      b_rd_ptr_sync2 <= b_rd_ptr_sync1;\n      b_rd_ptr_sync3 <= b_rd_ptr_sync2;\n    end\n  end\n\n  // Synchronize A write pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_sync1 <= {(AWIDTH+1){1'b0}};\n      a_wr_ptr_sync2 <= {(AWIDTH+1){1'b0}};\n      a_wr_ptr_sync3 <= {(AWIDTH+1){1'b0}};\n    end else begin\n      a_wr_ptr_sync1 <= a_wr_ptr;\n      a_wr_ptr_sync2 <= a_wr_ptr_sync1;\n      a_wr_ptr_sync3 <= a_wr_ptr_sync2;\n    end\n  end\n\n  // Synchronize A read pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_rd_ptr_sync1 <= {(AWIDTH+1){1'b0}};\n      a_rd_ptr_sync2 <= {(AWIDTH+1){1'b0}};\n      a_rd_ptr_sync3 <= {(AWIDTH+1){1'b0}};\n    end else begin\n      a_rd_ptr_sync1 <= a_rd_ptr;\n      a_rd_ptr_sync2 <= a_rd_ptr_sync1;\n      a_rd_ptr_sync3 <= a_rd_ptr_sync2;\n    end\n  end\n\n  // Determine effective write/read pointers based on direction\n  // When a_dir_reg == 0: A is writing, B is reading\n  // When a_dir_reg == 1: A is reading, B is writing\n\n  // A domain:\n  // If a_dir_reg == 0 (A writes): A write pointer is a_wr_ptr, A read pointer is b_rd_ptr_sync3\n  // If a_dir_reg == 1 (A reads):  A write pointer is b_wr_ptr_sync3, A read pointer is a_rd_ptr\n\n  wire a_is_writer = ~a_dir_reg;\n  wire a_is_reader = a_dir_reg;\n\n  // Effective write pointer for A domain (who is writing into the shared FIFO)\n  wire [AWIDTH:0] a_eff_wr_ptr = a_is_writer ? a_wr_ptr : b_wr_ptr_sync3;\n  // Effective read pointer for A domain (who is reading from the shared FIFO)\n  wire [AWIDTH:0] a_eff_rd_ptr = a_is_reader ? a_rd_ptr : b_rd_ptr_sync3;\n\n  // B domain:\n  // If b_dir_reg == 0 (B writes): B write pointer is b_wr_ptr, B read pointer is a_rd_ptr_sync3\n  // If b_dir_reg == 1 (B reads):  B write pointer is a_wr_ptr_sync3, B read pointer is b_rd_ptr\n\n  wire b_is_writer = ~b_dir_reg;\n  wire b_is_reader = b_dir_reg;\n\n  wire [AWIDTH+1:0] a_diff = a_eff_wr_ptr - a_eff_rd_ptr;\n  wire [AWIDTH+1:0] b_diff = b_eff_wr_ptr - b_eff_rd_ptr;\n\n  // Full/Empty status\n  // Full when write pointer has lapped read pointer by DEPTH\n  // Empty when write pointer equals read pointer\n\n  assign a_full   = (a_diff == DEPTH);\n  assign a_empty  = (a_diff == 0);\n  assign a_afull  = (a_diff >= AFULL_THRESH);\n  assign a_aempty = (a_diff <= AEMPTY_THRESH);\n\n  assign b_full   = (b_diff == DEPTH);\n  assign b_empty  = (b_diff == 0);\n  assign b_afull  = (b_diff >= AFULL_THRESH);\n  assign b_aempty = (b_diff <= AEMPTY_THRESH);\n\n  // Write enable for A domain\n  wire a_write_en = a_is_writer && a_winc && !a_full;\n  // Read enable for A domain\n  wire a_read_en  = a_is_reader && a_rinc && !a_empty;\n\n  // Write enable for B domain\n  wire b_write_en = b_is_writer && b_winc && !b_full;\n  // Read enable for B domain\n  wire b_read_en  = b_is_reader && b_rinc && !b_empty;\n\n  // Update A write pointer\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_wr_ptr <= {(AWIDTH+1){1'b0}};\n    else if (a_write_en)\n      a_wr_ptr <= a_wr_ptr + 1'b1;\n  end\n\n  // Update A read pointer\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_rd_ptr <= {(AWIDTH+1){1'b0}};\n    else if (a_read_en)\n      a_rd_ptr <= a_rd_ptr + 1'b1;\n  end\n\n  // Update B write pointer\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_wr_ptr <= {(AWIDTH+1){1'b0}};\n    else if (b_write_en)\n      b_wr_ptr <= b_wr_ptr + 1'b1;\n  end\n\n  // Update B read pointer\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_rd_ptr <= {(AWIDTH+1){1'b0}};\n    else if (b_read_en)\n      b_rd_ptr <= b_rd_ptr + 1'b1;\n  end\n\n  // Memory write\n  // A writes when a_is_writer\n  // B writes when b_is_writer\n  // Only one side can be writer at a time (direction is exclusive)\n  // But we need to handle the case where both could potentially write if directions are misconfigured.\n  // Per spec, direction selects which side writes. We assume valid direction.\n\n  always @(posedge a_clk) begin\n    if (a_write_en)\n      mem[a_wr_ptr[AWIDTH-1:0]] <= a_wdata;\n  end\n\n  always @(posedge b_clk) begin\n    if (b_write_en)\n      mem[b_wr_ptr[AWIDTH-1:0]] <= b_wdata;\n  end\n\n  // Read data\n  // A reads when a_is_reader\n  // B reads when b_is_reader\n\n  // For fall-through: if FALLTHROUGH is \"TRUE\", the read data is combinational from memory\n  // The read pointer used for data is the current effective read pointer\n\n  wire [AWIDTH-1:0] a_rd_addr = a_eff_rd_ptr[AWIDTH-1:0];\n  wire [AWIDTH-1:0] b_rd_addr = b_eff_rd_ptr[AWIDTH-1:0];\n\n  reg [DSIZE-1:0] a_rdata_reg;\n  reg [DSIZE-1:0] b_rdata_reg;\n\n  // A read data\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_rdata_reg <= {DSIZE{1'b0}};\n    else if (a_read_en)\n      a_rdata_reg <= mem[a_rd_addr];\n  end\n\n  // B read data\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_rdata_reg <= {DSIZE{1'b0}};\n    else if (b_read_en)\n      b_rdata_reg <= mem[b_rd_addr];\n  end\n\n  // Fall-through: combinational read\n  // When FALLTHROUGH is \"TRUE\", output is combinational from memory at current read address\n  // When FALLTHROUGH is not \"TRUE\", output is registered\n\n  wire fallthrough_en = (FALLTHROUGH == \"TRUE\");\n\n  assign a_rdata = fallthrough_en ? mem[a_rd_addr] : a_rdata_reg;\n  assign b_rdata = fallthrough_en ? mem[b_rd_addr] : b_rdata_reg;\n\nendmodule\n```<|im_end|>",
