  "text": "```verilog\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam AWIDTH = ASIZE;\n  localparam DEPTH  = 1 << AWIDTH;\n  localparam AFULL_THRESH  = DEPTH - 2;\n  localparam AEMPTY_THRESH = 1;\n\n  // Internal FIFO storage\n  reg [DSIZE-1:0] mem [0:DEPTH-1];\n\n  // Direction registers (synchronized to local clock)\n  reg a_dir_r;\n  reg b_dir_r;\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_dir_r <= 1'b0;\n    else\n      a_dir_r <= a_dir;\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_dir_r <= 1'b0;\n    else\n      b_dir_r <= b_dir;\n  end\n\n  // Write pointer in A domain\n  reg [AWIDTH:0] a_wr_ptr;\n  // Read pointer in A domain (for A reading)\n  reg [AWIDTH:0] a_rd_ptr;\n\n  // Write pointer in B domain\n  reg [AWIDTH:0] b_wr_ptr;\n  // Read pointer in B domain (for B reading)\n  reg [AWIDTH:0] b_rd_ptr;\n\n  // Synchronized pointers for status generation\n  // A domain: synchronized B pointers\n  reg [AWIDTH:0] b_wr_ptr_a;\n  reg [AWIDTH:0] b_rd_ptr_a;\n\n  // B domain: synchronized A pointers\n  reg [AWIDTH:0] a_wr_ptr_b;\n  reg [AWIDTH:0] a_rd_ptr_b;\n\n  // Synchronization of A write pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      a_wr_ptr_b <= {(AWIDTH+1){1'b0}};\n    else\n      a_wr_ptr_b <= a_wr_ptr;\n  end\n\n  // Synchronization of A read pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      a_rd_ptr_b <= {(AWIDTH+1){1'b0}};\n    else\n      a_rd_ptr_b <= a_rd_ptr;\n  end\n\n  // Synchronization of B write pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      b_wr_ptr_a <= {(AWIDTH+1){1'b0}};\n    else\n      b_wr_ptr_a <= b_wr_ptr;\n  end\n\n  // Synchronization of B read pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      b_rd_ptr_a <= {(AWIDTH+1){1'b0}};\n    else\n      b_rd_ptr_a <= b_rd_ptr;\n  end\n\n  // Determine effective write/read pointers based on direction\n  // When a_dir_r == 0: A is writing, B is reading\n  // When a_dir_r == 1: A is reading, B is writing\n\n  // A side:\n  // If a_dir_r == 0 (A writes):\n  //   A write pointer = a_wr_ptr\n  //   A read pointer  = b_rd_ptr_a (B is reading, so B's read pointer is the FIFO read pointer)\n  // If a_dir_r == 1 (A reads):\n  //   A write pointer = b_wr_ptr_a (B is writing)\n  //   A read pointer  = a_rd_ptr\n\n  wire a_is_writer = ~a_dir_r;\n  wire a_is_reader = a_dir_r;\n\n  wire [AWIDTH:0] a_eff_wr_ptr = a_is_writer ? a_wr_ptr : b_wr_ptr_a;\n  wire [AWIDTH:0] a_eff_rd_ptr = a_is_writer ? b_rd_ptr_a : a_rd_ptr;\n\n  // B side:\n  // If b_dir_r == 0 (B writes):\n  //   B write pointer = b_wr_ptr\n  //   B read pointer  = a_rd_ptr_b (A is reading)\n  // If b_dir_r == 1 (B reads):\n  //   B write pointer = a_wr_ptr_b (A is writing)\n  //   B read pointer  = b_rd_ptr\n\n  wire b_is_writer = ~b_dir_r;\n  wire b_is_reader = b_dir_r;\n\n  wire [AWIDTH:0] b_eff_wr_ptr = b_is_writer ? b_wr_ptr : a_wr_ptr_b;\n  wire [AWIDTH:0] b_eff_rd_ptr = b_is_writer ? a_rd_ptr_b : b_rd_ptr;\n\n  // Full/Empty status\n  // Full: write pointer has lapped read pointer by DEPTH\n  // Empty: write pointer equals read pointer\n\n  wire a_full  = (a_eff_wr_ptr[AWIDTH-1:0] == a_eff_rd_ptr[AWIDTH-1:0]) &&\n                 (a_eff_wr_ptr[AWIDTH] != a_eff_rd_ptr[AWIDTH]);\n  wire a_empty = (a_eff_wr_ptr == a_eff_rd_ptr);\n\n  wire b_full  = (b_eff_wr_ptr[AWIDTH-1:0] == b_eff_rd_ptr[AWIDTH-1:0]) &&\n                 (b_eff_wr_ptr[AWIDTH] != b_eff_rd_ptr[AWIDTH]);\n  wire b_empty = (b_eff_wr_ptr == b_eff_rd_ptr);\n\n  // Almost full/empty\n  wire [AWIDTH:0] a_fill_level = a_eff_wr_ptr - a_eff_rd_ptr;\n  wire [AWIDTH:0] b_fill_level = b_eff_wr_ptr - b_eff_rd_ptr;\n\n  wire a_afull  = (a_fill_level >= AFULL_THRESH[AWIDTH:0]);\n  wire a_aempty = (a_fill_level <= AEMPTY_THRESH[AWIDTH:0]);\n\n  wire b_afull  = (b_fill_level >= AFULL_THRESH[AWIDTH:0]);\n  wire b_aempty = (b_fill_level <= AEMPTY_THRESH[AWIDTH:0]);\n\n  // Write enable\n  wire a_we = a_winc & a_is_writer & ~a_full;\n  wire b_we = b_winc & b_is_writer & ~b_full;\n\n  // Read enable\n  wire a_re = a_rinc & a_is_reader & ~a_empty;\n  wire b_re = b_rinc & b_is_reader & ~b_empty;\n\n  // Update pointers\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {(AWIDTH+1){1'b0}};\n      a_rd_ptr <= {(AWIDTH+1){1'b0}};\n    end else begin\n      if (a_we)\n        a_wr_ptr <= a_wr_ptr + 1'b1;\n      if (a_re)\n        a_rd_ptr <= a_rd_ptr + 1'b1;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {(AWIDTH+1){1'b0}};\n      b_rd_ptr <= {(AWIDTH+1){1'b0}};\n    end else begin\n      if (b_we)\n        b_wr_ptr <= b_wr_ptr + 1'b1;\n      if (b_re)\n        b_rd_ptr <= b_rd_ptr + 1'b1;\n    end\n  end\n\n  // Memory write\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (a_we)\n      mem[a_wr_ptr[AWIDTH-1:0]] <= a_wdata;\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (b_we)\n      mem[b_wr_ptr[AWIDTH-1:0]] <= b_wdata;\n  end\n\n  // Memory read\n  // A reads from a_rd_ptr when a_is_reader\n  // B reads from b_rd_ptr when b_is_reader\n\n  reg [DSIZE-1:0] a_rdata_r;\n  reg [DSIZE-1:0] b_rdata_r;\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_rdata_r <= {DSIZE{1'b0}};\n    else if (a_re)\n      a_rdata_r <= mem[a_rd_ptr[AWIDTH-1:0]];\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_rdata_r <= {DSIZE{1'b0}};\n    else if (b_re)\n      b_rdata_r <= mem[b_rd_ptr[AWIDTH-1:0]];\n  end\n\n  // Fall-through: combinational read if FALLTHROUGH is \"TRUE\"\n  // When fall-through is enabled, if the FIFO is not empty and a read is requested,\n  // the data is available combinationally. Otherwise, use the registered data.\n\n  wire fallthrough_en = (FALLTHROUGH == \"TRUE\");\n\n  // For A: if fall-through enabled and a_is_reader and not empty, read combinationally\n  wire [DSIZE-1:0] a_rdata_comb = mem[a_eff_rd_ptr[AWIDTH-1:0]];\n  wire [DSIZE-1:0] b_rdata_comb = mem[b_eff_rd_ptr[AWIDTH-1:0]];\n\n  assign a_rdata = (fallthrough_en && a_is_reader && ~a_empty) ? a_rdata_comb : a_rdata_r;\n  assign b_rdata = (fallthrough_en && b_is_reader && ~b_empty) ? b_rdata_comb : b_rdata_r;\n\n  // Status outputs\n  assign a_full   = a_full;\n  assign a_afull  = a_afull;\n  assign a_empty  = a_empty;\n  assign a_aempty = a_aempty;\n\n  assign b_full   = b_full;\n  assign b_afull  = b_afull;\n  assign b_empty  = b_empty;\n  assign b_aempty = b_aempty;\n\nendmodule\n```<|im_end|>",
