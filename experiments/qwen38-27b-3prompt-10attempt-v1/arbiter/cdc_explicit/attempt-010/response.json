  "text": "```verilog\nmodule arbiter #\n(\n    parameter PORTS = 4,\n    parameter ARB_TYPE_ROUND_ROBIN = 0,\n    parameter ARB_BLOCK = 0,\n    parameter ARB_BLOCK_ACK = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 0\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    input  wire [PORTS-1:0]         request,\n    input  wire [PORTS-1:0]         acknowledge,\n    output wire [PORTS-1:0]         grant,\n    output wire                     grant_valid,\n    output wire [$clog2(PORTS)-1:0] grant_encoded\n);\n\n    localparam ENC_WIDTH = $clog2(PORTS);\n\n    // Internal signals\n    wire [PORTS-1:0] grant_comb;\n    wire             grant_valid_comb;\n    wire [ENC_WIDTH-1:0] grant_encoded_comb;\n\n    // State for round-robin and blocking\n    reg [PORTS-1:0] rr_mask;\n    reg [PORTS-1:0] blocked_grant;\n    reg             blocked_valid;\n\n    // Combinational logic for grant calculation\n    // First, determine the candidate request based on blocking mode\n    wire [PORTS-1:0] effective_request;\n    \n    generate\n        if (ARB_BLOCK) begin\n            // If blocked, only the previously granted port can be granted\n            // unless the block condition is released\n            assign effective_request = blocked_valid ? blocked_grant : request;\n        end else begin\n            assign effective_request = request;\n        end\n    endgenerate\n\n    // Priority encoding logic\n    // We need to select one port from effective_request\n    // If ARB_TYPE_ROUND_ROBIN, use rr_mask to rotate priority\n    // If ARB_LSB_HIGH_PRIORITY, LSB has highest priority\n    \n    wire [PORTS-1:0] masked_request;\n    \n    generate\n        if (ARB_TYPE_ROUND_ROBIN) begin\n            // Rotate the request based on rr_mask\n            // rr_mask indicates which ports have lower priority\n            // We want to give priority to ports that are NOT in rr_mask first\n            // Actually, a common approach: \n            // Let's define rr_mask as the mask of ports that have been granted recently\n            // and should have lower priority.\n            // So, first try ports where rr_mask is 0, then ports where rr_mask is 1.\n            \n            wire [PORTS-1:0] high_priority_req = effective_request & ~rr_mask;\n            wire [PORTS-1:0] low_priority_req  = effective_request & rr_mask;\n            \n            wire [PORTS-1:0] selected_req = high_priority_req | low_priority_req;\n            \n            // But we need to pick the highest priority one.\n            // If high_priority_req is non-zero, pick from it.\n            // Otherwise, pick from low_priority_req.\n            \n            wire hp_valid = |high_priority_req;\n            \n            assign masked_request = hp_valid ? high_priority_req : low_priority_req;\n        end else begin\n            assign masked_request = effective_request;\n        end\n    endgenerate\n\n    // Now, encode the selected request to a one-hot grant\n    // We need to pick the highest priority bit from masked_request\n    // If ARB_LSB_HIGH_PRIORITY, the LSB (bit 0) has highest priority\n    // Otherwise, the MSB (bit PORTS-1) has highest priority\n    \n    wire [PORTS-1:0] grant_onehot;\n    \n    generate\n        if (ARB_LSB_HIGH_PRIORITY) begin\n            // LSB has highest priority\n            // Find the lowest set bit in masked_request\n            // This is equivalent to: masked_request & (~masked_request + 1)\n            // But we need to be careful with width.\n            \n            wire [PORTS:0] temp = {1'b0, masked_request} + ~masked_request + 1'b1;\n            // Actually, simpler: \n            // lowest_set_bit = masked_request & (~masked_request + 1)\n            // But ~masked_request is PORTS bits wide.\n            \n            // Let's use a different approach:\n            // For each bit i, it is selected if masked_request[i] is 1 and all bits j < i are 0.\n            \n            genvar i;\n            for (i = 0; i < PORTS; i = i + 1) begin : lsb_priority\n                wire [i-1:0] lower_bits = (i > 0) ? masked_request[i-1:0] : {1{1'b0}};\n                wire lower_zero = (i == 0) ? 1'b1 : ~(|lower_bits);\n                assign grant_onehot[i] = masked_request[i] & lower_zero;\n            end\n        end else begin\n            // MSB has highest priority\n            // Find the highest set bit in masked_request\n            // For each bit i, it is selected if masked_request[i] is 1 and all bits j > i are 0.\n            \n            genvar i;\n            for (i = 0; i < PORTS; i = i + 1) begin : msb_priority\n                wire [PORTS-1:i+1] higher_bits = (i < PORTS-1) ? masked_request[PORTS-1:i+1] : {1{1'b0}};\n                wire higher_zero = (i == PORTS-1) ? 1'b1 : ~(|higher_bits);\n                assign grant_onehot[i] = masked_request[i] & higher_zero;\n            end\n        end\n    endgenerate\n\n    assign grant_comb = grant_onehot;\n    assign grant_valid_comb = |grant_onehot;\n    \n    // Encode one-hot to binary\n    // Simple encoder\n    reg [ENC_WIDTH-1:0] enc_temp;\n    integer j;\n    always @* begin\n        enc_temp = {ENC_WIDTH{1'b0}};\n        for (j = 0; j < PORTS; j = j + 1) begin\n            if (grant_onehot[j]) begin\n                enc_temp = j[ENC_WIDTH-1:0];\n            end\n        end\n    end\n    assign grant_encoded_comb = enc_temp;\n\n    // Sequential logic for state\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            rr_mask <= {PORTS{1'b0}};\n            blocked_grant <= {PORTS{1'b0}};\n            blocked_valid <= 1'b0;\n        end else begin\n            // Update round-robin mask\n            if (ARB_TYPE_ROUND_ROBIN) begin\n                if (grant_valid_comb) begin\n                    // Set the bit for the granted port in rr_mask\n                    // This gives it lower priority next time\n                    rr_mask <= rr_mask | grant_comb;\n                end\n            end\n            \n            // Update blocking state\n            if (ARB_BLOCK) begin\n                if (grant_valid_comb) begin\n                    blocked_grant <= grant_comb;\n                    blocked_valid <= 1'b1;\n                end else if (blocked_valid) begin\n                    // Check if block should be released\n                    if (ARB_BLOCK_ACK) begin\n                        // Release when acknowledge is received\n                        if (|acknowledge) begin\n                            blocked_valid <= 1'b0;\n                        end\n                    end else begin\n                        // Release when request drops\n                        if (!(blocked_grant & request)) begin\n                            blocked_valid <= 1'b0;\n                        end\n                    end\n                end\n            end\n        end\n    end\n\n    // Output assignments\n    assign grant = grant_comb;\n    assign grant_valid = grant_valid_comb;\n    assign grant_encoded = grant_encoded_comb;\n\nendmodule\n```<|im_end|>",
