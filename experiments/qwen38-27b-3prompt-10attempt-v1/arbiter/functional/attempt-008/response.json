  "text": "```verilog\nmodule arbiter #\n(\n    parameter PORTS = 4,\n    parameter ARB_TYPE_ROUND_ROBIN = 0,\n    parameter ARB_BLOCK = 0,\n    parameter ARB_BLOCK_ACK = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 0\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    input  wire [PORTS-1:0]         request,\n    input  wire [PORTS-1:0]         acknowledge,\n    output wire [PORTS-1:0]         grant,\n    output wire                     grant_valid,\n    output wire [$clog2(PORTS)-1:0] grant_encoded\n);\n\n    localparam NUM_BITS = $clog2(PORTS);\n\n    reg [PORTS-1:0] grant_reg;\n    reg [NUM_BITS-1:0] grant_encoded_reg;\n    reg grant_valid_reg;\n\n    // For round-robin, track the last granted port\n    reg [NUM_BITS-1:0] last_grant;\n\n    // Internal signals for arbitration\n    wire [PORTS-1:0] arb_request;\n    wire [PORTS-1:0] arb_grant;\n    wire arb_valid;\n    wire [NUM_BITS-1:0] arb_encoded;\n\n    // Function to find the first set bit (LSB) or last set bit (MSB) depending on priority\n    // We'll implement priority encoder logic\n\n    // For fixed priority:\n    // If ARB_LSB_HIGH_PRIORITY, LSB has highest priority\n    // Otherwise, MSB has highest priority\n\n    // For round-robin:\n    // Rotate the request vector so that the port after last_grant has highest priority\n\n    // Let's compute the grant based on the mode\n\n    // First, determine the effective request for arbitration\n    // In blocking mode, we hold the grant until release condition\n\n    // Let's create a combinational block to compute the next grant\n\n    // Priority encoder for fixed priority\n    // LSB high priority: find lowest index with request\n    // MSB high priority: find highest index with request\n\n    // For round-robin, we rotate the request vector\n\n    // Let's define helper functions\n\n    // Function to get the index of the first (LSB) set bit\n    function [NUM_BITS-1:0] find_lsb;\n        input [PORTS-1:0] vec;\n        integer i;\n        begin\n            find_lsb = 0;\n            for (i = 0; i < PORTS; i = i + 1) begin\n                if (vec[i]) begin\n                    find_lsb = i[NUM_BITS-1:0];\n                    disable find_lsb;\n                end\n            end\n        end\n    endfunction\n\n    // Function to get the index of the last (MSB) set bit\n    function [NUM_BITS-1:0] find_msb;\n        input [PORTS-1:0] vec;\n        integer i;\n        begin\n            find_msb = 0;\n            for (i = PORTS-1; i >= 0; i = i - 1) begin\n                if (vec[i]) begin\n                    find_msb = i[NUM_BITS-1:0];\n                    disable find_msb;\n                end\n            end\n        end\n    endfunction\n\n    // For round-robin, we need to rotate the request vector\n    // The port after last_grant should have highest priority\n    // We can do this by rotating the request vector left by (last_grant + 1) positions\n    // Then finding the LSB (or MSB depending on ARB_LSB_HIGH_PRIORITY) of the rotated vector\n    // Then rotating the index back\n\n    // Let's compute the rotated request\n    wire [PORTS-1:0] rotated_request;\n    wire [NUM_BITS-1:0] rotation_amount;\n\n    assign rotation_amount = (last_grant + 1) % PORTS;\n\n    // Rotate left by rotation_amount\n    // rotated_request[i] = request[(i - rotation_amount + PORTS) % PORTS]\n    genvar gi;\n    generate\n        for (gi = 0; gi < PORTS; gi = gi + 1) begin : gen_rot\n            assign rotated_request[gi] = request[(gi - rotation_amount + PORTS) % PORTS];\n        end\n    endgenerate\n\n    // Now compute the grant based on the mode\n    // We'll use a combinational block\n\n    wire [PORTS-1:0] next_grant;\n    wire next_valid;\n    wire [NUM_BITS-1:0] next_encoded;\n\n    // Determine which request vector to use and which priority scheme\n    // For round-robin: use rotated_request, and the priority is based on ARB_LSB_HIGH_PRIORITY\n    //   If ARB_LSB_HIGH_PRIORITY, LSB of rotated_request wins -> corresponds to the port right after last_grant\n    //   If not ARB_LSB_HIGH_PRIORITY, MSB of rotated_request wins -> corresponds to the port farthest from last_grant\n    // For fixed priority: use request, and priority is based on ARB_LSB_HIGH_PRIORITY\n\n    // Let's compute the grant index in the rotated space for round-robin\n    wire [NUM_BITS-1:0] rotated_grant_idx;\n    wire rotated_valid;\n\n    // For round-robin with ARB_LSB_HIGH_PRIORITY: find LSB of rotated_request\n    // For round-robin without ARB_LSB_HIGH_PRIORITY: find MSB of rotated_request\n    // For fixed priority with ARB_LSB_HIGH_PRIORITY: find LSB of request\n    // For fixed priority without ARB_LSB_HIGH_PRIORITY: find MSB of request\n\n    // We can use conditional logic\n\n    // Let's compute both possibilities and select\n\n    wire [NUM_BITS-1:0] lsb_idx_rotated;\n    wire [NUM_BITS-1:0] msb_idx_rotated;\n    wire [NUM_BITS-1:0] lsb_idx_fixed;\n    wire [NUM_BITS-1:0] msb_idx_fixed;\n\n    assign lsb_idx_rotated = find_lsb(rotated_request);\n    assign msb_idx_rotated = find_msb(rotated_request);\n    assign lsb_idx_fixed = find_lsb(request);\n    assign msb_idx_fixed = find_msb(request);\n\n    // For round-robin, the actual grant index is (rotated_grant_idx + rotation_amount) % PORTS\n    // Because we rotated left by rotation_amount, so index i in rotated corresponds to (i + rotation_amount) % PORTS in original\n\n    wire [NUM_BITS-1:0] rr_grant_idx;\n    wire rr_valid;\n\n    // Select the rotated grant index based on ARB_LSB_HIGH_PRIORITY\n    wire [NUM_BITS-1:0] sel_rotated_idx;\n    assign sel_rotated_idx = ARB_LSB_HIGH_PRIORITY ? lsb_idx_rotated : msb_idx_rotated;\n\n    // Convert from rotated index to original index\n    // original_idx = (sel_rotated_idx + rotation_amount) % PORTS\n    wire [NUM_BITS:0] rr_sum;\n    assign rr_sum = sel_rotated_idx + rotation_amount;\n    assign rr_grant_idx = rr_sum[NUM_BITS-1:0]; // Since PORTS is power of 2, modulo is just taking lower bits\n    assign rr_valid = |rotated_request;\n\n    // For fixed priority\n    wire [NUM_BITS-1:0] fp_grant_idx;\n    wire fp_valid;\n\n    assign fp_grant_idx = ARB_LSB_HIGH_PRIORITY ? lsb_idx_fixed : msb_idx_fixed;\n    assign fp_valid = |request;\n\n    // Select between round-robin and fixed priority\n    wire [NUM_BITS-1:0] comb_grant_idx;\n    wire comb_valid;\n\n    assign comb_grant_idx = ARB_TYPE_ROUND_ROBIN ? rr_grant_idx : fp_grant_idx;\n    assign comb_valid = ARB_TYPE_ROUND_ROBIN ? rr_valid : fp_valid;\n\n    // Now handle blocking\n    // If ARB_BLOCK is set, hold the grant until:\n    //   If ARB_BLOCK_ACK is nonzero: until acknowledge for the granted port is asserted\n    //   If ARB_BLOCK_ACK is zero: until the request for the granted port drops\n\n    // We need to track the current grant state\n\n    // Let's use a state machine approach\n    // State: IDLE or BLOCKED\n    // In IDLE: grant is combinational from request\n    // In BLOCKED: grant is held\n\n    // Actually, let's think about this more carefully.\n    // The grant output should reflect the current grant.\n    // In non-blocking mode, grant is purely combinational.\n    // In blocking mode, once a grant is given, it's held until the release condition.\n\n    // Let's use a register to hold the grant in blocking mode\n\n    // For simplicity, let's always use a register for the grant, and update it based on the mode\n\n    // In non-blocking mode: grant_reg <= comb_grant (combinational)\n    // In blocking mode: \n    //   If not currently blocked, and comb_valid, then grant_reg <= comb_grant, enter blocked state\n    //   If currently blocked, check release condition\n    //     If ARB_BLOCK_ACK: release when acknowledge[grant_reg] is asserted\n    //     If not ARB_BLOCK_ACK: release when request[grant_reg] is deasserted\n    //   When released, grant_reg <= 0, exit blocked state\n\n    // Let's implement this\n\n    reg blocked;\n\n    // One-hot grant from index\n    function [PORTS-1:0] idx_to_onehot;\n        input [NUM_BITS-1:0] idx;\n        integer i;\n        begin\n            idx_to_onehot = 0;\n            for (i = 0; i < PORTS; i = i + 1) begin\n                if (i == idx) begin\n                    idx_to_onehot[i] = 1;\n                    disable idx_to_onehot;\n                end\n            end\n        end\n    endfunction\n\n    wire [PORTS-1:0] comb_grant_onehot;\n    assign comb_grant_onehot = comb_valid ? idx_to_onehot(comb_grant_idx) : 0;\n\n    // Release condition for blocking\n    wire release;\n    wire ack_release;\n    wire req_release;\n\n    assign ack_release = acknowledge[grant_encoded_reg];\n    assign req_release = ~request[grant_encoded_reg];\n\n    assign release = ARB_BLOCK_ACK ? ack_release : req_release;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            grant_reg <= 0;\n            grant_encoded_reg <= 0;\n            grant_valid_reg <= 0;\n            blocked <= 0;\n            last_grant <= 0;\n        end else begin\n            if (ARB_BLOCK) begin\n                if (!blocked) begin\n                    if (comb_valid) begin\n                        grant_reg <= comb_grant_onehot;\n                        grant_encoded_reg <= comb_grant_idx;\n                        grant_valid_reg <= 1;\n                        blocked <= 1;\n                        last_grant <= comb_grant_idx;\n                    end else begin\n                        grant_reg <= 0;\n                        grant_encoded_reg <= 0;\n                        grant_valid_reg <= 0;\n                    end\n                end else begin\n                    // Currently blocked\n                    if (release) begin\n                        grant_reg <= 0;\n                        grant_encoded_reg <= 0;\n                        grant_valid_reg <= 0;\n                        blocked <= 0;\n                    end else begin\n                        // Hold the grant\n                        // grant_reg, grant_encoded_reg, grant_valid_reg remain unchanged\n                    end\n                end\n            end else begin\n                // Non-blocking mode\n                if (comb_valid) begin\n                    grant_reg <= comb_grant_onehot;\n                    grant_encoded_reg <= comb_grant_idx;\n                    grant_valid_reg <= 1;\n                    last_grant <= comb_grant_idx;\n                end else begin\n                    grant_reg <= 0;\n                    grant_encoded_reg <= 0;\n                    grant_valid_reg <= 0;\n                end\n            end\n        end\n    end\n\n    assign grant = grant_reg;\n    assign grant_valid = grant_valid_reg;\n    assign grant_encoded = grant_encoded_reg;\n\nendmodule\n```<|im_end|>",
