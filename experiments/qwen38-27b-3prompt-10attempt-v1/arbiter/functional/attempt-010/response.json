  "text": "```verilog\nmodule arbiter #\n(\n    parameter PORTS = 4,\n    parameter ARB_TYPE_ROUND_ROBIN = 0,\n    parameter ARB_BLOCK = 0,\n    parameter ARB_BLOCK_ACK = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 0\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    input  wire [PORTS-1:0]         request,\n    input  wire [PORTS-1:0]         acknowledge,\n    output wire [PORTS-1:0]         grant,\n    output wire                     grant_valid,\n    output wire [$clog2(PORTS)-1:0] grant_encoded\n);\n\n    localparam NUM_PORTS = PORTS;\n    localparam ENC_WIDTH = $clog2(PORTS);\n\n    reg [NUM_PORTS-1:0] grant_reg;\n    reg [ENC_WIDTH-1:0] grant_enc_reg;\n    reg                 grant_valid_reg;\n\n    // For round-robin, we need to track the last granted port\n    reg [ENC_WIDTH-1:0] last_grant_reg;\n\n    // Internal signals for arbitration\n    wire [NUM_PORTS-1:0] active_request;\n    wire [NUM_PORTS-1:0] rotated_request;\n    wire [NUM_PORTS-1:0] priority_grant;\n    wire [NUM_PORTS-1:0] final_grant;\n    wire [ENC_WIDTH-1:0] final_grant_enc;\n    wire                 final_grant_valid;\n\n    // Determine if we should block\n    wire block_active;\n    wire block_release;\n\n    // For fixed priority, we need to handle LSB high priority\n    // If ARB_LSB_HIGH_PRIORITY is 1, lower index has higher priority\n    // If ARB_LSB_HIGH_PRIORITY is 0, higher index has higher priority\n\n    // Function to find the first set bit from LSB (lowest index)\n    // This gives us the lowest index with a request\n    function [NUM_PORTS-1:0] find_lsb;\n        input [NUM_PORTS-1:0] req;\n        integer i;\n        begin\n            find_lsb = {NUM_PORTS{1'b0}};\n            for (i = 0; i < NUM_PORTS; i = i + 1) begin\n                if (req[i] && find_lsb == {NUM_PORTS{1'b0}}) begin\n                    find_lsb[i] = 1'b1;\n                end\n            end\n        end\n    endfunction\n\n    // Function to find the first set bit from MSB (highest index)\n    function [NUM_PORTS-1:0] find_msb;\n        input [NUM_PORTS-1:0] req;\n        integer i;\n        begin\n            find_msb = {NUM_PORTS{1'b0}};\n            for (i = NUM_PORTS-1; i >= 0; i = i - 1) begin\n                if (req[i] && find_msb == {NUM_PORTS{1'b0}}) begin\n                    find_msb[i] = 1'b1;\n                end\n            end\n        end\n    endfunction\n\n    // For round-robin, we rotate the request vector so that the port after\n    // the last grant becomes the highest priority\n    // We need to create a rotated version of the request\n\n    // Generate rotated request for round-robin\n    // The idea: shift the request vector so that the bit after last_grant is at position 0\n    // Then find the first set bit in the rotated vector, and map back to original index\n\n    wire [NUM_PORTS-1:0] rr_rotated_req;\n    wire [ENC_WIDTH-1:0] rr_offset;\n    wire [ENC_WIDTH-1:0] rr_grant_idx;\n    wire [NUM_PORTS-1:0] rr_grant;\n\n    assign rr_offset = last_grant_reg + 1'b1;\n\n    // Rotate request: rr_rotated_req[i] = request[(i + rr_offset) % NUM_PORTS]\n    genvar gi;\n    generate\n        for (gi = 0; gi < NUM_PORTS; gi = gi + 1) begin : gen_rr_rot\n            assign rr_rotated_req[gi] = request[(gi + rr_offset) % NUM_PORTS];\n        end\n    endgenerate\n\n    // Find first set bit in rotated request (LSB first)\n    wire [NUM_PORTS-1:0] rr_first_set = find_lsb(rr_rotated_req);\n\n    // Find the index of the first set bit in rr_first_set\n    // We need to find which bit is set in rr_first_set\n    wire [ENC_WIDTH-1:0] rr_first_idx;\n    genvar gj;\n    generate\n        for (gj = 0; gj < NUM_PORTS; gj = gj + 1) begin : gen_rr_idx\n            assign rr_first_idx[gj] = rr_first_set[gj];\n        end\n    endgenerate\n\n    // Actually, let's use a proper encoder\n    // Find the index of the set bit in rr_first_set\n    wire [ENC_WIDTH-1:0] rr_first_bit_idx;\n    reg [ENC_WIDTH-1:0] rr_first_bit_idx_reg;\n    always @(*) begin\n        rr_first_bit_idx_reg = {ENC_WIDTH{1'b0}};\n        for (integer k = 0; k < NUM_PORTS; k = k + 1) begin\n            if (rr_first_set[k]) begin\n                rr_first_bit_idx_reg = k[ENC_WIDTH-1:0];\n            end\n        end\n    end\n    assign rr_first_bit_idx = rr_first_bit_idx_reg;\n\n    // The actual grant index is (rr_first_bit_idx + rr_offset) % NUM_PORTS\n    wire [ENC_WIDTH:0] rr_sum = rr_first_bit_idx + rr_offset;\n    wire [ENC_WIDTH-1:0] rr_grant_idx_val = rr_sum[ENC_WIDTH-1:0];\n    wire rr_wrap = rr_sum[ENC_WIDTH];\n    wire [ENC_WIDTH-1:0] rr_final_idx = rr_wrap ? (rr_sum[ENC_WIDTH-1:0] - NUM_PORTS[ENC_WIDTH-1:0]) : rr_sum[ENC_WIDTH-1:0];\n\n    // Hmm, this is getting complicated. Let me use a different approach.\n    // For round-robin, we can use a priority encoder on the rotated request\n    // and then map back.\n\n    // Let me simplify: use a combinational approach for both fixed and round-robin\n\n    // For fixed priority:\n    // If ARB_LSB_HIGH_PRIORITY, lower index wins\n    // Otherwise, higher index wins\n\n    wire [NUM_PORTS-1:0] fixed_grant;\n    wire [ENC_WIDTH-1:0] fixed_grant_enc;\n    wire                 fixed_grant_valid;\n\n    // Fixed priority grant\n    // If ARB_LSB_HIGH_PRIORITY, find lowest index with request\n    // Otherwise, find highest index with request\n    wire [NUM_PORTS-1:0] fixed_grant_lsb = find_lsb(request);\n    wire [NUM_PORTS-1:0] fixed_grant_msb = find_msb(request);\n\n    assign fixed_grant = ARB_LSB_HIGH_PRIORITY ? fixed_grant_lsb : fixed_grant_msb;\n\n    // Encode fixed grant\n    reg [ENC_WIDTH-1:0] fixed_grant_enc_reg;\n    always @(*) begin\n        fixed_grant_enc_reg = {ENC_WIDTH{1'b0}};\n        for (integer k = 0; k < NUM_PORTS; k = k + 1) begin\n            if (fixed_grant[k]) begin\n                fixed_grant_enc_reg = k[ENC_WIDTH-1:0];\n            end\n        end\n    end\n    assign fixed_grant_enc = fixed_grant_enc_reg;\n    assign fixed_grant_valid = |fixed_grant;\n\n    // For round-robin, we need a different approach\n    // Let's use a priority encoder that considers the rotation\n\n    // Actually, let me use a simpler approach for round-robin:\n    // Create a mask where bits from last_grant+1 to end have higher priority\n    // and bits from 0 to last_grant have lower priority\n    // Then use a two-stage priority encoder\n\n    wire [NUM_PORTS-1:0] rr_high_priority_req;\n    wire [NUM_PORTS-1:0] rr_low_priority_req;\n\n    genvar gh;\n    generate\n        for (gh = 0; gh < NUM_PORTS; gh = gh + 1) begin : gen_rr_mask\n            // If gh > last_grant_reg, it's in the high priority group\n            // If gh <= last_grant_reg, it's in the low priority group\n            // But we need to handle wrap-around\n            // Actually, for round-robin, the priority order is:\n            // (last_grant+1), (last_grant+2), ..., (NUM_PORTS-1), 0, 1, ..., last_grant\n            // So high priority: indices > last_grant_reg\n            // Low priority: indices <= last_grant_reg\n            assign rr_high_priority_req[gh] = request[gh] & (gh > last_grant_reg);\n            assign rr_low_priority_req[gh]  = request[gh] & (gh <= last_grant_reg);\n        end\n    endgenerate\n\n    // Find grant in high priority group (LSB first, so lowest index wins)\n    wire [NUM_PORTS-1:0] rr_high_grant = find_lsb(rr_high_priority_req);\n    wire [NUM_PORTS-1:0] rr_low_grant  = find_lsb(rr_low_priority_req);\n\n    // If high priority group has a grant, use it; otherwise use low priority group\n    wire rr_use_high = |rr_high_grant;\n    wire [NUM_PORTS-1:0] rr_grant_comb = rr_use_high ? rr_high_grant : rr_low_grant;\n\n    // Encode rr_grant_comb\n    reg [ENC_WIDTH-1:0] rr_grant_enc_reg;\n    always @(*) begin\n        rr_grant_enc_reg = {ENC_WIDTH{1'b0}};\n        for (integer k = 0; k < NUM_PORTS; k = k + 1) begin\n            if (rr_grant_comb[k]) begin\n                rr_grant_enc_reg = k[ENC_WIDTH-1:0];\n            end\n        end\n    end\n\n    wire rr_grant_valid_comb = |rr_grant_comb;\n\n    // Select between fixed and round-robin\n    wire [NUM_PORTS-1:0] arb_grant = ARB_TYPE_ROUND_ROBIN ? rr_grant_comb : fixed_grant;\n    wire [ENC_WIDTH-1:0] arb_grant_enc = ARB_TYPE_ROUND_ROBIN ? rr_grant_enc_reg : fixed_grant_enc;\n    wire arb_grant_valid = ARB_TYPE_ROUND_ROBIN ? rr_grant_valid_comb : fixed_grant_valid;\n\n    // Block logic\n    // When ARB_BLOCK is set, hold the grant until:\n    // - If ARB_BLOCK_ACK is nonzero: until acknowledge is received\n    // - If ARB_BLOCK_ACK is zero: until request drops\n\n    wire block_hold;\n    wire block_release_ack;\n    wire block_release_req;\n\n    // Check if current grant is being acknowledged\n    wire ack_match = (grant_reg & acknowledge) != 0;\n\n    // Check if current grant's request is still active\n    wire req_match = (grant_reg & request) != 0;\n\n    assign block_hold = ARB_BLOCK && grant_valid_reg;\n    assign block_release_ack = ARB_BLOCK_ACK && ack_match;\n    assign block_release_req = !ARB_BLOCK_ACK && !req_match;\n\n    // If blocking and not released, hold the grant\n    // Otherwise, use the new arbitration result\n    wire use_new_arb = !block_hold || block_release_ack || block_release_req;\n\n    // Update logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            grant_reg <= {NUM_PORTS{1'b0}};\n            grant_enc_reg <= {ENC_WIDTH{1'b0}};\n            grant_valid_reg <= 1'b0;\n            last_grant_reg <= {ENC_WIDTH{1'b0}};\n        end else begin\n            if (use_new_arb) begin\n                grant_reg <= arb_grant;\n                grant_enc_reg <= arb_grant_enc;\n                grant_valid_reg <= arb_grant_valid;\n                if (arb_grant_valid) begin\n                    last_grant_reg <= arb_grant_enc;\n                end\n            end else begin\n                // Hold current grant\n                grant_reg <= grant_reg;\n                grant_enc_reg <= grant_enc_reg;\n                grant_valid_reg <= grant_valid_reg;\n            end\n        end\n    end\n\n    assign grant = grant_reg;\n    assign grant_encoded = grant_enc_reg;\n    assign grant_valid = grant_valid_reg;\n\nendmodule\n```<|im_end|>",
