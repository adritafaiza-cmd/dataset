  "text": "```verilog\nmodule arbiter #\n(\n    parameter PORTS = 4,\n    parameter ARB_TYPE_ROUND_ROBIN = 0,\n    parameter ARB_BLOCK = 0,\n    parameter ARB_BLOCK_ACK = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 0\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    input  wire [PORTS-1:0]         request,\n    input  wire [PORTS-1:0]         acknowledge,\n    output wire [PORTS-1:0]         grant,\n    output wire                     grant_valid,\n    output wire [$clog2(PORTS)-1:0] grant_encoded\n);\n\n    localparam NUM_BITS = $clog2(PORTS);\n\n    reg [PORTS-1:0] grant_reg;\n    reg [NUM_BITS-1:0] grant_encoded_reg;\n    reg grant_valid_reg;\n\n    // For round-robin, we need to track the last granted port\n    reg [NUM_BITS-1:0] last_grant;\n\n    // Function to find the first set bit (LSB priority)\n    function [PORTS-1:0] find_first_set;\n        input [PORTS-1:0] mask;\n        integer i;\n        begin\n            find_first_set = {PORTS{1'b0}};\n            for (i = 0; i < PORTS; i = i + 1) begin\n                if (mask[i] && find_first_set == {PORTS{1'b0}}) begin\n                    find_first_set[i] = 1'b1;\n                end\n            end\n        end\n    endfunction\n\n    // Function to find the last set bit (MSB priority)\n    function [PORTS-1:0] find_last_set;\n        input [PORTS-1:0] mask;\n        integer i;\n        begin\n            find_last_set = {PORTS{1'b0}};\n            for (i = PORTS-1; i >= 0; i = i - 1) begin\n                if (mask[i] && find_last_set == {PORTS{1'b0}}) begin\n                    find_last_set[i] = 1'b1;\n                end\n            end\n        endfunction\n    endfunction\n\n    // Function to rotate a vector left by n positions\n    function [PORTS-1:0] rotate_left;\n        input [PORTS-1:0] vec;\n        input [NUM_BITS-1:0] shift;\n        integer i;\n        begin\n            rotate_left = {PORTS{1'b0}};\n            for (i = 0; i < PORTS; i = i + 1) begin\n                rotate_left[i] = vec[(i - shift) % PORTS];\n            end\n        end\n    endfunction\n\n    // Function to rotate a vector right by n positions\n    function [PORTS-1:0] rotate_right;\n        input [PORTS-1:0] vec;\n        input [NUM_BITS-1:0] shift;\n        integer i;\n        begin\n            rotate_right = {PORTS{1'b0}};\n            for (i = 0; i < PORTS; i = i + 1) begin\n                rotate_right[i] = vec[(i + shift) % PORTS];\n            end\n        end\n    endfunction\n\n    // Function to convert one-hot to binary\n    function [NUM_BITS-1:0] onehot_to_binary;\n        input [PORTS-1:0] onehot;\n        integer i;\n        begin\n            onehot_to_binary = {NUM_BITS{1'b0}};\n            for (i = 0; i < PORTS; i = i + 1) begin\n                if (onehot[i]) begin\n                    onehot_to_binary = i[NUM_BITS-1:0];\n                end\n            end\n        end\n    endfunction\n\n    // Function to convert binary to one-hot\n    function [PORTS-1:0] binary_to_onehot;\n        input [NUM_BITS-1:0] bin;\n        integer i;\n        begin\n            binary_to_onehot = {PORTS{1'b0}};\n            for (i = 0; i < PORTS; i = i + 1) begin\n                if (i[NUM_BITS-1:0] == bin) begin\n                    binary_to_onehot[i] = 1'b1;\n                end\n            end\n        end\n    endfunction\n\n    wire [PORTS-1:0] arbiter_grant;\n    wire arbiter_valid;\n    wire [NUM_BITS-1:0] arbiter_encoded;\n\n    // Compute the grant based on arbitration type\n    // For fixed priority:\n    //   If ARB_LSB_HIGH_PRIORITY, LSB wins (find_first_set)\n    //   Otherwise, MSB wins (find_last_set)\n    // For round-robin:\n    //   Rotate request so that the port after last_grant has highest priority\n    //   Then apply fixed priority logic\n\n    wire [PORTS-1:0] rotated_request;\n    wire [PORTS-1:0] rotated_grant;\n    wire [PORTS-1:0] fixed_grant;\n\n    // For round-robin, we rotate the request vector so that the port\n    // immediately after last_grant is at position 0 (highest priority for LSB)\n    // or at the highest position (for MSB priority)\n    \n    // Let's think about this more carefully.\n    // In round-robin, we want to give priority to the next port after the last granted one.\n    // If we use LSB priority, we want the port after last_grant to be the LSB.\n    // If we use MSB priority, we want the port after last_grant to be the MSB.\n\n    // For LSB priority round-robin:\n    // Rotate request left by (last_grant + 1) so that port (last_grant+1) is at position 0\n    // Then find first set bit, then rotate back\n\n    // For MSB priority round-robin:\n    // Rotate request right by (PORTS - 1 - last_grant - 1) = (PORTS - last_grant - 2)\n    // Hmm, let me think again.\n\n    // Actually, let's use a simpler approach.\n    // For round-robin with LSB priority:\n    //   We want to prioritize ports in order: (last_grant+1), (last_grant+2), ..., (last_grant-1)\n    //   So we rotate the request left by (last_grant + 1) mod PORTS\n    //   Then the LSB of the rotated request corresponds to port (last_grant+1)\n    //   Find first set bit in rotated request\n    //   Rotate the result right by (last_grant + 1) mod PORTS to get back to original indexing\n\n    // For round-robin with MSB priority:\n    //   We want to prioritize ports in order: (last_grant+1), (last_grant+2), ..., (last_grant-1)\n    //   But with MSB priority, the highest bit wins.\n    //   So we need to arrange it so that (last_grant+1) is at the MSB position.\n    //   Rotate request right by (PORTS - 1 - (last_grant + 1)) = (PORTS - last_grant - 2)\n    //   Hmm, this is getting complicated. Let me use a different approach.\n\n    // Alternative: For round-robin, create a priority order and use a priority encoder.\n    // But since we're using one-hot grants, let's stick with the rotation approach.\n\n    // Let's define:\n    // For LSB priority:\n    //   rotated_request = rotate_left(request, last_grant + 1)\n    //   rotated_grant = find_first_set(rotated_request)\n    //   grant = rotate_right(rotated_grant, last_grant + 1)\n\n    // For MSB priority:\n    //   We want (last_grant+1) to be at the highest position.\n    //   If we rotate request right by (PORTS - 1 - (last_grant + 1)) = (PORTS - last_grant - 2)\n    //   Then port (last_grant+1) will be at position PORTS-1 (MSB)\n    //   rotated_request = rotate_right(request, PORTS - last_grant - 2)\n    //   rotated_grant = find_last_set(rotated_request)\n    //   grant = rotate_left(rotated_grant, PORTS - last_grant - 2)\n\n    // But we need to handle the case where last_grant + 1 >= PORTS (wrap around)\n    // The rotation functions handle this with modulo.\n\n    // Let's compute the shift amounts\n    wire [NUM_BITS-1:0] lsb_shift = (last_grant + 1) % PORTS;\n    wire [NUM_BITS-1:0] msb_shift = (PORTS - 1 - (last_grant + 1) + PORTS) % PORTS;\n\n    // For LSB priority round-robin\n    wire [PORTS-1:0] rr_lsb_rotated_req = rotate_left(request, lsb_shift);\n    wire [PORTS-1:0] rr_lsb_rotated_grant = find_first_set(rr_lsb_rotated_req);\n    wire [PORTS-1:0] rr_lsb_grant = rotate_right(rr_lsb_rotated_grant, lsb_shift);\n\n    // For MSB priority round-robin\n    wire [PORTS-1:0] rr_msb_rotated_req = rotate_right(request, msb_shift);\n    wire [PORTS-1:0] rr_msb_rotated_grant = find_last_set(rr_msb_rotated_req);\n    wire [PORTS-1:0] rr_msb_grant = rotate_left(rr_msb_rotated_grant, msb_shift);\n\n    // For fixed priority\n    wire [PORTS-1:0] fixed_lsb_grant = find_first_set(request);\n    wire [PORTS-1:0] fixed_msb_grant = find_last_set(request);\n\n    // Select the appropriate grant\n    wire [PORTS-1:0] computed_grant;\n    assign computed_grant = ARB_TYPE_ROUND_ROBIN ?\n        (ARB_LSB_HIGH_PRIORITY ? rr_lsb_grant : rr_msb_grant) :\n        (ARB_LSB_HIGH_PRIORITY ? fixed_lsb_grant : fixed_msb_grant);\n\n    assign arbiter_grant = computed_grant;\n    assign arbiter_valid = (computed_grant != {PORTS{1'b0}});\n    assign arbiter_encoded = onehot_to_binary(computed_grant);\n\n    // Blocking logic\n    // When ARB_BLOCK is set:\n    //   If ARB_BLOCK_ACK is nonzero, hold grant until acknowledge\n    //   If ARB_BLOCK_ACK is zero, hold grant until request drops\n\n    reg [PORTS-1:0] blocked_grant;\n    reg blocked_valid;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            grant_reg <= {PORTS{1'b0}};\n            grant_encoded_reg <= {NUM_BITS{1'b0}};\n            grant_valid_reg <= 1'b0;\n            last_grant <= {NUM_BITS{1'b0}};\n            blocked_grant <= {PORTS{1'b0}};\n            blocked_valid <= 1'b0;\n        end else begin\n            if (ARB_BLOCK) begin\n                if (blocked_valid) begin\n                    // Currently blocking\n                    if (ARB_BLOCK_ACK) begin\n                        // Hold until acknowledge\n                        if (blocked_grant & acknowledge) begin\n                            // Acknowledge received, release block\n                            blocked_valid <= 1'b0;\n                            // Update last_grant for round-robin\n                            if (ARB_TYPE_ROUND_ROBIN) begin\n                                last_grant <= onehot_to_binary(blocked_grant);\n                            end\n                            // Grant the new arbiter result\n                            grant_reg <= arbiter_grant;\n                            grant_encoded_reg <= arbiter_encoded;\n                            grant_valid_reg <= arbiter_valid;\n                        end else begin\n                            // Continue blocking\n                            grant_reg <= blocked_grant;\n                            grant_encoded_reg <= onehot_to_binary(blocked_grant);\n                            grant_valid_reg <= 1'b1;\n                        end\n                    end else begin\n                        // Hold until request drops\n                        if (blocked_grant & request) begin\n                            // Request still active, continue blocking\n                            grant_reg <= blocked_grant;\n                            grant_encoded_reg <= onehot_to_binary(blocked_grant);\n                            grant_valid_reg <= 1'b1;\n                        end else begin\n                            // Request dropped, release block\n                            blocked_valid <= 1'b0;\n                            // Update last_grant for round-robin\n                            if (ARB_TYPE_ROUND_ROBIN) begin\n                                last_grant <= onehot_to_binary(blocked_grant);\n                            end\n                            // Grant the new arbiter result\n                            grant_reg <= arbiter_grant;\n                            grant_encoded_reg <= arbiter_encoded;\n                            grant_valid_reg <= arbiter_valid;\n                        end\n                    end\n                end else begin\n                    // Not currently blocking\n                    if (arbiter_valid) begin\n                        // Start blocking\n                        blocked_grant <= arbiter_grant;\n                        blocked_valid <= 1'b1;\n                        grant_reg <= arbiter_grant;\n                        grant_encoded_reg <= arbiter_encoded;\n                        grant_valid_reg <= 1'b1;\n                    end else begin\n                        grant_reg <= {PORTS{1'b0}};\n                        grant_encoded_reg <= {NUM_BITS{1'b0}};\n                        grant_valid_reg <= 1'b0;\n                    end\n                end\n            end else begin\n                // No blocking\n                grant_reg <= arbiter_grant;\n                grant_encoded_reg <= arbiter_encoded;\n                grant_valid_reg <= arbiter_valid;\n                // Update last_grant for round-robin\n                if (ARB_TYPE_ROUND_ROBIN && arbiter_valid) begin\n                    last_grant <= arbiter_encoded;\n                end\n            end\n        end\n    end\n\n    assign grant = grant_reg;\n    assign grant_valid = grant_valid_reg;\n    assign grant_encoded = grant_encoded_reg;\n\nendmodule\n```<|im_end|>",
