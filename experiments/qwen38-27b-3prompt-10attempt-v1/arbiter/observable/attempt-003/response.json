  "text": "```verilog\nmodule arbiter #\n(\n    parameter PORTS = 4,\n    parameter ARB_TYPE_ROUND_ROBIN = 0,\n    parameter ARB_BLOCK = 0,\n    parameter ARB_BLOCK_ACK = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 0\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    input  wire [PORTS-1:0]         request,\n    input  wire [PORTS-1:0]         acknowledge,\n    output wire [PORTS-1:0]         grant,\n    output wire                     grant_valid,\n    output wire [$clog2(PORTS)-1:0] grant_encoded\n);\n\n    localparam GRANT_WIDTH = $clog2(PORTS);\n\n    reg [PORTS-1:0] grant_reg;\n    reg             grant_valid_reg;\n    reg [GRANT_WIDTH-1:0] grant_encoded_reg;\n\n    // For round-robin: track the last granted port\n    reg [GRANT_WIDTH-1:0] last_grant;\n    reg                   has_last_grant;\n\n    // For blocking: track if a grant is currently blocked\n    reg                   blocked;\n\n    // Combinational logic to determine the next grant\n    wire [PORTS-1:0] next_grant;\n    wire             next_grant_valid;\n    wire [GRANT_WIDTH-1:0] next_grant_encoded;\n\n    // Helper: find the lowest set bit (LSB) in a mask\n    // Returns one-hot grant and valid\n    function [PORTS-1:0] find_lsb;\n        input [PORTS-1:0] mask;\n        integer i;\n        begin\n            find_lsb = {PORTS{1'b0}};\n            for (i = 0; i < PORTS; i = i + 1) begin\n                if (mask[i] && find_lsb == {PORTS{1'b0}}) begin\n                    find_lsb[i] = 1'b1;\n                end\n            end\n        end\n    endfunction\n\n    // Helper: find the highest set bit (MSB) in a mask\n    function [PORTS-1:0] find_msb;\n        input [PORTS-1:0] mask;\n        integer i;\n        begin\n            find_msb = {PORTS{1'b0}};\n            for (i = PORTS - 1; i >= 0; i = i - 1) begin\n                if (mask[i] && find_msb == {PORTS{1'b0}}) begin\n                    find_msb[i] = 1'b1;\n                end\n            end\n        end\n    endfunction\n\n    // Helper: encode one-hot to binary\n    function [GRANT_WIDTH-1:0] onehot_to_binary;\n        input [PORTS-1:0] onehot;\n        integer i;\n        begin\n            onehot_to_binary = {GRANT_WIDTH{1'b0}};\n            for (i = 0; i < PORTS; i = i + 1) begin\n                if (onehot[i]) begin\n                    onehot_to_binary = i[GRANT_WIDTH-1:0];\n                end\n            end\n        end\n    endfunction\n\n    // Round-robin priority: rotate the request mask so that the port after last_grant has highest priority\n    // If ARB_LSB_HIGH_PRIORITY is 1, LSB has highest priority in fixed mode\n    // For round-robin, we use a rotating priority scheme\n\n    wire [PORTS-1:0] rr_mask;\n    wire [PORTS-1:0] rr_request;\n\n    // Generate rotated request for round-robin\n    // The idea: shift the request so that the port after last_grant is at position 0\n    // Then find the LSB (or MSB depending on priority) of the rotated request\n    // Then rotate back\n\n    // For simplicity, we'll use a different approach:\n    // In round-robin, we want to give priority to the next port after the last granted one\n    // We can do this by creating a priority mask\n\n    // Let's use a simpler approach for round-robin:\n    // Create a rotated version of the request where the bit after last_grant is at the LSB\n    // Then use fixed-priority logic on the rotated request\n\n    // Rotation: if last_grant is L, then port (L+1) % PORTS should be at position 0\n    // So we rotate left by (L+1) % PORTS\n\n    wire [GRANT_WIDTH-1:0] rotate_amount;\n    wire [PORTS-1:0] rotated_request;\n    wire [PORTS-1:0] rotated_grant;\n\n    assign rotate_amount = has_last_grant ? (last_grant + 1'b1) : {GRANT_WIDTH{1'b0}};\n\n    // Rotate left by rotate_amount\n    // We'll use a simple approach: for each bit position, check if the corresponding source bit is set\n    genvar i;\n    generate\n        for (i = 0; i < PORTS; i = i + 1) begin : gen_rotate\n            // rotated_request[i] = request[(i - rotate_amount) mod PORTS]\n            // But we need to handle the modular arithmetic\n            // Let's use a different approach: create a wide vector and select\n        end\n    endgenerate\n\n    // Simpler: use a function to rotate\n    function [PORTS-1:0] rotate_left;\n        input [PORTS-1:0] data;\n        input [GRANT_WIDTH-1:0] amount;\n        integer i;\n        integer src;\n        begin\n            rotate_left = {PORTS{1'b0}};\n            for (i = 0; i < PORTS; i = i + 1) begin\n                src = (i - amount) % PORTS;\n                if (src < 0) src = src + PORTS;\n                rotate_left[i] = data[src];\n            end\n        end\n    endfunction\n\n    assign rotated_request = rotate_left(request, rotate_amount);\n\n    // Now apply fixed-priority logic to rotated_request\n    wire [PORTS-1:0] fixed_grant_rotated;\n    wire             fixed_grant_valid_rotated;\n\n    // Fixed priority: if ARB_LSB_HIGH_PRIORITY, LSB has highest priority\n    // Otherwise, MSB has highest priority\n    assign fixed_grant_rotated = ARB_LSB_HIGH_PRIORITY ? find_lsb(rotated_request) : find_msb(rotated_request);\n    assign fixed_grant_valid_rotated = (rotated_request != {PORTS{1'b0}});\n\n    // Rotate back the grant\n    function [PORTS-1:0] rotate_right;\n        input [PORTS-1:0] data;\n        input [GRANT_WIDTH-1:0] amount;\n        integer i;\n        integer src;\n        begin\n            rotate_right = {PORTS{1'b0}};\n            for (i = 0; i < PORTS; i = i + 1) begin\n                src = (i + amount) % PORTS;\n                rotate_right[i] = data[src];\n            end\n        end\n    endfunction\n\n    assign next_grant = ARB_TYPE_ROUND_ROBIN ? rotate_right(fixed_grant_rotated, rotate_amount) : (ARB_LSB_HIGH_PRIORITY ? find_lsb(request) : find_msb(request));\n    assign next_grant_valid = (request != {PORTS{1'b0}});\n    assign next_grant_encoded = onehot_to_binary(next_grant);\n\n    // Blocking logic\n    // If ARB_BLOCK is enabled, a grant is held until the release event\n    // The release event is determined by ARB_BLOCK_ACK:\n    //   If ARB_BLOCK_ACK == 1, release when acknowledge is asserted for the granted port\n    //   If ARB_BLOCK_ACK == 0, release when request is deasserted for the granted port\n\n    wire release_event;\n    wire [PORTS-1:0] current_grant_mask;\n\n    assign current_grant_mask = grant_reg;\n\n    // Determine release event\n    // If blocked, check if the release condition is met\n    wire ack_for_grant;\n    wire req_for_grant;\n\n    assign ack_for_grant = (acknowledge & grant_reg) != {PORTS{1'b0}};\n    assign req_for_grant = (request & grant_reg) != {PORTS{1'b0}};\n\n    assign release_event = ARB_BLOCK_ACK ? ack_for_grant : (~req_for_grant);\n\n    // State machine for blocking\n    // When a new grant is issued and ARB_BLOCK is enabled, enter blocked state\n    // Stay blocked until release_event\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            grant_reg <= {PORTS{1'b0}};\n            grant_valid_reg <= 1'b0;\n            grant_encoded_reg <= {GRANT_WIDTH{1'b0}};\n            last_grant <= {GRANT_WIDTH{1'b0}};\n            has_last_grant <= 1'b0;\n            blocked <= 1'b0;\n        end else begin\n            if (ARB_BLOCK) begin\n                if (blocked) begin\n                    // Currently blocked, check for release\n                    if (release_event) begin\n                        // Release the block\n                        blocked <= 1'b0;\n                        grant_reg <= {PORTS{1'b0}};\n                        grant_valid_reg <= 1'b0;\n                        grant_encoded_reg <= {GRANT_WIDTH{1'b0}};\n                        // Issue new grant if available\n                        if (next_grant_valid) begin\n                            grant_reg <= next_grant;\n                            grant_valid_reg <= 1'b1;\n                            grant_encoded_reg <= next_grant_encoded;\n                            last_grant <= next_grant_encoded;\n                            has_last_grant <= 1'b1;\n                            if (ARB_TYPE_ROUND_ROBIN) begin\n                                blocked <= 1'b1;\n                            end\n                        end\n                    end\n                    // If not released, hold current grant\n                end else begin\n                    // Not blocked, issue new grant if available\n                    if (next_grant_valid) begin\n                        grant_reg <= next_grant;\n                        grant_valid_reg <= 1'b1;\n                        grant_encoded_reg <= next_grant_encoded;\n                        last_grant <= next_grant_encoded;\n                        has_last_grant <= 1'b1;\n                        blocked <= 1'b1;\n                    end else begin\n                        grant_reg <= {PORTS{1'b0}};\n                        grant_valid_reg <= 1'b0;\n                        grant_encoded_reg <= {GRANT_WIDTH{1'b0}};\n                    end\n                end\n            end else begin\n                // No blocking, just issue grant based on current requests\n                if (next_grant_valid) begin\n                    grant_reg <= next_grant;\n                    grant_valid_reg <= 1'b1;\n                    grant_encoded_reg <= next_grant_encoded;\n                    last_grant <= next_grant_encoded;\n                    has_last_grant <= 1'b1;\n                end else begin\n                    grant_reg <= {PORTS{1'b0}};\n                    grant_valid_reg <= 1'b0;\n                    grant_encoded_reg <= {GRANT_WIDTH{1'b0}};\n                end\n            end\n        end\n    end\n\n    assign grant = grant_reg;\n    assign grant_valid = grant_valid_reg;\n    assign grant_encoded = grant_encoded_reg;\n\nendmodule\n```<|im_end|>",
