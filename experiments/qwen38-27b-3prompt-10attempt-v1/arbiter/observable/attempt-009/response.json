  "text": "```verilog\nmodule arbiter #\n(\n    parameter PORTS = 4,\n    parameter ARB_TYPE_ROUND_ROBIN = 0,\n    parameter ARB_BLOCK = 0,\n    parameter ARB_BLOCK_ACK = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 0\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    input  wire [PORTS-1:0]         request,\n    input  wire [PORTS-1:0]         acknowledge,\n    output wire [PORTS-1:0]         grant,\n    output wire                     grant_valid,\n    output wire [$clog2(PORTS)-1:0] grant_encoded\n);\n\n    localparam NUM_PORTS = PORTS;\n    localparam ENC_WIDTH = $clog2(PORTS);\n\n    // Internal state\n    reg [NUM_PORTS-1:0] grant_reg;\n    reg                 grant_valid_reg;\n    reg [ENC_WIDTH-1:0] grant_encoded_reg;\n    reg [NUM_PORTS-1:0] last_grant_mask; // For round-robin: mask of ports with lower priority than last granted\n\n    // For round-robin, we track the last granted port to rotate priority\n    reg [ENC_WIDTH-1:0] last_grant_port;\n\n    // Function to find the first set bit (lowest index) in a vector\n    // Returns the index of the first 1, or 0 if none\n    function [ENC_WIDTH-1:0] find_first_set;\n        input [NUM_PORTS-1:0] vec;\n        integer i;\n        begin\n            find_first_set = 0;\n            for (i = 0; i < NUM_PORTS; i = i + 1) begin\n                if (vec[i]) begin\n                    find_first_set = i[ENC_WIDTH-1:0];\n                    disable find_first_set;\n                end\n            end\n        end\n    endfunction\n\n    // Function to find the first set bit starting from a given index (wrapping around)\n    function [ENC_WIDTH-1:0] find_first_set_wrapped;\n        input [NUM_PORTS-1:0] vec;\n        input [ENC_WIDTH-1:0] start_idx;\n        integer i;\n        integer idx;\n        begin\n            find_first_set_wrapped = 0;\n            for (i = 0; i < NUM_PORTS; i = i + 1) begin\n                idx = (start_idx + i) % NUM_PORTS;\n                if (vec[idx]) begin\n                    find_first_set_wrapped = idx[ENC_WIDTH-1:0];\n                    disable find_first_set_wrapped;\n                end\n            end\n        end\n    endfunction\n\n    // Determine which port to grant based on arbitration type\n    wire [NUM_PORTS-1:0] arb_request;\n    wire [ENC_WIDTH-1:0] arb_grant_port;\n    wire                 arb_grant_valid;\n\n    // For fixed priority: LSB high priority means port 0 has highest priority\n    // We find the first set bit in request\n    // For round-robin: we rotate based on last granted port\n\n    generate\n        if (ARB_TYPE_ROUND_ROBIN == 0) begin : gen_fixed\n            // Fixed priority arbitration\n            // If ARB_LSB_HIGH_PRIORITY == 0, port 0 has highest priority (find first set bit)\n            // If ARB_LSB_HIGH_PRIORITY == 1, port 0 has highest priority as well (same interpretation)\n            // Actually, let's interpret: LSB high priority means lower index = higher priority\n            // So we always find the first set bit (lowest index)\n            assign arb_grant_port = find_first_set(request);\n            assign arb_grant_valid = |request;\n        end\n        else begin : gen_round_robin\n            // Round-robin arbitration\n            // Start searching from the port after the last granted port\n            // If no previous grant, start from 0\n            wire [ENC_WIDTH-1:0] search_start;\n            assign search_start = (grant_valid_reg) ? (last_grant_port + 1) % NUM_PORTS : 0;\n            \n            assign arb_grant_port = find_first_set_wrapped(request, search_start);\n            assign arb_grant_valid = |request;\n        end\n    endgenerate\n\n    // Blocking logic\n    wire block_active;\n    wire release_event;\n\n    generate\n        if (ARB_BLOCK == 0) begin : gen_no_block\n            assign block_active = 1'b0;\n            assign release_event = 1'b0;\n        end\n        else begin : gen_block\n            // Block is active when a grant is pending and not yet released\n            // Release event depends on ARB_BLOCK_ACK\n            if (ARB_BLOCK_ACK == 0) begin : gen_block_no_ack\n                // Release on next clock edge after grant (immediate release)\n                // Actually, if ARB_BLOCK_ACK=0, we don't wait for acknowledge\n                // The grant is held for one cycle then released\n                assign block_active = grant_valid_reg;\n                assign release_event = 1'b1; // Always release after one cycle\n            end\n            else begin : gen_block_ack\n                // Release when acknowledge is received\n                assign block_active = grant_valid_reg;\n                assign release_event = (grant_valid_reg && (acknowledge & grant_reg) != 0);\n            end\n        end\n    endgenerate\n\n    // Main state machine\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            grant_reg <= {NUM_PORTS{1'b0}};\n            grant_valid_reg <= 1'b0;\n            grant_encoded_reg <= {ENC_WIDTH{1'b0}};\n            last_grant_port <= {ENC_WIDTH{1'b0}};\n        end\n        else begin\n            if (block_active && !release_event) begin\n                // Hold current grant\n                // No change\n            end\n            else begin\n                // Can issue new grant or clear\n                if (arb_grant_valid) begin\n                    grant_reg <= {NUM_PORTS{1'b0}};\n                    grant_reg[arb_grant_port] <= 1'b1;\n                    grant_valid_reg <= 1'b1;\n                    grant_encoded_reg <= arb_grant_port;\n                    last_grant_port <= arb_grant_port;\n                end\n                else begin\n                    grant_reg <= {NUM_PORTS{1'b0}};\n                    grant_valid_reg <= 1'b0;\n                    grant_encoded_reg <= {ENC_WIDTH{1'b0}};\n                end\n            end\n        end\n    end\n\n    assign grant = grant_reg;\n    assign grant_valid = grant_valid_reg;\n    assign grant_encoded = grant_encoded_reg;\n\nendmodule\n```<|im_end|>",
