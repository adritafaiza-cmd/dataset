  "text": "```verilog\nmodule arbiter #\n(\n    parameter PORTS = 4,\n    parameter ARB_TYPE_ROUND_ROBIN = 0,\n    parameter ARB_BLOCK = 0,\n    parameter ARB_BLOCK_ACK = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 0\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    input  wire [PORTS-1:0]         request,\n    input  wire [PORTS-1:0]         acknowledge,\n    output wire [PORTS-1:0]         grant,\n    output wire                     grant_valid,\n    output wire [$clog2(PORTS)-1:0] grant_encoded\n);\n\n    localparam NUM_PORTS = PORTS;\n    localparam ENC_WIDTH = $clog2(PORTS);\n\n    // State registers\n    reg [NUM_PORTS-1:0] grant_reg;\n    reg                 grant_valid_reg;\n    reg [ENC_WIDTH-1:0] grant_encoded_reg;\n    reg [NUM_PORTS-1:0] last_grant_mask; // For round-robin: mask of ports with higher priority than last granted\n\n    // Combinational logic for next state\n    wire [NUM_PORTS-1:0] next_grant;\n    wire                 next_grant_valid;\n    wire [ENC_WIDTH-1:0] next_grant_encoded;\n\n    // Helper: find first set bit (LSB first)\n    function [NUM_PORTS-1:0] find_first_set;\n        input [NUM_PORTS-1:0] mask;\n        integer i;\n        begin\n            find_first_set = {NUM_PORTS{1'b0}};\n            for (i = 0; i < NUM_PORTS; i = i + 1) begin\n                if (mask[i]) begin\n                    find_first_set[i] = 1'b1;\n                    break;\n                end\n            end\n        end\n    endfunction\n\n    // Helper: find last set bit (MSB first)\n    function [NUM_PORTS-1:0] find_last_set;\n        input [NUM_PORTS-1:0] mask;\n        integer i;\n        begin\n            find_last_set = {NUM_PORTS{1'b0}};\n            for (i = NUM_PORTS-1; i >= 0; i = i - 1) begin\n                if (mask[i]) begin\n                    find_last_set[i] = 1'b1;\n                    break;\n                end\n            end\n        end\n    endfunction\n\n    // Helper: encode one-hot to binary\n    function [ENC_WIDTH-1:0] onehot_to_binary;\n        input [NUM_PORTS-1:0] onehot;\n        integer i;\n        begin\n            onehot_to_binary = {ENC_WIDTH{1'b0}};\n            for (i = 0; i < NUM_PORTS; i = i + 1) begin\n                if (onehot[i]) begin\n                    onehot_to_binary = i[ENC_WIDTH-1:0];\n                    break;\n                end\n            end\n        end\n    endfunction\n\n    // Determine the grant based on arbiter type\n    wire [NUM_PORTS-1:0] arbiter_grant;\n    wire                 arbiter_grant_valid;\n\n    generate\n        if (ARB_TYPE_ROUND_ROBIN) begin\n            // Round-robin: rotate request based on last grant\n            // Create a rotated request where ports after last_grant have higher priority\n            wire [NUM_PORTS-1:0] rotated_request;\n            wire [NUM_PORTS-1:0] rotated_request_high;\n            wire [NUM_PORTS-1:0] rotated_request_low;\n            wire [NUM_PORTS-1:0] rotated_request_combined;\n\n            // If last_grant_mask is all zeros (no previous grant), treat as LSB high priority\n            // last_grant_mask has bits set for ports with index > last_granted_port\n            // We want to prioritize ports in order: last_granted+1, ..., PORTS-1, 0, ..., last_granted\n            \n            // Simpler approach: create a priority vector\n            // For round-robin, we can use a rotating priority scheme\n            // Let's use a different approach: find the first request after the last grant, wrapping around\n            \n            wire [NUM_PORTS-1:0] request_after_last;\n            wire [NUM_PORTS-1:0] request_before_last;\n            wire                 has_request_after;\n            wire                 has_request_before;\n\n            // request_after_last: bits from last_granted+1 to PORTS-1\n            // request_before_last: bits from 0 to last_granted\n            // We need to know the last granted port index\n            \n            // Alternative: use a shift register approach\n            // Let's use a simpler method: create a priority mask\n            \n            // For round-robin, we can compute the grant as follows:\n            // 1. If there's a request at a port higher than last_granted, grant the lowest such port\n            // 2. Otherwise, if there's a request at a port lower than or equal to last_granted, grant the lowest such port\n            \n            wire [NUM_PORTS-1:0] higher_priority_request;\n            wire [NUM_PORTS-1:0] lower_priority_request;\n            wire                 higher_valid;\n            wire                 lower_valid;\n\n            // higher_priority_request: request bits where index > last_granted_index\n            // lower_priority_request: request bits where index <= last_granted_index\n            \n            // We need to extract the last granted index from last_grant_mask\n            // last_grant_mask has bits set for all ports with index > last_granted_index\n            // So the last granted index is the position of the lowest set bit in ~last_grant_mask (if any)\n            // Actually, let's store the last granted index directly\n            \n            // Let me restructure: store last_granted_index instead\n            // But we already have last_grant_mask. Let's compute from it.\n            \n            // If last_grant_mask is 0, it means no previous grant or last grant was at port 0\n            // Let's use a different state: last_granted_port\n            \n            // I'll restructure the state to use last_granted_port\n        end\n        else begin\n            // Fixed priority\n            if (ARB_LSB_HIGH_PRIORITY) begin\n                assign arbiter_grant = find_first_set(request);\n            end\n            else begin\n                assign arbiter_grant = find_last_set(request);\n            end\n            assign arbiter_grant_valid = |request;\n        end\n    endgenerate\n\n    // Let me redo this with a cleaner approach using last_granted_port\n    reg [ENC_WIDTH-1:0] last_granted_port;\n\n    generate\n        if (ARB_TYPE_ROUND_ROBIN) begin\n            wire [NUM_PORTS-1:0] request_high;\n            wire [NUM_PORTS-1:0] request_low;\n            wire                 high_valid;\n            wire                 low_valid;\n            wire [NUM_PORTS-1:0] grant_high;\n            wire [NUM_PORTS-1:0] grant_low;\n\n            // Ports with index > last_granted_port\n            genvar i;\n            for (i = 0; i < NUM_PORTS; i = i + 1) begin : gen_high\n                assign request_high[i] = (i > last_granted_port) ? request[i] : 1'b0;\n            end\n\n            // Ports with index <= last_granted_port\n            for (i = 0; i < NUM_PORTS; i = i + 1) begin : gen_low\n                assign request_low[i] = (i <= last_granted_port) ? request[i] : 1'b0;\n            end\n\n            assign high_valid = |request_high;\n            assign low_valid  = |request_low;\n\n            assign grant_high = find_first_set(request_high);\n            assign grant_low  = find_first_set(request_low);\n\n            // Prefer higher priority (ports after last grant)\n            assign arbiter_grant = high_valid ? grant_high : grant_low;\n            assign arbiter_grant_valid = high_valid | low_valid;\n        end\n        else begin\n            if (ARB_LSB_HIGH_PRIORITY) begin\n                assign arbiter_grant = find_first_set(request);\n            end\n            else begin\n                assign arbiter_grant = find_last_set(request);\n            end\n            assign arbiter_grant_valid = |request;\n        end\n    endgenerate\n\n    // Blocking logic\n    wire block_active;\n    wire release_event;\n\n    generate\n        if (ARB_BLOCK) begin\n            if (ARB_BLOCK_ACK) begin\n                // Block until acknowledge\n                assign block_active = grant_valid_reg & ~(|acknowledge);\n                assign release_event = grant_valid_reg & (|acknowledge);\n            end\n            else begin\n                // No blocking (or always release)\n                assign block_active = 1'b0;\n                assign release_event = 1'b1;\n            end\n        end\n        else begin\n            assign block_active = 1'b0;\n            assign release_event = 1'b1;\n        end\n    endgenerate\n\n    // Next state logic\n    wire [NUM_PORTS-1:0] next_grant_comb;\n    wire                 next_grant_valid_comb;\n    wire [ENC_WIDTH-1:0] next_grant_encoded_comb;\n\n    assign next_grant_comb = block_active ? grant_reg : arbiter_grant;\n    assign next_grant_valid_comb = block_active ? grant_valid_reg : arbiter_grant_valid;\n    assign next_grant_encoded_comb = block_active ? grant_encoded_reg : onehot_to_binary(arbiter_grant);\n\n    // Sequential logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            grant_reg <= {NUM_PORTS{1'b0}};\n            grant_valid_reg <= 1'b0;\n            grant_encoded_reg <= {ENC_WIDTH{1'b0}};\n            last_granted_port <= {ENC_WIDTH{1'b0}};\n        end\n        else begin\n            grant_reg <= next_grant_comb;\n            grant_valid_reg <= next_grant_valid_comb;\n            grant_encoded_reg <= next_grant_encoded_comb;\n            \n            // Update last_granted_port for round-robin\n            if (ARB_TYPE_ROUND_ROBIN && next_grant_valid_comb && !block_active) begin\n                last_granted_port <= next_grant_encoded_comb;\n            end\n        end\n    end\n\n    // Outputs\n    assign grant = grant_reg;\n    assign grant_valid = grant_valid_reg;\n    assign grant_encoded = grant_encoded_reg;\n\nendmodule\n```<|im_end|>",
