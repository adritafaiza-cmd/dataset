{
  "text": "```verilog\nmodule arbiter #\n(\n    parameter PORTS = 4,\n    parameter ARB_TYPE_ROUND_ROBIN = 0,\n    parameter ARB_BLOCK = 0,\n    parameter ARB_BLOCK_ACK = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 0\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    input  wire [PORTS-1:0]         request,\n    input  wire [PORTS-1:0]         acknowledge,\n    output wire [PORTS-1:0]         grant,\n    output wire                     grant_valid,\n    output wire [$clog2(PORTS)-1:0] grant_encoded\n);\n\n    localparam GRANT_WIDTH = $clog2(PORTS);\n\n    reg [PORTS-1:0] grant_reg;\n    reg             grant_valid_reg;\n    reg [GRANT_WIDTH-1:0] grant_encoded_reg;\n\n    // For round-robin, track the last granted index\n    reg [GRANT_WIDTH-1:0] last_grant_idx;\n\n    // For blocking, track if a grant is currently held\n    reg block_hold;\n\n    // Function to find the lowest set bit index (LSB priority)\n    function [GRANT_WIDTH-1:0] find_lsb;\n        input [PORTS-1:0] mask;\n        integer i;\n        begin\n            find_lsb = 0;\n            for (i = 0; i < PORTS; i = i + 1) begin\n                if (mask[i]) begin\n                    find_lsb = i[GRANT_WIDTH-1:0];\n                    disable find_lsb;\n                end\n            end\n        end\n    endfunction\n\n    // Function to find the highest set bit index (MSB priority)\n    function [GRANT_WIDTH-1:0] find_msb;\n        input [PORTS-1:0] mask;\n        integer i;\n        begin\n            find_msb = 0;\n            for (i = PORTS-1; i >= 0; i = i - 1) begin\n                if (mask[i]) begin\n                    find_msb = i[GRANT_WIDTH-1:0];\n                    disable find_msb;\n                end\n            end\n        end\n    endfunction\n\n    // Round-robin: find the next requester after last_grant_idx\n    function [GRANT_WIDTH-1:0] find_round_robin;\n        input [PORTS-1:0] mask;\n        input [GRANT_WIDTH-1:0] last_idx;\n        integer i;\n        integer start;\n        begin\n            find_round_robin = 0;\n            start = last_idx + 1;\n            if (start >= PORTS) start = 0;\n            for (i = 0; i < PORTS; i = i + 1) begin\n                if (start + i >= PORTS) begin\n                    if (mask[(start + i) % PORTS]) begin\n                        find_round_robin = ((start + i) % PORTS)[GRANT_WIDTH-1:0];\n                        disable find_round_robin;\n                    end\n                end else begin\n                    if (mask[start + i]) begin\n                        find_round_robin = (start + i)[GRANT_WIDTH-1:0];\n                        disable find_round_robin;\n                    end\n                end\n            end\n        end\n    endfunction\n\n    wire [PORTS-1:0] next_grant;\n    wire             next_grant_valid;\n    wire [GRANT_WIDTH-1:0] next_grant_encoded;\n\n    // Determine the next grant based on arbiter type\n    wire [PORTS-1:0] active_request;\n    assign active_request = request;\n\n    // Fixed priority\n    wire [GRANT_WIDTH-1:0] fixed_priority_idx;\n    wire                   fixed_priority_valid;\n    assign fixed_priority_valid = |active_request;\n    assign fixed_priority_idx = ARB_LSB_HIGH_PRIORITY ? find_lsb(active_request) : find_msb(active_request);\n\n    // Round-robin\n    wire [GRANT_WIDTH-1:0] round_robin_idx;\n    wire                   round_robin_valid;\n    assign round_robin_valid = |active_request;\n    assign round_robin_idx = find_round_robin(active_request, last_grant_idx);\n\n    // Select based on ARB_TYPE_ROUND_ROBIN\n    assign next_grant_valid = ARB_TYPE_ROUND_ROBIN ? round_robin_valid : fixed_priority_valid;\n    assign next_grant_encoded = ARB_TYPE_ROUND_ROBIN ? round_robin_idx : fixed_priority_idx;\n\n    // Generate one-hot grant from encoded\n    reg [PORTS-1:0] next_grant_onehot;\n    integer j;\n    always @* begin\n        next_grant_onehot = {PORTS{1'b0}};\n        for (j = 0; j < PORTS; j = j + 1) begin\n            if (j == next_grant_encoded) begin\n                next_grant_onehot[j] = 1'b1;\n            end\n        end\n    end\n\n    assign next_grant = next_grant_onehot;\n\n    // Blocking logic\n    wire release_event;\n    assign release_event = (ARB_BLOCK_ACK == 1) ? acknowledge[next_grant_encoded] : 1'b1;\n\n    // If blocking is enabled and we're holding a grant, keep it until release\n    wire hold_grant;\n    assign hold_grant = ARB_BLOCK && block_hold && !release_event;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            grant_reg <= {PORTS{1'b0}};\n            grant_valid_reg <= 1'b0;\n            grant_encoded_reg <= {GRANT_WIDTH{1'b0}};\n            last_grant_idx <= {GRANT_WIDTH{1'b0}};\n            block_hold <= 1'b0;\n        end else begin\n            if (hold_grant) begin\n                // Hold the current grant\n                grant_reg <= grant_reg;\n                grant_valid_reg <= grant_valid_reg;\n                grant_encoded_reg <= grant_encoded_reg;\n                block_hold <= 1'b1;\n            end else begin\n                // Update grant\n                grant_reg <= next_grant;\n                grant_valid_reg <= next_grant_valid;\n                grant_encoded_reg <= next_grant_encoded;\n                \n                // Update last grant index for round-robin\n                if (next_grant_valid) begin\n                    last_grant_idx <= next_grant_encoded;\n                end\n                \n                // Update block hold\n                if (ARB_BLOCK && next_grant_valid) begin\n                    block_hold <= 1'b1;\n                end else begin\n                    block_hold <= 1'b0;\n                end\n            end\n        end\n    end\n\n    assign grant = grant_reg;\n    assign grant_valid = grant_valid_reg;\n    assign grant_encoded = grant_encoded_reg;\n\nendmodule\n```<|im_end|>",
