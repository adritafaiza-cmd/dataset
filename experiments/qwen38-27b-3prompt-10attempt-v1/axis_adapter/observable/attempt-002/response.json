  "text": "```verilog\nmodule axis_adapter #\n(\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    /*\n     * AXI input\n     */\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser\n);\n\n    // Internal parameters\n    localparam S_BYTES = (S_DATA_WIDTH + 7) / 8;\n    localparam M_BYTES = (M_DATA_WIDTH + 7) / 8;\n    localparam S_KEEP_W = (S_DATA_WIDTH > 8) ? S_KEEP_WIDTH : 1;\n    localparam M_KEEP_W = (M_DATA_WIDTH > 8) ? M_KEEP_WIDTH : 1;\n\n    // State machine states\n    localparam ST_IDLE = 2'd0;\n    localparam ST_SEND = 2'd1;\n    localparam ST_WAIT = 2'd2;\n\n    // Registers\n    reg [1:0] state;\n    reg [S_DATA_WIDTH-1:0] data_buf;\n    reg [S_KEEP_W-1:0] keep_buf;\n    reg s_axis_tlast_buf;\n    reg [ID_WIDTH-1:0] tid_buf;\n    reg [DEST_WIDTH-1:0] tdest_buf;\n    reg [USER_WIDTH-1:0] tuser_buf;\n\n    // Byte counter for output\n    reg [3:0] byte_count;\n    reg [3:0] total_bytes;\n\n    // Output registers\n    reg [M_DATA_WIDTH-1:0] m_axis_tdata_reg;\n    reg [M_KEEP_W-1:0] m_axis_tkeep_reg;\n    reg m_axis_tvalid_reg;\n    reg m_axis_tlast_reg;\n    reg [ID_WIDTH-1:0] m_axis_tid_reg;\n    reg [DEST_WIDTH-1:0] m_axis_tdest_reg;\n    reg [USER_WIDTH-1:0] m_axis_tuser_reg;\n\n    // Helper: count valid bytes in keep signal\n    function [3:0] count_bytes;\n        input [S_KEEP_W-1:0] keep;\n        integer i;\n        begin\n            count_bytes = 0;\n            for (i = 0; i < S_KEEP_W; i = i + 1) begin\n                count_bytes = count_bytes + keep[i];\n            end\n        end\n    endfunction\n\n    // Helper: extract byte from data based on keep\n    function [7:0] get_byte;\n        input [S_DATA_WIDTH-1:0] data;\n        input [S_KEEP_W-1:0] keep;\n        input [3:0] byte_idx;\n        integer i;\n        integer cnt;\n        begin\n            get_byte = 8'h00;\n            cnt = 0;\n            for (i = 0; i < S_KEEP_W; i = i + 1) begin\n                if (keep[i]) begin\n                    if (cnt == byte_idx) begin\n                        get_byte = data[i*8 +: 8];\n                    end\n                    cnt = cnt + 1;\n                end\n            end\n        end\n    endfunction\n\n    // Helper: build output data from input bytes\n    function [M_DATA_WIDTH-1:0] build_m_data;\n        input [S_DATA_WIDTH-1:0] data;\n        input [S_KEEP_W-1:0] keep;\n        input [3:0] start_byte;\n        integer i;\n        integer cnt;\n        integer m_byte_idx;\n        begin\n            build_m_data = {M_DATA_WIDTH{1'b0}};\n            m_byte_idx = 0;\n            cnt = 0;\n            for (i = 0; i < S_KEEP_W; i = i + 1) begin\n                if (keep[i]) begin\n                    if (cnt >= start_byte && m_byte_idx < M_BYTES) begin\n                        build_m_data[m_byte_idx*8 +: 8] = data[i*8 +: 8];\n                        m_byte_idx = m_byte_idx + 1;\n                    end\n                    cnt = cnt + 1;\n                end\n            end\n        end\n    endfunction\n\n    // Helper: build output keep from input keep\n    function [M_KEEP_W-1:0] build_m_keep;\n        input [S_KEEP_W-1:0] keep;\n        input [3:0] start_byte;\n        input [3:0] num_bytes;\n        integer i;\n        integer cnt;\n        integer m_byte_idx;\n        begin\n            build_m_keep = {M_KEEP_W{1'b0}};\n            m_byte_idx = 0;\n            cnt = 0;\n            for (i = 0; i < S_KEEP_W; i = i + 1) begin\n                if (keep[i]) begin\n                    if (cnt >= start_byte && m_byte_idx < M_BYTES && m_byte_idx < num_bytes) begin\n                        build_m_keep[m_byte_idx] = 1'b1;\n                        m_byte_idx = m_byte_idx + 1;\n                    end\n                    cnt = cnt + 1;\n                end\n            end\n        end\n    endfunction\n\n    // Determine how many bytes to send in current output beat\n    wire [3:0] bytes_to_send = (total_bytes - byte_count) < M_BYTES ? (total_bytes - byte_count) : M_BYTES;\n\n    // Output data and keep generation\n    wire [M_DATA_WIDTH-1:0] m_data_next = build_m_data(data_buf, keep_buf, byte_count);\n    wire [M_KEEP_W-1:0] m_keep_next = build_m_keep(keep_buf, byte_count, bytes_to_send);\n\n    // Determine if this is the last beat\n    wire is_last_beat = (byte_count + bytes_to_send) >= total_bytes;\n\n    // State machine\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            state <= ST_IDLE;\n            data_buf <= {S_DATA_WIDTH{1'b0}};\n            keep_buf <= {S_KEEP_W{1'b0}};\n            s_axis_tlast_buf <= 1'b0;\n            tid_buf <= {ID_WIDTH{1'b0}};\n            tdest_buf <= {DEST_WIDTH{1'b0}};\n            tuser_buf <= {USER_WIDTH{1'b0}};\n            byte_count <= 4'd0;\n            total_bytes <= 4'd0;\n            m_axis_tdata_reg <= {M_DATA_WIDTH{1'b0}};\n            m_axis_tkeep_reg <= {M_KEEP_W{1'b0}};\n            m_axis_tvalid_reg <= 1'b0;\n            m_axis_tlast_reg <= 1'b0;\n            m_axis_tid_reg <= {ID_WIDTH{1'b0}};\n            m_axis_tdest_reg <= {DEST_WIDTH{1'b0}};\n            m_axis_tuser_reg <= {USER_WIDTH{1'b0}};\n        end else begin\n            case (state)\n                ST_IDLE: begin\n                    m_axis_tvalid_reg <= 1'b0;\n                    if (s_axis_tvalid) begin\n                        data_buf <= s_axis_tdata;\n                        keep_buf <= s_axis_tkeep;\n                        s_axis_tlast_buf <= s_axis_tlast;\n                        tid_buf <= s_axis_tid;\n                        tdest_buf <= s_axis_tdest;\n                        tuser_buf <= s_axis_tuser;\n                        total_bytes <= count_bytes(s_axis_tkeep);\n                        byte_count <= 4'd0;\n                        state <= ST_SEND;\n                    end\n                end\n\n                ST_SEND: begin\n                    // Prepare output\n                    m_axis_tdata_reg <= m_data_next;\n                    m_axis_tkeep_reg <= m_keep_next;\n                    m_axis_tvalid_reg <= 1'b1;\n                    m_axis_tlast_reg <= is_last_beat & s_axis_tlast_buf;\n                    m_axis_tid_reg <= tid_buf;\n                    m_axis_tdest_reg <= tdest_buf;\n                    m_axis_tuser_reg <= tuser_buf;\n\n                    if (m_axis_tready) begin\n                        if (is_last_beat) begin\n                            state <= ST_IDLE;\n                            m_axis_tvalid_reg <= 1'b0;\n                        end else begin\n                            byte_count <= byte_count + bytes_to_send;\n                            state <= ST_SEND;\n                        end\n                    end\n                end\n\n                default: begin\n                    state <= ST_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Output assignments\n    assign m_axis_tdata = m_axis_tdata_reg;\n    assign m_axis_tkeep = m_axis_tkeep_reg;\n    assign m_axis_tvalid = m_axis_tvalid_reg;\n    assign m_axis_tlast = m_axis_tlast_reg;\n    assign m_axis_tid = m_axis_tid_reg;\n    assign m_axis_tdest = m_axis_tdest_reg;\n    assign m_axis_tuser = m_axis_tuser_reg;\n\n    // Input ready\n    assign s_axis_tready = (state == ST_IDLE);\n\nendmodule\n```<|im_end|>",
