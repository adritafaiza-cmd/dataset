  "text": "```verilog\nmodule axis_adapter #\n(\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser\n);\n\n    localparam S_BYTES = (S_DATA_WIDTH + 7) / 8;\n    localparam M_BYTES = (M_DATA_WIDTH + 7) / 8;\n    localparam MAX_BYTES = (S_BYTES > M_BYTES) ? S_BYTES : M_BYTES;\n    localparam MAX_BITS = MAX_BYTES * 8;\n\n    // State machine\n    localparam ST_IDLE = 2'd0;\n    localparam ST_SPLIT = 2'd1;\n    localparam ST_MERGE = 2'd2;\n\n    reg [1:0] state;\n    reg [MAX_BITS-1:0] buffer;\n    reg [3:0] buf_bytes; // number of valid bytes in buffer (0 to MAX_BYTES)\n    reg [3:0] s_bytes;   // number of valid bytes from current s beat\n    reg [3:0] m_bytes;   // number of valid bytes to output in current m beat\n    reg s_tlast_reg;\n    reg [ID_WIDTH-1:0] s_tid_reg;\n    reg [DEST_WIDTH-1:0] s_tdest_reg;\n    reg [USER_WIDTH-1:0] s_tuser_reg;\n\n    // Helper: count valid bytes from tkeep\n    function [3:0] count_bytes;\n        input [S_KEEP_WIDTH-1:0] keep;\n        integer i;\n        begin\n            count_bytes = 0;\n            for (i = 0; i < S_KEEP_WIDTH; i = i + 1)\n                if (keep[i])\n                    count_bytes = count_bytes + 1;\n        end\n    endfunction\n\n    // Helper: extract bytes from s_axis_tdata based on tkeep\n    // We'll build the buffer by shifting in valid bytes\n    // For simplicity, we assume tkeep is contiguous from LSB (standard AXI-Stream)\n    // But to be safe, we handle general case by packing valid bytes\n\n    // Function to pack valid bytes from s_axis_tdata into a byte array\n    // Returns packed bytes in lower bits\n    function [MAX_BITS-1:0] pack_s_bytes;\n        input [S_DATA_WIDTH-1:0] data;\n        input [S_KEEP_WIDTH-1:0] keep;\n        integer i, byte_idx;\n        reg [7:0] tmp_byte;\n        begin\n            pack_s_bytes = 0;\n            byte_idx = 0;\n            for (i = 0; i < S_KEEP_WIDTH; i = i + 1) begin\n                if (keep[i]) begin\n                    tmp_byte = data[i*8 +: 8];\n                    pack_s_bytes[byte_idx*8 +: 8] = tmp_byte;\n                    byte_idx = byte_idx + 1;\n                end\n            end\n        end\n    endfunction\n\n    // Function to unpack bytes from buffer to m_axis_tdata\n    function [M_DATA_WIDTH-1:0] unpack_m_bytes;\n        input [MAX_BITS-1:0] buf;\n        input [3:0] num_bytes;\n        integer i;\n        begin\n            unpack_m_bytes = 0;\n            for (i = 0; i < M_KEEP_WIDTH; i = i + 1) begin\n                if (i < num_bytes)\n                    unpack_m_bytes[i*8 +: 8] = buf[i*8 +: 8];\n                else\n                    unpack_m_bytes[i*8 +: 8] = 8'h00;\n            end\n        end\n    endfunction\n\n    // Function to generate m_axis_tkeep\n    function [M_KEEP_WIDTH-1:0] gen_m_keep;\n        input [3:0] num_bytes;\n        integer i;\n        begin\n            gen_m_keep = 0;\n            for (i = 0; i < M_KEEP_WIDTH; i = i + 1) begin\n                if (i < num_bytes)\n                    gen_m_keep[i] = 1'b1;\n                else\n                    gen_m_keep[i] = 1'b0;\n            end\n        end\n    endfunction\n\n    // Determine if we can accept a new s beat\n    wire s_can_accept = (state == ST_IDLE) || \n                        ((state == ST_SPLIT) && (buf_bytes + s_bytes <= MAX_BYTES));\n\n    // Determine if we can output an m beat\n    wire m_can_output = (state != ST_IDLE) && (buf_bytes > 0);\n\n    // Calculate how many bytes to output in current m beat\n    wire [3:0] bytes_to_output = (buf_bytes >= M_BYTES) ? M_BYTES[3:0] : buf_bytes;\n\n    // Determine if this m beat is the last\n    wire m_is_last = (state == ST_SPLIT) ? (s_tlast_reg && (buf_bytes <= M_BYTES)) :\n                     (state == ST_MERGE) ? (s_tlast_reg && (buf_bytes <= M_BYTES)) :\n                     1'b0;\n\n    // Assign outputs\n    assign s_axis_tready = s_can_accept;\n    assign m_axis_tvalid = m_can_output;\n    assign m_axis_tdata = unpack_m_bytes(buffer, bytes_to_output);\n    assign m_axis_tkeep = gen_m_keep(bytes_to_output);\n    assign m_axis_tlast = m_is_last;\n    assign m_axis_tid = s_tid_reg;\n    assign m_axis_tdest = s_tdest_reg;\n    assign m_axis_tuser = s_tuser_reg;\n\n    // State machine logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            state <= ST_IDLE;\n            buffer <= {MAX_BITS{1'b0}};\n            buf_bytes <= 4'd0;\n            s_bytes <= 4'd0;\n            s_tlast_reg <= 1'b0;\n            s_tid_reg <= {ID_WIDTH{1'b0}};\n            s_tdest_reg <= {DEST_WIDTH{1'b0}};\n            s_tuser_reg <= {USER_WIDTH{1'b0}};\n        end else begin\n            case (state)\n                ST_IDLE: begin\n                    if (s_axis_tvalid && s_axis_tready) begin\n                        // Accept s beat\n                        s_bytes <= count_bytes(s_axis_tkeep);\n                        s_tlast_reg <= s_axis_tlast;\n                        s_tid_reg <= s_axis_tid;\n                        s_tdest_reg <= s_axis_tdest;\n                        s_tuser_reg <= s_axis_tuser;\n                        \n                        // Pack bytes into buffer\n                        buffer <= pack_s_bytes(s_axis_tdata, s_axis_tkeep);\n                        buf_bytes <= count_bytes(s_axis_tkeep);\n                        \n                        if (count_bytes(s_axis_tkeep) >= M_BYTES) begin\n                            // Need to split or output directly\n                            if (count_bytes(s_axis_tkeep) == M_BYTES) begin\n                                // Exact fit, output and go to idle\n                                state <= ST_IDLE;\n                                buf_bytes <= 4'd0;\n                            end else begin\n                                // Split\n                                state <= ST_SPLIT;\n                            end\n                        end else begin\n                            // Merge: need more data\n                            state <= ST_MERGE;\n                        end\n                    end\n                end\n                \n                ST_SPLIT: begin\n                    if (m_axis_tvalid && m_axis_tready) begin\n                        // Output M_BYTES from buffer\n                        // Shift buffer left by M_BYTES\n                        buffer <= buffer << (M_BYTES * 8);\n                        buf_bytes <= buf_bytes - M_BYTES;\n                        \n                        if (buf_bytes == M_BYTES) begin\n                            // Exactly one more m beat needed\n                            state <= ST_IDLE;\n                            buf_bytes <= 4'd0;\n                        end else if (buf_bytes == 0) begin\n                            // Done\n                            state <= ST_IDLE;\n                        end else begin\n                            // Still have data, continue splitting\n                            state <= ST_SPLIT;\n                        end\n                    end\n                end\n                \n                ST_MERGE: begin\n                    if (s_axis_tvalid && s_axis_tready) begin\n                        // Accept new s beat and merge into buffer\n                        // Shift existing buffer up by s_bytes\n                        // Pack new bytes and append\n                        buffer <= (buffer << (count_bytes(s_axis_tkeep) * 8)) | \n                                  pack_s_bytes(s_axis_tdata, s_axis_tkeep);\n                        buf_bytes <= buf_bytes + count_bytes(s_axis_tkeep);\n                        \n                        // Update sideband if this is the last beat\n                        if (s_axis_tlast) begin\n                            s_tlast_reg <= 1'b1;\n                            s_tid_reg <= s_axis_tid;\n                            s_tdest_reg <= s_axis_tdest;\n                            s_tuser_reg <= s_axis_tuser;\n                        end\n                        \n                        if (buf_bytes >= M_BYTES) begin\n                            state <= ST_SPLIT;\n                        end else begin\n                            state <= ST_MERGE;\n                        end\n                    end\n                end\n                \n                default: begin\n                    state <= ST_IDLE;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
