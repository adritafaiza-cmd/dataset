  "text": "```verilog\nmodule axis_adapter #\n(\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    /*\n     * AXI input\n     */\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser\n);\n\n    // Calculate bytes per beat\n    localparam S_BYTES = (S_DATA_WIDTH + 7) / 8;\n    localparam M_BYTES = (M_DATA_WIDTH + 7) / 8;\n    \n    // Determine if we need to pack or unpack\n    // If S_DATA_WIDTH > M_DATA_WIDTH, we need to split (unpack)\n    // If S_DATA_WIDTH < M_DATA_WIDTH, we need to combine (pack)\n    // If equal, direct pass-through\n    \n    // For simplicity and correctness, we'll handle the general case using a byte-level buffer approach.\n    // However, for a single-clock domain, we can use a simpler state machine.\n    \n    // Let's define the ratio\n    // If S_DATA_WIDTH is a multiple of M_DATA_WIDTH, we can split\n    // If M_DATA_WIDTH is a multiple of S_DATA_WIDTH, we can pack\n    \n    // General approach: Use a shift register / byte buffer\n    // We'll accumulate bytes from the source and emit bytes to the destination.\n    \n    // Number of bytes to buffer\n    localparam MAX_BYTES = (S_DATA_WIDTH > M_DATA_WIDTH) ? S_DATA_WIDTH/8 : M_DATA_WIDTH/8;\n    \n    // We'll use a byte-level FIFO-like structure\n    // Actually, for a width converter, the simplest robust approach is:\n    // 1. If S_DATA_WIDTH == M_DATA_WIDTH: direct connection\n    // 2. If S_DATA_WIDTH > M_DATA_WIDTH: split each S beat into multiple M beats\n    // 3. If S_DATA_WIDTH < M_DATA_WIDTH: accumulate S beats into one M beat\n    \n    // Let's implement a general byte buffer approach\n    // Buffer size: max(S_DATA_WIDTH, M_DATA_WIDTH) bits\n    \n    localparam BUF_WIDTH = (S_DATA_WIDTH > M_DATA_WIDTH) ? S_DATA_WIDTH : M_DATA_WIDTH;\n    localparam BUF_BYTES = (BUF_WIDTH + 7) / 8;\n    \n    // State machine\n    // IDLE: waiting for data\n    // FILL: accumulating data\n    // DRAIN: sending data\n    \n    // For simplicity, let's handle the three cases separately\n    \n    // Case 1: Equal widths\n    wire eq_width = (S_DATA_WIDTH == M_DATA_WIDTH);\n    \n    // Case 2: S wider than M (split)\n    wire s_wider = (S_DATA_WIDTH > M_DATA_WIDTH);\n    \n    // Case 3: M wider than S (pack)\n    wire m_wider = (M_DATA_WIDTH > S_DATA_WIDTH);\n    \n    // For equal widths, direct pass-through\n    wire [S_DATA_WIDTH-1:0] m_axis_tdata_eq;\n    wire [S_KEEP_WIDTH-1:0] m_axis_tkeep_eq;\n    wire m_axis_tvalid_eq;\n    wire m_axis_tlast_eq;\n    wire [ID_WIDTH-1:0] m_axis_tid_eq;\n    wire [DEST_WIDTH-1:0] m_axis_tdest_eq;\n    wire [USER_WIDTH-1:0] m_axis_tuser_eq;\n    wire s_axis_tready_eq;\n    \n    assign m_axis_tdata_eq = s_axis_tdata;\n    assign m_axis_tkeep_eq = s_axis_tkeep;\n    assign m_axis_tvalid_eq = s_axis_tvalid;\n    assign m_axis_tlast_eq = s_axis_tlast;\n    assign m_axis_tid_eq = s_axis_tid;\n    assign m_axis_tdest_eq = s_axis_tdest;\n    assign m_axis_tuser_eq = s_axis_tuser;\n    assign s_axis_tready_eq = m_axis_tready;\n    \n    // For split case (S wider than M)\n    // We need to split each S beat into S_DATA_WIDTH/M_DATA_WIDTH M beats\n    // Assuming S_DATA_WIDTH is a multiple of M_DATA_WIDTH\n    \n    // For pack case (M wider than S)\n    // We need to accumulate M_DATA_WIDTH/S_DATA_WIDTH S beats into one M beat\n    // Assuming M_DATA_WIDTH is a multiple of S_DATA_WIDTH\n    \n    // Let's implement a general byte buffer approach that handles all cases\n    \n    // Byte buffer\n    reg [BUF_WIDTH-1:0] byte_buf;\n    reg [BUF_BYTES-1:0] byte_valid;\n    reg [BUF_BYTES-1:0] byte_last;\n    reg [ID_WIDTH-1:0] buf_tid;\n    reg [DEST_WIDTH-1:0] buf_tdest;\n    reg [USER_WIDTH-1:0] buf_tuser;\n    reg buf_valid;\n    \n    // State\n    localparam S_IDLE = 2'd0;\n    localparam S_FILL = 2'd1;\n    localparam S_DRAIN = 2'd2;\n    \n    reg [1:0] state;\n    \n    // Counters\n    reg [3:0] fill_count;\n    reg [3:0] drain_count;\n    \n    // Calculate how many S beats to fill one M beat (for pack)\n    // Or how many M beats to drain from one S beat (for split)\n    \n    // For now, let's implement a simpler approach:\n    // If widths are equal, direct pass-through\n    // If S is wider, split\n    // If M is wider, pack\n    \n    // Split implementation\n    reg [S_DATA_WIDTH-1:0] split_buf;\n    reg [3:0] split_count;\n    reg split_valid;\n    reg split_last;\n    reg [ID_WIDTH-1:0] split_tid;\n    reg [DEST_WIDTH-1:0] split_tdest;\n    reg [USER_WIDTH-1:0] split_tuser;\n    \n    // Pack implementation\n    reg [M_DATA_WIDTH-1:0] pack_buf;\n    reg [3:0] pack_count;\n    reg pack_valid;\n    reg pack_last;\n    reg [ID_WIDTH-1:0] pack_tid;\n    reg [DEST_WIDTH-1:0] pack_tdest;\n    reg [USER_WIDTH-1:0] pack_tuser;\n    \n    // Output mux\n    assign m_axis_tdata = eq_width ? m_axis_tdata_eq : (s_wider ? split_buf[0:M_DATA_WIDTH-1] : pack_buf);\n    assign m_axis_tkeep = eq_width ? m_axis_tkeep_eq : (s_wider ? {M_KEEP_WIDTH{1'b1}} : {M_KEEP_WIDTH{1'b1}});\n    assign m_axis_tvalid = eq_width ? m_axis_tvalid_eq : (s_wider ? split_valid : pack_valid);\n    assign m_axis_tlast = eq_width ? m_axis_tlast_eq : (s_wider ? split_last : pack_last);\n    assign m_axis_tid = eq_width ? m_axis_tid_eq : (s_wider ? split_tid : pack_tid);\n    assign m_axis_tdest = eq_width ? m_axis_tdest_eq : (s_wider ? split_tdest : pack_tdest);\n    assign m_axis_tuser = eq_width ? m_axis_tuser_eq : (s_wider ? split_tuser : pack_tuser);\n    \n    assign s_axis_tready = eq_width ? s_axis_tready_eq : (s_wider ? (split_valid == 0 || m_axis_tready) : (pack_valid == 0 || m_axis_tready));\n    \n    // Split logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            split_buf <= {S_DATA_WIDTH{1'b0}};\n            split_count <= 4'd0;\n            split_valid <= 1'b0;\n            split_last <= 1'b0;\n            split_tid <= {ID_WIDTH{1'b0}};\n            split_tdest <= {DEST_WIDTH{1'b0}};\n            split_tuser <= {USER_WIDTH{1'b0}};\n        end else begin\n            if (s_wider) begin\n                if (s_axis_tvalid && s_axis_tready) begin\n                    split_buf <= s_axis_tdata;\n                    split_count <= 4'd0;\n                    split_valid <= 1'b1;\n                    split_last <= s_axis_tlast;\n                    split_tid <= s_axis_tid;\n                    split_tdest <= s_axis_tdest;\n                    split_tuser <= s_axis_tuser;\n                end else if (split_valid && m_axis_tready) begin\n                    split_count <= split_count + 1'b1;\n                    if (split_count == (S_DATA_WIDTH/M_DATA_WIDTH - 1)) begin\n                        split_valid <= 1'b0;\n                        split_last <= 1'b0;\n                    end else begin\n                        split_buf <= {split_buf[M_DATA_WIDTH-1:0], {M_DATA_WIDTH{1'b0}}};\n                        split_last <= 1'b0;\n                    end\n                end\n            end\n        end\n    end\n    \n    // Pack logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            pack_buf <= {M_DATA_WIDTH{1'b0}};\n            pack_count <= 4'd0;\n            pack_valid <= 1'b0;\n            pack_last <= 1'b0;\n            pack_tid <= {ID_WIDTH{1'b0}};\n            pack_tdest <= {DEST_WIDTH{1'b0}};\n            pack_tuser <= {USER_WIDTH{1'b0}};\n        end else begin\n            if (m_wider) begin\n                if (s_axis_tvalid && s_axis_tready) begin\n                    pack_buf <= {pack_buf[S_DATA_WIDTH-1:0], s_axis_tdata};\n                    pack_count <= pack_count + 1'b1;\n                    if (pack_count == (M_DATA_WIDTH/S_DATA_WIDTH - 1)) begin\n                        pack_valid <= 1'b1;\n                        pack_last <= s_axis_tlast;\n                        pack_tid <= s_axis_tid;\n                        pack_tdest <= s_axis_tdest;\n                        pack_tuser <= s_axis_tuser;\n                    end\n                end else if (pack_valid && m_axis_tready) begin\n                    pack_valid <= 1'b0;\n                    pack_count <= 4'd0;\n                    pack_last <= 1'b0;\n                end\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
