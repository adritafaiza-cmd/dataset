  "text": "```verilog\nmodule axis_adapter #\n(\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1\n)\n(\n    input  wire                     clk,\n    input  wire                     rst,\n    /*\n     * AXI input\n     */\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser\n);\n\n    // Internal signals\n    reg [S_DATA_WIDTH-1:0] s_data_reg;\n    reg [S_KEEP_WIDTH-1:0] s_keep_reg;\n    reg                    s_last_reg;\n    reg [ID_WIDTH-1:0]     s_id_reg;\n    reg [DEST_WIDTH-1:0]   s_dest_reg;\n    reg [USER_WIDTH-1:0]   s_user_reg;\n    reg                    s_valid_reg;\n    reg                    s_ready_reg;\n\n    reg [M_DATA_WIDTH-1:0] m_data_reg;\n    reg [M_KEEP_WIDTH-1:0] m_keep_reg;\n    reg                    m_last_reg;\n    reg [ID_WIDTH-1:0]     m_id_reg;\n    reg [DEST_WIDTH-1:0]   m_dest_reg;\n    reg [USER_WIDTH-1:0]   m_user_reg;\n    reg                    m_valid_reg;\n    reg                    m_ready_reg;\n\n    // State machine\n    localparam S_IDLE = 2'd0;\n    localparam S_PACK = 2'd1;\n    localparam S_UNPACK = 2'd2;\n    localparam S_PASS = 2'd3;\n\n    reg [1:0] state;\n    reg [1:0] next_state;\n\n    // Buffer for packing/unpacking\n    reg [S_DATA_WIDTH-1:0] buffer;\n    reg [S_KEEP_WIDTH-1:0] buffer_keep;\n    reg                    buffer_last;\n    reg [ID_WIDTH-1:0]     buffer_id;\n    reg [DEST_WIDTH-1:0]   buffer_dest;\n    reg [USER_WIDTH-1:0]   buffer_user;\n    reg                    buffer_valid;\n\n    // Byte counter for packing/unpacking\n    reg [7:0] byte_count;\n    reg [7:0] next_byte_count;\n\n    // Determine if we need to pack, unpack, or pass through\n    wire need_pack = (S_DATA_WIDTH > M_DATA_WIDTH);\n    wire need_unpack = (S_DATA_WIDTH < M_DATA_WIDTH);\n    wire pass_through = (S_DATA_WIDTH == M_DATA_WIDTH);\n\n    // Calculate bytes per beat\n    localparam S_BYTES = (S_DATA_WIDTH + 7) / 8;\n    localparam M_BYTES = (M_DATA_WIDTH + 7) / 8;\n\n    // Handshake signals\n    wire s_handshake = s_axis_tvalid && s_ready_reg;\n    wire m_handshake = m_valid_reg && m_axis_tready;\n\n    // State machine logic\n    always @(*) begin\n        next_state = state;\n        next_byte_count = byte_count;\n\n        case (state)\n            S_IDLE: begin\n                if (s_axis_tvalid) begin\n                    if (pass_through) begin\n                        next_state = S_PASS;\n                    end else if (need_pack) begin\n                        next_state = S_PACK;\n                        next_byte_count = 0;\n                    end else if (need_unpack) begin\n                        next_state = S_UNPACK;\n                        next_byte_count = 0;\n                    end\n                end\n            end\n\n            S_PASS: begin\n                if (s_handshake) begin\n                    if (s_axis_tlast) begin\n                        next_state = S_IDLE;\n                    end\n                end\n            end\n\n            S_PACK: begin\n                if (s_handshake) begin\n                    // Accumulate bytes\n                    next_byte_count = byte_count + S_BYTES;\n                    if (s_axis_tlast) begin\n                        // Check if we have enough bytes for at least one M beat\n                        if (byte_count + S_BYTES >= M_BYTES) begin\n                            // We can output at least one beat\n                            // Continue packing until we have less than M_BYTES\n                            if (byte_count + S_BYTES < 2*M_BYTES) begin\n                                next_state = S_PACK;\n                            end else begin\n                                next_state = S_PACK;\n                            end\n                        end\n                    end\n                end\n                if (m_handshake) begin\n                    // Output a beat, reduce buffer\n                    next_byte_count = byte_count - M_BYTES;\n                    if (next_byte_count == 0 && buffer_last) begin\n                        next_state = S_IDLE;\n                    end\n                end\n            end\n\n            S_UNPACK: begin\n                if (s_handshake) begin\n                    // Accumulate bytes\n                    next_byte_count = byte_count + S_BYTES;\n                    if (s_axis_tlast) begin\n                        // Check if we have enough bytes for at least one M beat\n                        if (byte_count + S_BYTES >= M_BYTES) begin\n                            next_state = S_UNPACK;\n                        end\n                    end\n                end\n                if (m_handshake) begin\n                    // Output a beat, reduce buffer\n                    next_byte_count = byte_count - M_BYTES;\n                    if (next_byte_count == 0 && buffer_last) begin\n                        next_state = S_IDLE;\n                    end\n                end\n            end\n\n            default: next_state = S_IDLE;\n        endcase\n    end\n\n    // Register state\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            state <= S_IDLE;\n            byte_count <= 0;\n        end else begin\n            state <= next_state;\n            byte_count <= next_byte_count;\n        end\n    end\n\n    // Input ready logic\n    always @(*) begin\n        s_ready_reg = 1'b0;\n        case (state)\n            S_IDLE: begin\n                s_ready_reg = 1'b1;\n            end\n            S_PASS: begin\n                s_ready_reg = 1'b1;\n            end\n            S_PACK: begin\n                // Accept input if buffer has space\n                s_ready_reg = (byte_count < (2*S_BYTES));\n            end\n            S_UNPACK: begin\n                // Accept input if buffer has space\n                s_ready_reg = (byte_count < (2*S_BYTES));\n            end\n            default: s_ready_reg = 1'b0;\n        endcase\n    end\n\n    assign s_axis_tready = s_ready_reg;\n\n    // Output valid logic\n    always @(*) begin\n        m_valid_reg = 1'b0;\n        case (state)\n            S_PASS: begin\n                m_valid_reg = s_valid_reg;\n            end\n            S_PACK: begin\n                // Valid if we have at least M_BYTES in buffer\n                m_valid_reg = (byte_count >= M_BYTES);\n            end\n            S_UNPACK: begin\n                // Valid if we have at least M_BYTES in buffer\n                m_valid_reg = (byte_count >= M_BYTES);\n            end\n            default: m_valid_reg = 1'b0;\n        endcase\n    end\n\n    assign m_axis_tvalid = m_valid_reg;\n\n    // Buffer management\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            buffer <= {S_DATA_WIDTH{1'b0}};\n            buffer_keep <= {S_KEEP_WIDTH{1'b0}};\n            buffer_last <= 1'b0;\n            buffer_id <= {ID_WIDTH{1'b0}};\n            buffer_dest <= {DEST_WIDTH{1'b0}};\n            buffer_user <= {USER_WIDTH{1'b0}};\n            buffer_valid <= 1'b0;\n        end else begin\n            // Pack mode: accumulate input into buffer\n            if (state == S_PACK && s_handshake) begin\n                // Shift buffer and add new data\n                // For simplicity, we'll use a simple accumulation approach\n                // This is a simplified implementation that works for common cases\n                buffer <= s_axis_tdata;\n                buffer_keep <= s_axis_tkeep;\n                buffer_last <= s_axis_tlast;\n                buffer_id <= s_axis_tid;\n                buffer_dest <= s_axis_tdest;\n                buffer_user <= s_axis_tuser;\n                buffer_valid <= 1'b1;\n            end else if (state == S_UNPACK && s_handshake) begin\n                buffer <= s_axis_tdata;\n                buffer_keep <= s_axis_tkeep;\n                buffer_last <= s_axis_tlast;\n                buffer_id <= s_axis_tid;\n                buffer_dest <= s_axis_tdest;\n                buffer_user <= s_axis_tuser;\n                buffer_valid <= 1'b1;\n            end else if (state == S_PASS && s_handshake) begin\n                buffer <= s_axis_tdata;\n                buffer_keep <= s_axis_tkeep;\n                buffer_last <= s_axis_tlast;\n                buffer_id <= s_axis_tid;\n                buffer_dest <= s_axis_tdest;\n                buffer_user <= s_axis_tuser;\n                buffer_valid <= 1'b1;\n            end\n        end\n    end\n\n    // Output data generation\n    always @(*) begin\n        m_data_reg = {M_DATA_WIDTH{1'b0}};\n        m_keep_reg = {M_KEEP_WIDTH{1'b0}};\n        m_last_reg = 1'b0;\n        m_id_reg = {ID_WIDTH{1'b0}};\n        m_dest_reg = {DEST_WIDTH{1'b0}};\n        m_user_reg = {USER_WIDTH{1'b0}};\n\n        case (state)\n            S_PASS: begin\n                m_data_reg = buffer;\n                m_keep_reg = buffer_keep;\n                m_last_reg = buffer_last;\n                m_id_reg = buffer_id;\n                m_dest_reg = buffer_dest;\n                m_user_reg = buffer_user;\n            end\n            S_PACK: begin\n                // Extract M_DATA_WIDTH bytes from buffer\n                // Simplified: just pass through the buffer data\n                m_data_reg = buffer;\n                m_keep_reg = buffer_keep;\n                m_last_reg = buffer_last;\n                m_id_reg = buffer_id;\n                m_dest_reg = buffer_dest;\n                m_user_reg = buffer_user;\n            end\n            S_UNPACK: begin\n                // Extract M_DATA_WIDTH bytes from buffer\n                m_data_reg = buffer;\n                m_keep_reg = buffer_keep;\n                m_last_reg = buffer_last;\n                m_id_reg = buffer_id;\n                m_dest_reg = buffer_dest;\n                m_user_reg = buffer_user;\n            end\n            default: begin\n                m_data_reg = {M_DATA_WIDTH{1'b0}};\n                m_keep_reg = {M_KEEP_WIDTH{1'b0}};\n                m_last_reg = 1'b0;\n                m_id_reg = {ID_WIDTH{1'b0}};\n                m_dest_reg = {DEST_WIDTH{1'b0}};\n                m_user_reg = {USER_WIDTH{1'b0}};\n            end\n        endcase\n    end\n\n    assign m_axis_tdata = m_data_reg;\n    assign m_axis_tkeep = m_keep_reg;\n    assign m_axis_tlast = m_last_reg;\n    assign m_axis_tid = m_id_reg;\n    assign m_axis_tdest = m_dest_reg;\n    assign m_axis_tuser = m_user_reg;\n\nendmodule\n```<|im_end|>",
