{
  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state\n  reg src_valid_reg;\n  reg [WIDTH-1:0] src_data_reg;\n\n  // Destination domain state\n  reg dst_valid_reg;\n  reg [WIDTH-1:0] dst_data_reg;\n\n  // Synchronizers\n  reg [1:0] src_valid_sync;\n  reg [1:0] dst_valid_sync;\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_reg <= 1'b0;\n      src_data_reg  <= {WIDTH{1'b0}};\n    end else begin\n      if (src_valid_i && src_ready_o) begin\n        src_valid_reg <= 1'b1;\n        src_data_reg  <= src_data_i;\n      end else if (src_valid_reg && dst_valid_sync[1]) begin\n        src_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Source ready: can accept if no outstanding item\n  assign src_ready_o = ~src_valid_reg;\n\n  // Synchronize src_valid_reg to destination domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_valid_sync <= 2'b00;\n    end else begin\n      src_valid_sync <= {src_valid_sync[0], src_valid_reg};\n    end\n  end\n\n  // Synchronize dst_valid_reg to source domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_valid_sync <= 2'b00;\n    end else begin\n      dst_valid_sync <= {dst_valid_sync[0], dst_valid_reg};\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_data_reg  <= {WIDTH{1'b0}};\n    end else begin\n      if (!dst_valid_reg && src_valid_sync[1]) begin\n        dst_valid_reg <= 1'b1;\n        dst_data_reg  <= src_data_reg;\n      end else if (dst_valid_reg && dst_ready_i) begin\n        dst_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Destination outputs\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_data_o  = dst_data_reg;\n\nendmodule\n```<|im_end|>",
