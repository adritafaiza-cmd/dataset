{
  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain: capture data and generate request pulse\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_req;\n  wire            src_accept;\n\n  // Destination domain: track request and generate response pulse\n  reg             dst_req;\n  reg             dst_ack;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_valid_reg;\n\n  // Synchronizers for request (src -> dst)\n  reg [1:0] req_sync;\n  wire      req_synced = req_sync[1];\n\n  // Synchronizers for response (dst -> src)\n  reg [1:0] resp_sync;\n  wire      resp_synced = resp_sync[1];\n\n  // Source domain logic\n  assign src_accept = src_valid_i & src_ready_o;\n  assign src_ready_o = ~src_req | resp_synced;\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_req      <= 1'b0;\n      src_data_reg <= {WIDTH{1'b0}};\n    end else begin\n      if (src_accept) begin\n        src_req      <= 1'b1;\n        src_data_reg <= src_data_i;\n      end else if (resp_synced) begin\n        src_req <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize request to destination domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync <= 2'b00;\n    end else begin\n      req_sync <= {req_sync[0], src_req};\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_req       <= 1'b0;\n      dst_ack       <= 1'b0;\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_valid_reg <= 1'b0;\n    end else begin\n      // Detect rising edge of synchronized request\n      if (req_synced && !dst_req) begin\n        dst_req      <= 1'b1;\n        dst_data_reg <= src_data_reg;\n        dst_valid_reg <= 1'b1;\n      end\n\n      // When valid and ready, complete transfer and send ack\n      if (dst_valid_reg && dst_ready_i) begin\n        dst_valid_reg <= 1'b0;\n        dst_ack       <= 1'b1;\n      end else if (dst_ack) begin\n        dst_ack <= 1'b0;\n      end\n\n      // Clear request when ack is sent\n      if (dst_ack) begin\n        dst_req <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronize response (ack) to source domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      resp_sync <= 2'b00;\n    end else begin\n      resp_sync <= {resp_sync[0], dst_ack};\n    end\n  end\n\n  // Destination outputs\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
