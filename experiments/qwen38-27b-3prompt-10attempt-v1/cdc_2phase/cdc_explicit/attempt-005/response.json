  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain: handshake state\n  // We use a simple 2-phase handshake with a single outstanding item.\n  // The source holds the data and asserts a \"req\" signal that is synchronized\n  // to the destination domain. The destination acknowledges with \"ack\" which\n  // is synchronized back to the source domain.\n\n  // Source domain registers\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_req;       // Request to destination (source domain)\n  reg             src_ack_sync;  // Acknowledgment from destination (synchronized to source)\n  reg             src_ack_d1;    // First stage of ack synchronization\n  reg             src_ack_d2;    // Second stage of ack synchronization\n\n  // Destination domain registers\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_ack;       // Acknowledgment to source (destination domain)\n  reg             dst_req_sync;  // Request from source (synchronized to destination)\n  reg             dst_req_d1;    // First stage of req synchronization\n  reg             dst_req_d2;    // Second stage of req synchronization\n  reg             dst_valid;     // Valid in destination domain\n\n  // Synchronize src_ack to source domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ack_d1 <= 1'b0;\n      src_ack_d2 <= 1'b0;\n    end else begin\n      src_ack_d1 <= dst_ack;\n      src_ack_d2 <= src_ack_d1;\n    end\n  end\n  assign src_ack_sync = src_ack_d2;\n\n  // Synchronize src_req to destination domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_req_d1 <= 1'b0;\n      dst_req_d2 <= 1'b0;\n    end else begin\n      dst_req_d1 <= src_req;\n      dst_req_d2 <= dst_req_d1;\n    end\n  end\n  assign dst_req_sync = dst_req_d2;\n\n  // Source domain logic\n  // src_ready_o is high when we can accept a new item.\n  // We can accept a new item when:\n  //   - We are not currently holding an item (src_req is low), OR\n  //   - We have received an acknowledgment for the current item (src_ack_sync is high)\n  // Actually, let's think more carefully.\n  //\n  // State machine in source domain:\n  //   IDLE: src_req = 0, waiting for valid input\n  //   WAIT_ACK: src_req = 1, waiting for ack\n  //\n  // When in IDLE and src_valid_i is high, we capture data and set src_req = 1.\n  // When in WAIT_ACK and src_ack_sync becomes high, we go back to IDLE.\n  //\n  // src_ready_o should be high when we are in IDLE state (can accept new data).\n\n  reg src_state_idle;  // 1 when idle, 0 when waiting for ack\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg <= {WIDTH{1'b0}};\n      src_req      <= 1'b0;\n      src_state_idle <= 1'b1;\n    end else begin\n      if (src_state_idle) begin\n        if (src_valid_i) begin\n          src_data_reg   <= src_data_i;\n          src_req        <= 1'b1;\n          src_state_idle <= 1'b0;\n        end\n      end else begin\n        // Waiting for ack\n        if (src_ack_sync) begin\n          src_req        <= 1'b0;\n          src_state_idle <= 1'b1;\n        end\n      end\n    end\n  end\n\n  assign src_ready_o = src_state_idle;\n\n  // Destination domain logic\n  // When dst_req_sync transitions from 0 to 1, we capture the data and assert dst_valid.\n  // When dst_valid and dst_ready_i are both high, we deassert dst_valid and assert dst_ack.\n  // dst_ack is held until dst_req_sync goes back to 0 (which happens after source sees ack).\n\n  reg dst_ack_pending;  // Internal flag to track if we need to send ack\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg  <= {WIDTH{1'b0}};\n      dst_ack       <= 1'b0;\n      dst_valid     <= 1'b0;\n      dst_ack_pending <= 1'b0;\n    end else begin\n      if (!dst_valid) begin\n        // Not currently valid, check for new request\n        if (dst_req_sync) begin\n          dst_data_reg  <= src_data_reg;  // Capture data (safe because src_data_reg is stable while src_req is high)\n          dst_valid     <= 1'b1;\n          dst_ack       <= 1'b1;\n          dst_ack_pending <= 1'b1;\n        end\n      end else begin\n        // Currently valid\n        if (dst_ready_i) begin\n          dst_valid     <= 1'b0;\n          dst_ack       <= 1'b0;\n          dst_ack_pending <= 1'b0;\n        end\n      end\n    end\n  end\n\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid;\n\nendmodule\n```<|im_end|>",
