  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state\n  reg src_valid_reg;\n  reg [WIDTH-1:0] src_data_reg;\n\n  // Destination domain state\n  reg dst_valid_reg;\n  reg [WIDTH-1:0] dst_data_reg;\n\n  // Handshake signals crossing domains\n  // src_to_dst_valid: indicates source has data ready to send\n  // dst_to_src_ready: indicates destination is ready to accept new data\n\n  // We use a simple 2-phase handshake with data latched in source domain\n  // and synchronized to destination domain.\n\n  // Source domain:\n  // - When src_valid_i && src_ready_o, latch data and assert src_to_dst_valid\n  // - src_ready_o is high when we don't have outstanding data (src_valid_reg == 0)\n  //   OR when destination has acknowledged (dst_to_src_ready synchronized)\n\n  // Actually, let's use a simpler approach:\n  // Source latches data when valid && ready.\n  // src_ready_o = ~src_valid_reg (no outstanding item in source)\n  // When src_valid_reg is set, we need to wait for destination to consume it.\n  // Destination sees the data via synchronization.\n\n  // Let's use a standard async FIFO-like approach with single entry:\n  // Source domain:\n  //   - Latch data on valid && ready\n  //   - Assert a \"data available\" signal that crosses to destination\n  // Destination domain:\n  //   - Synchronize the \"data available\" signal\n  //   - When synchronized valid is high and dst_ready_i is high, complete transfer\n  //   - Deassert the \"data available\" signal (crosses back to source)\n  // Source domain:\n  //   - Synchronize the deassertion to clear src_valid_reg\n\n  // Signals crossing from source to destination:\n  //   src_data_cross: the data (multi-bit, needs to be stable)\n  //   src_valid_cross: valid indicator\n\n  // Signals crossing from destination to source:\n  //   dst_ack_cross: acknowledgment that destination consumed the data\n\n  // Source domain registers\n  reg src_valid_reg;\n  reg [WIDTH-1:0] src_data_reg;\n\n  // Destination domain registers\n  reg dst_valid_reg;\n  reg [WIDTH-1:0] dst_data_reg;\n\n  // Synchronization chains\n  // src_valid_cross: 2-flop sync in destination domain\n  reg [1:0] src_valid_sync;\n  // dst_ack_cross: 2-flop sync in source domain\n  reg [1:0] dst_ack_sync;\n\n  // Source domain logic\n  wire src_ready_o = ~src_valid_reg;\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_reg <= 1'b0;\n      src_data_reg  <= {WIDTH{1'b0}};\n    end else begin\n      if (src_valid_i && src_ready_o) begin\n        src_valid_reg <= 1'b1;\n        src_data_reg  <= src_data_i;\n      end else if (dst_ack_sync[1]) begin\n        src_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_data_reg  <= {WIDTH{1'b0}};\n    end else begin\n      if (src_valid_sync[1] && !dst_valid_reg) begin\n        dst_valid_reg <= 1'b1;\n        dst_data_reg  <= src_data_reg;\n      end else if (dst_valid_reg && dst_ready_i) begin\n        dst_valid_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Synchronization of src_valid to destination domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_valid_sync <= 2'b00;\n    end else begin\n      src_valid_sync <= {src_valid_sync[0], src_valid_reg};\n    end\n  end\n\n  // Synchronization of dst_ack to source domain\n  // dst_ack is asserted when destination has consumed the data\n  wire dst_ack = dst_valid_reg && dst_ready_i;\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_ack_sync <= 2'b00;\n    end else begin\n      dst_ack_sync <= {dst_ack_sync[0], dst_ack};\n    end\n  end\n\n  // Outputs\n  assign src_ready_o = ~src_valid_reg;\n  assign dst_data_o  = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>",
