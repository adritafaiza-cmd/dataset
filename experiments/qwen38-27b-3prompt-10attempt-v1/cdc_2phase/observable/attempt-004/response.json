{
  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side: capture data and generate request pulse\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_valid_reg;\n  reg             src_req;\n  wire            src_req_pulse;\n\n  // Destination side: acknowledge\n  reg             dst_ack;\n  wire            dst_ack_pulse;\n\n  // Synchronizers\n  reg [1:0] req_sync;\n  reg [1:0] ack_sync;\n\n  // Source clock domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg  <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n      src_req       <= 1'b0;\n    end else begin\n      if (src_valid_i && src_ready_o) begin\n        src_data_reg  <= src_data_i;\n        src_valid_reg <= 1'b1;\n        src_req       <= 1'b1;\n      end else if (src_valid_reg && src_req && ack_sync[1]) begin\n        src_valid_reg <= 1'b0;\n        src_req       <= 1'b0;\n      end\n    end\n  end\n\n  assign src_ready_o = !src_valid_reg;\n\n  // Synchronize request to destination clock\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync <= 2'b00;\n    end else begin\n      req_sync <= {req_sync[0], src_req};\n    end\n  end\n\n  // Destination clock domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_ack <= 1'b0;\n    end else begin\n      if (req_sync[1] && !dst_ack) begin\n        dst_ack <= 1'b1;\n      end else if (dst_ack && !req_sync[1]) begin\n        dst_ack <= 1'b0;\n      end\n    end\n  end\n\n  assign dst_valid_o = req_sync[1];\n  assign dst_data_o  = src_data_reg;\n\n  // Synchronize acknowledge to source clock\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync <= 2'b00;\n    end else begin\n      ack_sync <= {ack_sync[0], dst_ack};\n    end\n  end\n\nendmodule\n```<|im_end|>",
