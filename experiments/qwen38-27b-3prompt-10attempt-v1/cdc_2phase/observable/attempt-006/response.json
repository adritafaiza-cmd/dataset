  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side: capture data and generate request\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_req;\n  reg src_ack;\n\n  // Destination side: capture data and generate ack\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_ack;\n  reg dst_req;\n\n  // Synchronizers for request (src -> dst)\n  reg req_sync1;\n  reg req_sync2;\n\n  // Synchronizers for ack (dst -> src)\n  reg ack_sync1;\n  reg ack_sync2;\n\n  // Source clock domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg <= {WIDTH{1'b0}};\n      src_req      <= 1'b0;\n      src_ack      <= 1'b0;\n    end else begin\n      // If not currently holding a pending request, accept new data\n      if (!src_req) begin\n        if (src_valid_i) begin\n          src_data_reg <= src_data_i;\n          src_req      <= 1'b1;\n        end\n      end else begin\n        // Waiting for ack\n        if (src_ack) begin\n          src_req <= 1'b0;\n          src_ack <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // Source ready: ready when not holding a pending request\n  assign src_ready_o = ~src_req;\n\n  // Synchronize request to destination clock domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync1 <= 1'b0;\n      req_sync2 <= 1'b0;\n    end else begin\n      req_sync1 <= src_req;\n      req_sync2 <= req_sync1;\n    end\n  end\n\n  // Destination clock domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_ack      <= 1'b0;\n      dst_req      <= 1'b0;\n    end else begin\n      // If not currently holding a pending ack, accept new request\n      if (!dst_ack) begin\n        if (req_sync2) begin\n          dst_data_reg <= src_data_reg;\n          dst_ack      <= 1'b1;\n        end\n      end else begin\n        // Waiting for dst to consume the data\n        if (dst_valid_o && dst_ready_i) begin\n          dst_ack <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // Destination valid: valid when holding data and not yet consumed\n  assign dst_valid_o = dst_ack;\n  assign dst_data_o  = dst_data_reg;\n\n  // Synchronize ack to source clock domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync1 <= 1'b0;\n      ack_sync2 <= 1'b0;\n    end else begin\n      ack_sync1 <= dst_ack;\n      ack_sync2 <= ack_sync1;\n    end\n  end\n\n  // Update src_ack from synchronized ack\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_ack <= 1'b0;\n    end else begin\n      src_ack <= ack_sync2;\n    end\n  end\n\nendmodule\n```<|im_end|>",
