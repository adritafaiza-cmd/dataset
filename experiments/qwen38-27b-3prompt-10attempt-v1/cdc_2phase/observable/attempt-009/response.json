{
  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side: capture data and generate request pulse\n  reg [WIDTH-1:0] src_data_reg;\n  reg             src_req;\n  wire            src_ready;\n\n  // Destination side: receive request, generate response pulse\n  reg [WIDTH-1:0] dst_data_reg;\n  reg             dst_ack;\n  wire            dst_valid;\n\n  // Synchronizers for request (src -> dst)\n  reg [1:0] req_sync;\n  wire      req_synced = req_sync[1];\n\n  // Synchronizers for response (dst -> src)\n  reg [1:0] ack_sync;\n  wire      ack_synced = ack_sync[1];\n\n  // Source clock domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg <= {WIDTH{1'b0}};\n      src_req      <= 1'b0;\n    end else begin\n      if (src_valid_i && src_ready) begin\n        src_data_reg <= src_data_i;\n        src_req      <= 1'b1;\n      end else if (ack_synced) begin\n        src_req <= 1'b0;\n      end\n    end\n  end\n\n  assign src_ready = !src_req;\n\n  // Synchronize request from src to dst\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_sync <= 2'b00;\n    end else begin\n      req_sync <= {req_sync[0], src_req};\n    end\n  end\n\n  // Destination clock domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_ack      <= 1'b0;\n    end else begin\n      if (req_synced && !dst_ack) begin\n        dst_data_reg <= src_data_reg;\n        dst_ack      <= 1'b1;\n      end else if (dst_ack && dst_ready_i) begin\n        dst_ack <= 1'b0;\n      end\n    end\n  end\n\n  assign dst_valid = dst_ack;\n  assign dst_data_o = dst_data_reg;\n\n  // Synchronize response from dst to src\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_sync <= 2'b00;\n    end else begin\n      ack_sync <= {ack_sync[0], dst_ack};\n    end\n  end\n\nendmodule\n```<|im_end|>",
