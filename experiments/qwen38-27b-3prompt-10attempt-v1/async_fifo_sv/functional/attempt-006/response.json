  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n\n    // Write domain\n    reg [ADDR_WIDTH:0] wptr;\n    reg [ADDR_WIDTH:0] wptr_gray;\n    reg [ADDR_WIDTH:0] rptr_gray_w;\n    reg [ADDR_WIDTH:0] rptr_gray_w_sync [SYNC_STAGES-1:0];\n\n    // Read domain\n    reg [ADDR_WIDTH:0] rptr;\n    reg [ADDR_WIDTH:0] rptr_gray;\n    reg [ADDR_WIDTH:0] wptr_gray_r;\n    reg [ADDR_WIDTH:0] wptr_gray_r_sync [SYNC_STAGES-1:0];\n\n    // Memory\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Write enable\n    wire wenable = winc & ~wfull;\n\n    // Read enable\n    wire renable = rinc & ~rempty;\n\n    // Gray code conversion\n    function [ADDR_WIDTH:0] bin2gray;\n        input [ADDR_WIDTH:0] bin;\n        begin\n            bin2gray = bin ^ (bin >> 1);\n        end\n    endfunction\n\n    // Write domain logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= 0;\n            wptr_gray <= 0;\n        end else begin\n            if (wenable) begin\n                wptr <= wptr + 1;\n            end\n            wptr_gray <= bin2gray(wptr + (wenable ? 1 : 0));\n        end\n    end\n\n    // Synchronize read pointer gray to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_w_sync[0] <= 0;\n            rptr_gray_w_sync[1] <= 0;\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                    rptr_gray_w_sync[i] <= 0;\n            end\n        end else begin\n            rptr_gray_w_sync[0] <= rptr_gray;\n            rptr_gray_w_sync[1] <= rptr_gray_w_sync[0];\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                    rptr_gray_w_sync[i] <= rptr_gray_w_sync[i-1];\n            end\n        end\n    end\n\n    assign rptr_gray_w = rptr_gray_w_sync[SYNC_STAGES-1];\n\n    // Full condition: write pointer gray equals read pointer gray with MSB and MSB-1 inverted\n    assign wfull = (wptr_gray == {~rptr_gray_w[ADDR_WIDTH:ADDR_WIDTH-1], rptr_gray_w[ADDR_WIDTH-2:0]});\n\n    // Read domain logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= 0;\n            rptr_gray <= 0;\n        end else begin\n            if (renable) begin\n                rptr <= rptr + 1;\n            end\n            rptr_gray <= bin2gray(rptr + (renable ? 1 : 0));\n        end\n    end\n\n    // Synchronize write pointer gray to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_r_sync[0] <= 0;\n            wptr_gray_r_sync[1] <= 0;\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                    wptr_gray_r_sync[i] <= 0;\n            end\n        end else begin\n            wptr_gray_r_sync[0] <= wptr_gray;\n            wptr_gray_r_sync[1] <= wptr_gray_r_sync[0];\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                    wptr_gray_r_sync[i] <= wptr_gray_r_sync[i-1];\n            end\n        end\n    end\n\n    assign wptr_gray_r = wptr_gray_r_sync[SYNC_STAGES-1];\n\n    // Empty condition: write pointer gray equals read pointer gray\n    assign rempty = (wptr_gray_r == rptr_gray);\n\n    // Memory write\n    always @(posedge wclk) begin\n        if (wenable) begin\n            mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n        end\n    end\n\n    // Memory read\n    always @(posedge rclk) begin\n        if (renable) begin\n            rdata <= mem[rptr[ADDR_WIDTH-1:0]];\n        end\n    end\n\n    // Debug outputs\n    assign waddr = wptr;\n    assign raddr = rptr;\n\nendmodule\n```<|im_end|>",
