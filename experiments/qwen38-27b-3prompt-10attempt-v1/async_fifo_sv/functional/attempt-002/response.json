  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n\n    // Memory\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Write domain\n    reg [ADDR_WIDTH:0] wptr;\n    reg [ADDR_WIDTH:0] rptr_synced;\n    wire               wfull;\n\n    // Read domain\n    reg [ADDR_WIDTH:0] rptr;\n    reg [ADDR_WIDTH:0] wptr_synced;\n    wire               rempty;\n\n    // Gray code pointers\n    wire [ADDR_WIDTH:0] wptr_gray;\n    wire [ADDR_WIDTH:0] rptr_gray;\n\n    // Synchronizer for write pointer into read domain\n    reg [ADDR_WIDTH:0] wptr_gray_sync [0:SYNC_STAGES-1];\n\n    // Synchronizer for read pointer into write domain\n    reg [ADDR_WIDTH:0] rptr_gray_sync [0:SYNC_STAGES-1];\n\n    // Gray code conversion\n    assign wptr_gray = wptr ^ (wptr >> 1);\n    assign rptr_gray = rptr ^ (rptr >> 1);\n\n    // Write domain logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {(ADDR_WIDTH+1){1'b0}};\n        end else if (winc && !wfull) begin\n            wptr <= wptr + 1'b1;\n        end\n    end\n\n    // Write memory\n    always @(posedge wclk) begin\n        if (winc && !wfull) begin\n            mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n        end\n    end\n\n    // Full condition: write pointer gray code equals read pointer gray code with MSB different\n    assign wfull = (wptr_gray == rptr_synced) && (wptr[ADDR_WIDTH] != rptr_synced[ADDR_WIDTH]);\n\n    // Synchronize read pointer gray code into write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_sync[0] <= {(ADDR_WIDTH+1){1'b0}};\n            rptr_gray_sync[1] <= {(ADDR_WIDTH+1){1'b0}};\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i++) begin\n                    rptr_gray_sync[i] <= {(ADDR_WIDTH+1){1'b0}};\n                end\n            end\n        end else begin\n            rptr_gray_sync[0] <= rptr_gray;\n            rptr_gray_sync[1] <= rptr_gray_sync[0];\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i++) begin\n                    rptr_gray_sync[i] <= rptr_gray_sync[i-1];\n                end\n            end\n        end\n    end\n\n    assign rptr_synced = rptr_gray_sync[SYNC_STAGES-1];\n\n    // Read domain logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {(ADDR_WIDTH+1){1'b0}};\n        end else if (rinc && !rempty) begin\n            rptr <= rptr + 1'b1;\n        end\n    end\n\n    // Read data\n    assign rdata = mem[rptr[ADDR_WIDTH-1:0]];\n\n    // Empty condition: read pointer gray code equals write pointer gray code\n    assign rempty = (rptr_gray == wptr_synced);\n\n    // Synchronize write pointer gray code into read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_sync[0] <= {(ADDR_WIDTH+1){1'b0}};\n            wptr_gray_sync[1] <= {(ADDR_WIDTH+1){1'b0}};\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i++) begin\n                    wptr_gray_sync[i] <= {(ADDR_WIDTH+1){1'b0}};\n                end\n            end\n        end else begin\n            wptr_gray_sync[0] <= wptr_gray;\n            wptr_gray_sync[1] <= wptr_gray_sync[0];\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i++) begin\n                    wptr_gray_sync[i] <= wptr_gray_sync[i-1];\n                end\n            end\n        end\n    end\n\n    assign wptr_synced = wptr_gray_sync[SYNC_STAGES-1];\n\n    // Debug outputs\n    assign waddr = wptr;\n    assign raddr = rptr;\n\nendmodule\n```<|im_end|>",
