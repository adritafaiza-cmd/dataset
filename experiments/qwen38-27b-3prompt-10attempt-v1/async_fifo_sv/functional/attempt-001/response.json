{
  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n\n    // Memory\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Write domain\n    reg [ADDR_WIDTH:0] wptr;\n    reg [ADDR_WIDTH:0] wptr_sync; // not used for sync, just placeholder\n    reg [ADDR_WIDTH:0] rptr_w;    // read pointer synchronized to write domain\n\n    // Read domain\n    reg [ADDR_WIDTH:0] rptr;\n    reg [ADDR_WIDTH:0] wptr_r;    // write pointer synchronized to read domain\n\n    // Synchronization registers\n    reg [ADDR_WIDTH:0] wptr_sync_r [0:SYNC_STAGES-1];\n    reg [ADDR_WIDTH:0] rptr_sync_w [0:SYNC_STAGES-1];\n\n    // Full and empty flags\n    assign wfull  = (wptr == {~rptr_w[ADDR_WIDTH], rptr_w[ADDR_WIDTH-1:0]});\n    assign rempty = (rptr == wptr_r);\n\n    // Debug address outputs\n    assign waddr = wptr;\n    assign raddr = rptr;\n\n    // Write logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {1'b0, {ADDR_WIDTH{1'b0}}};\n        end else if (winc && !wfull) begin\n            mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n            wptr <= wptr + 1'b1;\n        end\n    end\n\n    // Read logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {1'b0, {ADDR_WIDTH{1'b0}}};\n        end else if (rinc && !rempty) begin\n            rptr <= rptr + 1'b1;\n        end\n    end\n\n    // Read data output\n    assign rdata = mem[rptr[ADDR_WIDTH-1:0]];\n\n    // Synchronize write pointer to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_sync_r[0] <= {1'b0, {ADDR_WIDTH{1'b0}}};\n            for (int i = 1; i < SYNC_STAGES; i++) begin\n                wptr_sync_r[i] <= {1'b0, {ADDR_WIDTH{1'b0}}};\n            end\n        end else begin\n            wptr_sync_r[0] <= wptr;\n            for (int i = 1; i < SYNC_STAGES; i++) begin\n                wptr_sync_r[i] <= wptr_sync_r[i-1];\n            end\n        end\n    end\n\n    assign wptr_r = wptr_sync_r[SYNC_STAGES-1];\n\n    // Synchronize read pointer to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_sync_w[0] <= {1'b0, {ADDR_WIDTH{1'b0}}};\n            for (int i = 1; i < SYNC_STAGES; i++) begin\n                rptr_sync_w[i] <= {1'b0, {ADDR_WIDTH{1'b0}}};\n            end\n        end else begin\n            rptr_sync_w[0] <= rptr;\n            for (int i = 1; i < SYNC_STAGES; i++) begin\n                rptr_sync_w[i] <= rptr_sync_w[i-1];\n            end\n        end\n    end\n\n    assign rptr_w = rptr_sync_w[SYNC_STAGES-1];\n\nendmodule\n```<|im_end|>",
