{
  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n\n    // Write domain\n    reg [PTR_WIDTH-1:0] wptr;\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    // Read domain\n    reg [PTR_WIDTH-1:0] rptr;\n    reg [DATA_WIDTH-1:0] rdata_reg;\n\n    // Synchronizers: write pointer to read domain\n    reg [PTR_WIDTH-1:0] wptr_sync [0:SYNC_STAGES-1];\n    // Synchronizers: read pointer to write domain\n    reg [PTR_WIDTH-1:0] rptr_sync [0:SYNC_STAGES-1];\n\n    // Synchronized pointers\n    wire [PTR_WIDTH-1:0] wptr_synced = wptr_sync[SYNC_STAGES-1];\n    wire [PTR_WIDTH-1:0] rptr_synced = rptr_sync[SYNC_STAGES-1];\n\n    // Write pointer increment\n    wire wptr_inc = winc && !wfull;\n\n    // Read pointer increment\n    wire rptr_inc = rinc && !rempty;\n\n    // Full condition: write pointer has lapped read pointer by DEPTH\n    // wfull when (wptr - rptr_synced) == DEPTH\n    // i.e., wptr[ADDR_WIDTH:1] == rptr_synced[ADDR_WIDTH:1] && wptr[0] != rptr_synced[0]\n    assign wfull = (wptr[ADDR_WIDTH:1] == rptr_synced[ADDR_WIDTH:1]) &&\n                   (wptr[0] != rptr_synced[0]);\n\n    // Empty condition: read pointer equals write pointer\n    assign rempty = (rptr == wptr_synced);\n\n    // Write address\n    assign waddr = wptr;\n\n    // Read address\n    assign raddr = rptr;\n\n    // Read data\n    assign rdata = rdata_reg;\n\n    // Write clock domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {PTR_WIDTH{1'b0}};\n        end else begin\n            if (wptr_inc) begin\n                mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n                wptr <= wptr + 1'b1;\n            end\n        end\n    end\n\n    // Synchronize write pointer to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_sync[0] <= {PTR_WIDTH{1'b0}};\n            wptr_sync[1] <= {PTR_WIDTH{1'b0}};\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                    wptr_sync[i] <= {PTR_WIDTH{1'b0}};\n            end\n        end else begin\n            wptr_sync[0] <= wptr;\n            wptr_sync[1] <= wptr_sync[0];\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                    wptr_sync[i] <= wptr_sync[i-1];\n            end\n        end\n    end\n\n    // Synchronize read pointer to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_sync[0] <= {PTR_WIDTH{1'b0}};\n            rptr_sync[1] <= {PTR_WIDTH{1'b0}};\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                    rptr_sync[i] <= {PTR_WIDTH{1'b0}};\n            end\n        end else begin\n            rptr_sync[0] <= rptr;\n            rptr_sync[1] <= rptr_sync[0];\n            if (SYNC_STAGES > 2) begin\n                for (int i = 2; i < SYNC_STAGES; i = i + 1)\n                    rptr_sync[i] <= rptr_sync[i-1];\n            end\n        end\n    end\n\n    // Read clock domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {PTR_WIDTH{1'b0}};\n            rdata_reg <= {DATA_WIDTH{1'b0}};\n        end else begin\n            if (rptr_inc) begin\n                rdata_reg <= mem[rptr[ADDR_WIDTH-1:0]];\n                rptr <= rptr + 1'b1;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
