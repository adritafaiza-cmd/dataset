  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n    localparam PTR_WIDTH = ADDR_WIDTH + 1;\n\n    // Write domain\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n    reg [PTR_WIDTH-1:0]  wptr;\n    reg [PTR_WIDTH-1:0]  rptr_wsync;\n\n    // Read domain\n    reg [PTR_WIDTH-1:0]  rptr;\n    reg [PTR_WIDTH-1:0]  wptr_rsync;\n\n    // Synchronizer for read pointer into write domain\n    reg [PTR_WIDTH-1:0] rptr_sync [0:SYNC_STAGES-1];\n\n    // Synchronizer for write pointer into read domain\n    reg [PTR_WIDTH-1:0] wptr_sync [0:SYNC_STAGES-1];\n\n    // Write clock domain logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {PTR_WIDTH{1'b0}};\n        end else if (winc && !wfull) begin\n            wptr <= wptr + 1'b1;\n        end\n    end\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_sync[0] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            rptr_sync[0] <= rptr;\n        end\n    end\n\n    genvar i;\n    generate\n        for (i = 1; i < SYNC_STAGES; i = i + 1) begin : rptr_sync_gen\n            always @(posedge wclk or negedge wrst_n) begin\n                if (!wrst_n) begin\n                    rptr_sync[i] <= {PTR_WIDTH{1'b0}};\n                end else begin\n                    rptr_sync[i] <= rptr_sync[i-1];\n                end\n            end\n        end\n    endgenerate\n\n    assign rptr_wsync = rptr_sync[SYNC_STAGES-1];\n\n    // Full condition: write pointer has lapped read pointer by DEPTH\n    // In binary, full when upper bits match and lower bits differ by 1\n    // Specifically: wptr[ADDR_WIDTH:1] == rptr_wsync[ADDR_WIDTH:1] && wptr[0] != rptr_wsync[0]\n    // But since we use PTR_WIDTH = ADDR_WIDTH+1, the MSB is the wrap bit.\n    // Full when wptr[ADDR_WIDTH:1] == rptr_wsync[ADDR_WIDTH:1] && wptr[0] != rptr_wsync[0]\n    // Actually, standard approach: full when (wptr - rptr_wsync) == DEPTH\n    // Which means wptr[ADDR_WIDTH:1] == rptr_wsync[ADDR_WIDTH:1] and wptr[0] != rptr_wsync[0]\n    // Let's use: wptr[ADDR_WIDTH:1] == rptr_wsync[ADDR_WIDTH:1] && wptr[0] != rptr_wsync[0]\n    // Wait, that's not quite right. Let me think again.\n    // wptr and rptr are PTR_WIDTH bits. DEPTH = 2^ADDR_WIDTH.\n    // Full when wptr - rptr_wsync == DEPTH (mod 2^PTR_WIDTH)\n    // This means the upper ADDR_WIDTH bits are equal and the LSB differs.\n    // Actually: wptr[ADDR_WIDTH:1] == rptr_wsync[ADDR_WIDTH:1] && wptr[0] != rptr_wsync[0]\n    // Hmm, let me verify: if wptr = 0b10000 and rptr = 0b00000, DEPTH=16, ADDR_WIDTH=4, PTR_WIDTH=5\n    // wptr[4:1] = 0b100, rptr[4:1] = 0b000. Not equal. So not full. But wptr - rptr = 16 = DEPTH. So it should be full.\n    // My condition is wrong. Let me reconsider.\n    // wptr - rptr = DEPTH means wptr = rptr + DEPTH (mod 2^PTR_WIDTH)\n    // Since DEPTH = 2^ADDR_WIDTH, adding DEPTH flips bit ADDR_WIDTH and leaves lower bits unchanged.\n    // So wptr[ADDR_WIDTH-1:0] == rptr[ADDR_WIDTH-1:0] and wptr[ADDR_WIDTH] != rptr[ADDR_WIDTH]\n    // That is: wptr[ADDR_WIDTH-1:0] == rptr_wsync[ADDR_WIDTH-1:0] && wptr[ADDR_WIDTH] != rptr_wsync[ADDR_WIDTH]\n    \n    assign wfull = (wptr[ADDR_WIDTH-1:0] == rptr_wsync[ADDR_WIDTH-1:0]) && \n                   (wptr[ADDR_WIDTH] != rptr_wsync[ADDR_WIDTH]);\n\n    // Write data to memory\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            // No action needed for memory\n        end else if (winc && !wfull) begin\n            mem[wptr[ADDR_WIDTH-1:0]] <= wdata;\n        end\n    end\n\n    assign waddr = wptr;\n\n    // Read clock domain logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {PTR_WIDTH{1'b0}};\n        end else if (rinc && !rempty) begin\n            rptr <= rptr + 1'b1;\n        end\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_sync[0] <= {PTR_WIDTH{1'b0}};\n        end else begin\n            wptr_sync[0] <= wptr;\n        end\n    end\n\n    generate\n        for (i = 1; i < SYNC_STAGES; i = i + 1) begin : wptr_sync_gen\n            always @(posedge rclk or negedge rrst_n) begin\n                if (!rrst_n) begin\n                    wptr_sync[i] <= {PTR_WIDTH{1'b0}};\n                end else begin\n                    wptr_sync[i] <= wptr_sync[i-1];\n                end\n            end\n        end\n    endgenerate\n\n    assign wptr_rsync = wptr_sync[SYNC_STAGES-1];\n\n    // Empty condition: wptr_rsync == rptr\n    assign rempty = (wptr_rsync == rptr);\n\n    // Read data from memory\n    assign rdata = mem[rptr[ADDR_WIDTH-1:0]];\n\n    assign raddr = rptr;\n\nendmodule\n```<|im_end|>",
