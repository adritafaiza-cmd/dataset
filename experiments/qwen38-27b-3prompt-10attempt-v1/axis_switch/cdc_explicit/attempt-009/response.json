  "text": "```verilog\nmodule axis_switch #\n(\n    parameter S_COUNT = 4,\n    parameter M_COUNT = 4,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter S_ID_WIDTH = 8,\n    parameter M_ID_WIDTH = S_ID_WIDTH+$clog2(S_COUNT),\n    parameter M_DEST_WIDTH = 1,\n    parameter S_DEST_WIDTH = M_DEST_WIDTH+$clog2(M_COUNT),\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter M_BASE = 0,\n    parameter M_TOP = 0,\n    parameter M_CONNECT = {M_COUNT{{S_COUNT{1'b1}}}},\n    parameter UPDATE_TID = 0,\n    parameter S_REG_TYPE = 0,\n    parameter M_REG_TYPE = 2,\n    parameter ARB_TYPE_ROUND_ROBIN = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 1\n)\n(\n    input  wire                             clk,\n    input  wire                             rst,\n    /*\n     * AXI Stream inputs\n     */\n    input  wire [S_COUNT*DATA_WIDTH-1:0]    s_axis_tdata,\n    input  wire [S_COUNT*KEEP_WIDTH-1:0]    s_axis_tkeep,\n    input  wire [S_COUNT-1:0]               s_axis_tvalid,\n    output wire [S_COUNT-1:0]               s_axis_tready,\n    input  wire [S_COUNT-1:0]               s_axis_tlast,\n    input  wire [S_COUNT*S_ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [S_COUNT*S_DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [S_COUNT*USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI Stream outputs\n     */\n    output wire [M_COUNT*DATA_WIDTH-1:0]    m_axis_tdata,\n    output wire [M_COUNT*KEEP_WIDTH-1:0]    m_axis_tkeep,\n    output wire [M_COUNT-1:0]               m_axis_tvalid,\n    input  wire [M_COUNT-1:0]               m_axis_tready,\n    output wire [M_COUNT-1:0]               m_axis_tlast,\n    output wire [M_COUNT*M_ID_WIDTH-1:0]    m_axis_tid,\n    output wire [M_COUNT*M_DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [M_COUNT*USER_WIDTH-1:0]    m_axis_tuser\n);\n\n    // Internal signals\n    wire [S_COUNT-1:0] s_tready_int;\n    wire [M_COUNT-1:0] m_tvalid_int;\n    wire [M_COUNT-1:0] m_tlast_int;\n    wire [M_COUNT*DATA_WIDTH-1:0] m_tdata_int;\n    wire [M_COUNT*KEEP_WIDTH-1:0] m_tkeep_int;\n    wire [M_COUNT*M_ID_WIDTH-1:0] m_tid_int;\n    wire [M_COUNT*M_DEST_WIDTH-1:0] m_tdest_int;\n    wire [M_COUNT*USER_WIDTH-1:0] m_tuser_int;\n\n    // Per-output arbitration and routing\n    genvar m;\n    genvar s;\n\n    // For each output port m, determine which input s is selected\n    // and whether the output is valid\n    wire [S_COUNT-1:0] m_req [0:M_COUNT-1];\n    wire [S_COUNT-1:0] m_grant [0:M_COUNT-1];\n    wire [M_COUNT-1:0] m_valid;\n\n    // Round-robin state per output\n    reg [S_COUNT-1:0] rr_state [0:M_COUNT-1];\n\n    // Generate per-output logic\n    generate\n        for (m = 0; m < M_COUNT; m = m + 1) begin : gen_out\n            // Request: input s wants to send to output m\n            // An input s requests output m if:\n            // 1. s_axis_tvalid[s] is high\n            // 2. The destination of input s matches output m (after base/top adjustment)\n            // 3. The connection is allowed by M_CONNECT\n\n            // Extract destination for input s\n            wire [S_DEST_WIDTH-1:0] s_dest = s_axis_tdest[s*S_DEST_WIDTH +: S_DEST_WIDTH];\n\n            // Determine if input s targets output m\n            // The actual output index is s_dest - M_BASE, but we need to check if it maps to m\n            // Simplified: assume s_dest directly encodes the output index, with M_BASE/M_TOP for range\n            // For now, use direct comparison: s_dest == (m + M_BASE)\n            // But we also need to respect M_CONNECT[m][s]\n\n            wire s_wants_m = s_axis_tvalid[s] && \n                             (s_dest == (m + M_BASE)) && \n                             M_CONNECT[m*S_COUNT + s];\n\n            // Build request vector for output m\n            assign m_req[m][s] = s_wants_m;\n\n            // Arbitration\n            // If ARB_TYPE_ROUND_ROBIN, use round-robin\n            // Else if ARB_LSB_HIGH_PRIORITY, lowest set bit wins\n            // Else, highest set bit wins (default)\n\n            wire [S_COUNT-1:0] req_vec = m_req[m];\n\n            // Round-robin arbitration\n            wire [S_COUNT-1:0] rr_grant;\n            wire [S_COUNT-1:0] fixed_grant;\n\n            if (ARB_TYPE_ROUND_ROBIN) begin : gen_rr\n                // Round-robin: rotate request by rr_state, find first set bit, rotate back\n                wire [S_COUNT-1:0] rotated_req;\n                wire [S_COUNT-1:0] rotated_grant;\n                wire [S_COUNT-1:0] grant_rotated;\n\n                // Rotate left by rr_state\n                assign rotated_req = (req_vec << rr_state) | (req_vec >> (S_COUNT - rr_state));\n                \n                // Find first set bit (LSB)\n                assign grant_rotated = rotated_req & (~rotated_req + 1'b1);\n                \n                // Rotate back\n                assign rotated_grant = (grant_rotated >> rr_state) | (grant_rotated << (S_COUNT - rr_state));\n                \n                assign rr_grant = rotated_grant;\n\n                // Update round-robin state on grant\n                always @(posedge clk or posedge rst) begin\n                    if (rst)\n                        rr_state[m] <= {S_COUNT{1'b0}};\n                    else if (m_tvalid[m] && m_axis_tready[m])\n                        rr_state[m] <= (rr_state[m] + 1'b1) % S_COUNT;\n                end\n            end else begin : gen_fixed\n                if (ARB_LSB_HIGH_PRIORITY) begin : gen_lsb\n                    // Lowest set bit\n                    assign fixed_grant = req_vec & (~req_vec + 1'b1);\n                end else begin : gen_msb\n                    // Highest set bit\n                    wire [S_COUNT-1:0] inv_req = ~req_vec;\n                    wire [S_COUNT-1:0] inv_plus1 = inv_req + 1'b1;\n                    wire [S_COUNT-1:0] msb_mask = inv_plus1 & ~inv_req;\n                    assign fixed_grant = msb_mask;\n                end\n                assign rr_grant = fixed_grant;\n            end\n\n            assign m_grant[m] = rr_grant;\n            assign m_tvalid[m] = |rr_grant;\n        end\n    endgenerate\n\n    // Output data routing\n    // For each output m, select the data from the granted input s\n    generate\n        for (m = 0; m < M_COUNT; m = m + 1) begin : gen_out_data\n            // Data\n            wire [DATA_WIDTH-1:0] out_data;\n            wire [KEEP_WIDTH-1:0] out_keep;\n            wire out_last;\n            wire [S_ID_WIDTH-1:0] out_sid;\n            wire [M_ID_WIDTH-1:0] out_tid;\n            wire [M_DEST_WIDTH-1:0] out_tdest;\n            wire [USER_WIDTH-1:0] out_user;\n\n            // Select from granted input\n            for (s = 0; s < S_COUNT; s = s + 1) begin : gen_sel\n                wire sel = m_grant[m][s];\n                assign out_data = sel ? s_axis_tdata[s*DATA_WIDTH +: DATA_WIDTH] : out_data;\n                assign out_keep = sel ? s_axis_tkeep[s*KEEP_WIDTH +: KEEP_WIDTH] : out_keep;\n                assign out_last = sel ? s_axis_tlast[s] : out_last;\n                assign out_sid = sel ? s_axis_tid[s*S_ID_WIDTH +: S_ID_WIDTH] : out_sid;\n                assign out_tdest = sel ? s_axis_tdest[s*S_DEST_WIDTH +: S_DEST_WIDTH] : out_tdest;\n                assign out_user = sel ? s_axis_tuser[s*USER_WIDTH +: USER_WIDTH] : out_user;\n            end\n\n            // Update TID if enabled\n            if (UPDATE_TID) begin : gen_update_tid\n                // New TID = original TID + input index (or some transformation)\n                // For simplicity, append input index to original ID\n                wire [M_ID_WIDTH-1:1] tid_high = out_sid;\n                wire [S_COUNT-1:0] s_idx;\n                // Find which s was granted\n                for (s = 0; s < S_COUNT; s = s + 1) begin : gen_sidx\n                    assign s_idx[s] = m_grant[m][s];\n                end\n                assign out_tid = {tid_high, s_idx};\n            end else begin : gen_no_update_tid\n                assign out_tid = out_sid;\n            end\n\n            // Drive outputs\n            assign m_tdata_int[m*DATA_WIDTH +: DATA_WIDTH] = out_data;\n            assign m_tkeep_int[m*KEEP_WIDTH +: KEEP_WIDTH] = out_keep;\n            assign m_tlast_int[m] = out_last;\n            assign m_tid_int[m*M_ID_WIDTH +: M_ID_WIDTH] = out_tid;\n            assign m_tdest_int[m*M_DEST_WIDTH +: M_DEST_WIDTH] = out_tdest;\n            assign m_tuser_int[m*USER_WIDTH +: USER_WIDTH] = out_user;\n        end\n    endgenerate\n\n    // Input ready logic\n    // Input s is ready if:\n    // 1. The output it targets is ready (m_axis_tready[m])\n    // 2. Input s is granted for that output\n    generate\n        for (s = 0; s < S_COUNT; s = s + 1) begin : gen_in_ready\n            wire [S_DEST_WIDTH-1:0] s_dest = s_axis_tdest[s*S_DEST_WIDTH +: S_DEST_WIDTH];\n            wire [M_COUNT-1:0] target_mask;\n            \n            // Determine which outputs this input could target\n            for (m = 0; m < M_COUNT; m = m + 1) begin : gen_target\n                assign target_mask[m] = (s_dest == (m + M_BASE)) && M_CONNECT[m*S_COUNT + s];\n            end\n\n            // Input is ready if any target output is ready AND input is granted\n            wire [M_COUNT-1:0] ready_targets;\n            for (m = 0; m < M_COUNT; m = m + 1) begin : gen_ready\n                assign ready_targets[m] = target_mask[m] && m_axis_tready[m] && m_grant[m][s];\n            end\n\n            assign s_tready_int[s] = |ready_targets;\n        end\n    endgenerate\n\n    // Final output assignments\n    assign s_axis_tready = s_tready_int;\n    assign m_axis_tvalid = m_tvalid_int;\n    assign m_axis_tlast = m_tlast_int;\n    assign m_axis_tdata = m_tdata_int;\n    assign m_axis_tkeep = m_tkeep_int;\n    assign m_axis_tid = m_tid_int;\n    assign m_axis_tdest = m_tdest_int;\n    assign m_axis_tuser = m_tuser_int;\n\nendmodule\n