  "text": "```verilog\nmodule axis_register #\n(\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter REG_TYPE = 2\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI Stream input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI Stream output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser\n);\n\n    // Internal signals\n    wire [DATA_WIDTH-1:0]  reg_tdata;\n    wire [KEEP_WIDTH-1:0]  reg_tkeep;\n    wire                   reg_tvalid;\n    wire                   reg_tlast;\n    wire [ID_WIDTH-1:0]    reg_tid;\n    wire [DEST_WIDTH-1:0]  reg_tdest;\n    wire [USER_WIDTH-1:0]  reg_tuser;\n\n    // Wire mode (REG_TYPE = 0)\n    wire wire_mode = (REG_TYPE == 0);\n    // Simple buffer mode (REG_TYPE = 1)\n    wire simple_mode = (REG_TYPE == 1);\n    // Skid buffer mode (REG_TYPE = 2)\n    wire skid_mode = (REG_TYPE == 2);\n\n    // For wire mode, pass through directly\n    wire [DATA_WIDTH-1:0]  out_tdata;\n    wire [KEEP_WIDTH-1:0]  out_tkeep;\n    wire                   out_tvalid;\n    wire                   out_tlast;\n    wire [ID_WIDTH-1:0]    out_tid;\n    wire [DEST_WIDTH-1:0]  out_tdest;\n    wire [USER_WIDTH-1:0]  out_tuser;\n    wire                   out_tready;\n\n    // Wire mode outputs\n    assign out_tdata  = wire_mode ? s_axis_tdata  : reg_tdata;\n    assign out_tkeep  = wire_mode ? s_axis_tkeep  : reg_tkeep;\n    assign out_tvalid = wire_mode ? s_axis_tvalid : reg_tvalid;\n    assign out_tlast  = wire_mode ? s_axis_tlast  : reg_tlast;\n    assign out_tid    = wire_mode ? s_axis_tid    : reg_tid;\n    assign out_tdest  = wire_mode ? s_axis_tdest  : reg_tdest;\n    assign out_tuser  = wire_mode ? s_axis_tuser  : reg_tuser;\n    assign out_tready = wire_mode ? m_axis_tready : 1'b1;\n\n    // Output assignments\n    assign m_axis_tdata  = out_tdata;\n    assign m_axis_tkeep  = out_tkeep;\n    assign m_axis_tvalid = out_tvalid;\n    assign m_axis_tlast  = out_tlast;\n    assign m_axis_tid    = out_tid;\n    assign m_axis_tdest  = out_tdest;\n    assign m_axis_tuser  = out_tuser;\n    assign s_axis_tready = out_tready;\n\n    // Simple buffer (REG_TYPE = 1)\n    // Single register stage\n    reg [DATA_WIDTH-1:0]  buf_tdata;\n    reg [KEEP_WIDTH-1:0]  buf_tkeep;\n    reg                   buf_tvalid;\n    reg                   buf_tlast;\n    reg [ID_WIDTH-1:0]    buf_tid;\n    reg [DEST_WIDTH-1:0]  buf_tdest;\n    reg [USER_WIDTH-1:0]  buf_tuser;\n\n    wire simple_tready = simple_mode ? (m_axis_tready || !buf_tvalid) : 1'b0;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            buf_tdata  <= {DATA_WIDTH{1'b0}};\n            buf_tkeep  <= {KEEP_WIDTH{1'b0}};\n            buf_tvalid <= 1'b0;\n            buf_tlast  <= 1'b0;\n            buf_tid    <= {ID_WIDTH{1'b0}};\n            buf_tdest  <= {DEST_WIDTH{1'b0}};\n            buf_tuser  <= {USER_WIDTH{1'b0}};\n        end else if (simple_mode) begin\n            if (s_axis_tvalid && simple_tready) begin\n                buf_tdata  <= s_axis_tdata;\n                buf_tkeep  <= s_axis_tkeep;\n                buf_tvalid <= 1'b1;\n                buf_tlast  <= s_axis_tlast;\n                buf_tid    <= s_axis_tid;\n                buf_tdest  <= s_axis_tdest;\n                buf_tuser  <= s_axis_tuser;\n            end else if (buf_tvalid && m_axis_tready) begin\n                buf_tvalid <= 1'b0;\n            end\n        end\n    end\n\n    assign reg_tdata  = buf_tdata;\n    assign reg_tkeep  = buf_tkeep;\n    assign reg_tvalid = buf_tvalid;\n    assign reg_tlast  = buf_tlast;\n    assign reg_tid    = buf_tid;\n    assign reg_tdest  = buf_tdest;\n    assign reg_tuser  = buf_tuser;\n\n    // Skid buffer (REG_TYPE = 2)\n    // Two-stage buffer: main register and skid register\n    reg [DATA_WIDTH-1:0]  skid_main_tdata;\n    reg [KEEP_WIDTH-1:0]  skid_main_tkeep;\n    reg                   skid_main_tvalid;\n    reg                   skid_main_tlast;\n    reg [ID_WIDTH-1:0]    skid_main_tid;\n    reg [DEST_WIDTH-1:0]  skid_main_tdest;\n    reg [USER_WIDTH-1:0]  skid_main_tuser;\n\n    reg [DATA_WIDTH-1:0]  skid_skid_tdata;\n    reg [KEEP_WIDTH-1:0]  skid_skid_tkeep;\n    reg                   skid_skid_tvalid;\n    reg                   skid_skid_tlast;\n    reg [ID_WIDTH-1:0]    skid_skid_tid;\n    reg [DEST_WIDTH-1:0]  skid_skid_tdest;\n    reg [USER_WIDTH-1:0]  skid_skid_tuser;\n\n    wire skid_main_ready = skid_mode ? (m_axis_tready || !skid_main_tvalid) : 1'b0;\n    wire skid_input_ready = skid_mode ? (skid_main_ready || !skid_skid_tvalid) : 1'b0;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            skid_main_tdata  <= {DATA_WIDTH{1'b0}};\n            skid_main_tkeep  <= {KEEP_WIDTH{1'b0}};\n            skid_main_tvalid <= 1'b0;\n            skid_main_tlast  <= 1'b0;\n            skid_main_tid    <= {ID_WIDTH{1'b0}};\n            skid_main_tdest  <= {DEST_WIDTH{1'b0}};\n            skid_main_tuser  <= {USER_WIDTH{1'b0}};\n\n            skid_skid_tdata  <= {DATA_WIDTH{1'b0}};\n            skid_skid_tkeep  <= {KEEP_WIDTH{1'b0}};\n            skid_skid_tvalid <= 1'b0;\n            skid_skid_tlast  <= 1'b0;\n            skid_skid_tid    <= {ID_WIDTH{1'b0}};\n            skid_skid_tdest  <= {DEST_WIDTH{1'b0}};\n            skid_skid_tuser  <= {USER_WIDTH{1'b0}};\n        end else if (skid_mode) begin\n            // Main register logic\n            if (s_axis_tvalid && skid_input_ready) begin\n                if (skid_main_tvalid && m_axis_tready) begin\n                    // Main is being drained, accept new data into main\n                    skid_main_tdata  <= s_axis_tdata;\n                    skid_main_tkeep  <= s_axis_tkeep;\n                    skid_main_tvalid <= 1'b1;\n                    skid_main_tlast  <= s_axis_tlast;\n                    skid_main_tid    <= s_axis_tid;\n                    skid_main_tdest  <= s_axis_tdest;\n                    skid_main_tuser  <= s_axis_tuser;\n                end else if (!skid_main_tvalid) begin\n                    // Main is empty, accept new data into main\n                    skid_main_tdata  <= s_axis_tdata;\n                    skid_main_tkeep  <= s_axis_tkeep;\n                    skid_main_tvalid <= 1'b1;\n                    skid_main_tlast  <= s_axis_tlast;\n                    skid_main_tid    <= s_axis_tid;\n                    skid_main_tdest  <= s_axis_tdest;\n                    skid_main_tuser  <= s_axis_tuser;\n                end else begin\n                    // Main is full and not draining, accept into skid\n                    skid_skid_tdata  <= s_axis_tdata;\n                    skid_skid_tkeep  <= s_axis_tkeep;\n                    skid_skid_tvalid <= 1'b1;\n                    skid_skid_tlast  <= s_axis_tlast;\n                    skid_skid_tid    <= s_axis_tid;\n                    skid_skid_tdest  <= s_axis_tdest;\n                    skid_skid_tuser  <= s_axis_tuser;\n                end\n            end else if (skid_main_tvalid && m_axis_tready) begin\n                // Main is draining\n                if (skid_skid_tvalid) begin\n                    // Move skid data to main\n                    skid_main_tdata  <= skid_skid_tdata;\n                    skid_main_tkeep  <= skid_skid_tkeep;\n                    skid_main_tvalid <= 1'b1;\n                    skid_main_tlast  <= skid_skid_tlast;\n                    skid_main_tid    <= skid_skid_tid;\n                    skid_main_tdest  <= skid_skid_tdest;\n                    skid_main_tuser  <= skid_skid_tuser;\n                    skid_skid_tvalid <= 1'b0;\n                end else begin\n                    skid_main_tvalid <= 1'b0;\n                end\n            end\n        end\n    end\n\n    assign reg_tdata  = skid_main_tdata;\n    assign reg_tkeep  = skid_main_tkeep;\n    assign reg_tvalid = skid_main_tvalid;\n    assign reg_tlast  = skid_main_tlast;\n    assign reg_tid    = skid_main_tid;\n    assign reg_tdest  = skid_main_tdest;\n    assign reg_tuser  = skid_main_tuser;\n\nendmodule\n```<|im_end|>",
