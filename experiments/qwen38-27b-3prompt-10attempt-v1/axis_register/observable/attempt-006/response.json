  "text": "```verilog\nmodule axis_register #\n(\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter REG_TYPE = 2\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI Stream input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI Stream output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser\n);\n\n    // REG_TYPE: 0 = wire, 1 = buffer, 2 = skid buffer\n\n    // Wire mode: direct passthrough\n    wire wire_mode = (REG_TYPE == 0);\n    // Buffer mode: single register\n    wire buffer_mode = (REG_TYPE == 1);\n    // Skid buffer mode: two registers\n    wire skid_mode = (REG_TYPE == 2);\n\n    // Internal signals for buffer/skid modes\n    reg [DATA_WIDTH-1:0]  reg_data;\n    reg [KEEP_WIDTH-1:0]  reg_keep;\n    reg                   reg_last;\n    reg [ID_WIDTH-1:0]    reg_tid;\n    reg [DEST_WIDTH-1:0]  reg_tdest;\n    reg [USER_WIDTH-1:0]  reg_tuser;\n    reg                   reg_valid;\n\n    // Skid buffer second stage\n    reg [DATA_WIDTH-1:0]  skid_data;\n    reg [KEEP_WIDTH-1:0]  skid_keep;\n    reg                   skid_last;\n    reg [ID_WIDTH-1:0]    skid_tid;\n    reg [DEST_WIDTH-1:0]  skid_tdest;\n    reg [USER_WIDTH-1:0]  skid_tuser;\n    reg                   skid_valid;\n\n    // Control signals\n    wire s_axis_tready_wire;\n    wire s_axis_tready_buffer;\n    wire s_axis_tready_skid;\n\n    wire m_axis_tvalid_wire;\n    wire m_axis_tvalid_buffer;\n    wire m_axis_tvalid_skid;\n\n    // Wire mode\n    assign s_axis_tready_wire = 1'b1;\n    assign m_axis_tvalid_wire = s_axis_tvalid;\n\n    // Buffer mode\n    // s_axis_tready is high when the register is empty or when the downstream is ready to accept\n    assign s_axis_tready_buffer = !reg_valid || m_axis_tready;\n    assign m_axis_tvalid_buffer = reg_valid;\n\n    // Skid buffer mode\n    // s_axis_tready is high when the main register is empty, or when the main register is full but the skid is empty and downstream is ready\n    // More precisely: s_axis_tready = !reg_valid || (!skid_valid && m_axis_tready)\n    assign s_axis_tready_skid = !reg_valid || (!skid_valid && m_axis_tready);\n    assign m_axis_tvalid_skid = reg_valid || skid_valid;\n\n    // Select tready\n    assign s_axis_tready = wire_mode ? s_axis_tready_wire :\n                           buffer_mode ? s_axis_tready_buffer :\n                           s_axis_tready_skid;\n\n    // Select tvalid\n    assign m_axis_tvalid = wire_mode ? m_axis_tvalid_wire :\n                           buffer_mode ? m_axis_tvalid_buffer :\n                           m_axis_tvalid_skid;\n\n    // Data path selection\n    wire [DATA_WIDTH-1:0]  m_axis_tdata_sel;\n    wire [KEEP_WIDTH-1:0]  m_axis_tkeep_sel;\n    wire                   m_axis_tlast_sel;\n    wire [ID_WIDTH-1:0]    m_axis_tid_sel;\n    wire [DEST_WIDTH-1:0]  m_axis_tdest_sel;\n    wire [USER_WIDTH-1:0]  m_axis_tuser_sel;\n\n    assign m_axis_tdata_sel = wire_mode ? s_axis_tdata :\n                              buffer_mode ? reg_data :\n                              (reg_valid ? reg_data : skid_data);\n\n    assign m_axis_tkeep_sel = wire_mode ? s_axis_tkeep :\n                              buffer_mode ? reg_keep :\n                              (reg_valid ? reg_keep : skid_keep);\n\n    assign m_axis_tlast_sel = wire_mode ? s_axis_tlast :\n                              buffer_mode ? reg_last :\n                              (reg_valid ? reg_last : skid_last);\n\n    assign m_axis_tid_sel = wire_mode ? s_axis_tid :\n                            buffer_mode ? reg_tid :\n                            (reg_valid ? reg_tid : skid_tid);\n\n    assign m_axis_tdest_sel = wire_mode ? s_axis_tdest :\n                              buffer_mode ? reg_tdest :\n                              (reg_valid ? reg_tdest : skid_tdest);\n\n    assign m_axis_tuser_sel = wire_mode ? s_axis_tuser :\n                              buffer_mode ? reg_tuser :\n                              (reg_valid ? reg_tuser : skid_tuser);\n\n    assign m_axis_tdata = m_axis_tdata_sel;\n    assign m_axis_tkeep = m_axis_tkeep_sel;\n    assign m_axis_tlast = m_axis_tlast_sel;\n    assign m_axis_tid   = m_axis_tid_sel;\n    assign m_axis_tdest = m_axis_tdest_sel;\n    assign m_axis_tuser = m_axis_tuser_sel;\n\n    // Buffer mode logic\n    wire buffer_load = buffer_mode && s_axis_tvalid && s_axis_tready_buffer;\n    wire buffer_pop  = buffer_mode && reg_valid && m_axis_tready;\n\n    // Skid buffer logic\n    wire skid_load_main = skid_mode && s_axis_tvalid && s_axis_tready_skid && !reg_valid;\n    wire skid_load_skid = skid_mode && s_axis_tvalid && s_axis_tready_skid && reg_valid;\n    wire skid_pop_main  = skid_mode && reg_valid && m_axis_tready;\n    wire skid_pop_skid  = skid_mode && skid_valid && m_axis_tready && !reg_valid;\n\n    // Main register logic (shared between buffer and skid modes)\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            reg_valid <= 1'b0;\n            reg_data  <= {DATA_WIDTH{1'b0}};\n            reg_keep  <= {KEEP_WIDTH{1'b0}};\n            reg_last  <= 1'b0;\n            reg_tid   <= {ID_WIDTH{1'b0}};\n            reg_tdest <= {DEST_WIDTH{1'b0}};\n            reg_tuser <= {USER_WIDTH{1'b0}};\n        end else begin\n            if (buffer_mode) begin\n                if (buffer_load) begin\n                    reg_valid <= 1'b1;\n                    reg_data  <= s_axis_tdata;\n                    reg_keep  <= s_axis_tkeep;\n                    reg_last  <= s_axis_tlast;\n                    reg_tid   <= s_axis_tid;\n                    reg_tdest <= s_axis_tdest;\n                    reg_tuser <= s_axis_tuser;\n                end else if (buffer_pop) begin\n                    reg_valid <= 1'b0;\n                end\n            end else if (skid_mode) begin\n                if (skid_load_main) begin\n                    reg_valid <= 1'b1;\n                    reg_data  <= s_axis_tdata;\n                    reg_keep  <= s_axis_tkeep;\n                    reg_last  <= s_axis_tlast;\n                    reg_tid   <= s_axis_tid;\n                    reg_tdest <= s_axis_tdest;\n                    reg_tuser <= s_axis_tuser;\n                end else if (skid_pop_main) begin\n                    if (skid_valid) begin\n                        // Move skid to main\n                        reg_valid <= 1'b1;\n                        reg_data  <= skid_data;\n                        reg_keep  <= skid_keep;\n                        reg_last  <= skid_last;\n                        reg_tid   <= skid_tid;\n                        reg_tdest <= skid_tdest;\n                        reg_tuser <= skid_tuser;\n                    end else begin\n                        reg_valid <= 1'b0;\n                    end\n                end\n            end\n        end\n    end\n\n    // Skid register logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            skid_valid <= 1'b0;\n            skid_data  <= {DATA_WIDTH{1'b0}};\n            skid_keep  <= {KEEP_WIDTH{1'b0}};\n            skid_last  <= 1'b0;\n            skid_tid   <= {ID_WIDTH{1'b0}};\n            skid_tdest <= {DEST_WIDTH{1'b0}};\n            skid_tuser <= {USER_WIDTH{1'b0}};\n        end else if (skid_mode) begin\n            if (skid_load_skid) begin\n                skid_valid <= 1'b1;\n                skid_data  <= s_axis_tdata;\n                skid_keep  <= s_axis_tkeep;\n                skid_last  <= s_axis_tlast;\n                skid_tid   <= s_axis_tid;\n                skid_tdest <= s_axis_tdest;\n                skid_tuser <= s_axis_tuser;\n            end else if (skid_pop_skid) begin\n                skid_valid <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
