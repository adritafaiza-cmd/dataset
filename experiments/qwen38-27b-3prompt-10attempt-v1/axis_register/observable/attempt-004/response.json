  "text": "```verilog\nmodule axis_register #\n(\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter REG_TYPE = 2\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI Stream input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI Stream output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser\n);\n\n    // REG_TYPE: 0 = wire (no register), 1 = buffer (single register), 2 = skid buffer\n\n    // Internal signals\n    wire [DATA_WIDTH-1:0]  reg_tdata;\n    wire [KEEP_WIDTH-1:0]  reg_tkeep;\n    wire                   reg_tvalid;\n    wire                   reg_tready;\n    wire                   reg_tlast;\n    wire [ID_WIDTH-1:0]    reg_tid;\n    wire [DEST_WIDTH-1:0]  reg_tdest;\n    wire [USER_WIDTH-1:0]  reg_tuser;\n\n    // Skid buffer internal signals\n    wire [DATA_WIDTH-1:0]  skid_tdata;\n    wire [KEEP_WIDTH-1:0]  skid_tkeep;\n    wire                   skid_tvalid;\n    wire                   skid_tready;\n    wire                   skid_tlast;\n    wire [ID_WIDTH-1:0]    skid_tid;\n    wire [DEST_WIDTH-1:0]  skid_tdest;\n    wire [USER_WIDTH-1:0]  skid_tuser;\n\n    // Wire mode: direct connection\n    generate\n        if (REG_TYPE == 0) begin : gen_wire\n            assign s_axis_tready = m_axis_tready;\n            assign m_axis_tdata  = s_axis_tdata;\n            assign m_axis_tkeep  = s_axis_tkeep;\n            assign m_axis_tvalid = s_axis_tvalid;\n            assign m_axis_tlast  = s_axis_tlast;\n            assign m_axis_tid    = s_axis_tid;\n            assign m_axis_tdest  = s_axis_tdest;\n            assign m_axis_tuser  = s_axis_tuser;\n        end\n        else if (REG_TYPE == 1) begin : gen_buffer\n            // Single register buffer\n            reg_buffer #(\n                .DATA_WIDTH(DATA_WIDTH),\n                .KEEP_ENABLE(KEEP_ENABLE),\n                .KEEP_WIDTH(KEEP_WIDTH),\n                .LAST_ENABLE(LAST_ENABLE),\n                .ID_ENABLE(ID_ENABLE),\n                .ID_WIDTH(ID_WIDTH),\n                .DEST_ENABLE(DEST_ENABLE),\n                .DEST_WIDTH(DEST_WIDTH),\n                .USER_ENABLE(USER_ENABLE),\n                .USER_WIDTH(USER_WIDTH)\n            ) u_reg_buffer (\n                .clk(clk),\n                .rst(rst),\n                .s_axis_tdata(s_axis_tdata),\n                .s_axis_tkeep(s_axis_tkeep),\n                .s_axis_tvalid(s_axis_tvalid),\n                .s_axis_tready(s_axis_tready),\n                .s_axis_tlast(s_axis_tlast),\n                .s_axis_tid(s_axis_tid),\n                .s_axis_tdest(s_axis_tdest),\n                .s_axis_tuser(s_axis_tuser),\n                .m_axis_tdata(m_axis_tdata),\n                .m_axis_tkeep(m_axis_tkeep),\n                .m_axis_tvalid(m_axis_tvalid),\n                .m_axis_tready(m_axis_tready),\n                .m_axis_tlast(m_axis_tlast),\n                .m_axis_tid(m_axis_tid),\n                .m_axis_tdest(m_axis_tdest),\n                .m_axis_tuser(m_axis_tuser)\n            );\n        end\n        else begin : gen_skid\n            // Skid buffer\n            skid_buffer #(\n                .DATA_WIDTH(DATA_WIDTH),\n                .KEEP_ENABLE(KEEP_ENABLE),\n                .KEEP_WIDTH(KEEP_WIDTH),\n                .LAST_ENABLE(LAST_ENABLE),\n                .ID_ENABLE(ID_ENABLE),\n                .ID_WIDTH(ID_WIDTH),\n                .DEST_ENABLE(DEST_ENABLE),\n                .DEST_WIDTH(DEST_WIDTH),\n                .USER_ENABLE(USER_ENABLE),\n                .USER_WIDTH(USER_WIDTH)\n            ) u_skid_buffer (\n                .clk(clk),\n                .rst(rst),\n                .s_axis_tdata(s_axis_tdata),\n                .s_axis_tkeep(s_axis_tkeep),\n                .s_axis_tvalid(s_axis_tvalid),\n                .s_axis_tready(s_axis_tready),\n                .s_axis_tlast(s_axis_tlast),\n                .s_axis_tid(s_axis_tid),\n                .s_axis_tdest(s_axis_tdest),\n                .s_axis_tuser(s_axis_tuser),\n                .m_axis_tdata(m_axis_tdata),\n                .m_axis_tkeep(m_axis_tkeep),\n                .m_axis_tvalid(m_axis_tvalid),\n                .m_axis_tready(m_axis_tready),\n                .m_axis_tlast(m_axis_tlast),\n                .m_axis_tid(m_axis_tid),\n                .m_axis_tdest(m_axis_tdest),\n                .m_axis_tuser(m_axis_tuser)\n            );\n        end\n    endgenerate\n\nendmodule\n\nmodule reg_buffer #\n(\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser\n);\n\n    reg [DATA_WIDTH-1:0]  tdata_reg;\n    reg [KEEP_WIDTH-1:0]  tkeep_reg;\n    reg                   tvalid_reg;\n    reg                   tlast_reg;\n    reg [ID_WIDTH-1:0]    tid_reg;\n    reg [DEST_WIDTH-1:0]  tdest_reg;\n    reg [USER_WIDTH-1:0]  tuser_reg;\n\n    wire s_axis_tready = !tvalid_reg || m_axis_tready;\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            tdata_reg  <= {DATA_WIDTH{1'b0}};\n            tkeep_reg  <= {KEEP_WIDTH{1'b0}};\n            tvalid_reg <= 1'b0;\n            tlast_reg  <= 1'b0;\n            tid_reg    <= {ID_WIDTH{1'b0}};\n            tdest_reg  <= {DEST_WIDTH{1'b0}};\n            tuser_reg  <= {USER_WIDTH{1'b0}};\n        end else begin\n            if (s_axis_tvalid && s_axis_tready) begin\n                tdata_reg  <= s_axis_tdata;\n                tkeep_reg  <= s_axis_tkeep;\n                tvalid_reg <= 1'b1;\n                tlast_reg  <= s_axis_tlast;\n                tid_reg    <= s_axis_tid;\n                tdest_reg  <= s_axis_tdest;\n                tuser_reg  <= s_axis_tuser;\n            end else if (m_axis_tready && tvalid_reg) begin\n                tvalid_reg <= 1'b0;\n            end\n        end\n    end\n\n    assign m_axis_tdata  = tdata_reg;\n    assign m_axis_tkeep  = tkeep_reg;\n    assign m_axis_tvalid = tvalid_reg;\n    assign m_axis_tlast  = tlast_reg;\n    assign m_axis_tid    = tid_reg;\n    assign m_axis_tdest  = tdest_reg;\n    assign m_axis_tuser  = tuser_reg;\n\nendmodule\n\nmodule skid_buffer #\n(\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser\n);\n\n    // Main register\n    reg [DATA_WIDTH-1:0]  main_tdata;\n    reg [KEEP_WIDTH-1:0]  main_tkeep;\n    reg                   main_tvalid;\n    reg                   main_tlast;\n    reg [ID_WIDTH-1:0]    main_tid;\n    reg [DEST_WIDTH-1:0]  main_tdest;\n    reg [USER_WIDTH-1:0]  main_tuser;\n\n    // Skid register\n    reg [DATA_WIDTH-1:0]  skid_tdata;\n    reg [KEEP_WIDTH-1:0]  skid_tkeep;\n    reg                   skid_tvalid;\n    reg                   skid_tlast;\n    reg [ID_WIDTH-1:0]    skid_tid;\n    reg [DEST_WIDTH-1:0]  skid_tdest;\n    reg [USER_WIDTH-1:0]  skid_tuser;\n\n    wire main_tready = m_axis_tready;\n    wire s_axis_tready = !main_tvalid || (main_tready && !skid_tvalid);\n\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            main_tdata  <= {DATA_WIDTH{1'b0}};\n            main_tkeep  <= {KEEP_WIDTH{1'b0}};\n            main_tvalid <= 1'b0;\n            main_tlast  <= 1'b0;\n            main_tid    <= {ID_WIDTH{1'b0}};\n            main_tdest  <= {DEST_WIDTH{1'b0}};\n            main_tuser  <= {USER_WIDTH{1'b0}};\n\n            skid_tdata  <= {DATA_WIDTH{1'b0}};\n            skid_tkeep  <= {KEEP_WIDTH{1'b0}};\n            skid_tvalid <= 1'b0;\n            skid_tlast  <= 1'b0;\n            skid_tid    <= {ID_WIDTH{1'b0}};\n            skid_tdest  <= {DEST_WIDTH{1'b0}};\n            skid_tuser  <= {USER_WIDTH{1'b0}};\n        end else begin\n            // Handle main register\n            if (main_tvalid && main_tready) begin\n                // Main is being consumed\n                if (skid_tvalid) begin\n                    // Move skid to main\n                    main_tdata  <= skid_tdata;\n                    main_tkeep  <= skid_tkeep;\n                    main_tvalid <= 1'b1;\n                    main_tlast  <= skid_tlast;\n                    main_tid    <= skid_tid;\n                    main_tdest  <= skid_tdest;\n                    main_tuser  <= skid_tuser;\n                    skid_tvalid <= 1'b0;\n                end else if (s_axis_tvalid && s_axis_tready) begin\n                    // Load new data into main\n                    main_tdata  <= s_axis_tdata;\n                    main_tkeep  <= s_axis_tkeep;\n                    main_tvalid <= 1'b1;\n                    main_tlast  <= s_axis_tlast;\n                    main_tid    <= s_axis_tid;\n                    main_tdest  <= s_axis_tdest;\n                    main_tuser  <= s_axis_tuser;\n                end else begin\n                    main_tvalid <= 1'b0;\n                end\n            end else if (main_tvalid && !main_tready) begin\n                // Main is stalled\n                if (s_axis_tvalid && s_axis_tready) begin\n                    // Load new data into skid\n                    skid_tdata  <= s_axis_tdata;\n                    skid_tkeep  <= s_axis_tkeep;\n                    skid_tvalid <= 1'b1;\n                    skid_tlast  <= s_axis_tlast;\n                    skid_tid    <= s_axis_tid;\n                    skid_tdest  <= s_axis_tdest;\n                    skid_tuser  <= s_axis_tuser;\n                end\n            end else if (!main_tvalid) begin\n                // Main is empty\n                if (s_axis_tvalid && s_axis_tready) begin\n                    main_tdata  <= s_axis_tdata;\n                    main_tkeep  <= s_axis_tkeep;\n                    main_tvalid <= 1'b1;\n                    main_tlast  <= s_axis_tlast;\n                    main_tid    <= s_axis_tid;\n                    main_tdest  <= s_axis_tdest;\n                    main_tuser  <= s_axis_tuser;\n                end\n            end\n        end\n    end\n\n    assign m_axis_tdata  = main_tdata;\n    assign m_axis_tkeep  = main_tkeep;\n    assign m_axis_tvalid = main_tvalid;\n    assign m_axis_tlast  = main_tlast;\n    assign m_axis_tid    = main_tid;\n    assign m_axis_tdest  = main_tdest;\n    assign m_axis_tuser  = main_tuser;\n\nendmodule\n```<|im_end|>",
