  "text": "```verilog\nmodule axis_register #\n(\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter REG_TYPE = 2\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI Stream input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI Stream output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser\n);\n\n    // Internal signals\n    wire [DATA_WIDTH-1:0]  reg_tdata;\n    wire [KEEP_WIDTH-1:0]  reg_tkeep;\n    wire                   reg_tvalid;\n    wire                   reg_tready;\n    wire                   reg_tlast;\n    wire [ID_WIDTH-1:0]    reg_tid;\n    wire [DEST_WIDTH-1:0]  reg_tdest;\n    wire [USER_WIDTH-1:0]  reg_tuser;\n\n    // Skid buffer signals\n    wire [DATA_WIDTH-1:0]  skid_tdata;\n    wire [KEEP_WIDTH-1:0]  skid_tkeep;\n    wire                   skid_tvalid;\n    wire                   skid_tready;\n    wire                   skid_tlast;\n    wire [ID_WIDTH-1:0]    skid_tid;\n    wire [DEST_WIDTH-1:0]  skid_tdest;\n    wire [USER_WIDTH-1:0]  skid_tuser;\n\n    // Control signals\n    wire                   accept;\n    wire                   forward;\n    wire                   skid_accept;\n    wire                   skid_forward;\n\n    // For REG_TYPE 0: wire (no register)\n    // For REG_TYPE 1: buffer (single register)\n    // For REG_TYPE 2: skid buffer (two registers)\n\n    // Wire mode: direct connection\n    // Buffer mode: single register\n    // Skid buffer mode: two registers with skid logic\n\n    // Determine if we can accept new data\n    // For wire: always ready\n    // For buffer: ready if not valid or downstream ready\n    // For skid: ready if main not valid or (main valid and skid not valid)\n\n    // Main register\n    reg_tdata  <= 0;\n    reg_tkeep  <= 0;\n    reg_tvalid <= 0;\n    reg_tlast  <= 0;\n    reg_tid    <= 0;\n    reg_tdest  <= 0;\n    reg_tuser  <= 0;\n\n    // Skid register\n    skid_tdata  <= 0;\n    skid_tkeep  <= 0;\n    skid_tvalid <= 0;\n    skid_tlast  <= 0;\n    skid_tid    <= 0;\n    skid_tdest  <= 0;\n    skid_tuser  <= 0;\n\n    // Control logic\n    // accept: can we accept new data from source?\n    // forward: can we forward data to destination?\n\n    // For wire (REG_TYPE=0):\n    //   s_axis_tready = m_axis_tready\n    //   m_axis_tdata = s_axis_tdata\n    //   etc.\n\n    // For buffer (REG_TYPE=1):\n    //   Single register. s_axis_tready = !reg_tvalid || m_axis_tready\n    //   m_axis_tvalid = reg_tvalid\n    //   m_axis_tdata = reg_tdata\n    //   etc.\n\n    // For skid buffer (REG_TYPE=2):\n    //   Two registers. Main and skid.\n    //   s_axis_tready = !reg_tvalid || (!skid_tvalid && m_axis_tready)\n    //   m_axis_tvalid = reg_tvalid || skid_tvalid\n    //   m_axis_tdata = reg_tvalid ? reg_tdata : skid_tdata\n    //   etc.\n\n    // Let's implement all three modes using conditional logic\n\n    // Wire mode\n    wire wire_s_axis_tready;\n    wire wire_m_axis_tdata;\n    wire wire_m_axis_tkeep;\n    wire wire_m_axis_tvalid;\n    wire wire_m_axis_tlast;\n    wire wire_m_axis_tid;\n    wire wire_m_axis_tdest;\n    wire wire_m_axis_tuser;\n\n    assign wire_s_axis_tready = m_axis_tready;\n    assign wire_m_axis_tdata  = s_axis_tdata;\n    assign wire_m_axis_tkeep  = s_axis_tkeep;\n    assign wire_m_axis_tvalid = s_axis_tvalid;\n    assign wire_m_axis_tlast  = s_axis_tlast;\n    assign wire_m_axis_tid    = s_axis_tid;\n    assign wire_m_axis_tdest  = s_axis_tdest;\n    assign wire_m_axis_tuser  = s_axis_tuser;\n\n    // Buffer mode\n    wire buf_s_axis_tready;\n    wire buf_m_axis_tdata;\n    wire buf_m_axis_tkeep;\n    wire buf_m_axis_tvalid;\n    wire buf_m_axis_tlast;\n    wire buf_m_axis_tid;\n    wire buf_m_axis_tdest;\n    wire buf_m_axis_tuser;\n\n    assign buf_s_axis_tready = !reg_tvalid || m_axis_tready;\n    assign buf_m_axis_tdata  = reg_tdata;\n    assign buf_m_axis_tkeep  = reg_tkeep;\n    assign buf_m_axis_tvalid = reg_tvalid;\n    assign buf_m_axis_tlast  = reg_tlast;\n    assign buf_m_axis_tid    = reg_tid;\n    assign buf_m_axis_tdest  = reg_tdest;\n    assign buf_m_axis_tuser  = reg_tuser;\n\n    // Skid buffer mode\n    wire skid_s_axis_tready;\n    wire skid_m_axis_tdata;\n    wire skid_m_axis_tkeep;\n    wire skid_m_axis_tvalid;\n    wire skid_m_axis_tlast;\n    wire skid_m_axis_tid;\n    wire skid_m_axis_tdest;\n    wire skid_m_axis_tuser;\n\n    assign skid_s_axis_tready = !reg_tvalid || (!skid_tvalid && m_axis_tready);\n    assign skid_m_axis_tvalid = reg_tvalid || skid_tvalid;\n    assign skid_m_axis_tdata  = reg_tvalid ? reg_tdata : skid_tdata;\n    assign skid_m_axis_tkeep  = reg_tvalid ? reg_tkeep : skid_tkeep;\n    assign skid_m_axis_tlast  = reg_tvalid ? reg_tlast : skid_tlast;\n    assign skid_m_axis_tid    = reg_tvalid ? reg_tid : skid_tid;\n    assign skid_m_axis_tdest  = reg_tvalid ? reg_tdest : skid_tdest;\n    assign skid_m_axis_tuser  = reg_tvalid ? reg_tuser : skid_tuser;\n\n    // Output selection\n    assign s_axis_tready = (REG_TYPE == 0) ? wire_s_axis_tready :\n                           (REG_TYPE == 1) ? buf_s_axis_tready :\n                                             skid_s_axis_tready;\n\n    assign m_axis_tdata  = (REG_TYPE == 0) ? wire_m_axis_tdata :\n                           (REG_TYPE == 1) ? buf_m_axis_tdata :\n                                             skid_m_axis_tdata;\n    assign m_axis_tkeep  = (REG_TYPE == 0) ? wire_m_axis_tkeep :\n                           (REG_TYPE == 1) ? buf_m_axis_tkeep :\n                                             skid_m_axis_tkeep;\n    assign m_axis_tvalid = (REG_TYPE == 0) ? wire_m_axis_tvalid :\n                           (REG_TYPE == 1) ? buf_m_axis_tvalid :\n                                             skid_m_axis_tvalid;\n    assign m_axis_tlast  = (REG_TYPE == 0) ? wire_m_axis_tlast :\n                           (REG_TYPE == 1) ? buf_m_axis_tlast :\n                                             skid_m_axis_tlast;\n    assign m_axis_tid    = (REG_TYPE == 0) ? wire_m_axis_tid :\n                           (REG_TYPE == 1) ? buf_m_axis_tid :\n                                             skid_m_axis_tid;\n    assign m_axis_tdest  = (REG_TYPE == 0) ? wire_m_axis_tdest :\n                           (REG_TYPE == 1) ? buf_m_axis_tdest :\n                                             skid_m_axis_tdest;\n    assign m_axis_tuser  = (REG_TYPE == 0) ? wire_m_axis_tuser :\n                           (REG_TYPE == 1) ? buf_m_axis_tuser :\n                                             skid_m_axis_tuser;\n\n    // Register logic for buffer and skid buffer\n    // For buffer: accept when s_axis_tvalid && buf_s_axis_tready\n    // For skid: accept when s_axis_tvalid && skid_s_axis_tready\n\n    // Buffer register\n    wire buf_accept = s_axis_tvalid && buf_s_axis_tready;\n    wire buf_forward = reg_tvalid && m_axis_tready;\n\n    // Skid buffer registers\n    wire skid_accept = s_axis_tvalid && skid_s_axis_tready;\n    wire skid_forward = reg_tvalid && m_axis_tready;\n    wire skid_skid_forward = skid_tvalid && m_axis_tready;\n\n    // Main register update logic\n    // For buffer:\n    //   If accept and not forward: load main\n    //   If forward and not accept: clear main\n    //   If accept and forward: load main with new data\n    //   If not accept and not forward: hold\n\n    // For skid:\n    //   Main register:\n    //     If skid_forward and not skid_accept: clear main (skid moves to main)\n    //     If skid_accept and not skid_forward: load main with new data\n    //     If skid_accept and skid_forward: load main with new data\n    //     If not skid_accept and not skid_forward: hold\n    //   Skid register:\n    //     If skid_accept and skid_forward: load skid with new data\n    //     If not skid_accept and not skid_forward: hold\n    //     If skid_forward and not skid_accept: clear skid\n    //     If skid_accept and not skid_forward: hold (skid stays, main gets new)\n\n    // Let's simplify:\n    // For buffer:\n    //   reg_tvalid <= buf_accept ? 1'b1 : (buf_forward ? 1'b0 : reg_tvalid);\n    //   reg_tdata  <= buf_accept ? s_axis_tdata : reg_tdata;\n    //   etc.\n\n    // For skid:\n    //   Main register:\n    //     If skid_forward:\n    //       If skid_accept: main gets new data\n    //       Else: main gets skid data\n    //     Else:\n    //       If skid_accept: main gets new data\n    //       Else: hold\n    //   Skid register:\n    //     If skid_accept and skid_forward: skid gets new data\n    //     Else: hold or clear\n\n    // Let's implement this properly\n\n    // Buffer mode register\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            reg_tvalid <= 1'b0;\n            reg_tdata  <= {DATA_WIDTH{1'b0}};\n            reg_tkeep  <= {KEEP_WIDTH{1'b0}};\n            reg_tlast  <= 1'b0;\n            reg_tid    <= {ID_WIDTH{1'b0}};\n            reg_tdest  <= {DEST_WIDTH{1'b0}};\n            reg_tuser  <= {USER_WIDTH{1'b0}};\n        end else if (REG_TYPE == 1) begin\n            if (buf_accept) begin\n                reg_tvalid <= 1'b1;\n                reg_tdata  <= s_axis_tdata;\n                reg_tkeep  <= s_axis_tkeep;\n                reg_tlast  <= s_axis_tlast;\n                reg_tid    <= s_axis_tid;\n                reg_tdest  <= s_axis_tdest;\n                reg_tuser  <= s_axis_tuser;\n            end else if (buf_forward) begin\n                reg_tvalid <= 1'b0;\n            end\n        end else if (REG_TYPE == 2) begin\n            // Skid buffer main register\n            if (skid_forward) begin\n                if (skid_accept) begin\n                    reg_tvalid <= 1'b1;\n                    reg_tdata  <= s_axis_tdata;\n                    reg_tkeep  <= s_axis_tkeep;\n                    reg_tlast  <= s_axis_tlast;\n                    reg_tid    <= s_axis_tid;\n                    reg_tdest  <= s_axis_tdest;\n                    reg_tuser  <= s_axis_tuser;\n                end else begin\n                    reg_tvalid <= skid_tvalid;\n                    reg_tdata  <= skid_tdata;\n                    reg_tkeep  <= skid_tkeep;\n                    reg_tlast  <= skid_tlast;\n                    reg_tid    <= skid_tid;\n                    reg_tdest  <= skid_tdest;\n                    reg_tuser  <= skid_tuser;\n                end\n            end else if (skid_accept) begin\n                reg_tvalid <= 1'b1;\n                reg_tdata  <= s_axis_tdata;\n                reg_tkeep  <= s_axis_tkeep;\n                reg_tlast  <= s_axis_tlast;\n                reg_tid    <= s_axis_tid;\n                reg_tdest  <= s_axis_tdest;\n                reg_tuser  <= s_axis_tuser;\n            end\n        end\n    end\n\n    // Skid register\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            skid_tvalid <= 1'b0;\n            skid_tdata  <= {DATA_WIDTH{1'b0}};\n            skid_tkeep  <= {KEEP_WIDTH{1'b0}};\n            skid_tlast  <= 1'b0;\n            skid_tid    <= {ID_WIDTH{1'b0}};\n            skid_tdest  <= {DEST_WIDTH{1'b0}};\n            skid_tuser  <= {USER_WIDTH{1'b0}};\n        end else if (REG_TYPE == 2) begin\n            if (skid_accept && skid_forward) begin\n                skid_tvalid <= 1'b1;\n                skid_tdata  <= s_axis_tdata;\n                skid_tkeep  <= s_axis_tkeep;\n                skid_tlast  <= s_axis_tlast;\n                skid_tid    <= s_axis_tid;\n                skid_tdest  <= s_axis_tdest;\n                skid_tuser  <= s_axis_tuser;\n            end else if (skid_forward) begin\n                skid_tvalid <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
