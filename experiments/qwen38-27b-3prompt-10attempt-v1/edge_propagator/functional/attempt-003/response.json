{
  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // TX domain: detect edge on edge_i and generate a toggle\n  logic edge_i_d;\n  logic tx_toggle;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      edge_i_d    <= 1'b0;\n      tx_toggle   <= 1'b0;\n    end else begin\n      edge_i_d    <= edge_i;\n      if (edge_i ^ edge_i_d)\n        tx_toggle <= ~tx_toggle;\n    end\n  end\n\n  // Synchronize tx_toggle into RX domain\n  logic rx_sync0, rx_sync1, rx_sync2;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      rx_sync0 <= 1'b0;\n      rx_sync1 <= 1'b0;\n      rx_sync2 <= 1'b0;\n    end else begin\n      rx_sync0 <= tx_toggle;\n      rx_sync1 <= rx_sync0;\n      rx_sync2 <= rx_sync1;\n    end\n  end\n\n  // RX domain: detect edge on synchronized signal and generate pulse\n  logic rx_toggle_d;\n  logic edge_o_int;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      rx_toggle_d <= 1'b0;\n      edge_o_int  <= 1'b0;\n    end else begin\n      rx_toggle_d <= rx_sync1;\n      edge_o_int  <= (rx_sync1 ^ rx_toggle_d);\n    end\n  end\n\n  assign edge_o = edge_o_int;\n\nendmodule\n```<|im_end|>",
