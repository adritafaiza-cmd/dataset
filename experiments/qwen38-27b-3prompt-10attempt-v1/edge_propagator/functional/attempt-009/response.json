  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // TX domain: detect rising edge of edge_i and generate a toggle\n  logic edge_i_d;\n  logic edge_detected_tx;\n  logic toggle_tx;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      edge_i_d <= 1'b0;\n      toggle_tx <= 1'b0;\n    end else begin\n      edge_i_d <= edge_i;\n      if (edge_i && !edge_i_d) begin\n        toggle_tx <= ~toggle_tx;\n      end\n    end\n  end\n\n  // Synchronize toggle_tx to RX domain\n  logic toggle_rx_1;\n  logic toggle_rx_2;\n  logic toggle_rx_3;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      toggle_rx_1 <= 1'b0;\n      toggle_rx_2 <= 1'b0;\n      toggle_rx_3 <= 1'b0;\n    end else begin\n      toggle_rx_1 <= toggle_tx;\n      toggle_rx_2 <= toggle_rx_1;\n      toggle_rx_3 <= toggle_rx_2;\n    end\n  end\n\n  // Detect rising edge of synchronized toggle in RX domain\n  logic edge_o;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      edge_o <= 1'b0;\n    end else begin\n      edge_o <= toggle_rx_2 ^ toggle_rx_3;\n    end\n  end\n\nendmodule\n```<|im_end|>",
