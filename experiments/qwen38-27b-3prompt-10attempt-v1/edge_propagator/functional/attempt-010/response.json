  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // TX domain: detect edge and generate a toggle\n  logic tx_edge_detected;\n  logic tx_toggle;\n  logic tx_toggle_reg;\n\n  // Detect rising edge of edge_i in TX domain\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      tx_toggle_reg <= 1'b0;\n    end else if (edge_i) begin\n      tx_toggle_reg <= ~tx_toggle_reg;\n    end\n  end\n\n  // Synchronize tx_toggle_reg to RX domain\n  logic rx_sync1;\n  logic rx_sync2;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      rx_sync1 <= 1'b0;\n      rx_sync2 <= 1'b0;\n    end else begin\n      rx_sync1 <= tx_toggle_reg;\n      rx_sync2 <= rx_sync1;\n    end\n  end\n\n  // Detect edge on synchronized signal in RX domain\n  logic rx_edge;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      edge_o <= 1'b0;\n    end else begin\n      edge_o <= (rx_sync2 != rx_sync1);\n    end\n  end\n\nendmodule\n```<|im_end|>",
