  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // TX domain: detect edge and generate a toggle\n  logic edge_d1_tx;\n  logic edge_d2_tx;\n  logic toggle_tx;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      edge_d1_tx <= 1'b0;\n      edge_d2_tx <= 1'b0;\n      toggle_tx  <= 1'b0;\n    end else begin\n      edge_d1_tx <= edge_i;\n      edge_d2_tx <= edge_d1_tx;\n      if (edge_d1_tx && !edge_d2_tx)\n        toggle_tx <= ~toggle_tx;\n    end\n  end\n\n  // Synchronize toggle_tx into RX domain\n  logic toggle_rx1;\n  logic toggle_rx2;\n  logic toggle_rx3;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      toggle_rx1 <= 1'b0;\n      toggle_rx2 <= 1'b0;\n      toggle_rx3 <= 1'b0;\n    end else begin\n      toggle_rx1 <= toggle_tx;\n      toggle_rx2 <= toggle_rx1;\n      toggle_rx3 <= toggle_rx2;\n    end\n  end\n\n  // Detect edge on synchronized toggle in RX domain\n  logic toggle_rx3_d1;\n  logic toggle_rx3_d2;\n  logic edge_o_int;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      toggle_rx3_d1 <= 1'b0;\n      toggle_rx3_d2 <= 1'b0;\n      edge_o        <= 1'b0;\n    end else begin\n      toggle_rx3_d1 <= toggle_rx3;\n      toggle_rx3_d2 <= toggle_rx3_d1;\n      edge_o        <= (toggle_rx3 != toggle_rx3_d1);\n    end\n  end\n\nendmodule\n```<|im_end|>",
