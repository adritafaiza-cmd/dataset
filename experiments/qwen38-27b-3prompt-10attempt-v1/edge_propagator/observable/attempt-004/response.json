{
  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // TX domain: detect rising edge of edge_i and generate a pulse\n  logic edge_i_d1, edge_i_d2;\n  logic tx_pulse;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      edge_i_d1 <= 1'b0;\n      edge_i_d2 <= 1'b0;\n    end else begin\n      edge_i_d1 <= edge_i;\n      edge_i_d2 <= edge_i_d1;\n    end\n  end\n\n  assign tx_pulse = edge_i_d1 & ~edge_i_d2;\n\n  // TX domain: pulse to level converter\n  logic tx_level;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i)\n      tx_level <= 1'b0;\n    else if (tx_pulse)\n      tx_level <= 1'b1;\n  end\n\n  // Synchronize tx_level into RX domain\n  logic sync_d1, sync_d2, sync_d3;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      sync_d1 <= 1'b0;\n      sync_d2 <= 1'b0;\n      sync_d3 <= 1'b0;\n    end else begin\n      sync_d1 <= tx_level;\n      sync_d2 <= sync_d1;\n      sync_d3 <= sync_d2;\n    end\n  end\n\n  // RX domain: detect rising edge of synchronized level and generate output pulse\n  logic rx_level_d1;\n  logic rx_pulse;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i)\n      rx_level_d1 <= 1'b0;\n    else\n      rx_level_d1 <= sync_d3;\n  end\n\n  assign rx_pulse = sync_d3 & ~rx_level_d1;\n\n  // RX domain: clear tx_level by sending a clear pulse back to TX domain\n  // Use a handshake: when rx_pulse occurs, assert rx_clear which is synchronized back to TX\n  logic rx_clear;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i)\n      rx_clear <= 1'b0;\n    else if (rx_pulse)\n      rx_clear <= 1'b1;\n  end\n\n  // Synchronize rx_clear into TX domain\n  logic clear_sync_d1, clear_sync_d2;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      clear_sync_d1 <= 1'b0;\n      clear_sync_d2 <= 1'b0;\n    end else begin\n      clear_sync_d1 <= rx_clear;\n      clear_sync_d2 <= clear_sync_d1;\n    end\n  end\n\n  // TX domain: clear tx_level when clear signal arrives\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i)\n      tx_level <= 1'b0;\n    else if (clear_sync_d2)\n      tx_level <= 1'b0;\n    else if (tx_pulse)\n      tx_level <= 1'b1;\n  end\n\n  // RX domain: deassert rx_clear after it has been acknowledged (simplified: deassert after one cycle)\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i)\n      rx_clear <= 1'b0;\n    else if (rx_pulse)\n      rx_clear <= 1'b1;\n    else\n      rx_clear <= 1'b0;\n  end\n\n  assign edge_o = rx_pulse;\n\nendmodule\n```<|im_end|>",
