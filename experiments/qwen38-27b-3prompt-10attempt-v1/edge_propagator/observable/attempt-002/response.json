  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // TX domain: capture edge_i and generate a toggle\n  logic tx_toggle;\n  logic tx_toggle_d;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      tx_toggle   <= 1'b0;\n      tx_toggle_d <= 1'b0;\n    end else begin\n      tx_toggle_d <= tx_toggle;\n      if (edge_i)\n        tx_toggle <= ~tx_toggle;\n    end\n  end\n\n  // Synchronize tx_toggle into RX domain\n  logic rx_sync0;\n  logic rx_sync1;\n  logic rx_sync2;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      rx_sync0 <= 1'b0;\n      rx_sync1 <= 1'b0;\n      rx_sync2 <= 1'b0;\n    end else begin\n      rx_sync0 <= tx_toggle;\n      rx_sync1 <= rx_sync0;\n      rx_sync2 <= rx_sync1;\n    end\n  end\n\n  // Detect edge on synchronized signal\n  logic rx_toggle_d;\n  logic edge_o;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      rx_toggle_d <= 1'b0;\n      edge_o      <= 1'b0;\n    end else begin\n      rx_toggle_d <= rx_sync2;\n      edge_o      <= (rx_sync2 != rx_toggle_d);\n    end\n  end\n\nendmodule\n```<|im_end|>",
