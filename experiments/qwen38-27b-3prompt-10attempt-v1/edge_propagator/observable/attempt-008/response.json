  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // TX domain: capture edge_i and generate a pulse to toggle the level\n  logic tx_edge_d;\n  logic tx_pulse;\n  logic tx_level;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      tx_edge_d <= 1'b0;\n      tx_level  <= 1'b0;\n    end else begin\n      tx_edge_d <= edge_i;\n      if (edge_i && !tx_edge_d)\n        tx_level <= ~tx_level;\n    end\n  end\n\n  assign tx_pulse = tx_level;\n\n  // Synchronizer: 2-FF synchronizer for tx_level into RX domain\n  logic rx_sync0;\n  logic rx_sync1;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      rx_sync0 <= 1'b0;\n      rx_sync1 <= 1'b0;\n    end else begin\n      rx_sync0 <= tx_pulse;\n      rx_sync1 <= rx_sync0;\n    end\n  end\n\n  // RX domain: detect rising edge of synchronized level to produce one-cycle pulse\n  logic rx_level_d;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      rx_level_d <= 1'b0;\n      edge_o     <= 1'b0;\n    end else begin\n      rx_level_d <= rx_sync1;\n      edge_o     <= rx_sync1 && !rx_level_d;\n    end\n  end\n\nendmodule\n```<|im_end|>",
