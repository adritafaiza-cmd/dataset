  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // TX side: capture edge_i into a level signal\n  logic tx_level;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i)\n      tx_level <= 1'b0;\n    else if (edge_i)\n      tx_level <= 1'b1;\n  end\n\n  // Synchronize tx_level into RX domain\n  logic rx_sync0, rx_sync1;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      rx_sync0 <= 1'b0;\n      rx_sync1 <= 1'b0;\n    end else begin\n      rx_sync0 <= tx_level;\n      rx_sync1 <= rx_sync0;\n    end\n  end\n\n  // RX side: detect rising edge of rx_sync1 to produce a single-cycle pulse\n  logic rx_prev;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i)\n      rx_prev <= 1'b0;\n    else\n      rx_prev <= rx_sync1;\n  end\n\n  assign edge_o = rx_sync1 & ~rx_prev;\n\nendmodule\n```<|im_end|>",
