{
  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // TX domain: detect rising edge of edge_i and generate a toggle\n  logic edge_i_d1;\n  logic edge_i_d2;\n  logic edge_detected;\n  logic toggle_tx;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      edge_i_d1 <= 1'b0;\n      edge_i_d2 <= 1'b0;\n      toggle_tx <= 1'b0;\n    end else begin\n      edge_i_d1 <= edge_i;\n      edge_i_d2 <= edge_i_d1;\n      edge_detected <= (edge_i & ~edge_i_d1);\n      if (edge_i & ~edge_i_d1)\n        toggle_tx <= ~toggle_tx;\n    end\n  end\n\n  // RX domain: synchronize toggle_tx with two flip-flops\n  logic toggle_rx_d1;\n  logic toggle_rx_d2;\n  logic toggle_rx_d3;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      toggle_rx_d1 <= 1'b0;\n      toggle_rx_d2 <= 1'b0;\n      toggle_rx_d3 <= 1'b0;\n    end else begin\n      toggle_rx_d1 <= toggle_tx;\n      toggle_rx_d2 <= toggle_rx_d1;\n      toggle_rx_d3 <= toggle_rx_d2;\n    end\n  end\n\n  // Detect rising edge of the synchronized toggle signal\n  logic toggle_edge;\n\n  always_comb begin\n    toggle_edge = toggle_rx_d2 & ~toggle_rx_d3;\n  end\n\n  // Generate a single-cycle pulse on edge_o\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i)\n      edge_o <= 1'b0;\n    else\n      edge_o <= toggle_edge;\n  end\n\nendmodule\n```<|im_end|>",
