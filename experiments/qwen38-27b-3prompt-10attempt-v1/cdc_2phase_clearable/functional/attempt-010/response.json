 // Source domain: track if we have data to send\n  reg src_has_data;\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_clear_active;\n  reg src_clear_done;\n\n  // Destination domain: track if we have data to present\n  reg dst_has_data;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_clear_active;\n  reg dst_clear_done;\n\n  // Handshake signals crossing domains\n  // src_to_dst: indicates source has data ready\n  reg src_to_dst_valid;\n  // dst_to_src: indicates destination is ready to accept\n  reg dst_to_src_ready;\n\n  // Synchronizers\n  // src_clear_i synchronized to dst domain\n  reg [SYNC_STAGES-1:0] src_clear_sync;\n  // dst_clear_i synchronized to src domain\n  reg [SYNC_STAGES-1:0] dst_clear_sync;\n  // src_to_dst_valid synchronized to dst domain\n  reg [SYNC_STAGES-1:0] src_to_dst_valid_sync;\n  // dst_to_src_ready synchronized to src domain\n  reg [SYNC_STAGES-1:0] dst_to_src_ready_sync;\n\n  // Synchronize src_clear_i to dst domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_clear_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      src_clear_sync <= {src_clear_sync[SYNC_STAGES-2:0], src_clear_i};\n    end\n  end\n\n  // Synchronize dst_clear_i to src domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_clear_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      dst_clear_sync <= {dst_clear_sync[SYNC_STAGES-2:0], dst_clear_i};\n    end\n  end\n\n  // Synchronize src_to_dst_valid to dst domain\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      src_to_dst_valid_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      src_to_dst_valid_sync <= {src_to_dst_valid_sync[SYNC_STAGES-2:0], src_to_dst_valid};\n    end\n  end\n\n  // Synchronize dst_to_src_ready to src domain\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      dst_to_src_ready_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      dst_to_src_ready_sync <= {dst_to_src_ready_sync[SYNC_STAGES-2:0], dst_to_src_ready};\n    end\n  end\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_has_data <= 1'b0;\n      src_data_reg <= {WIDTH{1'b0}};\n      src_clear_active <= 1'b0;\n      src_clear_done <= 1'b0;\n      src_to_dst_valid <= 1'b0;\n    end else begin\n      // Handle clear\n      if (src_clear_i || (CLEAR_ON_ASYNC_RESET && !src_rst_ni)) begin\n        src_clear_active <= 1'b1;\n        src_clear_done <= 1'b0;\n      end else if (src_clear_active) begin\n        // Wait for destination to acknowledge clear\n        if (dst_clear_sync[SYNC_STAGES-1]) begin\n          src_clear_active <= 1'b0;\n          src_clear_done <= 1'b1;\n        end\n      end else if (src_clear_done) begin\n        src_clear_done <= 1'b0;\n      end\n\n      // Data handling\n      if (src_clear_active) begin\n        src_has_data <= 1'b0;\n        src_to_dst_valid <= 1'b0;\n      end else begin\n        // Accept new data if no data pending and destination is ready\n        if (!src_has_data && dst_to_src_ready_sync[SYNC_STAGES-1] && src_valid_i) begin\n          src_has_data <= 1'b1;\n          src_data_reg <= src_data_i;\n          src_to_dst_valid <= 1'b1;\n        end else if (src_has_data && dst_to_src_ready_sync[SYNC_STAGES-1]) begin\n          // Data accepted by destination, clear local\n          src_has_data <= 1'b0;\n          src_to_dst_valid <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // Source ready output\n  assign src_ready_o = !src_has_data && !src_clear_active && dst_to_src_ready_sync[SYNC_STAGES-1];\n\n  // Source clear pending\n  assign src_clear_pending_int = src_clear_active;\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_has_data <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_clear_active <= 1'b0;\n      dst_clear_done <= 1'b0;\n      dst_to_src_ready <= 1'b0;\n    end else begin\n      // Handle clear\n      if (dst_clear_i || (CLEAR_ON_ASYNC_RESET && !dst_rst_ni)) begin\n        dst_clear_active <= 1'b1;\n        dst_clear_done <= 1'b0;\n      end else if (dst_clear_active) begin\n        // Wait for source to acknowledge clear\n        if (src_clear_sync[SYNC_STAGES-1]) begin\n          dst_clear_active <= 1'b0;\n          dst_clear_done <= 1'b1;\n        end\n      end else if (dst_clear_done) begin\n        dst_clear_done <= 1'b0;\n      end\n\n      // Data handling\n      if (dst_clear_active) begin\n        dst_has_data <= 1'b0;\n        dst_to_src_ready <= 1'b0;\n      end else begin\n        // Accept data from source\n        if (!dst_has_data && src_to_dst_valid_sync[SYNC_STAGES-1]) begin\n          dst_has_data <= 1'b1;\n          dst_data_reg <= src_data_reg;\n          dst_to_src_ready <= 1'b1;\n        end else if (dst_has_data && dst_ready_i) begin\n          // Data accepted by destination consumer\n          dst_has_data <= 1'b0;\n          dst_to_src_ready <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // Destination valid and data outputs\n  assign dst_valid_o = dst_has_data && !dst_clear_active;\n  assign dst_data_o = dst_data_reg;\n\n  // Destination clear pending\n  assign dst_clear_pending_int = dst_clear_active;\n\nendmodule\n```<|im_end|>",
