  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire src_clear_synced;\n  wire dst_clear_synced;\n  wire src_clear_pending_int;\n  wire dst_clear_pending_int;\n  wire src_ready_int;\n  wire dst_valid_int;\n  wire [WIDTH-1:0] dst_data_int;\n\n  // Clear pending outputs\n  assign src_clear_pending_o = src_clear_pending_int;\n  assign dst_clear_pending_o = dst_clear_pending_int;\n\n  // Source domain logic\n  reg src_clear_pending_r;\n  reg src_clear_pending_r2;\n  reg src_clear_pending_r3;\n  reg src_clear_pending_r4;\n  reg src_clear_pending_r5;\n  reg src_clear_pending_r6;\n  reg src_clear_pending_r7;\n  reg src_clear_pending_r8;\n  reg src_clear_pending_r9;\n  reg src_clear_pending_r10;\n  reg src_clear_pending_r11;\n  reg src_clear_pending_r12;\n  reg src_clear_pending_r13;\n  reg src_clear_pending_r14;\n  reg src_clear_pending_r15;\n  reg src_clear_pending_r16;\n  reg src_clear_pending_r17;\n  reg src_clear_pending_r18;\n  reg src_clear_pending_r19;\n  reg src_clear_pending_r20;\n  reg src_clear_pending_r21;\n  reg src_clear_pending_r22;\n  reg src_clear_pending_r23;\n  reg src_clear_pending_r24;\n  reg src_clear_pending_r25;\n  reg src_clear_pending_r26;\n  reg src_clear_pending_r27;\n  reg src_clear_pending_r28;\n  reg src_clear_pending_r29;\n  reg src_clear_pending_r30;\n  reg src_clear_pending_r31;\n  reg src_clear_pending_r32;\n  reg src_clear_pending_r33;\n  reg src_clear_pending_r34;\n  reg src_clear_pending_r35;\n  reg src_clear_pending_r36;\n  reg src_clear_pending_r37;\