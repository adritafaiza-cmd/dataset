  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire [WIDTH-1:0] src_data_reg;\n  wire             src_valid_reg;\n  wire             src_ready_int;\n  wire             src_clear_pending_int;\n\n  wire             dst_valid_reg;\n  wire [WIDTH-1:0] dst_data_reg;\n  wire             dst_ready_int;\n  wire             dst_clear_pending_int;\n\n  // Clear pending outputs\n  assign src_clear_pending_o = src_clear_pending_int;\n  assign dst_clear_pending_o = dst_clear_pending_int;\n\n  // Source domain logic\n  // We use a simple handshake: src_valid_i && src_ready_o indicates transfer.\n  // The channel holds one outstanding item.\n  // src_ready_o is high when the channel is empty and not in clear state.\n\n  // Clear state machine for source side\n  // When src_clear_i is asserted, we need to:\n  // 1. Stop accepting new data\n  // 2. Wait for any in-flight data to be cleared\n  // 3. Return to idle\n\n  // For simplicity, we'll use a flag to track if we're in clear mode\n  reg src_in_clear;\n  reg src_clear_done;\n\n  // Destination domain logic\n  reg dst_in_clear;\n  reg dst_clear_done;\n\n  // Synchronization of clear requests\n  // src_clear_i needs to be synchronized to dst domain\n  // dst_clear_i needs to be synchronized to src domain\n\n  // Sync src_clear_i to dst domain\n  reg [SYNC_STAGES-1:0] src_clear_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_clear_sync <= {SYNC_STAGES{1'b0}};\n    else\n      src_clear_sync <= {src_clear_sync[SYNC_STAGES-2:0], src_clear_i};\n  end\n  wire src_clear_dst = src_clear_sync[SYNC_STAGES-1];\n\n  // Sync dst_clear_i to src domain\n  reg [SYNC_STAGES-1:0] dst_clear_sync;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_clear_sync <= {SYNC_STAGES{1'b0}};\n    else\n      dst_clear_sync <= {dst_clear_sync[SYNC_STAGES-2:0], dst_clear_i};\n  end\n  wire dst_clear_src = dst_clear_sync[SYNC_STAGES-1];\n\n  // Source domain: track if there's data in flight\n  // The channel holds one item. We need to know if the destination has accepted it.\n  // We'll use a simple approach: src_ready is high when no data is pending.\n\n  // Let's use a different approach:\n  // src_ready_o is high when the channel is empty (no outstanding item)\n  // When src_valid_i && src_ready_o, the item is accepted and becomes outstanding.\n  // The item remains outstanding until dst_ready_i accepts it.\n\n  // We need to synchronize the \"outstanding\" status between domains.\n  // Let's use a flag: src_has_outstanding\n  // When src_valid_i && src_ready_o, src_has_outstanding becomes 1.\n  // When dst_ready_i && dst_valid_o, the item is consumed, and we need to notify src.\n\n  // Sync dst_ready_i && dst_valid_o to src domain\n  // Actually, we need to sync the \"consumed\" event.\n\n  // Let's define:\n  // src_outstanding: 1 when there's an item in the channel\n  // dst_outstanding: 1 when there's an item in the channel (from dst perspective)\n\n  // These should be the same, but we need to synchronize.\n\n  // Simpler approach: Use a single \"valid\" flag that is synchronized.\n  // But valid/ready handshake across CDC is tricky.\n\n  // Let's use a different strategy:\n  // The source holds the data and valid flag.\n  // The destination sees the synchronized valid and data.\n  // When dst_ready_i && dst_valid_o, the destination consumes the item.\n  // We need to tell the source that the item was consumed.\n\n  // Sync the \"consumed\" signal from dst to src.\n  // consumed = dst_ready_i && dst_valid_o\n\n  reg [SYNC_STAGES-1:0] consumed_sync;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      consumed_sync <= {SYNC_STAGES{1'b0}};\n    else\n      consumed_sync <= {consumed_sync[SYNC_STAGES-2:0], dst_ready_i && dst_valid_reg};\n  end\n  wire consumed_src = consumed_sync[SYNC_STAGES-1];\n\n  // Source domain: track outstanding item\n  reg src_outstanding;\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      src_outstanding <= 1'b0;\n    else if (src_valid_i && src_ready_int)\n      src_outstanding <= 1'b1;\n    else if (consumed_src)\n      src_outstanding <= 1'b0;\n  end\n\n  // src_ready is high when no outstanding item and not in clear\n  assign src_ready_int = !src_outstanding && !src_in_clear;\n  assign src_ready_o = src_ready_int;\n\n  // Source data and valid registers\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_data_reg <= {WIDTH{1'b0}};\n      src_valid_reg <= 1'b0;\n    end else if (src_valid_i && src_ready_int) begin\n      src_data_reg <= src_data_i;\n      src_valid_reg <= 1'b1;\n    end else if (consumed_src) begin\n      src_valid_reg <= 1'b0;\n    end\n  end\n\n  // Synchronize src_valid_reg and src_data_reg to dst domain\n  reg [SYNC_STAGES-1:0] src_valid_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_valid_sync <= {SYNC_STAGES{1'b0}};\n    else\n      src_valid_sync <= {src_valid_sync[SYNC_STAGES-2:0], src_valid_reg};\n  end\n  wire src_valid_dst = src_valid_sync[SYNC_STAGES-1];\n\n  // Data synchronization: use a mux to select data based on valid\n  // When valid transitions from 0 to 1, we need to capture the data.\n  // We'll use a simple approach: synchronize the data when valid is high.\n  // But data can change while valid is high, so we need to be careful.\n\n  // Better approach: use a data synchronizer that captures data when valid goes high.\n  // We'll use a register that captures src_data_reg when src_valid_reg rises.\n\n  reg [WIDTH-1:0] dst_data_sync;\n  reg             dst_valid_sync;\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_data_sync <= {WIDTH{1'b0}};\n      dst_valid_sync <= 1'b0;\n    end else begin\n      if (src_valid_dst && !dst_valid_sync) begin\n        // Valid rising edge: capture data\n        dst_data_sync <= src_data_reg;\n        dst_valid_sync <= 1'b1;\n      end else if (dst_ready_i && dst_valid_sync) begin\n        // Data consumed\n        dst_valid_sync <= 1'b0;\n      end\n    end\n  end\n\n  assign dst_valid_o = dst_valid_sync;\n  assign dst_data_o = dst_data_sync;\n\n  // Clear handling\n  // When src_clear_i is asserted, we need to clear the source side.\n  // When dst_clear_i is asserted, we need to clear the destination side.\n  // The clear is coordinated: both sides must be cleared.\n\n  // Source clear:\n  // When src_clear_i is high, set src_in_clear.\n  // Clear src_outstanding and src_valid_reg.\n  // Wait until dst_clear_src is also high (or until the clear is complete).\n  // Actually, the clear should be coordinated: when either side requests clear,\n  // both sides should clear.\n\n  // Let's define: clear_request = src_clear_i || dst_clear_src (in src domain)\n  // And: clear_request_dst = src_clear_dst || dst_clear_i (in dst domain)\n\n  wire src_clear_request = src_clear_i || dst_clear_src;\n  wire dst_clear_request = src_clear_dst || dst_clear_i;\n\n  // Source clear state machine\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_in_clear <= 1'b0;\n      src_clear_done <= 1'b0;\n    end else if (src_clear_request) begin\n      src_in_clear <= 1'b1;\n      src_clear_done <= 1'b0;\n    end else if (src_in_clear && dst_clear_src) begin\n      // Both sides have acknowledged the clear\n      src_in_clear <= 1'b0;\n      src_clear_done <= 1'b1;\n    end\n  end\n\n  // When in clear, force src_outstanding and src_valid_reg to 0\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_outstanding <= 1'b0;\n      src_valid_reg <= 1'b0;\n    end else if (src_in_clear) begin\n      src_outstanding <= 1'b0;\n      src_valid_reg <= 1'b0;\n    end else if (src_valid_i && src_ready_int) begin\n      src_outstanding <= 1'b1;\n      src_valid_reg <= 1'b1;\n    end else if (consumed_src) begin\n      src_outstanding <= 1'b0;\n      src_valid_reg <= 1'b0;\n    end\n  end\n\n  // Destination clear state machine\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_in_clear <= 1'b0;\n      dst_clear_done <= 1'b0;\n    end else if (dst_clear_request) begin\n      dst_in_clear <= 1'b1;\n      dst_clear_done <= 1'b0;\n    end else if (dst_in_clear && src_clear_dst) begin\n      // Both sides have acknowledged the clear\n      dst_in_clear <= 1'b0;\n      dst_clear_done <= 1'b1;\n    end\n  end\n\n  // When in clear, force dst_valid_sync to 0\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_sync <= 1'b0;\n      dst_data_sync <= {WIDTH{1'b0}};\n    end else if (dst_in_clear) begin\n      dst_valid_sync <= 1'b0;\n    end else begin\n      if (src_valid_dst && !dst_valid_sync) begin\n        dst_data_sync <= src_data_reg;\n        dst_valid_sync <= 1'b1;\n      end else if (dst_ready_i && dst_valid_sync) begin\n        dst_valid_sync <= 1'b0;\n      end\n    end\n  end\n\n  // Clear pending outputs\n  // src_clear_pending_o is high while src_in_clear is high\n  // dst_clear_pending_o is high while dst_in_clear is high\n  assign src_clear_pending_int = src_in_clear;\n  assign dst_clear_pending_int = dst_in_clear;\n\n  // Handle CLEAR_ON_ASYNC_RESET\n  // When CLEAR_ON_ASYNC_RESET is set, async reset should also flush the channel.\n  // This is already handled by the reset logic above.\n\nendmodule\n```<|im_end|>",
