  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals\n  wire src_req;\n  wire dst_ack;\n  wire dst_req;\n  wire src_ack;\n\n  // Source domain state\n  reg src_valid_reg;\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_clear_pending_reg;\n  reg src_clear_active_reg;\n\n  // Destination domain state\n  reg dst_valid_reg;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_clear_pending_reg;\n  reg dst_clear_active_reg;\n\n  // CDC synchronizers\n  // src_req -> dst domain\n  reg [SYNC_STAGES-1:0] src_req_sync;\n  // dst_ack -> src domain\n  reg [SYNC_STAGES-1:0] dst_ack_sync;\n  // dst_req -> src domain\n  reg [SYNC_STAGES-1:0] dst_req_sync;\n  // src_ack -> dst domain\n  reg [SYNC_STAGES-1:0] src_ack_sync;\n\n  // Synchronizer logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_req_sync <= {SYNC_STAGES{1'b0}};\n    else\n      src_req_sync <= {src_req_sync[SYNC_STAGES-2:0], src_req};\n  end\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_ack_sync <= {SYNC_STAGES{1'b0}};\n    else\n      dst_ack_sync <= {dst_ack_sync[SYNC_STAGES-2:0], dst_ack};\n  end\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_req_sync <= {SYNC_STAGES{1'b0}};\n    else\n      dst_req_sync <= {dst_req_sync[SYNC_STAGES-2:0], dst_req};\n  end\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_ack_sync <= {SYNC_STAGES{1'b0}};\n    else\n      src_ack_sync <= {src_ack_sync[SYNC_STAGES-2:0], src_ack};\n  end\n\n  // Synchronized signals\n  wire src_req_synced = src_req_sync[SYNC_STAGES-1];\n  wire dst_ack_synced = dst_ack_sync[SYNC_STAGES-1];\n  wire dst_req_synced = dst_req_sync[SYNC_STAGES-1];\n  wire src_ack_synced = src_ack_sync[SYNC_STAGES-1];\n\n  // Source domain logic\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_reg <= 1'b0;\n      src_data_reg <= {WIDTH{1'b0}};\n      src_clear_pending_reg <= 1'b0;\n      src_clear_active_reg <= 1'b0;\n    end else begin\n      // Clear handling\n      if (src_clear_i) begin\n        src_clear_active_reg <= 1'b1;\n        src_clear_pending_reg <= 1'b1;\n      end\n\n      if (src_clear_active_reg) begin\n        // Wait for destination to acknowledge clear\n        if (dst_ack_synced) begin\n          src_clear_active_reg <= 1'b0;\n          src_clear_pending_reg <= 1'b0;\n          src_valid_reg <= 1'b0;\n          src_data_reg <= {WIDTH{1'b0}};\n        end\n      end else begin\n        // Normal operation\n        if (src_valid_i && src_ready_o) begin\n          src_valid_reg <= 1'b1;\n          src_data_reg <= src_data_i;\n        end else if (dst_ack_synced) begin\n          src_valid_reg <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // Source ready: can accept new data if not holding valid data and not in clear\n  assign src_ready_o = !src_valid_reg && !src_clear_active_reg;\n\n  // Source clear pending output\n  assign src_clear_pending_o = src_clear_pending_reg;\n\n  // Source request: high when we have valid data to send\n  assign src_req = src_valid_reg && !src_clear_active_reg;\n\n  // Source acknowledge: high when we acknowledge destination's clear request\n  assign src_ack = src_clear_active_reg;\n\n  // Destination domain logic\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_data_reg <= {WIDTH{1'b0}};\n      dst_clear_pending_reg <= 1'b0;\n      dst_clear_active_reg <= 1'b0;\n    end else begin\n      // Clear handling\n      if (dst_clear_i) begin\n        dst_clear_active_reg <= 1'b1;\n        dst_clear_pending_reg <= 1'b1;\n      end\n\n      if (dst_clear_active_reg) begin\n        // Wait for source to acknowledge clear\n        if (src_ack_synced) begin\n          dst_clear_active_reg <= 1'b0;\n          dst_clear_pending_reg <= 1'b0;\n          dst_valid_reg <= 1'b0;\n          dst_data_reg <= {WIDTH{1'b0}};\n        end\n      end else begin\n        // Normal operation\n        if (src_req_synced && !dst_valid_reg) begin\n          dst_valid_reg <= 1'b1;\n          dst_data_reg <= src_data_reg;\n        end else if (dst_valid_reg && dst_ready_i) begin\n          dst_valid_reg <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // Destination valid output\n  assign dst_valid_o = dst_valid_reg && !dst_clear_active_reg;\n\n  // Destination data output\n  assign dst_data_o = dst_data_reg;\n\n  // Destination clear pending output\n  assign dst_clear_pending_o = dst_clear_pending_reg;\n\n  // Destination request: high when we request clear\n  assign dst_req = dst_clear_active_reg;\n\n  // Destination acknowledge: high when we acknowledge source's clear request\n  assign dst_ack = dst_clear_active_reg;\n\nendmodule\n```<|im_end|>",
