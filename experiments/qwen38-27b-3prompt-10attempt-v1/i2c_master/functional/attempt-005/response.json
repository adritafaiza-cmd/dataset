  "text": "```verilog\nmodule i2c_master (\n    input  wire        clk,\n    input  wire        rst,\n    /*\n     * Host interface\n     */\n    input  wire [6:0]  s_axis_cmd_address,\n    input  wire        s_axis_cmd_start,\n    input  wire        s_axis_cmd_read,\n    input  wire        s_axis_cmd_write,\n    input  wire        s_axis_cmd_write_multiple,\n    input  wire        s_axis_cmd_stop,\n    input  wire        s_axis_cmd_valid,\n    output wire        s_axis_cmd_ready,\n    input  wire [7:0]  s_axis_data_tdata,\n    input  wire        s_axis_data_tvalid,\n    output wire        s_axis_data_tready,\n    input  wire        s_axis_data_tlast,\n    output wire [7:0]  m_axis_data_tdata,\n    output wire        m_axis_data_tvalid,\n    input  wire        m_axis_data_tready,\n    output wire        m_axis_data_tlast,\n    /*\n     * I2C interface\n     */\n    input  wire        scl_i,\n    output wire        scl_o,\n    output wire        scl_t,\n    input  wire        sda_i,\n    output wire        sda_o,\n    output wire        sda_t,\n    /*\n     * Status\n     */\n    output wire        busy,\n    output wire        bus_control,\n    output wire        bus_active,\n    output wire        missed_ack,\n    /*\n     * Configuration\n     */\n    input  wire [15:0] prescale,\n    input  wire        stop_on_idle\n);\n\n    // State machine states\n    localparam S_IDLE            = 4'd0;\n    localparam S_START           = 4'd1;\n    localparam S_ADDR_BIT        = 4'd2;\n    localparam S_ADDR_ACK        = 4'd3;\n    localparam S_DATA_BIT        = 4'd4;\n    localparam S_DATA_ACK        = 4'd5;\n    localparam S_READ_BIT        = 4'd6;\n    localparam S_READ_ACK        = 4'd7;\n    localparam S_STOP            = 4'd8;\n    localparam S_WAIT_IDLE       = 4'd9;\n\n    reg [3:0]  state;\n    reg [3:0]  bit_count;\n    reg [7:0]  tx_byte;\n    reg [7:0]  rx_byte;\n    reg        is_read;\n    reg        is_write;\n    reg        is_write_multiple;\n    reg        need_stop;\n    reg        missed_ack_reg;\n    reg        bus_active_reg;\n    reg        bus_control_reg;\n\n    // Prescale counter\n    reg [15:0] prescale_cnt;\n    reg        prescale_done;\n\n    // Open-drain outputs\n    reg        scl_o_reg;\n    reg        sda_o_reg;\n    reg        scl_t_reg;\n    reg        sda_t_reg;\n\n    assign scl_o = scl_o_reg;\n    assign sda_o = sda_o_reg;\n    assign scl_t = scl_t_reg;\n    assign sda_t = sda_t_reg;\n\n    assign busy = (state != S_IDLE);\n    assign bus_control = bus_control_reg;\n    assign bus_active = bus_active_reg;\n    assign missed_ack = missed_ack_reg;\n\n    // AXI-Stream command ready\n    assign s_axis_cmd_ready = (state == S_IDLE) && !busy;\n\n    // AXI-Stream data ready\n    assign s_axis_data_tready = (state == S_DATA_BIT) && (bit_count == 4'd0) && is_write;\n\n    // AXI-Stream read data output\n    assign m_axis_data_tdata = rx_byte;\n    assign m_axis_data_tvalid = (state == S_READ_ACK) && !missed_ack_reg;\n    assign m_axis_data_tlast = s_axis_data_tlast; // Simplified: assume single byte read or use tlast from command\n\n    // Prescale logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            prescale_cnt <= 16'd0;\n            prescale_done <= 1'b0;\n        end else begin\n            if (state == S_IDLE) begin\n                prescale_cnt <= 16'd0;\n                prescale_done <= 1'b0;\n            end else if (prescale_cnt < prescale) begin\n                prescale_cnt <= prescale_cnt + 16'd1;\n                prescale_done <= 1'b0;\n            end else begin\n                prescale_cnt <= 16'd0;\n                prescale_done <= 1'b1;\n            end\n        end\n    end\n\n    // Main state machine\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            state <= S_IDLE;\n            bit_count <= 4'd0;\n            tx_byte <= 8'd0;\n            rx_byte <= 8'd0;\n            is_read <= 1'b0;\n            is_write <= 1'b0;\n            is_write_multiple <= 1'b0;\n            need_stop <= 1'b0;\n            missed_ack_reg <= 1'b0;\n            bus_active_reg <= 1'b0;\n            bus_control_reg <= 1'b0;\n            scl_o_reg <= 1'b1;\n            sda_o_reg <= 1'b1;\n            scl_t_reg <= 1'b1;\n            sda_t_reg <= 1'b1;\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    scl_o_reg <= 1'b1;\n                    sda_o_reg <= 1'b1;\n                    scl_t_reg <= 1'b1;\n                    sda_t_reg <= 1'b1;\n                    bus_active_reg <= 1'b0;\n                    bus_control_reg <= 1'b0;\n                    missed_ack_reg <= 1'b0;\n                    if (s_axis_cmd_valid && s_axis_cmd_ready) begin\n                        is_read <= s_axis_cmd_read;\n                        is_write <= s_axis_cmd_write;\n                        is_write_multiple <= s_axis_cmd_write_multiple;\n                        need_stop <= s_axis_cmd_stop;\n                        tx_byte <= {s_axis_cmd_address, s_axis_cmd_read};\n                        bit_count <= 4'd7;\n                        state <= S_START;\n                        bus_control_reg <= 1'b1;\n                        bus_active_reg <= 1'b1;\n                    end\n                end\n\n                S_START: begin\n                    // SCL high, SDA high\n                    scl_o_reg <= 1'b1;\n                    sda_o_reg <= 1'b1;\n                    scl_t_reg <= 1'b1;\n                    sda_t_reg <= 1'b1;\n                    if (prescale_done) begin\n                        // SDA low while SCL high (start condition)\n                        scl_o_reg <= 1'b1;\n                        sda_o_reg <= 1'b0;\n                        scl_t_reg <= 1'b1;\n                        sda_t_reg <= 1'b0;\n                        state <= S_ADDR_BIT;\n                        bit_count <= 4'd7;\n                    end\n                end\n\n                S_ADDR_BIT: begin\n                    // Drive SDA with bit, SCL high\n                    scl_o_reg <= 1'b1;\n                    sda_o_reg <= tx_byte[bit_count];\n                    scl_t_reg <= 1'b1;\n                    sda_t_reg <= 1'b0;\n                    if (prescale_done) begin\n                        // SCL low to sample\n                        scl_o_reg <= 1'b0;\n                        sda_o_reg <= tx_byte[bit_count];\n                        scl_t_reg <= 1'b0;\n                        sda_t_reg <= 1'b0;\n                        state <= S_ADDR_ACK;\n                    end\n                end\n\n                S_ADDR_ACK: begin\n                    // SCL low, SDA released to read ACK\n                    scl_o_reg <= 1'b0;\n                    sda_o_reg <= 1'b1;\n                    scl_t_reg <= 1'b0;\n                    sda_t_reg <= 1'b1;\n                    if (prescale_done) begin\n                        // SCL high to sample ACK\n                        scl_o_reg <= 1'b1;\n                        sda_o_reg <= 1'b1;\n                        scl_t_reg <= 1'b1;\n                        sda_t_reg <= 1'b1;\n                        if (sda_i) begin\n                            // NACK\n                            missed_ack_reg <= 1'b1;\n                            state <= S_STOP;\n                        end else begin\n                            // ACK\n                            if (is_read) begin\n                                state <= S_READ_BIT;\n                                bit_count <= 4'd7;\n                                rx_byte <= 8'd0;\n                            end else begin\n                                // Wait for data\n                                state <= S_DATA_BIT;\n                                bit_count <= 4'd7;\n                            end\n                        end\n                    end\n                end\n\n                S_DATA_BIT: begin\n                    // Drive SDA with data bit, SCL high\n                    if (s_axis_data_tvalid && s_axis_data_tready) begin\n                        tx_byte <= s_axis_data_tdata;\n                    end\n                    scl_o_reg <= 1'b1;\n                    sda_o_reg <= tx_byte[bit_count];\n                    scl_t_reg <= 1'b1;\n                    sda_t_reg <= 1'b0;\n                    if (prescale_done) begin\n                        // SCL low\n                        scl_o_reg <= 1'b0;\n                        sda_o_reg <= tx_byte[bit_count];\n                        scl_t_reg <= 1'b0;\n                        sda_t_reg <= 1'b0;\n                        state <= S_DATA_ACK;\n                    end\n                end\n\n                S_DATA_ACK: begin\n                    // SCL low, SDA released to read ACK\n                    scl_o_reg <= 1'b0;\n                    sda_o_reg <= 1'b1;\n                    scl_t_reg <= 1'b0;\n                    sda_t_reg <= 1'b1;\n                    if (prescale_done) begin\n                        // SCL high to sample ACK\n                        scl_o_reg <= 1'b1;\n                        sda_o_reg <= 1'b1;\n                        scl_t_reg <= 1'b1;\n                        sda_t_reg <= 1'b1;\n                        if (sda_i) begin\n                            // NACK\n                            missed_ack_reg <= 1'b1;\n                            state <= S_STOP;\n                        end else begin\n                            // ACK\n                            if (bit_count == 4'd0) begin\n                                if (is_write_multiple && !s_axis_data_tlast) begin\n                                    state <= S_DATA_BIT;\n                                    bit_count <= 4'd7;\n                                end else begin\n                                    state <= S_STOP;\n                                end\n                            end else begin\n                                bit_count <= bit_count - 1'b1;\n                                state <= S_DATA_BIT;\n                            end\n                        end\n                    end\n                end\n\n                S_READ_BIT: begin\n                    // SCL high, SDA released to read data\n                    scl_o_reg <= 1'b1;\n                    sda_o_reg <= 1'b1;\n                    scl_t_reg <= 1'b1;\n                    sda_t_reg <= 1'b1;\n                    if (prescale_done) begin\n                        // SCL low to sample data\n                        scl_o_reg <= 1'b0;\n                        sda_o_reg <= 1'b1;\n                        scl_t_reg <= 1'b0;\n                        sda_t_reg <= 1'b1;\n                        rx_byte <= {sda_i, rx_byte[7:1]};\n                        state <= S_READ_ACK;\n                    end\n                end\n\n                S_READ_ACK: begin\n                    // SCL low, drive ACK/NACK\n                    scl_o_reg <= 1'b0;\n                    sda_o_reg <= 1'b0; // ACK\n                    scl_t_reg <= 1'b0;\n                    sda_t_reg <= 1'b0;\n                    if (prescale_done) begin\n                        // SCL high\n                        scl_o_reg <= 1'b1;\n                        sda_o_reg <= 1'b0;\n                        scl_t_reg <= 1'b1;\n                        sda_t_reg <= 1'b0;\n                        if (bit_count == 4'd0) begin\n                            state <= S_STOP;\n                        end else begin\n                            bit_count <= bit_count - 1'b1;\n                            state <= S_READ_BIT;\n                        end\n                    end\n                end\n\n                S_STOP: begin\n                    // SCL low, SDA low\n                    scl_o_reg <= 1'b0;\n                    sda_o_reg <= 1'b0;\n                    scl_t_reg <= 1'b0;\n                    sda_t_reg <= 1'b0;\n                    if (prescale_done) begin\n                        // SCL high, SDA low\n                        scl_o_reg <= 1'b1;\n                        sda_o_reg <= 1'b0;\n                        scl_t_reg <= 1'b1;\n                        sda_t_reg <= 1'b0;\n                        state <= S_WAIT_IDLE;\n                    end\n                end\n\n                S_WAIT_IDLE: begin\n                    // SCL high, SDA high (stop condition)\n                    scl_o_reg <= 1'b1;\n                    sda_o_reg <= 1'b1;\n                    scl_t_reg <= 1'b1;\n                    sda_t_reg <= 1'b1;\n                    if (prescale_done) begin\n                        state <= S_IDLE;\n                        bus_control_reg <= 1'b0;\n                        bus_active_reg <= 1'b0;\n                    end\n                end\n\n                default: begin\n                    state <= S_IDLE;\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>",
