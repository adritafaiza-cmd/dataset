  "text": "```verilog\nmodule i2c_master (\n    input  wire        clk,\n    input  wire        rst,\n    /*\n     * Host interface\n     */\n    input  wire [6:0]  s_axis_cmd_address,\n    input  wire        s_axis_cmd_start,\n    input  wire        s_axis_cmd_read,\n    input  wire        s_axis_cmd_write,\n    input  wire        s_axis_cmd_write_multiple,\n    input  wire        s_axis_cmd_stop,\n    input  wire        s_axis_cmd_valid,\n    output wire        s_axis_cmd_ready,\n    input  wire [7:0]  s_axis_data_tdata,\n    input  wire        s_axis_data_tvalid,\n    output wire        s_axis_data_tready,\n    input  wire        s_axis_data_tlast,\n    output wire [7:0]  m_axis_data_tdata,\n    output wire        m_axis_data_tvalid,\n    input  wire        m_axis_data_tready,\n    output wire        m_axis_data_tlast,\n    /*\n     * I2C interface\n     */\n    input  wire        scl_i,\n    output wire        scl_o,\n    output wire        scl_t,\n    input  wire        sda_i,\n    output wire        sda_o,\n    output wire        sda_t,\n    /*\n     * Status\n     */\n    output wire        busy,\n    output wire        bus_control,\n    output wire        bus_active,\n    output wire        missed_ack,\n    /*\n     * Configuration\n     */\n    input  wire [15:0] prescale,\n    input  wire        stop_on_idle\n);\n\n    // State machine states\n    localparam S_IDLE          = 4'd0;\n    localparam S_START         = 4'd1;\n    localparam S_SEND_BIT      = 4'd2;\n    localparam S_RECV_BIT      = 4'd3;\n    localparam S_ACK           = 4'd4;\n    localparam S_STOP          = 4'd5;\n    localparam S_DONE          = 4'd6;\n\n    // Operation modes\n    localparam OP_NONE         = 2'd0;\n    localparam OP_WRITE        = 2'd1;\n    localparam OP_READ         = 2'd2;\n    localparam OP_WRITE_MULTI  = 2'd3;\n\n    reg [3:0]  state;\n    reg [3:0]  next_state;\n\n    reg [1:0]  op_mode;\n    reg [6:0]  addr_reg;\n    reg [7:0]  data_reg;\n    reg [2:0]  bit_cnt;\n    reg [7:0]  shift_out;\n    reg [7:0]  shift_in;\n    reg        ack_received;\n    reg        ack_missed;\n    reg        data_valid;\n    reg        data_last;\n    reg        cmd_pending;\n    reg        write_multi_pending;\n    reg        stop_pending;\n    reg        start_pending;\n    reg        read_pending;\n    reg        write_pending;\n    reg        write_multi_cmd;\n    reg        stop_cmd;\n    reg        start_cmd;\n    reg        read_cmd;\n    reg        write_cmd;\n    reg [6:0]  cmd_addr;\n\n    // Timing\n    reg [15:0] prescale_reg;\n    reg [15:0] timer;\n    reg        timer_done;\n\n    // I2C signals\n    reg        scl_out;\n    reg        sda_out;\n    reg        scl_tri;\n    reg        sda_tri;\n\n    // Internal signals\n    wire       scl_high;\n    wire       sda_high;\n\n    assign scl_high = scl_i;\n    assign sda_high = sda_i;\n\n    // Output assignments\n    assign scl_o = scl_out;\n    assign sda_o = sda_out;\n    assign scl_t = scl_tri;\n    assign sda_t = sda_tri;\n\n    assign busy = (state != S_IDLE) || cmd_pending;\n    assign bus_control = (state != S_IDLE);\n    assign bus_active = (state != S_IDLE) && (state != S_DONE);\n    assign missed_ack = ack_missed;\n\n    // AXI command ready\n    assign s_axis_cmd_ready = (state == S_IDLE) && !cmd_pending;\n\n    // AXI data ready\n    assign s_axis_data_tready = (state == S_IDLE) && cmd_pending && \n                                 (op_mode == OP_WRITE || op_mode == OP_WRITE_MULTI) &&\n                                 !write_multi_pending;\n\n    // AXI data output\n    assign m_axis_data_tdata = shift_in;\n    assign m_axis_data_tvalid = data_valid;\n    assign m_axis_data_tlast = data_last;\n\n    // Timer logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            prescale_reg <= 16'd1;\n            timer <= 16'd0;\n            timer_done <= 1'b0;\n        end else begin\n            prescale_reg <= prescale;\n            if (timer_done) begin\n                timer <= 16'd0;\n                timer_done <= 1'b0;\n            end else if (timer < prescale_reg) begin\n                timer <= timer + 16'd1;\n            end else begin\n                timer_done <= 1'b1;\n            end\n        end\n    end\n\n    // Command capture\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            cmd_pending <= 1'b0;\n            start_pending <= 1'b0;\n            read_pending <= 1'b0;\n            write_pending <= 1'b0;\n            write_multi_pending <= 1'b0;\n            stop_pending <= 1'b0;\n            start_cmd <= 1'b0;\n            read_cmd <= 1'b0;\n            write_cmd <= 1'b0;\n            write_multi_cmd <= 1'b0;\n            stop_cmd <= 1'b0;\n            cmd_addr <= 7'd0;\n            op_mode <= OP_NONE;\n        end else if (state == S_IDLE && !cmd_pending) begin\n            if (s_axis_cmd_valid) begin\n                cmd_pending <= 1'b1;\n                cmd_addr <= s_axis_cmd_address;\n                start_cmd <= s_axis_cmd_start;\n                read_cmd <= s_axis_cmd_read;\n                write_cmd <= s_axis_cmd_write;\n                write_multi_cmd <= s_axis_cmd_write_multiple;\n                stop_cmd <= s_axis_cmd_stop;\n                \n                if (s_axis_cmd_start) begin\n                    op_mode <= OP_NONE;\n                end else if (s_axis_cmd_read) begin\n                    op_mode <= OP_READ;\n                end else if (s_axis_cmd_write_multiple) begin\n                    op_mode <= OP_WRITE_MULTI;\n                end else if (s_axis_cmd_write) begin\n                    op_mode <= OP_WRITE;\n                end else if (s_axis_cmd_stop) begin\n                    op_mode <= OP_NONE;\n                end\n            end\n        end else if (state == S_DONE) begin\n            cmd_pending <= 1'b0;\n            start_pending <= 1'b0;\n            read_pending <= 1'b0;\n            write_pending <= 1'b0;\n            write_multi_pending <= 1'b0;\n            stop_pending <= 1'b0;\n            start_cmd <= 1'b0;\n            read_cmd <= 1'b0;\n            write_cmd <= 1'b0;\n            write_multi_cmd <= 1'b0;\n            stop_cmd <= 1'b0;\n            op_mode <= OP_NONE;\n        end\n    end\n\n    // Data capture for write\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            data_reg <= 8'd0;\n        end else if (s_axis_data_tready && s_axis_data_tvalid) begin\n            data_reg <= s_axis_data_tdata;\n        end\n    end\n\n    // Main state machine\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            state <= S_IDLE;\n            bit_cnt <= 3'd0;\n            shift_out <= 8'd0;\n            shift_in <= 8'd0;\n            ack_received <= 1'b0;\n            ack_missed <= 1'b0;\n            data_valid <= 1'b0;\n            data_last <= 1'b0;\n            scl_out <= 1'b1;\n            sda_out <= 1'b1;\n            scl_tri <= 1'b1;\n            sda_tri <= 1'b1;\n        end else begin\n            // Default: hold outputs\n            scl_tri <= 1'b1;\n            sda_tri <= 1'b1;\n            \n            case (state)\n                S_IDLE: begin\n                    scl_out <= 1'b1;\n                    sda_out <= 1'b1;\n                    scl_tri <= 1'b1;\n                    sda_tri <= 1'b1;\n                    data_valid <= 1'b0;\n                    data_last <= 1'b0;\n                    ack_missed <= 1'b0;\n                    \n                    if (cmd_pending && timer_done) begin\n                        if (start_cmd) begin\n                            // Generate START condition\n                            state <= S_START;\n                            bit_cnt <= 3'd0;\n                            scl_out <= 1'b1;\n                            sda_out <= 1'b1;\n                            scl_tri <= 1'b0;\n                            sda_tri <= 1'b0;\n                        end else if (stop_cmd) begin\n                            // Generate STOP condition\n                            state <= S_STOP;\n                            bit_cnt <= 3'd0;\n                            scl_out <= 1'b1;\n                            sda_out <= 1'b0;\n                            scl_tri <= 1'b0;\n                            sda_tri <= 1'b0;\n                        end else if (read_cmd) begin\n                            // Read operation: send address with R bit\n                            state <= S_SEND_BIT;\n                            bit_cnt <= 3'd7;\n                            shift_out <= {cmd_addr, 1'b1};\n                            scl_out <= 1'b1;\n                            sda_out <= 1'b1;\n                            scl_tri <= 1'b0;\n                            sda_tri <= 1'b0;\n                        end else if (write_cmd) begin\n                            // Write operation: send address with W bit\n                            state <= S_SEND_BIT;\n                            bit_cnt <= 3'd7;\n                            shift_out <= {cmd_addr, 1'b0};\n                            scl_out <= 1'b1;\n                            sda_out <= 1'b1;\n                            scl_tri <= 1'b0;\n                            sda_tri <= 1'b0;\n                        end else if (write_multi_cmd) begin\n                            // Write multiple: send address with W bit\n                            state <= S_SEND_BIT;\n                            bit_cnt <= 3'd7;\n                            shift_out <= {cmd_addr, 1'b0};\n                            scl_out <= 1'b1;\n                            sda_out <= 1'b1;\n                            scl_tri <= 1'b0;\n                            sda_tri <= 1'b0;\n                        end\n                    end\n                end\n\n                S_START: begin\n                    // START: SCL high, SDA high -> SCL high, SDA low\n                    if (timer_done) begin\n                        sda_out <= 1'b0;\n                        state <= S_SEND_BIT;\n                        bit_cnt <= 3'd7;\n                        if (read_cmd) begin\n                            shift_out <= {cmd_addr, 1'b1};\n                        end else begin\n                            shift_out <= {cmd_addr, 1'b0};\n                        end\n                    end\n                end\n\n                S_SEND_BIT: begin\n                    // Send one bit\n                    if (timer_done) begin\n                        if (bit_cnt == 3'd0) begin\n                            // All bits sent, wait for ACK\n                            state <= S_ACK;\n                            bit_cnt <= 3'd0;\n                            scl_out <= 1'b1;\n                            sda_out <= 1'b1;\n                            scl_tri <= 1'b0;\n                            sda_tri <= 1'b1; // Release SDA for ACK\n                        end else begin\n                            // Drive SDA with current bit\n                            sda_out <= shift_out[7];\n                            sda_tri <= 1'b0;\n                            scl_out <= 1'b0;\n                            scl_tri <= 1'b0;\n                            bit_cnt <= bit_cnt - 3'd1;\n                            shift_out <= {shift_out[6:0], 1'b0};\n                        end\n                    end\n                end\n\n                S_ACK: begin\n                    // Wait for ACK from slave\n                    if (timer_done) begin\n                        ack_received <= ~sda_i; // ACK is SDA low\n                        if (sda_i) begin\n                            ack_missed <= 1'b1;\n                        end\n                        state <= S_DONE;\n                        scl_out <= 1'b1;\n                        sda_out <= 1'b1;\n                        scl_tri <= 1'b1;\n                        sda_tri <= 1'b1;\n                    end\n                end\n\n                S_RECV_BIT: begin\n                    // Receive one bit\n                    if (timer_done) begin\n                        if (bit_cnt == 3'd0) begin\n                            // All bits received, send ACK/NACK\n                            state <= S_ACK;\n                            bit_cnt <= 3'd0;\n                            scl_out <= 1'b1;\n                            sda_out <= 1'b0; // ACK\n                            scl_tri <= 1'b0;\n                            sda_tri <= 1'b0;\n                        end else begin\n                            // Sample SDA\n                            shift_in <= {shift_in[6:0], sda_i};\n                            scl_out <= 1'b0;\n                            scl_tri <= 1'b0;\n                            sda_tri <= 1'b1; // Release SDA\n                            bit_cnt <= bit_cnt - 3'd1;\n                        end\n                    end\n                end\n\n                S_STOP: begin\n                    // STOP: SCL low, SDA low -> SCL high, SDA high\n                    if (timer_done) begin\n                        sda_out <= 1'b1;\n                        state <= S_DONE;\n                        scl_out <= 1'b1;\n                        sda_out <= 1'b1;\n                        scl_tri <= 1'b1;\n                        sda_tri <= 1'b1;\n                    end\n                end\n\n                S_DONE: begin\n                    scl_out <= 1'b1;\n                    sda_out <= 1'b1;\n                    scl_tri <= 1'b1;\n                    sda_tri <= 1'b1;\n                    data_valid <= 1'b0;\n                    data_last <= 1'b0;\n                    \n                    if (timer_done) begin\n                        state <= S_IDLE;\n                    end\n                end\n\n                default: begin\n                    state <= S_IDLE;\n                end\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>",
