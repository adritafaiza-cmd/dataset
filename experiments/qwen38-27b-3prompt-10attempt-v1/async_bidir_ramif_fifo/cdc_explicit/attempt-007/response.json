  "text": "```verilog\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam PTR_W = ASIZE + 1;\n  localparam AFULL_MARGIN = DEPTH/4;\n  localparam AEMPTY_MARGIN = DEPTH/4;\n\n  // Side A registers\n  reg [PTR_W-1:0] a_wr_ptr;\n  reg [PTR_W-1:0] a_rd_ptr;\n  reg [PTR_W-1:0] a_wr_ptr_gray;\n  reg [PTR_W-1:0] a_rd_ptr_gray;\n  reg [PTR_W-1:0] a_wr_ptr_gray_sync;\n  reg [PTR_W-1:0] a_rd_ptr_gray_sync;\n  reg [PTR_W-1:0] a_wr_ptr_gray_sync2;\n  reg [PTR_W-1:0] a_rd_ptr_gray_sync2;\n\n  // Side B registers\n  reg [PTR_W-1:0] b_wr_ptr;\n  reg [PTR_W-1:0] b_rd_ptr;\n  reg [PTR_W-1:0] b_wr_ptr_gray;\n  reg [PTR_W-1:0] b_rd_ptr_gray;\n  reg [PTR_W-1:0] b_wr_ptr_gray_sync;\n  reg [PTR_W-1:0] b_rd_ptr_gray_sync;\n  reg [PTR_W-1:0] b_wr_ptr_gray_sync2;\n  reg [PTR_W-1:0] b_rd_ptr_gray_sync2;\n\n  // Gray code conversion\n  function [PTR_W-1:0] bin2gray;\n    input [PTR_W-1:0] bin;\n    begin\n      bin2gray = bin ^ (bin >> 1);\n    end\n  endfunction\n\n  // Side A logic\n  wire a_wr_en = a_winc & ~a_full;\n  wire a_rd_en = a_rinc & ~a_empty;\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {PTR_W{1'b0}};\n      a_rd_ptr <= {PTR_W{1'b0}};\n      a_wr_ptr_gray <= {PTR_W{1'b0}};\n      a_rd_ptr_gray <= {PTR_W{1'b0}};\n      a_wr_ptr_gray_sync <= {PTR_W{1'b0}};\n      a_rd_ptr_gray_sync <= {PTR_W{1'b0}};\n      a_wr_ptr_gray_sync2 <= {PTR_W{1'b0}};\n      a_rd_ptr_gray_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      if (a_wr_en) begin\n        a_wr_ptr <= a_wr_ptr + 1'b1;\n        a_wr_ptr_gray <= bin2gray(a_wr_ptr + 1'b1);\n      end\n      if (a_rd_en) begin\n        a_rd_ptr <= a_rd_ptr + 1'b1;\n        a_rd_ptr_gray <= bin2gray(a_rd_ptr + 1'b1);\n      end\n      a_wr_ptr_gray_sync <= a_wr_ptr_gray;\n      a_rd_ptr_gray_sync <= a_rd_ptr_gray;\n      a_wr_ptr_gray_sync2 <= a_wr_ptr_gray_sync;\n      a_rd_ptr_gray_sync2 <= a_rd_ptr_gray_sync;\n    end\n  end\n\n  // Side B logic\n  wire b_wr_en = b_winc & ~b_full;\n  wire b_rd_en = b_rinc & ~b_empty;\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {PTR_W{1'b0}};\n      b_rd_ptr <= {PTR_W{1'b0}};\n      b_wr_ptr_gray <= {PTR_W{1'b0}};\n      b_rd_ptr_gray <= {PTR_W{1'b0}};\n      b_wr_ptr_gray_sync <= {PTR_W{1'b0}};\n      b_rd_ptr_gray_sync <= {PTR_W{1'b0}};\n      b_wr_ptr_gray_sync2 <= {PTR_W{1'b0}};\n      b_rd_ptr_gray_sync2 <= {PTR_W{1'b0}};\n    end else begin\n      if (b_wr_en) begin\n        b_wr_ptr <= b_wr_ptr + 1'b1;\n        b_wr_ptr_gray <= bin2gray(b_wr_ptr + 1'b1);\n      end\n      if (b_rd_en) begin\n        b_rd_ptr <= b_rd_ptr + 1'b1;\n        b_rd_ptr_gray <= bin2gray(b_rd_ptr + 1'b1);\n      end\n      b_wr_ptr_gray_sync <= b_wr_ptr_gray;\n      b_rd_ptr_gray_sync <= b_rd_ptr_gray;\n      b_wr_ptr_gray_sync2 <= b_wr_ptr_gray_sync;\n      b_rd_ptr_gray_sync2 <= b_rd_ptr_gray_sync;\n    end\n  end\n\n  // Full/Empty flags\n  wire a_full = (a_wr_ptr_gray_sync2 == a_rd_ptr_gray);\n  wire a_empty = (a_rd_ptr_gray_sync2 == a_wr_ptr_gray);\n  wire b_full = (b_wr_ptr_gray_sync2 == b_rd_ptr_gray);\n  wire b_empty = (b_rd_ptr_gray_sync2 == b_wr_ptr_gray);\n\n  // Almost full/empty\n  wire [PTR_W-1:0] a_wr_minus_rd = a_wr_ptr - a_rd_ptr;\n  wire [PTR_W-1:0] b_wr_minus_rd = b_wr_ptr - b_rd_ptr;\n  wire a_afull = (a_wr_minus_rd >= (DEPTH - AFULL_MARGIN));\n  wire a_aempty = (a_wr_minus_rd <= AEMPTY_MARGIN);\n  wire b_afull = (b_wr_minus_rd >= (DEPTH - AFULL_MARGIN));\n  wire b_aempty = (b_wr_minus_rd <= AEMPTY_MARGIN);\n\n  // RAM interface\n  assign o_ram_a_clk = a_clk;\n  assign o_ram_a_wdata = a_wdata;\n  assign o_ram_a_addr = a_wr_ptr[ASIZE-1:0];\n  assign o_ram_a_winc = a_wr_en;\n  assign o_ram_a_rinc = a_rd_en;\n  assign a_rdata = i_ram_a_rdata;\n\n  assign o_ram_b_clk = b_clk;\n  assign o_ram_b_wdata = b_wdata;\n  assign o_ram_b_addr = b_wr_ptr[ASIZE-1:0];\n  assign o_ram_b_winc = b_wr_en;\n  assign o_ram_b_rinc = b_rd_en;\n  assign b_rdata = i_ram_b_rdata;\n\n  assign a_full = a_full;\n  assign a_afull = a_afull;\n  assign a_empty = a_empty;\n  assign a_aempty = a_aempty;\n  assign b_full = b_full;\n  assign b_afull = b_afull;\n  assign b_empty = b_empty;\n  assign b_aempty = b_aempty;\n\nendmodule\n```<|im_end|>",
