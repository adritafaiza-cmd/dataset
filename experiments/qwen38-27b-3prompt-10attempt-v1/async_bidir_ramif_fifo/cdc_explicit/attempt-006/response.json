  "text": "```verilog\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam AWIDTH = ASIZE + 1;\n  localparam AWIDTH_M1 = ASIZE;\n\n  // A-side pointers\n  reg [AWIDTH-1:0] a_wr_ptr;\n  reg [AWIDTH-1:0] a_rd_ptr;\n\n  // B-side pointers\n  reg [AWIDTH-1:0] b_wr_ptr;\n  reg [AWIDTH-1:0] b_rd_ptr;\n\n  // Synchronized pointers\n  reg [AWIDTH-1:0] a_wr_ptr_b_sync;\n  reg [AWIDTH-1:0] a_rd_ptr_b_sync;\n  reg [AWIDTH-1:0] b_wr_ptr_a_sync;\n  reg [AWIDTH-1:0] b_rd_ptr_a_sync;\n\n  // Gray code conversion\n  function [AWIDTH-1:0] bin2gray;\n    input [AWIDTH-1:0] bin;\n    begin\n      bin2gray = bin ^ (bin >> 1);\n    end\n  endfunction\n\n  // Gray code pointers\n  wire [AWIDTH-1:0] a_wr_ptr_gray = bin2gray(a_wr_ptr);\n  wire [AWIDTH-1:0] a_rd_ptr_gray = bin2gray(a_rd_ptr);\n  wire [AWIDTH-1:0] b_wr_ptr_gray = bin2gray(b_wr_ptr);\n  wire [AWIDTH-1:0] b_rd_ptr_gray = bin2gray(b_rd_ptr);\n\n  // Synchronizers for A->B\n  reg [AWIDTH-1:0] a_wr_ptr_gray_b_sync1;\n  reg [AWIDTH-1:0] a_wr_ptr_gray_b_sync2;\n  reg [AWIDTH-1:0] a_rd_ptr_gray_b_sync1;\n  reg [AWIDTH-1:0] a_rd_ptr_gray_b_sync2;\n\n  // Synchronizers for B->A\n  reg [AWIDTH-1:0] b_wr_ptr_gray_a_sync1;\n  reg [AWIDTH-1:0] b_wr_ptr_gray_a_sync2;\n  reg [AWIDTH-1:0] b_rd_ptr_gray_a_sync1;\n  reg [AWIDTH-1:0] b_rd_ptr_gray_a_sync2;\n\n  // A clock domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {AWIDTH{1'b0}};\n      a_rd_ptr <= {AWIDTH{1'b0}};\n    end else begin\n      if (a_winc && !a_full)\n        a_wr_ptr <= a_wr_ptr + 1'b1;\n      if (a_rinc && !a_empty)\n        a_rd_ptr <= a_rd_ptr + 1'b1;\n    end\n  end\n\n  // B clock domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {AWIDTH{1'b0}};\n      b_rd_ptr <= {AWIDTH{1'b0}};\n    end else begin\n      if (b_winc && !b_full)\n        b_wr_ptr <= b_wr_ptr + 1'b1;\n      if (b_rinc && !b_empty)\n        b_rd_ptr <= b_rd_ptr + 1'b1;\n    end\n  end\n\n  // Synchronizers A->B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_gray_b_sync1 <= {AWIDTH{1'b0}};\n      a_wr_ptr_gray_b_sync2 <= {AWIDTH{1'b0}};\n      a_rd_ptr_gray_b_sync1 <= {AWIDTH{1'b0}};\n      a_rd_ptr_gray_b_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      a_wr_ptr_gray_b_sync1 <= a_wr_ptr_gray;\n      a_wr_ptr_gray_b_sync2 <= a_wr_ptr_gray_b_sync1;\n      a_rd_ptr_gray_b_sync1 <= a_rd_ptr_gray;\n      a_rd_ptr_gray_b_sync2 <= a_rd_ptr_gray_b_sync1;\n    end\n  end\n\n  // Synchronizers B->A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_gray_a_sync1 <= {AWIDTH{1'b0}};\n      b_wr_ptr_gray_a_sync2 <= {AWIDTH{1'b0}};\n      b_rd_ptr_gray_a_sync1 <= {AWIDTH{1'b0}};\n      b_rd_ptr_gray_a_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      b_wr_ptr_gray_a_sync1 <= b_wr_ptr_gray;\n      b_wr_ptr_gray_a_sync2 <= b_wr_ptr_gray_a_sync1;\n      b_rd_ptr_gray_a_sync1 <= b_rd_ptr_gray;\n      b_rd_ptr_gray_a_sync2 <= b_rd_ptr_gray_a_sync1;\n    end\n  end\n\n  // Convert synchronized gray to binary\n  function [AWIDTH-1:0] gray2bin;\n    input [AWIDTH-1:0] gray;\n    integer i;\n    begin\n      gray2bin[AWIDTH-1] = gray[AWIDTH-1];\n      for (i = AWIDTH-2; i >= 0; i = i - 1)\n        gray2bin[i] = gray2bin[i+1] ^ gray[i];\n    end\n  endfunction\n\n  wire [AWIDTH-1:0] a_wr_ptr_b_sync = gray2bin(a_wr_ptr_gray_b_sync2);\n  wire [AWIDTH-1:0] a_rd_ptr_b_sync = gray2bin(a_rd_ptr_gray_b_sync2);\n  wire [AWIDTH-1:0] b_wr_ptr_a_sync = gray2bin(b_wr_ptr_gray_a_sync2);\n  wire [AWIDTH-1:0] b_rd_ptr_a_sync = gray2bin(b_rd_ptr_gray_a_sync2);\n\n  // Full/Empty flags\n  // A side: full when a_wr_ptr == a_rd_ptr_b_sync + DEPTH (i.e., upper bits differ, lower bits same)\n  // Empty when a_rd_ptr == a_wr_ptr_a_sync (i.e., a_rd_ptr == b_rd_ptr_a_sync? No.)\n  \n  // For A side:\n  // a_full: A is full when the write pointer has lapped the read pointer.\n  // a_wr_ptr and a_rd_ptr are in A domain. The read pointer seen by A is b_rd_ptr_a_sync (B's read pointer synchronized to A).\n  // Wait, this is a bidirectional FIFO. Let me reconsider.\n  \n  // In a bidirectional FIFO with external RAM:\n  // - A writes to RAM port A, B reads from RAM port B (or vice versa depending on direction)\n  // - Actually, looking at the ports: a_winc writes, a_rinc reads. b_winc writes, b_rinc reads.\n  // - The FIFO is bidirectional: data can flow A->B or B->A.\n  // - a_dir and b_dir control direction.\n  \n  // Let me reconsider the architecture. This is a bidirectional FIFO where:\n  // - When a_dir=1, A writes and B reads (A->B direction)\n  // - When b_dir=1, B writes and A reads (B->A direction)\n  // - The RAM is dual-port: port A and port B\n  // - Each side has its own write and read pointers\n  \n  // Actually, for a bidirectional async FIFO with external RAM:\n  // - A side: a_winc writes to RAM port A, a_rinc reads from RAM port A\n  // - B side: b_winc writes to RAM port B, b_rinc reads from RAM port B\n  // - The FIFO logic manages pointers to track occupancy\n  \n  // Let me think about this more carefully. The key insight is:\n  // - A writes to RAM port A at address a_wr_ptr[ASIZE-1:0]\n  // - B reads from RAM port B at address b_rd_ptr[ASIZE-1:0]\n  // - For A->B direction: A writes, B reads\n  // - For B->A direction: B writes, A reads\n  \n  // The full/empty flags need to account for the direction.\n  \n  // Let me simplify: treat it as two independent FIFOs sharing the same RAM, with direction control.\n  \n  // A->B FIFO:\n  // - Write pointer: a_wr_ptr (A domain)\n  // - Read pointer: b_rd_ptr (B domain)\n  // - a_full: a_wr_ptr has lapped b_rd_ptr_a_sync\n  // - b_empty: b_rd_ptr == b_wr_ptr_a_sync? No, b_empty should be based on B's view.\n  \n  // Actually, let me reconsider. The standard approach for bidirectional FIFO:\n  // - a_full: A cannot write because FIFO is full (in A->B direction)\n  // - a_empty: A cannot read because FIFO is empty (in B->A direction)\n  // - b_full: B cannot write because FIFO is full (in B->A direction)\n  // - b_empty: B cannot read because FIFO is empty (in A->B direction)\n  \n  // For A->B direction:\n  // - A writes, B reads\n  // - a_full: a_wr_ptr - b_rd_ptr_a_sync == DEPTH\n  // - b_empty: b_rd_ptr == b_wr_ptr_a_sync (but b_wr_ptr is B's write pointer, which is for B->A)\n  \n  // I think the cleanest approach is:\n  // - A->B: write ptr = a_wr_ptr, read ptr = b_rd_ptr\n  // - B->A: write ptr = b_wr_ptr, read ptr = a_rd_ptr\n  \n  // a_full (A->B full): a_wr_ptr has lapped b_rd_ptr_a_sync\n  // a_empty (B->A empty): a_rd_ptr == b_wr_ptr_a_sync\n  // b_full (B->A full): b_wr_ptr has lapped a_rd_ptr_b_sync\n  // b_empty (A->B empty): b_rd_ptr == a_wr_ptr_b_sync\n\n  wire a_full = (a_wr_ptr[AWIDTH-1] != b_rd_ptr_a_sync[AWIDTH-1]) && \n                (a_wr_ptr[AWIDTH-2:0] == b_rd_ptr_a_sync[AWIDTH-2:0]);\n  wire a_empty = (a_rd_ptr == b_wr_ptr_a_sync);\n  wire b_full = (b_wr_ptr[AWIDTH-1] != a_rd_ptr_b_sync[AWIDTH-1]) && \n                (b_wr_ptr[AWIDTH-2:0] == a_rd_ptr_b_sync[AWIDTH-2:0]);\n  wire b_empty = (b_rd_ptr == a_wr_ptr_b_sync);\n\n  // Almost full/empty (1 entry margin)\n  wire a_afull = (a_wr_ptr[AWIDTH-1] != b_rd_ptr_a_sync[AWIDTH-1]) && \n                 (a_wr_ptr[AWIDTH-2:0] == b_rd_ptr_a_sync[AWIDTH-2:0] - 1'b1);\n  wire a_aempty = (a_rd_ptr == b_wr_ptr_a_sync - 1'b1);\n  wire b_afull = (b_wr_ptr[AWIDTH-1] != a_rd_ptr_b_sync[AWIDTH-1]) && \n                 (b_wr_ptr[AWIDTH-2:0] == a_rd_ptr_b_sync[AWIDTH-2:0] - 1'b1);\n  wire b_aempty = (b_rd_ptr == a_wr_ptr_b_sync - 1'b1);\n\n  // RAM interface\n  // A side: write when a_winc and not full, read when a_rinc and not empty\n  assign o_ram_a_clk = a_clk;\n  assign o_ram_a_wdata = a_wdata;\n  assign o_ram_a_addr = a_wr_ptr[ASIZE-1:0];\n  assign o_ram_a_winc = a_winc && !a_full;\n  assign o_ram_a_rinc = a_rinc && !a_empty;\n\n  // B side: write when b_winc and not full, read when b_rinc and not empty\n  assign o_ram_b_clk = b_clk;\n  assign o_ram_b_wdata = b_wdata;\n  assign o_ram_b_addr = b_wr_ptr[ASIZE-1:0];\n  assign o_ram_b_winc = b_winc && !b_full;\n  assign o_ram_b_rinc = b_rinc && !b_empty;\n\n  // Read data\n  assign a_rdata = i_ram_a_rdata;\n  assign b_rdata = i_ram_b_rdata;\n\n  // Flags\n  assign a_full = a_full;\n  assign a_afull = a_afull;\n  assign a_empty = a_empty;\n  assign a_aempty = a_aempty;\n  assign b_full = b_full;\n  assign b_afull = b_afull;\n  assign b_empty = b_empty;\n  assign b_aempty = b_aempty;\n\nendmodule\n```<|im_end|>",
