  "text": "```verilog\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam AFULL_OFFSET = 2;\n  localparam AEMPTY_OFFSET = 1;\n\n  // Side A: write pointer (A writes to RAM A)\n  reg [ASIZE:0] a_wr_ptr;\n  // Side A: read pointer (A reads from RAM B)\n  reg [ASIZE:0] a_rd_ptr;\n\n  // Side B: write pointer (B writes to RAM B)\n  reg [ASIZE:0] b_wr_ptr;\n  // Side B: read pointer (B reads from RAM A)\n  reg [ASIZE:0] b_rd_ptr;\n\n  // Gray code pointers for CDC\n  wire [ASIZE:0] a_wr_ptr_gray;\n  wire [ASIZE:0] a_rd_ptr_gray;\n  wire [ASIZE:0] b_wr_ptr_gray;\n  wire [ASIZE:0] b_rd_ptr_gray;\n\n  // Synchronizers\n  reg [ASIZE:0] a_wr_ptr_gray_sync1, a_wr_ptr_gray_sync2;\n  reg [ASIZE:0] a_rd_ptr_gray_sync1, a_rd_ptr_gray_sync2;\n  reg [ASIZE:0] b_wr_ptr_gray_sync1, b_wr_ptr_gray_sync2;\n  reg [ASIZE:0] b_rd_ptr_gray_sync1, b_rd_ptr_gray_sync2;\n\n  // Binary pointers synchronized to opposite side\n  reg [ASIZE:0] a_wr_ptr_bin_sync;\n  reg [ASIZE:0] a_rd_ptr_bin_sync;\n  reg [ASIZE:0] b_wr_ptr_bin_sync;\n  reg [ASIZE:0] b_rd_ptr_bin_sync;\n\n  // Gray code conversion\n  assign a_wr_ptr_gray = a_wr_ptr ^ (a_wr_ptr >> 1);\n  assign a_rd_ptr_gray = a_rd_ptr ^ (a_rd_ptr >> 1);\n  assign b_wr_ptr_gray = b_wr_ptr ^ (b_wr_ptr >> 1);\n  assign b_rd_ptr_gray = b_rd_ptr ^ (b_rd_ptr >> 1);\n\n  // Synchronizer for A write pointer to B side\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_gray_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      a_wr_ptr_gray_sync2 <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      a_wr_ptr_gray_sync1 <= a_wr_ptr_gray;\n      a_wr_ptr_gray_sync2 <= a_wr_ptr_gray_sync1;\n    end\n  end\n\n  // Synchronizer for A read pointer to B side\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_rd_ptr_gray_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      a_rd_ptr_gray_sync2 <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      a_rd_ptr_gray_sync1 <= a_rd_ptr_gray;\n      a_rd_ptr_gray_sync2 <= a_rd_ptr_gray_sync1;\n    end\n  end\n\n  // Synchronizer for B write pointer to A side\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_gray_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      b_wr_ptr_gray_sync2 <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      b_wr_ptr_gray_sync1 <= b_wr_ptr_gray;\n      b_wr_ptr_gray_sync2 <= b_wr_ptr_gray_sync1;\n    end\n  end\n\n  // Synchronizer for B read pointer to A side\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_rd_ptr_gray_sync1 <= {1'b0, {ASIZE{1'b0}}};\n      b_rd_ptr_gray_sync2 <= {1'b0, {ASIZE{1'b0}}};\n    end else begin\n      b_rd_ptr_gray_sync1 <= b_rd_ptr_gray;\n      b_rd_ptr_gray_sync2 <= b_rd_ptr_gray_sync1;\n    end\n  end\n\n  // Gray to binary conversion\n  function [ASIZE:0] gray_to_bin;\n    input [ASIZE:0] gray;\n    integer i;\n    begin\n      gray_to_bin[ASIZE] = gray[ASIZE];\n      for (i = ASIZE-1; i >= 0; i = i - 1)\n        gray_to_bin[i] = gray_to_bin[i+1] ^ gray[i];\n    end\n  endfunction\n\n  // Synchronized binary pointers\n  assign a_wr_ptr_bin_sync = gray_to_bin(a_wr_ptr_gray_sync2);\n  assign a_rd_ptr_bin_sync = gray_to_bin(a_rd_ptr_gray_sync2);\n  assign b_wr_ptr_bin_sync = gray_to_bin(b_wr_ptr_gray_sync2);\n  assign b_rd_ptr_bin_sync = gray_to_bin(b_rd_ptr_gray_sync2);\n\n  // Direction logic:\n  // a_dir = 1: A writes to RAM A, B reads from RAM A\n  // a_dir = 0: A reads from RAM A, B writes to RAM A\n  // b_dir = 1: B writes to RAM B, A reads from RAM B\n  // b_dir = 0: B reads from RAM B, A writes to RAM B\n\n  // RAM A interface\n  // Write to RAM A: from A if a_dir=1, from B if b_dir=0\n  wire a_winc_ram_a = a_winc & a_dir;\n  wire b_winc_ram_a = b_winc & ~b_dir;\n\n  // Read from RAM A: from A if a_dir=0, from B if b_dir=1\n  wire a_rinc_ram_a = a_rinc & ~a_dir;\n  wire b_rinc_ram_a = b_rinc & b_dir;\n\n  // RAM B interface\n  // Write to RAM B: from B if b_dir=1, from A if a_dir=0\n  wire b_winc_ram_b = b_winc & b_dir;\n  wire a_winc_ram_b = a_winc & ~a_dir;\n\n  // Read from RAM B: from B if b_dir=0, from A if a_dir=1\n  wire b_rinc_ram_b = b_rinc & ~b_dir;\n  wire a_rinc_ram_b = a_rinc & a_dir;\n\n  // RAM A clock and address\n  assign o_ram_a_clk = a_clk;\n  assign o_ram_a_wdata = a_dir ? a_wdata : b_wdata;\n  assign o_ram_a_addr = a_dir ? a_wr_ptr[ASIZE-1:0] : b_wr_ptr[ASIZE-1:0];\n  assign o_ram_a_winc = a_winc_ram_a | b_winc_ram_a;\n  assign o_ram_a_rinc = a_rinc_ram_a | b_rinc_ram_a;\n\n  // RAM B clock and address\n  assign o_ram_b_clk = b_clk;\n  assign o_ram_b_wdata = b_dir ? b_wdata : a_wdata;\n  assign o_ram_b_addr = b_dir ? b_wr_ptr[ASIZE-1:0] : a_wr_ptr[ASIZE-1:0];\n  assign o_ram_b_winc = b_winc_ram_b | a_winc_ram_b;\n  assign o_ram_b_rinc = b_rinc_ram_b | a_rinc_ram_b;\n\n  // Read data routing\n  // A reads from RAM B if a_dir=1, from RAM A if a_dir=0\n  assign a_rdata = a_dir ? i_ram_b_rdata : i_ram_a_rdata;\n  // B reads from RAM A if b_dir=1, from RAM B if b_dir=0\n  assign b_rdata = b_dir ? i_ram_a_rdata : i_ram_b_rdata;\n\n  // Pointer updates\n  // A write pointer increments when A writes\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_wr_ptr <= {1'b0, {ASIZE{1'b0}}};\n    else if (a_winc)\n      a_wr_ptr <= a_wr_ptr + 1'b1;\n  end\n\n  // A read pointer increments when A reads\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_rd_ptr <= {1'b0, {ASIZE{1'b0}}};\n    else if (a_rinc)\n      a_rd_ptr <= a_rd_ptr + 1'b1;\n  end\n\n  // B write pointer increments when B writes\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_wr_ptr <= {1'b0, {ASIZE{1'b0}}};\n    else if (b_winc)\n      b_wr_ptr <= b_wr_ptr + 1'b1;\n  end\n\n  // B read pointer increments when B reads\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_rd_ptr <= {1'b0, {ASIZE{1'b0}}};\n    else if (b_rinc)\n      b_rd_ptr <= b_rd_ptr + 1'b1;\n  end\n\n  // Full/Empty flags\n  // A full: A's write pointer is ahead of B's read pointer by DEPTH\n  // A empty: A's read pointer equals B's write pointer\n  // B full: B's write pointer is ahead of A's read pointer by DEPTH\n  // B empty: B's read pointer equals A's write pointer\n\n  wire a_full_internal = (a_wr_ptr[ASIZE] != b_rd_ptr_bin_sync[ASIZE]) && \n                         (a_wr_ptr[ASIZE-1:0] == b_rd_ptr_bin_sync[ASIZE-1:0]);\n  wire a_empty_internal = (a_rd_ptr == b_wr_ptr_bin_sync);\n  wire b_full_internal = (b_wr_ptr[ASIZE] != a_rd_ptr_bin_sync[ASIZE]) && \n                         (b_wr_ptr[ASIZE-1:0] == a_rd_ptr_bin_sync[ASIZE-1:0]);\n  wire b_empty_internal = (b_rd_ptr == a_wr_ptr_bin_sync);\n\n  // Almost full/empty\n  wire a_afull_internal = (a_wr_ptr[ASIZE] != b_rd_ptr_bin_sync[ASIZE]) && \n                          (a_wr_ptr[ASIZE-1:0] == b_rd_ptr_bin_sync[ASIZE-1:0] + AFULL_OFFSET[ASIZE-1:0]);\n  wire a_aempty_internal = (a_rd_ptr == b_wr_ptr_bin_sync + AEMPTY_OFFSET[ASIZE-1:0]);\n  wire b_afull_internal = (b_wr_ptr[ASIZE] != a_rd_ptr_bin_sync[ASIZE]) && \n                          (b_wr_ptr[ASIZE-1:0] == a_rd_ptr_bin_sync[ASIZE-1:0] + AFULL_OFFSET[ASIZE-1:0]);\n  wire b_aempty_internal = (b_rd_ptr == a_wr_ptr_bin_sync + AEMPTY_OFFSET[ASIZE-1:0]);\n\n  assign a_full = a_full_internal;\n  assign a_afull = a_afull_internal;\n  assign a_empty = a_empty_internal;\n  assign a_aempty = a_aempty_internal;\n  assign b_full = b_full_internal;\n  assign b_afull = b_afull_internal;\n  assign b_empty = b_empty_internal;\n  assign b_aempty = b_aempty_internal;\n\nendmodule\n```<|im_end|>",
