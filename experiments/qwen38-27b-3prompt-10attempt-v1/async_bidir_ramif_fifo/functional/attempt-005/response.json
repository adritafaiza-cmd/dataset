  "text": "```verilog\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  localparam DEPTH = 1 << ASIZE;\n  localparam AWIDTH = ASIZE + 1;\n  localparam AFULL_THRESH = DEPTH - 1;\n  localparam AEMPTY_THRESH = 1;\n\n  // Side A state\n  reg [AWIDTH-1:0] a_wr_ptr;\n  reg [AWIDTH-1:0] a_rd_ptr;\n  reg [AWIDTH-1:0] a_wr_ptr_gray;\n  reg [AWIDTH-1:0] a_rd_ptr_gray;\n  reg [AWIDTH-1:0] a_wr_ptr_gray_sync1;\n  reg [AWIDTH-1:0] a_wr_ptr_gray_sync2;\n  reg [AWIDTH-1:0] a_rd_ptr_gray_sync1;\n  reg [AWIDTH-1:0] a_rd_ptr_gray_sync2;\n\n  // Side B state\n  reg [AWIDTH-1:0] b_wr_ptr;\n  reg [AWIDTH-1:0] b_rd_ptr;\n  reg [AWIDTH-1:0] b_wr_ptr_gray;\n  reg [AWIDTH-1:0] b_rd_ptr_gray;\n  reg [AWIDTH-1:0] b_wr_ptr_gray_sync1;\n  reg [AWIDTH-1:0] b_wr_ptr_gray_sync2;\n  reg [AWIDTH-1:0] b_rd_ptr_gray_sync1;\n  reg [AWIDTH-1:0] b_rd_ptr_gray_sync2;\n\n  // Gray code conversion\n  function [AWIDTH-1:0] bin2gray;\n    input [AWIDTH-1:0] bin;\n    begin\n      bin2gray = bin ^ (bin >> 1);\n    end\n  endfunction\n\n  // Side A: write pointer update\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {AWIDTH{1'b0}};\n      a_wr_ptr_gray <= {AWIDTH{1'b0}};\n    end else if (a_winc && !a_full) begin\n      a_wr_ptr <= a_wr_ptr + 1'b1;\n      a_wr_ptr_gray <= bin2gray(a_wr_ptr + 1'b1);\n    end\n  end\n\n  // Side A: read pointer update\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_rd_ptr <= {AWIDTH{1'b0}};\n      a_rd_ptr_gray <= {AWIDTH{1'b0}};\n    end else if (a_rinc && !a_empty) begin\n      a_rd_ptr <= a_rd_ptr + 1'b1;\n      a_rd_ptr_gray <= bin2gray(a_rd_ptr + 1'b1);\n    end\n  end\n\n  // Side A: sync B's write pointer gray into A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr_gray_sync1 <= {AWIDTH{1'b0}};\n      a_wr_ptr_gray_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      a_wr_ptr_gray_sync1 <= b_wr_ptr_gray;\n      a_wr_ptr_gray_sync2 <= a_wr_ptr_gray_sync1;\n    end\n  end\n\n  // Side A: sync B's read pointer gray into A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_rd_ptr_gray_sync1 <= {AWIDTH{1'b0}};\n      a_rd_ptr_gray_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      a_rd_ptr_gray_sync1 <= b_rd_ptr_gray;\n      a_rd_ptr_gray_sync2 <= a_rd_ptr_gray_sync1;\n    end\n  end\n\n  // Side A: full/empty flags\n  wire a_full_raw = (a_wr_ptr_gray == a_rd_ptr_gray_sync2) && (a_wr_ptr[ASIZE] != a_rd_ptr_gray_sync2[ASIZE]);\n  wire a_empty_raw = (a_rd_ptr_gray == a_wr_ptr_gray_sync2);\n\n  assign a_full = a_full_raw;\n  assign a_empty = a_empty_raw;\n  assign a_afull = (a_wr_ptr_gray == a_rd_ptr_gray_sync2) && (a_wr_ptr[ASIZE] != a_rd_ptr_gray_sync2[ASIZE]) || \n                   (a_wr_ptr_gray == a_rd_ptr_gray_sync2) && (a_wr_ptr[ASIZE] == a_rd_ptr_gray_sync2[ASIZE]) && \n                   (a_wr_ptr[ASIZE-1:0] - a_rd_ptr_gray_sync2[ASIZE-1:0] >= AFULL_THRESH[ASIZE-1:0]);\n  assign a_aempty = (a_rd_ptr_gray == a_wr_ptr_gray_sync2) || \n                    (a_rd_ptr_gray == a_wr_ptr_gray_sync2) && \n                    (a_wr_ptr_gray_sync2[ASIZE-1:0] - a_rd_ptr_gray[ASIZE-1:0] <= AEMPTY_THRESH[ASIZE-1:0]);\n\n  // Side B: write pointer update\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {AWIDTH{1'b0}};\n      b_wr_ptr_gray <= {AWIDTH{1'b0}};\n    end else if (b_winc && !b_full) begin\n      b_wr_ptr <= b_wr_ptr + 1'b1;\n      b_wr_ptr_gray <= bin2gray(b_wr_ptr + 1'b1);\n    end\n  end\n\n  // Side B: read pointer update\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_rd_ptr <= {AWIDTH{1'b0}};\n      b_rd_ptr_gray <= {AWIDTH{1'b0}};\n    end else if (b_rinc && !b_empty) begin\n      b_rd_ptr <= b_rd_ptr + 1'b1;\n      b_rd_ptr_gray <= bin2gray(b_rd_ptr + 1'b1);\n    end\n  end\n\n  // Side B: sync A's write pointer gray into B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr_gray_sync1 <= {AWIDTH{1'b0}};\n      b_wr_ptr_gray_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      b_wr_ptr_gray_sync1 <= a_wr_ptr_gray;\n      b_wr_ptr_gray_sync2 <= b_wr_ptr_gray_sync1;\n    end\n  end\n\n  // Side B: sync A's read pointer gray into B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_rd_ptr_gray_sync1 <= {AWIDTH{1'b0}};\n      b_rd_ptr_gray_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      b_rd_ptr_gray_sync1 <= a_rd_ptr_gray;\n      b_rd_ptr_gray_sync2 <= b_rd_ptr_gray_sync1;\n    end\n  end\n\n  // Side B: full/empty flags\n  wire b_full_raw = (b_wr_ptr_gray == b_rd_ptr_gray_sync2) && (b_wr_ptr[ASIZE] != b_rd_ptr_gray_sync2[ASIZE]);\n  wire b_empty_raw = (b_rd_ptr_gray == b_wr_ptr_gray_sync2);\n\n  assign b_full = b_full_raw;\n  assign b_empty = b_empty_raw;\n  assign b_afull = (b_wr_ptr_gray == b_rd_ptr_gray_sync2) && (b_wr_ptr[ASIZE] != b_rd_ptr_gray_sync2[ASIZE]) || \n                   (b_wr_ptr_gray == b_rd_ptr_gray_sync2) && (b_wr_ptr[ASIZE] == b_rd_ptr_gray_sync2[ASIZE]) && \n                   (b_wr_ptr[ASIZE-1:0] - b_rd_ptr_gray_sync2[ASIZE-1:0] >= AFULL_THRESH[ASIZE-1:0]);\n  assign b_aempty = (b_rd_ptr_gray == b_wr_ptr_gray_sync2) || \n                    (b_rd_ptr_gray == b_wr_ptr_gray_sync2) && \n                    (b_wr_ptr_gray_sync2[ASIZE-1:0] - b_rd_ptr_gray[ASIZE-1:0] <= AEMPTY_THRESH[ASIZE-1:0]);\n\n  // RAM interface\n  assign o_ram_a_clk = a_clk;\n  assign o_ram_a_addr = a_wr_ptr[ASIZE-1:0];\n  assign o_ram_a_wdata = a_wdata;\n  assign o_ram_a_winc = a_winc && !a_full;\n  assign o_ram_a_rinc = a_rinc && !a_empty;\n  assign a_rdata = i_ram_a_rdata;\n\n  assign o_ram_b_clk = b_clk;\n  assign o_ram_b_addr = b_wr_ptr[ASIZE-1:0];\n  assign o_ram_b_wdata = b_wdata;\n  assign o_ram_b_winc = b_winc && !b_full;\n  assign o_ram_b_rinc = b_rinc && !b_empty;\n  assign b_rdata = i_ram_b_rdata;\n\nendmodule\n```<|im_end|>",
