  "text": "```verilog\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  localparam AWIDTH = ASIZE + 1;\n  localparam DEPTH  = 1 << ASIZE;\n  localparam AFULL_OFFSET = 2;\n  localparam AEMPTY_OFFSET = 1;\n\n  // A-side state\n  reg [AWIDTH-1:0] a_wr_ptr;\n  reg [AWIDTH-1:0] a_rd_ptr;\n  reg [AWIDTH-1:0] b_wr_ptr_a;\n  reg [AWIDTH-1:0] b_rd_ptr_a;\n\n  // B-side state\n  reg [AWIDTH-1:0] b_wr_ptr;\n  reg [AWIDTH-1:0] b_rd_ptr;\n  reg [AWIDTH-1:0] a_wr_ptr_b;\n  reg [AWIDTH-1:0] a_rd_ptr_b;\n\n  // CDC synchronizers\n  reg [AWIDTH-1:0] a_wr_ptr_b_sync1, a_wr_ptr_b_sync2;\n  reg [AWIDTH-1:0] a_rd_ptr_b_sync1, a_rd_ptr_b_sync2;\n  reg [AWIDTH-1:0] b_wr_ptr_a_sync1, b_wr_ptr_a_sync2;\n  reg [AWIDTH-1:0] b_rd_ptr_a_sync1, b_rd_ptr_a_sync2;\n\n  // Direction sync\n  reg a_dir_b_sync1, a_dir_b_sync2;\n  reg b_dir_a_sync1, b_dir_a_sync2;\n\n  // A-side status\n  wire a_full   = (a_wr_ptr == b_rd_ptr_a);\n  wire a_empty  = (a_rd_ptr == b_wr_ptr_a);\n  wire a_afull  = (a_wr_ptr[AWIDTH-1:1] == b_rd_ptr_a[AWIDTH-1:1]) &&\n                  (a_wr_ptr[0] != b_rd_ptr_a[0]) &&\n                  (a_wr_ptr[0] == 1'b1);\n  wire a_aempty = (a_rd_ptr[AWIDTH-1:1] == b_wr_ptr_a[AWIDTH-1:1]) &&\n                  (a_rd_ptr[0] != b_wr_ptr_a[0]) &&\n                  (a_rd_ptr[0] == 1'b0);\n\n  // B-side status\n  wire b_full   = (b_wr_ptr == a_rd_ptr_b);\n  wire b_empty  = (b_rd_ptr == a_wr_ptr_b);\n  wire b_afull  = (b_wr_ptr[AWIDTH-1:1] == a_rd_ptr_b[AWIDTH-1:1]) &&\n                  (b_wr_ptr[0] != a_rd_ptr_b[0]) &&\n                  (b_wr_ptr[0] == 1'b1);\n  wire b_aempty = (b_rd_ptr[AWIDTH-1:1] == a_wr_ptr_b[AWIDTH-1:1]) &&\n                  (b_rd_ptr[0] != b_wr_ptr_b[0]) &&\n                  (b_rd_ptr[0] == 1'b0);\n\n  // A-side RAM control\n  wire a_ram_wen = a_winc && !a_full;\n  wire a_ram_ren = a_rinc && !a_empty;\n  wire a_ram_fallthrough = (FALLTHROUGH == \"TRUE\") && a_winc && a_rinc && !a_full && !a_empty;\n\n  // B-side RAM control\n  wire b_ram_wen = b_winc && !b_full;\n  wire b_ram_ren = b_rinc && !b_empty;\n  wire b_ram_fallthrough = (FALLTHROUGH == \"TRUE\") && b_winc && b_rinc && !b_full && !b_empty;\n\n  // A-side RAM outputs\n  assign o_ram_a_clk   = a_clk;\n  assign o_ram_a_wdata = a_wdata;\n  assign o_ram_a_addr  = a_wr_ptr[ASIZE-1:0];\n  assign o_ram_a_winc  = a_ram_wen;\n  assign o_ram_a_rinc  = a_ram_ren;\n\n  // B-side RAM outputs\n  assign o_ram_b_clk   = b_clk;\n  assign o_ram_b_wdata = b_wdata;\n  assign o_ram_b_addr  = b_wr_ptr[ASIZE-1:0];\n  assign o_ram_b_winc  = b_ram_wen;\n  assign o_ram_b_rinc  = b_ram_ren;\n\n  // A-side read data\n  assign a_rdata = a_ram_fallthrough ? a_wdata : i_ram_a_rdata;\n\n  // B-side read data\n  assign b_rdata = b_ram_fallthrough ? b_wdata : i_ram_b_rdata;\n\n  // A-side pointer updates\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {AWIDTH{1'b0}};\n      a_rd_ptr <= {AWIDTH{1'b0}};\n      b_wr_ptr_a <= {AWIDTH{1'b0}};\n      b_rd_ptr_a <= {AWIDTH{1'b0}};\n    end else begin\n      if (a_ram_wen)\n        a_wr_ptr <= a_wr_ptr + 1'b1;\n      if (a_ram_ren)\n        a_rd_ptr <= a_rd_ptr + 1'b1;\n      b_wr_ptr_a <= b_wr_ptr_a_sync2;\n      b_rd_ptr_a <= b_rd_ptr_a_sync2;\n    end\n  end\n\n  // B-side pointer updates\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {AWIDTH{1'b0}};\n      b_rd_ptr <= {AWIDTH{1'b0}};\n      a_wr_ptr_b <= {AWIDTH{1'b0}};\n      a_rd_ptr_b <= {AWIDTH{1'b0}};\n    end else begin\n      if (b_ram_wen)\n        b_wr_ptr <= b_wr_ptr + 1'b1;\n      if (b_ram_ren)\n        b_rd_ptr <= b_rd_ptr + 1'b1;\n      a_wr_ptr_b <= a_wr_ptr_b_sync2;\n      a_rd_ptr_b <= a_rd_ptr_b_sync2;\n    end\n  end\n\n  // CDC: A write pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_b_sync1 <= {AWIDTH{1'b0}};\n      a_wr_ptr_b_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      a_wr_ptr_b_sync1 <= a_wr_ptr;\n      a_wr_ptr_b_sync2 <= a_wr_ptr_b_sync1;\n    end\n  end\n\n  // CDC: A read pointer to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_rd_ptr_b_sync1 <= {AWIDTH{1'b0}};\n      a_rd_ptr_b_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      a_rd_ptr_b_sync1 <= a_rd_ptr;\n      a_rd_ptr_b_sync2 <= a_rd_ptr_b_sync1;\n    end\n  end\n\n  // CDC: B write pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_a_sync1 <= {AWIDTH{1'b0}};\n      b_wr_ptr_a_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      b_wr_ptr_a_sync1 <= b_wr_ptr;\n      b_wr_ptr_a_sync2 <= b_wr_ptr_a_sync1;\n    end\n  end\n\n  // CDC: B read pointer to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_rd_ptr_a_sync1 <= {AWIDTH{1'b0}};\n      b_rd_ptr_a_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      b_rd_ptr_a_sync1 <= b_rd_ptr;\n      b_rd_ptr_a_sync2 <= b_rd_ptr_a_sync1;\n    end\n  end\n\n  // CDC: A direction to B domain\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_dir_b_sync1 <= 1'b0;\n      a_dir_b_sync2 <= 1'b0;\n    end else begin\n      a_dir_b_sync1 <= a_dir;\n      a_dir_b_sync2 <= a_dir_b_sync1;\n    end\n  end\n\n  // CDC: B direction to A domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_dir_a_sync1 <= 1'b0;\n      b_dir_a_sync2 <= 1'b0;\n    end else begin\n      b_dir_a_sync1 <= b_dir;\n      b_dir_a_sync2 <= b_dir_a_sync1;\n    end\n  end\n\nendmodule\n```<|im_end|>",
