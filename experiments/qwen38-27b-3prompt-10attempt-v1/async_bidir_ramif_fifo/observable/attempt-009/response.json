  "text": "```verilog\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  localparam AWIDTH = ASIZE + 1;\n  localparam DEPTH  = 1 << ASIZE;\n  localparam AFULL_THRESH  = DEPTH - 2;\n  localparam AEMPTY_THRESH = 1;\n\n  // A-side state\n  reg [AWIDTH-1:0] a_wr_ptr;\n  reg [AWIDTH-1:0] a_rd_ptr;\n  reg [AWIDTH-1:0] a_wr_ptr_b;\n  reg [AWIDTH-1:0] a_rd_ptr_b;\n\n  // B-side state\n  reg [AWIDTH-1:0] b_wr_ptr;\n  reg [AWIDTH-1:0] b_rd_ptr;\n  reg [AWIDTH-1:0] b_wr_ptr_a;\n  reg [AWIDTH-1:0] b_rd_ptr_a;\n\n  // A-side status\n  wire a_full   = (a_wr_ptr == a_rd_ptr_b) && (a_wr_ptr[ASIZE] != a_rd_ptr_b[ASIZE]);\n  wire a_empty  = (a_wr_ptr_b == a_rd_ptr);\n  wire a_afull  = (a_wr_ptr - a_rd_ptr_b) >= AFULL_THRESH;\n  wire a_aempty = (a_wr_ptr_b - a_rd_ptr) <= AEMPTY_THRESH;\n\n  // B-side status\n  wire b_full   = (b_wr_ptr == b_rd_ptr_a) && (b_wr_ptr[ASIZE] != b_rd_ptr_a[ASIZE]);\n  wire b_empty  = (b_wr_ptr_a == b_rd_ptr);\n  wire b_afull  = (b_wr_ptr - b_rd_ptr_a) >= AFULL_THRESH;\n  wire b_aempty = (b_wr_ptr_a - b_rd_ptr) <= AEMPTY_THRESH;\n\n  // A-side RAM control\n  wire a_ram_wen = a_winc && !a_full;\n  wire a_ram_ren = a_rinc && !a_empty;\n  wire a_ram_we  = a_ram_wen;\n  wire a_ram_re  = a_ram_ren;\n\n  assign o_ram_a_clk   = a_clk;\n  assign o_ram_a_wdata = a_wdata;\n  assign o_ram_a_addr  = a_wr_ptr[ASIZE-1:0];\n  assign o_ram_a_winc  = a_ram_we;\n  assign o_ram_a_rinc  = a_ram_re;\n\n  // B-side RAM control\n  wire b_ram_wen = b_winc && !b_full;\n  wire b_ram_ren = b_rinc && !b_empty;\n  wire b_ram_we  = b_ram_wen;\n  wire b_ram_re  = b_ram_ren;\n\n  assign o_ram_b_clk   = b_clk;\n  assign o_ram_b_wdata = b_wdata;\n  assign o_ram_b_addr  = b_wr_ptr[ASIZE-1:0];\n  assign o_ram_b_winc  = b_ram_we;\n  assign o_ram_b_rinc  = b_ram_re;\n\n  // A-side read data\n  reg [DSIZE-1:0] a_rdata_reg;\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_rdata_reg <= {DSIZE{1'b0}};\n    else if (a_ram_re)\n      a_rdata_reg <= i_ram_a_rdata;\n  end\n\n  // Fall-through logic for A\n  wire a_fallthrough = (FALLTHROUGH == \"TRUE\") && a_empty && a_ram_re;\n  assign a_rdata = a_fallthrough ? a_wdata : a_rdata_reg;\n\n  // B-side read data\n  reg [DSIZE-1:0] b_rdata_reg;\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_rdata_reg <= {DSIZE{1'b0}};\n    else if (b_ram_re)\n      b_rdata_reg <= i_ram_b_rdata;\n  end\n\n  // Fall-through logic for B\n  wire b_fallthrough = (FALLTHROUGH == \"TRUE\") && b_empty && b_ram_re;\n  assign b_rdata = b_fallthrough ? b_wdata : b_rdata_reg;\n\n  // A-side pointer updates\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {AWIDTH{1'b0}};\n      a_rd_ptr <= {AWIDTH{1'b0}};\n    end else begin\n      if (a_ram_we)\n        a_wr_ptr <= a_wr_ptr + 1'b1;\n      if (a_ram_re)\n        a_rd_ptr <= a_rd_ptr + 1'b1;\n    end\n  end\n\n  // B-side pointer updates\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {AWIDTH{1'b0}};\n      b_rd_ptr <= {AWIDTH{1'b0}};\n    end else begin\n      if (b_ram_we)\n        b_wr_ptr <= b_wr_ptr + 1'b1;\n      if (b_ram_re)\n        b_rd_ptr <= b_rd_ptr + 1'b1;\n    end\n  end\n\n  // A-side pointer snapshots for B (crossing to B domain)\n  // a_wr_ptr crosses to B as a_wr_ptr_b\n  // a_rd_ptr crosses to B as a_rd_ptr_b\n  // These are used by B to determine A's full/empty status\n\n  // B-side pointer snapshots for A (crossing to A domain)\n  // b_wr_ptr crosses to A as b_wr_ptr_a\n  // b_rd_ptr crosses to A as b_rd_ptr_a\n  // These are used by A to determine B's full/empty status\n\n  // Gray code conversion for CDC\n  function [AWIDTH-1:0] bin2gray;\n    input [AWIDTH-1:0] bin;\n    begin\n      bin2gray = bin ^ (bin >> 1);\n    end\n  endfunction\n\n  function [AWIDTH-1:0] gray2bin;\n    input [AWIDTH-1:0] gray;\n    integer i;\n    begin\n      gray2bin[AWIDTH-1] = gray[AWIDTH-1];\n      for (i = AWIDTH-2; i >= 0; i = i - 1)\n        gray2bin[i] = gray2bin[i+1] ^ gray[i];\n    end\n  endfunction\n\n  // A-side: send a_wr_ptr and a_rd_ptr to B domain\n  reg [AWIDTH-1:0] a_wr_ptr_gray;\n  reg [AWIDTH-1:0] a_rd_ptr_gray;\n  reg [AWIDTH-1:0] a_wr_ptr_gray_b;\n  reg [AWIDTH-1:0] a_rd_ptr_gray_b;\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr_gray <= {AWIDTH{1'b0}};\n      a_rd_ptr_gray <= {AWIDTH{1'b0}};\n    end else begin\n      a_wr_ptr_gray <= bin2gray(a_wr_ptr);\n      a_rd_ptr_gray <= bin2gray(a_rd_ptr);\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_gray_b <= {AWIDTH{1'b0}};\n      a_rd_ptr_gray_b <= {AWIDTH{1'b0}};\n    end else begin\n      a_wr_ptr_gray_b <= a_wr_ptr_gray;\n      a_rd_ptr_gray_b <= a_rd_ptr_gray;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_b <= {AWIDTH{1'b0}};\n      a_rd_ptr_b <= {AWIDTH{1'b0}};\n    end else begin\n      a_wr_ptr_b <= gray2bin(a_wr_ptr_gray_b);\n      a_rd_ptr_b <= gray2bin(a_rd_ptr_gray_b);\n    end\n  end\n\n  // B-side: send b_wr_ptr and b_rd_ptr to A domain\n  reg [AWIDTH-1:0] b_wr_ptr_gray;\n  reg [AWIDTH-1:0] b_rd_ptr_gray;\n  reg [AWIDTH-1:0] b_wr_ptr_gray_a;\n  reg [AWIDTH-1:0] b_rd_ptr_gray_a;\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr_gray <= {AWIDTH{1'b0}};\n      b_rd_ptr_gray <= {AWIDTH{1'b0}};\n    end else begin\n      b_wr_ptr_gray <= bin2gray(b_wr_ptr);\n      b_rd_ptr_gray <= bin2gray(b_rd_ptr);\n    end\n  end\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_gray_a <= {AWIDTH{1'b0}};\n      b_rd_ptr_gray_a <= {AWIDTH{1'b0}};\n    end else begin\n      b_wr_ptr_gray_a <= b_wr_ptr_gray;\n      b_rd_ptr_gray_a <= b_rd_ptr_gray;\n    end\n  end\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_a <= {AWIDTH{1'b0}};\n      b_rd_ptr_a <= {AWIDTH{1'b0}};\n    end else begin\n      b_wr_ptr_a <= gray2bin(b_wr_ptr_gray_a);\n      b_rd_ptr_a <= gray2bin(b_rd_ptr_gray_a);\n    end\n  end\n\nendmodule\n```<|im_end|>",
