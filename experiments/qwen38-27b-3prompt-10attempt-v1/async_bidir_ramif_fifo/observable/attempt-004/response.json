  "text": "```verilog\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  localparam AWIDTH = ASIZE + 1;\n  localparam DEPTH  = 1 << ASIZE;\n\n  // ---------------------------------------------------------------------------\n  // Side A logic (clocked by a_clk)\n  // ---------------------------------------------------------------------------\n\n  reg [AWIDTH-1:0] a_wr_ptr;\n  reg [AWIDTH-1:0] a_rd_ptr;\n\n  // Synchronizers for B's pointers into A domain\n  reg [AWIDTH-1:0] b_wr_ptr_sync1, b_wr_ptr_sync2;\n  reg [AWIDTH-1:0] b_rd_ptr_sync1, b_rd_ptr_sync2;\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_wr_ptr_sync1 <= {AWIDTH{1'b0}};\n      b_wr_ptr_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      b_wr_ptr_sync1 <= b_wr_ptr_sync2;\n      b_wr_ptr_sync2 <= b_wr_ptr;\n    end\n  end\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_rd_ptr_sync1 <= {AWIDTH{1'b0}};\n      b_rd_ptr_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      b_rd_ptr_sync1 <= b_rd_ptr_sync2;\n      b_rd_ptr_sync2 <= b_rd_ptr;\n    end\n  end\n\n  // A-side status\n  wire a_full  = (a_wr_ptr == b_rd_ptr_sync2);\n  wire a_empty = (a_rd_ptr == b_wr_ptr_sync2);\n\n  wire a_afull  = (a_wr_ptr[ASIZE] == b_rd_ptr_sync2[ASIZE]) &&\n                  (a_wr_ptr[ASIZE-1:0] == b_rd_ptr_sync2[ASIZE-1:0] + ASIZE'(DEPTH - 2));\n  wire a_aempty = (a_rd_ptr[ASIZE] == b_wr_ptr_sync2[ASIZE]) &&\n                  (a_rd_ptr[ASIZE-1:0] == b_wr_ptr_sync2[ASIZE-1:0] + ASIZE'(DEPTH - 2));\n\n  // A-side RAM port control\n  wire a_ram_wen = a_winc && !a_full;\n  wire a_ram_ren = a_rinc && !a_empty;\n\n  assign o_ram_a_clk   = a_clk;\n  assign o_ram_a_wdata = a_wdata;\n  assign o_ram_a_addr  = a_wr_ptr[ASIZE-1:0];\n  assign o_ram_a_winc  = a_ram_wen;\n  assign o_ram_a_rinc  = a_ram_ren;\n\n  // A-side read data: fall-through or from RAM\n  wire a_fallthrough = (FALLTHROUGH == \"TRUE\") && a_ram_wen && a_ram_ren;\n  assign a_rdata = a_fallthrough ? a_wdata : i_ram_a_rdata;\n\n  // A-side pointer updates\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_wr_ptr <= {AWIDTH{1'b0}};\n      a_rd_ptr <= {AWIDTH{1'b0}};\n    end else begin\n      if (a_ram_wen) a_wr_ptr <= a_wr_ptr + 1'b1;\n      if (a_ram_ren) a_rd_ptr <= a_rd_ptr + 1'b1;\n    end\n  end\n\n  // ---------------------------------------------------------------------------\n  // Side B logic (clocked by b_clk)\n  // ---------------------------------------------------------------------------\n\n  reg [AWIDTH-1:0] b_wr_ptr;\n  reg [AWIDTH-1:0] b_rd_ptr;\n\n  // Synchronizers for A's pointers into B domain\n  reg [AWIDTH-1:0] a_wr_ptr_sync1, a_wr_ptr_sync2;\n  reg [AWIDTH-1:0] a_rd_ptr_sync1, a_rd_ptr_sync2;\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_wr_ptr_sync1 <= {AWIDTH{1'b0}};\n      a_wr_ptr_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      a_wr_ptr_sync1 <= a_wr_ptr_sync2;\n      a_wr_ptr_sync2 <= a_wr_ptr;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_rd_ptr_sync1 <= {AWIDTH{1'b0}};\n      a_rd_ptr_sync2 <= {AWIDTH{1'b0}};\n    end else begin\n      a_rd_ptr_sync1 <= a_rd_ptr_sync2;\n      a_rd_ptr_sync2 <= a_rd_ptr;\n    end\n  end\n\n  // B-side status\n  wire b_full  = (b_wr_ptr == a_rd_ptr_sync2);\n  wire b_empty = (b_rd_ptr == a_wr_ptr_sync2);\n\n  wire b_afull  = (b_wr_ptr[ASIZE] == a_rd_ptr_sync2[ASIZE]) &&\n                  (b_wr_ptr[ASIZE-1:0] == a_rd_ptr_sync2[ASIZE-1:0] + ASIZE'(DEPTH - 2));\n  wire b_aempty = (b_rd_ptr[ASIZE] == a_wr_ptr_sync2[ASIZE]) &&\n                  (b_rd_ptr[ASIZE-1:0] == a_wr_ptr_sync2[ASIZE-1:0] + ASIZE'(DEPTH - 2));\n\n  // B-side RAM port control\n  wire b_ram_wen = b_winc && !b_full;\n  wire b_ram_ren = b_rinc && !b_empty;\n\n  assign o_ram_b_clk   = b_clk;\n  assign o_ram_b_wdata = b_wdata;\n  assign o_ram_b_addr  = b_wr_ptr[ASIZE-1:0];\n  assign o_ram_b_winc  = b_ram_wen;\n  assign o_ram_b_rinc  = b_ram_ren;\n\n  // B-side read data: fall-through or from RAM\n  wire b_fallthrough = (FALLTHROUGH == \"TRUE\") && b_ram_wen && b_ram_ren;\n  assign b_rdata = b_fallthrough ? b_wdata : i_ram_b_rdata;\n\n  // B-side pointer updates\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_wr_ptr <= {AWIDTH{1'b0}};\n      b_rd_ptr <= {AWIDTH{1'b0}};\n    end else begin\n      if (b_ram_wen) b_wr_ptr <= b_wr_ptr + 1'b1;\n      if (b_ram_ren) b_rd_ptr <= b_rd_ptr + 1'b1;\n    end\n  end\n\n  // ---------------------------------------------------------------------------\n  // Status outputs\n  // ---------------------------------------------------------------------------\n\n  assign a_full   = a_full;\n  assign a_afull  = a_afull;\n  assign a_empty  = a_empty;\n  assign a_aempty = a_aempty;\n\n  assign b_full   = b_full;\n  assign b_afull  = b_afull;\n  assign b_empty  = b_empty;\n  assign b_aempty = b_aempty;\n\nendmodule\n```<|im_end|>",
