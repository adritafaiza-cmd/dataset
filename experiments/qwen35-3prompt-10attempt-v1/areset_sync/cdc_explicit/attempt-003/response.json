{
  "text": "module areset_sync #(\n    parameter STAGES = 2\n)(\n    input  clk,\n    input  async_rst_i,\n    output sync_rst_o\n);\n\n    // Synchronizer chain for reset release\n    // STAGES defines the depth of the synchronizer pipeline\n    // Using 2 stages is standard for robust reset release synchronization\n    wire [STAGES-1:0] rst_sync_chain;\n\n    // First stage of synchronizer\n    always @(posedge clk or posedge async_rst_i) begin\n        if (async_rst_i)\n            rst_sync_chain[0] <= 1'b1;\n        else\n            rst_sync_chain[0] <= rst_sync_chain[0];\n    end\n\n    // Subsequent stages of synchronizer\n    genvar i;\n    generate\n        for (i = 1; i < STAGES; i = i + 1) begin : sync_stage\n            always @(posedge clk or posedge rst_sync_chain[i-1]) begin\n                if (rst_sync_chain[i-1])\n                    rst_sync_chain[i] <= 1'b1;\n                else\n                    rst_sync_chain[i] <= rst_sync_chain[i];\n            end\n        end\n    endgenerate\n\n    // Final output is the last stage of the synchronizer chain\n    assign sync_rst_o = rst_sync_chain[STAGES-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
