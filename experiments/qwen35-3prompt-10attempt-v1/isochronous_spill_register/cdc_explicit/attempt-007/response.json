{
  "text": "```verilog\nmodule isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output reg [WIDTH-1:0] dst_data_o\n);\n\n    // Internal signals for CDC-safe state storage\n    // Using 2-deep FIFO logic:\n    // src_domain: stores valid and data until ready is asserted\n    // dst_domain: stores valid and data until ready is consumed\n    \n    reg src_valid_reg;\n    reg [WIDTH-1:0] src_data_reg;\n    reg dst_valid_reg;\n    reg [WIDTH-1:0] dst_data_reg;\n    \n    // State machine for source domain to manage ready handshake\n    // States: IDLE, WAIT_FOR_DST\n    reg [1:0] src_state;\n    parameter IDLE = 2'b00, WAIT_FOR_DST = 2'b01;\n    \n    // State machine for destination domain to manage valid assertion\n    // States: IDLE, WAIT_FOR_SRC\n    reg [1:0] dst_state;\n    parameter DST_IDLE = 2'b00, DST_WAIT_FOR_SRC = 2'b01;\n\n    // Source Domain Logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_valid_reg <= 1'b0;\n            src_data_reg <= 1'b0;\n            src_state <= IDLE;\n            src_ready_o <= 1'b0;\n        end else begin\n            case (src_state)\n                IDLE: begin\n                    if (src_valid_i) begin\n                        src_valid_reg <= 1'b1;\n                        src_data_reg <= src_data_i;\n                        src_state <= WAIT_FOR_DST;\n                    end\n                    src_ready_o <= 1'b0;\n                end\n                \n                WAIT_FOR_DST: begin\n                    if (src_valid_reg && dst_ready_i) begin\n                        src_valid_reg <= 1'b0;\n                        src_state <= IDLE;\n                        src_ready_o <= 1'b1;\n                    end else if (src_valid_reg && !dst_ready_i) begin\n                        src_ready_o <= 1'b0;\n                    end else begin\n                        src_ready_o <= 1'b0;\n                    end\n                end\n            endcase\n        end\n    end\n\n    // Destination Domain Logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_reg <= 1'b0;\n            dst_data_reg <= 1'b0;\n            dst_state <= DST_IDLE;\n            dst_valid_o <= 1'b0;\n        end else begin\n            case (dst_state)\n                DST_IDLE: begin\n                    if (src_valid_reg) begin\n                        dst_valid_reg <= 1'b1;\n                        dst_data_reg <= src_data_reg;\n                        dst_state <= DST_WAIT_FOR_SRC;\n                    end\n                    dst_valid_o <= 1'b0;\n                end\n                \n                DST_WAIT_FOR_SRC: begin\n                    if (dst_valid_reg && dst_ready_i) begin\n                        dst_valid_reg <= 1'b0;\n                        dst_state <= DST_IDLE;\n                        dst_valid_o <= 1'b1;\n                    end else if (dst_valid_reg && !dst_ready_i) begin\n                        dst_valid_o <= 1'b0;\n                    end else begin\n                        dst_valid_o <= 1'b0;\n                    end\n                end\n            endcase\n        end\n    end\n\n    // Output assignment for destination data\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_o <= 1'b0;\n        end else begin\n            dst_data_o <= dst_data_reg;\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
