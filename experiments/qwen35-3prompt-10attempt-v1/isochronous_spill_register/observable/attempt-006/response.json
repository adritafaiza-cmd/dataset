  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output reg [WIDTH-1:0] dst_data_o\n);\n\n    // State encoding\n    // IDLE: Buffer is empty\n    // WAIT_SRC: Waiting for valid data from source\n    // WAIT_DST: Waiting for ready from destination\n    localparam IDLE = 2'b00;\n    localparam WAIT_SRC = 2'b01;\n    localparam WAIT_DST = 2'b10;\n\n    reg [1:0] state;\n    reg [WIDTH-1:0] buffer_data;\n    reg src_valid_reg;\n    reg src_ready_reg;\n    reg dst_valid_reg;\n\n    // Synchronous logic for source side signals\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_valid_reg <= 1'b0;\n            src_ready_reg <= 1'b1;\n        end else begin\n            src_valid_reg <= src_valid_i;\n            // Ready is asserted unless we are waiting for destination\n            src_ready_reg <= (state == WAIT_SRC) ? 1'b0 : 1'b1;\n        end\n    end\n\n    // Synchronous logic for destination side signals\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_reg <= 1'b0;\n            dst_data_o <= 1'b0; // Drive 0 on reset\n        end else begin\n            dst_valid_reg <= (state == WAIT_DST) ? 1'b1 : 1'b0;\n            // Drive buffer data when valid\n            dst_data_o <= (state == WAIT_DST) ? buffer_data : 1'b0;\n        end\n    end\n\n    // State machine logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            state <= IDLE;\n        end else begin\n            case (state)\n                IDLE: begin\n                    if (src_valid_i && src_ready_reg) begin\n                        // Capture data and move to waiting for destination\n                        buffer_data <= src_data_i;\n                        state <= WAIT_DST;\n                    end\n                end\n                WAIT_SRC: begin\n                    // Stay here until destination is ready\n                    // Note: In a 2-deep buffer context, this state effectively\n                    // acts as the first stage holding data. If the requirement\n                    // implies buffering multiple items, the state machine would\n                    // need to track count. However, \"2-deep valid/ready spill buffer\"\n                    // between related clocks often implies a handshake buffer with\n                    // potential for 2 cycles of latency or a specific depth.\n                    // Given the interface and \"deliver accepted data once in order\",\n                    // a single FIFO element (1-deep) is the standard interpretation\n                    // for a simple spill register unless a specific FIFO depth\n                    // parameter is requested. \n                    // \n                    // Re-reading \"2-deep\": This usually implies a depth of 2.\n                    // To implement a depth-2 FIFO between clocks, we need a counter\n                    // and a pointer.\n                    \n                    // Let's implement a true 2-deep FIFO logic here.\n                    // We will use a counter to track depth.\n                    // Since we are in a single clock domain logic block for state,\n                    // we need to handle the cross-clock FIFO pointer logic carefully.\n                    // However, the prompt asks for a \"spill buffer\" which often implies\n                    // a specific latency or small depth. \n                    // \n                    // Correction: A \"2-deep\" buffer implies a FIFO with capacity 2.\n                    // We need to track the write pointer (src side) and read pointer (dst side).\n                    // Since clocks are related, we can use synchronous pointers.\n                    \n                    // Let's refactor the state machine to support a 2-deep FIFO.\n                    // States:\n                    // 0: Empty\n                    // 1: 1 item\n                    // 2: 2 items (Full)\n                    \n                    // Actually, to keep it simple and robust for \"related clocks\",\n                    // we can use a single counter for depth and pointers.\n                    // But the prompt asks for a specific behavior: \"Buffer a short rate mismatch\".\n                    // A 2-deep FIFO is the standard solution.\n                    \n                    // Let's switch to a counter-based approach for the 2-deep requirement.\n                    // We will move the state logic into the counter logic.\n                    \n                    // Wait, the previous state machine was for a 1-deep buffer.\n                    // To strictly follow \"2-deep\", I must implement a FIFO with depth 2.\n                    // Let's restart the logic block below to implement the 2-deep FIFO correctly.\n                    \n                    // Placeholder to avoid compilation error in this thought block,\n                    // actual implementation follows below.\n                    state <= IDLE; \n                end\n                default: state <= IDLE;\n            endcase\n        end\n    end\n\n    // --- 2-Deep FIFO Implementation ---\n    \n    // Pointers: 2 bits are sufficient for depth 2 (00, 01, 10)\n    // We use a simple counter for write pointer and read pointer.\n    // Since clocks are related, we can use synchronous pointers.\n    \n    reg [1:0] write_ptr;\n    reg [1:0] read_ptr;\n    reg [WIDTH-1:0] fifo_mem [0:1]; // Depth 2\n    reg [1:0] full_mask; // Mask to indicate full status (11 = full)\n    reg [1:0] empty_mask; // Mask to indicate empty status (00 = empty)\n\n    // Write logic (Source Clock Domain)\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            write_ptr <= 2'b00;\n            fifo_mem <= 2'b0;\n            full_mask <= 2'b00;\n        end else begin\n            // Write enable: valid is high AND we are not full\n            // Full condition: write_ptr == read_ptr + 2 (wrapping)\n            // For depth 2:\n            // 00 -> 01 -> 10 -> 00 (Full)\n            // 00 -> 01 -> 10 -> 11 (Empty? No, 11 is usually full in some encodings)\n            // Let's use standard circular buffer logic.\n            \n            // Check if full: (write_ptr + 1) == read_ptr (for depth 2, indices 0,1)\n            // If write_ptr=0, next=1. If read_ptr=1, full.\n            // If write_ptr=1, next=0. If read_ptr=0, full.\n            \n            if (src_valid_i && src_ready_reg) begin\n                // Check full condition\n                // If (write_ptr + 1) == read_ptr, then full\n                // For depth 2:\n                // Case 1: w=0, r=1 -> next w=1 != r(1) -> Not full? Wait.\n                // Let's trace:\n                // Init: w=0, r=0, empty.\n                // Write 1: w=1, r=0. Data at [1].\n                // Write 2: w=0, r=0. Data at [0]. Now w=0, r=0. Is it full?\n                // If w=0 and r=0, it could be empty or full.\n                // We need a separate full flag or check count.\n                \n                // Simpler approach for small depth:\n                // Count items.\n                // But let's stick to pointers for generality.\n                // Depth 2:\n                // Empty: w == r\n                // Full: (w + 1) % 2 == r\n                \n                if (write_ptr == 2'b00 && read_ptr == 2'b01) begin\n                    // Full\n                    src_ready_reg <= 1'b0;\n                end else if (write_ptr == 2'b01 && read_ptr == 2'b00) begin\n                    // Full\n                    src_ready_reg <= 1'b0;\n                end else begin\n                    // Not full\n                    src_ready_reg <= 1'b1;\n                    fifo_mem[write_ptr] <= src_data_i;\n                    write_ptr <= write_ptr + 1'b1;\n                    if (write_ptr == 2'b10) write_ptr <= 2'b00;\n                end\n            end else begin\n                src_ready_reg <= 1'b1; // Ready if not full\n            end\n        end\n    end\n\n    // Read logic (Destination Clock Domain)\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            read_ptr <= 2'b00;\n            dst_valid_reg <= 1'b0;\n            dst_data_o <= 1'b0;\n        end else begin\n            // Check if empty: w == r\n            if (write_ptr == read_ptr) begin\n                dst_valid_reg <= 1'b0;\n                dst_data_o <= 1'b0;\n            end else begin\n                dst_valid_reg <= 1'b1;\n                dst_data_o <= fifo_mem[read_ptr];\n                // Advance read pointer\n                read_ptr <= read_ptr + 1'b1;\n                if (read_ptr == 2'b10) read_ptr <= 2'b00;\n            end\n        end\n    end\n\n    // Output assignments\n    assign src_ready_o = src_ready_reg;\n    assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
