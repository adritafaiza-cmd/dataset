  "text": "```verilog\nmodule isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output reg [WIDTH-1:0] dst_data_o\n);\n\n    // 2-deep FIFO state machine\n    typedef enum logic [1:0] {\n        STATE_IDLE,\n        STATE_FILL,\n        STATE_EMPTY,\n        STATE_FULL\n    } fsm_state_t;\n\n    fsm_state_t state_reg, state_next;\n    logic [1:0] count_reg, count_next;\n    logic [WIDTH-1:0] data_reg;\n    logic src_valid_reg;\n    logic dst_valid_reg;\n    logic dst_ready_reg;\n\n    // Synchronize src_valid to dst_clk\n    logic src_valid_synced;\n    always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_valid_synced <= 1'b0;\n        else\n            src_valid_synced <= src_valid_i;\n    end\n\n    // Synchronize dst_ready to src_clk\n    logic dst_ready_synced;\n    always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_ready_synced <= 1'b0;\n        else\n            dst_ready_synced <= dst_ready_i;\n    end\n\n    // State and Count Next State Logic\n    always_comb begin\n        state_next = state_reg;\n        count_next = count_reg;\n        dst_valid_reg = 1'b0;\n        src_ready_o = 1'b0;\n        dst_data_o = 0;\n\n        case (state_reg)\n            STATE_IDLE: begin\n                if (src_valid_synced && dst_ready_synced) begin\n                    state_next = STATE_FILL;\n                    count_next = 1;\n                    src_ready_o = 1'b1;\n                end\n            end\n\n            STATE_FILL: begin\n                if (src_valid_synced && dst_ready_synced) begin\n                    state_next = STATE_FILL;\n                    count_next = count_reg + 1;\n                    src_ready_o = 1'b1;\n                end else if (src_valid_synced) begin\n                    state_next = STATE_FILL;\n                    count_next = count_reg + 1;\n                    src_ready_o = 1'b1;\n                end else if (dst_ready_synced) begin\n                    state_next = STATE_FILL;\n                    count_next = count_reg - 1;\n                    src_ready_o = 1'b0;\n                end else begin\n                    state_next = STATE_FILL;\n                    count_next = count_reg;\n                    src_ready_o = 1'b0;\n                end\n            end\n\n            STATE_EMPTY: begin\n                if (src_valid_synced && dst_ready_synced) begin\n                    state_next = STATE_FILL;\n                    count_next = 1;\n                    src_ready_o = 1'b1;\n                end\n            end\n\n            STATE_FULL: begin\n                if (src_valid_synced && dst_ready_synced) begin\n                    state_next = STATE_FILL;\n                    count_next = count_reg - 1;\n                    src_ready_o = 1'b1;\n                end else if (src_valid_synced) begin\n                    state_next = STATE_FULL;\n                    count_next = count_reg;\n                    src_ready_o = 1'b1;\n                end else if (dst_ready_synced) begin\n                    state_next = STATE_FILL;\n                    count_next = count_reg - 1;\n                    src_ready_o = 1'b0;\n                end else begin\n                    state_next = STATE_FULL;\n                    count_next = count_reg;\n                    src_ready_o = 1'b0;\n                end\n            end\n        endcase\n    end\n\n    // State and Count Registers\n    always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            state_reg <= STATE_IDLE;\n            count_reg <= 2'b00;\n            data_reg <= 0;\n            src_valid_reg <= 1'b0;\n            dst_valid_reg <= 1'b0;\n            dst_ready_reg <= 1'b0;\n        end else begin\n            state_reg <= state_next;\n            count_reg <= count_next;\n            src_valid_reg <= src_valid_synced;\n            dst_valid_reg <= dst_ready_synced;\n            dst_ready_reg <= src_valid_synced;\n        end\n    end\n\n    // Data Register\n    always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            data_reg <= 0;\n        end else if (state_reg == STATE_FILL && count_reg == 1 && src_valid_synced && dst_ready_synced) begin\n            data_reg <= src_data_i;\n        end\n    end\n\n    // Output Logic\n    always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_o <= 1'b0;\n            dst_data_o <= 0;\n        end else if (state_reg == STATE_FILL && count_reg == 1 && src_valid_synced && dst_ready_synced) begin\n            dst_valid_o <= 1'b1;\n            dst_data_o <= data_reg;\n        end else begin\n            dst_valid_o <= 1'b0;\n            dst_data_o <= 0;\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
