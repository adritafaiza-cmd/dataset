{
  "text": "module isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output reg [WIDTH-1:0] dst_data_o\n);\n\n    // Source domain state: 0 = empty, 1 = full\n    reg src_state;\n    // Destination domain state: 0 = empty, 1 = full\n    reg dst_state;\n    // Data storage for the buffer\n    reg [WIDTH-1:0] src_data_reg;\n    reg [WIDTH-1:0] dst_data_reg;\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_state <= 1'b0;\n            src_data_reg <= 0;\n        end else begin\n            if (src_valid_i && !src_state) begin\n                src_state <= 1'b1;\n                src_data_reg <= src_data_i;\n            end\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_state <= 1'b0;\n            dst_data_reg <= 0;\n            dst_valid_o <= 1'b0;\n            dst_data_o <= 0;\n        end else begin\n            if (dst_state && dst_ready_i) begin\n                dst_state <= 1'b0;\n                dst_valid_o <= 1'b1;\n                dst_data_o <= dst_data_reg;\n            end else if (src_state) begin\n                dst_state <= 1'b1;\n                dst_data_reg <= src_data_reg;\n                dst_valid_o <= 1'b0;\n                dst_data_o <= 0;\n            end else begin\n                dst_state <= 1'b0;\n                dst_valid_o <= 1'b0;\n                dst_data_o <= 0;\n            end\n        end\n    end\n\n    // Backpressure generation\n    assign src_ready_o = src_state ? 1'b0 : 1'b1;\n\nendmodule<|im_end|>\n<|endoftext|>",
