  "text": "module isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output [WIDTH-1:0] dst_data_o\n);\n\n    // Source domain state\n    reg src_valid_reg;\n    reg [WIDTH-1:0] src_data_reg;\n    reg src_valid_prev;\n\n    // Destination domain state (2-deep buffer)\n    reg [WIDTH-1:0] dst_data_buf [0:1];\n    reg dst_valid_buf [0:1];\n    reg dst_valid_prev;\n\n    // Source domain logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_valid_reg <= 1'b0;\n            src_data_reg <= 1'b0;\n            src_valid_prev <= 1'b0;\n        end else begin\n            src_valid_prev <= src_valid_reg;\n            src_valid_reg <= src_valid_i;\n            src_data_reg <= src_data_i;\n        end\n    end\n\n    // Destination domain logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_buf[0] <= 1'b0;\n            dst_valid_buf[1] <= 1'b0;\n            dst_data_buf[0] <= 1'b0;\n            dst_data_buf[1] <= 1'b0;\n            dst_valid_prev <= 1'b0;\n        end else begin\n            dst_valid_prev <= dst_valid_buf[0];\n            // Shift buffer: move index 1 to index 0, then load new data if available\n            dst_valid_buf[0] <= dst_valid_buf[1];\n            dst_data_buf[0] <= dst_data_buf[1];\n            \n            // Load new data if source is ready and destination has space\n            if (src_valid_reg && !dst_valid_buf[1]) begin\n                dst_valid_buf[1] <= 1'b1;\n                dst_data_buf[1] <= src_data_reg;\n            end\n        end\n    end\n\n    // Output assignments\n    assign src_ready_o = src_valid_prev && dst_ready_i && !dst_valid_buf[1];\n    assign dst_valid_o = dst_valid_buf[0];\n    assign dst_data_o = dst_data_buf[0];\n\nendmodule<|im_end|>\n<|endoftext|>",
