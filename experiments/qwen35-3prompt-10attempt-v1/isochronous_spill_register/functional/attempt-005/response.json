  "text": "module isochronous_spill_register #(\n    parameter WIDTH = 8\n)(\n    input              src_clk_i,\n    input              src_rst_ni,\n    input              src_valid_i,\n    output             src_ready_o,\n    input  [WIDTH-1:0] src_data_i,\n    input              dst_clk_i,\n    input              dst_rst_ni,\n    output             dst_valid_o,\n    input              dst_ready_i,\n    output reg [WIDTH-1:0] dst_data_o\n);\n\n    // Source domain state: 0 = empty, 1 = full\n    reg src_state;\n    // Destination domain state: 0 = empty, 1 = full\n    reg dst_state;\n    // Data storage for the single slot in the 2-deep buffer\n    reg [WIDTH-1:0] data_buf;\n\n    // ---------------------------------------------------------\n    // Source Domain Logic\n    // ---------------------------------------------------------\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_state <= 1'b0;\n            src_ready_o <= 1'b1;\n        end else begin\n            // If destination is ready and we have data, push to dest\n            if (src_state == 1'b1 && dst_ready_i) begin\n                src_state <= 1'b0;\n                src_ready_o <= 1'b1;\n            end else if (src_valid_i && src_state == 1'b0) begin\n                // Accept new data, mark buffer full\n                src_state <= 1'b1;\n                src_ready_o <= 1'b0;\n            end else begin\n                // No data available or buffer full\n                src_ready_o <= 1'b1;\n            end\n        end\n    end\n\n    // Capture data when entering full state\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            data_buf <= 1'b0;\n        end else if (src_valid_i && src_state == 1'b0) begin\n            data_buf <= src_data_i;\n        end\n    end\n\n    // ---------------------------------------------------------\n    // Destination Domain Logic\n    // ---------------------------------------------------------\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_state <= 1'b0;\n            dst_valid_o <= 1'b0;\n            dst_data_o <= 1'b0;\n        end else begin\n            // If source has data and buffer is not empty, pull from buffer\n            if (src_state == 1'b1 && dst_state == 1'b0) begin\n                dst_state <= 1'b1;\n                dst_valid_o <= 1'b1;\n                dst_data_o <= data_buf;\n            end else if (dst_state == 1'b1 && dst_ready_i) begin\n                // Data consumed, mark buffer empty\n                dst_state <= 1'b0;\n                dst_valid_o <= 1'b0;\n                dst_data_o <= 1'b0;\n            end else begin\n                // No data to send or destination not ready\n                dst_valid_o <= 1'b0;\n                dst_data_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule<|im_end|>\n<|endoftext|>",
