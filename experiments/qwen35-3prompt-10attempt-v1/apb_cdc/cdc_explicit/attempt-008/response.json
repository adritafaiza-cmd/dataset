  // FIFO Control Signals\n    reg [LOG_DEPTH-1:0] wr_ptr;\n    reg [LOG_DEPTH-1:0] rd_ptr;\n    reg [LOG_DEPTH-1:0] full_cnt;\n    reg [LOG_DEPTH-1:0] empty_cnt;\n    reg [LOG_DEPTH-1:0] next_wr_ptr;\n    reg [LOG_DEPTH-1:0] next_rd_ptr;\n    reg [LOG_DEPTH-1:0] next_full_cnt;\n    reg [LOG_DEPTH-1:0] next_empty_cnt;\n    reg [LOG_DEPTH-1:0] next_next_wr_ptr;\n    reg [LOG_DEPTH-1:0] next_next_rd_ptr;\n    reg [LOG_DEPTH-1:0] next_next_full_cnt;\n    reg [LOG_DEPTH-1:0] next_next_empty_cnt;\n\n    // FIFO Data Storage\n    reg [INT_ADDR_WIDTH-1:0] fifo_addr [INT_DEPTH-1:0];\n    reg [INT_DATA_WIDTH-1:0] fifo_pwdata [INT_DEPTH-1:0];\n    reg [INT_STRB_WIDTH-1:0] fifo_pstrb [INT_DEPTH-0];\n    reg [2:0] fifo_pprot [INT_DEPTH-1:0];\n    reg [INT_DATA_WIDTH-1:0] fifo_prdata [INT_DEPTH-1:0];\n    reg fifo_pslverr [INT_DEPTH-1:0];\n\n    // State Machine for Source Side\n    typedef enum logic [1:0] {\n        SRC_IDLE,\n        SRC_WAIT_DST_READY,\n        SRC_READ_DATA\n    } src_state_t;\n\n    src_state_t src_state;\n    reg src_state_next;\n\n    // State Machine for Destination Side\n    typedef enum logic [1:0] {\n        DST_IDLE,\n        DST_WAIT_SRC_READY,\n        DST_READ_DATA\n    } dst_state_t;\n\n    dst_state_t dst_state;\n    reg dst_state_next;\n\n    // Synchronizer Logic\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_reset_sync <= 1'b1;\n        else\n            src_reset_sync <= src_reset_sync | src_preset_ni;\n    end\n\n    always_ff @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_reset_sync <= 1'b1;\n        else\n            dst_reset_sync <= dst_reset_sync | dst_preset_ni;\n    end\n\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_psel_sync <= 1'b0;\n        else\n            src_psel_sync <= src_psel_sync | src_psel_i;\n    end\n\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_penable_sync <= 1'b0;\n        else\n            src_penable_sync <= src_penable_sync | src_penable_i;\n    end\n\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_pwrite_sync <= 1'b0;\n        else\n            src_pwrite_sync <= src_pwrite_sync | src_pwrite_i;\n    end\n\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_pready_sync <= 1'b0;\n        else\n            src_pready_sync <= src_pready_sync | src_pready_i;\n    end\n\n    always_ff @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_pready_sync <= 1'b0;\n        else\n            dst_pready_sync <= dst_pready_sync | dst_pready_i;\n    end\n\n    always_ff @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_pslverr_sync <= 1'b0;\n        else\n            dst_pslverr_sync <= dst_pslverr_sync | dst_pslverr_i;\n    end\n\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_paddr_sync <= {INT_ADDR_WIDTH{1'b0}};\n        else\n            src_paddr_sync <= src_paddr_i;\n    end\n\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_pwdata_sync <= {INT_DATA_WIDTH{1'b0}};\n        else\n            src_pwdata_sync <= src_pwdata_i;\n    end\n\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_pstrb_sync <= {INT_STRB_WIDTH{1'b0}};\n        else\n            src_pstrb_sync <= src_pstrb_i;\n    end\n\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_pprot_sync <= 3'b000;\n        else\n            src_pprot_sync <= src_pprot_i;\n    end\n\n    always_ff @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_prdata_sync <= {INT_DATA_WIDTH{1'b0}};\n        else\n            dst_prdata_sync <= dst_prdata_i;\n    end\n\n    // FIFO Logic\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            wr_ptr <= 0;\n            rd_ptr <= 0;\n            full_cnt <= 0;\n            empty_cnt <= 0;\n            next_wr_ptr <= 0;\n            next_rd_ptr <= 0;\n            next_full_cnt <= 0;\n            next_empty_cnt <= 0;\n            next_next_wr_ptr <= 0;\n            next_next_rd_ptr <= 0;\n            next_next_full_cnt <= 0;\n            next_next_empty_cnt <= 0;\n        end else begin\n            wr_ptr <= next_wr_ptr;\n            rd_ptr <= next_rd_ptr;\n            full_cnt <= next_full_cnt;\n            empty_cnt <= next_empty_cnt;\n            next_wr_ptr <= next_next_wr_ptr;\n            next_rd_ptr <= next_next_rd_ptr;\n            next_full_cnt <= next_next_full_cnt;\n            next_empty_cnt <= next_next_empty_cnt;\n        end\n    end\n\n    always_comb begin\n        next_wr_ptr = wr_ptr;\n        next_rd_ptr = rd_ptr;\n        next_full_cnt = full_cnt;\n        next_empty_cnt = empty_cnt;\n\n        if (src_psel_sync && src_penable_sync && !src_pready_sync && !src_reset_sync) begin\n            if (full_cnt == 0) begin\n                next_wr_ptr = wr_ptr;\n                next_full_cnt = 1;\n            end else if (full_cnt == INT_DEPTH - 1) begin\n                next_wr_ptr = wr_ptr;\n                next_full_cnt = INT_DEPTH;\n            end else begin\n                next_wr_ptr = wr_ptr + 1;\n                next_full_cnt = full_cnt + 1;\n            end\n        end\n\n        if (dst_pready_sync && !dst_reset_sync) begin\n            if (empty_cnt == 0) begin\n                next_rd_ptr = rd_ptr;\n                next_empty_cnt = 1;\n            end else if (empty_cnt == INT_DEPTH - 1) begin\n                next_rd_ptr = rd_ptr;\n                next_empty_cnt = INT_DEPTH;\n            end else begin\n                next_rd_ptr = rd_ptr + 1;\n                next_empty_cnt = empty_cnt + 1;\n            end\n        end\n    end\n\n    always_comb begin\n        if (src_psel_sync && src_penable_sync && !src_pready_sync && !src_reset_sync) begin\n            fifo_addr[wr_ptr] = src_paddr_sync;\n            fifo_pwdata[wr_ptr] = src_pwdata_sync;\n            fifo_pstrb[wr_ptr] = src_pstrb_sync;\n            fifo_pprot[wr_ptr] = src_pprot_sync;\n        end\n\n        if (dst_pready_sync && !dst_reset_sync) begin\n            fifo_prdata[rd_ptr] = dst_prdata_sync;\n            fifo_pslverr[rd_ptr] = dst_pslverr_sync;\n        end\n    end\n\n    // Source State Machine\n    always_ff @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni)\n            src_state <= SRC_IDLE;\n        else\n            src_state <= src_state_next;\n    end\n\n    always_comb begin\n        src_state_next = SRC_IDLE;\n        src_pready_o = 1'b0;\n        src_prdata_o = {INT_DATA_WIDTH{1'b0}};\n        src_pslverr_o = 1'b0;\n\n        case (src_state)\n            SRC_IDLE: begin\n                if (src_psel_sync && src_penable_sync && !src_pready_sync && !src_reset_sync) begin\n                    src_state_next = SRC_WAIT_DST_READY;\n                end\n            end\n\n            SRC_WAIT_DST_READY: begin\n                if (dst_pready_sync && !dst_reset_sync) begin\n                    src_state_next = SRC_READ_DATA;\n                end\n            end\n\n            SRC_READ_DATA: begin\n                if (dst_pready_sync && !dst_reset_sync) begin\n                    src_state_next = SRC_IDLE;\n                    src_pready_o = 1'b1;\n                    src_prdata_o = fifo_prdata[rd_ptr];\n                    src_pslverr_o = fifo_pslverr[rd_ptr];\n                end\n            end\n        endcase\n    end\n\n    // Destination State Machine\n    always_ff @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni)\n            dst_state <= DST_IDLE;\n        else\n            dst_state <= dst_state_next;\n    end\n\n    always_comb begin\n        dst_state_next = DST_IDLE;\n        dst_psel_o = 1'b0;\n        dst_penable_o = 1'b0;\n        dst_pwrite_o = 1'b0;\n        dst_paddr_o = {INT_ADDR_WIDTH{1'b0}};\n        dst_pwdata_o = {INT_DATA_WIDTH{1'b0}};\n        dst_pstrb_o = {INT_STRB_WIDTH{1'b0}};\n        dst_pprot_o = 3'b000;\n\n        case (dst_state)\n            DST_IDLE: begin\n                if (src_psel_sync && src_penable_sync && !src_pready_sync && !dst_reset_sync) begin\n                    dst_state_next = DST_WAIT_SRC_READY;\n                    dst_psel_o = 1'b1;\n                    dst_penable_o = 1'b1;\n                    dst_pwrite_o = src_pwrite_sync;\n                    dst_paddr_o = fifo_addr[wr_ptr];\n                    dst_pwdata_o = fifo_pwdata[wr_ptr];\n                    dst_pstrb_o = fifo_pstrb[wr_ptr];\n                    dst_pprot_o = fifo_pprot[wr_ptr];\n                end\n            end\n\n            DST_WAIT_SRC_READY: begin\n                if (src_pready_sync && !dst_reset_sync) begin\n                    dst_state_next = DST_READ_DATA;\n                end\n            end\n\n            DST_READ_DATA: begin\n                if (src_pready_sync && !dst_reset_sync) begin\n                    dst_state_next = DST_IDLE;\n                    dst_psel_o = 1'b0;\n                    dst_penable_o = 1'b0;\n                    dst_pwrite_o = 1'b0;\n                    dst_paddr_o = {INT_ADDR_WIDTH{1'b0}};\n                    dst_pwdata_o = {INT_DATA_WIDTH{1'b0}};\n                    dst_pstrb_o = {INT_STRB_WIDTH{1'b0}};\n                    dst_pprot_o = 3'b000;\n                end\n            end\n        endcase\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
