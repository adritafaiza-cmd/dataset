l;\n    reg                     dst_fifo_empty;\n\n    // Control Signals\n    reg                     src_req_valid;\n    reg                     src_req_ready;\n    reg                     dst_resp_valid;\n    reg                     dst_resp_ready;\n    reg                     src_resp_valid;\n    reg                     src_resp_ready;\n    reg                     dst_req_valid;\n    reg                     dst_req_ready;\n    reg                     dst_resp_ready_int;\n\n    // Source Side Logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_fifo_addr <= '0;\n            src_fifo_wdata <= '0;\n            src_fifo_wstrb <= '0;\n            src_fifo_valid <= 1'b0;\n            src_fifo_ready <= 1'b1;\n            src_fifo_full <= 1'b0;\n            src_fifo_empty <= 1'b1;\n            src_req_valid <= 1'b0;\n            src_req_ready <= 1'b1;\n            src_pready_o <= 1'b1;\n            src_prdata_o <= '0;\n            src_pslverr_o <= 1'b0;\n            dst_psel_o <= 1'b0;\n            dst_penable_o <= 1'b0;\n            dst_pwrite_o <= 1'b0;\n            dst_paddr_o <= '0;\n            dst_pwdata_o <= '0;\n            dst_pstrb_o <= '0;\n            dst_pprot_o <= '0;\n        end else begin\n            // Request Generation\n            src_req_valid <= src_psel_i & src_penable_i;\n            src_req_ready <= ~src_fifo_full;\n            \n            if (src_req_valid & src_req_ready) begin\n                src_fifo_addr <= src_paddr_i;\n                src_fifo_wdata <= src_pwdata_i;\n                src_fifo_wstrb <= src_pstrb_i;\n                src_fifo_wen <= 1'b1;\n                src_fifo_valid <= 1'b1;\n                src_pready_o <= 1'b0;\n            end else if (src_fifo_valid & src_fifo_ready) begin\n                src_fifo_wen <= 1'b0;\n                src_fifo_valid <= 1'b0;\n                src_pready_o <= 1'b1;\n            end\n\n            // Response Generation\n            src_resp_valid <= dst_resp_valid;\n            src_resp_ready <= ~src_fifo_empty;\n            \n            if (src_resp_valid & src_resp_ready) begin\n                src_prdata_o <= dst_prdata_i;\n                src_pslverr_o <= dst_pslverr_i;\n            end else if (src_resp_valid & src_resp_ready) begin\n                // Handshake completed, reset response\n                src_prdata_o <= '0;\n                src_pslverr_o <= 1'b0;\n            end\n\n            // Destination Request Generation\n            dst_req_valid <= src_fifo_valid;\n            dst_req_ready <= ~dst_fifo_full;\n            \n            if (dst_req_valid & dst_req_ready) begin\n                dst_psel_o <= 1'b1;\n                dst_penable_o <= 1'b1;\n                dst_pwrite_o <= src_pwrite_i;\n                dst_paddr_o <= src_fifo_addr;\n                dst_pwdata_o <= src_fifo_wdata;\n                dst_pstrb_o <= src_fifo_wstrb;\n                dst_pprot_o <= src_pprot_i;\n            end else if (dst_req_valid & dst_req_ready) begin\n                // Wait for ready, do nothing else\n            end\n\n            // Destination Response Handling\n            dst_resp_ready_int <= ~dst_fifo_empty;\n            if (dst_pready_i & dst_req_valid) begin\n                dst_resp_valid <= 1'b1;\n                dst_prdata_i <= dst_prdata_i; // Capture data\n                dst_pslverr_i <= dst_pslverr_i; // Capture error\n            end else if (dst_pready_i & dst_req_valid) begin\n                // Handshake completed\n                dst_resp_valid <= 1'b0;\n            end\n        end\n    end\n\n    // Source Side FIFO Logic\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_fifo_full <= 1'b0;\n            src_fifo_empty <= 1'b1;\n        end else begin\n            if (src_fifo_valid & src_fifo_ready) begin\n                if (src_fifo_empty) begin\n                    src_fifo_empty <= 1'b0;\n                end\n                if (!src_fifo_full) begin\n                    src_fifo_full <= 1'b1;\n                end\n            end else if (~src_fifo_valid & src_fifo_ready) begin\n                if (src_fifo_full) begin\n                    src_fifo_full <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // Destination Side FIFO Logic\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_fifo_full <= 1'b0;\n            dst_fifo_empty <= 1'b1;\n        end else begin\n            if (dst_req_valid & dst_pready_i) begin\n                if (dst_fifo_empty) begin\n                    dst_fifo_empty <= 1'b0;\n                end\n                if (!dst_fifo_full) begin\n                    dst_fifo_full <= 1'b1;\n                end\n            end else if (~dst_req_valid & dst_pready_i) begin\n                if (dst_fifo_full) begin\n                    dst_fifo_full <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // Response FIFO Logic (Read from Dest, Write to Src)\n    // This is a simple buffer since we just need to pass the response back\n    // We use a single register to hold the response until the source is ready\n    reg [DATA_WIDTH-1:0]    resp_data_reg;\n    reg [DATA_WIDTH/8-1:0]  resp_strb_reg;\n    reg                     resp_valid_reg;\n    reg                     resp_ready_reg;\n\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            resp_data_reg <= '0;\n            resp_strb_reg <= '0;\n            resp_valid_reg <= 1'b0;\n            resp_ready_reg <= 1'b1;\n        end else begin\n            // Capture response when destination provides it\n            if (dst_pready_i & dst_req_valid) begin\n                resp_data_reg <= dst_prdata_i;\n                resp_strb_reg <= dst_pstrb_i; // Not used in response, but for completeness\n                resp_valid_reg <= 1'b1;\n            end else if (dst_pready_i & dst_req_valid) begin\n                // Handshake completed, reset\n                resp_valid_reg <= 1'b0;\n            end\n            \n            // Drive response to source\n            src_prdata_o <= resp_data_reg;\n            src_pslverr_o <= dst_pslverr_i;\n        end\n    end\n\n    // Handshake logic for response\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_resp_ready <= 1'b1;\n        end else begin\n            dst_resp_ready <= ~src_fifo_empty;\n        end\n    end\n\n    // Handshake logic for request\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_req_ready <= 1'b1;\n        end else begin\n            dst_req_ready <= ~dst_fifo_full;\n        end\n    end\n\n    // Handshake logic for source request\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_req_ready <= 1'b1;\n        end else begin\n            src_req_ready <= ~src_fifo_full;\n        end\n    end\n\n    // Handshake logic for source response\n    always @(posedge src_pclk_i or negedge src_preset_ni) begin\n        if (!src_preset_ni) begin\n            src_resp_ready <= 1'b1;\n        end else begin\n            src_resp_ready <= ~src_fifo_empty;\n        end\n    end\n\n    // Handshake logic for destination response\n    always @(posedge dst_pclk_i or negedge dst_preset_ni) begin\n        if (!dst_preset_ni) begin\n            dst_resp_ready_int <= 1'b1;\n        end else begin\n            dst_resp_ready_int <= ~dst_fifo_empty;\n        end\n    end\n\n    // Final output assignments\n    assign dst_pready_o = dst_pready_i;\n    assign dst_prdata_o = dst_prdata_i;\n    assign dst_pslverr_o = dst_pslverr_i;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
