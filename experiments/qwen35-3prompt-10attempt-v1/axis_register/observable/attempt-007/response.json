  "text": "```verilog\nmodule axis_register #\n(\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter REG_TYPE = 2\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI Stream input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI Stream output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser\n);\n\n    // Internal state registers\n    reg [DATA_WIDTH-1:0] reg_tdata;\n    reg [KEEP_WIDTH-1:0] reg_tkeep;\n    reg reg_tlast;\n    reg reg_tid [ID_WIDTH-1:0];\n    reg reg_tdest [DEST_WIDTH-1:0];\n    reg reg_tuser [USER_WIDTH-1:0];\n    reg reg_valid;\n\n    // Control signals\n    wire s_axis_tvalid_and_ready;\n    wire m_axis_tvalid_and_ready;\n    wire stall;\n\n    assign s_axis_tvalid_and_ready = s_axis_tvalid & m_axis_tready;\n    assign m_axis_tvalid_and_ready = m_axis_tvalid & s_axis_tready;\n    assign stall = (s_axis_tvalid_and_ready) & (~m_axis_tvalid_and_ready);\n\n    // Reset logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            reg_tdata <= 0;\n            reg_tkeep <= 0;\n            reg_tlast <= 0;\n            reg_tid <= 0;\n            reg_tdest <= 0;\n            reg_tuser <= 0;\n            reg_valid <= 0;\n        end else begin\n            // Logic based on REG_TYPE\n            // 0: Wire (Pass-through, no storage)\n            // 1: Buffer (Store one beat, output on valid)\n            // 2: Skid Buffer (Store one beat, output on ready, keep pending data intact)\n            \n            if (REG_TYPE == 0) begin\n                // Wire behavior\n                reg_tdata <= s_axis_tdata;\n                reg_tkeep <= s_axis_tkeep;\n                reg_tlast <= s_axis_tlast;\n                reg_tid <= s_axis_tid;\n                reg_tdest <= s_axis_tdest;\n                reg_tuser <= s_axis_tuser;\n                reg_valid <= s_axis_tvalid;\n            end else if (REG_TYPE == 1) begin\n                // Buffer behavior\n                if (s_axis_tvalid_and_ready) begin\n                    reg_tdata <= s_axis_tdata;\n                    reg_tkeep <= s_axis_tkeep;\n                    reg_tlast <= s_axis_tlast;\n                    reg_tid <= s_axis_tid;\n                    reg_tdest <= s_axis_tdest;\n                    reg_tuser <= s_axis_tuser;\n                    reg_valid <= 1;\n                end else if (m_axis_tvalid_and_ready) begin\n                    reg_valid <= 0;\n                end\n            end else if (REG_TYPE == 2) begin\n                // Skid Buffer behavior\n                if (s_axis_tvalid_and_ready) begin\n                    reg_tdata <= s_axis_tdata;\n                    reg_tkeep <= s_axis_tkeep;\n                    reg_tlast <= s_axis_tlast;\n                    reg_tid <= s_axis_tid;\n                    reg_tdest <= s_axis_tdest;\n                    reg_tuser <= s_axis_tuser;\n                    reg_valid <= 1;\n                end else if (m_axis_tvalid_and_ready) begin\n                    reg_valid <= 0;\n                end\n            end\n        end\n    end\n\n    // Output logic\n    always @(*) begin\n        m_axis_tdata = reg_tdata;\n        m_axis_tkeep = reg_tkeep;\n        m_axis_tlast = reg_tlast;\n        m_axis_tid = reg_tid;\n        m_axis_tdest = reg_tdest;\n        m_axis_tuser = reg_tuser;\n        m_axis_tvalid = reg_valid;\n        s_axis_tready = m_axis_tready;\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
