  "text": "```verilog\nmodule axis_register #\n(\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter REG_TYPE = 2\n)\n(\n    input  wire                   clk,\n    input  wire                   rst,\n    /*\n     * AXI Stream input\n     */\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI Stream output\n     */\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser\n);\n\n    // Local parameters for width checks to avoid synthesis warnings\n    localparam int WIDTH_DATA = DATA_WIDTH;\n    localparam int WIDTH_KEEP = KEEP_ENABLE ? KEEP_WIDTH : 1;\n    localparam int WIDTH_LAST = LAST_ENABLE ? 1 : 0;\n    localparam int WIDTH_ID = ID_ENABLE ? ID_WIDTH : 1;\n    localparam int WIDTH_DEST = DEST_ENABLE ? DEST_WIDTH : 1;\n    localparam int WIDTH_USER = USER_ENABLE ? USER_WIDTH : 1;\n\n    // Internal state registers\n    reg [WIDTH_DATA-1:0]  reg_tdata;\n    reg [WIDTH_KEEP-1:0]  reg_tkeep;\n    reg                   reg_tlast;\n    reg [WIDTH_ID-1:0]    reg_tid;\n    reg [WIDTH_DEST-1:0]  reg_tdest;\n    reg [WIDTH_USER-1:0]  reg_tuser;\n    reg                   reg_valid;\n\n    // Output registers\n    reg [WIDTH_DATA-1:0]  out_tdata;\n    reg [WIDTH_KEEP-1:0]  out_tkeep;\n    reg                   out_tlast;\n    reg [WIDTH_ID-1:0]    out_tid;\n    reg [WIDTH_DEST-1:0]  out_tdest;\n    reg [WIDTH_USER-1:0]  out_tuser;\n    reg                   out_valid;\n\n    // Skid buffer depth (for REG_TYPE 2)\n    // We need at least 1 beat to allow stalling. \n    // A depth of 2 allows the input to stall for 1 cycle while output drains.\n    localparam int SKID_DEPTH = 2;\n\n    // Input FIFO for Skid Buffer (REG_TYPE 2)\n    // Stores {valid, tdata, tkeep, tlast, tid, tdest, tuser}\n    reg [1:0]              fifo_valid;\n    reg [WIDTH_DATA-1:0]   fifo_tdata;\n    reg [WIDTH_KEEP-1:0]   fifo_tkeep;\n    reg                    fifo_tlast;\n    reg [WIDTH_ID-1:0]     fifo_tid;\n    reg [WIDTH_DEST-1:0]   fifo_tdest;\n    reg [WIDTH_USER-1:0]   fifo_tuser;\n\n    // Output FIFO for Skid Buffer (REG_TYPE 2)\n    // Stores {valid, tdata, tkeep, tlast, tid, tdest, tuser}\n    reg [1:0]              fifo_out_valid;\n    reg [WIDTH_DATA-1:0]   fifo_out_tdata;\n    reg [WIDTH_KEEP-1:0]   fifo_out_tkeep;\n    reg                    fifo_out_tlast;\n    reg [WIDTH_ID-1:0]     fifo_out_tid;\n    reg [WIDTH_DEST-1:0]   fifo_out_tdest;\n    reg [WIDTH_USER-1:0]   fifo_out_tuser;\n\n    // Wire for internal ready signals\n    wire                   in_ready;\n    wire                   out_ready;\n\n    assign in_ready = (REG_TYPE == 2) ? m_axis_tready : m_axis_tready;\n    assign out_ready = (REG_TYPE == 2) ? m_axis_tready : 1'b1;\n\n    // --- Logic for REG_TYPE 0 (Wire) ---\n    // Pass-through immediately. No storage.\n    if (REG_TYPE == 0) begin\n        assign s_axis_tready = m_axis_tready;\n        assign m_axis_tdata = s_axis_tdata;\n        assign m_axis_tkeep = s_axis_tkeep;\n        assign m_axis_tvalid = s_axis_tvalid;\n        assign m_axis_tlast = s_axis_tlast;\n        assign m_axis_tid = s_axis_tid;\n        assign m_axis_tdest = s_axis_tdest;\n        assign m_axis_tuser = s_axis_tuser;\n    end\n\n    // --- Logic for REG_TYPE 1 (Simple Buffer) ---\n    // Single cycle storage.\n    else if (REG_TYPE == 1) begin\n        // Input stage\n        always @(posedge clk or posedge rst) begin\n            if (rst) begin\n                reg_tdata <= 0;\n                reg_tkeep <= 0;\n                reg_tlast <= 0;\n                reg_tid <= 0;\n                reg_tdest <= 0;\n                reg_tuser <= 0;\n                reg_valid <= 0;\n            end else begin\n                if (s_axis_tvalid && in_ready) begin\n                    reg_tdata <= s_axis_tdata;\n                    reg_tkeep <= s_axis_tkeep;\n                    reg_tlast <= s_axis_tlast;\n                    reg_tid <= s_axis_tid;\n                    reg_tdest <= s_axis_tdest;\n                    reg_tuser <= s_axis_tuser;\n                    reg_valid <= 1'b1;\n                end else begin\n                    reg_valid <= 1'b0;\n                end\n            end\n        end\n\n        // Output stage\n        always @(posedge clk or posedge rst) begin\n            if (rst) begin\n                out_tdata <= 0;\n                out_tkeep <= 0;\n                out_tlast <= 0;\n                out_tid <= 0;\n                out_tdest <= 0;\n                out_tuser <= 0;\n                out_valid <= 0;\n            end else begin\n                if (reg_valid && out_ready) begin\n                    out_tdata <= reg_tdata;\n                    out_tkeep <= reg_tkeep;\n                    out_tlast <= reg_tlast;\n                    out_tid <= reg_tid;\n                    out_tdest <= reg_tdest;\n                    out_tuser <= reg_tuser;\n                    out_valid <= 1'b1;\n                end else begin\n                    out_valid <= 1'b0;\n                end\n            end\n        end\n\n        assign s_axis_tready = (reg_valid) ? out_ready : 1'b1;\n        assign m_axis_tdata = out_tdata;\n        assign m_axis_tkeep = out_tkeep;\n        assign m_axis_tvalid = out_valid;\n        assign m_axis_tlast = out_tlast;\n        assign m_axis_tid = out_tid;\n        assign m_axis_tdest = out_tdest;\n        assign m_axis_tuser = out_tuser;\n    end\n\n    // --- Logic for REG_TYPE 2 (Skid Buffer) ---\n    // Must not drop a beat when output stalls.\n    else begin\n        // Input Stage: Write to FIFO\n        always @(posedge clk or posedge rst) begin\n            if (rst) begin\n                fifo_valid <= 0;\n                fifo_tdata <= 0;\n                fifo_tkeep <= 0;\n                fifo_tlast <= 0;\n                fifo_tid <= 0;\n                fifo_tdest <= 0;\n                fifo_tuser <= 0;\n            end else begin\n                if (s_axis_tvalid && in_ready) begin\n                    fifo_valid <= 1'b1;\n                    fifo_tdata <= s_axis_tdata;\n                    fifo_tkeep <= s_axis_tkeep;\n                    fifo_tlast <= s_axis_tlast;\n                    fifo_tid <= s_axis_tid;\n                    fifo_tdest <= s_axis_tdest;\n                    fifo_tuser <= s_axis_tuser;\n                end else begin\n                    fifo_valid <= 1'b0;\n                end\n            end\n        end\n\n        // Output Stage: Read from FIFO\n        always @(posedge clk or posedge rst) begin\n            if (rst) begin\n                fifo_out_valid <= 0;\n                fifo_out_tdata <= 0;\n                fifo_out_tkeep <= 0;\n                fifo_out_tlast <= 0;\n                fifo_out_tid <= 0;\n                fifo_out_tdest <= 0;\n                fifo_out_tuser <= 0;\n            end else begin\n                if (fifo_out_valid && out_ready) begin\n                    fifo_out_valid <= 1'b0;\n                    fifo_out_tdata <= 0;\n                    fifo_out_tkeep <= 0;\n                    fifo_out_tlast <= 0;\n                    fifo_out_tid <= 0;\n                    fifo_out_tdest <= 0;\n                    fifo_out_tuser <= 0;\n                end else begin\n                    fifo_out_valid <= 1'b1;\n                    fifo_out_tdata <= fifo_tdata;\n                    fifo_out_tkeep <= fifo_tkeep;\n                    fifo_out_tlast <= fifo_tlast;\n                    fifo_out_tid <= fifo_tid;\n                    fifo_out_tdest <= fifo_tdest;\n                    fifo_out_tuser <= fifo_tuser;\n                end\n            end\n        end\n\n        assign s_axis_tready = (fifo_valid) ? out_ready : 1'b1;\n        assign m_axis_tdata = fifo_out_tdata;\n        assign m_axis_tkeep = fifo_out_tkeep;\n        assign m_axis_tvalid = fifo_out_valid;\n        assign m_axis_tlast = fifo_out_tlast;\n        assign m_axis_tid = fifo_out_tid;\n        assign m_axis_tdest = fifo_out_tdest;\n        assign m_axis_tuser = fifo_out_tuser;\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
