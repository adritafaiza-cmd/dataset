{
  "text": "module edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // CDC Strategy:\n  // 1. Capture the input edge in the TX domain using a flip-flop to synchronize it to clk_tx_i.\n  // 2. Detect the rising edge of this synchronized signal within the TX domain to identify a pulse/transition.\n  // 3. Use a 2-FIFO (or 2-stage synchronizer + edge detector) approach to transfer the \"edge detected\" event to the RX domain.\n    //    Since we only need to propagate a single event (the edge), a 2-stage synchronizer on the \"edge detected\" signal is sufficient.\n    //    However, to ensure we don't double-count or lose edges due to metastability or glitches, we will:\n    //    a) Detect the edge in TX.\n    //    b) Synchronize the \"edge detected\" flag to RX using a 2-stage synchronizer.\n    //    c) Use a simple edge detector in RX to generate the output pulse.\n    //    This ensures the event is safely transferred across the clock domain boundary.\n\n  // Stage 1: Synchronize input edge to TX domain (though it's already in TX, we capture it to avoid metastability if edge_i is from another async source, \n  // but per spec edge_i is in TX domain. We need to detect the transition in TX).\n  \n  // Let's refine: \n  // edge_i is in TX domain. We need to detect if it changed (rising or falling? Spec says \"pulse or edge\"). \n  // Usually \"edge propagator\" implies detecting a rising edge or a transition. \n  // \"A pulse or edge on edge_i ... produce one pulse\". \n  // If edge_i goes high then low (pulse), we want one pulse out.\n  // If edge_i goes low then high (edge), we want one pulse out.\n  // So we detect any transition.\n  \n  // Approach:\n  // 1. In TX domain: Detect if edge_i changed from previous cycle. Store this \"change\" signal.\n  // 2. Transfer the \"change\" signal to RX domain using a 2-stage synchronizer (safe for CDC).\n  // 3. In RX domain: Detect the rising edge of the synchronized \"change\" signal to generate the output pulse.\n  //    This ensures exactly one pulse is generated per transition in TX.\n\n  logic edge_synced_tx;\n  logic edge_change_tx;\n  logic edge_synced_rx_1;\n  logic edge_synced_rx_2;\n  logic edge_change_rx;\n\n  // --- TX Domain Logic ---\n  \n  // Capture edge_i to detect transitions. \n  // We use a register to store the previous value of edge_i.\n  // Note: rstn_tx_i is active low.\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      edge_synced_tx <= 1'b0;\n    end else begin\n      edge_synced_tx <= edge_i;\n    end\n  end\n\n  // Detect transition in TX domain\n  // We compare current edge_synced_tx with previous value.\n  // We need to store the previous value of edge_synced_tx.\n  logic edge_synced_tx_prev;\n  \n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      edge_synced_tx_prev <= 1'b0;\n    end else begin\n      edge_synced_tx_prev <= edge_synced_tx;\n    end\n  end\n\n  // Generate the \"change\" signal in TX domain\n  // A change occurs if the current value is different from the previous value.\n  // We use a latch or register to hold the change signal until it is synchronized out.\n  // To prevent double counting, we only assert change when a transition is detected.\n  // We will use a register to hold the change signal, resetting it after one cycle in TX? \n  // Actually, the standard way is to detect the edge, then synchronize that single-bit event to RX.\n  // Since the event is a single bit (did a change happen?), we can just synchronize the 'change' signal.\n  // But we must ensure the 'change' signal is stable for at least one clock cycle in TX before being sampled by RX synchronizer.\n  // So we register the change signal in TX.\n  \n  logic edge_change_tx_reg;\n  \n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      edge_change_tx_reg <= 1'b0;\n    end else begin\n      edge_change_tx_reg <= (edge_synced_tx != edge_synced_tx_prev);\n    end\n  end\n\n  // --- CDC Synchronization (TX to RX) ---\n  // 2-Stage Synchronizer for the edge_change_tx_reg signal.\n  // This is safe for asynchronous clock domains.\n  \n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      edge_synced_rx_1 <= 1'b0;\n    end else begin\n      edge_synced_rx_1 <= edge_change_tx_reg;\n    end\n  end\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      edge_synced_rx_2 <= 1'b0;\n    end else begin\n      edge_synced_rx_2 <= edge_synced_rx_1;\n    end\n  end\n\n  // --- RX Domain Logic ---\n  // Now we have the synchronized \"change\" signal in the RX domain (edge_synced_rx_2).\n  // We need to detect the rising edge of this signal to generate the output pulse.\n  // This ensures that even if the TX domain had multiple cycles of change (glitches), \n  // the RX domain sees a clean single transition because the synchronizer filters them.\n  // However, we must ensure we don't double count if the TX domain signal stays high for multiple cycles.\n  // The logic above: edge_change_tx_reg is asserted for exactly one cycle in TX when a transition happens.\n  // The synchronizer transfers this single-cycle pulse to RX.\n  // Then we detect the rising edge of the synchronized signal in RX.\n  \n  logic edge_synced_rx_2_prev;\n  \n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      edge_synced_rx_2_prev <= 1'b0;\n    end else begin\n      edge_synced_rx_2_prev <= edge_synced_rx_2;\n    end\n  end\n\n  // Generate output pulse on rising edge of the synchronized change signal\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      edge_o <= 1'b0;\n    end else begin\n      edge_o <= (edge_synced_rx_2 && !edge_synced_rx_2_prev);\n    end\n  end\n\nendmodule<|im_end|>\n<|endoftext|>",
