{
  "text": "```systemverilog\nmodule edge_propagator (\n  input  logic clk_tx_i,\n  input  logic rstn_tx_i,\n  input  logic edge_i,\n  input  logic clk_rx_i,\n  input  logic rstn_rx_i,\n  output logic edge_o\n);\n\n  // Synchronizer for the input event from the transmit clock domain\n  // Uses a 2-stage synchronizer to filter out metastability\n  logic sync_edge_1;\n  logic sync_edge_2;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      sync_edge_1 <= 1'b0;\n      sync_edge_2 <= 1'b0;\n    end else begin\n      sync_edge_1 <= edge_i;\n      sync_edge_2 <= sync_edge_1;\n    end\n  end\n\n  // Pulse generator to create a single-cycle pulse on the transmit side\n  // This ensures the event is captured as a single event without duplication\n  logic tx_pulse;\n\n  always_ff @(posedge clk_tx_i or negedge rstn_tx_i) begin\n    if (!rstn_tx_i) begin\n      tx_pulse <= 1'b0;\n    end else begin\n      if (sync_edge_2 && !sync_edge_1) begin\n        tx_pulse <= 1'b1;\n      end else begin\n        tx_pulse <= 1'b0;\n      end\n    end\n  end\n\n  // Clock domain crossing from transmit to receive\n  // Synchronize the pulse signal to the receive clock domain\n  logic rx_sync_pulse_1;\n  logic rx_sync_pulse_2;\n\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      rx_sync_pulse_1 <= 1'b0;\n      rx_sync_pulse_2 <= 1'b0;\n    end else begin\n      rx_sync_pulse_1 <= tx_pulse;\n      rx_sync_pulse_2 <= rx_sync_pulse_1;\n    end\n  end\n\n  // Generate the output pulse on the receive side\n  // Ensure the output is a single-cycle pulse and reset properly\n  always_ff @(posedge clk_rx_i or negedge rstn_rx_i) begin\n    if (!rstn_rx_i) begin\n      edge_o <= 1'b0;\n    end else begin\n      if (rx_sync_pulse_2 && !rx_sync_pulse_1) begin\n        edge_o <= 1'b1;\n      end else begin\n        edge_o <= 1'b0;\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
