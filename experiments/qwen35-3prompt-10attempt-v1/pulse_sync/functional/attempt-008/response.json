{
  "text": "module pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Internal signals\n    wire [STAGES-1:0] state_a;\n    wire [STAGES-1:0] state_b;\n    wire pulseA_valid;\n    wire pulseB_valid;\n\n    // State encoding:\n    // 0: Idle\n    // 1: Pulse detected in domain A, propagating\n    // 2: Pulse detected in domain B, propagating\n    // We use a counter-like approach where we count up on detection and down on propagation\n    // to ensure the pulse width is exactly one cycle in the destination domain.\n\n    // Domain A Logic\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a) begin\n            state_a <= 0;\n        end else begin\n            case (state_a)\n                0: begin\n                    if (pulseA_i)\n                        state_a <= 1;\n                    else\n                        state_a <= 0;\n                end\n                1: begin\n                    // Once a pulse is detected, we stay in state 1 for exactly one cycle\n                    // to generate the pulse in domain B, then return to idle.\n                    // However, to prevent re-triggering if pulseA_i stays high,\n                    // we only transition back to 0 after one full cycle.\n                    // But the requirement says \"one-cycle pulse\".\n                    // Strategy: Detect edge or level? Usually level with one-cycle output.\n                    // If pulseA_i is high for multiple cycles, we only want ONE output pulse.\n                    // So we stay in state 1 for one cycle, then go to 0.\n                    // But we must ignore new pulses while busy.\n                    // Let's refine: State 1 means \"Pulse in flight\".\n                    // If we are in state 1, we ignore new pulseA_i.\n                    // After one cycle, we go to 0.\n                    state_a <= 0;\n                end\n                default: state_a <= 0;\n            endcase\n        end\n    end\n\n    // Domain B Logic\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            state_b <= 0;\n        end else begin\n            case (state_b)\n                0: begin\n                    if (pulseA_valid)\n                        state_b <= 1;\n                    else\n                        state_b <= 0;\n                end\n                1: begin\n                    state_b <= 0;\n                end\n                default: state_b <= 0;\n            endcase\n        end\n    end\n\n    // Generate pulseA_valid: High for exactly one cycle in domain A when pulseA_i goes high\n    // This ensures that even if pulseA_i is wide, we only send one trigger to domain B.\n    // Actually, the logic above in state_a handles the \"ignore while busy\" and \"one pulse\" requirement.\n    // pulseA_valid is simply the signal that indicates a pulse is currently being processed in domain A.\n    assign pulseA_valid = (state_a == 1);\n\n    // Generate pulseB_valid: High for exactly one cycle in domain B when state_b is 1\n    // This ensures the output is a one-cycle pulse.\n    assign pulseB_valid = (state_b == 1);\n\n    // Output assignments\n    assign pulseB_o = pulseB_valid;\n    assign busy_o = (state_a == 1) | (state_b == 1);\n\nendmodule<|im_end|>\n<|endoftext|>",
