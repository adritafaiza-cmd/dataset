{
  "text": "module pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Internal state machine to track pulse capture and transfer\n    // States: IDLE, CAPTURE, TRANSFER\n    localparam [2:0] STATE_IDLE = 3'd0;\n    localparam [2:0] STATE_CAP = 3'd1;\n    localparam [2:0] STATE_TRF = 3'd2;\n\n    reg [2:0] state_a, state_b;\n    reg pulseA_d;\n    reg pulseB_d;\n    reg busy_d;\n\n    // Domain A Logic: Capture pulse from pulseA_i\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a) begin\n            state_a <= STATE_IDLE;\n            pulseA_d <= 1'b0;\n        end else begin\n            case (state_a)\n                STATE_IDLE: begin\n                    if (pulseA_i)\n                        state_a <= STATE_CAP;\n                    else\n                        state_a <= STATE_IDLE;\n                end\n                STATE_CAP: begin\n                    if (!pulseA_i)\n                        state_a <= STATE_TRF;\n                    else\n                        state_a <= STATE_CAP;\n                end\n                STATE_TRF: begin\n                    state_a <= STATE_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Domain B Logic: Generate pulse from captured signal\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            state_b <= STATE_IDLE;\n            pulseB_d <= 1'b0;\n            busy_d <= 1'b0;\n        end else begin\n            case (state_b)\n                STATE_IDLE: begin\n                    if (pulseA_d)\n                        state_b <= STATE_CAP;\n                    else\n                        state_b <= STATE_IDLE;\n                end\n                STATE_CAP: begin\n                    if (!pulseA_d)\n                        state_b <= STATE_TRF;\n                    else\n                        state_b <= STATE_CAP;\n                end\n                STATE_TRF: begin\n                    state_b <= STATE_IDLE;\n                end\n            endcase\n        end\n    end\n\n    // Output assignments\n    assign pulseB_o = pulseB_d;\n    assign busy_o = (state_a == STATE_CAP) || (state_b == STATE_CAP) || (state_b == STATE_TRF);\n\nendmodule<|im_end|>\n<|endoftext|>",
