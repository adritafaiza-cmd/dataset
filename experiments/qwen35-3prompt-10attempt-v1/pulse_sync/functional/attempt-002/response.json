  "text": "module pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // Internal signals\n    reg [STAGES-1:0] shift_reg;\n    reg busy;\n\n    // Stage 0: Capture pulse from domain A\n    // We use a 2-stage pipeline for domain A to ensure setup/hold met with single-cycle pulse\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            shift_reg[0] <= 1'b0;\n        else\n            shift_reg[0] <= pulseA_i;\n    end\n\n    // Pipeline stages for domain A to serialize the pulse\n    genvar i;\n    generate\n        for (i = 1; i < STAGES; i = i + 1) begin : a_pipeline\n            always @(posedge clk_a or negedge rstn_a) begin\n                if (!rstn_a)\n                    shift_reg[i] <= 1'b0;\n                else\n                    shift_reg[i] <= shift_reg[i-1];\n            end\n        end\n    endgenerate\n\n    // Detect pulse in domain A (rising edge of the last stage)\n    // This indicates a new pulse has arrived\n    reg pulse_detected;\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            pulse_detected <= 1'b0;\n        else\n            pulse_detected <= (shift_reg[STAGES-1] && !shift_reg[STAGES-2]);\n    end\n\n    // Domain B logic: Capture and serialize the pulse\n    // We need to capture the pulse_detected signal and ensure it appears as a single cycle\n    // in domain B. We use a similar pipeline approach.\n    \n    // Capture the pulse detection in domain B\n    reg [STAGES-1:0] b_shift_reg;\n    reg b_pulse_detected;\n\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b) begin\n            b_shift_reg <= {STAGES{1'b0}};\n            busy <= 1'b0;\n            pulseB_o <= 1'b0;\n        end\n        else begin\n            // Shift register for domain B\n            b_shift_reg[0] <= pulse_detected;\n            for (i = 1; i < STAGES; i = i + 1) begin\n                b_shift_reg[i] <= b_shift_reg[i-1];\n            end\n            \n            // Detect rising edge in domain B to start the pulse\n            b_pulse_detected <= (b_shift_reg[STAGES-1] && !b_shift_reg[STAGES-2]);\n            \n            // busy is high if we are in the middle of processing a pulse\n            // It's high from the moment we detect the pulse until the pulse is fully serialized\n            busy <= (b_shift_reg[STAGES-1] || b_shift_reg[STAGES-2]);\n            \n            // Output the pulse in domain B\n            // The pulse should be one cycle wide in domain B\n            // We output when the pulse is at the last stage of our B pipeline\n            pulseB_o <= b_shift_reg[STAGES-1];\n        end\n    end\n\n    // Assign output registers\n    assign pulseB_o = b_shift_reg[STAGES-1];\n    assign busy_o = busy;\n\nendmodule<|im_end|>\n<|endoftext|>",
