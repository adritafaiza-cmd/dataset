  "text": "```verilog\nmodule pulse_sync #(\n    parameter STAGES = 2\n)(\n    input  clk_a,\n    input  rstn_a,\n    input  clk_b,\n    input  rstn_b,\n    input  pulseA_i,\n    output pulseB_o,\n    output busy_o\n);\n\n    // ---------------------------------------------------------\n    // Clock Domain A: Capture the input pulse and detect edges\n    // ---------------------------------------------------------\n    reg pulseA_d;\n    reg pulseA_edge;\n    reg [STAGES-1:0] sync_pulseA;\n    reg busy_a;\n\n    // Synchronize input pulse\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            pulseA_d <= 1'b0;\n        else\n            pulseA_d <= pulseA_i;\n    end\n\n    // Detect rising edge of the pulse in domain A\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            pulseA_edge <= 1'b0;\n        else if (pulseA_d && ~pulseA_d) // Transition from 0 to 1\n            pulseA_edge <= 1'b1;\n        else\n            pulseA_edge <= 1'b0;\n    end\n\n    // Synchronize the edge to domain B (Gray code or simple shift register)\n    // Using a shift register to create a multi-cycle pulse in domain B\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            sync_pulseA <= {STAGES{1'b0}};\n        else\n            sync_pulseA <= {sync_pulseA[STAGES-2:0], pulseA_edge};\n    end\n\n    // Determine if we are busy in domain A\n    // Busy if the edge has been detected but not yet fully synchronized to B\n    // We consider it busy if the last STAGES bits are not all zero\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            busy_a <= 1'b0;\n        else\n            busy_a <= |sync_pulseA;\n    end\n\n    // ---------------------------------------------------------\n    // Clock Domain B: Generate the output pulse and manage state\n    // ---------------------------------------------------------\n    reg [STAGES-1:0] sync_pulseB;\n    reg busy_b;\n    reg pulseB_d;\n    reg pulseB_edge;\n\n    // Synchronize the incoming pulse from A to domain B\n    // We use the same shift register logic but driven by sync_pulseA\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            sync_pulseB <= {STAGES{1'b0}};\n        else\n            sync_pulseB <= {sync_pulseB[STAGES-2:0], sync_pulseA[STAGES-1]};\n    end\n\n    // Detect the pulse in domain B\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            pulseB_d <= 1'b0;\n        else\n            pulseB_d <= sync_pulseB[STAGES-1];\n    end\n\n    // Generate the output pulse (one-shot)\n    // We output high for one cycle when the synchronized pulse arrives\n    // and ensure we don't re-trigger while busy\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            pulseB_o <= 1'b0;\n        else if (sync_pulseB[STAGES-1] && !pulseB_d)\n            pulseB_o <= 1'b1;\n        else\n            pulseB_o <= 1'b0;\n    end\n\n    // Detect rising edge of the output pulse in domain B to track state\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            pulseB_edge <= 1'b0;\n        else if (pulseB_o && ~pulseB_d)\n            pulseB_edge <= 1'b1;\n        else\n            pulseB_edge <= 1'b0;\n    end\n\n    // Synchronize the output edge back to domain A to update busy status\n    reg [STAGES-1:0] sync_pulseB_edge;\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            sync_pulseB_edge <= {STAGES{1'b0}};\n        else\n            sync_pulseB_edge <= {sync_pulseB_edge[STAGES-2:0], pulseB_edge};\n    end\n\n    // Determine busy status in domain A\n    // Busy if the output pulse is currently in flight (synchronized edge is present)\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            busy_o <= 1'b0;\n        else\n            busy_o <= |sync_pulseB_edge;\n    end\n\n    // ---------------------------------------------------------\n    // Cross-domain handshake for busy signal\n    // To ensure the \"busy\" flag is accurate across domains, we need to \n    // synchronize the busy signal from B back to A properly.\n    // However, the requirement is: \"Indicate when one is in flight, ignore further pulses while busy\".\n    // The logic above handles the \"ignore\" part in domain A by checking sync_pulseA.\n    // The \"busy_o\" output is driven by domain A's view of the busy state.\n    \n    // Re-evaluating the busy logic to ensure robustness:\n    // The \"busy\" state should be high from the moment the pulse enters the FIFO/shift register \n    // until it has been fully processed and the output pulse is complete.\n    \n    // Let's refine the busy logic in Domain A to reflect the state in Domain B accurately.\n    // We will synchronize the 'busy_b' signal from B to A.\n    \n    reg busy_b_reg;\n    reg [STAGES-1:0] sync_busy_b;\n\n    // Calculate busy in Domain B: Busy if sync_pulseB is not all zeros\n    always @(posedge clk_b or negedge rstn_b) begin\n        if (!rstn_b)\n            busy_b_reg <= 1'b0;\n        else\n            busy_b_reg <= |sync_pulseB;\n    end\n\n    // Synchronize busy_b_reg to Domain A\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            sync_busy_b <= {STAGES{1'b0}};\n        else\n            sync_busy_b <= {sync_busy_b[STAGES-2:0], busy_b_reg};\n    end\n\n    // Final busy output in Domain A\n    always @(posedge clk_a or negedge rstn_a) begin\n        if (!rstn_a)\n            busy_o <= 1'b0;\n        else\n            busy_o <= |sync_busy_b;\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
