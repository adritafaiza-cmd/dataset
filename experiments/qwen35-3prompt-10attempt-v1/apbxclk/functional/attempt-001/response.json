  "text": "```verilog\nmodule apbxclk #(\n\tparameter\tC_APB_ADDR_WIDTH = 12,\n\tparameter\tC_APB_DATA_WIDTH = 32,\n\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\tlocalparam\tDW = C_APB_DATA_WIDTH\n) (\n\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\tinput\twire\t\t\tS_APB_PSEL,\n\tinput\twire\t\t\tS_APB_PENABLE,\n\toutput\treg\t\t\tS_APB_PREADY,\n\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\tinput\twire\t\t\tS_APB_PWRITE,\n\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\toutput\twire\t\t\tS_APB_PSLVERR,\n\tinput\twire\t\t\tM_APB_PCLK,\n\toutput\treg\t\t\tM_PRESETn,\n\toutput\treg\t\t\tM_APB_PSEL,\n\toutput\treg\t\t\tM_APB_PENABLE,\n\tinput\twire\t\t\tM_APB_PREADY,\n\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\toutput\twire\t\t\tM_APB_PWRITE,\n\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\tinput\twire\t\t\tM_APB_PSLVERR\n);\n\n\tlocalparam\tAW_REG = OPT_REGISTERED ? 1 : 0;\n\tlocalparam\tDW_REG = OPT_REGISTERED ? 1 : 0;\n\n\treg [AW-1:0]\tfifo_addr;\n\treg [DW-1:0]\tfifo_data;\n\treg [DW/8-1:0]\tfifo_wstrb;\n\treg\t\t\tfifo_write;\n\treg\t\t\tfifo_valid;\n\treg\t\t\tfifo_ready;\n\treg\t\t\tfifo_busy;\n\treg\t\t\tfifo_error;\n\treg\t\t\tfifo_done;\n\n\t// Cross-clock FIFO for payload and response\n\t// When OPT_REGISTERED is 0, we still need to capture the data on the M clock\n\t// to ensure stability during the access phase, but we don't add extra registers\n\t// for the crossing itself beyond the necessary capture logic.\n\t// However, the requirement states: \"Crossing payload and response fields are captured once\n\t// in the receiving clock and then held.\"\n\t// If OPT_REGISTERED is 0, we capture on M clock edge. If 1, we explicitly register.\n\t// To satisfy \"captured once... and then held\" regardless of OPT_REGISTERED,\n\t// we use a simple register file or latch structure that holds the value until ready.\n\t// Since OPT_REGISTERED=0 implies no *extra* registers beyond the crossing,\n\t// but the data must be stable, we will use a single register stage on the M clock\n\t// to capture the data from S clock domain, then hold it until M_APB_PREADY.\n\t// Actually, standard async FIFO is safer and meets \"captured once... then held\".\n\t// But for a single outstanding transaction, a simple register on M clock is sufficient\n\t// to capture the data when the request arrives, provided we handle the clock domains correctly.\n\t// Let's implement a minimal async FIFO (1 depth) to ensure no loss and proper holding.\n\n\treg [AW-1:0]\tfifo_addr_reg;\n\treg [DW-1:0]\tfifo_data_reg;\n\treg [DW/8-1:0]\tfifo_wstrb_reg;\n\treg\t\t\tfifo_write_reg;\n\treg\t\t\tfifo_valid_reg;\n\treg\t\t\tfifo_ready_reg;\n\treg\t\t\tfifo_busy_reg;\n\treg\t\t\tfifo_error_reg;\n\treg\t\t\tfifo_done_reg;\n\n\t// Synchronous logic for Source side (S_APB_PCLK)\n\t// Capture request details when PSEL and PENABLE are asserted\n\t// and PREADY is not asserted (start of access phase).\n\t// APB protocol: PSEL + PENABLE -> PREADY low -> Access -> PREADY high.\n\t// We capture the request when PSEL is high, PENABLE is high, and PREADY is low.\n\t// We also need to capture the data if it's a write.\n\n\treg [AW-1:0]\ts_addr;\n\treg [DW-1:0]\ts_data;\n\treg [DW/8-1:0]\ts_wstrb;\n\treg\t\t\ts_write;\n\treg\t\t\ts_valid;\n\treg\t\t\ts_error;\n\n\t// Synchronous logic for Master side (M_APB_PCLK)\n\t// Drive the M_APB interface.\n\t// We need to hold the request stable until M_APB_PREADY goes high.\n\t// Then we capture the response (PRDATA, PSLVERR) and drive S_APB_PRDATA/SLVERR.\n\n\treg [AW-1:0]\tm_addr;\n\treg [DW-1:0]\tm_data;\n\treg [DW/8-1:0]\tm_wstrb;\n\treg\t\t\tm_write;\n\treg\t\t\tm_valid;\n\treg\t\t\tm_error;\n\treg\t\t\tm_ready;\n\n\t// Clock domain crossing logic\n\t// We use a simple 1-deep FIFO implemented with registers to cross the clock domains.\n\t// This ensures data is captured once on the receiving clock and held.\n\n\t// Synchronous capture on S_APB_PCLK\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\ts_addr <= 0;\n\t\t\ts_data <= 0;\n\t\t\ts_wstrb <= 0;\n\t\t\ts_write <= 0;\n\t\t\ts_valid <= 0;\n\t\t\ts_error <= 0;\n\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\tM_PRESETn <= 1'b0;\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\tM_APB_PADDR <= 0;\n\t\t\tM_APB_PWRITE <= 0;\n\t\t\tM_APB_PWDATA <= 0;\n\t\t\tM_APB_PWSTRB <= 0;\n\t\t\tM_APB_PPROT <= 0;\n\t\t\tfifo_addr_reg <= 0;\n\t\t\tfifo_data_reg <= 0;\n\t\t\tfifo_wstrb_reg <= 0;\n\t\t\tfifo_write_reg <= 0;\n\t\t\tfifo_valid_reg <= 0;\n\t\t\tfifo_ready_reg <= 1;\n\t\t\tfifo_busy_reg <= 0;\n\t\t\tfifo_error_reg <= 0;\n\t\t\tfifo_done_reg <= 0;\n\t\tend else begin\n\t\t\t// Reset M side if S side is reset\n\t\t\tM_PRESETn <= 1'b0;\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\tM_APB_PADDR <= 0;\n\t\t\tM_APB_PWRITE <= 0;\n\t\t\tM_APB_PWDATA <= 0;\n\t\t\tM_APB_PWSTRB <= 0;\n\t\t\tM_APB_PPROT <= 0;\n\t\t\tS_APB_PREADY <= 1'b1;\n\n\t\t\t// Capture request if valid\n\t\t\tif (S_APB_PSEL && S_APB_PENABLE && !S_APB_PREADY) begin\n\t\t\t\ts_addr <= S_APB_PADDR;\n\t\t\t\ts_data <= S_APB_PWDATA;\n\t\t\t\ts_wstrb <= S_APB_PWSTRB;\n\t\t\t\ts_write <= S_APB_PWRITE;\n\t\t\t\ts_valid <= 1'b1;\n\t\t\t\ts_error <= 0; // Error detected later\n\t\t\tend else begin\n\t\t\t\ts_valid <= 0;\n\t\t\t\ts_error <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Clock domain crossing: S to M\n\t// Capture s_valid, s_addr, s_data, s_wstrb, s_write on M_APB_PCLK\n\t// Use a simple register to hold the request until M_APB_PREADY is asserted.\n\t// Since we only support one outstanding transaction, a single register stage is enough.\n\t// We need to ensure we don't overwrite while the transaction is pending.\n\n\treg [AW-1:0]\tcross_addr;\n\treg [DW-1:0]\tcross_data;\n\treg [DW/8-1:0]\tcross_wstrb;\n\treg\t\t\tcross_write;\n\treg\t\t\tcross_valid;\n\treg\t\t\tcross_error;\n\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tcross_addr <= 0;\n\t\t\tcross_data <= 0;\n\t\t\tcross_wstrb <= 0;\n\t\t\tcross_write <= 0;\n\t\t\tcross_valid <= 0;\n\t\t\tcross_error <= 0;\n\t\tend else begin\n\t\t\t// Capture if new request arrives and we are not currently busy\n\t\t\t// OR if we are not busy and a request is valid.\n\t\t\t// Actually, we just need to capture the first valid request.\n\t\t\tif (!cross_valid && s_valid) begin\n\t\t\t\tcross_addr <= s_addr;\n\t\t\t\tcross_data <= s_data;\n\t\t\t\tcross_wstrb <= s_wstrb;\n\t\t\t\tcross_write <= s_write;\n\t\t\t\tcross_valid <= 1'b1;\n\t\t\t\tcross_error <= 0;\n\t\t\tend else if (cross_valid && M_APB_PREADY) begin\n\t\t\t\t// Transaction completed, clear valid\n\t\t\t\tcross_valid <= 0;\n\t\t\t\tcross_error <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Drive M_APB interface\n\t// Hold the request stable until M_APB_PREADY is asserted.\n\t// If cross_valid is high, drive the interface.\n\t// If cross_valid is low, drive idle.\n\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\tM_APB_PADDR <= 0;\n\t\t\tM_APB_PWRITE <= 0;\n\t\t\tM_APB_PWDATA <= 0;\n\t\t\tM_APB_PWSTRB <= 0;\n\t\t\tM_APB_PPROT <= 0;\n\t\tend else begin\n\t\t\tif (cross_valid) begin\n\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\tM_APB_PADDR <= cross_addr;\n\t\t\t\tM_APB_PWRITE <= cross_write;\n\t\t\t\tM_APB_PWDATA <= cross_data;\n\t\t\t\tM_APB_PWSTRB <= cross_wstrb;\n\t\t\t\tM_APB_PPROT <= S_APB_PPROT; // Forward protection bits\n\t\t\tend else begin\n\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\t\tM_APB_PADDR <= 0;\n\t\t\t\tM_APB_PWRITE <= 0;\n\t\t\t\tM_APB_PWDATA <= 0;\n\t\t\t\tM_APB_PWSTRB <= 0;\n\t\t\t\tM_APB_PPROT <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Capture response on M_APB_PCLK\n\t// When M_APB_PREADY is asserted, capture PRDATA and PSLVERR.\n\t// Then drive S_APB_PRDATA and S_APB_PSLVERR.\n\t// Also assert S_APB_PREADY.\n\n\treg [DW-1:0]\tresp_data;\n\treg\t\t\tresp_error;\n\treg\t\t\tresp_valid;\n\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tresp_data <= 0;\n\t\t\tresp_error <= 0;\n\t\t\tresp_valid <= 0;\n\t\t\tS_APB_PRDATA <= 0;\n\t\t\tS_APB_PSLVERR <= 0;\n\t\t\tS_APB_PREADY <= 1'b1;\n\t\tend else begin\n\t\t\tif (M_APB_PREADY) begin\n\t\t\t\tresp_data <= M_APB_PRDATA;\n\t\t\t\tresp_error <= M_APB_PSLVERR;\n\t\t\t\tresp_valid <= 1'b1;\n\t\t\t\tS_APB_PRDATA <= M_APB_PRDATA;\n\t\t\t\tS_APB_PSLVERR <= M_APB_PSLVERR;\n\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\tend else begin\n\t\t\t\tresp_valid <= 0;\n\t\t\t\tS_APB_PRDATA <= 0;\n\t\t\t\tS_APB_PSLVERR <= 0;\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Handle error propagation\n\t// If the slave returns an error, we need to mark it.\n\t// The APB protocol says if PSLVERR is asserted, the master should deassert PSEL.\n\t// Our bridge handles this by clearing cross_valid when PREADY is asserted.\n\t// We also need to ensure that if an error occurs, we don't re-issue the request.\n\t// The current logic clears cross_valid on PREADY, which is correct.\n\t// However, we need to make sure that if an error occurs, the source knows.\n\t// The source knows via S_APB_PSLVERR, which is driven from M_APB_PSLVERR.\n\t// This is handled in the response capture block.\n\n\t// Additional check: If M_APB_PSLVERR is asserted, we should not try to re-issue.\n\t// The current logic does this because cross_valid is cleared on PREADY.\n\t// But we need to ensure that if PREADY is not asserted (e.g., slave busy), we keep the request stable.\n\t// The current logic does this: M_APB_PSEL, etc., are driven by cross_valid.\n\t// cross_valid is only cleared when M_APB_PREADY is asserted.\n\t// So if M_APB_PREADY is low, the request remains stable.\n\n\t// One edge case: If M_APB_PREADY is never asserted, the request hangs.\n\t// This is expected behavior for a bridge; the slave must eventually respond.\n\n\t// Final cleanup: Ensure no transaction is created during reset.\n\t// Handled by the reset logic.\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
