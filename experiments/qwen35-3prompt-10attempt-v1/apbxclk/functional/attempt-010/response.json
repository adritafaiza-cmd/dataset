\t\t\ts_req_valid <= 1'b0;\n\t\t\ts_req_ready <= 1'b1;\n\t\t\ts_data_valid <= 1'b0;\n\t\t\ts_data_ready <= 1'b1;\n\t\t\ts_err <= 1'b0;\n\t\t\ts_addr <= 1'b0;\n\t\t\ts_write <= 1'b0;\n\t\t\ts_write_data <= 1'b0;\n\t\t\ts_write_strb <= 1'b0;\n\t\t\ts_prot <= 1'b0;\n\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\tS_APB_PRDATA <= 1'b0;\n\t\t\tS_APB_PSLVERR <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\t// Request Handshake\n\t\t\ts_req_ready <= s_state == IDLE;\n\t\t\tif (s_req_valid && s_req_ready) begin\n\t\t\t\ts_req_valid <= 1'b0;\n\t\t\t\ts_state <= SETUP;\n\t\t\tend\n\n\t\t\t// Setup Phase Logic\n\t\t\tif (s_state == SETUP) begin\n\t\t\t\tif (S_APB_PENABLE) begin\n\t\t\t\t\ts_addr <= S_APB_PADDR;\n\t\t\t\t\ts_write <= S_APB_PWRITE;\n\t\t\t\t\ts_write_data <= S_APB_PWDATA;\n\t\t\t\t\ts_write_strb <= S_APB_PWSTRB;\n\t\t\t\t\ts_prot <= S_APB_PPROT;\n\t\t\t\t\ts_state <= ACCESS;\n\t\t\t\tend\n\t\t\tend\n\n\t\t\t// Access Phase Logic\n\t\t\tif (s_state == ACCESS) begin\n\t\t\t\tif (M_APB_PREADY) begin\n\t\t\t\t\ts_state <= IDLE;\n\t\t\t\t\ts_data_valid <= 1'b1;\n\t\t\t\t\ts_data_ready <= 1'b0;\n\t\t\t\t\tif (M_APB_PSLVERR) begin\n\t\t\t\t\t\ts_err <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\n\t\t\t// Data Handshake\n\t\t\ts_data_ready <= s_state == IDLE;\n\t\t\tif (s_data_valid && s_data_ready) begin\n\t\t\t\ts_data_valid <= 1'b0;\n\t\t\t\ts_data_ready <= 1'b1;\n\t\t\t\tS_APB_PRDATA <= M_APB_PRDATA;\n\t\t\t\tS_APB_PSLVERR <= s_err;\n\t\t\tend\n\n\t\t\t// Ready Output\n\t\t\tS_APB_PREADY <= (s_state == IDLE);\n\t\tend\n\tend\n\n\t// M_APB Clock Domain Logic\n\t// State machine for M_APB side\n\t// States: IDLE, SETUP, ACCESS\n\tlocalparam\tIDLE_M = 2'b00;\n\tlocalparam\tSETUP_M = 2'b01;\n\tlocalparam\tACCESS_M = 2'b10;\n\n\treg [1:0]\t\tm_state;\n\treg\t\t\tm_req_valid;\n\treg\t\t\tm_req_ready;\n\treg\t\t\tm_data_valid;\n\treg\t\t\tm_data_ready;\n\treg\t\t\tm_err;\n\treg\t\t\tm_addr;\n\treg\t\t\tm_write;\n\treg\t\t\tm_write_data;\n\treg\t\t\tm_write_strb;\n\treg\t\t\tm_prot;\n\n\t// Cross-domain registers for M_APB side\n\treg [AW-1:0]\t\tm_cross_addr;\n\treg [DW-1:0]\t\tm_cross_write_data;\n\treg [DW/8-1:0]\t\tm_cross_write_strb;\n\treg [2:0]\t\t\tm_cross_prot;\n\treg\t\t\t\tm_cross_write;\n\treg\t\t\t\tm_cross_sel;\n\treg\t\t\t\tm_cross_enable;\n\treg\t\t\t\tm_cross_ready;\n\treg\t\t\t\tm_cross_err;\n\treg\t\t\t\tm_cross_data_valid;\n\treg [DW-1:0]\t\tm_cross_data;\n\n\t// M_APB Clock Domain Logic\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_state <= IDLE_M;\n\t\t\tm_req_valid <= 1'b0;\n\t\t\tm_req_ready <= 1'b1;\n\t\t\tm_data_valid <= 1'b0;\n\t\t\tm_data_ready <= 1'b1;\n\t\t\tm_err <= 1'b0;\n\t\t\tm_addr <= 1'b0;\n\t\t\tm_write <= 1'b0;\n\t\t\tm_write_data <= 1'b0;\n\t\t\tm_write_strb <= 1'b0;\n\t\t\tm_prot <= 1'b0;\n\t\t\tM_APB_PREADY <= 1'b1;\n\t\t\tM_APB_PRDATA <= 1'b0;\n\t\t\tM_APB_PSLVERR <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\t// Request Handshake\n\t\t\tm_req_ready <= m_state == IDLE_M;\n\t\t\tif (m_req_valid && m_req_ready) begin\n\t\t\t\tm_req_valid <= 1'b0;\n\t\t\t\tm_state <= SETUP_M;\n\t\t\tend\n\n\t\t\t// Setup Phase Logic\n\t\t\tif (m_state == SETUP_M) begin\n\t\t\t\tif (M_APB_PENABLE) begin\n\t\t\t\t\tm_addr <= M_APB_PADDR;\n\t\t\t\t\tm_write <= M_APB_PWRITE;\n\t\t\t\t\tm_write_data <= M_APB_PWDATA;\n\t\t\t\t\tm_write_strb <= M_APB_PWSTRB;\n\t\t\t\t\tm_prot <= M_APB_PPROT;\n\t\t\t\t\tm_state <= ACCESS_M;\n\t\t\t\tend\n\t\t\tend\n\n\t\t\t// Access Phase Logic\n\t\t\tif (m_state == ACCESS_M) begin\n\t\t\t\tif (S_APB_PREADY) begin\n\t\t\t\t\tm_state <= IDLE_M;\n\t\t\t\t\tm_data_valid <= 1'b1;\n\t\t\t\t\tm_data_ready <= 1'b0;\n\t\t\t\t\tif (S_APB_PSLVERR) begin\n\t\t\t\t\t\tm_err <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\n\t\t\t// Data Handshake\n\t\t\tm_data_ready <= m_state == IDLE_M;\n\t\t\tif (m_data_valid && m_data_ready) begin\n\t\t\t\tm_data_valid <= 1'b0;\n\t\t\t\tm_data_ready <= 1'b1;\n\t\t\t\tM_APB_PRDATA <= S_APB_PRDATA;\n\t\t\t\tM_APB_PSLVERR <= m_err;\n\t\t\tend\n\n\t\t\t// Ready Output\n\t\t\tM_APB_PREADY <= (m_state == IDLE_M);\n\t\tend\n\tend\n\n\t// Cross-domain synchronization logic\n\t// Capture S_APB signals on M_APB clock\n\treg [AW-1:0]\t\tc_addr;\n\treg [DW-1:0]\t\tc_write_data;\n\treg [DW/8-1:0]\t\tc_write_strb;\n\treg [2:0]\t\t\tc_prot;\n\treg\t\t\t\tc_write;\n\treg\t\t\t\tc_sel;\n\treg\t\t\t\tc_enable;\n\treg\t\t\t\tc_ready;\n\treg\t\t\t\tc_err;\n\treg\t\t\t\tc_data_valid;\n\treg [DW-1:0]\t\tc_data;\n\n\t// S_APB to M_APB crossing\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tc_addr <= 1'b0;\n\t\t\tc_write_data <= 1'b0;\n\t\t\tc_write_strb <= 1'b0;\n\t\t\tc_prot <= 1'b0;\n\t\t\tc_write <= 1'b0;\n\t\t\tc_sel <= 1'b0;\n\t\t\tc_enable <= 1'b0;\n\t\t\tc_ready <= 1'b1;\n\t\t\tc_err <= 1'b0;\n\t\t\tc_data_valid <= 1'b0;\n\t\t\tc_data <= 1'b0;\n\t\t\tM_PRESETn <= 1'b1;\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\t// Capture source signals\n\t\t\tif (S_APB_PCLK) begin\n\t\t\t\tc_addr <= S_APB_PADDR;\n\t\t\t\tc_write_data <= S_APB_PWDATA;\n\t\t\t\tc_write_strb <= S_APB_PWSTRB;\n\t\t\t\tc_prot <= S_APB_PPROT;\n\t\t\t\tc_write <= S_APB_PWRITE;\n\t\t\t\tc_sel <= S_APB_PSEL;\n\t\t\t\tc_enable <= S_APB_PENABLE;\n\t\t\t\tc_ready <= S_APB_PREADY;\n\t\t\t\tc_err <= S_APB_PSLVERR;\n\t\t\t\tc_data_valid <= S_APB_PRDATA[0]; // Dummy to capture data if needed\n\t\t\t\tc_data <= S_APB_PRDATA;\n\t\t\tend\n\n\t\t\t// Reset output\n\t\t\tM_PRESETn <= S_PRESETn;\n\n\t\t\t// Request generation\n\t\t\tif (c_sel && c_enable && c_ready) begin\n\t\t\t\tM_APB_PSEL <= 1'b1;\n\t\t\t\tM_APB_PENABLE <= 1'b1;\n\t\t\t\tM_APB_PADDR <= c_addr;\n\t\t\t\tM_APB_PWRITE <= c_write;\n\t\t\t\tM_APB_PWDATA <= c_write_data;\n\t\t\t\tM_APB_PWSTRB <= c_write_strb;\n\t\t\t\tM_APB_PPROT <= c_prot;\n\t\t\tend else begin\n\t\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\tend\n\n\t\t\t// Response capture\n\t\t\tif (M_APB_PREADY) begin\n\t\t\t\tS_APB_PRDATA <= M_APB_PRDATA;\n\t\t\t\tS_APB_PSLVERR <= M_APB_PSLVERR;\n\t\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\tend else begin\n\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// M_APB to S_APB crossing\n\talways @(posedge S_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tm_cross_addr <= 1'b0;\n\t\t\tm_cross_write_data <= 1'b0;\n\t\t\tm_cross_write_strb <= 1'b0;\n\t\t\tm_cross_prot <= 1'b0;\n\t\t\tm_cross_write <= 1'b0;\n\t\t\tm_cross_sel <= 1'b0;\n\t\t\tm_cross_enable <= 1'b0;\n\t\t\tm_cross_ready <= 1'b1;\n\t\t\tm_cross_err <= 1'b0;\n\t\t\tm_cross_data_valid <= 1'b0;\n\t\t\tm_cross_data <= 1'b0;\n\t\t\tS_APB_PREADY <= 1'b1;\n\t\t\tS_APB_PRDATA <= 1'b0;\n\t\t\tS_APB_PSLVERR <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\t// Capture destination signals\n\t\t\tif (M_APB_PCLK) begin\n\t\t\t\tm_cross_addr <= M_APB_PADDR;\n\t\t\t\tm_cross_write_data <= M_APB_PWDATA;\n\t\t\t\tm_cross_write_strb <= M_APB_PWSTRB;\n\t\t\t\tm_cross_prot <= M_APB_PPROT;\n\t\t\t\tm_cross_write <= M_APB_PWRITE;\n\t\t\t\tm_cross_sel <= M_APB_PSEL;\n\t\t\t\tm_cross_enable <= M_APB_PENABLE;\n\t\t\t\tm_cross_ready <= M_APB_PREADY;\n\t\t\t\tm_cross_err <= M_APB_PSLVERR;\n\t\t\t\tm_cross_data_valid <= M_APB_PRDATA[0]; // Dummy to capture data if needed\n\t\t\t\tm_cross_data <= M_APB_PRDATA;\n\t\t\tend\n\n\t\t\t// Reset output\n\t\t\tM_PRESETn <= S_PRESETn;\n\n\t\t\t// Request generation\n\t\t\tif (m_cross_sel && m_cross_enable && m_cross_ready) begin\n\t\t\t\tS_APB_PSEL <= 1'b1;\n\t\t\t\tS_APB_PENABLE <= 1'b1;\n\t\t\t\tS_APB_PADDR <= m_cross_addr;\n\t\t\t\tS_APB_PWRITE <= m_cross_write;\n\t\t\t\tS_APB_PWDATA <= m_cross_write_data;\n\t\t\t\tS_APB_PWSTRB <= m_cross_write_strb;\n\t\t\t\tS_APB_PPROT <= m_cross_prot;\n\t\t\tend else begin\n\t\t\t\tS_APB_PSEL <= 1'b0;\n\t\t\t\tS_APB_PENABLE <= 1'b0;\n\t\t\tend\n\n\t\t\t// Response capture\n\t\t\tif (S_APB_PREADY) begin\n\t\t\t\tM_APB_PRDATA <= S_APB_PRDATA;\n\t\t\t\tM_APB_PSLVERR <= S_APB_PSLVERR;\n\t\t\t\tM_APB_PREADY <= 1'b1;\n\t\t\tend el