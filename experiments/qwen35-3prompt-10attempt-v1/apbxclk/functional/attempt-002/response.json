  "text": "```verilog\nmodule apbxclk #(\n\tparameter\tC_APB_ADDR_WIDTH = 12,\n\tparameter\tC_APB_DATA_WIDTH = 32,\n\tparameter [0:0]\tOPT_REGISTERED = 1'b0,\n\tlocalparam\tAW = C_APB_ADDR_WIDTH,\n\tlocalparam\tDW = C_APB_DATA_WIDTH\n) (\n\tinput\twire\t\t\tS_APB_PCLK, S_PRESETn,\n\tinput\twire\t\t\tS_APB_PSEL,\n\tinput\twire\t\t\tS_APB_PENABLE,\n\toutput\treg\t\t\tS_APB_PREADY,\n\tinput\twire\t[AW-1:0]\tS_APB_PADDR,\n\tinput\twire\t\t\tS_APB_PWRITE,\n\tinput\twire\t[DW-1:0]\tS_APB_PWDATA,\n\tinput\twire\t[DW/8-1:0]\tS_APB_PWSTRB,\n\tinput\twire\t[2:0]\t\tS_APB_PPROT,\n\toutput\twire\t[DW-1:0]\tS_APB_PRDATA,\n\toutput\twire\t\t\tS_APB_PSLVERR,\n\tinput\twire\t\t\tM_APB_PCLK,\n\toutput\treg\t\t\tM_PRESETn,\n\toutput\treg\t\t\tM_APB_PSEL,\n\toutput\treg\t\t\tM_APB_PENABLE,\n\tinput\twire\t\t\tM_APB_PREADY,\n\toutput\twire\t[AW-1:0]\tM_APB_PADDR,\n\toutput\twire\t\t\tM_APB_PWRITE,\n\toutput\twire\t[DW-1:0]\tM_APB_PWDATA,\n\toutput\twire\t[DW/8-1:0]\tM_APB_PWSTRB,\n\toutput\twire\t[2:0]\t\tM_APB_PPROT,\n\tinput\twire\t[DW-1:0]\tM_APB_PRDATA,\n\tinput\twire\t\t\tM_APB_PSLVERR\n);\n\n\t// Internal signals for state machine and data buffering\n\treg [AW-1:0]\t\ti_addr;\n\treg\t\t\ti_write;\n\treg [DW-1:0]\t\ti_wdata;\n\treg [DW/8-1:0]\t\ti_wstrb;\n\treg [2:0]\t\t\ti_prot;\n\treg\t\t\ti_sel;\n\treg\t\t\ti_enable;\n\treg\t\t\ti_ready;\n\treg\t\t\ti_err;\n\treg\t\t\ti_data;\n\n\t// State machine states\n\tlocalparam IDLE = 2'b00;\n\tlocalparam REQ = 2'b01;\n\tlocalparam ACC = 2'b10;\n\n\treg [1:0]\t\tstate;\n\n\t// Cross-domain registers for payload and response\n\t// When OPT_REGISTERED is 0, these are combinational outputs driven by the state machine\n\t// When OPT_REGISTERED is 1, these are registered in the destination clock domain\n\treg [AW-1:0]\t\to_addr_reg;\n\treg\t\t\to_write_reg;\n\treg [DW-1:0]\t\to_wdata_reg;\n\treg [DW/8-1:0]\t\to_wstrb_reg;\n\treg [2:0]\t\t\to_prot_reg;\n\treg\t\t\to_sel_reg;\n\treg\t\t\to_enable_reg;\n\treg\t\t\to_ready_reg;\n\treg\t\t\to_err_reg;\n\treg\t\t\to_data_reg;\n\n\t// Synchronizer for M_APB_PREADY to detect completion in S domain\n\treg [1:0]\t\tsync_ready;\n\n\t// Synchronizer for M_APB_PSLVERR to detect error in S domain\n\treg [1:0]\t\tsync_err;\n\n\t// Synchronizer for M_APB_PRDATA to capture data in S domain\n\treg [DW-1:0]\t\tsync_data;\n\n\t// Synchronizer for M_APB_PCLK to generate a pulse for capturing data (if needed)\n\t// Actually, we just need to capture data on the rising edge of M_APB_PREADY in S domain\n\t// But since M_APB_PRDATA is valid when M_APB_PREADY is high, we need to sync the ready signal\n\t// and capture the data at that moment.\n\n\t// Synchronizer for M_APB_PREADY\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\tsync_ready <= 2'b00;\n\t\telse\n\t\t\tsync_ready <= {sync_ready[0], M_APB_PREADY};\n\tend\n\n\t// Synchronizer for M_APB_PSLVERR\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\tsync_err <= 2'b00;\n\t\telse\n\t\t\tsync_err <= {sync_err[0], M_APB_PSLVERR};\n\tend\n\n\t// Synchronizer for M_APB_PRDATA\n\t// We capture the data when the second bit of sync_ready becomes 1\n\t// This ensures we capture the data stable in S domain\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\tsync_data <= {DW{1'b0}};\n\t\telse if (sync_ready[1])\n\t\t\tsync_data <= M_APB_PRDATA;\n\tend\n\n\t// State machine logic in S domain\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\tstate <= IDLE;\n\t\telse\n\t\t\tcase (state)\n\t\t\t\tIDLE:\n\t\t\t\t\tif (S_APB_PSEL && S_APB_PENABLE)\n\t\t\t\t\t\tstate <= REQ;\n\t\t\t\t\telse\n\t\t\t\t\t\tstate <= IDLE;\n\n\t\t\t\tREQ:\n\t\t\t\t\t// Wait for M domain to acknowledge\n\t\t\t\t\tif (sync_ready[1])\n\t\t\t\t\t\tstate <= ACC;\n\t\t\t\t\telse\n\t\t\t\t\t\tstate <= REQ;\n\n\t\t\t\tACC:\n\t\t\t\t\t// Wait for M domain to complete\n\t\t\t\t\tif (sync_ready[1])\n\t\t\t\t\t\tstate <= IDLE;\n\t\t\t\t\telse\n\t\t\t\t\t\tstate <= ACC;\n\t\t\tendcase\n\tend\n\n\t// Output logic for S domain\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn) begin\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\tS_APB_PRDATA <= {DW{1'b0}};\n\t\t\tS_APB_PSLVERR <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\tcase (state)\n\t\t\t\tIDLE: begin\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tS_APB_PRDATA <= {DW{1'b0}};\n\t\t\t\t\tS_APB_PSLVERR <= 1'b0;\n\t\t\t\tend\n\t\t\t\tREQ: begin\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tS_APB_PRDATA <= {DW{1'b0}};\n\t\t\t\t\tS_APB_PSLVERR <= 1'b0;\n\t\t\t\tend\n\t\t\t\tACC: begin\n\t\t\t\t\tS_APB_PREADY <= 1'b0;\n\t\t\t\t\tS_APB_PRDATA <= sync_data;\n\t\t\t\t\tS_APB_PSLVERR <= sync_err[1];\n\t\t\t\tend\n\t\t\tendcase\n\t\tend\n\tend\n\n\t// Output logic for M domain\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\tM_APB_PSEL <= 1'b0;\n\t\t\tM_APB_PENABLE <= 1'b0;\n\t\t\tM_APB_PADDR <= {AW{1'b0}};\n\t\t\tM_APB_PWRITE <= 1'b0;\n\t\t\tM_APB_PWDATA <= {DW{1'b0}};\n\t\t\tM_APB_PWSTRB <= {DW/8{1'b0}};\n\t\t\tM_APB_PPROT <= 3'b000;\n\t\tend\n\t\telse begin\n\t\t\t// Drive M domain signals based on current state and buffered data\n\t\t\tM_APB_PSEL <= o_sel_reg;\n\t\t\tM_APB_PENABLE <= o_enable_reg;\n\t\t\tM_APB_PADDR <= o_addr_reg;\n\t\t\tM_APB_PWRITE <= o_write_reg;\n\t\t\tM_APB_PWDATA <= o_wdata_reg;\n\t\t\tM_APB_PWSTRB <= o_wstrb_reg;\n\t\t\tM_APB_PPROT <= o_prot_reg;\n\t\tend\n\tend\n\n\t// Register M domain outputs when OPT_REGISTERED is set\n\t// This ensures that the data is stable across the clock domain boundary\n\t// and captured correctly in the S domain synchronizers\n\talways @(posedge M_APB_PCLK or negedge M_PRESETn) begin\n\t\tif (!M_PRESETn) begin\n\t\t\to_addr_reg <= {AW{1'b0}};\n\t\t\to_write_reg <= 1'b0;\n\t\t\to_wdata_reg <= {DW{1'b0}};\n\t\t\to_wstrb_reg <= {DW/8{1'b0}};\n\t\t\to_prot_reg <= 3'b000;\n\t\t\to_sel_reg <= 1'b0;\n\t\t\to_enable_reg <= 1'b0;\n\t\t\to_ready_reg <= 1'b0;\n\t\t\to_err_reg <= 1'b0;\n\t\t\to_data_reg <= {DW{1'b0}};\n\t\tend\n\t\telse begin\n\t\t\to_addr_reg <= M_APB_PADDR;\n\t\t\to_write_reg <= M_APB_PWRITE;\n\t\t\to_wdata_reg <= M_APB_PWDATA;\n\t\t\to_wstrb_reg <= M_APB_PWSTRB;\n\t\t\to_prot_reg <= M_APB_PPROT;\n\t\t\to_sel_reg <= M_APB_PSEL;\n\t\t\to_enable_reg <= M_APB_PENABLE;\n\t\t\to_ready_reg <= M_APB_PREADY;\n\t\t\to_err_reg <= M_APB_PSLVERR;\n\t\t\to_data_reg <= M_APB_PRDATA;\n\t\tend\n\tend\n\n\t// When OPT_REGISTERED is 0, drive M domain outputs directly from S domain inputs\n\t// This avoids unnecessary registers and keeps the behavior simple\n\talways @(*) begin\n\t\tif (OPT_REGISTERED == 1'b1) begin\n\t\t\tM_APB_PADDR <= o_addr_reg;\n\t\t\tM_APB_PWRITE <= o_write_reg;\n\t\t\tM_APB_PWDATA <= o_wdata_reg;\n\t\t\tM_APB_PWSTRB <= o_wstrb_reg;\n\t\t\tM_APB_PPROT <= o_prot_reg;\n\t\t\tM_APB_PSEL <= o_sel_reg;\n\t\t\tM_APB_PENABLE <= o_enable_reg;\n\t\tend\n\t\telse begin\n\t\t\tM_APB_PADDR <= S_APB_PADDR;\n\t\t\tM_APB_PWRITE <= S_APB_PWRITE;\n\t\t\tM_APB_PWDATA <= S_APB_PWDATA;\n\t\t\tM_APB_PWSTRB <= S_APB_PWSTRB;\n\t\t\tM_APB_PPROT <= S_APB_PPROT;\n\t\t\tM_APB_PSEL <= S_APB_PSEL;\n\t\t\tM_APB_PENABLE <= S_APB_PENABLE;\n\t\tend\n\tend\n\n\t// Generate M domain reset\n\talways @(posedge M_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\tM_PRESETn <= 1'b0;\n\t\telse\n\t\t\tM_PRESETn <= 1'b1;\n\tend\n\n\t// Generate S domain ready signal\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\tS_APB_PREADY <= 1'b0;\n\t\telse\n\t\t\tS_APB_PREADY <= (state == ACC) ? 1'b1 : 1'b0;\n\tend\n\n\t// Generate S domain error signal\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\tS_APB_PSLVERR <= 1'b0;\n\t\telse\n\t\t\tS_APB_PSLVERR <= sync_err[1];\n\tend\n\n\t// Generate S domain data signal\n\talways @(posedge S_APB_PCLK or negedge S_PRESETn) begin\n\t\tif (!S_PRESETn)\n\t\t\tS_APB_PRDATA <= {DW{1'b0}};\n\t\telse\n\t\t\tS_APB_PRDATA <= sync_data;\n\tend\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
