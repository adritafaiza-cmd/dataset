  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal state registers\n    reg [N-1:0] shift_reg;\n    reg [N-1:0] shift_reg_out;\n    reg [N-1:0] shift_reg_in;\n    reg shift_done;\n    reg spi_busy;\n    reg spi_sel_active;\n    reg spi_sck_count;\n    reg spi_sck_dir; // 0: falling, 1: rising (for 2x div)\n    \n    // State machine for SPI transaction\n    localparam IDLE = 2'b00;\n    localparam SELECT = 2'b01;\n    localparam SHIFT = 2'b10;\n    localparam DESELECT = 2'b11;\n\n    reg [1:0] state;\n\n    // State register\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= IDLE;\n            shift_reg <= {N{1'b0}};\n            shift_reg_out <= {N{1'b0}};\n            shift_reg_in <= {N{1'b0}};\n            shift_done <= 1'b0;\n            spi_busy <= 1'b0;\n            spi_sel_active <= 1'b0;\n            spi_sck_count <= 1'b0;\n            spi_sck_dir <= 1'b0;\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            spi_mosi_o <= 1'b0;\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n        end\n        else begin\n            state <= state;\n            shift_reg <= shift_reg;\n            shift_reg_out <= shift_reg_out;\n            shift_reg_in <= shift_reg_in;\n            shift_done <= shift_done;\n            spi_busy <= spi_busy;\n            spi_sel_active <= spi_sel_active;\n            spi_sck_count <= spi_sck_count;\n            spi_sck_dir <= spi_sck_dir;\n            spi_ssel_o <= spi_ssel_o;\n            spi_sck_o <= spi_sck_o;\n            spi_mosi_o <= spi_mosi_o;\n            di_req_o <= di_req_o;\n            wr_ack_o <= wr_ack_o;\n            do_valid_o <= do_valid_o;\n            do_o <= do_o;\n        end\n    end\n\n    // State Machine Logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            state <= IDLE;\n        else begin\n            case (state)\n                IDLE: begin\n                    if (wren_i && !spi_busy) begin\n                        state <= SELECT;\n                        shift_reg <= di_i;\n                        shift_reg_out <= {N{1'b0}};\n                        shift_reg_in <= {N{1'b0}};\n                        shift_done <= 1'b0;\n                        spi_busy <= 1'b1;\n                        di_req_o <= 1'b1;\n                        wr_ack_o <= 1'b0;\n                    end\n                    else begin\n                        di_req_o <= 1'b0;\n                        wr_ack_o <= 1'b0;\n                    end\n                end\n\n                SELECT: begin\n                    if (spi_sck_count == SPI_2X_CLK_DIV) begin\n                        state <= SHIFT;\n                        spi_sel_active <= 1'b1;\n                        spi_sck_count <= 1'b0;\n                        spi_sck_dir <= 1'b0;\n                        spi_sck_o <= 1'b0;\n                        spi_mosi_o <= 1'b0;\n                    end\n                    else begin\n                        spi_sck_count <= spi_sck_count + 1'b1;\n                        spi_sck_o <= 1'b0;\n                        spi_mosi_o <= 1'b0;\n                    end\n                end\n\n                SHIFT: begin\n                    if (spi_sck_count == SPI_2X_CLK_DIV) begin\n                        state <= DESELECT;\n                        spi_sel_active <= 1'b0;\n                        spi_sck_count <= 1'b0;\n                        spi_sck_dir <= 1'b0;\n                        spi_sck_o <= 1'b0;\n                        spi_mosi_o <= 1'b0;\n                        shift_done <= 1'b1;\n                        spi_busy <= 1'b0;\n                        do_valid_o <= 1'b1;\n                        do_o <= shift_reg_out;\n                    end\n                    else begin\n                        spi_sck_count <= spi_sck_count + 1'b1;\n                        spi_sck_o <= 1'b0;\n                        spi_mosi_o <= 1'b0;\n                    end\n                end\n\n                DESELECT: begin\n                    if (spi_sck_count == SPI_2X_CLK_DIV) begin\n                        state <= IDLE;\n                        spi_sel_active <= 1'b0;\n                        spi_sck_count <= 1'b0;\n                        spi_sck_dir <= 1'b0;\n                        spi_sck_o <= 1'b0;\n                        spi_mosi_o <= 1'b0;\n                        shift_done <= 1'b0;\n                        do_valid_o <= 1'b0;\n                        di_req_o <= 1'b0;\n                        wr_ack_o <= 1'b1;\n                    end\n                    else begin\n                        spi_sck_count <= spi_sck_count + 1'b1;\n                        spi_sck_o <= 1'b0;\n                        spi_mosi_o <= 1'b0;\n                    end\n                end\n            end\n        end\n    end\n\n    // SPI Clock Generation (2x Divider)\n    // Toggle clock on every rising edge of sclk_i to achieve 2x speed\n    always @(posedge sclk_i) begin\n        if (spi_busy) begin\n            if (spi_sck_dir == 1'b0) begin\n                spi_sck_o <= 1'b1;\n                spi_sck_dir <= 1'b1;\n            end\n            else begin\n                spi_sck_o <= 1'b0;\n                spi_sck_dir <= 1'b0;\n            end\n        end\n        else begin\n            spi_sck_o <= 1'b0;\n        end\n    end\n\n    // SPI MOSI Output Logic\n    // Drive MOSI based on current bit position in shift_reg\n    // We need to track which bit we are currently shifting out\n    reg [N-1:0] bit_index;\n    reg [N-1:0] bit_index_reg;\n\n    always @(posedge sclk_i) begin\n        if (spi_busy) begin\n            if (spi_sck_dir == 1'b0) begin\n                // Rising edge of SPI clock, shift out next bit\n                bit_index_reg <= bit_index + 1'b1;\n                spi_mosi_o <= shift_reg[N-1-bit_index_reg];\n            end\n            else begin\n                // Falling edge of SPI clock\n                spi_mosi_o <= 1'b0;\n            end\n        end\n        else begin\n            spi_mosi_o <= 1'b0;\n        end\n    end\n\n    // SPI MISO Capture Logic\n    // Capture MISO on the falling edge of SPI clock (standard SPI mode 0)\n    // and shift it into the register\n    always @(posedge sclk_i) begin\n        if (spi_busy) begin\n            if (spi_sck_dir == 1'b0) begin\n                // Rising edge of SPI clock, shift in next bit\n                shift_reg_in[N-1-bit_index_reg] <= spi_miso_i;\n            end\n            else begin\n                // Falling edge of SPI clock\n                // No action needed for shifting in on falling edge if we shift on rising\n            end\n        end\n    end\n\n    // Shift register update on completion of byte transfer\n    // Actually, we need to shift the data as we go. \n    // Let's restructure the shift logic to be synchronous with the SPI clock edges.\n    \n    // Revised approach: Use a counter to track bit position and shift data accordingly\n    reg [N-1:0] shift_reg_data;\n    reg [N-1:0] shift_reg_result;\n    reg [N-1:0] bit_pos;\n    reg [N-1:0] bit_pos_reg;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            shift_reg_data <= {N{1'b0}};\n            shift_reg_result <= {N{1'b0}};\n            bit_pos <= {N{1'b0}};\n            bit_pos_reg <= {N{1'b0}};\n        end\n        else begin\n            shift_reg_data <= shift_reg_data;\n            shift_reg_result <= shift_reg_result;\n            bit_pos <= bit_pos;\n            bit_pos_reg <= bit_pos_reg;\n        end\n    end\n\n    // Shift register update logic\n    always @(posedge sclk_i) begin\n        if (spi_busy) begin\n            if (spi_sck_dir == 1'b0) begin\n                // Rising edge of SPI clock\n                // Shift in MISO bit at current position\n                shift_reg_data[N-1-bit_pos_reg] <= spi_miso_i;\n                \n                // Shift out MOSI bit at current position\n                spi_mosi_o <= shift_reg_data[N-1-bit_pos_reg];\n                \n                // Update bit position\n                bit_pos_reg <= bit_pos_reg + 1'b1;\n            end\n            else begin\n                // Falling edge of SPI clock\n                spi_mosi_o <= 1'b0;\n            end\n        end\n        else begin\n            spi_mosi_o <= 1'b0;\n        end\n    end\n\n    // Final result assembly\n    always @(posedge sclk_i) begin\n        if (spi_busy) begin\n            if (spi_sck_dir == 1'b0) begin\n                // Rising edge: shift in MISO\n                shift_reg_result[N-1-bit_pos_reg] <= spi_miso_i;\n            end\n            else begin\n                // Falling edge: no change\n            end\n        end\n    end\n\n    // Output the final result when transfer is complete\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            do_o <= {N{1'b0}};\n            do_valid_o <= 1'b0;\n        end\n        else begin\n            if (shift_done) begin\n                do_o <= shift_reg_result;\n                do_valid_o <= 1'b1;\n            end\n            else begin\n                do_o <= do_o;\n                do_valid_o <= do_valid_o;\n            end\n        end\n    end\n\n    // Select line control\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1;\n        end\n        else begin\n            if (state == SELECT || state == SHIFT) begin\n                spi_ssel_o <= 1'b0;\n            end\n            else begin\n                spi_ssel_o <= 1'b1;\n            end\n        end\n    end\n\n    // Acknowledge write when transfer is complete\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wr_ack_o <= 1'b0;\n        end\n        else begin\n            if (shift_done) begin\n                wr_ack_o <= 1'b1;\n            end\n            else begin\n                wr_ack_o <= 1'b0;\n            end\n        end\n    end\n\n    // Request next word when transfer is complete\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1'b0;\n        end\n        else begin\n            if (shift_done) begin\n                di_req_o <= 1'b1;\n            end\n            else begin\n                di_req_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
