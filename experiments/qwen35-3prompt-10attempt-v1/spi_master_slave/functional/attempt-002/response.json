  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // State encoding\n    localparam IDLE = 2'b00;\n    localparam TX_START = 2'b01;\n    localparam TX_SHIFT = 2'b10;\n    localparam RX_SHIFT = 2'b11;\n\n    reg [1:0] state;\n    reg [N-1:0] tx_data;\n    reg [N-1:0] rx_data;\n    reg [N-1:0] shift_reg;\n    reg tx_en;\n    reg [N-1:0] shift_count;\n    reg [N-1:0] rx_count;\n    reg ssel_active;\n\n    // Internal clock generation for SPI domain\n    // We need to generate a clock that is SPI_2X_CLK_DIV times faster than sclk_i\n    // to handle the bit shifting efficiently.\n    reg [SPI_2X_CLK_DIV - 1:0] sclk_div_cnt;\n    wire sclk_fast;\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            sclk_div_cnt <= {SPI_2X_CLK_DIV{1'b0}};\n        else\n            sclk_div_cnt <= sclk_div_cnt + 1'b1;\n    end\n\n    assign sclk_fast = (sclk_div_cnt == {SPI_2X_CLK_DIV{1'b0}}) ? 1'b1 : 1'b0;\n\n    // State Machine Logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= IDLE;\n            tx_data <= 0;\n            rx_data <= 0;\n            shift_reg <= 0;\n            tx_en <= 0;\n            shift_count <= 0;\n            rx_count <= 0;\n            ssel_active <= 0;\n            di_req_o <= 0;\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n        end\n        else begin\n            case (state)\n                IDLE: begin\n                    if (wren_i && di_req_o) begin\n                        state <= TX_START;\n                        tx_data <= di_i;\n                        shift_count <= 0;\n                        rx_count <= 0;\n                        ssel_active <= 1;\n                        di_req_o <= 0; // Deassert request after grab\n                        wr_ack_o <= 1; // Acknowledge write\n                    end\n                    else begin\n                        wr_ack_o <= 0;\n                    end\n                end\n\n                TX_START: begin\n                    // Assert chip select\n                    ssel_active <= 1;\n                    // Load shift register with MSB first\n                    shift_reg <= {tx_data[N-1], tx_data[N-2:0]};\n                    state <= TX_SHIFT;\n                    shift_count <= 0;\n                    rx_count <= 0;\n                end\n\n                TX_SHIFT: begin\n                    // Shift out MSB first\n                    spi_mosi_o <= shift_reg[N-1];\n                    spi_sck_o <= 1'b0; // Start low\n                    shift_count <= shift_count + 1'b1;\n                    \n                    if (shift_count == N - 1) begin\n                        // Last bit shifted out\n                        spi_sck_o <= 1'b1; // End high\n                        state <= RX_SHIFT;\n                    end\n                end\n\n                RX_SHIFT: begin\n                    // Capture MISO\n                    spi_miso_i; // Read input\n                    shift_reg <= {spi_miso_i, shift_reg[N-1:N-1]}; // Shift in LSB first effectively for storage\n                    // Actually, standard SPI shift: \n                    // If we shift MSB out first, we should shift MSB in first to keep alignment?\n                    // Let's standardize: Shift register holds data MSB at index 0 (leftmost).\n                    // On TX_SHIFT: we output shift_reg[N-1] (MSB).\n                    // On RX_SHIFT: we capture spi_miso_i into shift_reg[0] (LSB position relative to next shift).\n                    // So: shift_reg = {spi_miso_i, shift_reg[N-1:1]};\n                    \n                    shift_reg <= {spi_miso_i, shift_reg[N-1:1]};\n                    spi_sck_o <= 1'b0; // Start low\n                    rx_count <= rx_count + 1'b1;\n\n                    if (rx_count == N - 1) begin\n                        // Last bit shifted in\n                        spi_sck_o <= 1'b1; // End high\n                        do_valid_o <= 1;\n                        do_o <= shift_reg;\n                        state <= IDLE;\n                        ssel_active <= 0;\n                        // Deassert chip select after transaction\n                        spi_ssel_o <= 0;\n                    end\n                end\n            endcase\n        end\n    end\n\n    // Output assignments\n    assign spi_ssel_o = ssel_active;\n    assign spi_sck_o = (state == TX_SHIFT || state == RX_SHIFT) ? spi_sck_o : 1'b0;\n    // Note: spi_sck_o is driven inside the FSM. \n    // To ensure it's always driven correctly without race conditions in the output logic:\n    // The FSM drives spi_sck_o directly. We just need to make sure the output logic doesn't conflict.\n    // Since spi_sck_o is a reg, we can drive it directly in the always block.\n    // However, to be safe with the \"output reg\" declaration and potential synthesis tools:\n    // We will rely on the FSM to drive it.\n    \n    // Re-evaluating spi_sck_o drive:\n    // In the FSM above, spi_sck_o is assigned directly.\n    // But wait, in IDLE and TX_START, we need to ensure it's low.\n    // In the case statement above, I assigned spi_sck_o <= 1'b0 inside TX_SHIFT and RX_SHIFT.\n    // I need to ensure it is 0 in IDLE and TX_START as well.\n    \n    // Let's refactor the spi_sck_o assignment to be cleaner.\n    // Actually, the FSM logic inside the case statement handles the toggling.\n    // We just need to make sure the initial state and transitions are correct.\n    // In IDLE: spi_sck_o should be 0.\n    // In TX_START: spi_sck_o should be 0.\n    // In TX_SHIFT: spi_sck_o toggles 0->1->0...\n    // In RX_SHIFT: spi_sck_o toggles 0->1->0...\n    \n    // Corrected FSM logic for spi_sck_o:\n    // It's better to drive spi_sck_o based on state and a counter/toggle logic if needed,\n    // but since we have a specific clock domain (sclk_fast), we can just toggle it.\n    // However, the requirement is simple: generate clock pulses.\n    // Let's simplify the FSM to drive spi_sck_o explicitly.\n\n    reg spi_sck_internal;\n    \n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck_internal <= 1'b0;\n            ssel_active <= 0;\n            do_valid_o <= 0;\n            di_req_o <= 0;\n            wr_ack_o <= 0;\n        end\n        else begin\n            case (state)\n                IDLE: begin\n                    spi_sck_internal <= 1'b0;\n                    ssel_active <= 0;\n                    if (wren_i && di_req_o) begin\n                        state <= TX_START;\n                        tx_data <= di_i;\n                        shift_count <= 0;\n                        rx_count <= 0;\n                        di_req_o <= 0;\n                        wr_ack_o <= 1;\n                    end\n                    else begin\n                        wr_ack_o <= 0;\n                    end\n                end\n\n                TX_START: begin\n                    spi_sck_internal <= 1'b0;\n                    ssel_active <= 1;\n                    shift_reg <= {tx_data[N-1], tx_data[N-2:0]};\n                    state <= TX_SHIFT;\n                    shift_count <= 0;\n                    rx_count <= 0;\n                end\n\n                TX_SHIFT: begin\n                    spi_mosi_o <= shift_reg[N-1];\n                    if (shift_count == N - 1) begin\n                        spi_sck_internal <= 1'b1; // End high\n                        state <= RX_SHIFT;\n                    end\n                    else begin\n                        spi_sck_internal <= 1'b0; // Start low\n                        shift_count <= shift_count + 1'b1;\n                    end\n                end\n\n                RX_SHIFT: begin\n                    shift_reg <= {spi_miso_i, shift_reg[N-1:1]};\n                    if (rx_count == N - 1) begin\n                        spi_sck_internal <= 1'b1; // End high\n                        do_valid_o <= 1;\n                        do_o <= shift_reg;\n                        state <= IDLE;\n                        ssel_active <= 0;\n                    end\n                    else begin\n                        spi_sck_internal <= 1'b0; // Start low\n                        rx_count <= rx_count + 1'b1;\n                    end\n                end\n            endcase\n        end\n    end\n\n    assign spi_sck_o = spi_sck_internal;\n    assign spi_ssel_o = ssel_active;\n\n    // Di_req_o is an output that requests the next word.\n    // The prompt says \"di_req_o requests the next word\".\n    // Usually, the master asserts di_req_o when it is ready to accept a new word.\n    // In this design, the master accepts a word when wren_i is high.\n    // So di_req_o should be asserted when the master is in IDLE state and ready.\n    // However, the prompt says \"Accept N-bit words on di_i when wren_i is high\".\n    // And \"di_req_o requests the next word\".\n    // This implies a handshake where the master signals it is ready.\n    // Let's assume di_req_o is asserted when the master is idle and waiting for data.\n    \n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            di_req_o <= 0;\n        else if (state == IDLE)\n            di_req_o <= 1;\n        else\n            di_req_o <= 0;\n    end\n\n    // wr_ack_o is already handled in the FSM.\n    // do_valid_o and do_o are handled in the FSM.\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
