  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // Internal state registers for parallel interface\n    reg [N-1:0] tx_data;\n    reg [N-1:0] rx_data;\n    reg tx_ready;\n    reg rx_ready;\n    reg tx_busy;\n    reg rx_busy;\n    reg tx_start;\n    reg rx_start;\n    reg tx_done;\n    reg rx_done;\n\n    // Internal counters and shift registers for SPI\n    reg [N-1:0] shift_reg;\n    reg [N-1:0] shift_reg_rx;\n    reg [3:0]   bit_count;\n    reg         sck_edge;\n    reg         sck_edge_neg;\n    reg         sck_edge_pos;\n\n    // State machine for SPI timing\n    localparam IDLE = 0;\n    localparam TX_SHIFT = 1;\n    localparam RX_SHIFT = 2;\n    localparam TX_DONE = 3;\n    localparam RX_DONE = 4;\n\n    reg [1:0] spi_state;\n\n    // Generate SPI clock based on divider\n    reg [SPI_2X_CLK_DIV-1:0] sck_div_cnt;\n    reg sck_out;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sck_div_cnt <= 0;\n            sck_out <= 1'b0;\n        end else begin\n            sck_div_cnt <= sck_div_cnt + 1'b1;\n            if (sck_div_cnt == SPI_2X_CLK_DIV - 1'b1) begin\n                sck_div_cnt <= 0;\n                sck_out <= ~sck_out;\n            end\n        end\n    end\n\n    // Detect SPI clock edges\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sck_edge <= 1'b0;\n        end else begin\n            sck_edge <= sck_out;\n        end\n    end\n\n    // State machine logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_state <= IDLE;\n            tx_data <= 0;\n            rx_data <= 0;\n            tx_ready <= 0;\n            rx_ready <= 0;\n            tx_busy <= 0;\n            rx_busy <= 0;\n            tx_start <= 0;\n            rx_start <= 0;\n            tx_done <= 0;\n            rx_done <= 0;\n            bit_count <= 0;\n            shift_reg <= 0;\n            shift_reg_rx <= 0;\n            di_req_o <= 0;\n            wr_ack_o <= 0;\n            do_valid_o <= 0;\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            spi_mosi_o <= 1'b0;\n        end else begin\n            // State transitions\n            case (spi_state)\n                IDLE: begin\n                    if (wren_i && di_req_o) begin\n                        tx_data <= di_i;\n                        tx_start <= 1'b1;\n                        tx_busy <= 1'b1;\n                        rx_start <= 1'b0;\n                        rx_busy <= 1'b0;\n                        spi_state <= TX_SHIFT;\n                    end else if (rx_ready && do_valid_o) begin\n                        rx_start <= 1'b1;\n                        rx_busy <= 1'b1;\n                        tx_start <= 1'b0;\n                        tx_busy <= 1'b0;\n                        spi_state <= RX_SHIFT;\n                    end else begin\n                        spi_state <= IDLE;\n                    end\n                end\n\n                TX_SHIFT: begin\n                    if (bit_count == N) begin\n                        tx_done <= 1'b1;\n                        tx_busy <= 1'b0;\n                        tx_start <= 1'b0;\n                        spi_state <= TX_DONE;\n                    end else begin\n                        spi_state <= TX_SHIFT;\n                    end\n                end\n\n                TX_DONE: begin\n                    if (tx_done) begin\n                        tx_done <= 1'b0;\n                        tx_ready <= 1'b1;\n                        spi_state <= IDLE;\n                    end else begin\n                        spi_state <= TX_DONE;\n                    end\n                end\n\n                RX_SHIFT: begin\n                    if (bit_count == N) begin\n                        rx_done <= 1'b1;\n                        rx_busy <= 1'b0;\n                        rx_start <= 1'b0;\n                        spi_state <= RX_DONE;\n                    end else begin\n                        spi_state <= RX_SHIFT;\n                    end\n                end\n\n                RX_DONE: begin\n                    if (rx_done) begin\n                        rx_done <= 1'b0;\n                        rx_ready <= 1'b1;\n                        spi_state <= IDLE;\n                    end else begin\n                        spi_state <= RX_DONE;\n                    end\n                end\n            endcase\n        end\n    end\n\n    // SPI Output Logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            spi_mosi_o <= 1'b0;\n        end else begin\n            // Chip Select: Active low during transfer\n            if (spi_state == IDLE) begin\n                spi_ssel_o <= 1'b1;\n                spi_sck_o <= 1'b0;\n                spi_mosi_o <= 1'b0;\n            end else if (spi_state == TX_SHIFT) begin\n                spi_ssel_o <= 1'b0;\n                spi_sck_o <= 1'b0;\n                spi_mosi_o <= shift_reg[N-1];\n            end else if (spi_state == RX_SHIFT) begin\n                spi_ssel_o <= 1'b0;\n                spi_sck_o <= 1'b0;\n                spi_mosi_o <= 1'b0; // MOSI idle during RX\n            end else begin\n                spi_ssel_o <= 1'b1;\n                spi_sck_o <= 1'b0;\n                spi_mosi_o <= 1'b0;\n            end\n        end\n    end\n\n    // SPI Clock Output\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_sck_o <= 1'b0;\n        end else begin\n            if (spi_state == IDLE) begin\n                spi_sck_o <= 1'b0;\n            end else if (spi_state == TX_SHIFT || spi_state == RX_SHIFT) begin\n                spi_sck_o <= 1'b1;\n            end else begin\n                spi_sck_o <= 1'b0;\n            end\n        end\n    end\n\n    // Shift Register Logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            shift_reg <= 0;\n            shift_reg_rx <= 0;\n            bit_count <= 0;\n        end else begin\n            if (spi_state == TX_SHIFT) begin\n                shift_reg <= {shift_reg[N-2:0], 1'b0}; // Shift in 0 for TX\n                bit_count <= bit_count + 1'b1;\n            end else if (spi_state == RX_SHIFT) begin\n                shift_reg_rx <= {shift_reg_rx[N-2:0], spi_miso_i};\n                bit_count <= bit_count + 1'b1;\n            end else begin\n                shift_reg <= 0;\n                shift_reg_rx <= 0;\n                bit_count <= 0;\n            end\n        end\n    end\n\n    // Data Output Logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            do_valid_o <= 1'b0;\n            do_o <= 0;\n        end else begin\n            if (spi_state == RX_SHIFT) begin\n                do_valid_o <= 1'b0;\n                do_o <= shift_reg_rx;\n            end else if (spi_state == RX_DONE) begin\n                do_valid_o <= 1'b1;\n                do_o <= shift_reg_rx;\n            end else begin\n                do_valid_o <= 1'b0;\n                do_o <= 0;\n            end\n        end\n    end\n\n    // Handshake Signals\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n        end else begin\n            if (spi_state == IDLE) begin\n                di_req_o <= 1'b1;\n            end else begin\n                di_req_o <= 1'b0;\n            end\n\n            if (spi_state == TX_DONE) begin\n                wr_ack_o <= 1'b1;\n            end else begin\n                wr_ack_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
