  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    localparam WORD_WIDTH = N;\n    localparam SPI_CLK_DIV = SPI_2X_CLK_DIV;\n\n    // State encoding\n    localparam IDLE = 2'd0;\n    localparam SELECT = 2'd1;\n    localparam TRANSFER = 2'd2;\n    localparam AWAIT_WR_ACK = 2'd3;\n    localparam AWAIT_DO_VALID = 2'd4;\n\n    reg [1:0] state;\n    reg [WORD_WIDTH-1:0] shift_reg;\n    reg [WORD_WIDTH-1:0] rx_data;\n    reg [WORD_WIDTH-1:0] tx_data;\n    reg [WORD_WIDTH-1:0] last_rx_data;\n    reg wr_ack_pending;\n    reg do_valid_pending;\n    reg [WORD_WIDTH-1:0] do_data;\n    reg ssel_active;\n    reg [3:0] bit_count;\n    reg [3:0] rx_bit_count;\n    reg [3:0] tx_bit_count;\n    reg sck_edge;\n    reg sck_edge_d;\n    reg di_req_valid;\n    reg di_req_d;\n    reg wren_d;\n\n    // Clock domain crossing registers for parallel interface\n    reg [WORD_WIDTH-1:0] di_sync_reg;\n    reg wren_sync_reg;\n    reg di_req_sync_reg;\n\n    // Clock domain crossing registers for SPI output data\n    reg [WORD_WIDTH-1:0] do_sync_reg;\n    reg do_valid_sync_reg;\n\n    // SCK edge detection (sclk_i domain)\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            sck_edge <= 1'b0;\n        else\n            sck_edge <= sclk_i;\n    end\n\n    // Parallel interface synchronization (pclk_i domain)\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_d <= 1'b0;\n            wren_d <= 1'b0;\n        end else begin\n            di_req_d <= di_req_i;\n            wren_d <= wren_i;\n        end\n    end\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_sync_reg <= {WORD_WIDTH{1'b0}};\n            wren_sync_reg <= 1'b0;\n        end else begin\n            di_sync_reg <= di_sync_reg;\n            wren_sync_reg <= wren_sync_reg;\n        end\n    end\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_sync_reg <= 1'b0;\n        end else begin\n            di_req_sync_reg <= di_req_d;\n        end\n    end\n\n    // SPI output data synchronization (sclk_i domain)\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            do_sync_reg <= {WORD_WIDTH{1'b0}};\n            do_valid_sync_reg <= 1'b0;\n        end else begin\n            do_sync_reg <= do_sync_reg;\n            do_valid_sync_reg <= do_valid_sync_reg;\n        end\n    end\n\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            do_valid_sync_reg <= 1'b0;\n        end else begin\n            do_valid_sync_reg <= do_valid_d;\n        end\n    end\n\n    // State machine logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= IDLE;\n            bit_count <= 4'd0;\n            rx_bit_count <= 4'd0;\n            tx_bit_count <= 4'd0;\n            shift_reg <= {WORD_WIDTH{1'b0}};\n            rx_data <= {WORD_WIDTH{1'b0}};\n            tx_data <= {WORD_WIDTH{1'b0}};\n            last_rx_data <= {WORD_WIDTH{1'b0}};\n            wr_ack_pending <= 1'b0;\n            do_valid_pending <= 1'b0;\n            do_data <= {WORD_WIDTH{1'b0}};\n            ssel_active <= 1'b0;\n            di_req_valid <= 1'b0;\n        end else begin\n            case (state)\n                IDLE: begin\n                    if (di_req_valid && wren_sync_reg) begin\n                        state <= SELECT;\n                        tx_data <= di_sync_reg;\n                        shift_reg <= {WORD_WIDTH{1'b0}};\n                        rx_data <= {WORD_WIDTH{1'b0}};\n                        bit_count <= 4'd0;\n                        rx_bit_count <= 4'd0;\n                        tx_bit_count <= 4'd0;\n                        wr_ack_pending <= 1'b0;\n                        do_valid_pending <= 1'b0;\n                        do_data <= {WORD_WIDTH{1'b0}};\n                    end else begin\n                        state <= IDLE;\n                    end\n                end\n\n                SELECT: begin\n                    if (bit_count == 4'd1) begin\n                        state <= TRANSFER;\n                        bit_count <= 4'd1;\n                    end else begin\n                        bit_count <= bit_count + 1;\n                    end\n                end\n\n                TRANSFER: begin\n                    if (tx_bit_count == WORD_WIDTH) begin\n                        state <= AWAIT_WR_ACK;\n                        wr_ack_pending <= 1'b1;\n                        bit_count <= 4'd0;\n                        rx_bit_count <= 4'd0;\n                        tx_bit_count <= 4'd0;\n                    end else begin\n                        bit_count <= bit_count + 1;\n                        tx_bit_count <= tx_bit_count + 1;\n                        rx_bit_count <= rx_bit_count + 1;\n                    end\n                end\n\n                AWAIT_WR_ACK: begin\n                    if (wr_ack_pending) begin\n                        state <= AWAIT_DO_VALID;\n                        wr_ack_pending <= 1'b0;\n                        do_valid_pending <= 1'b1;\n                        do_data <= rx_data;\n                    end else begin\n                        state <= AWAIT_WR_ACK;\n                    end\n                end\n\n                AWAIT_DO_VALID: begin\n                    if (do_valid_pending) begin\n                        state <= IDLE;\n                        do_valid_pending <= 1'b0;\n                        bit_count <= 4'd0;\n                        rx_bit_count <= 4'd0;\n                        tx_bit_count <= 4'd0;\n                    end else begin\n                        state <= AWAIT_DO_VALID;\n                    end\n                end\n            endcase\n        end\n    end\n\n    // Parallel interface input logic\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_req_valid <= 1'b0;\n        end else begin\n            di_req_valid <= di_req_sync_reg;\n        end\n    end\n\n    // SPI output logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            spi_ssel_o <= 1'b1;\n            spi_sck_o <= 1'b0;\n            spi_mosi_o <= 1'b0;\n            do_valid_d <= 1'b0;\n            do_o <= {WORD_WIDTH{1'b0}};\n        end else begin\n            case (state)\n                IDLE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o <= 1'b0;\n                    spi_mosi_o <= 1'b0;\n                    do_valid_d <= 1'b0;\n                    do_o <= {WORD_WIDTH{1'b0}};\n                end\n\n                SELECT: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                    spi_mosi_o <= 1'b0;\n                    do_valid_d <= 1'b0;\n                    do_o <= {WORD_WIDTH{1'b0}};\n                end\n\n                TRANSFER: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                    spi_mosi_o <= shift_reg[WORD_WIDTH-1];\n                    \n                    if (rx_bit_count < WORD_WIDTH) begin\n                        rx_data[WORD_WIDTH-1-rx_bit_count] <= spi_miso_i;\n                    end\n                    \n                    if (tx_bit_count < WORD_WIDTH) begin\n                        shift_reg[WORD_WIDTH-1-tx_bit_count] <= tx_data[WORD_WIDTH-1-tx_bit_count];\n                    end\n\n                    do_valid_d <= 1'b0;\n                    do_o <= {WORD_WIDTH{1'b0}};\n                end\n\n                AWAIT_WR_ACK: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                    spi_mosi_o <= 1'b0;\n                    do_valid_d <= 1'b0;\n                    do_o <= {WORD_WIDTH{1'b0}};\n                end\n\n                AWAIT_DO_VALID: begin\n                    spi_ssel_o <= 1'b0;\n                    spi_sck_o <= 1'b0;\n                    spi_mosi_o <= 1'b0;\n                    \n                    if (do_valid_sync_reg) begin\n                        do_valid_d <= 1'b1;\n                        do_o <= do_data;\n                    end else begin\n                        do_valid_d <= 1'b0;\n                        do_o <= {WORD_WIDTH{1'b0}};\n                    end\n                end\n            endcase\n        end\n    end\n\n    // Output registers for parallel interface\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {WORD_WIDTH{1'b0}};\n        end else begin\n            wr_ack_o <= wr_ack_pending;\n            do_valid_o <= do_valid_pending;\n            do_o <= do_data;\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
