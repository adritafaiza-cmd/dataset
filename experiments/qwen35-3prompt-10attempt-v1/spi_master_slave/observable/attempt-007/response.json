  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    localparam SPI_CLK_DIV = SPI_2X_CLK_DIV;\n    localparam MAX_DEPTH = 16; // Sufficient for typical SPI bursts\n\n    // State Machine States\n    localparam IDLE = 0;\n    localparam PREPARE = 1;\n    localprogram = 2;\n    localparam TRANSFER = 3;\n    localparam WAIT_ACK = 4;\n\n    reg [2:0] state;\n    reg [N-1:0] shift_reg;\n    reg [N-1:0] rx_data;\n    reg [N-1:0] tx_data;\n    reg shift_en;\n    reg bit_count;\n    reg transfer_complete;\n    reg ack_received;\n    reg ssel_active;\n\n    // Clock domain crossing registers for parallel interface\n    reg [N-1:0] di_sync_reg;\n    reg wren_sync_reg;\n    reg di_req_sync_reg;\n    reg wr_ack_sync_reg;\n    reg do_valid_sync_reg;\n    reg [N-1:0] do_sync_reg;\n\n    // Synchronous logic for parallel interface\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            di_sync_reg <= {N{1'b0}};\n            wren_sync_reg <= 1'b0;\n            di_req_sync_reg <= 1'b0;\n            wr_ack_sync_reg <= 1'b0;\n            do_valid_sync_reg <= 1'b0;\n            do_sync_reg <= {N{1'b0}};\n        end else begin\n            di_sync_reg <= di_i;\n            wren_sync_reg <= wren_i;\n            di_req_sync_reg <= di_req_o;\n            wr_ack_sync_reg <= wr_ack_o;\n            do_valid_sync_reg <= do_valid_o;\n            do_sync_reg <= do_o;\n        end\n    end\n\n    // SPI Clock Domain Logic\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            state <= IDLE;\n            shift_reg <= {N{1'b0}};\n            rx_data <= {N{1'b0}};\n            tx_data <= {N{1'b0}};\n            shift_en <= 1'b0;\n            bit_count <= 0;\n            transfer_complete <= 1'b0;\n            ack_received <= 1'b0;\n            ssel_active <= 1'b0;\n            spi_sck_o <= 1'b0;\n            spi_mosi_o <= 1'b0;\n            spi_ssel_o <= 1'b1;\n            di_req_o <= 1'b0;\n            wr_ack_o <= 1'b0;\n            do_valid_o <= 1'b0;\n            do_o <= {N{1'b0}};\n        end else begin\n            // State Machine\n            case (state)\n                IDLE: begin\n                    if (wren_sync_reg && !di_req_sync_reg) begin\n                        state <= PREPARE;\n                        tx_data <= di_sync_reg;\n                        shift_en <= 1'b1;\n                        bit_count <= 0;\n                        transfer_complete <= 1'b0;\n                        ack_received <= 1'b0;\n                        di_req_o <= 1'b1;\n                        spi_ssel_o <= 1'b0;\n                        spi_sck_o <= 1'b0;\n                        spi_mosi_o <= 1'b0;\n                    end\n                end\n\n                PREPARE: begin\n                    if (wren_sync_reg && di_req_sync_reg) begin\n                        state <= TRANSFER;\n                        shift_en <= 1'b1;\n                        bit_count <= 0;\n                        transfer_complete <= 1'b0;\n                        ack_received <= 1'b0;\n                        di_req_o <= 1'b0;\n                        spi_ssel_o <= 1'b0;\n                        spi_sck_o <= 1'b0;\n                        spi_mosi_o <= 1'b0;\n                    end\n                end\n\n                TRANSFER: begin\n                    if (shift_en) begin\n                        if (bit_count < N) begin\n                            // Shift out MSB first\n                            spi_mosi_o <= tx_data[N-1-bit_count];\n                            rx_data[N-1-bit_count] <= spi_miso_i;\n                            shift_reg[N-1-bit_count] <= spi_miso_i;\n                            bit_count <= bit_count + 1;\n                            spi_sck_o <= 1'b1;\n                        end else begin\n                            // Transfer complete\n                            shift_en <= 1'b0;\n                            transfer_complete <= 1'b1;\n                            spi_sck_o <= 1'b0;\n                            if (bit_count == N) begin\n                                state <= WAIT_ACK;\n                            end\n                        end\n                    end else begin\n                        spi_sck_o <= 1'b0;\n                    end\n                end\n\n                WAIT_ACK: begin\n                    if (ack_received) begin\n                        state <= IDLE;\n                        spi_ssel_o <= 1'b1;\n                        di_req_o <= 1'b0;\n                        wr_ack_o <= 1'b1;\n                        do_valid_o <= 1'b1;\n                        do_o <= shift_reg;\n                    end\n                end\n            endcase\n        end\n    end\n\n    // Clock domain crossing for SPI signals to parallel domain\n    // Using a simple 2-stage synchronizer for safety\n    reg [N-1:0] do_sync_stage1;\n    reg do_valid_sync_stage1;\n    reg do_valid_sync_stage2;\n    reg wr_ack_sync_stage1;\n    reg wr_ack_sync_stage2;\n    reg di_req_sync_stage1;\n    reg di_req_sync_stage2;\n\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            do_sync_stage1 <= {N{1'b0}};\n            do_valid_sync_stage1 <= 1'b0;\n            do_valid_sync_stage2 <= 1'b0;\n            wr_ack_sync_stage1 <= 1'b0;\n            wr_ack_sync_stage2 <= 1'b0;\n            di_req_sync_stage1 <= 1'b0;\n            di_req_sync_stage2 <= 1'b0;\n        end else begin\n            do_sync_stage1 <= do_o;\n            do_valid_sync_stage1 <= do_valid_o;\n            do_valid_sync_stage2 <= do_valid_sync_stage1;\n            wr_ack_sync_stage1 <= wr_ack_o;\n            wr_ack_sync_stage2 <= wr_ack_sync_stage1;\n            di_req_sync_stage1 <= di_req_o;\n            di_req_sync_stage2 <= di_req_sync_stage1;\n        end\n    end\n\n    // Output assignments based on synchronized signals\n    assign do_o = do_sync_stage1;\n    assign do_valid_o = do_valid_sync_stage2;\n    assign wr_ack_o = wr_ack_sync_stage2;\n    assign di_req_o = di_req_sync_stage2;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
