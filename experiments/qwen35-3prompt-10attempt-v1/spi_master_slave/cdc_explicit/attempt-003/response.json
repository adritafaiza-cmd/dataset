  "text": "```verilog\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n    input              spi_miso_i,\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // ========================================================================\n    // Clock Domain Crossing (CDC) Strategy:\n    // 1. PCLK Domain: State machine, data buffering, and handshake logic.\n    // 2. SCLK Domain: SPI shift register and timing generation.\n    // 3. Reset Domain: Use a multi-cycle reset synchronizer for both domains.\n    // ========================================================================\n\n    // ------------------------------------------------------------------------\n    // Synchronizers for Reset and Control Signals\n    // ------------------------------------------------------------------------\n    \n    // Synchronize rst_i to PCLK domain (2-stage)\n    reg pclk_rst_sync_1, pclk_rst_sync_2;\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            pclk_rst_sync_1 <= 1'b1;\n            pclk_rst_sync_2 <= 1'b1;\n        end else begin\n            pclk_rst_sync_1 <= rst_i;\n            pclk_rst_sync_2 <= pclk_rst_sync_1;\n        end\n    end\n\n    // Synchronize rst_i to SCLK domain (2-stage)\n    reg sclk_rst_sync_1, sclk_rst_sync_2;\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_rst_sync_1 <= 1'b1;\n            sclk_rst_sync_2 <= 1'b1;\n        end else begin\n            sclk_rst_sync_1 <= rst_i;\n            sclk_rst_sync_2 <= sclk_rst_sync_1;\n        end\n    end\n\n    // Synchronize wren_i to SCLK domain (2-stage)\n    reg sclk_wren_sync_1, sclk_wren_sync_2;\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i) begin\n            sclk_wren_sync_1 <= 1'b1;\n            sclk_wren_sync_2 <= 1'b1;\n        end else begin\n            sclk_wren_sync_1 <= wren_i;\n            sclk_wren_sync_2 <= sclk_wren_sync_1;\n        end\n    end\n\n    // ------------------------------------------------------------------------\n    // PCLK Domain: State Machine and Data Handling\n    // ------------------------------------------------------------------------\n\n    // State encoding\n    localparam IDLE = 2'b00;\n    localparam SHIFTING = 2'b01;\n    localparam DONE = 2'b10;\n\n    reg [1:0] pclk_state;\n    reg [N-1:0] pclk_data_reg;\n    reg pclk_shift_enable;\n    reg pclk_done_flag;\n    reg pclk_wr_ack;\n    reg pclk_di_req;\n\n    // State Machine\n    always @(posedge pclk_i or posedge pclk_rst_sync_2) begin\n        if (pclk_rst_sync_2) begin\n            pclk_state <= IDLE;\n            pclk_data_reg <= 0;\n            pclk_shift_enable <= 1'b0;\n            pclk_done_flag <= 1'b0;\n            pclk_wr_ack <= 1'b0;\n            pclk_di_req <= 1'b0;\n        end else begin\n            case (pclk_state)\n                IDLE: begin\n                    if (pclk_rst_sync_2 && wren_i) begin\n                        pclk_state <= SHIFTING;\n                        pclk_data_reg <= di_i;\n                        pclk_shift_enable <= 1'b1;\n                        pclk_wr_ack <= 1'b1; // Acknowledge write immediately on entry\n                        pclk_di_req <= 1'b0;\n                    end\n                end\n                SHIFTING: begin\n                    pclk_shift_enable <= 1'b1;\n                    pclk_done_flag <= 1'b0;\n                    // Wait for shift completion flag from SCLK domain\n                    if (sclk_shift_done) begin\n                        pclk_state <= DONE;\n                        pclk_shift_enable <= 1'b0;\n                        pclk_done_flag <= 1'b1;\n                        pclk_wr_ack <= 1'b0; // Clear ack after shift done\n                    end\n                end\n                DONE: begin\n                    pclk_shift_enable <= 1'b0;\n                    if (pclk_done_flag) begin\n                        pclk_state <= IDLE;\n                        pclk_done_flag <= 1'b0;\n                        pclk_di_req <= 1'b1; // Request next word\n                    end\n                end\n            endcase\n        end\n    end\n\n    // ------------------------------------------------------------------------\n    // SCLK Domain: SPI Shift Register and Timing\n    // ------------------------------------------------------------------------\n\n    // Shift register depth\n    localparam SPI_DEPTH = N;\n    reg [SPI_DEPTH-1:0] sclk_shift_reg;\n    reg [SPI_DEPTH-1:0] sclk_miso_reg;\n    reg sclk_shift_done;\n    reg sclk_ssel;\n    reg sclk_sck;\n    reg sclk_mosi;\n    reg [SPI_DEPTH-1:0] sclk_count;\n\n    // Initialize shift register on reset\n    always @(posedge sclk_i or posedge sclk_rst_sync_2) begin\n        if (sclk_rst_sync_2) begin\n            sclk_shift_reg <= {N{1'b0}};\n            sclk_miso_reg <= {N{1'b0}};\n            sclk_shift_done <= 1'b0;\n            sclk_ssel <= 1'b1;\n            sclk_sck <= 1'b0;\n            sclk_mosi <= 1'b0;\n            sclk_count <= 0;\n        end else begin\n            // Shift logic\n            if (pclk_shift_enable && sclk_count < SPI_DEPTH) begin\n                // Shift in new bit from MSB\n                sclk_shift_reg[sclk_count] <= pclk_data_reg[N-1-sclk_count];\n                sclk_mosi <= pclk_data_reg[N-1-sclk_count];\n                sclk_count <= sclk_count + 1'b1;\n            end else if (sclk_count == SPI_DEPTH) begin\n                // Shift complete\n                sclk_shift_done <= 1'b1;\n                sclk_count <= 0;\n                sclk_shift_reg <= {N{1'b0}};\n                sclk_mosi <= 1'b0;\n            end\n        end\n    end\n\n    // Clock generation with optional division\n    // If SPI_2X_CLK_DIV is 2, we toggle SCK every 2 SCLK cycles\n    // If SPI_2X_CLK_DIV is 1, we toggle SCK every 1 SCLK cycle\n    always @(posedge sclk_i or posedge sclk_rst_sync_2) begin\n        if (sclk_rst_sync_2) begin\n            sclk_sck <= 1'b0;\n        end else begin\n            if (sclk_shift_done) begin\n                sclk_sck <= 1'b0;\n            end else begin\n                // Simple counter for clock division\n                reg [1:0] sclk_div_counter;\n                always @(posedge sclk_i or posedge sclk_rst_sync_2) begin\n                    if (sclk_rst_sync_2) sclk_div_counter <= 0;\n                    else sclk_div_counter <= sclk_div_counter + 1'b1;\n                end\n                // Toggle SCK based on counter\n                if (sclk_div_counter == SPI_2X_CLK_DIV - 1'b1) begin\n                    sclk_sck <= ~sclk_sck;\n                    sclk_div_counter <= 0;\n                end\n            end\n        end\n    end\n\n    // Chip Select Logic\n    // Active low, asserted when shifting, deasserted when done\n    always @(posedge sclk_i or posedge sclk_rst_sync_2) begin\n        if (sclk_rst_sync_2) begin\n            sclk_ssel <= 1'b1;\n        end else begin\n            if (sclk_shift_done) begin\n                sclk_ssel <= 1'b1;\n            end else begin\n                sclk_ssel <= 1'b0;\n            end\n        end\n    end\n\n    // MISO Capture Logic\n    // Capture MISO bit when SCK is high (or falling edge depending on mode, assuming standard CPOL=0, CPHA=0)\n    // Assuming standard SPI: Sample on rising edge of SCK, Shift on falling edge.\n    // However, to be robust and simple, we sample MISO when SCK is high.\n    always @(posedge sclk_i or posedge sclk_rst_sync_2) begin\n        if (sclk_rst_sync_2) begin\n            sclk_miso_reg <= {N{1'b0}};\n        end else begin\n            if (sclk_shift_done) begin\n                sclk_miso_reg <= {N{1'b0}};\n            end else begin\n                // Shift MISO in opposite direction to MOSI\n                // If we shifted MOSI in at index 0, we want MISO at index 0 to be the last bit received\n                // Standard approach: Shift MISO into the register as we shift MOSI out\n                // But since we are capturing during the shift, let's capture on the rising edge of SCK\n                // and store it in the corresponding position.\n                // To align with MOSI shift direction (MSB first), MISO should also be MSB first.\n                if (sclk_count < SPI_DEPTH) begin\n                    sclk_miso_reg[sclk_count] <= spi_miso_i;\n                end\n            end\n        end\n    end\n\n    // ------------------------------------------------------------------------\n    // Output Drivers (PCLK Domain)\n    // ------------------------------------------------------------------------\n\n    // Assign SCLK and SSEL outputs from SCLK domain to PCLK domain safely\n    // Since these are single-bit signals, a 2-stage synchronizer is sufficient.\n    reg pclk_sclk_sync_1, pclk_sclk_sync_2;\n    reg pclk_ssel_sync_1, pclk_ssel_sync_2;\n\n    always @(posedge pclk_i or posedge pclk_rst_sync_2) begin\n        if (pclk_rst_sync_2) begin\n            pclk_sclk_sync_1 <= 1'b0;\n            pclk_sclk_sync_2 <= 1'b0;\n            pclk_ssel_sync_1 <= 1'b1;\n            pclk_ssel_sync_2 <= 1'b1;\n        end else begin\n            pclk_sclk_sync_1 <= sclk_sck;\n            pclk_sclk_sync_2 <= pclk_sclk_sync_1;\n            pclk_ssel_sync_1 <= sclk_ssel;\n            pclk_ssel_sync_2 <= pclk_ssel_sync_1;\n        end\n    end\n\n    assign spi_sck_o = pclk_sclk_sync_2;\n    assign spi_ssel_o = pclk_ssel_sync_2;\n\n    // MOSI Output\n    // Drive MOSI from PCLK domain. Since SCLK domain drives the actual pin,\n    // we need to drive the pin from PCLK domain. The SCLK domain logic above\n    // actually drives the internal state. We need to drive the physical pin `spi_mosi_o`.\n    // The SCLK domain logic `sclk_mosi` is the value to be driven.\n    // We synchronize `sclk_mosi` to PCLK and drive it.\n    reg pclk_mosi_sync_1, pclk_mosi_sync_2;\n    always @(posedge pclk_i or posedge pclk_rst_sync_2) begin\n        if (pclk_rst_sync_2) begin\n            pclk_mosi_sync_1 <= 1'b0;\n            pclk_mosi_sync_2 <= 1'b0;\n        end else begin\n            pclk_mosi_sync_1 <= sclk_mosi;\n            pclk_mosi_sync_2 <= pclk_mosi_sync_1;\n        end\n    end\n    assign spi_mosi_o = pclk_mosi_sync_2;\n\n    // DO Output and Valid\n    // Synchronize MISO data and valid flag to PCLK domain\n    reg [N-1:0] pclk_do_sync_1, pclk_do_sync_2;\n    reg pclk_do_valid_sync_1, pclk_do_valid_sync_2;\n\n    always @(posedge pclk_i or posedge pclk_rst_sync_2) begin\n        if (pclk_rst_sync_2) begin\n            pclk_do_sync_1 <= {N{1'b0}};\n            pclk_do_sync_2 <= {N{1'b0}};\n            pclk_do_valid_sync_1 <= 1'b0;\n            pclk_do_valid_sync_2 <= 1'b0;\n        end else begin\n            pclk_do_sync_1 <= sclk_miso_reg;\n            pclk_do_sync_2 <= pclk_do_sync_1;\n            pclk_do_valid_sync_1 <= sclk_shift_done;\n            pclk_do_valid_sync_2 <= pclk_do_valid_sync_1;\n        end\n    end\n\n    assign do_o = pclk_do_sync_2;\n    assign do_valid_o = pclk_do_valid_sync_2;\n\n    // WR_ACK Output\n    assign wr_ack_o = pclk_wr_ack;\n\n    // DI_REQ Output\n    assign di_req_o = pclk_di_req;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
