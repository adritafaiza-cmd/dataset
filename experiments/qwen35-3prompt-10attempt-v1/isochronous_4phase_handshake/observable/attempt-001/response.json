  "text": "```verilog\nmodule isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    // Synchronizer for dst_ready_i to src_clk domain\n    reg dst_ready_sync_1;\n    reg dst_ready_sync_2;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_ready_sync_1 <= 1'b0;\n            dst_ready_sync_2 <= 1'b0;\n        end else begin\n            dst_ready_sync_1 <= dst_ready_i;\n            dst_ready_sync_2 <= dst_ready_sync_1;\n        end\n    end\n\n    // Synchronizer for src_valid_i to dst_clk domain\n    reg src_valid_sync_1;\n    reg src_valid_sync_2;\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_valid_sync_1 <= 1'b0;\n            src_valid_sync_2 <= 1'b0;\n        end else begin\n            src_valid_sync_1 <= src_valid_i;\n            src_valid_sync_2 <= src_valid_sync_1;\n        end\n    end\n\n    // Handshake State Machine in src_clk domain\n    // States: IDLE, WAIT_DST_READY, WAIT_SRC_VALID_ACK\n    reg [1:0] state;\n    reg src_valid_latched;\n    reg dst_ready_latched;\n\n    parameter IDLE = 2'b00;\n    parameter WAIT_DST_READY = 2'b01;\n    parameter WAIT_SRC_VALID_ACK = 2'b10;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            state <= IDLE;\n            src_valid_latched <= 1'b0;\n            dst_ready_latched <= 1'b0;\n            src_ready_o <= 1'b0;\n            dst_valid_o <= 1'b0;\n        end else begin\n            // State Logic\n            case (state)\n                IDLE: begin\n                    if (src_valid_i) begin\n                        state <= WAIT_DST_READY;\n                        src_valid_latched <= 1'b1;\n                        dst_valid_o <= 1'b0; // Do not assert valid until dst_ready is seen\n                    end else begin\n                        state <= IDLE;\n                    end\n                end\n\n                WAIT_DST_READY: begin\n                    if (dst_ready_sync_2) begin\n                        // Phase 1: Data is valid on dst side\n                        dst_valid_o <= 1'b1;\n                        state <= WAIT_SRC_VALID_ACK;\n                        dst_ready_latched <= 1'b1;\n                    end else begin\n                        // Wait for dst_ready\n                        state <= WAIT_DST_READY;\n                    end\n                end\n\n                WAIT_SRC_VALID_ACK: begin\n                    if (src_valid_sync_2) begin\n                        // Phase 2: Data accepted by src\n                        src_ready_o <= 1'b1;\n                        state <= IDLE;\n                        src_valid_latched <= 1'b0;\n                        dst_ready_latched <= 1'b0;\n                        dst_valid_o <= 1'b0;\n                    end else begin\n                        // Wait for src_valid to confirm acceptance\n                        state <= WAIT_SRC_VALID_ACK;\n                    end\n                end\n            endcase\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
