  "text": "module isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    reg src_state;\n    reg dst_state;\n    reg src_valid_reg;\n    reg dst_valid_reg;\n    reg dst_ready_reg;\n\n    // State encoding: 0=Idle, 1=WaitValid, 2=WaitReady, 3=WaitValidAck, 4=WaitReadyAck\n    // Source Domain States\n    // 0: Idle (src_ready_o = 0)\n    // 1: Waiting for dst_valid_o (src_ready_o = 1)\n    // 2: Waiting for dst_ready_i (src_ready_o = 0)\n    // 3: Waiting for dst_valid_o again (src_ready_o = 1)\n    // 4: Waiting for dst_ready_i again (src_ready_o = 0)\n\n    // Destination Domain States\n    // 0: Idle (dst_valid_o = 0)\n    // 1: Waiting for src_ready_o (dst_valid_o = 1)\n    // 2: Waiting for src_valid_i (dst_valid_o = 0)\n    // 3: Waiting for src_ready_o again (dst_valid_o = 1)\n    // 4: Waiting for src_valid_i again (dst_valid_o = 0)\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_state <= 0;\n            src_valid_reg <= 0;\n            src_ready_o <= 0;\n        end else begin\n            case (src_state)\n                0: begin // Idle\n                    src_ready_o <= 0;\n                    if (src_valid_i)\n                        src_state <= 1;\n                end\n                1: begin // Wait for dst_valid_o\n                    src_ready_o <= 1;\n                    if (src_valid_i && dst_valid_o)\n                        src_state <= 2;\n                end\n                2: begin // Wait for dst_ready_i\n                    src_ready_o <= 0;\n                    if (dst_ready_i)\n                        src_state <= 3;\n                end\n                3: begin // Wait for dst_valid_o again\n                    src_ready_o <= 1;\n                    if (dst_valid_o)\n                        src_state <= 4;\n                end\n                4: begin // Wait for dst_ready_i again\n                    src_ready_o <= 0;\n                    if (dst_ready_i)\n                        src_state <= 0; // Complete handshake\n                end\n                default: begin\n                    src_state <= 0;\n                    src_ready_o <= 0;\n                end\n            endcase\n        end\n    end\n\n    // Synchronize dst_ready_i to src domain for state machine\n    reg dst_ready_sync;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_ready_sync <= 0;\n        else\n            dst_ready_sync <= dst_ready_i;\n    end\n\n    // Synchronize dst_valid_o to src domain for state machine\n    reg dst_valid_sync;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_valid_sync <= 0;\n        else\n            dst_valid_sync <= dst_valid_o;\n    end\n\n    // Update state machine with synchronized signals\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_state <= 0;\n            src_valid_reg <= 0;\n            src_ready_o <= 0;\n        end else begin\n            case (src_state)\n                0: begin\n                    src_ready_o <= 0;\n                    if (src_valid_i)\n                        src_state <= 1;\n                end\n                1: begin\n                    src_ready_o <= 1;\n                    if (src_valid_i && dst_valid_sync)\n                        src_state <= 2;\n                end\n                2: begin\n                    src_ready_o <= 0;\n                    if (dst_ready_sync)\n                        src_state <= 3;\n                end\n                3: begin\n                    src_ready_o <= 1;\n                    if (dst_valid_sync)\n                        src_state <= 4;\n                end\n                4: begin\n                    src_ready_o <= 0;\n                    if (dst_ready_sync)\n                        src_state <= 0;\n                end\n                default: begin\n                    src_state <= 0;\n                    src_ready_o <= 0;\n                end\n            endcase\n        end\n    end\n\n    // Destination Domain State Machine\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_state <= 0;\n            dst_valid_reg <= 0;\n            dst_valid_o <= 0;\n        end else begin\n            case (dst_state)\n                0: begin // Idle\n                    dst_valid_o <= 0;\n                    if (dst_ready_i)\n                        dst_state <= 1;\n                end\n                1: begin // Wait for src_ready_o\n                    dst_valid_o <= 1;\n                    if (dst_ready_i && src_ready_o)\n                        dst_state <= 2;\n                end\n                2: begin // Wait for src_valid_i\n                    dst_valid_o <= 0;\n                    if (src_valid_i)\n                        dst_state <= 3;\n                end\n                3: begin // Wait for src_ready_o again\n                    dst_valid_o <= 1;\n                    if (src_ready_o)\n                        dst_state <= 4;\n                end\n                4: begin // Wait for src_valid_i again\n                    dst_valid_o <= 0;\n                    if (src_valid_i)\n                        dst_state <= 0; // Complete handshake\n                end\n                default: begin\n                    dst_state <= 0;\n                    dst_valid_o <= 0;\n                end\n            endcase\n        end\n    end\n\n    // Synchronize src_valid_i to dst domain for state machine\n    reg src_valid_sync;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_valid_sync <= 0;\n        else\n            src_valid_sync <= src_valid_i;\n    end\n\n    // Update destination state machine with synchronized signals\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_state <= 0;\n            dst_valid_reg <= 0;\n            dst_valid_o <= 0;\n        end else begin\n            case (dst_state)\n                0: begin\n                    dst_valid_o <= 0;\n                    if (dst_ready_i)\n                        dst_state <= 1;\n                end\n                1: begin\n                    dst_valid_o <= 1;\n                    if (dst_ready_i && src_valid_sync)\n                        dst_state <= 2;\n                end\n                2: begin\n                    dst_valid_o <= 0;\n                    if (src_valid_sync)\n                        dst_state <= 3;\n                end\n                3: begin\n                    dst_valid_o <= 1;\n                    if (src_valid_sync)\n                        dst_state <= 4;\n                end\n                4: begin\n                    dst_valid_o <= 0;\n                    if (src_valid_sync)\n                        dst_state <= 0;\n                end\n                default: begin\n                    dst_state <= 0;\n                    dst_valid_o <= 0;\n                end\n            endcase\n        end\n    end\n\nendmodule<|im_end|>\n<|endoftext|>",
