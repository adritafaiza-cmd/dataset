{
  "text": "module isochronous_4phase_handshake (\n    input  src_clk_i,\n    input  src_rst_ni,\n    input  src_valid_i,\n    output src_ready_o,\n    input  dst_clk_i,\n    input  dst_rst_ni,\n    output dst_valid_o,\n    input  dst_ready_i\n);\n\n    reg src_state;\n    reg dst_state;\n    reg src_valid_reg;\n    reg dst_valid_reg;\n    reg dst_ready_reg;\n\n    // State encoding: 0=Idle, 1=SentValid, 2=SentReady, 3=SentValidAgain\n    parameter IDLE = 2'b00;\n    parameter SENT_VALID = 2'b01;\n    parameter SENT_READY = 2'b10;\n    parameter SENT_VALID_AGAIN = 2'b11;\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_state <= IDLE;\n        else\n            src_state <= src_state;\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_state <= IDLE;\n        else\n            dst_state <= dst_state;\n    end\n\n    // Synchronize src_valid_i to dst domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_valid_reg <= 1'b0;\n        else\n            src_valid_reg <= src_valid_i;\n    end\n\n    // Synchronize dst_ready_i to src domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_ready_reg <= 1'b0;\n        else\n            dst_ready_reg <= dst_ready_i;\n    end\n\n    // Synchronize dst_valid_o to src domain for state machine logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            dst_valid_reg <= 1'b0;\n        else\n            dst_valid_reg <= dst_valid_o;\n    end\n\n    // Synchronize src_ready_o to dst domain for state machine logic\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            src_ready_reg <= 1'b0;\n        else\n            src_ready_reg <= src_ready_o;\n    end\n\n    // State machine for Source domain\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_state <= IDLE;\n        else\n            case (src_state)\n                IDLE: begin\n                    if (src_valid_i)\n                        src_state <= SENT_VALID;\n                    else\n                        src_state <= IDLE;\n                end\n                SENT_VALID: begin\n                    if (dst_ready_reg)\n                        src_state <= SENT_READY;\n                    else\n                        src_state <= SENT_VALID;\n                end\n                SENT_READY: begin\n                    if (src_valid_i)\n                        src_state <= SENT_VALID_AGAIN;\n                    else\n                        src_state <= SENT_READY;\n                end\n                SENT_VALID_AGAIN: begin\n                    if (dst_ready_reg)\n                        src_state <= IDLE;\n                    else\n                        src_state <= SENT_VALID_AGAIN;\n                end\n                default: src_state <= IDLE;\n            endcase\n    end\n\n    // State machine for Destination domain\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_state <= IDLE;\n        else\n            case (dst_state)\n                IDLE: begin\n                    if (src_valid_reg)\n                        dst_state <= SENT_VALID;\n                    else\n                        dst_state <= IDLE;\n                end\n                SENT_VALID: begin\n                    if (src_ready_reg)\n                        dst_state <= SENT_READY;\n                    else\n                        dst_state <= SENT_VALID;\n                end\n                SENT_READY: begin\n                    if (dst_ready_i)\n                        dst_state <= SENT_VALID_AGAIN;\n                    else\n                        dst_state <= SENT_READY;\n                end\n                SENT_VALID_AGAIN: begin\n                    if (src_ready_reg)\n                        dst_state <= IDLE;\n                    else\n                        dst_state <= SENT_VALID_AGAIN;\n                end\n                default: dst_state <= IDLE;\n            endcase\n    end\n\n    // Output assignments\n    assign src_ready_o = (src_state == SENT_READY) || (src_state == SENT_VALID_AGAIN);\n    assign dst_valid_o = (dst_state == SENT_VALID) || (dst_state == SENT_VALID_AGAIN);\n\nendmodule<|im_end|>\n<|endoftext|>",
