  "text": "```systemverilog\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  localparam DATA_WIDTH = WIDTH;\n  localparam SYNC_STAGES = SYNC_STAGES;\n  localparam CLEAR_ON_ASYNC_RESET = CLEAR_ON_ASYNC_RESET;\n\n  // State encoding for the handshake controller\n  // IDLE: No data in flight\n  // DATA: Data is being transferred (src_valid asserted, dst_ready waiting)\n  // CLEAR_SRC: Source side requested clear, data dropped, waiting for dst to clear\n  // CLEAR_DST: Dest side requested clear, data dropped, waiting for src to clear\n  // CLEAR_DONE: Both sides clear requested, channel flushed, returning to IDLE\n  typedef enum logic [1:0] {\n    STATE_IDLE,\n    STATE_DATA,\n    STATE_CLEAR_SRC,\n    STATE_CLEAR_DST,\n    STATE_CLEAR_DONE\n  } state_t;\n\n  // Synchronizers for asynchronous signals\n  // We use a 2-stage synchronizer for all async inputs to ensure CDC compliance\n  logic [SYNC_STAGES-1:0] src_valid_synced;\n  logic [SYNC_STAGES-1:0] src_data_synced;\n  logic [SYNC_STAGES-1:0] src_clear_synced;\n  logic [SYNC_STAGES-1:0] dst_valid_synced;\n  logic [SYNC_STAGES-1:0] dst_ready_synced;\n  logic [SYNC_STAGES-1:0] dst_clear_synced;\n  logic [SYNC_STAGES-1:0] src_rst_synced;\n  logic [SYNC_STAGES-1:0] dst_rst_synced;\n\n  // Internal state machine\n  state_t state;\n  logic [DATA_WIDTH-1:0] internal_data;\n  logic internal_valid;\n  logic internal_ready;\n  logic clear_request_src;\n  logic clear_request_dst;\n  logic clear_in_progress;\n\n  // ------------------------------------------------------------------\n  // 1. Synchronizers\n  // ------------------------------------------------------------------\n  genvar i;\n  generate\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_src_valid_sync\n      assign src_valid_synced[i] = src_valid_synced[i-1] ? src_valid_synced[i-1] : src_valid_i;\n    end\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_src_data_sync\n      assign src_data_synced[i] = src_data_synced[i-1] ? src_data_synced[i-1] : src_data_i;\n    end\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_src_clear_sync\n      assign src_clear_synced[i] = src_clear_synced[i-1] ? src_clear_synced[i-1] : src_clear_i;\n    end\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_dst_valid_sync\n      assign dst_valid_synced[i] = dst_valid_synced[i-1] ? dst_valid_synced[i-1] : dst_ready_i;\n    end\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_dst_ready_sync\n      assign dst_ready_synced[i] = dst_ready_synced[i-1] ? dst_ready_synced[i-1] : dst_ready_i;\n    end\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_dst_clear_sync\n      assign dst_clear_synced[i] = dst_clear_synced[i-1] ? dst_clear_synced[i-1] : dst_clear_i;\n    end\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_src_rst_sync\n      assign src_rst_synced[i] = src_rst_synced[i-1] ? src_rst_synced[i-1] : src_rst_ni;\n    end\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_dst_rst_sync\n      assign dst_rst_synced[i] = dst_rst_synced[i-1] ? dst_rst_synced[i-1] : dst_rst_ni;\n    end\n  endgenerate\n\n  // ------------------------------------------------------------------\n  // 2. State Machine Logic\n  // ------------------------------------------------------------------\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      state <= STATE_IDLE;\n      internal_data <= '0;\n      internal_valid <= 1'b0;\n      clear_request_src <= 1'b0;\n      clear_request_dst <= 1'b0;\n      clear_in_progress <= 1'b0;\n    end else begin\n      // Reset synchronization logic\n      logic rst_src_synced = src_rst_synced[SYNC_STAGES-1];\n      logic rst_dst_synced = dst_rst_synced[SYNC_STAGES-1];\n\n      // Determine if we need to force clear based on async reset\n      logic force_clear_src = CLEAR_ON_ASYNC_RESET && rst_src_synced;\n      logic force_clear_dst = CLEAR_ON_ASYNC_RESET && rst_dst_synced;\n\n      // Combine explicit clear requests with async reset forces\n      clear_request_src = src_clear_synced[SYNC_STAGES-1] || force_clear_src;\n      clear_request_dst = dst_clear_synced[SYNC_STAGES-1] || force_clear_dst;\n\n      case (state)\n        STATE_IDLE: begin\n          if (src_valid_synced[SYNC_STAGES-1] && !clear_request_src) begin\n            state <= STATE_DATA;\n            internal_data <= src_data_synced[SYNC_STAGES-1];\n            internal_valid <= 1'b1;\n          end else if (clear_request_src && clear_request_dst) begin\n            // Both sides requested clear simultaneously, go directly to done\n            state <= STATE_CLEAR_DONE;\n          end else if (clear_request_src) begin\n            state <= STATE_CLEAR_SRC;\n          end else if (clear_request_dst) begin\n            state <= STATE_CLEAR_DST;\n          end else begin\n            state <= STATE_IDLE;\n          end\n        end\n\n        STATE_DATA: begin\n          if (dst_ready_synced[SYNC_STAGES-1]) begin\n            // Data accepted, return to idle\n            state <= STATE_IDLE;\n            internal_valid <= 1'b0;\n          end else if (clear_request_src) begin\n            // Source wants to clear while data is in flight\n            state <= STATE_CLEAR_SRC;\n          end else if (clear_request_dst) begin\n            // Dest wants to clear while data is in flight\n            state <= STATE_CLEAR_DST;\n          end else begin\n            state <= STATE_DATA;\n          end\n        end\n\n        STATE_CLEAR_SRC: begin\n          // Source has requested clear. We are dropping the data.\n          // We wait for destination to acknowledge the clear request.\n          if (clear_request_dst) begin\n            state <= STATE_CLEAR_DONE;\n          end else if (dst_ready_synced[SYNC_STAGES-1]) begin\n            // If dest is ready, we can technically send a \"clear\" beat, \n            // but the spec says \"Reset and clear must not create a destination beat\".\n            // So we just wait for the clear request from dest.\n            state <= STATE_CLEAR_SRC;\n          end else begin\n            state <= STATE_CLEAR_SRC;\n          end\n        end\n\n        STATE_CLEAR_DST: begin\n          // Dest has requested clear. We are dropping the data.\n          // We wait for source to acknowledge the clear request.\n          if (clear_request_src) begin\n            state <= STATE_CLEAR_DONE;\n          end else if (src_valid_synced[SYNC_STAGES-1]) begin\n            // If src is valid, we ignore it to prevent sending data during clear\n            state <= STATE_CLEAR_DST;\n          end else begin\n            state <= STATE_CLEAR_DST;\n          end\n        end\n\n        STATE_CLEAR_DONE: begin\n          // Both sides requested clear. Channel is flushed.\n          // Return to idle.\n          state <= STATE_IDLE;\n          internal_valid <= 1'b0;\n        end\n      endcase\n    end\n  end\n\n  // ------------------------------------------------------------------\n  // 3. Output Logic & CDC Crossing\n  // ------------------------------------------------------------------\n  // Internal handshake signals\n  assign internal_ready = (state == STATE_DATA) ? dst_ready_synced[SYNC_STAGES-1] : 1'b1;\n  assign internal_valid = (state == STATE_DATA) ? 1'b1 : 1'b0;\n\n  // Cross back to source domain for src_ready_o\n  // We need to synchronize dst_ready and internal_valid back to src_clk\n  logic [SYNC_STAGES-1:0] dst_ready_back;\n  logic [SYNC_STAGES-1:0] internal_valid_back;\n\n  generate\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_dst_ready_back\n      assign dst_ready_back[i] = dst_ready_back[i-1] ? dst_ready_back[i-1] : dst_ready_synced[i-1];\n    end\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_internal_valid_back\n      assign internal_valid_back[i] = internal_valid_back[i-1] ? internal_valid_back[i-1] : internal_valid;\n    end\n  endgenerate\n\n  assign src_ready_o = dst_ready_back[SYNC_STAGES-1] && internal_valid_back[SYNC_STAGES-1];\n\n  // Cross back to source domain for clear pending status\n  // src_clear_pending_o is high while we are in clear states\n  logic [SYNC_STAGES-1:0] clear_pending_src_back;\n  generate\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_clear_pending_src_back\n      assign clear_pending_src_back[i] = clear_pending_src_back[i-1] ? clear_pending_src_back[i-1] : \n                                         (state == STATE_CLEAR_SRC || state == STATE_CLEAR_DONE);\n    end\n  endgenerate\n  assign src_clear_pending_o = clear_pending_src_back[SYNC_STAGES-1];\n\n  // Cross to destination domain for data and valid\n  logic [SYNC_STAGES-1:0] internal_data_back;\n  logic [SYNC_STAGES-1:0] internal_valid_out_back;\n\n  generate\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_internal_data_back\n      assign internal_data_back[i] = internal_data_back[i-1] ? internal_data_back[i-1] : internal_data;\n    end\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_internal_valid_out_back\n      assign internal_valid_out_back[i] = internal_valid_out_back[i-1] ? internal_valid_out_back[i-1] : internal_valid;\n    end\n  endgenerate\n\n  assign dst_data_o = internal_data_back[SYNC_STAGES-1];\n  assign dst_valid_o = internal_valid_out_back[SYNC_STAGES-1];\n\n  // Cross back to destination domain for clear pending status\n  // dst_clear_pending_o is high while we are in clear states\n  logic [SYNC_STAGES-1:0] clear_pending_dst_back;\n  generate\n    for (i = 0; i < SYNC_STAGES; i = i + 1) begin : gen_clear_pending_dst_back\n      assign clear_pending_dst_back[i] = clear_pending_dst_back[i-1] ? clear_pending_dst_back[i-1] : \n                                         (state == STATE_CLEAR_DST || state == STATE_CLEAR_DONE);\n    end\n  endgenerate\n  assign dst_clear_pending_o = clear_pending_dst_back[SYNC_STAGES-1];\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
