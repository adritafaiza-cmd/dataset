  "text": "```verilog\nmodule cdc_fifo_gray_clearable #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input                  src_clear_i,\n    output                 src_clear_pending_o,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    input                  dst_clear_i,\n    output                 dst_clear_pending_o,\n    output [WIDTH-1:0]     dst_data_o,\n    output                 dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam GRAY_WIDTH = LOG_DEPTH;\n\n    // Internal signals for pointers\n    reg [GRAY_WIDTH-1:0] src_gray_ptr;\n    reg [GRAY_WIDTH-1:0] dst_gray_ptr;\n    reg [LOG_DEPTH-1:0] src_bin_ptr;\n    reg [LOG_DEPTH-1:0] dst_bin_ptr;\n    \n    // Clear state machine flags\n    reg src_clear_req;\n    reg dst_clear_req;\n    reg src_clear_ack;\n    reg dst_clear_ack;\n    \n    // Clear pending flags (output)\n    reg src_clear_pending;\n    reg dst_clear_pending;\n\n    // Data storage\n    reg [WIDTH-1:0] mem [DEPTH-1:0];\n    reg [LOG_DEPTH-1:0] write_ptr_bin;\n    reg [LOG_DEPTH-1:0] read_ptr_bin;\n    reg write_en;\n    reg read_en;\n    reg full;\n    reg empty;\n\n    // Synchronizers for clear requests\n    reg [SYNC_STAGES-1:0] src_clear_sync;\n    reg [SYNC_STAGES-1:0] dst_clear_sync;\n    \n    // Synchronizers for clear acks (to detect completion)\n    reg [SYNC_STAGES-1:0] src_clear_ack_sync;\n    reg [SYNC_STAGES-1:0] dst_clear_ack_sync;\n\n    // Synchronizers for ready signals\n    reg [SYNC_STAGES-1:1] src_ready_sync;\n    reg [SYNC_STAGES-1:1] dst_valid_sync;\n\n    // ------------------------------------------------------------------\n    // CDC: Clear Request Synchronizers\n    // ------------------------------------------------------------------\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni)\n            src_clear_sync <= {SYNC_STAGES{1'b0}};\n        else\n            src_clear_sync <= {src_clear_sync[SYNC_STAGES-2:0], src_clear_i};\n    end\n\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni)\n            dst_clear_sync <= {SYNC_STAGES{1'b0}};\n        else\n            dst_clear_sync <= {dst_clear_sync[SYNC_STAGES-2:0], dst_clear_i};\n    end\n\n    // ------------------------------------------------------------------\n    // CDC: Clear Ack Synchronizers\n    // ------------------------------------------------------------------\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni)\n            src_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            src_clear_ack_sync <= {src_clear_ack_sync[SYNC_STAGES-2:0], src_clear_ack};\n    end\n\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni)\n            dst_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            dst_clear_ack_sync <= {dst_clear_ack_sync[SYNC_STAGES-2:0], dst_clear_ack};\n    end\n\n    // ------------------------------------------------------------------\n    // CDC: Ready/Valid Synchronizers\n    // ------------------------------------------------------------------\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni)\n            src_ready_sync <= {SYNC_STAGES{1'b0}};\n        else\n            src_ready_sync <= {src_ready_sync[SYNC_STAGES-2:0], dst_ready_i};\n    end\n\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni)\n            dst_valid_sync <= {SYNC_STAGES{1'b0}};\n        else\n            dst_valid_sync <= {dst_valid_sync[SYNC_STAGES-2:0], src_valid_i};\n    end\n\n    // ------------------------------------------------------------------\n    // Pointer Logic (Binary)\n    // ------------------------------------------------------------------\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni) begin\n            src_bin_ptr <= 1'b0;\n            write_ptr_bin <= 1'b0;\n            src_clear_ack <= 1'b0;\n        end else begin\n            src_bin_ptr <= src_bin_ptr;\n            write_ptr_bin <= write_ptr_bin;\n            src_clear_ack <= src_clear_ack;\n        end\n    end\n\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni) begin\n            dst_bin_ptr <= 1'b0;\n            read_ptr_bin <= 1'b0;\n            dst_clear_ack <= 1'b0;\n        end else begin\n            dst_bin_ptr <= dst_bin_ptr;\n            read_ptr_bin <= read_ptr_bin;\n            dst_clear_ack <= dst_clear_ack;\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Gray Code Conversion\n    // ------------------------------------------------------------------\n    assign src_gray_ptr = src_bin_ptr ^ {GRAY_WIDTH{src_bin_ptr[LOG_DEPTH-2:0]}};\n    assign dst_gray_ptr = dst_bin_ptr ^ {GRAY_WIDTH{dst_bin_ptr[LOG_DEPTH-2:0]}};\n\n    // ------------------------------------------------------------------\n    // Full/Empty Logic\n    // ------------------------------------------------------------------\n    assign full = (src_bin_ptr == dst_bin_ptr) && (src_clear_ack && dst_clear_ack);\n    assign empty = (src_bin_ptr == dst_bin_ptr) && (!src_clear_ack || !dst_clear_ack);\n\n    // ------------------------------------------------------------------\n    // Clear State Machine\n    // ------------------------------------------------------------------\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni) begin\n            src_clear_req <= 1'b0;\n            src_clear_pending <= 1'b0;\n        end else begin\n            src_clear_req <= src_clear_sync[SYNC_STAGES-1];\n            src_clear_pending <= src_clear_req;\n        end\n    end\n\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni) begin\n            dst_clear_req <= 1'b0;\n            dst_clear_pending <= 1'b0;\n        end else begin\n            dst_clear_req <= dst_clear_sync[SYNC_STAGES-1];\n            dst_clear_pending <= dst_clear_req;\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Write Logic (Source Side)\n    // ------------------------------------------------------------------\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni) begin\n            write_en <= 1'b0;\n            full <= 1'b0;\n        end else begin\n            write_en <= src_valid_i && src_ready_o;\n            // Full condition: pointers equal AND clear is not active on both sides\n            // Actually, if clear is pending, we treat it as not full until clear completes?\n            // No, standard behavior: if clear is requested, we stop writing.\n            // Full is true if pointers equal AND no clear is in progress on either side.\n            // However, the problem states: \"A clear request should flush pending data together\".\n            // So if clear is requested, we stop writing immediately.\n            // Full logic: (src_bin == dst_bin) AND (src_clear_ack == 0) AND (dst_clear_ack == 0)\n            // But wait, if clear is requested, we must stop writing.\n            // Let's refine full logic:\n            // Full = (src_bin == dst_bin) AND (src_clear_ack == 0) AND (dst_clear_ack == 0)\n            // If clear is requested, we assume it will complete eventually.\n            // To be safe, if clear is requested on either side, we consider the FIFO \"cleared\" \n            // but not necessarily empty until acks come back? \n            // Actually, the simplest robust logic:\n            // Full = (src_bin == dst_bin) AND (src_clear_ack == 0) AND (dst_clear_ack == 0)\n            // If clear is requested, we stop writing. The pointers will diverge as we read.\n            // But if clear is requested, we must ensure we don't write new data.\n            // So: if (src_clear_req || dst_clear_req) write_en = 0;\n            \n            if (src_clear_req || dst_clear_req)\n                full <= 1'b1; // Force full to stop writing\n            else\n                full <= (src_bin_ptr == dst_bin_ptr);\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Read Logic (Destination Side)\n    // ------------------------------------------------------------------\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni) begin\n            read_en <= 1'b0;\n            empty <= 1'b1;\n        end else begin\n            read_en <= dst_valid_o && dst_ready_i;\n            // Empty condition: pointers equal AND clear is not active\n            if (dst_clear_req || src_clear_req)\n                empty <= 1'b0; // Force empty to stop reading (or rather, prevent reading stale data)\n            else\n                empty <= (dst_bin_ptr == src_bin_ptr);\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Pointer Updates\n    // ------------------------------------------------------------------\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni)\n            src_bin_ptr <= 1'b0;\n        else if (write_en)\n            src_bin_ptr <= src_bin_ptr + 1'b1;\n    end\n\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni)\n            dst_bin_ptr <= 1'b0;\n        else if (read_en)\n            dst_bin_ptr <= dst_bin_ptr + 1'b1;\n    end\n\n    // ------------------------------------------------------------------\n    // Data Output\n    // ------------------------------------------------------------------\n    assign dst_data_o = mem[dst_bin_ptr];\n    assign dst_valid_o = read_en && !empty;\n\n    // ------------------------------------------------------------------\n    // Write Enable\n    // ------------------------------------------------------------------\n    assign src_ready_o = !full;\n\n    // ------------------------------------------------------------------\n    // Clear Ack Generation\n    // ------------------------------------------------------------------\n    // Acknowledge when both sides have processed the clear request\n    // We use a simple counter or state machine to ensure both sides have seen the clear\n    // Since we have synchronized clear requests, we can just wait for both to be high\n    // and then assert ack.\n    \n    // Simple approach: if both clear requests are high, assert ack.\n    // To avoid glitches, we can use a small state machine or just logic with synchronization.\n    // Given the requirement \"clear resets each binary pointer and the Gray register that feeds its synchronizer on the same edge\",\n    // we need to ensure the pointers are reset when clear is acknowledged.\n    \n    // Let's use a simple logic: if both clear requests are high, assert ack.\n    // This will be synchronized to both clocks.\n    \n    // However, to prevent multiple acks, we can use a flip-flop to latch the ack condition.\n    // But since the clear request is one-shot (usually), we can just assert ack when both are high.\n    // To make it robust, we can use a small state machine.\n    \n    // Simpler approach: \n    // src_clear_ack = (src_clear_req && dst_clear_req)\n    // dst_clear_ack = (src_clear_req && dst_clear_req)\n    // This works because the clear request is synchronized.\n    \n    // But we need to ensure that the ack is only asserted once per clear cycle.\n    // If the clear signal is held high, we don't want to toggle the ack.\n    // So we can use a D flip-flop to latch the ack condition.\n    \n    reg src_clear_ack_latch;\n    reg dst_clear_ack_latch;\n\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni)\n            src_clear_ack_latch <= 1'b0;\n        else if (src_clear_req && dst_clear_req && !src_clear_ack_latch)\n            src_clear_ack_latch <= 1'b1;\n    end\n\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni)\n            dst_clear_ack_latch <= 1'b0;\n        else if (src_clear_req && dst_clear_req && !dst_clear_ack_latch)\n            dst_clear_ack_latch <= 1'b1;\n    end\n\n    assign src_clear_ack = src_clear_ack_latch;\n    assign dst_clear_ack = dst_clear_ack_latch;\n\n    // ------------------------------------------------------------------\n    // Pointer Reset on Clear Ack\n    // ------------------------------------------------------------------\n    // The problem states: \"A clear resets each binary pointer and the Gray register that feeds its synchronizer on the same edge.\"\n    // This implies that when the clear is acknowledged, the pointers are reset.\n    // We can do this in the pointer update logic.\n    \n    // Modify src_bin_ptr update:\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni || src_clear_ack)\n            src_bin_ptr <= 1'b0;\n        else if (write_en)\n            src_bin_ptr <= src_bin_ptr + 1'b1;\n    end\n\n    // Modify dst_bin_ptr update:\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni || dst_clear_ack)\n            dst_bin_ptr <= 1'b0;\n        else if (read_en)\n            dst_bin_ptr <= dst_bin_ptr + 1'b1;\n    end\n\n    // ------------------------------------------------------------------\n    // Memory Write\n    // ------------------------------------------------------------------\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni || write_en) begin\n            mem[write_ptr_bin] <= src_data_i;\n            write_ptr_bin <= src_bin_ptr;\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Output Clear Pending\n    // ------------------------------------------------------------------\n    // src_clear_pending_o is already generated above\n    // dst_clear_pending_o is already generated above\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
