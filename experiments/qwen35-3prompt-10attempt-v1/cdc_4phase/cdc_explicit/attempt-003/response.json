  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // ---------------------------------------------------------------------------\n  // Source Domain Logic\n  // ---------------------------------------------------------------------------\n  // State Machine States:\n  // IDLE: Waiting for valid\n  // GRAB: Valid asserted, waiting for ready (Phase 1)\n  // WAIT: Ready asserted, waiting for valid to drop (Phase 2)\n  // STABLE: Valid dropped, waiting for ready to drop (Phase 3)\n  // RELEASE: Ready dropped, waiting for valid to rise again (Phase 4)\n\n  typedef enum logic [1:0] {\n    SRC_IDLE,\n    SRC_GRAB,\n    SRC_WAIT,\n    SRC_STABLE,\n    SRC_RELEASE\n  } src_state_t;\n\n  src_state_t src_state, src_state_next;\n  logic       src_valid_reg;\n  logic       src_ready_reg;\n  logic       src_valid_d; // Delayed valid for stability check\n\n  // Reset logic for source domain\n  logic src_rst_n;\n  assign src_rst_n = src_rst_ni;\n\n  // State Register\n  always_ff @(posedge src_clk_i or negedge src_rst_n) begin\n    if (!src_rst_n) begin\n      src_state <= SRC_IDLE;\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b0;\n    end else begin\n      src_state <= src_state_next;\n      src_valid_reg <= src_valid_d;\n      src_ready_reg <= src_ready_reg; // Hold ready until state changes\n    end\n  end\n\n  // State Next Logic\n  always_comb begin\n    src_state_next = src_state;\n    src_ready_reg = 1'b0;\n    src_valid_d = 1'b0;\n\n    case (src_state)\n      SRC_IDLE: begin\n        if (src_valid_i) begin\n          src_state_next = SRC_GRAB;\n          src_ready_reg = 1'b1;\n          src_valid_d = 1'b1;\n        end\n      end\n\n      SRC_GRAB: begin\n        if (src_ready_i) begin\n          src_state_next = SRC_WAIT;\n          src_valid_d = 1'b1;\n        end\n      end\n\n      SRC_WAIT: begin\n        if (!src_valid_i) begin\n          src_state_next = SRC_STABLE;\n          src_valid_d = 1'b0;\n        end\n      end\n\n      SRC_STABLE: begin\n        if (src_ready_i) begin\n          src_state_next = SRC_RELEASE;\n          src_valid_d = 1'b0;\n        end\n      end\n\n      SRC_RELEASE: begin\n        if (src_valid_i) begin\n          src_state_next = SRC_GRAB;\n          src_ready_reg = 1'b1;\n          src_valid_d = 1'b1;\n        end\n      end\n\n      default: begin\n        src_state_next = SRC_IDLE;\n      end\n    endcase\n  end\n\n  // Output assignments for Source Domain\n  assign src_ready_o = src_ready_reg;\n\n  // ---------------------------------------------------------------------------\n  // Destination Domain Logic\n  // ---------------------------------------------------------------------------\n  // State Machine States:\n  // IDLE: Waiting for valid\n  // GRAB: Valid asserted, waiting for ready (Phase 1)\n  // WAIT: Ready asserted, waiting for valid to drop (Phase 2)\n  // STABLE: Valid dropped, waiting for ready to drop (Phase 3)\n  // RELEASE: Ready dropped, waiting for valid to rise again (Phase 4)\n\n  typedef enum logic [1:0] {\n    DST_IDLE,\n    DST_GRAB,\n    DST_WAIT,\n    DST_STABLE,\n    DST_RELEASE\n  } dst_state_t;\n\n  dst_state_t dst_state, dst_state_next;\n  logic       dst_valid_reg;\n  logic       dst_ready_reg;\n  logic       dst_valid_d; // Delayed valid for stability check\n  logic       dst_data_reg; // Delayed data for stability check\n  logic       dst_reset_msg_flag; // Flag to track if reset message has been sent\n\n  // Reset logic for destination domain\n  logic dst_rst_n;\n  assign dst_rst_n = dst_rst_ni;\n\n  // State Register\n  always_ff @(posedge dst_clk_i or negedge dst_rst_n) begin\n    if (!dst_rst_n) begin\n      dst_state <= DST_IDLE;\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b0;\n      dst_valid_d <= 1'b0;\n      dst_data_reg <= RESET_MSG;\n      dst_reset_msg_flag <= 0;\n    end else begin\n      dst_state <= dst_state_next;\n      dst_valid_reg <= dst_valid_d;\n      dst_ready_reg <= dst_ready_reg; // Hold ready until state changes\n      dst_valid_d <= dst_valid_d;\n      dst_data_reg <= dst_data_reg;\n      dst_reset_msg_flag <= dst_reset_msg_flag;\n    end\n  end\n\n  // State Next Logic\n  always_comb begin\n    dst_state_next = dst_state;\n    dst_ready_reg = 1'b0;\n    dst_valid_d = 1'b0;\n    dst_data_reg = RESET_MSG; // Default to reset message on reset or idle if configured\n\n    case (dst_state)\n      DST_IDLE: begin\n        if (dst_valid_i) begin\n          dst_state_next = DST_GRAB;\n          dst_ready_reg = 1'b1;\n          dst_valid_d = 1'b1;\n          dst_data_reg = src_data_i;\n        end\n      end\n\n      DST_GRAB: begin\n        if (dst_ready_i) begin\n          dst_state_next = DST_WAIT;\n          dst_valid_d = 1'b1;\n          dst_data_reg = src_data_i;\n        end\n      end\n\n      DST_WAIT: begin\n        if (!dst_valid_i) begin\n          dst_state_next = DST_STABLE;\n          dst_valid_d = 1'b0;\n        end\n      end\n\n      DST_STABLE: begin\n        if (dst_ready_i) begin\n          dst_state_next = DST_RELEASE;\n          dst_valid_d = 1'b0;\n        end\n      end\n\n      DST_RELEASE: begin\n        if (dst_valid_i) begin\n          dst_state_next = DST_GRAB;\n          dst_ready_reg = 1'b1;\n          dst_valid_d = 1'b1;\n          dst_data_reg = src_data_i;\n        end\n      end\n\n      default: begin\n        dst_state_next = DST_IDLE;\n      end\n    endcase\n  end\n\n  // Output assignments for Destination Domain\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\n  // ---------------------------------------------------------------------------\n  // Reset Message Handling\n  // ---------------------------------------------------------------------------\n  // If SEND_RESET_MSG is enabled, we need to ensure the reset message is sent\n  // exactly once after reset release in the destination domain.\n  // We use a flag to track if the reset message has been sent.\n  \n  always_ff @(posedge dst_clk_i or negedge dst_rst_n) begin\n    if (!dst_rst_n) begin\n      dst_reset_msg_flag <= 0;\n    end else begin\n      // If we are in DST_IDLE and the flag is not set, send the reset message\n      if (dst_state == DST_IDLE && !dst_reset_msg_flag) begin\n        dst_reset_msg_flag <= 1;\n        dst_data_reg <= RESET_MSG;\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
