  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Sender side (src_clk_i domain)\n  // State machine for 4-phase handshake:\n  // IDLE -> WAIT_VALID -> WAIT_READY -> IDLE\n  // We also handle reset message propagation if enabled.\n  \n  localparam STATE_IDLE = 2'b00;\n  localparam STATE_WAIT_VALID = 2'b01;\n  localparam STATE_WAIT_READY = 2'b10;\n  \n  reg [1:0] src_state;\n  reg [WIDTH-1:0] src_msg;\n  reg src_valid_reg;\n  reg src_ready_reg;\n  \n  // Receiver side (dst_clk_i domain)\n  // State machine for 4-phase handshake:\n  // IDLE -> WAIT_VALID -> WAIT_READY -> IDLE\n  \n  localparam DST_STATE_IDLE = 2'b00;\n  localparam DST_STATE_WAIT_VALID = 2'b01;\n  localparam DST_STATE_WAIT_READY = 2'b10;\n  \n  reg [1:0] dst_state;\n  reg [WIDTH-1:0] dst_msg;\n  reg dst_valid_reg;\n  reg dst_ready_reg;\n  \n  // Internal signals for cross-domain communication\n  // src_ready_o is driven by the sender based on receiver's state\n  // dst_valid_o is driven by the receiver based on sender's state\n  \n  // Sender logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state <= STATE_IDLE;\n      src_msg <= RESET_MSG;\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n    end else begin\n      case (src_state)\n        STATE_IDLE: begin\n          if (src_valid_i) begin\n            src_state <= STATE_WAIT_VALID;\n            src_msg <= src_data_i;\n          end\n          src_ready_reg <= 1'b1;\n        end\n        \n        STATE_WAIT_VALID: begin\n          if (src_valid_i) begin\n            src_state <= STATE_WAIT_READY;\n            src_msg <= src_data_i;\n          end\n          src_ready_reg <= 1'b0;\n        end\n        \n        STATE_WAIT_READY: begin\n          if (src_ready_reg) begin\n            src_state <= STATE_IDLE;\n            src_ready_reg <= 1'b1;\n          end\n        end\n      endcase\n    end\n  end\n  \n  // Receiver logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state <= DST_STATE_IDLE;\n      dst_msg <= RESET_MSG;\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b1;\n    end else begin\n      case (dst_state)\n        DST_STATE_IDLE: begin\n          if (dst_ready_i) begin\n            dst_state <= DST_STATE_WAIT_VALID;\n            dst_msg <= src_msg; // Capture the message from sender\n          end\n          dst_valid_reg <= 1'b0;\n        end\n        \n        DST_STATE_WAIT_VALID: begin\n          if (dst_ready_i) begin\n            dst_state <= DST_STATE_WAIT_READY;\n            dst_msg <= src_msg; // Capture the message from sender\n          end\n          dst_valid_reg <= 1'b0;\n        end\n        \n        DST_STATE_WAIT_READY: begin\n          if (dst_ready_i) begin\n            dst_state <= DST_STATE_IDLE;\n            dst_valid_reg <= 1'b1;\n            dst_msg <= src_msg; // Capture the message from sender\n          end\n        end\n      endcase\n    end\n  end\n  \n  // Output assignments\n  assign src_ready_o = src_ready_reg;\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_data_o = dst_msg;\n  \n  // Handle reset message propagation if enabled\n  if (SEND_RESET_MSG) begin\n    // When in reset state, we want to send the reset message\n    // This is handled by the state machine logic above\n    // The reset message is captured when the receiver is in IDLE state\n    // and the sender sends the reset message\n  end\n  \nendmodule\n```<|im_end|>\n<|endoftext|>",
