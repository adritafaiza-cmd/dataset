  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic src_valid_reg;\n  logic src_ready_reg;\n  logic [WIDTH-1:0] src_data_reg;\n  logic src_valid_next;\n  logic src_ready_next;\n\n  // Destination domain signals\n  logic dst_valid_reg;\n  logic dst_ready_reg;\n  logic [WIDTH-1:0] dst_data_reg;\n  logic dst_valid_next;\n  logic dst_ready_next;\n\n  // State machine for destination side (4-phase)\n  // States: IDLE, DATA, ACK, WAIT\n  enum logic [1:0] {\n    DST_IDLE,\n    DST_DATA,\n    DST_ACK,\n    DST_WAIT\n  } dst_state, dst_state_next;\n\n  // Source side state (simplified handshake logic)\n  // We need to track if we are waiting for the previous beat to complete\n  // before accepting a new one, unless DECOUPLED is set.\n  logic src_waiting_for_ack;\n\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n      src_data_reg <= '0;\n      src_waiting_for_ack <= 1'b0;\n    end else begin\n      src_valid_reg <= src_valid_next;\n      src_ready_reg <= src_ready_next;\n      src_data_reg <= src_data_next;\n      src_waiting_for_ack <= src_waiting_for_ack_next;\n    end\n  end\n\n  always_comb begin\n    src_valid_next = src_valid_reg;\n    src_ready_next = src_ready_reg;\n    src_data_next = src_data_reg;\n    src_waiting_for_ack_next = src_waiting_for_ack;\n\n    // Default values\n    src_ready_next = 1'b1;\n    src_valid_next = 1'b0;\n    src_data_next = '0;\n    src_waiting_for_ack_next = 1'b0;\n\n    // Handshake logic\n    if (!src_rst_ni) begin\n      src_ready_next = 1'b1;\n      src_valid_next = 1'b0;\n      src_waiting_for_ack_next = 1'b0;\n    end else begin\n      // If we are waiting for the previous beat to complete (non-decoupled mode)\n      if (!DECOUPLED && src_waiting_for_ack) begin\n        src_ready_next = 1'b0;\n      end else begin\n        src_ready_next = 1'b1;\n      end\n\n      // If valid and ready, accept data and set waiting flag if not decoupled\n      if (src_valid_i && src_ready_next) begin\n        src_valid_next = 1'b0; // Deassert valid immediately after acceptance\n        src_data_next = src_data_i;\n        if (!DECOUPLED) begin\n          src_waiting_for_ack_next = 1'b1;\n        end else begin\n          src_waiting_for_ack_next = 1'b0;\n        end\n      end\n    end\n  end\n\n  // Destination side logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b1;\n      dst_data_reg <= '0;\n      dst_state <= DST_IDLE;\n    end else begin\n      dst_valid_reg <= dst_valid_next;\n      dst_ready_reg <= dst_ready_next;\n      dst_data_reg <= dst_data_next;\n      dst_state <= dst_state_next;\n    end\n  end\n\n  always_comb begin\n    dst_valid_next = dst_valid_reg;\n    dst_ready_next = dst_ready_reg;\n    dst_data_next = dst_data_reg;\n    dst_state_next = dst_state;\n\n    // Default values\n    dst_ready_next = 1'b1;\n    dst_valid_next = 1'b0;\n    dst_data_next = '0;\n    dst_state_next = DST_IDLE;\n\n    if (!dst_rst_ni) begin\n      dst_ready_next = 1'b1;\n      dst_valid_next = 1'b0;\n      dst_data_next = '0;\n      dst_state_next = DST_IDLE;\n    end else begin\n      case (dst_state)\n        DST_IDLE: begin\n          if (src_valid_reg && src_ready_reg) begin\n            dst_valid_next = 1'b1;\n            dst_data_next = src_data_reg;\n            dst_state_next = DST_DATA;\n          end else begin\n            dst_state_next = DST_IDLE;\n          end\n        end\n\n        DST_DATA: begin\n          // Hold data stable while waiting for ready\n          dst_data_next = src_data_reg;\n          if (dst_ready_i) begin\n            dst_valid_next = 1'b0;\n            dst_state_next = DST_ACK;\n          end else begin\n            // Stay in DATA state, hold data\n            dst_state_next = DST_DATA;\n          end\n        end\n\n        DST_ACK: begin\n          // Wait for source to acknowledge (src_ready goes high)\n          // In 4-phase, we wait for src_ready to go high to indicate the previous beat is done\n          if (src_ready_reg) begin\n            dst_valid_next = 1'b0;\n            dst_state_next = DST_WAIT;\n          end else begin\n            dst_state_next = DST_ACK;\n          end\n        end\n\n        DST_WAIT: begin\n          // Wait for source to indicate it's ready for the next beat\n          // This is the \"wait for src_valid to go low\" phase effectively\n          if (!src_valid_reg) begin\n            dst_state_next = DST_IDLE;\n          end else begin\n            dst_state_next = DST_WAIT;\n          end\n        end\n\n        default: begin\n          dst_state_next = DST_IDLE;\n        end\n      endcase\n    end\n  end\n\n  // Handle Reset Message\n  if (SEND_RESET_MSG && !dst_rst_ni) begin\n    // During reset, force the reset message\n    dst_valid_next = 1'b1;\n    dst_data_next = RESET_MSG;\n    dst_state_next = DST_DATA;\n  end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
