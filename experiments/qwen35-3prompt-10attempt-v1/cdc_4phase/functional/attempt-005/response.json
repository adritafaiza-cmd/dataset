d_reg_next = 1'b1;\n          dst_ready_next = 1'b1;\n        end else begin\n          dst_ready_next = 1'b1;\n        end\n      end\n\n      dst_grab: begin\n        if (src_ready_i) begin\n          dst_state_next = dst_wait_src_ready;\n          dst_valid_reg_next = 1'b0;\n          dst_ready_next = 1'b1;\n        end else begin\n          dst_ready_next = 1'b0;\n        end\n      end\n\n      dst_wait_src_ready: begin\n        if (src_ready_i) begin\n          dst_state_next = dst_wait_src_valid;\n          dst_valid_reg_next = 1'b1;\n          dst_ready_next = 1'b1;\n        end else begin\n          dst_ready_next = 1'b1;\n        end\n      end\n\n      dst_wait_src_valid: begin\n        if (src_valid_i) begin\n          dst_state_next = dst_idl;\n          dst_valid_reg_next = 1'b0;\n          dst_ready_next = 1'b1;\n        end else begin\n          dst_ready_next = 1'b1;\n        end\n      end\n    endcase\n  end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
