  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state machine\n  // States: IDLE, WAIT_DST_READY, WAIT_SRC_VALID\n  localparam IDLE = 2'b00;\n  localparam WAIT_DST_READY = 2'b01;\n  localparam WAIT_SRC_VALID = 2'b10;\n\n  reg [1:0] src_state;\n  wire src_state_next;\n  wire src_valid_next;\n  wire src_data_next;\n  wire src_ready_next;\n  wire src_valid_curr;\n  wire src_data_curr;\n\n  // Destination domain state machine\n  // States: IDLE, WAIT_SRC_VALID, WAIT_SRC_READY\n  localparam DST_IDLE = 2'b00;\n  localparam DST_WAIT_SRC_VALID = 2'b01;\n  localparam DST_WAIT_SRC_READY = 2'b10;\n\n  reg [1:0] dst_state;\n  wire dst_state_next;\n  wire dst_valid_next;\n  wire dst_data_next;\n  wire dst_ready_next;\n  wire dst_valid_curr;\n  wire dst_data_curr;\n\n  // --- Source Domain Logic ---\n\n  // Current values for combinational next-state logic\n  assign src_valid_curr = src_valid_i;\n  assign src_data_curr = src_data_i;\n\n  always_comb begin\n    src_state_next = src_state;\n    src_valid_next = 1'b0;\n    src_data_next = src_data_i;\n    src_ready_next = 1'b0;\n\n    case (src_state)\n      IDLE: begin\n        if (src_valid_i) begin\n          src_state_next = WAIT_DST_READY;\n          src_valid_next = 1'b1;\n          src_data_next = src_data_i;\n          src_ready_next = 1'b1;\n        end else begin\n          src_ready_next = 1'b1;\n        end\n      end\n\n      WAIT_DST_READY: begin\n        if (dst_ready_i) begin\n          src_state_next = WAIT_SRC_VALID;\n          src_valid_next = 1'b0;\n          src_data_next = src_data_i;\n          src_ready_next = 1'b0;\n        end else begin\n          src_ready_next = 1'b0;\n        end\n      end\n\n      WAIT_SRC_VALID: begin\n        if (src_valid_i) begin\n          src_state_next = WAIT_DST_READY;\n          src_valid_next = 1'b1;\n          src_data_next = src_data_i;\n          src_ready_next = 1'b1;\n        end else begin\n          src_ready_next = 1'b1;\n        end\n      end\n\n      default: begin\n        src_state_next = IDLE;\n        src_valid_next = 1'b0;\n        src_data_next = src_data_i;\n        src_ready_next = 1'b1;\n      end\n    endcase\n  end\n\n  // --- Destination Domain Logic ---\n\n  // Current values for combinational next-state logic\n  assign dst_valid_curr = dst_valid_o;\n  assign dst_data_curr = dst_data_o;\n\n  always_comb begin\n    dst_state_next = dst_state;\n    dst_valid_next = 1'b0;\n    dst_data_next = dst_data_i; // Default to input data if not in transfer state\n    dst_ready_next = 1'b0;\n\n    // Handle Reset Message Logic\n    if (SEND_RESET_MSG && !dst_rst_ni) begin\n      dst_state_next = DST_IDLE;\n      dst_valid_next = 1'b1;\n      dst_data_next = RESET_MSG;\n      dst_ready_next = 1'b1;\n    end\n    else if (dst_state == DST_IDLE) begin\n      if (src_valid_i) begin\n        dst_state_next = DST_WAIT_SRC_READY;\n        dst_valid_next = 1'b1;\n        dst_data_next = src_data_i;\n        dst_ready_next = 1'b0;\n      end else begin\n        dst_ready_next = 1'b1;\n      end\n    end\n    else if (dst_state == DST_WAIT_SRC_READY) begin\n      if (src_ready_i) begin\n        dst_state_next = DST_WAIT_SRC_VALID;\n        dst_valid_next = 1'b0;\n        dst_data_next = src_data_i;\n        dst_ready_next = 1'b1;\n      end else begin\n        dst_ready_next = 1'b0;\n      end\n    end\n    else if (dst_state == DST_WAIT_SRC_VALID) begin\n      if (src_valid_i) begin\n        dst_state_next = DST_WAIT_SRC_READY;\n        dst_valid_next = 1'b1;\n        dst_data_next = src_data_i;\n        dst_ready_next = 1'b0;\n      end else begin\n        dst_ready_next = 1'b1;\n      end\n    end\n    else begin\n      dst_state_next = DST_IDLE;\n      dst_valid_next = 1'b0;\n      dst_data_next = dst_data_i;\n      dst_ready_next = 1'b1;\n    end\n  end\n\n  // --- Registers ---\n\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state <= IDLE;\n    end else begin\n      src_state <= src_state_next;\n    end\n  end\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state <= DST_IDLE;\n    end else begin\n      dst_state <= dst_state_next;\n    end\n  end\n\n  // --- Output Assignments ---\n\n  assign src_ready_o = src_ready_next;\n  assign dst_data_o = dst_data_next;\n  assign dst_valid_o = dst_valid_next;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
