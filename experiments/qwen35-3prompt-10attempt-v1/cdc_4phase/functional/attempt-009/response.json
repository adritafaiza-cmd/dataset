  "text": "```systemverilog\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state machine\n  localparam IDLE = 0;\n  localparam GRAB = 1;\n  localparam WAIT_DST = 2;\n  localparam DONE = 3;\n\n  reg [1:0] src_state;\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_valid_reg;\n  reg src_ready_reg;\n  reg [1:0] src_next_state;\n\n  // Destination domain state machine\n  localparam IDLE_D = 0;\n  localparam GRAB_D = 1;\n  localparam WAIT_SRC = 2;\n  localparam DONE_D = 3;\n\n  reg [1:0] dst_state;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n  reg dst_ready_reg;\n  reg [1:0] dst_next_state;\n\n  // Internal signals for handshake coordination\n  wire src_valid_next;\n  wire dst_valid_next;\n\n  // ---------------------------------------------------------\n  // Source Domain Logic\n  // ---------------------------------------------------------\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state <= IDLE;\n      src_data_reg <= '0;\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n    end else begin\n      src_state <= src_next_state;\n      src_data_reg <= src_data_reg;\n      src_valid_reg <= src_valid_reg;\n      src_ready_reg <= src_ready_reg;\n    end\n  end\n\n  always_comb begin\n    src_ready_o = 1'b0;\n    src_valid_next = 1'b0;\n    src_next_state = src_state;\n\n    case (src_state)\n      IDLE: begin\n        src_ready_o = 1'b1;\n        if (src_valid_i) begin\n          src_data_reg = src_data_i;\n          src_valid_next = 1'b1;\n          src_next_state = GRAB;\n        end\n      end\n\n      GRAB: begin\n        src_ready_o = 1'b0;\n        if (dst_ready_i) begin\n          src_valid_next = 1'b0;\n          src_next_state = DONE;\n        end\n      end\n\n      WAIT_DST: begin\n        src_ready_o = 1'b0;\n        if (dst_ready_i) begin\n          src_valid_next = 1'b0;\n          src_next_state = DONE;\n        end\n      end\n\n      DONE: begin\n        src_ready_o = 1'b1;\n        if (src_valid_i && DECOUPLED) begin\n          src_data_reg = src_data_i;\n          src_valid_next = 1'b1;\n          src_next_state = GRAB;\n        end else begin\n          src_next_state = IDLE;\n        end\n      end\n    endcase\n  end\n\n  // ---------------------------------------------------------\n  // Destination Domain Logic\n  // ---------------------------------------------------------\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state <= IDLE_D;\n      dst_data_reg <= '0;\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b1;\n    end else begin\n      dst_state <= dst_next_state;\n      dst_data_reg <= dst_data_reg;\n      dst_valid_reg <= dst_valid_reg;\n      dst_ready_reg <= dst_ready_reg;\n    end\n  end\n\n  always_comb begin\n    dst_ready_o = 1'b0;\n    dst_valid_next = 1'b0;\n    dst_next_state = dst_state;\n\n    case (dst_state)\n      IDLE_D: begin\n        dst_ready_o = 1'b1;\n        if (src_valid_reg) begin\n          dst_data_reg = src_data_reg;\n          dst_valid_next = 1'b1;\n          dst_next_state = GRAB_D;\n        end\n      end\n\n      GRAB_D: begin\n        dst_ready_o = 1'b0;\n        if (src_ready_o) begin\n          dst_valid_next = 1'b0;\n          dst_next_state = DONE_D;\n        end\n      end\n\n      WAIT_SRC: begin\n        dst_ready_o = 1'b0;\n        if (src_ready_o) begin\n          dst_valid_next = 1'b0;\n          dst_next_state = DONE_D;\n        end\n      end\n\n      DONE_D: begin\n        dst_ready_o = 1'b1;\n        if (src_valid_reg && DECOUPLED) begin\n          dst_data_reg = src_data_reg;\n          dst_valid_next = 1'b1;\n          dst_next_state = GRAB_D;\n        end else begin\n          dst_next_state = IDLE_D;\n        end\n      end\n    endcase\n  end\n\n  // ---------------------------------------------------------\n  // Output Assignments\n  // ---------------------------------------------------------\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\n  // Reset message handling logic\n  // This logic ensures that if SEND_RESET_MSG is set, the first valid beat\n  // after reset carries the RESET_MSG payload instead of waiting for source data.\n  // We implement this by checking if we are in the first cycle after reset in the\n  // destination domain and if SEND_RESET_MSG is enabled.\n  \n  reg [WIDTH-1:0] dst_data_override;\n  reg reset_active;\n\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      reset_active <= 1'b1;\n    end else begin\n      reset_active <= 1'b0;\n    end\n  end\n\n  always_comb begin\n    dst_data_override = dst_data_reg;\n    if (SEND_RESET_MSG && reset_active && dst_state == GRAB_D) begin\n      dst_data_override = RESET_MSG;\n    end\n  end\n\n  assign dst_data_o = dst_data_override;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
