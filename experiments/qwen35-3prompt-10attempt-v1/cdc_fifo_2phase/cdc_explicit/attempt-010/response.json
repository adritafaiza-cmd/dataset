  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule cdc_fifo_2phase #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output reg [WIDTH-1:0] dst_data_o,\n    output reg             dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam HALF_DEPTH = DEPTH / 2;\n\n    // Source Domain Signals\n    reg [LOG_DEPTH-1:0] src_ptr;\n    reg [LOG_DEPTH-1:0] dst_ptr;\n    reg [LOG_DEPTH-1:0] gray_src_ptr;\n    reg [LOG_DEPTH-1:0] gray_dst_ptr;\n    reg [WIDTH*DEPTH-1:0] mem;\n    reg [LOG_DEPTH-1:0] empty_gray;\n    reg [LOG_DEPTH-1:0] full_gray;\n    reg src_empty;\n    reg src_full;\n    reg src_valid_reg;\n    reg dst_valid_reg;\n\n    // Destination Domain Signals\n    reg [LOG_DEPTH-1:0] dst_ptr_reg;\n    reg [LOG_DEPTH-1:0] dst_ptr_gray;\n    reg [LOG_DEPTH-1:0] dst_ptr_gray_reg;\n    reg [WIDTH*DEPTH-1:0] mem_reg;\n    reg [LOG_DEPTH-1:0] empty_gray_reg;\n    reg [LOG_DEPTH-1:0] full_gray_reg;\n    reg dst_empty;\n    reg dst_full;\n    reg dst_valid_reg_reg;\n\n    // ------------------------------------------------------------------\n    // Source Domain Logic\n    // ------------------------------------------------------------------\n\n    // Reset Synchronizer for Source Reset (Active Low)\n    reg src_rst_sync;\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_rst_sync <= 1'b1;\n        else\n            src_rst_sync <= 1'b0;\n    end\n\n    // Pointer Logic\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_ptr <= '0;\n            dst_ptr <= '0;\n        end else begin\n            src_ptr <= src_ptr + 1'b1;\n            dst_ptr <= dst_ptr + 1'b1;\n        end\n    end\n\n    // Gray Code Encoding for Source Pointers\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            gray_src_ptr <= '0;\n        else\n            gray_src_ptr <= {src_ptr[LOG_DEPTH-2:0], ~src_ptr[LOG_DEPTH-2] ^ src_ptr[LOG_DEPTH-1]};\n    end\n\n    // Gray Code Encoding for Destination Pointers\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            gray_dst_ptr <= '0;\n        else\n            gray_dst_ptr <= {dst_ptr[LOG_DEPTH-2:0], ~dst_ptr[LOG_DEPTH-2] ^ dst_ptr[LOG_DEPTH-1]};\n    end\n\n    // Empty/Full Status Calculation (Source Domain)\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_empty <= 1'b1;\n            src_full <= 1'b0;\n        end else begin\n            src_empty <= (gray_src_ptr == gray_dst_ptr);\n            src_full <= (gray_src_ptr == (gray_dst_ptr + HALF_DEPTH));\n        end\n    end\n\n    // Write Enable & Data Storage\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            mem <= '0;\n            src_valid_reg <= 1'b0;\n        end else if (src_valid_i && !src_full) begin\n            mem[src_ptr] <= src_data_i;\n            src_valid_reg <= 1'b1;\n        end else begin\n            src_valid_reg <= 1'b0;\n        end\n    end\n\n    // Source Ready Output\n    assign src_ready_o = !src_full;\n\n    // ------------------------------------------------------------------\n    // Destination Domain Logic\n    // ------------------------------------------------------------------\n\n    // Reset Synchronizer for Destination Reset (Active Low)\n    reg dst_rst_sync;\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_rst_sync <= 1'b1;\n        else\n            dst_rst_sync <= 1'b0;\n    end\n\n    // Pointer Logic (Destination Domain)\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_ptr_reg <= '0;\n            dst_ptr_gray <= '0;\n        end else begin\n            dst_ptr_reg <= dst_ptr_reg + 1'b1;\n            // Update Gray code based on current binary pointer\n            dst_ptr_gray <= {dst_ptr_reg[LOG_DEPTH-2:0], ~dst_ptr_reg[LOG_DEPTH-2] ^ dst_ptr_reg[LOG_DEPTH-1]};\n        end\n    end\n\n    // Gray Code Encoding for Source Pointers (as seen from Dest)\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            empty_gray_reg <= '0;\n        else\n            empty_gray_reg <= {src_ptr[LOG_DEPTH-2:0], ~src_ptr[LOG_DEPTH-2] ^ src_ptr[LOG_DEPTH-1]};\n    end\n\n    // Gray Code Encoding for Full Status (as seen from Dest)\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            full_gray_reg <= '0;\n        else\n            full_gray_reg <= {dst_ptr_reg[LOG_DEPTH-2:0], ~dst_ptr_reg[LOG_DEPTH-2] ^ dst_ptr_reg[LOG_DEPTH-1]};\n    end\n\n    // Empty/Full Status Calculation (Destination Domain)\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_empty <= 1'b1;\n            dst_full <= 1'b0;\n        end else begin\n            dst_empty <= (empty_gray_reg == dst_ptr_gray);\n            dst_full <= (full_gray_reg == dst_ptr_gray);\n        end\n    end\n\n    // Read Enable & Data Output\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_o <= '0;\n            dst_valid_reg_reg <= 1'b0;\n        end else if (dst_valid_reg_reg && !dst_full) begin\n            dst_data_o <= mem_reg[dst_ptr_reg];\n            dst_valid_reg_reg <= 1'b1;\n        end else begin\n            dst_valid_reg_reg <= 1'b0;\n        end\n    end\n\n    // Read Pointer Update (only when data is consumed)\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_ptr_reg <= '0;\n            mem_reg <= '0;\n        end else if (dst_valid_reg_reg && !dst_full) begin\n            dst_ptr_reg <= dst_ptr_reg + 1'b1;\n            mem_reg[dst_ptr_reg] <= mem[dst_ptr_reg]; // Shift data to fill gap\n        end else begin\n            // No change to pointer or memory on idle/full\n        end\n    end\n\n    // Destination Valid Output\n    assign dst_valid_o = dst_valid_reg_reg;\n\n    // ------------------------------------------------------------------\n    // Memory Initialization\n    // ------------------------------------------------------------------\n    initial begin\n        mem = '0;\n        mem_reg = '0;\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
