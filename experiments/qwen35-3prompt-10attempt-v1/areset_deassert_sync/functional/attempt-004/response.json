{
  "text": "module areset_deassert_sync #(\n    parameter CHAINS = 2,\n    parameter RST_POL = 1'b1\n)(\n    input  clk,\n    input  async_rst_i,\n    output sync_rst_o\n);\n\n    reg [CHAINS-1:0] rst_pipe;\n\n    // Stage 0: Immediate assertion handling\n    // If RST_POL is 1, active high means assert when async_rst_i is 1.\n    // If RST_POL is 0, active low means assert when async_rst_i is 0.\n    // We invert the input if active-low to maintain a consistent \"asserted\" logic flow (1 = asserted).\n    reg rst_asserted;\n    assign rst_asserted = (RST_POL == 1'b1) ? async_rst_i : (~async_rst_i);\n\n    // Pipeline stages for deassertion synchronization\n    // On reset (asserted), the pipeline is cleared.\n    // On release (deasserted), the signal propagates through the chain.\n    // Only when the last stage is 0 (deasserted) do we output the synchronized reset.\n    always @(posedge clk) begin\n        if (rst_asserted) begin\n            // Assertion detected: Clear the entire pipeline immediately\n            rst_pipe <= {CHAINS{1'b0}};\n        end else begin\n            // Deassertion detected: Shift the pipeline\n            // The first stage takes the current deassertion signal (which is 0 here)\n            // Subsequent stages shift left\n            rst_pipe <= {1'b0, rst_pipe[CHAINS-2:0]};\n        end\n    end\n\n    // Output logic:\n    // If the last stage of the pipeline is 0, it means the deassertion has been observed\n    // for CHAINS clock cycles. We output 0 (inactive reset).\n    // If the pipeline is still propagating (any 1s remain), we hold the previous state\n    // or output 1 (active reset) to ensure safety during the transition.\n    // However, the requirement states \"sync_rst_o must follow assertion... immediately\".\n    // This implies if async_rst_i goes high, sync_rst_o goes high immediately.\n    // If async_rst_i goes low, sync_rst_o stays high until the chain clears.\n    \n    // Logic refinement:\n    // When rst_asserted is 1, sync_rst_o must be 1 immediately.\n    // When rst_asserted is 0, sync_rst_o follows the pipeline.\n    // The pipeline outputs 1 if any stage is 1, else 0.\n    // Since we shift in 0s on deassertion, the pipeline will eventually become all 0s.\n    // We need to ensure that while the chain is clearing, the output remains 1 (active reset).\n    \n    assign sync_rst_o = rst_asserted | rst_pipe[CHAINS-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
