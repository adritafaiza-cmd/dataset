{
  "text": "module areset_deassert_sync #(\n    parameter CHAINS = 2,\n    parameter RST_POL = 1'b1\n)(\n    input  clk,\n    input  async_rst_i,\n    output sync_rst_o\n);\n\n    reg [CHAINS-1:0] rst_pipe;\n\n    // Stage 0: Capture the asynchronous reset signal\n    // If RST_POL is 1, we capture active-high. If 0, we capture active-low.\n    always @(posedge clk) begin\n        if (RST_POL)\n            rst_pipe[0] <= async_rst_i;\n        else\n            rst_pipe[0] <= ~async_rst_i;\n    end\n\n    // Stages 1 to CHAINS-1: Shift register to synchronize the deassertion\n    // This ensures that the release of the reset is stable across clock domains\n    // and observed by multiple clock edges before being propagated.\n    genvar i;\n    generate\n        for (i = 1; i < CHAINS; i = i + 1) begin : rst_pipe_stages\n            always @(posedge clk) begin\n                rst_pipe[i] <= rst_pipe[i-1];\n            end\n        end\n    endgenerate\n\n    // Output logic:\n    // If RST_POL is 1, output is active when the last stage is high.\n    // If RST_POL is 0, output is active when the last stage is low.\n    assign sync_rst_o = (RST_POL) ? rst_pipe[CHAINS-1] : ~rst_pipe[CHAINS-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
