{
  "text": "module areset_deassert_sync #(\n    parameter CHAINS = 2,\n    parameter RST_POL = 1'b1\n)(\n    input  clk,\n    input  async_rst_i,\n    output sync_rst_o\n);\n\n    reg [CHAINS-1:0] rst_pipe;\n\n    // Stage 0: Immediate assertion handling\n    // If RST_POL is 1, active high means assert when async_rst_i is 1.\n    // If RST_POL is 0, active low means assert when async_rst_i is 0.\n    // We invert the input if active-low to maintain a consistent \"asserted\" logic flow for the pipeline.\n    assign rst_pipe[0] = RST_POL ? async_rst_i : ~async_rst_i;\n\n    // Pipeline stages for release synchronization\n    // Each stage synchronizes the deassertion (release) of the reset signal.\n    genvar i;\n    generate\n        for (i = 1; i < CHAINS; i = i + 1) begin : rst_pipe_stages\n            always @(posedge clk) begin\n                if (rst_pipe[i-1]) begin\n                    // If the previous stage is asserted, hold the assertion\n                    rst_pipe[i] <= 1'b1;\n                end else begin\n                    // If the previous stage is deasserted, propagate deassertion\n                    rst_pipe[i] <= 0;\n                end\n            end\n        end\n    endgenerate\n\n    // Final output logic\n    // Invert back if active-low to match the original polarity\n    assign sync_rst_o = RST_POL ? rst_pipe[CHAINS-1] : ~rst_pipe[CHAINS-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
