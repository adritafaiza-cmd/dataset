{
  "text": "module areset_deassert_sync #(\n    parameter CHAINS = 2,\n    parameter RST_POL = 1'b1\n)(\n    input  clk,\n    input  async_rst_i,\n    output sync_rst_o\n);\n\n    reg [CHAINS-1:0] rst_pipe;\n\n    // Stage 0: Immediate assertion response\n    // If RST_POL is 1, assert when async_rst_i is 1.\n    // If RST_POL is 0, assert when async_rst_i is 0.\n    always @(posedge clk) begin\n        if (RST_POL)\n            rst_pipe[0] <= async_rst_i;\n        else\n            rst_pipe[0] <= ~async_rst_i;\n    end\n\n    // Stages 1 to CHAINS-1: Synchronize deassertion\n    // Shift the signal through the pipeline.\n    // The output of the last stage becomes the synchronized reset.\n    genvar i;\n    generate\n        for (i = 1; i < CHAINS; i = i + 1) begin : rst_pipe_stages\n            always @(posedge clk) begin\n                rst_pipe[i] <= rst_pipe[i-1];\n            end\n        end\n    endgenerate\n\n    // Output is the last stage of the pipeline\n    assign sync_rst_o = rst_pipe[CHAINS-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
