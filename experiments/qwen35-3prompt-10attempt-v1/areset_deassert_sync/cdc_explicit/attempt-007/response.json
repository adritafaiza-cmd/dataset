{
  "text": "module areset_deassert_sync #(\n    parameter CHAINS = 2,\n    parameter RST_POL = 1'b1\n)(\n    input  clk,\n    input  async_rst_i,\n    output sync_rst_o\n);\n\n    // Internal signal to handle polarity inversion if needed\n    // If RST_POL is 0, we invert the input so the logic below (active-high assumption) works uniformly\n    wire rst_active;\n    assign rst_active = RST_POL ? async_rst_i : ~async_rst_i;\n\n    // Stage 0: Immediate Assertion Capture\n    // This stage ensures that if the reset is asserted, the output is asserted immediately.\n    // It uses a flip-flop triggered by clk. On reset, it captures the '1'.\n    // When rst_active goes low (deassert), this stage will eventually go low after one clock cycle.\n    reg rst_stage0;\n    always @(posedge clk or posedge rst_active) begin\n        if (rst_active)\n            rst_stage0 <= 1'b1;\n        else\n            rst_stage0 <= 1'b0;\n    end\n\n    // Pipeline stages for safe deassertion (Release)\n    // We chain CHAINS flip-flops. The reset signal propagates through them.\n    // Only after the signal has traversed the entire chain and returned to 0\n    // do we consider the reset fully released.\n    genvar i;\n    reg rst_chain[CHAINS-1:0];\n\n    generate\n        for (i = 0; i < CHAINS; i = i + 1) begin : rst_chain_gen\n            always @(posedge clk or posedge rst_active) begin\n                if (rst_active)\n                    rst_chain[i] <= 1'b1;\n                else\n                    rst_chain[i] <= rst_chain[i-1] ? 1'b1 : 1'b0;\n            end\n        end\n    endgenerate\n\n    // Final Output Logic\n    // sync_rst_o is asserted if:\n    // 1. The immediate capture (rst_stage0) is high (handles immediate assertion).\n    // 2. OR, any stage in the release chain is still high (indicating the release hasn't completed).\n    //\n    // Logic derivation:\n    // - If rst_active is high, rst_stage0 becomes 1. Output = 1.\n    // - If rst_active goes low:\n    //   - rst_stage0 goes low after 1 cycle.\n    //   - rst_chain[0] goes low after 1 cycle.\n    //   - ...\n    //   - rst_chain[CHAINS-1] goes low after CHAINS+1 cycles.\n    //   - Until all are low, output remains 1.\n    //   - Once all are low, output becomes 0.\n    //\n    // This ensures the reset is held high until the CDC hazard of early deassertion is eliminated.\n    assign sync_rst_o = rst_stage0 | rst_chain[CHAINS-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
