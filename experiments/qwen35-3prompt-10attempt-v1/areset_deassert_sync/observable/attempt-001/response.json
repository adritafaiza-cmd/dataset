  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule areset_deassert_sync #(\n    parameter CHAINS = 2,\n    parameter RST_POL = 1'b1\n)(\n    input  wire        clk,\n    input  wire        async_rst_i,\n    output reg         sync_rst_o\n);\n\n    localparam DEASSERT_DEPTH = CHAINS;\n\n    // Internal state to track the deassertion process\n    // We use a counter-like approach where we count down from DEASSERT_DEPTH\n    // only when the reset is being released (going from asserted to deasserted).\n    \n    reg [DEASSERT_DEPTH-1:0] deassert_count;\n    reg                      rst_asserted;\n\n    // Determine the current asserted state based on polarity\n    // If RST_POL is 1, active high means async_rst_i == 1\n    // If RST_POL is 0, active low means async_rst_i == 0\n    wire rst_active = (RST_POL == 1'b1) ? async_rst_i : (~async_rst_i);\n\n    // Logic to detect the transition from asserted to deasserted\n    // We need to ensure the source reset has been stable in the deasserted state\n    // before we start counting down.\n    reg rst_was_active;\n    reg rst_is_releasing;\n\n    always @(posedge clk) begin\n        // Detect if reset was active in the previous cycle\n        rst_was_active <= rst_active;\n        \n        // Detect if reset is currently active\n        rst_is_releasing <= (rst_active && !rst_was_active);\n    end\n\n    // Logic to manage the deassertion counter\n    // When rst_is_releasing is high, we start counting down.\n    // Once count reaches 0, we allow the reset to be deasserted.\n    always @(posedge clk) begin\n        if (rst_is_releasing) begin\n            // Start counting down from DEASSERT_DEPTH\n            if (deassert_count == DEASSERT_DEPTH) begin\n                deassert_count <= DEASSERT_DEPTH - 1;\n            end else begin\n                deassert_count <= deassert_count - 1;\n            end\n        end else begin\n            // If not releasing, hold the current count\n            // This ensures we don't accidentally reset the counter if the signal glitches back\n            // However, for a clean release, we typically only count down once per transition.\n            // If the signal goes active again before count reaches 0, we should reset the counter.\n            if (rst_active) begin\n                deassert_count <= DEASSERT_DEPTH;\n            end\n        end\n    end\n\n    // Output logic\n    // If the counter has reached 0 (or never started if CHAINS=0), the reset is released.\n    // Otherwise, the reset remains asserted.\n    always @(posedge clk) begin\n        if (RST_POL == 1'b1) begin\n            // Active High Reset\n            if (deassert_count == 0) begin\n                sync_rst_o <= 1'b0;\n            end else begin\n                sync_rst_o <= 1'b1;\n            end\n        end else begin\n            // Active Low Reset\n            if (deassert_count == 0) begin\n                sync_rst_o <= 1'b1;\n            end else begin\n                sync_rst_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
