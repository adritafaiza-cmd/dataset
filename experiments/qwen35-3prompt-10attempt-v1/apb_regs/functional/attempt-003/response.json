  "text": "```verilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Internal types for APB protocol signals\n  typedef logic [ApbAddrWidth-1:0] apb_addr_internal_t;\n  typedef logic [ApbDataWidth-1:0] apb_data_internal_t;\n  \n  // APB Protocol Signals\n  logic paddr_i;\n  logic pwrite_i;\n  logic pend_i;\n  logic pvalid_i;\n  logic pready_o;\n  apb_data_internal_t pdata_i;\n  apb_data_internal_t presp_o;\n\n  // Internal register storage\n  reg_data_t [NoApbRegs-1:0] reg_storage;\n\n  // APB Master Interface Generation\n  assign paddr_i = base_addr_i + (req_i.addr * AddrOffset);\n  assign pwrite_i = req_i.write;\n  assign pend_i = req_i.end;\n  assign pvalid_i = req_i.valid;\n  assign pdata_i = req_i.data;\n\n  // APB Slave Interface Generation\n  assign pready_o = req_i.ready;\n  assign presp_o = resp_i;\n\n  // APB Protocol Logic\n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      reg_storage <= '0;\n      resp_o <= 1'b0;\n    end else begin\n      if (pend_i) begin\n        if (pwrite_i) begin\n          // Write operation\n          if (paddr_i < NoApbRegs * AddrOffset) begin\n            // Calculate register index\n            int unsigned idx = paddr_i / AddrOffset;\n            \n            // Check if this register is read-only\n            if (ReadOnly[idx]) begin\n              // Ignore write for read-only registers\n              // Do nothing\n            end else begin\n              // Update register value\n              reg_storage[idx] <= reg_data_t'(pdata_i);\n            end\n          end\n        end else begin\n          // Read operation\n          if (paddr_i < NoApbRegs * AddrOffset) begin\n            // Calculate register index\n            int unsigned idx = paddr_i / AddrOffset;\n            \n            // Drive response data\n            presp_o <= reg_data_t'(reg_storage[idx]);\n          end else begin\n            // Invalid address\n            presp_o <= '0;\n          end\n        end\n      end\n    end\n  end\n\n  // Output register array\n  assign reg_q_o = reg_storage;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
