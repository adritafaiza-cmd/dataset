  "text": "module apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // Internal logic types\n  localparam int unsigned ADDR_WIDTH = ApbAddrWidth;\n  localparam int unsigned DATA_WIDTH = RegDataWidth;\n  \n  // APB Protocol Signals\n  logic pwrite1;\n  logic pwrite0;\n  logic pwrite;\n  logic pvalid;\n  logic pready;\n  logic paddr;\n  logic pprot;\n  logic psize;\n  logic pburst;\n  logic ptrans;\n  logic pslaveselect;\n  logic pwrite1_o;\n  logic pwrite0_o;\n  logic pwrite_o;\n  logic pvalid_o;\n  logic pready_o;\n  logic paddr_o;\n  logic pprot_o;\n  logic psize_o;\n  logic pburst_o;\n  logic ptrans_o;\n  logic pslaveselect_o;\n  \n  // Internal register for data\n  reg_data_t [NoApbRegs-1:0] reg_q;\n  \n  // Generate APB interface wires\n  generate\n    if (ApbAddrWidth > 0) begin : gen_addr\n      assign paddr_o = base_addr_i;\n    end else begin : gen_addr_empty\n      assign paddr_o = '0;\n    end\n    \n    assign pprot_o = '0;\n    assign psize_o = '0;\n    assign pburst_o = '0;\n    assign ptrans_o = '0;\n    assign pslaveselect_o = '0;\n  endgenerate\n  \n  // APB Master Interface (Internal to this module, simulating the APB bus)\n  // Since req_i is a generic type, we assume it contains the necessary APB control signals.\n  // We map req_i fields to internal APB signals.\n  // Note: In a real scenario, req_t would be a struct or packed array matching the APB spec.\n  // Here we assume req_i has fields: pwrite, pvalid, paddr, pprot, psize, pburst, ptrans, pslaveselect.\n  \n  assign pwrite = req_i.pwrite;\n  assign pvalid = req_i.pvalid;\n  assign paddr = req_i.paddr;\n  assign pprot = req_i.pprot;\n  assign psize = req_i.psize;\n  assign pburst = req_i.pburst;\n  assign ptrans = req_i.ptrans;\n  assign pslaveselect = req_i.pslaveselect;\n  \n  assign req_i.pwrite1_o = pwrite1_o;\n  assign req_i.pwrite0_o = pwrite0_o;\n  assign req_i.pwrite_o = pwrite_o;\n  assign req_i.pvalid_o = pvalid_o;\n  assign req_i.pready_o = pready_o;\n  assign req_i.paddr_o = paddr_o;\n  assign req_i.pprot_o = pprot_o;\n  assign req_i.psize_o = psize_o;\n  assign req_i.pburst_o = pburst_o;\n  assign req_i.ptrans_o = ptrans_o;\n  assign req_i.pslaveselect_o = pslaveselect_o;\n  \n  // APB Slave Interface (Internal to this module, simulating the APB bus)\n  // Since resp_t is a generic type, we assume it contains the necessary APB response signals.\n  // We map internal APB signals to resp_t fields.\n  // Note: In a real scenario, resp_t would be a struct or packed array matching the APB spec.\n  // Here we assume resp_t has fields: pwrite1, pwrite0, pwrite, pvalid, pready, paddr, pprot, psize, pburst, ptrans, pslaveselect.\n  \n  assign resp_o.pwrite1 = pwrite1;\n  assign resp_o.pwrite0 = pwrite0;\n  assign resp_o.pwrite = pwrite;\n  assign resp_o.pvalid = pvalid;\n  assign resp_o.pready = pready;\n  assign resp_o.paddr = paddr;\n  assign resp_o.pprot = pprot;\n  assign resp_o.psize = psize;\n  assign resp_o.pburst = pburst;\n  assign resp_o.ptrans = ptrans;\n  assign resp_o.pslaveselect = pslaveselect;\n  \n  // APB Slave Logic\n  // This block implements the APB protocol for the slave side.\n  // It handles the handshake and data transfer.\n  \n  logic [ApbAddrWidth-1:0] addr;\n  logic [RegDataWidth-1:0] wr_data;\n  logic [RegDataWidth-1:0] rd_data;\n  logic [NoApbRegs-1:0] write_mask;\n  logic [NoApbRegs-1:0] read_mask;\n  logic write_enable;\n  logic read_enable;\n  logic slave_ready;\n  logic slave_valid;\n  \n  assign addr = paddr;\n  assign wr_data = req_i.pwrite ? req_i.reg_data_i : '0; // Assuming req_i has reg_data_i for write\n  assign rd_data = reg_q[addr_to_reg_idx(addr)];\n  assign write_mask = addr_to_reg_mask(addr);\n  assign read_mask = addr_to_reg_mask(addr);\n  assign write_enable = pwrite && pvalid && pready;\n  assign read_enable = !pwrite && pvalid && pready;\n  assign slave_ready = pready;\n  assign slave_valid = pvalid;\n  \n  // APB Slave State Machine\n  logic [1:0] state;\n  logic next_state;\n  logic [ApbAddrWidth-1:0] next_addr;\n  logic [RegDataWidth-1:0] next_wr_data;\n  logic [RegDataWidth-1:0] next_rd_data;\n  logic [NoApbRegs-1:0] next_write_mask;\n  logic [NoApbRegs-1:0] next_read_mask;\n  logic next_write_enable;\n  logic next_read_enable;\n  logic next_slave_ready;\n  logic next_slave_valid;\n  \n  always @(posedge pclk_i or negedge preset_ni) begin\n    if (!preset_ni) begin\n      state <= 2'd0;\n      addr <= '0;\n      wr_data <= '0;\n      rd_data <= '0;\n      write_mask <= '0;\n      read_mask <= '0;\n      write_enable <= 1'b0;\n      read_enable <= 1'b0;\n      slave_ready <= 1'b0;\n      slave_valid <= 1'b0;\n    end else begin\n      state <= next_state;\n      addr <= next_addr;\n      wr_data <= next_wr_data;\n      rd_data <= next_rd_data;\n      write_mask <= next_write_mask;\n      read_mask <= next_read_mask;\n      write_enable <= next_write_enable;\n      read_enable <= next_read_enable;\n      slave_ready <= next_slave_ready;\n      slave_valid <= next_slave_valid;\n    end\n  end\n  \n  always @(*) begin\n    next_state = state;\n    next_addr = addr;\n    next_wr_data = wr_data;\n    next_rd_data = rd_data;\n    next_write_mask = write_mask;\n    next_read_mask = read_mask;\n    next_write_enable = write_enable;\n    next_read_enable = read_enable;\n    next_slave_ready = slave_ready;\n    next_slave_valid = slave_valid;\n    \n    case (state)\n      2'd0: begin // Idle\n        if (pvalid) begin\n          next_state = 2'd1;\n          next_addr = paddr;\n          next_wr_data = req_i.reg_data_i;\n          next_write_mask = addr_to_reg_mask(paddr);\n          next_read_mask = addr_to_reg_mask(paddr);\n          next_write_enable = pwrite;\n          next_read_enable = !pwrite;\n          next_slave_ready = 1'b1;\n          next_slave_valid = 1'b1;\n        end else begin\n          next_slave_ready = 1'b1;\n          next_slave_valid = 1'b0;\n        end\n      end\n      \n      2'd1: begin // Active\n        if (pready) begin\n          if (pwrite) begin\n            // Write operation\n            if (write_mask[addr_to_reg_idx(paddr)]) begin\n              if (!ReadOnly[addr_to_reg_idx(paddr)]) begin\n                reg_q[addr_to_reg_idx(paddr)] = req_i.reg_data_i;\n              end\n            end\n          end else begin\n            // Read operation\n            if (read_mask[addr_to_reg_idx(paddr)]) begin\n              rd_data = reg_q[addr_to_reg_idx(paddr)];\n            end\n          end\n          next_state = 2'd0;\n          next_slave_ready = 1'b1;\n          next_slave_valid = 1'b0;\n        end else begin\n          next_slave_ready = 1'b0;\n          next_slave_valid = 1'b1;\n        end\n      end\n    endcase\n  end\n  \n  // Helper functions for address mapping\n  function integer addr_to_reg_idx;\n    input [ApbAddrWidth-1:0] addr;\n    begin\n      addr_to_reg_idx = (addr - base_addr_i) / AddrOffset;\n      if (addr_to_reg_idx < 0 || addr_to_reg_idx >= NoApbRegs) begin\n        addr_to_reg_idx = -1;\n      end\n    end\n  endfunction\n  \n  function [NoApbRegs-1:0] addr_to_reg_mask;\n    input [ApbAddrWidth-1:0] addr;\n    begin\n      addr_to_reg_mask = '0;\n      if (addr_to_reg_idx(addr) >= 0 && addr_to_reg_idx(addr) < NoApbRegs) begin\n        addr_to_reg_mask[addr_to_reg_idx(addr)] = 1'b1;\n      end\n    end\n  endfunction\n  \nendmodule<|im_end|>\n<|endoftext|>",
