  "text": "```verilog\nmodule apb_regs #(\n  parameter int unsigned        NoApbRegs    = 32'd0,\n  parameter int unsigned        ApbAddrWidth = 32'd0,\n  parameter int unsigned        AddrOffset   = 32'd4,\n  parameter int unsigned        ApbDataWidth = 32'd0,\n  parameter int unsigned        RegDataWidth = 32'd0,\n  parameter bit [NoApbRegs-1:0] ReadOnly     = 32'h0,\n  parameter type                req_t        = logic,\n  parameter type                resp_t       = logic,\n  parameter type apb_addr_t                  = logic[ApbAddrWidth-1:0],\n  parameter type reg_data_t                  = logic[RegDataWidth-1:0]\n) (\n  input  logic                      pclk_i,\n  input  logic                      preset_ni,\n  input  req_t                      req_i,\n  output resp_t                     resp_o,\n  input  apb_addr_t                 base_addr_i,\n  input  reg_data_t [NoApbRegs-1:0] reg_init_i,\n  output reg_data_t [NoApbRegs-1:0] reg_q_o\n);\n\n  // CDC Strategy:\n  // 1. Use a dedicated internal clock domain (pclk_i) for all state registers.\n  // 2. Use a synchronous reset (preset_ni) that is assumed to be stable relative to pclk_i \n  //    (or handled by the caller's reset logic). This avoids asynchronous reset hazards \n  //    inside the module.\n  // 3. All input sampling (req_i, base_addr_i) and output driving (resp_o, reg_q_o) \n  //    occur on the active edge of pclk_i.\n  // 4. Multi-bit data transfers are synchronous and coherent within the single clock domain.\n  // 5. No cross-clock-domain FIFOs or handshakes are needed as there is only one clock.\n\n  localparam int unsigned ADDR_MASK = (1 << ApbAddrWidth) - 1;\n  localparam int unsigned OFFSET_MASK = (1 << AddrOffset) - 1;\n\n  // Internal state registers\n  reg_data_t [NoApbRegs-1:0] reg_state;\n  \n  // APB Protocol State Machine State\n  // States: IDLE, READ, WRITE\n  typedef enum logic [1:0] {\n    STATE_IDLE,\n    STATE_READ,\n    STATE_WRITE\n  } apb_state_t;\n\n  apb_state_t state_reg;\n  logic       state_next;\n  \n  // Address register to hold the decoded register index\n  logic [NoApbRegs-1:0] addr_idx_reg;\n  logic                 addr_valid_reg;\n  \n  // Write data register\n  reg_data_t            write_data_reg;\n  logic                 write_data_valid_reg;\n\n  // APB Response status\n  logic                 pwrite1; // PWRITE1 signal for APB response\n  logic                 pwrite0; // PWRITE0 signal for APB response\n  logic                 pvalid;  // PVALID signal for APB response\n\n  // Generate APB Response Signals\n  // APB protocol: \n  // PREADY is handled by the caller (assumed 1'b1 if clock is valid).\n  // PWRITE1/PWRITE0 indicate success/failure.\n  // PVALID indicates the response is ready.\n  \n  assign pwrite1 = (state_reg == STATE_READ) ? 1'b1 : 1'b0;\n  assign pwrite0 = (state_reg == STATE_READ) ? 1'b0 : 1'b1;\n  assign pvalid  = (state_reg != STATE_IDLE);\n\n  // Address decoding logic\n  // Calculate the register index based on base address and offset\n  // addr_idx = ((base_addr + req_addr) >> AddrOffset) & (NoApbRegs - 1)\n  // However, APB usually addresses the register directly. \n  // Assuming req_i contains the full APB address.\n  // We need to extract the register index from the address.\n  // Let's assume req_i has an address field. Since req_t is a parameter, we assume it has \n  // an address field compatible with apb_addr_t or similar. \n  // For this implementation, we assume req_i has a field 'addr' of type apb_addr_t.\n  // If req_t is a struct, we access it as req_i.addr.\n  // If req_t is just logic, this code would fail compilation unless req_t is defined elsewhere.\n  // Given the constraints, we assume req_t is a struct with .addr and .pwrite fields.\n  \n  // To make this generic and compilable without knowing the exact structure of req_t,\n  // we will assume req_t has a member 'addr' of type apb_addr_t.\n  // If req_t is a simple logic vector, this approach won't work directly, but \n  // the problem statement implies a structured APB interface.\n  // We will use a generic way to access the address if possible, or assume a standard structure.\n  // Since we cannot define the structure, we assume req_i has a field .addr.\n  \n  // Note: In a real scenario, req_t would be defined as:\n  // typedef struct { logic pwrite; apb_addr_t addr; } req_t;\n  // We will proceed with this assumption.\n\n  // Synchronous Reset Logic\n  // Reset all registers and state machine to initial values\n  always_ff @(posedge pclk_i) begin\n    if (!preset_ni) begin\n      reg_state     <= STATE_IDLE;\n      addr_idx_reg  <= 0;\n      addr_valid_reg <= 1'b0;\n      write_data_reg <= '0;\n      write_data_valid_reg <= 1'b0;\n      reg_state     <= STATE_IDLE; // Redundant but safe\n    end else begin\n      // State Machine Logic\n      if (state_reg == STATE_IDLE) begin\n        // Check for valid APB transaction\n        // Assuming req_i.pwrite indicates write, req_i.addr indicates address\n        // We need to check if the address falls within our mapped region.\n        // Base address is base_addr_i.\n        // The register address in APB space is: base_addr_i + (idx * AddrOffset)\n        // We need to find idx such that: base_addr_i <= req_i.addr < base_addr_i + (NoApbRegs * AddrOffset)\n        \n        // Calculate potential index\n        // idx = (req_i.addr - base_addr_i) / AddrOffset\n        // We perform this calculation carefully to avoid negative results if addr < base_addr\n        \n        logic [ApbAddrWidth-1:0] calc_addr;\n        logic [NoApbRegs-1:0] calc_idx;\n        logic addr_in_range;\n        \n        // Check if req_i.addr is within the mapped range\n        // Range start: base_addr_i\n        // Range end: base_addr_i + (NoApbRegs * AddrOffset) - 1\n        \n        // Since we don't know the exact width of req_i.addr, we assume it matches apb_addr_t\n        // and that the testbench ensures alignment.\n        \n        // Simple check: if the lower AddrOffset bits are 0, it's aligned.\n        // Then calculate index.\n        \n        if (req_i.addr[AddrOffset-1:0] == 0) begin\n          // Calculate index\n          // idx = (req_i.addr - base_addr_i) / AddrOffset\n          // We use a simple subtraction and shift.\n          // Note: This assumes req_i.addr >= base_addr_i.\n          // If not, the result will be garbage, but the range check below should catch it.\n          \n          // To be safe against underflow in synthesis tools, we can check range first.\n          // Let's assume the testbench provides valid addresses.\n          \n          // We need to handle the case where NoApbRegs is 0.\n          if (NoApbRegs > 0) begin\n            // Calculate index\n            // idx = (req_i.addr - base_addr_i) >> AddrOffset\n            // We need to ensure the subtraction doesn't wrap around incorrectly if addr < base_addr\n            // But since we are in a single clock domain, we can rely on the testbench.\n            \n            // Let's implement a safe index calculation\n            logic [ApbAddrWidth-1:0] diff;\n            if (req_i.addr >= base_addr_i) begin\n              diff = req_i.addr - base_addr_i;\n              calc_idx = diff >> AddrOffset;\n            end else begin\n              calc_idx = '0;\n            end\n            \n            // Check if index is valid\n            if (calc_idx < NoApbRegs) begin\n              addr_idx_reg <= calc_idx;\n              addr_valid_reg <= 1'b1;\n              \n              // Determine next state\n              if (req_i.pwrite) begin\n                // Write operation\n                // Check if the register is read-only\n                if (ReadOnly[calc_idx] == 1'b0) begin\n                  state_next <= STATE_WRITE;\n                end else begin\n                  // Read-only register, ignore write, stay in IDLE or go to READ?\n                  // APB spec: If write to read-only, PREADY=1, PWRITE1=1, PWRITE0=0, PVALID=1\n                  // So we should respond as if it was a read (success) but ignore the write.\n                  // However, the state machine needs to drive the response.\n                  // If we stay in IDLE, we don't drive PVALID.\n                  // We need to drive PVALID immediately for read-only writes.\n                  // So we can treat it as a successful operation without changing state.\n                  // But we need to ensure the response signals are correct.\n                  // Our response logic uses state_reg. \n                  // If state_reg is IDLE, pvalid is 0.\n                  // So we must transition to a state that sets pvalid.\n                  // Let's use STATE_READ for successful operations (reads and ignored writes).\n                  state_next <= STATE_READ;\n                end\n              end else begin\n                // Read operation\n                state_next <= STATE_READ;\n              end\n            end else begin\n              // Address out of range\n              // APB spec: PREADY=1, PWRITE1=0, PWRITE0=1, PVALID=1 (Error)\n              // We can force state to READ to generate the error response.\n              state_next <= STATE_READ;\n            end\n          end else begin\n            // No registers, always error\n            state_next <= STATE_READ;\n          end\n        end else begin\n          // Misaligned address\n          // APB spec: PREADY=1, PWRITE1=0, PWRITE0=1, PVALID=1 (Error)\n          state_next <= STATE_READ;\n        end\n      end else if (state_reg == STATE_READ) begin\n        // Read operation\n        // Drive reg_q_o with the data\n        if (addr_valid_reg) begin\n          reg_q_o[addr_idx_reg] <= reg_init_i[addr_idx_reg];\n        end else begin\n          // If address is invalid, drive 0 or keep previous? \n          // Usually, if address is invalid, we might not drive anything or drive 0.\n          // Let's drive 0 for safety.\n          reg_q_o <= '0;\n        end\n        // After reading, return to IDLE\n        state_next <= STATE_IDLE;\n      end else if (state_reg == STATE_WRITE) begin\n        // Write operation\n        if (addr_valid_reg) begin\n          reg_state[addr_idx_reg] <= write_data_reg;\n        end\n        // After writing, return to IDLE\n        state_next <= STATE_IDLE;\n      end\n    end\n  end\n\n  // Input sampling for address and data\n  // Since everything is in the same clock domain, we can sample directly.\n  // However, to be robust against glitches on the clock edge, we sample in the same block.\n  // The logic above already samples req_i inside the always_ff block.\n  \n  // Write data sampling\n  // We need to capture the write data when the state transitions to WRITE.\n  // But the write data is available on the same clock edge.\n  // We can capture it in the same always_ff block when transitioning to STATE_WRITE.\n  \n  // Let's refactor the always_ff block to handle data capture explicitly.\n  \n  always_ff @(posedge pclk_i) begin\n    if (!preset_ni) begin\n      reg_state     <= STATE_IDLE;\n      addr_idx_reg  <= '0;\n      addr_valid_reg <= 1'b0;\n      write_data_reg <= '0;\n      write_data_valid_reg <= 1'b0;\n      reg_q_o <= '0;\n    end else begin\n      // Address and Data Capture Logic\n      logic [NoApbRegs-1:0] new_idx;\n      logic new_addr_valid;\n      logic new_state;\n      \n      if (state_reg == STATE_IDLE) begin\n        if (NoApbRegs > 0) begin\n          if (req_i.addr[AddrOffset-1:0] == 0) begin\n            if (req_i.addr >= base_addr_i) begin\n              new_idx = (req_i.addr - base_addr_i) >> AddrOffset;\n              if (new_idx < NoApbRegs) begin\n                new_addr_valid = 1'b1;\n                new_idx = new_idx;\n              end else begin\n                new_addr_valid = 1'b0;\n                new_idx = '0;\n              end\n            end else begin\n              new_addr_valid = 1'b0;\n              new_idx = '0;\n            end\n          end else begin\n            new_addr_valid = 1'b0;\n            new_idx = '0;\n          end\n        end else begin\n          new_addr_valid = 1'b0;\n          new_idx = '0;\n        end\n        \n        if (new_addr_valid) begin\n          if (req_i.pwrite) begin\n            // Write\n            if (ReadOnly[new_idx] == 1'b0) begin\n              new_state = STATE_WRITE;\n            end else begin\n              // Read-only, treat as success (like a read)\n              new_state = STATE_READ;\n            end\n          end else begin\n            // Read\n            new_state = STATE_READ;\n          end\n        end else begin\n          // Error condition (misaligned or out of range)\n          new_state = STATE_READ;\n        end\n      end else if (state_reg == STATE_READ) begin\n        // Read operation\n        if (new_addr_valid) begin\n          reg_q_o[new_idx] <= reg_init_i[new_idx];\n        end else begin\n          reg_q_o <= '0;\n        end\n        new_state = STATE_IDLE;\n      end else if (state_reg == STATE_WRITE) begin\n        // Write operation\n        if (new_addr_valid) begin\n          reg_state[new_idx] <= write_data_reg;\n        end\n        new_state = STATE_IDLE;\n      end\n      \n      // Capture write data if transitioning to WRITE\n      if (state_reg == STATE_IDLE && new_state == STATE_WRITE) begin\n        write_data_reg <= req_i.data; // Assuming req_i has a .data field\n        write_data_valid_reg <= 1'b1;\n      end\n      \n      // Update state\n      state_reg <= new_state;\n      addr_idx_reg <= new_idx;\n      addr_valid_reg <= new_addr_valid;\n    end\n  end\n\n  // Output the register file\n  assign reg_q_o = reg_state;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
