  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam INT_WIDTH = ADDR_WIDTH + 1;\n    localparam MAX_DEPTH = 2**ADDR_WIDTH;\n    localparam GRANT_WIDTH = INT_WIDTH - 1;\n\n    // Generate sync stages\n    genvar i;\n    generate\n        for (i = 0; i < SYNC_STAGES; i = i + 1) begin : sync_stage\n            wire sync_winc, sync_rinc, sync_wfull, sync_rempty;\n            \n            wire [INT_WIDTH-1:0] sync_waddr, sync_raddr;\n            \n            wire [INT_WIDTH-1:0] sync_waddr_d, sync_waddr_q;\n            wire [INT_WIDTH-1:0] sync_raddr_d, sync_raddr_q;\n            \n            // Write side sync\n            always @(posedge wclk or negedge wrst_n) begin\n                if (!wrst_n) begin\n                    sync_waddr <= {1'b0, {INT_WIDTH-1{1'b0}}};\n                    sync_winc  <= 1'b0;\n                    sync_wfull <= 1'b0;\n                end else begin\n                    sync_waddr <= sync_waddr_d;\n                    sync_winc  <= winc;\n                    sync_wfull <= wfull;\n                end\n            end\n            \n            // Read side sync\n            always @(posedge rclk or negedge rrst_n) begin\n                if (!rrst_n) begin\n                    sync_raddr <= {1'b0, {INT_WIDTH-1{1'b0}}};\n                    sync_rinc  <= 1'b0;\n                    sync_rempty <= 1'b1;\n                end else begin\n                    sync_raddr <= sync_raddr_d;\n                    sync_rinc  <= rinc;\n                    sync_rempty <= rempty;\n                end\n            end\n            \n            // Address registers for sync\n            always @(posedge wclk or negedge wrst_n) begin\n                if (!wrst_n)\n                    sync_waddr_d <= {1'b0, {INT_WIDTH-1{1'b0}}};\n                else\n                    sync_waddr_d <= sync_waddr;\n            end\n            \n            always @(posedge rclk or negedge rrst_n) begin\n                if (!rrst_n)\n                    sync_raddr_d <= {1'b0, {INT_WIDTH-1{1'b0}}};\n                else\n                    sync_raddr_d <= sync_raddr;\n            end\n            \n            // Output sync\n            always @(posedge wclk or negedge wrst_n) begin\n                if (!wrst_n) begin\n                    waddr <= {1'b0, {INT_WIDTH-1{1'b0}}};\n                    wfull <= 1'b0;\n                end else begin\n                    waddr <= sync_waddr;\n                    wfull <= sync_wfull;\n                end\n            end\n            \n            always @(posedge rclk or negedge rrst_n) begin\n                if (!rrst_n) begin\n                    raddr <= {1'b0, {INT_WIDTH-1{1'b0}}};\n                    rempty <= 1'b1;\n                end else begin\n                    raddr <= sync_raddr;\n                    rempty <= sync_rempty;\n                end\n            end\n        end\n    endgenerate\n\n    // Internal signals\n    reg [INT_WIDTH-1:0] wptr, rptr;\n    reg [INT_WIDTH-1:0] wptr_sync, rptr_sync;\n    reg [DATA_WIDTH-1:0] mem [0:MAX_DEPTH-1];\n    reg [INT_WIDTH-1:0] wptr_sync_reg, rptr_sync_reg;\n    reg [INT_WIDTH-1:0] wptr_sync_reg2, rptr_sync_reg2;\n    reg wfull_int, rempty_int;\n    reg [DATA_WIDTH-1:0] rdata_reg;\n\n    // Write pointer logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= {1'b0, {INT_WIDTH-1{1'b0}}};\n            wfull_int <= 1'b0;\n        end else begin\n            wptr <= wptr + winc;\n            wfull_int <= (wptr == rptr) && (winc && rinc);\n        end\n    end\n\n    // Read pointer logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= {1'b0, {INT_WIDTH-1{1'b0}}};\n            rempty_int <= 1'b1;\n        end else begin\n            rempty_int <= (rptr == wptr);\n            if (rinc && !rempty_int) begin\n                rptr <= rptr + 1;\n            end\n        end\n    end\n\n    // Memory write\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            mem <= '0;\n        end else if (winc && !wfull_int) begin\n            mem[wptr] <= wdata;\n        end\n    end\n\n    // Memory read\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata_reg <= '0;\n        end else if (rinc && !rempty_int) begin\n            rdata_reg <= mem[rptr];\n        end\n    end\n\n    // Cross-domain synchronization for pointers\n    // Write pointer sync to read domain\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_sync <= {1'b0, {INT_WIDTH-1{1'b0}}};\n            wptr_sync_reg <= {1'b0, {INT_WIDTH-1{1'b0}}};\n            wptr_sync_reg2 <= {1'b0, {INT_WIDTH-1{1'b0}}};\n        end else begin\n            wptr_sync <= wptr;\n            wptr_sync_reg <= wptr_sync;\n            wptr_sync_reg2 <= wptr_sync_reg;\n        end\n    end\n\n    // Read pointer sync to write domain\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_sync <= {1'b0, {INT_WIDTH-1{1'b0}}};\n            rptr_sync_reg <= {1'b0, {INT_WIDTH-1{1'b0}}};\n            rptr_sync_reg2 <= {1'b0, {INT_WIDTH-1{1'b0}}};\n        end else begin\n            rptr_sync <= rptr;\n            rptr_sync_reg <= rptr_sync;\n            rptr_sync_reg2 <= rptr_sync_reg;\n        end\n    end\n\n    // Full signal generation (write domain)\n    // Full when wptr == rptr and we have a pending write\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wfull <= 1'b0;\n        end else begin\n            wfull <= (wptr == rptr_sync_reg2) && winc;\n        end\n    end\n\n    // Empty signal generation (read domain)\n    // Empty when rptr == wptr and no pending read\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rempty <= 1'b1;\n        end else begin\n            rempty <= (rptr == wptr_sync_reg2) && !rinc;\n        end\n    end\n\n    // Output assignments\n    assign rdata = rdata_reg;\n    assign waddr = wptr;\n    assign raddr = rptr;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
