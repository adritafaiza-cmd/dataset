  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam ADDR_MASK = (1 << ADDR_WIDTH) - 1;\n    localparam FIFO_DEPTH = 1 << ADDR_WIDTH;\n\n    // Internal pointers: [ADDR_WIDTH-1:0] for address, [ADDR_WIDTH:0] for full/empty logic\n    reg [ADDR_WIDTH-1:0] wptr, rptr;\n    reg [ADDR_WIDTH-1:0] wptr_sync, rptr_sync;\n    reg [ADDR_WIDTH-1:0] wptr_gray, rptr_gray;\n    reg [ADDR_WIDTH-1:0] wptr_gray_sync, rptr_gray_sync;\n    reg [ADDR_WIDTH-1:0] wptr_gray_sync2, rptr_gray_sync2;\n\n    // Full/Empty flags\n    reg wfull;\n    reg rempty;\n\n    // Write Domain Logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= '0;\n            wfull <= 1'b0;\n        end else begin\n            if (winc && !wfull) begin\n                wptr <= wptr + 1'b1;\n            end\n        end\n    end\n\n    // Gray Encoder for Write Pointer\n    assign wptr_gray = wptr ^ (wptr >> 1);\n\n    // Read Domain Logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= '0;\n            rempty <= 1'b1;\n        end else begin\n            if (rinc && !rempty) begin\n                rptr <= rptr + 1'b1;\n            end\n        end\n    end\n\n    // Gray Encoder for Read Pointer\n    assign rptr_gray = rptr ^ (rptr >> 1);\n\n    // Cross-Clock Synchronization: Write Pointer (Read Domain)\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_sync <= '0;\n        end else begin\n            wptr_gray_sync <= wptr_gray;\n        end\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wptr_gray_sync2 <= '0;\n        end else begin\n            wptr_gray_sync2 <= wptr_gray_sync;\n        end\n    end\n\n    // Full Flag Generation (Read Domain)\n    // Full when write pointer equals read pointer + 1 (considering wrap-around)\n    assign wfull = (wptr_gray_sync2 == (rptr_gray_sync + 1'b1)) ? 1'b1 : 1'b0;\n\n    // Cross-Clock Synchronization: Read Pointer (Write Domain)\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_sync <= '0;\n        end else begin\n            rptr_gray_sync <= rptr_gray;\n        end\n    end\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            rptr_gray_sync2 <= '0;\n        end else begin\n            rptr_gray_sync2 <= rptr_gray_sync;\n        end\n    end\n\n    // Empty Flag Generation (Write Domain)\n    // Empty when write pointer equals read pointer\n    assign rempty = (wptr_gray_sync2 == rptr_gray_sync2) ? 1'b1 : 1'b0;\n\n    // Address Outputs (Debug Pointers)\n    assign waddr = wptr;\n    assign raddr = rptr;\n\n    // Data Output (Read Domain)\n    // Use a register to hold the data from the write domain\n    reg [DATA_WIDTH-1:0] wdata_sync;\n    reg [DATA_WIDTH-1:0] wdata_sync2;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wdata_sync <= '0;\n        end else begin\n            wdata_sync <= wdata;\n        end\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            wdata_sync2 <= '0;\n        end else begin\n            wdata_sync2 <= wdata_sync;\n        end\n    end\n\n    assign rdata = wdata_sync2;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
