  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam ADDR_WIDTH_LOG = ADDR_WIDTH + 1;\n    localparam DATA_WIDTH_LOG = DATA_WIDTH;\n\n    // Write side registers\n    reg [ADDR_WIDTH_LOG-1:0] w_ptr;\n    reg [ADDR_WIDTH_LOG-1:0] w_tail;\n    reg [ADDR_WIDTH_LOG-1:0] w_cnt;\n    reg [DATA_WIDTH-1:0]     w_data_reg;\n\n    // Read side registers\n    reg [ADDR_WIDTH_LOG-1:0] r_ptr;\n    reg [ADDR_WIDTH_LOG-1:0] r_tail;\n    reg [ADDR_WIDTH_LOG-1:0] r_cnt;\n    reg [DATA_WIDTH-1:0]     r_data_reg;\n\n    // Synchronizers for write pointer (read domain)\n    wire [ADDR_WIDTH_LOG-1:0] w_ptr_sync_0;\n    wire [ADDR_WIDTH_LOG-1:0] w_ptr_sync_1;\n    wire [ADDR_WIDTH_LOG-1:0] w_tail_sync_0;\n    wire [ADDR_WIDTH_LOG-1:0] w_tail_sync_1;\n\n    // Synchronizers for read pointer (write domain)\n    wire [ADDR_WIDTH_LOG-1:0] r_ptr_sync_0;\n    wire [ADDR_WIDTH_LOG-1:0] r_ptr_sync_1;\n    wire [ADDR_WIDTH_LOG-1:0] r_tail_sync_0;\n    wire [ADDR_WIDTH_LOG-1:0] r_tail_sync_1;\n\n    // Write side logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            w_ptr     <= 0;\n            w_tail    <= 0;\n            w_cnt     <= 0;\n            w_data_reg <= 0;\n            waddr     <= 0;\n            wfull     <= 1'b1;\n        end else begin\n            w_ptr     <= w_ptr + 1'b1;\n            w_tail    <= w_tail;\n            w_cnt     <= w_cnt + 1'b1;\n            w_data_reg <= wdata;\n            waddr     <= w_ptr;\n\n            if (w_cnt == (1 << ADDR_WIDTH_LOG)) begin\n                wfull <= 1'b1;\n            end else begin\n                wfull <= 1'b0;\n            end\n        end\n    end\n\n    // Read side logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            r_ptr     <= 0;\n            r_tail    <= 0;\n            r_cnt     <= 0;\n            r_data_reg <= 0;\n            raddr     <= 0;\n            rempty    <= 1'b1;\n        end else begin\n            r_ptr     <= r_ptr + 1'b1;\n            r_tail    <= r_tail;\n            r_cnt     <= r_cnt + 1'b1;\n            r_data_reg <= r_data_reg;\n            raddr     <= r_ptr;\n\n            if (r_cnt == (1 << ADDR_WIDTH_LOG)) begin\n                rempty <= 1'b1;\n            end else begin\n                rempty <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronizers for write pointer (read domain)\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            w_ptr_sync_0 <= 0;\n            w_ptr_sync_1 <= 0;\n            w_tail_sync_0 <= 0;\n            w_tail_sync_1 <= 0;\n        end else begin\n            w_ptr_sync_0 <= w_ptr;\n            w_ptr_sync_1 <= w_ptr_sync_0;\n            w_tail_sync_0 <= w_tail;\n            w_tail_sync_1 <= w_tail_sync_0;\n        end\n    end\n\n    // Synchronizers for read pointer (write domain)\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            r_ptr_sync_0 <= 0;\n            r_ptr_sync_1 <= 0;\n            r_tail_sync_0 <= 0;\n            r_tail_sync_1 <= 0;\n        end else begin\n            r_ptr_sync_0 <= r_ptr;\n            r_ptr_sync_1 <= r_ptr_sync_0;\n            r_tail_sync_0 <= r_tail;\n            r_tail_sync_1 <= r_tail_sync_0;\n        end\n    end\n\n    // Full flag logic (in write domain)\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wfull <= 1'b1;\n        end else begin\n            if (w_cnt == (1 << ADDR_WIDTH_LOG)) begin\n                wfull <= 1'b1;\n            end else if (w_cnt == (1 << ADDR_WIDTH_LOG) - 1 && w_ptr == r_ptr_sync_1) begin\n                wfull <= 1'b1;\n            end else begin\n                wfull <= 1'b0;\n            end\n        end\n    end\n\n    // Empty flag logic (in read domain)\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rempty <= 1'b1;\n        end else begin\n            if (r_cnt == (1 << ADDR_WIDTH_LOG)) begin\n                rempty <= 1'b1;\n            end else if (r_cnt == (1 << ADDR_WIDTH_LOG) - 1 && r_ptr == w_tail_sync_1) begin\n                rempty <= 1'b1;\n            end else begin\n                rempty <= 1'b0;\n            end\n        end\n    end\n\n    // Data output logic (in read domain)\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata <= 0;\n        end else begin\n            if (rinc) begin\n                rdata <= r_data_reg;\n            end else begin\n                rdata <= r_data_reg;\n            end\n        end\n    end\n\n    // Write enable logic (in write domain)\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            w_data_reg <= 0;\n        end else begin\n            if (winc && !wfull) begin\n                w_data_reg <= wdata;\n            end else begin\n                w_data_reg <= w_data_reg;\n            end\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
