  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam ADDR_WIDTH_LOG = ADDR_WIDTH + 1;\n    localparam FIFO_DEPTH = 2**ADDR_WIDTH;\n\n    // Write side registers\n    reg [ADDR_WIDTH-1:0] wptr;\n    reg [ADDR_WIDTH-1:0] wptr_next;\n    reg [ADDR_WIDTH-1:0] wfull_ptr;\n    reg wfull_reg;\n\n    // Read side registers\n    reg [ADDR_WIDTH-1:0] rptr;\n    reg [ADDR_WIDTH-1:0] rptr_next;\n    reg [ADDR_WIDTH-1:0] rempty_ptr;\n    reg rempty_reg;\n\n    // FIFO Memory\n    reg [DATA_WIDTH-1:0] mem [FIFO_DEPTH-1:0];\n\n    // Write Address Generation\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= '0;\n            wfull_ptr <= '0;\n            wfull_reg <= 1'b0;\n        end else begin\n            wptr <= wptr_next;\n            wfull_ptr <= wfull_ptr + 1'b1;\n            if (wptr_next == '0)\n                wfull_reg <= 1'b1;\n            else if (wptr_next == wfull_ptr)\n                wfull_reg <= 1'b0;\n            else\n                wfull_reg <= wfull_reg;\n        end\n    end\n\n    // Read Address Generation\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= '0;\n            rempty_ptr <= '0;\n            rempty_reg <= 1'b1;\n        end else begin\n            rptr <= rptr_next;\n            rempty_ptr <= rempty_ptr + 1'b1;\n            if (rptr_next == '0)\n                rempty_reg <= 1'b1;\n            else if (rptr_next == rempty_ptr)\n                rempty_reg <= 1'b0;\n            else\n                rempty_reg <= rempty_reg;\n        end\n    end\n\n    // Write Pointer Next Logic\n    always @* begin\n        wptr_next = wptr + 1'b1;\n        if (wptr == FIFO_DEPTH - 1'b1)\n            wptr_next = '0;\n    end\n\n    // Read Pointer Next Logic\n    always @* begin\n        rptr_next = rptr + 1'b1;\n        if (rptr == FIFO_DEPTH - 1'b1)\n            rptr_next = '0;\n    end\n\n    // Write Enable Logic (Increment pointer only if not full)\n    always @* begin\n        wptr_next = wptr;\n        if (winc && !wfull_reg)\n            wptr_next = wptr + 1'b1;\n            if (wptr == FIFO_DEPTH - 1'b1)\n                wptr_next = '0;\n    end\n\n    // Read Enable Logic (Increment pointer only if not empty)\n    always @* begin\n        rptr_next = rptr;\n        if (rinc && !rempty_reg)\n            rptr_next = rptr + 1'b1;\n            if (rptr == FIFO_DEPTH - 1'b1)\n                rptr_next = '0;\n    end\n\n    // Memory Write Logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            mem <= '0;\n        end else if (winc && !wfull_reg) begin\n            mem[wptr] <= wdata;\n        end\n    end\n\n    // Memory Read Logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rdata <= '0;\n        end else begin\n            rdata <= mem[rptr];\n        end\n    end\n\n    // Clock Domain Crossing: Write Address to Read Domain\n    wire [ADDR_WIDTH-1:0] wptr_synced;\n    wire [ADDR_WIDTH-1:0] wptr_synced_1;\n    wire [ADDR_WIDTH-1:0] wptr_synced_2;\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr_synced <= '0;\n        else\n            wptr_synced <= wptr;\n    end\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr_synced_1 <= '0;\n        else\n            wptr_synced_1 <= wptr_synced;\n    end\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr_synced_2 <= '0;\n        else\n            wptr_synced_2 <= wptr_synced_1;\n    end\n\n    // Clock Domain Crossing: Read Address to Write Domain\n    wire [ADDR_WIDTH-1:0] rptr_synced;\n    wire [ADDR_WIDTH-1:0] rptr_synced_1;\n    wire [ADDR_WIDTH-1:0] rptr_synced_2;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr_synced <= '0;\n        else\n            rptr_synced <= rptr;\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr_synced_1 <= '0;\n        else\n            rptr_synced_1 <= rptr_synced;\n    end\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr_synced_2 <= '0;\n        else\n            rptr_synced_2 <= rptr_synced_1;\n    end\n\n    // Full Flag Logic (Write Domain)\n    // Full when write pointer equals read pointer (after sync)\n    always @* begin\n        wfull = 1'b0;\n        if (wptr == rptr_synced_2)\n            wfull = 1'b1;\n    end\n\n    // Empty Flag Logic (Read Domain)\n    // Empty when read pointer equals write pointer (after sync)\n    always @* begin\n        rempty = 1'b0;\n        if (rptr == wptr_synced_2)\n            rempty = 1'b1;\n    end\n\n    // Output Ports\n    assign waddr = wptr;\n    assign raddr = rptr;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
