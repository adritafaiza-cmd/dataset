  "text": "```systemverilog\nmodule async_fifo #(\n    parameter DATA_WIDTH = 8,\n    parameter ADDR_WIDTH = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam ADDR_MASK = (1 << ADDR_WIDTH) - 1;\n    localparam FIFO_DEPTH = 1 << ADDR_WIDTH;\n\n    // Generate Gray code stages for CDC\n    localparam NUM_STAGES = SYNC_STAGES;\n    localparam STAGE_WIDTH = ADDR_WIDTH + 1; // Address + Valid flag\n\n    // Internal signals\n    wire [ADDR_WIDTH:0] wptr_raw;\n    wire [ADDR_WIDTH:0] rptr_raw;\n    wire [ADDR_WIDTH:0] wptr_synced;\n    wire [ADDR_WIDTH:0] rptr_synced;\n    wire wptr_valid;\n    wire rptr_valid;\n    wire [ADDR_WIDTH:0] wptr_gray;\n    wire [ADDR_WIDTH:0] rptr_gray;\n    wire [ADDR_WIDTH:0] wptr_gray_synced;\n    wire [ADDR_WIDTH:0] rptr_gray_synced;\n    wire wptr_valid_synced;\n    wire rptr_valid_synced;\n    wire [ADDR_WIDTH:0] wptr_gray_synced_2;\n    wire [ADDR_WIDTH:0] rptr_gray_synced_2;\n    wire wptr_valid_synced_2;\n    wire rptr_valid_synced_2;\n\n    // Write Pointer Generation (Write Domain)\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr_raw <= 0;\n        else if (winc)\n            wptr_raw <= wptr_raw + 1'b1;\n    end\n\n    // Read Pointer Generation (Read Domain)\n    always_ff @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr_raw <= 0;\n        else if (rinc)\n            rptr_raw <= rptr_raw + 1'b1;\n    end\n\n    // --- Write Pointer Sync to Read Domain ---\n    // Stage 1: Address + Valid\n    always_ff @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            wptr_gray <= {wptr_raw[ADDR_WIDTH-1:0], 1'b0};\n        else\n            wptr_gray <= wptr_raw;\n    end\n\n    // Stage 2: Valid Flag\n    always_ff @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            wptr_valid <= 1'b0;\n        else\n            wptr_valid <= wptr_gray[ADDR_WIDTH];\n    end\n\n    // Stage 3: Address (Gray to Binary conversion happens implicitly by using the raw pointer logic \n    // but we need to sync the pointer value itself. Since we are using a simple counter, \n    // we sync the pointer value through a chain of registers to ensure stability).\n    // However, for a standard Gray code implementation, we usually sync the pointer value \n    // and the valid flag separately. Let's use a standard 2-stage sync for the pointer value \n    // and 2-stage for the valid flag, then combine.\n    \n    // Re-architecting for robust CDC:\n    // 1. Write Domain: Counter (wptr_raw)\n    // 2. Sync wptr_raw to Read Domain (2 stages) -> wptr_synced\n    // 3. Sync wptr_valid (wptr_raw[ADDR_WIDTH] if we used Gray, but here we use raw counter comparison)\n    //    Actually, comparing raw counters across domains is unsafe if not synchronized.\n    //    Standard approach: Sync the pointer value (wptr_raw) to read domain.\n    //    Then compare wptr_synced with rptr_raw in read domain.\n    //    But wptr_raw is not Gray. Comparing raw binary pointers across domains is prone to metastability \n    //    during the transition.\n    //    Correct approach: Use Gray code for the pointer itself.\n    \n    // Let's restart the pointer logic with proper Gray code generation in Write Domain.\n    \n    // Write Domain: Gray Code Generator\n    // wptr_gray[ADDR_WIDTH] is the MSB (Valid bit for the pointer chain)\n    // wptr_gray[ADDR_WIDTH-1:0] is the address\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            wptr_gray <= {ADDR_WIDTH{1'b0}};\n        else if (winc)\n            wptr_gray <= wptr_gray ^ {ADDR_WIDTH{wptr_gray[ADDR_WIDTH-1:0]}};\n    end\n\n    // Read Domain: Sync wptr_gray (2 stages)\n    // Stage 1\n    always_ff @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            wptr_gray_synced <= {ADDR_WIDTH{1'b0}};\n        else\n            wptr_gray_synced <= wptr_gray;\n    end\n    // Stage 2\n    always_ff @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            wptr_gray_synced_2 <= {ADDR_WIDTH{1'b0}};\n        else\n            wptr_gray_synced_2 <= wptr_gray_synced;\n    end\n\n    // Read Domain: Sync wptr_valid (MSB of wptr_gray)\n    // Stage 1\n    always_ff @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            wptr_valid <= 1'b0;\n        else\n            wptr_valid <= wptr_gray_synced[ADDR_WIDTH-1]; // MSB of the synced pointer\n    end\n    // Stage 2\n    always_ff @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            wptr_valid_synced <= 1'b0;\n        else\n            wptr_valid_synced <= wptr_valid;\n    end\n\n    // --- Read Pointer Sync to Write Domain ---\n    // Read Domain: Gray Code Generator\n    always_ff @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n)\n            rptr_gray <= {ADDR_WIDTH{1'b0}};\n        else if (rinc)\n            rptr_gray <= rptr_gray ^ {ADDR_WIDTH{rptr_gray[ADDR_WIDTH-1:0]}};\n    end\n\n    // Write Domain: Sync rptr_gray (2 stages)\n    // Stage 1\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            rptr_gray_synced <= {ADDR_WIDTH{1'b0}};\n        else\n            rptr_gray_synced <= rptr_gray;\n    end\n    // Stage 2\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            rptr_gray_synced_2 <= {ADDR_WIDTH{1'b0}};\n        else\n            rptr_gray_synced_2 <= rptr_gray_synced;\n    end\n\n    // Write Domain: Sync rptr_valid (MSB of rptr_gray)\n    // Stage 1\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            rptr_valid <= 1'b0;\n        else\n            rptr_valid <= rptr_gray_synced[ADDR_WIDTH-1];\n    end\n    // Stage 2\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            rptr_valid_synced <= 1'b0;\n        else\n            rptr_valid_synced <= rptr_valid;\n    end\n\n    // --- Data Storage ---\n    // Data is stored in the write domain.\n    // We need to store data at wptr_gray[ADDR_WIDTH-1:0].\n    // Since wptr_gray changes on write, we can use the raw pointer to index.\n    // However, to avoid race conditions, we store data when winc is high.\n    \n    reg [DATA_WIDTH-1:0] mem [0:ADDR_MASK];\n    \n    // Write Data Logic\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            mem <= '{default: 0};\n        else if (winc)\n            mem[wptr_gray[ADDR_WIDTH-1:0]] <= wdata;\n    end\n\n    // --- Full/Empty Logic (Read Domain) ---\n    // Full: wptr == rptr AND wptr_valid == 1 (meaning write pointer has advanced past read pointer)\n    // Empty: wptr == rptr AND wptr_valid == 0 (meaning write pointer hasn't advanced past read pointer)\n    \n    // Calculate Full\n    // wptr_gray_synced_2 is the stable write pointer in read domain\n    // rptr_gray_synced_2 is the stable read pointer in read domain\n    // wptr_valid_synced_2 is the stable valid flag\n    \n    assign wfull = (wptr_gray_synced_2 == rptr_gray_synced_2) && wptr_valid_synced_2;\n    \n    // Calculate Empty\n    // rempty is high when wptr == rptr and wptr_valid is low\n    assign rempty = (wptr_gray_synced_2 == rptr_gray_synced_2) && (!wptr_valid_synced_2);\n\n    // --- Read Data Logic (Write Domain) ---\n    // Read data is sampled in the write domain when rinc is high.\n    // We read from mem[rptr_gray[ADDR_WIDTH-1:0]].\n    // We need to ensure rptr_gray is stable in write domain before reading.\n    // rptr_gray_synced_2 is stable in write domain.\n    \n    reg [DATA_WIDTH-1:0] rdata_reg;\n    reg rinc_synced;\n    \n    // Sync rinc to write domain (2 stages)\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            rinc_synced <= 1'b0;\n        else\n            rinc_synced <= rinc;\n    end\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            rinc_synced <= 1'b0;\n        else\n            rinc_synced <= rinc_synced;\n    end\n\n    // Read Data Logic\n    always_ff @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n)\n            rdata_reg <= 0;\n        else if (rinc_synced)\n            rdata_reg <= mem[rptr_gray_synced_2[ADDR_WIDTH-1:0]];\n    end\n\n    // Output assignments\n    assign waddr = wptr_gray[ADDR_WIDTH-1:0];\n    assign raddr = rptr_gray[ADDR_WIDTH-1:0];\n    assign rdata = rdata_reg;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
