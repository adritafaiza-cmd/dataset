  "text": "```verilog\nmodule wbxclk #(\n\tparameter\tAW=32,\n\t\t\t\tDW=32,\n\t\t\t\tLGFIFO = 5\n) (\n\tinput\twire\t\t\ti_wb_clk, i_reset,\n\tinput\twire\t\t\ti_wb_cyc, i_wb_stb, i_wb_we,\n\tinput\twire\t[(AW-1):0]\ti_wb_addr,\n\tinput\twire\t[(DW-1):0]\ti_wb_data,\n\tinput\twire\t[(DW/8-1):0]\ti_wb_sel,\n\toutput\twire\t\t\to_wb_stall,\n\toutput\treg\t\t\to_wb_ack,\n\toutput\treg\t[(DW-1):0]\to_wb_data,\n\toutput\treg\t\t\to_wb_err,\n\tinput\twire\t\t\ti_xclk_clk,\n\toutput\treg\t\t\to_xclk_cyc,\n\toutput\treg\t\t\to_xclk_stb,\n\toutput\treg\t\t\to_xclk_we,\n\toutput\treg\t[(AW-1):0]\to_xclk_addr,\n\toutput\treg\t[(DW-1):0]\to_xclk_data,\n\toutput\treg\t[(DW/8-1):0]\to_xclk_sel,\n\tinput\twire\t\t\ti_xclk_stall,\n\tinput\twire\t\t\ti_xclk_ack,\n\tinput\twire\t[(DW-1):0]\ti_xclk_data,\n\tinput\twire\t\t\ti_xclk_err\n);\n\n\tlocalparam\tDEPTH = 1 << LGFIFO;\n\n\t// Wishbone Side State Machine\n\t// States: IDLE, WAIT_XACK, WAIT_XERR\n\tlocalparam\tIDLE = 2'b00,\n\t\t\t\tWAIT_XACK = 2'b01,\n\t\t\t\tWAIT_XERR = 2'b10;\n\n\treg\t[1:0]\twb_state;\n\treg\t\twb_valid;\n\treg\t\twb_stall_flag;\n\treg\t\t[LGFIPO-1:0]\twb_fifo_wptr;\n\treg\t\t[LGFIPO-1:0]\twb_fifo_rptr;\n\treg\t\t[LGFIPO-1:0]\twb_fifo_count;\n\treg\t\t[AW-1:0]\twb_fifo_addr;\n\treg\t\t[DW-1:0]\twb_fifo_data;\n\treg\t\t[DW/8-1:0]\twb_fifo_sel;\n\treg\t\t\twb_fifo_we;\n\treg\t\t\twb_fifo_err;\n\n\t// XCLK Side State Machine\n\t// States: IDLE, WAIT_WACK, WAIT_WERR\n\tlocalparam\tX_IDLE = 2'b00,\n\t\t\t\tX_WAIT_WACK = 2'b01,\n\t\t\t\tX_WAIT_WERR = 2'b10;\n\n\treg\t[1:0]\tx_state;\n\treg\t\tx_valid;\n\treg\t\tx_stall_flag;\n\treg\t\t[LGFIPO-1:0]\tx_fifo_wptr;\n\treg\t\t[LGFIPO-1:0]\tx_fifo_rptr;\n\treg\t\t[LGFIPO-1:0]\tx_fifo_count;\n\treg\t\t[AW-1:0]\tx_fifo_addr;\n\treg\t\t[DW-1:0]\tx_fifo_data;\n\treg\t\t[DW/8-1:0]\tx_fifo_sel;\n\treg\t\t\tx_fifo_we;\n\treg\t\t\tx_fifo_err;\n\n\t// Wishbone FIFO Logic\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\twb_fifo_wptr <= '0;\n\t\t\twb_fifo_rptr <= '0;\n\t\t\twb_fifo_count <= '0;\n\t\t\twb_fifo_addr <= '0;\n\t\t\twb_fifo_data <= '0;\n\t\t\twb_fifo_sel <= '0;\n\t\t\twb_fifo_we <= 1'b0;\n\t\t\twb_fifo_err <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\twb_fifo_wptr <= wb_fifo_wptr + wb_fifo_we;\n\t\t\twb_fifo_rptr <= wb_fifo_rptr + x_fifo_we;\n\t\t\twb_fifo_count <= wb_fifo_count + wb_fifo_we - x_fifo_we;\n\t\t\twb_fifo_addr <= wb_fifo_addr;\n\t\t\twb_fifo_data <= wb_fifo_data;\n\t\t\twb_fifo_sel <= wb_fifo_sel;\n\t\t\twb_fifo_we <= wb_valid;\n\t\t\twb_fifo_err <= wb_valid & wb_fifo_err;\n\t\tend\n\tend\n\n\t// XCLK FIFO Logic\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tx_fifo_wptr <= '0;\n\t\t\tx_fifo_rptr <= '0;\n\t\t\tx_fifo_count <= '0;\n\t\t\tx_fifo_addr <= '0;\n\t\t\tx_fifo_data <= '0;\n\t\t\tx_fifo_sel <= '0;\n\t\t\tx_fifo_we <= 1'b0;\n\t\t\tx_fifo_err <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\tx_fifo_wptr <= x_fifo_wptr + x_fifo_we;\n\t\t\tx_fifo_rptr <= x_fifo_rptr + wb_fifo_we;\n\t\t\tx_fifo_count <= x_fifo_count + x_fifo_we - wb_fifo_we;\n\t\t\tx_fifo_addr <= x_fifo_addr;\n\t\t\tx_fifo_data <= x_fifo_data;\n\t\t\tx_fifo_sel <= x_fifo_sel;\n\t\t\tx_fifo_we <= x_valid;\n\t\t\tx_fifo_err <= x_valid & x_fifo_err;\n\t\tend\n\tend\n\n\t// Wishbone Side State Machine\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\twb_state <= IDLE;\n\t\t\twb_valid <= 1'b0;\n\t\t\twb_stall_flag <= 1'b0;\n\t\t\to_wb_ack <= 1'b0;\n\t\t\to_wb_err <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\tcase (wb_state)\n\t\t\t\tIDLE: begin\n\t\t\t\t\tif (i_wb_cyc & i_wb_stb & ~wb_stall_flag) begin\n\t\t\t\t\t\twb_state <= WAIT_XACK;\n\t\t\t\t\t\twb_valid <= 1'b1;\n\t\t\t\t\t\to_wb_ack <= 1'b0;\n\t\t\t\t\t\to_wb_err <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tWAIT_XACK: begin\n\t\t\t\t\tif (i_xclk_ack) begin\n\t\t\t\t\t\twb_state <= IDLE;\n\t\t\t\t\t\twb_valid <= 1'b0;\n\t\t\t\t\t\to_wb_ack <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\t\telse if (i_xclk_err) begin\n\t\t\t\t\t\twb_state <= IDLE;\n\t\t\t\t\t\twb_valid <= 1'b0;\n\t\t\t\t\t\to_wb_err <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tWAIT_XERR: begin\n\t\t\t\t\tif (i_xclk_ack) begin\n\t\t\t\t\t\twb_state <= IDLE;\n\t\t\t\t\t\twb_valid <= 1'b0;\n\t\t\t\t\t\to_wb_err <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: begin\n\t\t\t\t\twb_state <= IDLE;\n\t\t\t\tend\n\t\t\tendcase\n\t\tend\n\tend\n\n\t// XCLK Side State Machine\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tx_state <= X_IDLE;\n\t\t\tx_valid <= 1'b0;\n\t\t\tx_stall_flag <= 1'b0;\n\t\t\to_xclk_cyc <= 1'b0;\n\t\t\to_xclk_stb <= 1'b0;\n\t\t\to_xclk_we <= 1'b0;\n\t\t\to_xclk_err <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\tcase (x_state)\n\t\t\t\tX_IDLE: begin\n\t\t\t\t\tif (i_xclk_cyc & i_xclk_stb & ~x_stall_flag) begin\n\t\t\t\t\t\tx_state <= X_WAIT_WACK;\n\t\t\t\t\t\tx_valid <= 1'b1;\n\t\t\t\t\t\to_xclk_cyc <= 1'b1;\n\t\t\t\t\t\to_xclk_stb <= 1'b1;\n\t\t\t\t\t\to_xclk_we <= i_wb_we;\n\t\t\t\t\t\to_xclk_err <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tX_WAIT_WACK: begin\n\t\t\t\t\tif (i_wb_ack) begin\n\t\t\t\t\t\tx_state <= X_IDLE;\n\t\t\t\t\t\tx_valid <= 1'b0;\n\t\t\t\t\t\to_xclk_cyc <= 1'b0;\n\t\t\t\t\t\to_xclk_stb <= 1'b0;\n\t\t\t\t\t\to_xclk_we <= 1'b0;\n\t\t\t\t\t\to_xclk_err <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\t\telse if (i_wb_err) begin\n\t\t\t\t\t\tx_state <= X_IDLE;\n\t\t\t\t\t\tx_valid <= 1'b0;\n\t\t\t\t\t\to_xclk_cyc <= 1'b0;\n\t\t\t\t\t\to_xclk_stb <= 1'b0;\n\t\t\t\t\t\to_xclk_we <= 1'b0;\n\t\t\t\t\t\to_xclk_err <= 1'b1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tX_WAIT_WERR: begin\n\t\t\t\t\tif (i_wb_ack) begin\n\t\t\t\t\t\tx_state <= X_IDLE;\n\t\t\t\t\t\tx_valid <= 1'b0;\n\t\t\t\t\t\to_xclk_cyc <= 1'b0;\n\t\t\t\t\t\to_xclk_stb <= 1'b0;\n\t\t\t\t\t\to_xclk_we <= 1'b0;\n\t\t\t\t\t\to_xclk_err <= 1'b0;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tdefault: begin\n\t\t\t\t\tx_state <= X_IDLE;\n\t\t\t\tend\n\t\t\tendcase\n\t\tend\n\tend\n\n\t// Output Logic\n\tassign o_wb_stall = wb_stall_flag | x_stall_flag;\n\tassign o_wb_data = wb_fifo_data;\n\tassign o_wb_sel = wb_fifo_sel;\n\tassign o_xclk_addr = x_fifo_addr;\n\tassign o_xclk_data = x_fifo_data;\n\tassign o_xclk_sel = x_fifo_sel;\n\n\t// Stall Logic\n\talways @(posedge i_wb_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\twb_stall_flag <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\twb_stall_flag <= (wb_fifo_count == DEPTH) ? 1'b1 : 1'b0;\n\t\tend\n\tend\n\n\talways @(posedge i_xclk_clk or posedge i_reset) begin\n\t\tif (i_reset) begin\n\t\t\tx_stall_flag <= 1'b0;\n\t\tend\n\t\telse begin\n\t\t\tx_stall_flag <= (x_fifo_count == DEPTH) ? 1'b1 : 1'b0;\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
