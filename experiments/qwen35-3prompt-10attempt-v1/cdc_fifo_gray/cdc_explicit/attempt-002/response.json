  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output reg [WIDTH-1:0] dst_data_o,\n    output reg             dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam GRAY_WIDTH = LOG_DEPTH + 1;\n\n    // Internal registers for pointers and data\n    reg [LOG_DEPTH-1:0] src_ptr;\n    reg [LOG_DEPTH-1:0] dst_ptr;\n    reg [LOG_DEPTH-1:0] src_gray_ptr;\n    reg [LOG_DEPTH-1:0] dst_gray_ptr;\n    reg [WIDTH-1:0] fifo_mem [DEPTH-1:0];\n    reg [WIDTH-1:0] dst_data_reg;\n    reg dst_valid_reg;\n\n    // ---------------------------------------------------------\n    // Source Domain Logic\n    // ---------------------------------------------------------\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_ptr <= '{default: 0};\n            src_ready_o <= 1'b1;\n        end else begin\n            // Calculate Gray code for current pointer\n            src_gray_ptr <= src_ptr ^ (src_ptr >> 1);\n            \n            // Check if FIFO is full\n            if (src_gray_ptr == dst_gray_ptr) begin\n                src_ready_o <= 1'b0;\n            end else begin\n                src_ready_o <= 1'b1;\n            end\n            \n            // Write data if valid and ready\n            if (src_valid_i && src_ready_o) begin\n                fifo_mem[src_ptr] <= src_data_i;\n                src_ptr <= src_ptr + 1'b1;\n            end\n        end\n    end\n\n    // ---------------------------------------------------------\n    // Destination Domain Logic\n    // ---------------------------------------------------------\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_ptr <= '{default: 0};\n            dst_gray_ptr <= '{default: 0};\n            dst_data_reg <= '{default: 0};\n            dst_valid_reg <= 1'b0;\n        end else begin\n            // Calculate Gray code for current pointer\n            dst_gray_ptr <= dst_ptr ^ (dst_ptr >> 1);\n            \n            // Check if FIFO is empty\n            if (dst_gray_ptr == src_gray_ptr) begin\n                dst_valid_reg <= 1'b0;\n            end else begin\n                // Read data from memory\n                dst_data_reg <= fifo_mem[dst_ptr];\n                dst_valid_reg <= 1'b1;\n                \n                // Update pointer if data is accepted\n                if (dst_valid_reg && dst_ready_i) begin\n                    dst_ptr <= dst_ptr + 1'b1;\n                end\n            end\n            \n            // Output assignments\n            dst_data_o <= dst_data_reg;\n            dst_valid_o <= dst_valid_reg;\n        end\n    end\n\n    // ---------------------------------------------------------\n    // CDC Synchronization for Pointers (Gray Code Crossing)\n    // ---------------------------------------------------------\n    // We use a dual-flop synchronizer for the critical pointer bits\n    // and a multi-stage synchronizer for the full pointer to ensure\n    // stability before using it in the logic.\n    \n    // Synchronize src_gray_ptr into dst domain\n    reg [GRAY_WIDTH-1:0] src_gray_synced_1;\n    reg [GRAY_WIDTH-1:0] src_gray_synced_2;\n    \n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            src_gray_synced_1 <= '{default: 0};\n            src_gray_synced_2 <= '{default: 0};\n        end else begin\n            src_gray_synced_1 <= src_gray_ptr;\n            src_gray_synced_2 <= src_gray_synced_1;\n        end\n    end\n\n    // Synchronize dst_gray_ptr into src domain\n    reg [GRAY_WIDTH-1:0] dst_gray_synced_1;\n    reg [GRAY_WIDTH-1:0] dst_gray_synced_2;\n    \n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            dst_gray_synced_1 <= '{default: 0};\n            dst_gray_synced_2 <= '{default: 0};\n        end else begin\n            dst_gray_synced_1 <= dst_gray_ptr;\n            dst_gray_synced_2 <= dst_gray_synced_1;\n        end\n    end\n\n    // Use synchronized pointers for the full comparison logic to ensure\n    // the empty/full detection is stable across clock domains.\n    // Note: In a real implementation, we might need more stages depending on\n    // the specific timing closure, but 2 stages is standard for pointer crossing.\n    // The logic below uses the synchronized versions to determine empty/full.\n    \n    // Re-implement the ready/valid logic using synchronized pointers for safety\n    // This ensures that the decision to accept data is based on a stable view\n    // of the other domain's pointer.\n    \n    reg src_ready_safe;\n    reg dst_valid_safe;\n    \n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_ready_safe <= 1'b1;\n        end else begin\n            // Compare synchronized dst pointer with current src pointer\n            if (src_gray_ptr == dst_gray_synced_2) begin\n                src_ready_safe <= 1'b0;\n            end else begin\n                src_ready_safe <= 1'b1;\n            end\n        end\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_valid_safe <= 1'b0;\n        end else begin\n            // Compare synchronized src pointer with current dst pointer\n            if (dst_gray_ptr == src_gray_synced_2) begin\n                dst_valid_safe <= 1'b0;\n            end else begin\n                dst_valid_safe <= 1'b1;\n            end\n        end\n    end\n\n    // Assign final outputs based on safe logic\n    assign src_ready_o = src_ready_safe;\n    assign dst_valid_o = dst_valid_safe;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
