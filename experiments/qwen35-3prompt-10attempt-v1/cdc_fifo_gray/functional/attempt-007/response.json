  "text": "```verilog\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output reg [WIDTH-1:0] dst_data_o,\n    output reg             dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam GRAY_WIDTH = $clog2(DEPTH);\n\n    // Source Domain Signals\n    reg [LOG_DEPTH-1:0] src_write_ptr;\n    reg [LOG_DEPTH-1:0] src_read_ptr;\n    reg [LOG_DEPTH-1:0] src_gray_ptr;\n    reg src_write_en;\n    reg src_full;\n    reg [DEPTH-1:0] src_full_reg;\n\n    // Destination Domain Signals\n    reg [LOG_DEPTH-1:0] dst_read_ptr;\n    reg [LOG_DEPTH-1:0] dst_write_ptr; // Used as read pointer in dest domain\n    reg [LOG_DEPTH-1:0] dst_gray_ptr;\n    reg dst_read_en;\n    reg dst_empty;\n    reg [DEPTH-1:0] dst_empty_reg;\n\n    // Cross-domain pointers (Gray encoded for stability)\n    reg [LOG_DEPTH-1:0] src_gray_write_ptr;\n    reg [LOG_DEPTH-1:0] dst_gray_read_ptr;\n\n    // Data Storage\n    reg [WIDTH-1:0] mem [DEPTH-1:0];\n\n    // Synchronizers for control signals\n    reg [SYNC_STAGES-1:0] src_valid_sync;\n    reg [SYNC_STAGES-1:0] dst_ready_sync;\n    reg [SYNC_STAGES-1:0] src_rst_sync;\n    reg [SYNC_STAGES-1:0] dst_rst_sync;\n\n    // ---------------------------------------------------------\n    // Source Domain Logic\n    // ---------------------------------------------------------\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            src_write_ptr <= '0;\n            src_read_ptr  <= '0;\n            src_gray_ptr  <= '0;\n            src_full      <= 1'b0;\n            src_full_reg  <= '0;\n            src_write_en  <= 1'b0;\n        end else begin\n            src_write_ptr <= src_write_ptr + src_write_en;\n            src_read_ptr  <= src_read_ptr + dst_read_en;\n            \n            // Calculate Gray pointer from binary write pointer\n            src_gray_ptr <= src_write_ptr ^ (src_write_ptr >> 1);\n            \n            // Full detection: (write_ptr - read_ptr) == DEPTH - 1\n            // Using subtraction to avoid overflow issues with large depths\n            if (src_write_en && !src_full) begin\n                if (src_write_ptr == src_read_ptr) begin\n                    // FIFO is full\n                    src_full <= 1'b1;\n                end else begin\n                    src_full <= 1'b0;\n                end\n            end\n            \n            // Register full signal for stability\n            src_full_reg <= src_full;\n        end\n    end\n\n    // ---------------------------------------------------------\n    // Destination Domain Logic\n    // ---------------------------------------------------------\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_read_ptr <= '0;\n            dst_write_ptr <= '0; // Alias for read pointer in dest domain\n            dst_gray_ptr <= '0;\n            dst_empty    <= 1'b1;\n            dst_empty_reg <= '0;\n            dst_read_en  <= 1'b0;\n        end else begin\n            dst_read_ptr <= dst_read_ptr + dst_read_en;\n            dst_write_ptr <= dst_write_ptr + src_write_en; // Alias for read pointer in dest domain\n            \n            // Calculate Gray pointer from binary read pointer\n            dst_gray_ptr <= dst_read_ptr ^ (dst_read_ptr >> 1);\n            \n            // Empty detection: (read_ptr - write_ptr) == 0\n            if (dst_read_en && !dst_empty) begin\n                if (dst_read_ptr == dst_write_ptr) begin\n                    // FIFO is empty\n                    dst_empty <= 1'b1;\n                end else begin\n                    dst_empty <= 1'b0;\n                end\n            end\n            \n            // Register empty signal for stability\n            dst_empty_reg <= dst_empty;\n        end\n    end\n\n    // ---------------------------------------------------------\n    // Cross-Clock Pointers (Gray Encoding)\n    // ---------------------------------------------------------\n    // Source domain generates Gray pointer for destination\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_gray_write_ptr <= '0;\n        else\n            src_gray_write_ptr <= src_gray_ptr;\n    end\n\n    // Destination domain generates Gray pointer for source\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_gray_read_ptr <= '0;\n        else\n            dst_gray_read_ptr <= dst_gray_ptr;\n    end\n\n    // ---------------------------------------------------------\n    // Synchronizers\n    // ---------------------------------------------------------\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_valid_sync <= {SYNC_STAGES{1'b0}};\n        else\n            src_valid_sync <= {src_valid_sync[SYNC_STAGES-2:0], src_valid_i};\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_ready_sync <= {SYNC_STAGES{1'b0}};\n        else\n            dst_ready_sync <= {dst_ready_sync[SYNC_STAGES-2:0], dst_ready_i};\n    end\n\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_rst_sync <= {SYNC_STAGES{1'b0}};\n        else\n            src_rst_sync <= {src_rst_sync[SYNC_STAGES-2:0], src_rst_ni};\n    end\n\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_rst_sync <= {SYNC_STAGES{1'b0}};\n        else\n            dst_rst_sync <= {dst_rst_sync[SYNC_STAGES-2:0], dst_rst_ni};\n    end\n\n    // ---------------------------------------------------------\n    // Control Logic\n    // ---------------------------------------------------------\n    // Source Ready: Not full AND valid signal synchronized\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_ready_o <= 1'b0;\n        else\n            src_ready_o <= ~src_full_reg && src_valid_sync[SYNC_STAGES-1];\n    end\n\n    // Destination Valid: Not empty AND ready signal synchronized\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_valid_o <= 1'b0;\n        else\n            dst_valid_o <= ~dst_empty_reg && dst_ready_sync[SYNC_STAGES-1];\n    end\n\n    // ---------------------------------------------------------\n    // Write Enable (Source Domain)\n    // ---------------------------------------------------------\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni)\n            src_write_en <= 1'b0;\n        else\n            src_write_en <= src_valid_i && src_ready_o;\n    end\n\n    // ---------------------------------------------------------\n    // Read Enable (Destination Domain)\n    // ---------------------------------------------------------\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni)\n            dst_read_en <= 1'b0;\n        else\n            dst_read_en <= dst_valid_o;\n    end\n\n    // ---------------------------------------------------------\n    // Data Output (Destination Domain)\n    // ---------------------------------------------------------\n    // Read data from memory using the synchronized read pointer\n    // The pointer is updated on dst_clk_i, so we use the current value of dst_read_ptr\n    // to index into the memory.\n    always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n        if (!dst_rst_ni) begin\n            dst_data_o <= '0;\n            dst_valid_o <= 1'b0;\n        end else begin\n            if (dst_valid_o) begin\n                dst_data_o <= mem[dst_read_ptr];\n            end else begin\n                dst_data_o <= '0;\n            end\n        end\n    end\n\n    // ---------------------------------------------------------\n    // Memory Write (Source Domain)\n    // ---------------------------------------------------------\n    always @(posedge src_clk_i or negedge src_rst_ni) begin\n        if (!src_rst_ni) begin\n            mem <= '0;\n        end else if (src_write_en) begin\n            mem[src_write_ptr] <= src_data_i;\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
