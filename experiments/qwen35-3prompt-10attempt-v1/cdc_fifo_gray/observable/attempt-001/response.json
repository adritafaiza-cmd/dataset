  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule cdc_fifo_gray #(\n    parameter WIDTH = 8,\n    parameter LOG_DEPTH = 3,\n    parameter SYNC_STAGES = 2\n)(\n    input                  src_rst_ni,\n    input                  src_clk_i,\n    input  [WIDTH-1:0]     src_data_i,\n    input                  src_valid_i,\n    output                 src_ready_o,\n    input                  dst_rst_ni,\n    input                  dst_clk_i,\n    output reg [WIDTH-1:0] dst_data_o,\n    output reg             dst_valid_o,\n    input                  dst_ready_i\n);\n\n    localparam DEPTH = 1 << LOG_DEPTH;\n    localparam GRAY_WIDTH = $clog2(DEPTH);\n\n    // --- Source Side (Write) ---\n    reg [LOG_DEPTH-1:0] write_ptr;\n    reg [LOG_DEPTH-1:0] read_ptr;\n    reg [WIDTH-1:0]     data_mem [DEPTH-1:0];\n    reg                 write_en;\n    reg                 read_en;\n    reg                 full;\n    reg                 empty;\n    reg [LOG_DEPTH-1:0] write_gray;\n    reg [LOG_DEPTH-1:0] read_gray;\n\n    // --- Destination Side (Read) ---\n    // We need to capture the write pointer from the source domain to determine if data is available\n    // and to handle the \"lag\" requirement for dst_valid_o.\n    wire [LOG_DEPTH-1:0] src_write_ptr_captured;\n    wire [LOG_DEPTH-1:0] src_read_ptr_captured;\n    wire                 src_full_captured;\n    wire                 src_empty_captured;\n\n    // --- CDC Logic: Gray Encoding for Pointers ---\n    // Source Domain: Generate Gray encoded pointers\n    assign write_gray = write_ptr ^ (write_ptr >> 1);\n    assign read_gray  = read_ptr ^ (read_ptr >> 1);\n\n    // Destination Domain: Decode Gray pointers back to binary\n    // Since the pointers are captured asynchronously, we decode them here.\n    // Note: For small depths, direct decoding is fine. For larger, a dedicated decoder might be used,\n    // but standard binary-to-gray and gray-to-binary logic works for the pointer values themselves.\n    // However, the standard approach for FIFOs is to keep pointers in binary on each side\n    // and only cross the boundary using Gray encoding.\n    // Here, we capture the Gray pointers from the other domain.\n    \n    // Capture Write Pointer (Gray) from Source to Dest\n    reg [LOG_DEPTH-1:0] w_ptr_gray_stage1;\n    reg [LOG_DEPTH-1:0] w_ptr_gray_stage2;\n    reg [LOG_DEPTH-1:0] w_ptr_gray_stage3;\n    reg [LOG_DEPTH-1:0] w_ptr_gray_stage4;\n    \n    // Capture Read Pointer (Gray) from Source to Dest\n    reg [LOG_DEPTH-1:0] r_ptr_gray_stage1;\n    reg [LOG_DEPTH-1:0] r_ptr_gray_stage2;\n    reg [LOG_DEPTH-1:0] r_ptr_gray_stage3;\n    reg [LOG_DEPTH-1:0] r_ptr_gray_stage4;\n\n    // Capture Full/Empty flags from Source to Dest\n    reg                 full_stage1;\n    reg                 full_stage2;\n    reg                 full_stage3;\n    reg                 full_stage4;\n    \n    reg                 empty_stage1;\n    reg                 empty_stage2;\n    reg                 empty_stage3;\n    reg                 empty_stage4;\n\n    // --- CDC Flip-Flops for Pointers (Source -> Dest) ---\n    // Write Pointer\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni) begin\n            w_ptr_gray_stage1 <= {LOG_DEPTH{1'b0}};\n            w_ptr_gray_stage2 <= {LOG_DEPTH{1'b0}};\n            w_ptr_gray_stage3 <= {LOG_DEPTH{1'b0}};\n            w_ptr_gray_stage4 <= {LOG_DEPTH{1'b0}};\n        end else begin\n            w_ptr_gray_stage1 <= write_gray;\n            w_ptr_gray_stage2 <= w_ptr_gray_stage1;\n            w_ptr_gray_stage3 <= w_ptr_gray_stage2;\n            w_ptr_gray_stage4 <= w_ptr_gray_stage3;\n        end\n    end\n\n    // Read Pointer\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni) begin\n            r_ptr_gray_stage1 <= {LOG_DEPTH{1'b0}};\n            r_ptr_gray_stage2 <= {LOG_DEPTH{1'b0}};\n            r_ptr_gray_stage3 <= {LOG_DEPTH{1'b0}};\n            r_ptr_gray_stage4 <= {LOG_DEPTH{1'b0}};\n        end else begin\n            r_ptr_gray_stage1 <= read_gray;\n            r_ptr_gray_stage2 <= r_ptr_gray_stage1;\n            r_ptr_gray_stage3 <= r_ptr_gray_stage2;\n            r_ptr_gray_stage4 <= r_ptr_gray_stage3;\n        end\n    end\n\n    // --- CDC Flip-Flops for Status (Source -> Dest) ---\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni) begin\n            full_stage1 <= 1'b0;\n            full_stage2 <= 1'b0;\n            full_stage3 <= 1'b0;\n            full_stage4 <= 1'b0;\n            empty_stage1 <= 1'b1;\n            empty_stage2 <= 1'b1;\n            empty_stage3 <= 1'b1;\n            empty_stage4 <= 1'b1;\n        end else begin\n            full_stage1 <= full;\n            full_stage2 <= full_stage1;\n            full_stage3 <= full_stage2;\n            full_stage4 <= full_stage3;\n            empty_stage1 <= empty;\n            empty_stage2 <= empty_stage1;\n            empty_stage3 <= empty_stage2;\n            empty_stage4 <= empty_stage3;\n        end\n    end\n\n    // --- Gray to Binary Decoder for Captured Pointers ---\n    // We need to convert the captured Gray pointers back to binary to compare with local read_ptr\n    // and to determine the actual data to output.\n    // Since the pointers are captured with SYNC_STAGES, we use the final stage (stage4) for logic.\n    \n    // Helper function to convert Gray to Binary\n    // bin[0] = gray[0]\n    // bin[i] = gray[i] ^ bin[i-1]\n    \n    // Decode Write Pointer (Captured)\n    reg [LOG_DEPTH-1:0] w_ptr_bin;\n    always @(*) begin\n        w_ptr_bin = 0;\n        for (integer i = 0; i < LOG_DEPTH; i = i + 1) begin\n            if (i == 0)\n                w_ptr_bin[i] = w_ptr_gray_stage4[i];\n            else\n                w_ptr_bin[i] = w_ptr_gray_stage4[i] ^ w_ptr_bin[i-1];\n        end\n    end\n\n    // Decode Read Pointer (Captured)\n    reg [LOG_DEPTH-1:0] r_ptr_bin;\n    always @(*) begin\n        r_ptr_bin = 0;\n        for (integer i = 0; i < LOG_DEPTH; i = i + 1) begin\n            if (i == 0)\n                r_ptr_bin[i] = r_ptr_gray_stage4[i];\n            else\n                r_ptr_bin[i] = r_ptr_gray_stage4[i] ^ r_ptr_bin[i-1];\n        end\n    end\n\n    // --- Source Domain Logic ---\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni) begin\n            write_ptr <= {LOG_DEPTH{1'b0}};\n            read_ptr  <= {LOG_DEPTH{1'b0}};\n            full      <= 1'b0;\n            empty     <= 1'b1;\n            src_ready_o <= 1'b0;\n        end else begin\n            // Calculate Full/Empty\n            // Full: (write_ptr + 1) == read_ptr\n            // Empty: write_ptr == read_ptr\n            if (write_ptr == read_ptr)\n                empty <= 1'b1;\n            else\n                empty <= 1'b0;\n\n            if (write_ptr == (DEPTH - 1) && read_ptr == 0)\n                full <= 1'b1;\n            else if (write_ptr == (DEPTH - 1) && read_ptr == DEPTH - 1)\n                full <= 1'b0; // This case shouldn't happen if logic is correct, but for safety\n            else\n                full <= (write_ptr + 1) == read_ptr;\n\n            // Write Enable\n            write_en = src_valid_i && !full;\n            \n            // Update Pointers\n            if (write_en)\n                write_ptr <= write_ptr + 1;\n            \n            // Flow Control\n            src_ready_o = !full;\n        end\n    end\n\n    // --- Destination Domain Logic ---\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni) begin\n            dst_valid_o <= 1'b0;\n            dst_data_o  <= {WIDTH{1'b0}};\n            read_en     <= 1'b0;\n        end else begin\n            // Determine if we can read\n            // We can read if the captured write pointer is ahead of the captured read pointer\n            // AND the status flags indicate data is available.\n            // To handle the \"lag\" requirement: dst_valid_o may fall for one clock after accepted beat.\n            // This is naturally handled if we only assert valid when we are sure data is there.\n            // However, the prompt says: \"dst_valid_o may fall for one destination clock after an accepted beat even when another word is stored.\"\n            // This implies we should be greedy: if there is data, assert valid.\n            \n            // Check if data is available based on captured pointers\n            // Available if w_ptr_bin > r_ptr_bin\n            // But we must also respect the full/empty flags captured from source to avoid glitches\n            // during pointer transitions.\n            \n            // Logic: \n            // 1. If empty_captured is high, no data.\n            // 2. If full_captured is high, data is available (unless we are at the very edge of wrap around which full handles).\n            // 3. Pointer comparison: w_ptr_bin > r_ptr_bin.\n            \n            // A robust way to determine validity in the destination domain:\n            // valid = !empty_captured && (w_ptr_bin > r_ptr_bin)\n            // However, due to asynchronous nature, w_ptr_bin and r_ptr_bin might be momentarily inconsistent.\n            // Using the captured full/empty flags is usually safer for the \"ready\" signal, \n            // but for \"valid\", we rely on the pointer comparison.\n            \n            // Let's use the captured status flags to drive the enable, and pointer comparison to drive valid?\n            // No, standard design:\n            // dst_valid_o = !empty_captured && (w_ptr_bin > r_ptr_bin)\n            // But we need to ensure we don't output garbage when pointers are transitioning.\n            // The \"lag\" behavior mentioned suggests we should assert valid as soon as data is present.\n            \n            // Refined Logic:\n            // If the source says it's not empty (empty_captured == 0), and the captured write pointer\n            // is strictly greater than the captured read pointer, then data is valid.\n            \n            // To prevent metastability on the comparison result, we can add a small delay or \n            // rely on the fact that pointers only change by 1.\n            // Given SYNC_STAGES=2, the probability of mismatch is low, but we can add a safety check.\n            \n            // Let's implement the standard valid logic:\n            // valid = (!empty_captured) && (w_ptr_bin > r_ptr_bin)\n            // However, to strictly follow \"dst_valid_o may fall for one destination clock after an accepted beat\",\n            // we should assert valid whenever data is available.\n            \n            // One nuance: If w_ptr_bin == r_ptr_bin, it means empty.\n            // If w_ptr_bin > r_ptr_bin, it means full or partially full.\n            \n            // We will use the captured 'full' flag to gate the pointer comparison to avoid glitches\n            // when the FIFO transitions from empty to full or vice versa.\n            // Actually, the simplest robust method is:\n            // dst_valid_o = !empty_captured && (w_ptr_bin > r_ptr_bin);\n            // But we must ensure w_ptr_bin and r_ptr_bin are stable.\n            // With 4 stages, they are quite stable.\n            \n            // Let's add a small debounce or just rely on the logic.\n            // To handle the specific requirement about valid falling:\n            // We assert valid if data is present. If the source accepts a beat, it increments write_ptr.\n            // The destination sees the new write_ptr in the next cycle(s).\n            \n            // Implementation:\n            if (empty_stage4) begin\n                dst_valid_o <= 1'b0;\n                dst_data_o  <= {WIDTH{1'b0}};\n                read_en     <= 1'b0;\n            end else begin\n                // Check pointer difference\n                // Since we are in binary domain now (decoded from gray), we can compare directly.\n                // We need to be careful about the wrap-around.\n                // w_ptr_bin > r_ptr_bin covers all cases where data exists.\n                \n                // To be extra safe against transient glitches in the decoded pointers:\n                // We can check if the difference is at least 1.\n                // If w_ptr_bin > r_ptr_bin, then valid.\n                \n                // However, there is a known issue: if w_ptr_bin and r_ptr_bin are decoded from \n                // asynchronously captured gray codes, they might momentarily be equal when they shouldn't be,\n                // or one might be ahead.\n                // A common fix is to use the captured 'full' flag to inhibit valid when transitioning to empty.\n                \n                // Let's use a slightly more conservative valid logic to ensure stability:\n                // valid = (!empty_stage4) && (w_ptr_bin > r_ptr_bin)\n                // But we also need to consider the 'full' flag. If full_stage4 is 1, we definitely have data.\n                // If full_stage4 is 0, we might still have data if w_ptr > r_ptr.\n                \n                // Let's stick to the pointer comparison as the primary source of truth for 'valid',\n                // gated by !empty_stage4.\n                \n                if (w_ptr_bin > r_ptr_bin) begin\n                    dst_valid_o <= 1'b1;\n                    dst_data_o  <= data_mem[r_ptr_bin];\n                    read_en     <= 1'b1;\n                end else begin\n                    dst_valid_o <= 1'b0;\n                    dst_data_o  <= {WIDTH{1'b0}};\n                    read_en     <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // --- Read Pointer Update (Destination Domain) ---\n    always @(posedge dst_clk_i or posedge dst_rst_ni) begin\n        if (dst_rst_ni) begin\n            read_ptr <= {LOG_DEPTH{1'b0}};\n        end else begin\n            if (read_en)\n                read_ptr <= read_ptr + 1;\n        end\n    end\n\n    // --- Data Memory Write (Source Domain) ---\n    always @(posedge src_clk_i or posedge src_rst_ni) begin\n        if (src_rst_ni) begin\n            data_mem <= {DEPTH{1'b0}};\n        end else if (write_en) begin\n            data_mem[write_ptr] <= src_data_i;\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
