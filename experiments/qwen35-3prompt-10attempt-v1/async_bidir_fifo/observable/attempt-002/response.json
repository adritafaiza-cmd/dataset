  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  // Internal pointers and counters\n  reg [ASIZE-1:0] a_write_ptr;\n  reg [ASIZE-1:0] a_read_ptr;\n  reg [ASIZE-1:0] b_write_ptr;\n  reg [ASIZE-1:0] b_read_ptr;\n\n  // Gray code pointers for cross-domain signaling\n  reg [ASIZE-1:0] a_write_gray;\n  reg [ASIZE-1:0] a_read_gray;\n  reg [ASIZE-1:0] b_write_gray;\n  reg [ASIZE-1:0] b_read_gray;\n\n  // Status flags\n  reg a_full_int;\n  reg a_empty_int;\n  reg b_full_int;\n  reg b_empty_int;\n\n  // Acknowledged status (sampled across domains)\n  reg a_afull;\n  reg a_aempty;\n  reg b_afull;\n  reg b_aempty;\n\n  // Write data registers\n  reg [DSIZE-1:0] a_write_data_reg;\n  reg [DSIZE-1:0] b_write_data_reg;\n\n  // Read data registers\n  reg [DSIZE-1:0] a_read_data_reg;\n  reg [DSIZE-1:0] b_read_data_reg;\n\n  // Direction control\n  reg a_dir_reg;\n  reg b_dir_reg;\n\n  // Write enable signals (internal)\n  reg a_write_en;\n  reg b_write_en;\n\n  // Read enable signals (internal)\n  reg a_read_en;\n  reg b_read_en;\n\n  // Helper function to generate Gray code from binary\n  function [ASIZE-1:0] bin2gray;\n    input [ASIZE-1:0] bin;\n    begin\n      bin2gray = {bin[ASIZE-2:0], bin[ASIZE-1] ^ bin[ASIZE-2:0]};\n    end\n  endfunction\n\n  // Helper function to convert Gray code back to binary\n  function [ASIZE-1:0] gray2bin;\n    input [ASIZE-1:0] gray;\n    begin\n      gray2bin = gray;\n      for (integer i = ASIZE-2; i >= 0; i = i - 1) begin\n        gray2bin[i] = gray[i] ^ gray[i+1];\n      end\n    end\n  endfunction\n\n  // Write logic for Domain A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_write_ptr <= 0;\n      a_write_data_reg <= 0;\n      a_dir_reg <= 0;\n      a_write_en <= 0;\n    end else begin\n      if (a_winc) begin\n        a_write_ptr <= a_write_ptr + 1'b1;\n        a_write_data_reg <= a_wdata;\n        a_dir_reg <= a_dir;\n        a_write_en <= 1;\n      end else begin\n        a_write_en <= 0;\n      end\n    end\n  end\n\n  // Write logic for Domain B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_write_ptr <= 0;\n      b_write_data_reg <= 0;\n      b_dir_reg <= 0;\n      b_write_en <= 0;\n    end else begin\n      if (b_winc) begin\n        b_write_ptr <= b_write_ptr + 1'b1;\n        b_write_data_reg <= b_wdata;\n        b_dir_reg <= b_dir;\n        b_write_en <= 1;\n      end else begin\n        b_write_en <= 0;\n      end\n    end\n  end\n\n  // Read logic for Domain A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_read_ptr <= 0;\n      a_read_data_reg <= 0;\n      a_read_en <= 0;\n    end else begin\n      if (a_rinc) begin\n        a_read_ptr <= a_read_ptr + 1'b1;\n        a_read_en <= 1;\n      end else begin\n        a_read_en <= 0;\n      end\n    end\n  end\n\n  // Read logic for Domain B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_read_ptr <= 0;\n      b_read_data_reg <= 0;\n      b_read_en <= 0;\n    end else begin\n      if (b_rinc) begin\n        b_read_ptr <= b_read_ptr + 1'b1;\n        b_read_en <= 1;\n      end else begin\n        b_read_en <= 0;\n      end\n    end\n  end\n\n  // Cross-domain pointer updates (Gray code)\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_write_gray <= 0;\n      a_read_gray <= 0;\n    end else begin\n      a_write_gray <= bin2gray(a_write_ptr);\n      a_read_gray <= bin2gray(a_read_ptr);\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_write_gray <= 0;\n      b_read_gray <= 0;\n    end else begin\n      b_write_gray <= bin2gray(b_write_ptr);\n      b_read_gray <= bin2gray(b_read_ptr);\n    end\n  end\n\n  // Full/Empty logic for Domain A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_full_int <= 0;\n      a_empty_int <= 1;\n    end else begin\n      if (a_write_ptr == a_read_ptr) begin\n        a_empty_int <= 1;\n        a_full_int <= 0;\n      end else if (a_write_ptr == (a_read_ptr + 1'b1) - 1) begin\n        a_empty_int <= 0;\n        a_full_int <= 1;\n      end else begin\n        a_empty_int <= 0;\n        a_full_int <= 0;\n      end\n    end\n  end\n\n  // Full/Empty logic for Domain B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_full_int <= 0;\n      b_empty_int <= 1;\n    end else begin\n      if (b_write_ptr == b_read_ptr) begin\n        b_empty_int <= 1;\n        b_full_int <= 0;\n      end else if (b_write_ptr == (b_read_ptr + 1'b1) - 1) begin\n        b_empty_int <= 0;\n        b_full_int <= 1;\n      end else begin\n        b_empty_int <= 0;\n        b_full_int <= 0;\n      end\n    end\n  end\n\n  // Read data output logic for Domain A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_rdata <= 0;\n    end else begin\n      if (a_rinc) begin\n        // Sample the data from the write side of the other domain\n        if (a_dir) begin\n          // Reading from B's write side\n          a_rdata <= b_write_data_reg;\n        end else begin\n          // Reading from A's own write side\n          a_rdata <= a_write_data_reg;\n        end\n      end else begin\n        a_rdata <= a_rdata;\n      end\n    end\n  end\n\n  // Read data output logic for Domain B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_rdata <= 0;\n    end else begin\n      if (b_rinc) begin\n        // Sample the data from the write side of the other domain\n        if (b_dir) begin\n          // Reading from A's write side\n          b_rdata <= a_write_data_reg;\n        end else begin\n          // Reading from B's own write side\n          b_rdata <= b_write_data_reg;\n        end\n      end else begin\n        b_rdata <= b_rdata;\n      end\n    end\n  end\n\n  // Acknowledged status logic for Domain A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_afull <= 0;\n      a_aempty <= 1;\n    end else begin\n      if (FALLTHROUGH == \"TRUE\") begin\n        if (a_rinc) begin\n          if (a_dir) begin\n            // Reading from B's write side\n            if (b_write_gray == a_read_gray) begin\n              a_aempty <= 1;\n              a_afull <= 0;\n            end else if (b_write_gray == (a_read_gray + 1'b1) - 1) begin\n              a_aempty <= 0;\n              a_afull <= 1;\n            end else begin\n              a_aempty <= 0;\n              a_afull <= 0;\n            end\n          end else begin\n            // Reading from A's own write side\n            if (a_write_gray == a_read_gray) begin\n              a_aempty <= 1;\n              a_afull <= 0;\n            end else if (a_write_gray == (a_read_gray + 1'b1) - 1) begin\n              a_aempty <= 0;\n              a_afull <= 1;\n            end else begin\n              a_aempty <= 0;\n              a_afull <= 0;\n            end\n          end\n        end else begin\n          a_afull <= a_afull;\n          a_aempty <= a_aempty;\n        end\n      end else begin\n        // Combinational read not selected\n        a_afull <= a_full_int;\n        a_aempty <= a_empty_int;\n      end\n    end\n  end\n\n  // Acknowledged status logic for Domain B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_afull <= 0;\n      b_aempty <= 1;\n    end else begin\n      if (FALLTHROUGH == \"TRUE\") begin\n        if (b_rinc) begin\n          if (b_dir) begin\n            // Reading from A's write side\n            if (a_write_gray == b_read_gray) begin\n              b_aempty <= 1;\n              b_afull <= 0;\n            end else if (a_write_gray == (b_read_gray + 1'b1) - 1) begin\n              b_aempty <= 0;\n              b_afull <= 1;\n            end else begin\n              b_aempty <= 0;\n              b_afull <= 0;\n            end\n          end else begin\n            // Reading from B's own write side\n            if (b_write_gray == b_read_gray) begin\n              b_aempty <= 1;\n              b_afull <= 0;\n            end else if (b_write_gray == (b_read_gray + 1'b1) - 1) begin\n              b_aempty <= 0;\n              b_afull <= 1;\n            end else begin\n              b_aempty <= 0;\n              b_afull <= 0;\n            end\n          end\n        end else begin\n          b_afull <= b_afull;\n          b_aempty <= b_aempty;\n        end\n      end else begin\n        // Combinational read not selected\n        b_afull <= b_full_int;\n        b_aempty <= b_empty_int;\n      end\n    end\n  end\n\n  // Output full/empty signals (non-acknowledged)\n  assign a_full = a_full_int;\n  assign a_empty = a_empty_int;\n  assign b_full = b_full_int;\n  assign b_empty = b_empty_int;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
