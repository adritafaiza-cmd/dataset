  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule async_bidir_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"TRUE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir\n       );\n\n  localparam INT_ASIZE = ASIZE;\n  localparam INT_DEPTH = 1 << ASIZE;\n  localparam INT_MASK  = (1 << ASIZE) - 1;\n\n  // Cross-clock pointers\n  reg [INT_ASIZE-1:0] a_write_ptr;\n  reg [INT_ASIZE-1:0] a_read_ptr;\n  reg [INT_ASIZE-1:0] b_write_ptr;\n  reg [INT_ASIZE-1:0] b_read_ptr;\n\n  // Cross-clock data registers\n  reg [DSIZE-1:0] a_write_data_reg;\n  reg [DSIZE-1:0] b_write_data_reg;\n\n  // Cross-clock pointers for almost-full/almost-empty detection\n  // We use a separate pointer that lags by 1 to detect \"almost full/empty\"\n  // relative to the other side's view.\n  reg [INT_ASIZE-1:0] a_write_ptr_afull;\n  reg [INT_ASIZE-1:0] a_read_ptr_aempty;\n  reg [INT_ASIZE-1:0] b_write_ptr_afull;\n  reg [INT_ASIZE-1:0] b_read_ptr_aempty;\n\n  // Internal flags for almost-full/almost-empty logic\n  reg a_almost_full;\n  reg a_almost_empty;\n  reg b_almost_full;\n  reg b_almost_empty;\n\n  // Write enable signals derived from direction\n  wire a_write_en = (a_dir == 1'b1) ? a_winc : 1'b0;\n  wire b_write_en = (b_dir == 1'b1) ? b_winc : 1'b0;\n\n  // Read enable signals derived from direction\n  wire a_read_en = (a_dir == 1'b0) ? a_rinc : 1'b0;\n  wire b_read_en = (b_dir == 1'b0) ? b_rinc : 1'b0;\n\n  // Full/Empty logic based on pointer comparison\n  // Full: write_ptr == read_ptr + 1 (modulo depth)\n  // Empty: write_ptr == read_ptr\n  wire a_full_local = (a_write_ptr == (a_read_ptr + 1) & INT_MASK);\n  wire a_empty_local = (a_write_ptr == a_read_ptr);\n  wire b_full_local = (b_write_ptr == (b_read_ptr + 1) & INT_MASK);\n  wire b_empty_local = (b_write_ptr == b_read_ptr);\n\n  // Almost Full/Empty logic\n  // Almost Full: write_ptr == read_ptr + 2 (modulo depth)\n  // Almost Empty: write_ptr == read_ptr - 1 (modulo depth)\n  wire a_almost_full_local = (a_write_ptr == (a_read_ptr + 2) & INT_MASK);\n  wire a_almost_empty_local = (a_write_ptr == (a_read_ptr - 1 + INT_DEPTH) & INT_MASK);\n  wire b_almost_full_local = (b_write_ptr == (b_read_ptr + 2) & INT_MASK);\n  wire b_almost_empty_local = (b_write_ptr == (b_read_ptr - 1 + INT_DEPTH) & INT_MASK);\n\n  // Almost full/empty flags are sampled by the opposite side\n  // They are registered in the opposite clock domain to avoid metastability\n  // and to provide a stable signal for the other side.\n  reg a_afull_reg;\n  reg a_aempty_reg;\n  reg b_afull_reg;\n  reg b_aempty_reg;\n\n  // Data output registers\n  reg [DSIZE-1:0] a_rdata_reg;\n  reg [DSIZE-1:0] b_rdata_reg;\n\n  // Write pointer update logic (A side)\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_write_ptr <= 0;\n      a_read_ptr  <= 0;\n      a_write_data_reg <= 0;\n      a_write_ptr_afull <= 0;\n      a_read_ptr_aempty <= 0;\n    end else begin\n      if (a_write_en) begin\n        a_write_ptr <= a_write_ptr + 1;\n        a_write_ptr_afull <= a_write_ptr + 1; // Lagging pointer for almost-full\n        a_write_data_reg <= a_wdata;\n      end else begin\n        a_write_ptr_afull <= a_write_ptr;\n      end\n      if (a_read_en) begin\n        a_read_ptr <= a_read_ptr + 1;\n        a_read_ptr_aempty <= a_read_ptr + 1; // Lagging pointer for almost-empty\n      end else begin\n        a_read_ptr_aempty <= a_read_ptr;\n      end\n    end\n  end\n\n  // Write pointer update logic (B side)\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_write_ptr <= 0;\n      b_read_ptr  <= 0;\n      b_write_data_reg <= 0;\n      b_write_ptr_afull <= 0;\n      b_read_ptr_aempty <= 0;\n    end else begin\n      if (b_write_en) begin\n        b_write_ptr <= b_write_ptr + 1;\n        b_write_ptr_afull <= b_write_ptr + 1;\n        b_write_data_reg <= b_wdata;\n      end else begin\n        b_write_ptr_afull <= b_write_ptr;\n      end\n      if (b_read_en) begin\n        b_read_ptr <= b_read_ptr + 1;\n        b_read_ptr_aempty <= b_read_ptr + 1;\n      end else begin\n        b_read_ptr_aempty <= b_read_ptr;\n      end\n    end\n  end\n\n  // Almost full/empty flag generation (A side)\n  // These flags are generated in A clock domain but sampled in B clock domain\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_afull_reg <= 0;\n      a_aempty_reg <= 1;\n    end else begin\n      a_afull_reg <= a_almost_full_local;\n      a_aempty_reg <= a_almost_empty_local;\n    end\n  end\n\n  // Almost full/empty flag generation (B side)\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_afull_reg <= 0;\n      b_aempty_reg <= 1;\n    end else begin\n      b_afull_reg <= b_almost_full_local;\n      b_aempty_reg <= b_almost_empty_local;\n    end\n  end\n\n  // Read data output logic (A side)\n  // Data is read from the cross-clock register when a_read_en is asserted\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_rdata_reg <= 0;\n    end else if (a_read_en) begin\n      // Read data from the B-side write register\n      a_rdata_reg <= b_write_data_reg;\n    end\n  end\n\n  // Read data output logic (B side)\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_rdata_reg <= 0;\n    end else if (b_read_en) begin\n      // Read data from the A-side write register\n      b_rdata_reg <= a_write_data_reg;\n    end\n  end\n\n  // Output assignments\n  assign a_rdata = a_rdata_reg;\n  assign b_rdata = b_rdata_reg;\n\n  // Full/Empty flags (local to each side)\n  assign a_full = a_full_local;\n  assign a_empty = a_empty_local;\n  assign b_full = b_full_local;\n  assign b_empty = b_empty_local;\n\n  // Almost Full/Empty flags (cross-domain)\n  // These are sampled in the opposite clock domain\n  assign a_afull = a_afull_reg;\n  assign a_aempty = a_aempty_reg;\n  assign b_afull = b_afull_reg;\n  assign b_aempty = b_aempty_reg;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
