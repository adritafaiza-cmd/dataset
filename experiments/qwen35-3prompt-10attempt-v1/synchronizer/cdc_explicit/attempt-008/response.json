  "text": "module synchronizer #(\n    parameter STAGES = 2\n)(\n    input  clk,\n    input  rstn,\n    input  async_sig_i,\n    output sync_sig_o\n);\n\n    reg [STAGES-1:0] sync_pipe;\n\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn) begin\n            sync_pipe <= '{default: 1'b0};\n        end else begin\n            sync_pipe[0] <= async_sig_i;\n            for (integer i = 1; i < STAGES; i = i + 1) begin\n                sync_pipe[i] <= sync_pipe[i-1];\n            end\n        end\n    end\n\n    assign sync_sig_o = sync_pipe[STAGES-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
