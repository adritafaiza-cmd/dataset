  "text": "module synchronizer #(\n    parameter STAGES = 2\n)(\n    input  clk,\n    input  rstn,\n    input  async_sig_i,\n    output sync_sig_o\n);\n\n    // Internal signal to hold the synchronized value\n    reg sync_sig_i;\n\n    // Two-stage synchronizer chain for CDC compliance\n    // Stage 1\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn)\n            sync_sig_i <= 1'b0;\n        else\n            sync_sig_i <= async_sig_i;\n    end\n\n    // Stage 2\n    always @(posedge clk or negedge rstn) begin\n        if (!rstn)\n            sync_sig_o <= 1'b0;\n        else\n            sync_sig_o <= sync_sig_i;\n    end\n\nendmodule<|im_end|>\n<|endoftext|>",
