{
  "text": "module sync #(\n    parameter int unsigned STAGES = 2,\n    parameter bit ResetValue = 1'b0\n) (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic serial_i,\n    output logic serial_o\n);\n\n    // Internal clock for the destination domain (same as clk_i)\n    logic clk_int;\n    assign clk_int = clk_i;\n\n    // Internal reset for the destination domain\n    // We use a simple synchronizer for the reset signal to ensure RDC safety\n    // before distributing it to the pipeline stages.\n    logic rst_ni_synced;\n    logic rst_ni_synced_2;\n\n    // Reset Synchronizer (2-stage)\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            rst_ni_synced <= 1'b1;\n        else\n            rst_ni_synced <= rst_ni_synced_2;\n    end\n\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            rst_ni_synced_2 <= 1'b1;\n        else\n            rst_ni_synced_2 <= rst_ni_synced;\n    end\n\n    // Pipeline stages for data synchronization\n    // Each stage captures the data on the destination clock edge\n    genvar i;\n    logic [STAGES-1:0] sync_pipe;\n\n    generate\n        for (i = 0; i < STAGES; i = i + 1) begin : stage_gen\n            always_ff @(posedge clk_int or negedge rst_ni) begin\n                if (!rst_ni)\n                    sync_pipe[i] <= ResetValue;\n                else\n                    sync_pipe[i] <= sync_pipe[i-1];\n            end\n        end\n    endgenerate\n\n    // Assign output from the last stage\n    assign serial_o = sync_pipe[STAGES-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
