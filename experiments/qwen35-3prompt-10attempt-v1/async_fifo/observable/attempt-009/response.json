  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam ADDR_WIDTH = ASIZE;\n    localparam CAPACITY   = 1 << ASIZE;\n\n    // Write side registers (wclk domain)\n    reg [ADDR_WIDTH-1:0] wptr;\n    reg [ADDR_WIDTH-1:0] wptr_gray;\n    reg [ADDR_WIDTH-1:0] wptr_next;\n    reg [ADDR_WIDTH-1:0] wptr_next_gray;\n    reg                 wfull_reg;\n    reg                 wfull_next;\n\n    // Read side registers (rclk domain)\n    reg [ADDR_WIDTH-1:0] rptr;\n    reg [ADDR_WIDTH-1:0] rptr_gray;\n    reg [ADDR_WIDTH-1:0] rptr_next;\n    reg [ADDR_WIDTH-1:0] rptr_next_gray;\n    reg                 rempty_reg;\n    reg                 rempty_next;\n    reg [DSIZE-1:0]     rdata_reg;\n    reg [DSIZE-1:0]     rdata_next;\n\n    // Cross-domain pointers (stored in opposite domains)\n    wire [ADDR_WIDTH-1:0] wptr_gray_cross;\n    wire [ADDR_WIDTH-1:0] rptr_gray_cross;\n\n    // Write Pointer Logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr <= 1'b0;\n            wptr_gray <= 1'b0;\n            wfull_reg <= 1'b0;\n        end else begin\n            wptr <= wptr_next;\n            wptr_gray <= wptr_next_gray;\n            wfull_reg <= wfull_next;\n        end\n    end\n\n    // Write Pointer Next Logic\n    always @* begin\n        wptr_next = wptr;\n        wptr_next_gray = wptr_gray;\n        wfull_next = wfull_reg;\n\n        if (!wrst_n) begin\n            wptr_next = 1'b0;\n            wptr_next_gray = 1'b0;\n            wfull_next = 1'b0;\n        end else if (winc) begin\n            wptr_next = wptr + 1'b1;\n            // Gray code conversion for cross-domain pointer\n            wptr_next_gray = {wptr_next[ADDR_WIDTH-1], wptr_next[ADDR_WIDTH-1] ^ wptr_next[ADDR_WIDTH-2:0]};\n            \n            // Full detection: pointer wraps around\n            if (wptr == (CAPACITY - 1)) begin\n                wfull_next = 1'b1;\n            end\n        end\n    end\n\n    // Read Pointer Logic\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr <= 1'b0;\n            rptr_gray <= 1'b0;\n            rempty_reg <= 1'b1;\n            rdata_reg <= 1'b0;\n        end else begin\n            rptr <= rptr_next;\n            rptr_gray <= rptr_next_gray;\n            rempty_reg <= rempty_next;\n            rdata_reg <= rdata_next;\n        end\n    end\n\n    // Read Pointer Next Logic\n    always @* begin\n        rptr_next = rptr;\n        rptr_next_gray = rptr_gray;\n        rempty_next = rempty_reg;\n        rdata_next = rdata_reg;\n\n        if (!rrst_n) begin\n            rptr_next = 1'b0;\n            rptr_next_gray = 1'b0;\n            rempty_next = 1'b1;\n            rdata_next = 1'b0;\n        end else if (rinc) begin\n            rptr_next = rptr + 1'b1;\n            // Gray code conversion for cross-domain pointer\n            rptr_next_gray = {rptr_next[ADDR_WIDTH-1], rptr_next[ADDR_WIDTH-1] ^ rptr_next[ADDR_WIDTH-2:0]};\n            \n            // Empty detection: pointer wraps around\n            if (rptr == (CAPACITY - 1)) begin\n                rempty_next = 1'b1;\n            end\n        end\n    end\n\n    // Cross-domain pointer assignment\n    assign wptr_gray_cross = wptr_gray;\n    assign rptr_gray_cross = rptr_gray;\n\n    // Full Flag Logic (Read domain)\n    // Full when write pointer (gray) == read pointer (gray) + 1\n    // We need to compare wptr_gray_cross with rptr_gray + 1\n    wire [ADDR_WIDTH-1:0] rptr_plus_1;\n    assign rptr_plus_1 = rptr_gray + 1'b1;\n\n    always @* begin\n        wfull = 1'b0;\n        if (FALLTHROUGH == 1'b0) begin\n            // Combinational read path disabled, but full flag still needs to be accurate\n            // However, the problem states \"FALLTHROUGH does not select a combinational memory read.\"\n            // It doesn't explicitly say we can't use combinational logic for flags, \n            // but typically in strict async FIFOs, flags are derived from pointers.\n            // Let's assume standard pointer comparison for flags regardless of FALLTHROUGH setting\n            // regarding the memory read path.\n            if (wptr_gray_cross == rptr_plus_1) begin\n                wfull = 1'b1;\n            end\n        end else begin\n            // Even with fallthrough, the full flag logic remains based on pointers\n            if (wptr_gray_cross == rptr_plus_1) begin\n                wfull = 1'b1;\n            end\n        end\n    end\n\n    // Empty Flag Logic (Write domain)\n    // Empty when read pointer (gray) == write pointer (gray)\n    always @* begin\n        rempty = 1'b0;\n        if (rptr_gray_cross == wptr_gray) begin\n            rempty = 1'b1;\n        end\n    end\n\n    // Almost Full Flag (Write domain)\n    // Almost full when write pointer (gray) == read pointer (gray) - 1\n    wire [ADDR_WIDTH-1:0] rptr_minus_1;\n    assign rptr_minus_1 = rptr_gray - 1'b1;\n\n    always @* begin\n        awfull = 1'b0;\n        if (wptr_gray_cross == rptr_minus_1) begin\n            awfull = 1'b1;\n        end\n    end\n\n    // Almost Empty Flag (Read domain)\n    // Almost empty when read pointer (gray) == write pointer (gray) + 1\n    always @* begin\n        arempty = 1'b0;\n        if (rptr_gray_cross == wptr_plus_1) begin\n            arempty = 1'b1;\n        end\n    end\n    // Note: wptr_plus_1 needs to be defined for arempty logic\n    wire [ADDR_WIDTH-1:0] wptr_plus_1;\n    assign wptr_plus_1 = wptr_gray + 1'b1;\n    assign arempty = (rptr_gray_cross == wptr_plus_1) ? 1'b1 : 1'b0;\n\n    // Data Read Logic\n    // If FALLTHROUGH is enabled, we use a combinational memory read.\n    // If FALLTHROUGH is disabled, we must use the registered data path (rdata_reg).\n    // The problem states: \"FALLTHROUGH does not select a combinational memory read.\"\n    // This implies if FALLTHROUGH is TRUE, we DO select combinational.\n    // If FALSE, we use the registered path.\n    \n    // However, the prompt says \"FALLTHROUGH does not select a combinational memory read.\"\n    // This phrasing is slightly ambiguous. Usually \"Fallthrough\" means \"don't block, just read\".\n    // Let's interpret: \n    // If FALLTHROUGH == TRUE: Use combinational read (rdata = mem[rptr]).\n    // If FALLTHROUGH == FALSE: Use registered read (rdata = rdata_reg).\n    // BUT the prompt says: \"FALLTHROUGH does not select a combinational memory read.\"\n    // This might mean the parameter name \"FALLTHROUGH\" being TRUE means \"Do NOT use combinational\".\n    // Let's re-read carefully: \"support the fall-through option ... `FALLTHROUGH` does not select a combinational memory read.\"\n    // This sentence structure suggests: When the option is active (TRUE), it does NOT select combinational.\n    // So:\n    // FALLTHROUGH == TRUE -> Use Registered Read (rdata_reg)\n    // FALLTHROUGH == FALSE -> Use Combinational Read (mem[rptr])\n    \n    // Wait, standard terminology: \"Fallthrough\" usually means the read pointer doesn't wait for the write to acknowledge, \n    // allowing continuous reading. But here it seems to control the memory access method.\n    // Let's stick to the explicit instruction: \"FALLTHROUGH does not select a combinational memory read.\"\n    // This implies if FALLTHROUGH is TRUE, we avoid combinational read.\n    \n    // Let's define the memory array\n    reg [DSIZE-1:0] mem [0:CAPACITY-1];\n\n    // Write Memory Logic\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            // Clear memory on reset\n            for (integer i = 0; i < CAPACITY; i = i + 1) begin\n                mem[i] <= 1'b0;\n            end\n        end else if (winc && !wfull) begin\n            mem[wptr] <= wdata;\n        end\n    end\n\n    // Read Data Logic\n    always @* begin\n        rdata_next = rdata_reg;\n        \n        if (!rrst_n) begin\n            rdata_next = 1'b0;\n        end else if (rinc) begin\n            if (FALLTHROUGH == 1'b1) begin\n                // Fallthrough mode: Use registered data (as per \"does not select combinational\")\n                rdata_next = rdata_reg;\n            end else begin\n                // Non-fallthrough mode: Use combinational read\n                rdata_next = mem[rptr];\n            end\n        end\n    end\n\n    // Output assignments\n    assign awfull = awfull; // Already computed in combinational logic\n    assign arempty = arempty; // Already computed in combinational logic\n    assign wfull = wfull; // Already computed in combinational logic\n    assign rempty = rempty; // Already computed in combinational logic\n    assign rdata = rdata_next;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
