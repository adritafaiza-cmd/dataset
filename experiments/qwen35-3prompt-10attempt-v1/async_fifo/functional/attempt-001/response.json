  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule async_fifo\n    #(\n        parameter DSIZE = 8,\n        parameter ASIZE = 4,\n        parameter FALLTHROUGH = \"TRUE\"\n    )(\n        input  wire             wclk,\n        input  wire             wrst_n,\n        input  wire             winc,\n        input  wire [DSIZE-1:0] wdata,\n        output wire             wfull,\n        output wire             awfull,\n        input  wire             rclk,\n        input  wire             rrst_n,\n        input  wire             rinc,\n        output wire [DSIZE-1:0] rdata,\n        output wire             rempty,\n        output wire             arempty\n    );\n\n    localparam INT_ASIZE = ASIZE;\n    localparam INT_DEPTH = 1 << ASIZE;\n    localparam INT_MASK  = (1 << ASIZE) - 1;\n\n    // Write domain pointers\n    reg [INT_ASIZE-1:0] w_ptr;\n    reg [INT_ASIZE-1:0] w_full_ptr;\n\n    // Read domain pointers\n    reg [INT_ASIZE-1:0] r_ptr;\n    reg [INT_ASIZE-1:0] r_empty_ptr;\n\n    // FIFO Memory\n    reg [DSIZE-1:0] mem [INT_DEPTH-1:0];\n\n    // Cross-domain signals\n    wire [INT_ASIZE-1:0] w_ptr_gray;\n    wire [INT_ASIZE-1:0] r_ptr_gray;\n    wire [INT_ASIZE-1:0] w_full_ptr_gray;\n    wire [INT_ASIZE-1:0] r_empty_ptr_gray;\n\n    // --- Write Domain Logic ---\n\n    // Generate Gray code for write pointer\n    assign w_ptr_gray = w_ptr ^ (w_ptr >> 1);\n    assign w_full_ptr_gray = w_full_ptr ^ (w_full_ptr >> 1);\n\n    // Full detection: w_ptr == w_full_ptr\n    assign wfull = (w_ptr == w_full_ptr);\n\n    // Almost full detection: w_ptr + 1 == w_full_ptr (modulo depth)\n    // This is true if w_full_ptr is the next position after w_ptr\n    assign awfull = (w_full_ptr == (w_ptr + 1) - INT_DEPTH);\n\n    // Write process\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            w_ptr      <= 0;\n            w_full_ptr <= 0;\n        end else begin\n            if (winc && !wfull) begin\n                w_ptr <= w_ptr + 1;\n                mem[w_ptr] <= wdata;\n            end\n            // w_full_ptr only updates when we are NOT full\n            // If we are full, w_full_ptr stays where it is, effectively blocking writes\n            if (!wfull) begin\n                w_full_ptr <= w_full_ptr + 1;\n            end\n        end\n    end\n\n    // --- Read Domain Logic ---\n\n    // Generate Gray code for read pointers\n    assign r_ptr_gray = r_ptr ^ (r_ptr >> 1);\n    assign r_empty_ptr_gray = r_empty_ptr ^ (r_empty_ptr >> 1);\n\n    // Empty detection: r_ptr == r_empty_ptr\n    assign rempty = (r_ptr == r_empty_ptr);\n\n    // Almost empty detection: r_ptr + 1 == r_empty_ptr (modulo depth)\n    assign arempty = (r_empty_ptr == (r_ptr + 1) - INT_DEPTH);\n\n    // Read process\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            r_ptr      <= 0;\n            r_empty_ptr <= 0;\n        end else begin\n            if (rinc && !rempty) begin\n                r_ptr <= r_ptr + 1;\n            end\n            // r_empty_ptr only updates when we are NOT empty\n            if (!rempty) begin\n                r_empty_ptr <= r_empty_ptr + 1;\n            end\n        end\n    end\n\n    // Data Output Logic\n    // We need to read from memory using the read pointer.\n    // Since the read pointer is in the read domain and memory is in the write domain,\n    // we must use the Gray-coded version of the read pointer to index the memory.\n    // The memory is stable in the write domain, so reading it with a Gray code\n    // from the read domain works correctly for asynchronous FIFOs.\n\n    // Determine the address to read based on FALLTHROUGH\n    // If FALLTHROUGH is TRUE, we want the current oldest word (r_ptr).\n    // If FALLTHROUGH is FALSE, we want the word that will be read on the NEXT cycle\n    // (which is r_ptr + 1). However, the prompt says:\n    // \"When FALLTHROUGH equals \"TRUE\", rdata presents the current oldest unread word...\n    // Otherwise, rdata may be updated by an accepted read.\"\n    //\n    // Standard interpretation:\n    // FALLTHROUGH = TRUE: rdata = mem[r_ptr_gray] (Available immediately)\n    // FALLTHROUGH = FALSE: rdata = mem[(r_ptr + 1) gray] (Requires a read cycle to advance)\n    //\n    // Note: The prompt states \"rdata is one read-clock sample\".\n    // If FALLTHROUGH is FALSE, typically the data is valid only after a read occurs.\n    // But to satisfy \"presents the current oldest unread word\" for TRUE, and the alternative for FALSE:\n    //\n    // Case TRUE: Address = r_ptr\n    // Case FALSE: Address = r_ptr + 1 (This is the standard behavior where data is valid\n    //              only after the pointer has advanced, effectively requiring a read cycle).\n    //              However, some implementations hold the old data until the pointer moves.\n    //              Given the description \"rdata may be updated by an accepted read\" for FALSE,\n    //              it implies that without a read, rdata might be stale or undefined, OR\n    //              it implies the data available is the one *after* the current pointer.\n    //\n    // Let's implement the standard logic:\n    // If FALLTHROUGH: Read at r_ptr.\n    // If !FALLTHROUGH: Read at r_ptr + 1.\n    //\n    // We must handle the modulo arithmetic for the address calculation.\n\n    wire [INT_ASIZE-1:0] read_addr;\n\n    always @(*) begin\n        if (FALLTHROUGH) begin\n            read_addr = r_ptr;\n        end else begin\n            read_addr = (r_ptr + 1) - INT_DEPTH;\n        end\n    end\n\n    // Assign rdata from memory using the calculated address.\n    // We use the Gray code of the read pointer to index the memory array directly.\n    // The memory array is indexed by the write pointer (which is stable in write domain).\n    // The read pointer (r_ptr) is in the read domain.\n    // To access memory safely across domains, we use the Gray code of the read pointer.\n    // However, since we are calculating 'read_addr' based on r_ptr, we need to be careful.\n    // The standard technique is to index the memory with the Gray code of the read pointer.\n    // But here we have a specific address calculation.\n    //\n    // Correction on standard async FIFO implementation:\n    // The memory is indexed by the Gray code of the pointer.\n    // If we want to read at 'r_ptr', we use mem[r_ptr_gray].\n    // If we want to read at 'r_ptr + 1', we need the Gray code of (r_ptr + 1).\n    //\n    // Let's re-evaluate the address generation.\n    // We cannot simply do mem[read_addr_gray] if read_addr is a calculated value like r_ptr+1,\n    // because the Gray code of (A+1) is not (A_gray + 1).\n    //\n    // Approach:\n    // 1. Calculate the logical address (r_ptr or r_ptr+1).\n    // 2. Convert that logical address to Gray code to index the memory.\n    //\n    // Let's define the logical address first.\n    wire [INT_ASIZE-1:0] logical_addr;\n    assign logical_addr = (FALLTHROUGH) ? r_ptr : (r_ptr + 1 - INT_DEPTH);\n\n    // Now convert logical_addr to Gray code to index the memory.\n    wire [INT_ASIZE-1:0] addr_gray = logical_addr ^ (logical_addr >> 1);\n\n    assign rdata = mem[addr_gray];\n\n    // End of module\nendmodule\n```<|im_end|>\n<|endoftext|>",
