  "text": "module cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal registers for source domain\n  logic src_valid_reg;\n  logic src_data_reg [WIDTH-1:0];\n  logic src_valid_next;\n  logic src_data_next [WIDTH-1:0];\n\n  // Internal registers for destination domain\n  logic dst_valid_reg;\n  logic dst_data_reg [WIDTH-1:0];\n  logic dst_valid_next;\n  logic dst_data_next [WIDTH-1:0];\n\n  // Source Domain Logic\n  // Capture valid and data on rising edge of src_clk_i\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_reg <= 1'b0;\n      src_data_reg <= '{default: 1'b0};\n    end else begin\n      src_valid_reg <= src_valid_i;\n      src_data_reg <= src_data_i;\n    end\n  end\n\n  // Determine if we can accept a new item\n  // We can accept if the destination has not yet claimed the current item\n  // This is indicated by dst_valid_reg being low OR (dst_valid_reg high AND dst_ready_i high)\n  // However, to ensure safety with one outstanding item, we only accept if dst_valid_reg is low.\n  // If dst_valid_reg is high, the item is \"in flight\" and we must wait for it to be consumed.\n  logic src_ready_internal;\n  assign src_ready_internal = ~dst_valid_reg;\n\n  // Generate src_ready_o\n  // src_ready_o is high only when src_valid_reg is high AND we can accept a new item\n  // This ensures that the handshake completes atomically in the source domain\n  assign src_ready_o = src_valid_reg && src_ready_internal;\n\n  // Update next state for source domain\n  // If src_valid_i is high and src_ready_o is high, we keep the data valid for the next cycle\n  // Otherwise, we deassert valid\n  always_comb begin\n    src_valid_next = src_valid_reg && src_ready_internal;\n    src_data_next = src_data_reg;\n  end\n\n  // Destination Domain Logic\n  // Capture valid and data on rising edge of dst_clk_i\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_data_reg <= '{default: 1'b0};\n    end else begin\n      dst_valid_reg <= dst_valid_next;\n      dst_data_reg <= dst_data_next;\n    end\n  end\n\n  // Determine if we can send an item to the destination\n  // We can send if dst_valid_reg is low (idle) OR if dst_valid_reg is high and dst_ready_i is high\n  // This ensures that the handshake completes atomically in the destination domain\n  always_comb begin\n    dst_valid_next = dst_valid_reg || (dst_valid_reg && dst_ready_i);\n    dst_data_next = dst_data_reg;\n  end\n\n  // Generate dst_valid_o\n  // dst_valid_o is high only when dst_valid_reg is high AND dst_ready_i is high\n  // This ensures that the handshake completes atomically in the destination domain\n  assign dst_valid_o = dst_valid_reg && dst_ready_i;\n\n  // Generate dst_data_o\n  // dst_data_o is stable when dst_valid_o is high\n  assign dst_data_o = dst_valid_reg ? dst_data_reg : '{default: 1'b0};\n\nendmodule<|im_end|>\n<|endoftext|>",
