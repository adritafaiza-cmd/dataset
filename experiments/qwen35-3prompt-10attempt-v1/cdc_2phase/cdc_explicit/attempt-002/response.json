  "text": "module cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal registers for source domain\n  logic src_valid_reg;\n  logic src_data_reg [WIDTH-1:0];\n  logic src_valid_next;\n  logic src_data_next [WIDTH-1:0];\n\n  // Internal registers for destination domain\n  logic dst_valid_reg;\n  logic dst_data_reg [WIDTH-1:0];\n  logic dst_valid_next;\n  logic dst_data_next [WIDTH-1:0];\n\n  // ------------------------------------------------------------------\n  // Source Domain Logic\n  // ------------------------------------------------------------------\n  // Capture valid and data on rising edge of src_clk_i\n  // Reset is active-low, so we use !src_rst_ni as the enable condition\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_reg <= 1'b0;\n      src_data_reg <= '{default: 1'b0};\n    end else begin\n      src_valid_reg <= src_valid_i;\n      src_data_reg <= src_data_i;\n    end\n  end\n\n  // Determine if we can accept a new item\n  // We can accept if:\n  // 1. Current item is not yet transferred (src_valid_reg is high)\n  // 2. Destination is ready (dst_ready_i is high)\n  // Note: dst_ready_i is asynchronous, so we sample it directly here.\n  // This is safe because we only use it to gate the acceptance of a new item.\n  // The actual transfer happens on the next cycle when dst_valid is asserted.\n  assign src_ready_o = (src_valid_reg && dst_ready_i);\n\n  // Prepare next state for valid and data\n  // If we are ready to accept, we prepare the data for the next cycle\n  // However, we only update the register if we are accepting a new item\n  // But wait, the standard 2-phase handshake works as follows:\n  // 1. Source captures data.\n  // 2. Source checks dst_ready. If high, it asserts dst_valid_next.\n  // 3. Destination captures data and asserts dst_valid.\n  // 4. Destination checks src_ready. If high, it deasserts dst_valid.\n  // 5. Source sees dst_valid and deasserts src_valid (implicitly by not re-asserting or by explicit logic).\n  \n  // Let's refine the logic to ensure exactly one outstanding item.\n  // State machine approach:\n  // State IDLE: src_valid_reg = 0\n  // State BUSY: src_valid_reg = 1, waiting for dst_ready\n  \n  // Actually, the simplest 2-phase implementation:\n  // 1. Source captures data on src_clk.\n  // 2. Source asserts dst_valid_next if src_valid_reg is high AND dst_ready_i is high.\n  // 3. Destination captures dst_valid_next and dst_data_next on dst_clk.\n  // 4. Destination asserts dst_valid_reg if dst_valid_next is high.\n  // 5. Destination deasserts dst_valid_reg if dst_ready_i is high (and dst_valid_reg was high).\n  // 6. Source deasserts src_valid_reg if dst_valid_reg was high (on next src_clk).\n  \n  // Let's restructure for clarity and safety:\n  \n  // Source side:\n  // - Capture src_valid_i and src_data_i.\n  // - If src_valid_reg is high and dst_ready_i is high, set dst_valid_next = 1.\n  // - If dst_valid_reg was high (meaning we sent something last cycle), set src_valid_next = 0.\n  \n  // Destination side:\n  // - Capture dst_valid_next and dst_data_next.\n  // - If dst_valid_next is high, set dst_valid_reg = 1.\n  // - If dst_valid_reg is high and dst_ready_i is high, set dst_valid_next = 0.\n  \n  // This ensures:\n  // - Data is captured only when valid.\n  // - Valid is asserted only when ready.\n  // - No spurious transactions on reset.\n  \n  // Source Domain Next State Logic\n  always_comb begin\n    src_valid_next = 1'b0;\n    src_data_next = '{default: 1'b0};\n    \n    if (!src_rst_ni) begin\n      src_valid_next = 1'b0;\n      src_data_next = '{default: 1'b0};\n    end else begin\n      // If we have data and destination is ready, we are about to send it.\n      // We keep the data in the register until it is acknowledged.\n      // But we need to deassert src_valid_reg once the transaction is complete.\n      // The transaction is complete when dst_valid_reg becomes 0.\n      \n      // Logic:\n      // 1. If dst_valid_reg is high, it means we sent something last cycle.\n      //    So we should deassert src_valid_reg now.\n      // 2. If src_valid_reg is high and dst_ready_i is high, we assert dst_valid_next.\n      //    We do NOT update src_valid_reg here; it will be updated based on dst_valid_reg.\n      \n      if (dst_valid_reg) begin\n        // Transaction completed in previous cycle (from dest perspective)\n        // So we clear our valid flag\n        src_valid_next = 1'b0;\n        src_data_next = '{default: 1'b0};\n      end else if (src_valid_reg && dst_ready_i) begin\n        // We have data and dest is ready, so we prepare to send\n        // We keep the data in the register for the next cycle\n        src_valid_next = src_valid_reg;\n        src_data_next = src_data_reg;\n      end else begin\n        // Idle or waiting\n        src_valid_next = 1'b0;\n        src_data_next = '{default: 1'b0};\n      end\n    end\n  end\n\n  // Destination Domain Next State Logic\n  always_comb begin\n    dst_valid_next = 1'b0;\n    dst_data_next = '{default: 1'b0};\n    \n    if (!dst_rst_ni) begin\n      dst_valid_next = 1'b0;\n      dst_data_next = '{default: 1'b0};\n    end else begin\n      // If dst_valid_reg is high and dst_ready_i is high, we acknowledge the transfer\n      // by deasserting dst_valid_next (which will cause dst_valid_reg to go low next cycle)\n      if (dst_valid_reg && dst_ready_i) begin\n        dst_valid_next = 1'b0;\n        dst_data_next = '{default: 1'b0};\n      end else if (src_valid_reg) begin\n        // We have a new item coming from source\n        // We capture it and assert dst_valid_next\n        dst_valid_next = 1'b1;\n        dst_data_next = src_data_reg;\n      end else begin\n        // Idle\n        dst_valid_next = 1'b0;\n        dst_data_next = '{default: 1'b0};\n      end\n    end\n  end\n\n  // Source Domain Registers\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_reg <= 1'b0;\n      src_data_reg <= '{default: 1'b0};\n    end else begin\n      src_valid_reg <= src_valid_next;\n      src_data_reg <= src_data_next;\n    end\n  end\n\n  // Destination Domain Registers\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_data_reg <= '{default: 1'b0};\n    end else begin\n      dst_valid_reg <= dst_valid_next;\n      dst_data_reg <= dst_data_next;\n    end\n  end\n\n  // Output Assignments\n  assign src_ready_o = (src_valid_reg && dst_ready_i);\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule<|im_end|>\n<|endoftext|>",
