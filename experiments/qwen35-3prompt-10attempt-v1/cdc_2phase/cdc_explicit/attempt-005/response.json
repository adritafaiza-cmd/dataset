  "text": "module cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source Domain State Machine\n  // State: IDLE, WAIT_DST_READY\n  localparam IDLE = 0;\n  localparam WAIT_DST_READY = 1;\n\n  reg [1:0] src_state;\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_valid_reg;\n\n  // Destination Domain State Machine\n  // State: IDLE, WAIT_SRC_VALID\n  localparam DST_IDLE = 0;\n  localparam DST_WAIT_SRC_VALID = 1;\n\n  reg [1:0] dst_state;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n\n  // Synchronizers for asynchronous signals\n  // src_valid_i needs to be synchronized to dst_clk_i\n  reg [1:0] src_valid_sync;\n  // dst_ready_i needs to be synchronized to src_clk_i\n  reg [1:0] dst_ready_sync;\n\n  // ------------------------------------------------------------------\n  // Source Domain Logic\n  // ------------------------------------------------------------------\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state <= IDLE;\n      src_data_reg <= '0;\n      src_valid_reg <= 1'b0;\n      src_ready_o <= 1'b1;\n    end else begin\n      case (src_state)\n        IDLE: begin\n          if (src_valid_i) begin\n            src_data_reg <= src_data_i;\n            src_valid_reg <= 1'b1;\n            src_state <= WAIT_DST_READY;\n          end\n          src_ready_o <= 1'b1;\n        end\n        WAIT_DST_READY: begin\n          if (dst_ready_sync[1]) begin\n            src_state <= IDLE;\n            src_valid_reg <= 1'b0;\n            src_ready_o <= 1'b1;\n          end else begin\n            src_ready_o <= 1'b0;\n          end\n        end\n        default: begin\n          src_state <= IDLE;\n          src_ready_o <= 1'b1;\n        end\n      endcase\n    end\n  end\n\n  // ------------------------------------------------------------------\n  // Destination Domain Logic\n  // ------------------------------------------------------------------\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state <= DST_IDLE;\n      dst_data_reg <= '0;\n      dst_valid_reg <= 1'b0;\n      dst_valid_o <= 1'b0;\n    end else begin\n      case (dst_state)\n        DST_IDLE: begin\n          if (src_valid_sync[1]) begin\n            dst_data_reg <= src_data_reg;\n            dst_valid_reg <= 1'b1;\n            dst_state <= DST_WAIT_SRC_VALID;\n          end\n          dst_valid_o <= 1'b0;\n        end\n        DST_WAIT_SRC_VALID: begin\n          if (src_valid_sync[0]) begin\n            dst_state <= DST_IDLE;\n            dst_valid_reg <= 1'b0;\n            dst_valid_o <= 1'b0;\n          end else begin\n            dst_valid_o <= 1'b1;\n          end\n        end\n        default: begin\n          dst_state <= DST_IDLE;\n          dst_valid_o <= 1'b0;\n        end\n      endcase\n    end\n  end\n\n  // ------------------------------------------------------------------\n  // Synchronizers\n  // ------------------------------------------------------------------\n  // Synchronize src_valid_i to dst_clk_i (2-stage)\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      src_valid_sync <= 2'b00;\n    else\n      src_valid_sync <= {src_valid_sync[0], src_valid_i};\n  end\n\n  // Synchronize dst_ready_i to src_clk_i (2-stage)\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      dst_ready_sync <= 2'b00;\n    else\n      dst_ready_sync <= {dst_ready_sync[0], dst_ready_i};\n  end\n\nendmodule<|im_end|>\n<|endoftext|>",
