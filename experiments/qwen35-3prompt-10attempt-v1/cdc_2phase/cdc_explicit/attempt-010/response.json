  "text": "module cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Internal signals for CDC handshake\n  logic src_valid_reg;\n  logic dst_valid_reg;\n  logic dst_valid_ack;\n  logic dst_valid_next;\n  logic dst_data_reg;\n  logic dst_data_next;\n  logic dst_valid_stable;\n\n  // ------------------------------------------------------------------\n  // Source Domain: Capture valid and drive ready\n  // ------------------------------------------------------------------\n  // Capture src_valid_i on rising edge of src_clk_i\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni)\n      src_valid_reg <= 1'b0;\n    else\n      src_valid_reg <= src_valid_i;\n  end\n\n  // Drive src_ready_o based on destination status\n  // Ready is asserted only when:\n  // 1. No pending transfer in destination (dst_valid_reg is low)\n  // 2. Destination is ready (dst_ready_i is high)\n  // 3. Current captured valid is low (no item currently being transferred)\n  assign src_ready_o = (~dst_valid_reg) & dst_ready_i;\n\n  // ------------------------------------------------------------------\n  // Destination Domain: Capture data/valid and drive valid\n  // ------------------------------------------------------------------\n  // Capture src_valid_reg and src_data_reg on rising edge of dst_clk_i\n  // Note: We capture the source valid signal to know when to assert dst_valid_o\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_data_reg  <= {WIDTH{1'b0}};\n    end else begin\n      // Capture the source valid signal from the source domain\n      // This creates a safe crossing because we are sampling an external signal\n      // that is stable during the capture window (two-phase protocol ensures this)\n      dst_valid_reg <= src_valid_reg;\n      // Capture the source data when valid is high\n      dst_data_reg  <= (src_valid_reg) ? src_data_i : {WIDTH{1'b0}};\n    end\n  end\n\n  // Drive dst_valid_o based on destination status\n  // Valid is asserted only when:\n  // 1. Captured source valid is high\n  // 2. Destination is ready (dst_ready_i is high)\n  // 3. No pending transfer from previous cycle (dst_valid_reg was low before this cycle)\n  // This ensures we don't re-assert valid if we are already in a transfer\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      dst_valid_o <= 1'b0;\n    else begin\n      // Check if we have a new item to send\n      logic new_item = (src_valid_reg) & (~dst_valid_reg);\n      \n      if (new_item) begin\n        // New item arrived and no pending transfer\n        dst_valid_o <= 1'b1;\n      end else if (dst_valid_reg) begin\n        // We have a pending transfer, keep valid high until ready\n        dst_valid_o <= 1'b1;\n      end else begin\n        // No pending transfer and no new item\n        dst_valid_o <= 1'b0;\n      end\n    end\n  end\n\n  // Drive dst_data_o\n  // Data is stable when dst_valid_o is high\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni)\n      dst_data_o <= {WIDTH{1'b0}};\n    else if (dst_valid_o)\n      dst_data_o <= dst_data_reg;\n    else\n      dst_data_o <= {WIDTH{1'b0}};\n  end\n\nendmodule<|im_end|>\n<|endoftext|>",
