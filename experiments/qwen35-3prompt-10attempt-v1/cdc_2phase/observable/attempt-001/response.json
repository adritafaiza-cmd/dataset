  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source side: Capture valid/ready handshake and data\n  logic src_valid_reg;\n  logic src_ready_reg;\n  logic [WIDTH-1:0] src_data_reg;\n  logic src_valid_prev;\n  logic src_ready_prev;\n\n  // Destination side: Capture valid/ready handshake and data\n  logic dst_valid_reg;\n  logic dst_ready_reg;\n  logic [WIDTH-1:0] dst_data_reg;\n  logic dst_valid_prev;\n  logic dst_ready_prev;\n\n  // Two-phase handshake state machine for source side\n  // State 0: Idle\n  // State 1: Waiting for dst_ready (data latched, valid asserted)\n  logic [1:0] src_state;\n  localparam SRC_IDLE = 2'b00;\n  localparam SRC_WAIT = 2'b01;\n\n  // Two-phase handshake state machine for destination side\n  // State 0: Idle\n  // State 1: Waiting for src_valid (data latched, ready asserted)\n  logic [1:0] dst_state;\n  localparam DST_IDLE = 2'b00;\n  localparam DST_WAIT = 2'b01;\n\n  // Source logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n      src_data_reg  <= 1'b0;\n      src_state     <= SRC_IDLE;\n    end else begin\n      // Capture previous values for two-phase detection\n      src_valid_prev <= src_valid_reg;\n      src_ready_prev <= src_ready_reg;\n\n      case (src_state)\n        SRC_IDLE: begin\n          if (src_valid_i && dst_ready_reg) begin\n            src_valid_reg <= 1'b1;\n            src_data_reg  <= src_data_i;\n            src_state     <= SRC_WAIT;\n          end else begin\n            src_valid_reg <= 1'b0;\n            src_ready_reg <= 1'b1;\n          end\n        end\n        SRC_WAIT: begin\n          if (dst_ready_reg) begin\n            src_valid_reg <= 1'b0;\n            src_ready_reg <= 1'b1;\n            src_state     <= SRC_IDLE;\n          end else begin\n            src_valid_reg <= 1'b1;\n            src_ready_reg <= 1'b0;\n          end\n        end\n      endcase\n    end\n  end\n\n  // Destination logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b1;\n      dst_data_reg  <= 1'b0;\n      dst_state     <= DST_IDLE;\n    end else begin\n      // Capture previous values for two-phase detection\n      dst_valid_prev <= dst_valid_reg;\n      dst_ready_prev <= dst_ready_reg;\n\n      case (dst_state)\n        DST_IDLE: begin\n          if (src_valid_reg && dst_ready_i) begin\n            dst_valid_reg <= 1'b1;\n            dst_data_reg  <= src_data_reg;\n            dst_state     <= DST_WAIT;\n          end else begin\n            dst_valid_reg <= 1'b0;\n            dst_ready_reg <= 1'b1;\n          end\n        end\n        DST_WAIT: begin\n          if (src_valid_reg) begin\n            dst_valid_reg <= 1'b0;\n            dst_ready_reg <= 1'b0;\n            dst_state     <= DST_IDLE;\n          end else begin\n            dst_valid_reg <= 1'b1;\n            dst_ready_reg <= 1'b0;\n          end\n        end\n      endcase\n    end\n  end\n\n  // Output assignments\n  assign src_ready_o = src_ready_reg;\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_data_o  = dst_data_reg;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
