  "text": "module cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state machine\n  // State: IDLE or BUSY\n  localparam IDLE = 1'b0;\n  localparam BUSY = 1'b1;\n\n  reg src_state;\n  reg [WIDTH-1:0] src_data_reg;\n\n  // Destination domain state machine\n  // State: IDLE or BUSY\n  localparam DST_IDLE = 1'b0;\n  localparam DST_BUSY = 1'b1;\n\n  reg dst_state;\n  reg [WIDTH-1:0] dst_data_reg;\n\n  // ---------------------------------------------------------\n  // Source Domain Logic\n  // ---------------------------------------------------------\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state      <= IDLE;\n      src_data_reg   <= 0;\n      src_ready_o    <= 1'b1; // Ready by default when idle\n    end else begin\n      case (src_state)\n        IDLE: begin\n          if (src_valid_i) begin\n            src_state      <= BUSY;\n            src_data_reg   <= src_data_i;\n            src_ready_o    <= 1'b0; // Not ready until transfer completes\n          end else begin\n            src_ready_o    <= 1'b1; // Ready if valid is low\n          end\n        end\n        BUSY: begin\n          src_ready_o    <= 1'b1; // Ready to accept next item\n          // State remains BUSY until destination acknowledges\n        end\n      endcase\n    end\n  end\n\n  // ---------------------------------------------------------\n  // Destination Domain Logic\n  // ---------------------------------------------------------\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state       <= DST_IDLE;\n      dst_data_reg    <= 0;\n      dst_valid_o     <= 1'b0;\n    end else begin\n      case (dst_state)\n        DST_IDLE: begin\n          if (src_valid_i && src_ready_o) begin\n            dst_state       <= DST_BUSY;\n            dst_data_reg    <= src_data_reg;\n            dst_valid_o     <= 1'b1;\n          end else begin\n            dst_valid_o     <= 1'b0;\n          end\n        end\n        DST_BUSY: begin\n          if (dst_ready_i) begin\n            dst_state       <= DST_IDLE;\n            dst_valid_o     <= 1'b0;\n          end else begin\n            // Hold data and valid stable\n          end\n        end\n      endcase\n    end\n  end\n\nendmodule<|im_end|>\n<|endoftext|>",
