  "text": "module cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state machine\n  // States: IDLE, WAIT_DST_READY\n  localparam [1:0] IDLE = 2'b00;\n  localparam [1:0] WAIT_DST_READY = 2'b01;\n\n  reg [1:0] src_state;\n  reg [WIDTH-1:0] src_data_reg;\n  reg src_valid_reg;\n  reg src_ready_reg;\n\n  // Destination domain state machine\n  // States: IDLE, WAIT_SRC_VALID\n  localparam [1:0] DST_IDLE = 2'b00;\n  localparam [1:0] DST_WAIT_SRC_VALID = 2'b01;\n\n  reg [1:0] dst_state;\n  reg [WIDTH-1:0] dst_data_reg;\n  reg dst_valid_reg;\n  reg dst_ready_reg;\n\n  // Source Domain Logic\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state <= IDLE;\n      src_data_reg <= '0;\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n    end else begin\n      case (src_state)\n        IDLE: begin\n          if (src_valid_i) begin\n            src_data_reg <= src_data_i;\n            src_valid_reg <= 1'b1;\n            src_state <= WAIT_DST_READY;\n          end else begin\n            src_ready_reg <= 1'b1;\n          end\n        end\n        WAIT_DST_READY: begin\n          if (src_ready_i) begin\n            src_state <= IDLE;\n            src_valid_reg <= 1'b0;\n            src_ready_reg <= 1'b1;\n          end else begin\n            src_ready_reg <= 1'b0;\n          end\n        end\n        default: begin\n          src_state <= IDLE;\n          src_ready_reg <= 1'b1;\n        end\n      endcase\n    end\n  end\n\n  // Destination Domain Logic\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state <= DST_IDLE;\n      dst_data_reg <= '0;\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b1;\n    end else begin\n      case (dst_state)\n        DST_IDLE: begin\n          if (src_valid_reg) begin\n            dst_data_reg <= src_data_reg;\n            dst_valid_reg <= 1'b1;\n            dst_state <= DST_WAIT_SRC_VALID;\n          end else begin\n            dst_ready_reg <= 1'b1;\n          end\n        end\n        DST_WAIT_SRC_VALID: begin\n          if (dst_ready_i) begin\n            dst_state <= DST_IDLE;\n            dst_valid_reg <= 1'b0;\n            dst_ready_reg <= 1'b1;\n          end else begin\n            dst_ready_reg <= 1'b0;\n          end\n        end\n        default: begin\n          dst_state <= DST_IDLE;\n          dst_ready_reg <= 1'b1;\n        end\n      endcase\n    end\n  end\n\n  // Output Assignments\n  assign src_ready_o = src_ready_reg;\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule<|im_end|>\n<|endoftext|>",
