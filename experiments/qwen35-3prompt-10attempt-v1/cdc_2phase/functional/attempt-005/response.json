{
  "text": "module cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state\n  logic src_state_idle, src_state_busy;\n  logic src_data_reg;\n\n  // Destination domain state\n  logic dst_state_idle, dst_state_busy;\n  logic dst_data_reg;\n\n  // ------------------------------------------------------------------\n  // Source Domain Logic\n  // ------------------------------------------------------------------\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state_idle <= 1'b1;\n      src_state_busy <= 1'b0;\n      src_data_reg   <= 1'b0;\n    end else begin\n      if (src_state_idle) begin\n        src_state_idle <= 1'b0;\n        src_state_busy <= 1'b1;\n        src_data_reg   <= src_data_i;\n        src_ready_o    <= 1'b0; // Cannot accept new data while processing\n      end else if (src_state_busy) begin\n        src_state_idle <= 1'b1;\n        src_state_busy <= 1'b0;\n        src_data_reg   <= 1'b0;\n        src_ready_o    <= 1'b1; // Ready to accept next item\n      end\n    end\n  end\n\n  // ------------------------------------------------------------------\n  // Destination Domain Logic\n  // ------------------------------------------------------------------\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state_idle <= 1'b1;\n      dst_state_busy <= 1'b0;\n      dst_data_reg   <= 1'b0;\n      dst_valid_o    <= 1'b0;\n    end else begin\n      if (dst_state_idle) begin\n        dst_state_idle <= 1'b0;\n        dst_state_busy <= 1'b1;\n        dst_data_reg   <= src_data_reg;\n        dst_valid_o    <= 1'b1;\n      end else if (dst_state_busy) begin\n        dst_state_idle <= 1'b1;\n        dst_state_busy <= 1'b0;\n        dst_data_reg   <= 1'b0;\n        dst_valid_o    <= 1'b0;\n      end\n    end\n  end\n\n  // ------------------------------------------------------------------\n  // Handshake Logic\n  // ------------------------------------------------------------------\n  // Source ready is high only when in idle state\n  assign src_ready_o = src_state_idle;\n\n  // Destination data is stable when valid is high\n  assign dst_data_o = dst_data_reg;\n\nendmodule<|im_end|>\n<|endoftext|>",
