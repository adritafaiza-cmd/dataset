  "text": "```systemverilog\nmodule cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain state\n  logic src_state_idle, src_state_busy;\n  logic src_data_reg;\n  logic src_valid_reg;\n  logic src_ready_reg;\n\n  // Destination domain state\n  logic dst_state_idle, dst_state_busy;\n  logic dst_data_reg;\n  logic dst_valid_reg;\n  logic dst_ready_reg;\n\n  // Generate synchronous logic for source domain\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_state_idle <= 1'b1;\n      src_state_busy <= 1'b0;\n      src_data_reg <= '0;\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b1;\n    end else begin\n      src_state_idle <= ~src_state_busy;\n      src_state_busy <= ~src_state_idle;\n\n      if (src_state_idle) begin\n        src_data_reg <= src_data_i;\n        src_valid_reg <= src_valid_i;\n        src_ready_reg <= 1'b1;\n      end else begin\n        src_data_reg <= '0;\n        src_valid_reg <= 1'b0;\n        src_ready_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Generate synchronous logic for destination domain\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_state_idle <= 1'b1;\n      dst_state_busy <= 1'b0;\n      dst_data_reg <= '0;\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b1;\n    end else begin\n      dst_state_idle <= ~dst_state_busy;\n      dst_state_busy <= ~dst_state_idle;\n\n      if (dst_state_idle) begin\n        dst_data_reg <= src_data_reg;\n        dst_valid_reg <= src_valid_reg;\n        dst_ready_reg <= 1'b1;\n      end else begin\n        dst_data_reg <= '0;\n        dst_valid_reg <= 1'b0;\n        dst_ready_reg <= 1'b0;\n      end\n    end\n  end\n\n  // Assign output ports\n  assign src_ready_o = src_ready_reg;\n  assign dst_data_o = dst_data_reg;\n  assign dst_valid_o = dst_valid_reg;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
