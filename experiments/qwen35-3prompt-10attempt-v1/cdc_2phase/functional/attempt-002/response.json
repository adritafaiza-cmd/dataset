{
  "text": "module cdc_2phase #(\n  parameter WIDTH = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // Source domain signals\n  logic src_valid_reg;\n  logic src_ready_reg;\n  logic [WIDTH-1:0] src_data_reg;\n\n  // Destination domain signals\n  logic dst_valid_reg;\n  logic dst_ready_reg;\n  logic [WIDTH-1:0] dst_data_reg;\n\n  // Two-phase handshake logic\n  // Phase 1: Source captures data when valid and ready\n  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      src_valid_reg <= 1'b0;\n      src_ready_reg <= 1'b0;\n      src_data_reg  <= 1'b0;\n    end else begin\n      src_valid_reg <= src_valid_i;\n      src_ready_reg <= dst_ready_i;\n      src_data_reg  <= src_data_i;\n    end\n  end\n\n  // Phase 2: Destination captures data when valid and ready\n  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      dst_valid_reg <= 1'b0;\n      dst_ready_reg <= 1'b0;\n      dst_data_reg  <= 1'b0;\n    end else begin\n      dst_valid_reg <= src_valid_reg;\n      dst_ready_reg <= src_ready_reg;\n      dst_data_reg  <= src_data_reg;\n    end\n  end\n\n  // Output assignments\n  assign src_ready_o = src_ready_reg;\n  assign dst_valid_o = dst_valid_reg;\n  assign dst_data_o  = dst_data_reg;\n\nendmodule<|im_end|>\n<|endoftext|>",
