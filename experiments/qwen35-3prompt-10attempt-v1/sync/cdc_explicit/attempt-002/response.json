{
  "text": "module sync #(\n    parameter int unsigned STAGES = 2,\n    parameter bit ResetValue = 1'b0\n) (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic serial_i,\n    output logic serial_o\n);\n\n    // Internal clock for the destination domain (same as clk_i)\n    logic clk_int;\n    assign clk_int = clk_i;\n\n    // Internal reset for the destination domain\n    // We use a simple synchronizer for the reset signal to ensure RDC safety\n    // before distributing it to the pipeline stages.\n    logic rst_n_int;\n    logic rst_n_sync_1;\n    logic rst_n_sync_2;\n\n    // Reset Synchronizer (2-stage)\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            rst_n_sync_1 <= 1'b1;\n        else\n            rst_n_sync_1 <= rst_ni;\n    end\n\n    always_ff @(posedge clk_i or negedge rst_n_sync_1) begin\n        if (!rst_n_sync_1)\n            rst_n_sync_2 <= 1'b1;\n        else\n            rst_n_sync_2 <= rst_n_sync_1;\n    end\n\n    // Assign the synchronized reset to the pipeline\n    assign rst_n_int = rst_n_sync_2;\n\n    // Pipeline stages for data synchronization\n    // Using a register chain where each stage captures the previous output\n    // on the destination clock.\n    genvar i;\n    logic [STAGES-1:0] stage_reg;\n\n    // Initialize the first stage\n    always_ff @(posedge clk_int or negedge rst_n_int) begin\n        if (!rst_n_int)\n            stage_reg[0] <= ResetValue;\n        else\n            stage_reg[0] <= serial_i;\n    end\n\n    // Generate remaining stages\n    generate\n        for (i = 1; i < STAGES; i = i + 1) begin : stage_gen\n            always_ff @(posedge clk_int or negedge rst_n_int) begin\n                if (!rst_n_int)\n                    stage_reg[i] <= ResetValue;\n                else\n                    stage_reg[i] <= stage_reg[i-1];\n            end\n        end\n    endgenerate\n\n    // Output is the last stage of the pipeline\n    assign serial_o = stage_reg[STAGES-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
