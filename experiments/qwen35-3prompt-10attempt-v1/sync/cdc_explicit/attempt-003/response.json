{
  "text": "module sync #(\n    parameter int unsigned STAGES = 2,\n    parameter bit ResetValue = 1'b0\n) (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic serial_i,\n    output logic serial_o\n);\n\n    // Generate pipeline stages for CDC compliance\n    // Using a synchronous chain where each stage captures the previous stage's output\n    // on the destination clock. This ensures metastability is resolved before the next stage.\n    genvar i;\n    logic [STAGES-1:0] sync_chain;\n\n    // Initialize the first stage of the chain\n    // The first stage captures the asynchronous input serial_i\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            sync_chain[0] <= ResetValue;\n        else\n            sync_chain[0] <= serial_i;\n    end\n\n    // Generate remaining stages\n    generate\n        for (i = 1; i < STAGES; i = i + 1) begin : stage_gen\n            always_ff @(posedge clk_i or negedge rst_ni) begin\n                if (!rst_ni)\n                    sync_chain[i] <= ResetValue;\n                else\n                    sync_chain[i] <= sync_chain[i-1];\n            end\n        end\n    endgenerate\n\n    // Assign the final synchronized output\n    assign serial_o = sync_chain[STAGES-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
