{
  "text": "module rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    // Synchronization logic for the reset signal\n    // When test_mode_i is high, the reset is passed through directly.\n    // Otherwise, it is synchronized using a 2-stage synchronizer.\n    logic rst_sync_1;\n    logic rst_sync_2;\n\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            rst_sync_1 <= 1'b0;\n            rst_sync_2 <= 1'b0;\n        end else begin\n            rst_sync_1 <= rst_ni;\n            rst_sync_2 <= rst_sync_1;\n        end\n    end\n\n    // Generate the final synchronized reset output\n    // In test mode, bypass synchronization to avoid metastability during scan\n    assign rst_no = test_mode_i ? rst_ni : rst_sync_2;\n\n    // Generate the initialization qualifier\n    // This signal is active low and indicates the system is in the initial state\n    // immediately after reset release. It stays low for one clock cycle after\n    // rst_no goes high, then returns high.\n    logic rst_no_sync_1;\n    logic rst_no_sync_2;\n\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            rst_no_sync_1 <= 1'b0;\n            rst_no_sync_2 <= 1'b0;\n        end else begin\n            rst_no_sync_1 <= rst_no;\n            rst_no_sync_2 <= rst_no_sync_1;\n        end\n    end\n\n    // init_no is active low. It is asserted (0) when rst_no is high (reset released)\n    // and de-asserted (1) after one clock cycle.\n    // Logic: if rst_no is 1, init_no becomes 0. Else, init_no follows rst_no_sync_2.\n    // However, the requirement is a \"short initialization qualifier\".\n    // Standard behavior: init_no = 0 while rst_no == 1, then init_no = 1.\n    assign init_no = rst_no ? 1'b0 : rst_no_sync_2;\n\nendmodule<|im_end|>\n<|endoftext|>",
