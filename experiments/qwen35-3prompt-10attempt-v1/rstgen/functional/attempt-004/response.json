{
  "text": "module rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    logic rst_sync;\n    logic rst_sync_n;\n    logic init_pulse;\n\n    // Synchronize the active-low reset\n    always_ff @(posedge clk_i) begin\n        if (test_mode_i) begin\n            // Bypass synchronization for scan/test mode\n            rst_sync_n <= rst_ni;\n        end else begin\n            rst_sync_n <= rst_ni;\n        end\n    end\n\n    // Generate active-low synchronized reset\n    assign rst_no = rst_sync_n;\n\n    // Generate short initialization pulse after reset release\n    always_ff @(posedge clk_i) begin\n        if (test_mode_i) begin\n            // In test mode, init pulse is disabled or held low\n            init_pulse <= 1'b0;\n        end else begin\n            if (rst_sync_n) begin\n                // Reset has been released\n                init_pulse <= 1'b1;\n            end else begin\n                // Reset is active, hold init pulse low\n                init_pulse <= 1'b0;\n            end\n        end\n    end\n\n    // Output active-low init qualifier (low during init pulse)\n    assign init_no = ~init_pulse;\n\nendmodule<|im_end|>\n<|endoftext|>",
