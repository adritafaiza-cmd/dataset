{
  "text": "```systemverilog\nmodule rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    // Synchronized reset signal (active low)\n    logic rst_sync;\n\n    // Synchronization logic\n    // If test_mode_i is high, pass the raw reset directly.\n    // Otherwise, synchronize rst_ni to clk_i using a 2-stage synchronizer.\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            rst_sync <= 1'b1;\n        else if (test_mode_i)\n            rst_sync <= 1'b1;\n        else\n            rst_sync <= rst_sync;\n    end\n\n    // Generate the output reset (active low)\n    // Invert the synchronized signal to match active-low convention\n    assign rst_no = ~rst_sync;\n\n    // Generate the initialization qualifier (active low)\n    // This signal is asserted for one clock cycle after the reset is released.\n    // It helps distinguish between the reset state and the initial configuration state.\n    logic rst_sync_neg;\n    assign rst_sync_neg = ~rst_sync;\n\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            init_no <= 1'b1;\n        else if (rst_sync_neg)\n            init_no <= 1'b1;\n        else\n            init_no <= 1'b0;\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
