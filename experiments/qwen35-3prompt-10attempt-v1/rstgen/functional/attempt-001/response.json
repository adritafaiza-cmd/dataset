  "text": "module rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    logic rst_sync;\n    logic rst_sync_n;\n    logic init_sync;\n\n    // Synchronize the active-low reset input\n    always_ff @(posedge clk_i) begin\n        if (!test_mode_i) begin\n            rst_sync <= rst_ni;\n        end else begin\n            rst_sync <= 1'b1;\n        end\n    end\n\n    // Generate active-low synchronized reset\n    assign rst_no = rst_sync;\n\n    // Generate initialization qualifier (active-low)\n    // Asserted for 2 clock cycles after reset release\n    always_ff @(posedge clk_i) begin\n        if (!test_mode_i) begin\n            if (rst_sync) begin\n                init_sync <= 1'b1;\n            end else if (init_sync) begin\n                init_sync <= 1'b0;\n            end else begin\n                init_sync <= 1'b0;\n            end\n        end else begin\n            init_sync <= 1'b0;\n        end\n    end\n\n    assign init_no = init_sync;\n\nendmodule<|im_end|>\n<|endoftext|>",
