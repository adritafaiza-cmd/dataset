  "text": "module rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    // Synchronized reset output\n    logic rst_n_sync;\n\n    // Initialization qualifier output\n    logic init_n_sync;\n\n    // Internal state for initialization sequence\n    logic [1:0] init_state;\n\n    // State machine for initialization sequence\n    always_ff @(posedge clk_i or negedge rst_n_sync) begin\n        if (!rst_n_sync) begin\n            init_state <= 2'b00;\n        end else begin\n            case (init_state)\n                2'b00: begin\n                    if (test_mode_i)\n                        init_state <= 2'b01;\n                    else\n                        init_state <= 2'b00;\n                end\n                2'b01: begin\n                    if (test_mode_i)\n                        init_state <= 2'b01;\n                    else\n                        init_state <= 2'b10;\n                end\n                2'b10: begin\n                    if (test_mode_i)\n                        init_state <= 2'b01;\n                    else\n                        init_state <= 2'b00;\n                end\n                default:\n                    init_state <= 2'b00;\n            endcase\n        end\n    end\n\n    // Synchronize the active-low reset\n    always_ff @(posedge clk_i or negedge rst_n_sync) begin\n        if (!rst_n_sync)\n            rst_n_sync <= 1'b0;\n        else\n            rst_n_sync <= rst_ni;\n    end\n\n    // Generate synchronized reset output\n    assign rst_no = rst_n_sync;\n\n    // Generate initialization qualifier\n    assign init_no = (init_state == 2'b00) ? 1'b1 : 1'b0;\n\nendmodule<|im_end|>\n<|endoftext|>",
