{
  "text": "module rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    // Synchronized reset output (active-low)\n    // In test_mode, the raw reset is passed through directly to allow scan/test access.\n    // Otherwise, a 2-stage synchronizer ensures the reset is safe for CDC/RDC analysis.\n    logic rst_synced;\n\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            rst_synced <= 1'b1;\n        else if (test_mode_i)\n            rst_synced <= rst_ni;\n        else\n            rst_synced <= rst_synced;\n    end\n\n    assign rst_no = rst_synced;\n\n    // Initialization qualifier (active-low)\n    // Asserted briefly after the synchronized reset is released.\n    // This provides a clean window for logic initialization without violating CDC rules.\n    logic init_synced;\n    logic init_cnt;\n\n    // Two-stage synchronizer for the reset release event to ensure CDC safety\n    // before generating the init pulse.\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            init_synced <= 1'b1;\n        else if (test_mode_i)\n            init_synced <= rst_ni;\n        else\n            init_synced <= init_synced;\n    end\n\n    // Generate a short pulse when the synchronized reset goes low (active-low logic)\n    // Since rst_no is active-low, we look for the transition from 1 to 0.\n    // We use a counter that resets on the active reset and counts up after release.\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            init_cnt <= 0;\n        else if (test_mode_i)\n            init_cnt <= 0;\n        else\n            init_cnt <= init_cnt + 1'b1;\n    end\n\n    // init_no is asserted (low) for a short duration after reset release.\n    // The pulse width is determined by the counter.\n    // Assuming a 4-cycle pulse for initialization.\n    assign init_no = (init_cnt < 4) ? 1'b0 : 1'b1;\n\nendmodule<|im_end|>\n<|endoftext|>",
