{
  "text": "```systemverilog\nmodule rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    // Synchronized reset output\n    // In test_mode, the raw reset is passed through (bypassing sync logic)\n    // Otherwise, a 2-stage synchronizer is used to ensure CDC compliance\n    logic rst_n_sync;\n    logic rst_n_sync_2;\n\n    // Synchronizer chain for reset domain crossing\n    // This ensures that the asynchronous or multi-cycle reset is safely synchronized\n    // to the clk_i domain before being used as the system reset.\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            rst_n_sync <= 1'b1;\n        else\n            rst_n_sync <= rst_n_sync;\n    end\n\n    always_ff @(posedge clk_i or negedge rst_n_sync) begin\n        if (!rst_n_sync)\n            rst_n_sync_2 <= 1'b1;\n        else\n            rst_n_sync_2 <= rst_n_sync_2;\n    end\n\n    // Assign synchronized reset to output\n    // In test mode, we assume the input is already safe or we want to bypass\n    // the synchronization delay for scan/test purposes.\n    assign rst_no = test_mode_i ? rst_ni : rst_n_sync_2;\n\n    // Initialization qualifier (init_no)\n    // This signal is asserted for a short duration after the reset is released.\n    // It is generated based on the synchronized reset release.\n    // We use a counter or a simple delay mechanism relative to the reset release.\n    // Since no specific width is given, a simple 2-cycle pulse after reset release is standard.\n    \n    logic rst_n_sync_3; // Additional stage to detect the exact edge of reset release for init pulse\n    logic init_pulse;\n\n    // Detect reset release edge safely\n    // We need to detect when rst_n goes from 0 to 1 (active high) in the synchronized domain\n    // to trigger the init pulse.\n    \n    always_ff @(posedge clk_i or negedge rst_n_sync_2) begin\n        if (!rst_n_sync_2)\n            rst_n_sync_3 <= 1'b1;\n        else\n            rst_n_sync_3 <= rst_n_sync_2;\n    end\n\n    // Generate init pulse: asserted for 2 cycles after reset release\n    // Logic: If current cycle is reset released AND previous cycle was reset active, pulse.\n    // Then hold for one more cycle.\n    always_ff @(posedge clk_i or negedge rst_n_sync_2) begin\n        if (!rst_n_sync_2)\n            init_pulse <= 1'b0;\n        else if (rst_n_sync_2 && ~rst_n_sync_3)\n            init_pulse <= 1'b1;\n        else\n            init_pulse <= 1'b0;\n    end\n\n    // Extend the pulse to ensure it covers the transition and provides a stable window\n    // A common pattern is to assert for N cycles. Let's do 2 cycles for robustness.\n    logic init_pulse_2;\n    always_ff @(posedge clk_i or negedge rst_n_sync_2) begin\n        if (!rst_n_sync_2)\n            init_pulse_2 <= 1'b0;\n        else if (init_pulse)\n            init_pulse_2 <= 1'b1;\n        else\n            init_pulse_2 <= 1'b0;\n    end\n\n    assign init_no = test_mode_i ? 1'b1 : ~init_pulse_2;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
