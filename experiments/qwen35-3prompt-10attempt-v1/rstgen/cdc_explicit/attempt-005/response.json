  "text": "module rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    // Synchronized reset output (active-low)\n    // In test_mode, the input reset is passed through directly.\n    // Otherwise, it is synchronized using a 2-stage synchronizer.\n    logic rst_synced;\n\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            rst_synced <= 1'b1;\n        else if (test_mode_i)\n            rst_synced <= rst_ni;\n        else\n            rst_synced <= rst_synced;\n    end\n\n    assign rst_no = rst_synced;\n\n    // Initialization qualifier (active-low)\n    // Asserted briefly after reset release to indicate the system is coming out of reset.\n    // This is generated by a one-shot mechanism synchronized to the clock.\n    logic rst_synced_neg;\n    logic init_pulse;\n\n    // Generate a single-cycle pulse when rst_synced transitions from 1 to 0\n    // We use a register to detect the transition.\n    logic rst_synced_prev;\n\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            rst_synced_prev <= 1'b1;\n        else\n            rst_synced_prev <= rst_synced;\n    end\n\n    // Detect the falling edge of the synchronized reset (release of reset)\n    // Since rst_synced is active-high internally (1 = reset), we look for 1->0 transition.\n    // However, our rst_no is active-low. Let's re-align logic for clarity.\n    // Internal state: 1 = Reset Active, 0 = Reset Released.\n    // Transition we want: 1 -> 0 (Reset Release).\n    \n    // Re-evaluating the pulse generation based on rst_synced (1=Reset)\n    // We want init_no to be low (active) for one cycle when reset releases.\n    // So init_no should be !rst_synced_pulse.\n    \n    logic rst_released;\n    \n    // Simple edge detection for reset release\n    // rst_synced is 1 during reset, 0 after.\n    // We want a pulse when it goes 1->0.\n    logic rst_synced_edge;\n    \n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            rst_synced_edge <= 1'b0;\n        else if (rst_synced && !rst_synced_prev)\n            rst_synced_edge <= 1'b1;\n        else\n            rst_synced_edge <= 1'b0;\n    end\n\n    // One-shot to generate init_no\n    // init_no is active-low. It should be low for one clock cycle when rst_synced_edge is high.\n    logic init_pulse_int;\n    \n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            init_pulse_int <= 1'b1;\n        else if (rst_synced_edge)\n            init_pulse_int <= 1'b0;\n        else\n            init_pulse_int <= 1'b1;\n    end\n\n    assign init_no = init_pulse_int;\n\nendmodule<|im_end|>\n<|endoftext|>",
