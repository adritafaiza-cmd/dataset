{
  "text": "```systemverilog\nmodule rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    // Synchronized reset signal (active low)\n    logic rst_n_sync;\n    // Internal flag to track reset release state\n    logic rst_n_released;\n    // Internal flag to track initialization phase\n    logic init_done;\n\n    // Synchronize the active-low reset input\n    // Using a 2-stage synchronizer to ensure metastability is resolved\n    // before generating the synchronized reset output.\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            rst_n_sync <= 1'b1;\n        end else begin\n            rst_n_sync <= rst_n_sync;\n        end\n    end\n\n    // Generate synchronized reset output\n    // In test mode, the output follows the input directly (bypass)\n    // In normal mode, the output is the synchronized signal\n    assign rst_no = test_mode_i ? rst_ni : rst_n_sync;\n\n    // Logic to generate init_no\n    // init_no is active low during reset and for a short period after reset release\n    // It indicates the system is still in the initialization phase.\n    \n    // State machine to track reset release and initialization duration\n    // We use a counter or a delay mechanism. Since no specific width is given,\n    // we use a simple delay based on clock cycles.\n    // Let's define a constant for the initialization duration (e.g., 10 cycles)\n    localparam int INIT_DURATION = 10;\n    \n    logic [3:0] init_counter;\n    logic init_counter_en;\n\n    // Counter to measure time after reset release\n    always_ff @(posedge clk_i or negedge rst_n_sync) begin\n        if (!rst_n_sync) begin\n            init_counter <= 4'd0;\n            init_counter_en <= 1'b0;\n        end else begin\n            init_counter_en <= 1'b1;\n            if (init_counter_en) begin\n                if (init_counter < INIT_DURATION) begin\n                    init_counter <= init_counter + 1'b1;\n                end else begin\n                    init_counter <= 4'd0;\n                    init_counter_en <= 1'b0;\n                end\n            end\n        end\n    end\n\n    // Generate init_no\n    // Active low when reset is active OR when initialization is in progress\n    assign init_no = rst_n_sync || (init_counter_en && init_counter > 4'd0);\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
