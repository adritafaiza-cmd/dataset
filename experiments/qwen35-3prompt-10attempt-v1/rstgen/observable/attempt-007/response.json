  "text": "```systemverilog\nmodule rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    // Synchronize the asynchronous reset signal to the clk_i domain\n    // Using a 2-stage synchronizer to prevent metastability issues\n    logic rst_n_sync_1;\n    logic rst_n_sync_2;\n\n    // Synchronizer chain for rst_ni\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            rst_n_sync_1 <= 1'b1;\n        end else begin\n            rst_n_sync_1 <= rst_ni;\n        end\n    end\n\n    always_ff @(posedge clk_i or negedge rst_n_sync_1) begin\n        if (!rst_n_sync_1) begin\n            rst_n_sync_2 <= 1'b1;\n        end else begin\n            rst_n_sync_2 <= rst_n_sync_1;\n        end\n    end\n\n    // Generate the synchronized reset output\n    // If test_mode_i is high, bypass the synchronizer and use raw rst_ni directly\n    // Otherwise, use the synchronized version\n    assign rst_no = test_mode_i ? rst_ni : rst_n_sync_2;\n\n    // Generate the initialization indication\n    // init_no is active low, indicating the system is still initializing\n    // It stays low as long as the reset is active or during the first clock cycle after reset release\n    // This ensures all registers have settled before logic proceeds\n    always_ff @(posedge clk_i or negedge rst_n_sync_2) begin\n        if (!rst_n_sync_2) begin\n            init_no <= 1'b0;\n        end else begin\n            // Reset the init flag on the first clock edge after reset release\n            // This ensures a clean state transition\n            init_no <= 1'b0;\n        end\n    end\n\n    // Note: The above logic for init_no needs refinement to actually indicate \"initializing\" state properly.\n    // A common pattern is to keep init_no low during reset and for one cycle after reset release.\n    // However, the requirement asks for \"initialization indication\". \n    // Let's implement a standard pattern where init_no is low during reset and the first cycle after.\n    \n    // Re-implementing init_no logic for correct behavior:\n    // We need to detect the transition from reset to non-reset and assert init_no for one cycle.\n    // Actually, the prompt asks for \"initialization indication\". \n    // Typically, this means the signal is low while the system is initializing (during reset + 1 cycle).\n    \n    logic rst_n_sync_3; // Extra stage to detect edge if needed, but let's use a counter approach or edge detection\n    \n    // Simpler approach: \n    // If reset is active, init_no is 0.\n    // If reset just released, init_no is 0 for one cycle, then 1.\n    // But wait, the prompt says \"active-low reset and initialization indication\".\n    // Usually, init_no = 0 means \"initializing\", init_no = 1 means \"ready\".\n    // So during reset, init_no should be 0.\n    // After reset releases, we might want to keep it 0 for one cycle to ensure stability, then go to 1.\n    \n    // Let's use a simple state machine or edge detection on the synchronized reset.\n    // We will assert init_no (active low) when rst_n_sync_2 is low OR when rst_n_sync_2 transitions from 0 to 1.\n    \n    logic rst_n_sync_3;\n    \n    always_ff @(posedge clk_i or negedge rst_n_sync_2) begin\n        if (!rst_n_sync_2) begin\n            rst_n_sync_3 <= 1'b1;\n        end else begin\n            rst_n_sync_3 <= rst_n_sync_2;\n        end\n    end\n    \n    // Detect the rising edge of the active-high reset (falling edge of active-low reset)\n    // Actually, we want to know if we are in the \"initializing\" phase.\n    // Phase 1: Reset active -> init_no = 0\n    // Phase 2: Reset released, first clock cycle -> init_no = 0 (to allow setup)\n    // Phase 3: Subsequent cycles -> init_no = 1\n    \n    // Let's track the previous state of the synchronized reset\n    logic rst_n_sync_prev;\n    \n    always_ff @(posedge clk_i or negedge rst_n_sync_2) begin\n        if (!rst_n_sync_2) begin\n            rst_n_sync_prev <= 1'b1;\n        end else begin\n            rst_n_sync_prev <= rst_n_sync_2;\n        end\n    end\n    \n    // Logic for init_no:\n    // 0 if rst_n_sync_2 is low (reset active)\n    // 0 if rst_n_sync_2 is high AND rst_n_sync_prev was low (just released reset)\n    // 1 otherwise (system is stable)\n    assign init_no = (rst_n_sync_2 || ~rst_n_sync_prev) ? 1'b0 : 1'b1;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
