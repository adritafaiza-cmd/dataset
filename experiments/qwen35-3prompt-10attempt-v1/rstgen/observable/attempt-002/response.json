{
  "text": "```systemverilog\nmodule rstgen (\n    input  logic clk_i,\n    input  logic rst_ni,\n    input  logic test_mode_i,\n    output logic rst_no,\n    output logic init_no\n);\n\n    // Synchronize the asynchronous reset signal to the clk_i domain\n    // Using a 2-stage synchronizer to prevent metastability\n    logic rst_n_sync_1;\n    logic rst_n_sync_2;\n\n    always_ff @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            rst_n_sync_1 <= 1'b1;\n        end else begin\n            rst_n_sync_1 <= rst_n_sync_1;\n        end\n    end\n\n    always_ff @(posedge clk_i or negedge rst_n_sync_1) begin\n        if (!rst_n_sync_1) begin\n            rst_n_sync_2 <= 1'b1;\n        end else begin\n            rst_n_sync_2 <= rst_n_sync_2;\n        end\n    end\n\n    // Generate the synchronized reset\n    // If test_mode_i is high, bypass synchronization and pass rst_ni directly\n    // Otherwise, use the synchronized version\n    assign rst_no = test_mode_i ? rst_ni : rst_n_sync_2;\n\n    // Generate initialization indication\n    // init_no is active low when the system is in reset or transitioning out of reset\n    // It stays low until the reset is fully released and stable\n    assign init_no = rst_no;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
