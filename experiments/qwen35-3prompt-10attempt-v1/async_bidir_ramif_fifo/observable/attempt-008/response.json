  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  // Internal pointers and counters\n  reg [ASIZE-1:0] a_write_ptr, a_read_ptr;\n  reg [ASIZE-1:0] b_write_ptr, b_read_ptr;\n  \n  // Cross-domain pointers (snapshots)\n  reg [ASIZE-1:0] a_read_ptr_b, b_write_ptr_a;\n  reg [ASIZE-1:0] b_read_ptr_a, a_write_ptr_b;\n\n  // Status flags\n  reg a_full_int, a_empty_int;\n  reg b_full_int, b_empty_int;\n  reg a_full_sync, a_empty_sync;\n  reg b_full_sync, b_empty_sync;\n\n  // Direction control\n  reg a_dir_reg, b_dir_reg;\n\n  // RAM Interface Signals\n  wire [ASIZE-1:0] ram_addr_a, ram_addr_b;\n  wire [DSIZE-1:0] ram_wdata_a, ram_wdata_b;\n  wire ram_winc_a, ram_winc_b;\n  wire ram_rinc_a, ram_rinc_b;\n  wire [DSIZE-1:0] ram_rdata_a, ram_rdata_b;\n  wire ram_clk_a, ram_clk_b;\n\n  // Generate clock signals for RAM\n  assign o_ram_a_clk = ram_clk_a;\n  assign o_ram_b_clk = ram_clk_b;\n  assign o_ram_a_wdata = ram_wdata_a;\n  assign o_ram_b_wdata = ram_wdata_b;\n  assign o_ram_a_addr = ram_addr_a;\n  assign o_ram_b_addr = ram_addr_b;\n  assign o_ram_a_rinc = ram_rinc_a;\n  assign o_ram_b_rinc = ram_rinc_b;\n  assign o_ram_a_winc = ram_winc_a;\n  assign o_ram_b_winc = ram_winc_b;\n\n  // RAM Read Data Inputs\n  assign i_ram_a_rdata = ram_rdata_a;\n  assign i_ram_b_rdata = ram_rdata_b;\n\n  // Logic to determine direction and update pointers\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_write_ptr <= 0;\n      a_read_ptr  <= 0;\n      a_dir_reg   <= 0;\n    end else begin\n      a_write_ptr <= a_write_ptr;\n      a_read_ptr  <= a_read_ptr;\n      a_dir_reg   <= a_dir;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_write_ptr <= 0;\n      b_read_ptr  <= 0;\n      b_dir_reg   <= 0;\n    end else begin\n      b_write_ptr <= b_write_ptr;\n      b_read_ptr  <= b_read_ptr;\n      b_dir_reg   <= b_dir;\n    end\n  end\n\n  // Cross-domain pointer updates\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_write_ptr_a <= 0;\n      b_read_ptr_a  <= 0;\n    end else begin\n      if (b_rinc) b_read_ptr_a <= a_write_ptr;\n      else if (b_winc) b_write_ptr_a <= a_read_ptr;\n      else b_write_ptr_a <= b_write_ptr_a;\n      b_read_ptr_a <= b_read_ptr_a;\n    end\n  end\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_write_ptr_b <= 0;\n      a_read_ptr_b  <= 0;\n    end else begin\n      if (a_rinc) a_read_ptr_b <= b_write_ptr;\n      else if (a_winc) a_write_ptr_b <= b_read_ptr;\n      else a_write_ptr_b <= a_write_ptr_b;\n      a_read_ptr_b <= a_read_ptr_b;\n    end\n  end\n\n  // Full/Empty logic for Side A\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_full_int <= 0;\n      a_empty_int <= 1;\n    end else begin\n      if (a_dir_reg) begin\n        // Writing to A (reading from B)\n        if (a_write_ptr == a_read_ptr_b) a_full_int <= 1;\n        else if (a_write_ptr == a_read_ptr_b - 1) a_empty_int <= 1;\n        else begin\n          a_full_int <= 0;\n          a_empty_int <= 0;\n        end\n      end else begin\n        // Reading from A (writing to B)\n        if (a_read_ptr == a_write_ptr_b) a_empty_int <= 1;\n        else if (a_read_ptr == a_write_ptr_b - 1) a_full_int <= 1;\n        else begin\n          a_full_int <= 0;\n          a_empty_int <= 0;\n        end\n      end\n    end\n  end\n\n  // Full/Empty logic for Side B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_full_int <= 0;\n      b_empty_int <= 1;\n    end else begin\n      if (b_dir_reg) begin\n        // Writing to B (reading from A)\n        if (b_write_ptr == b_read_ptr_a) b_full_int <= 1;\n        else if (b_write_ptr == b_read_ptr_a - 1) b_empty_int <= 1;\n        else begin\n          b_full_int <= 0;\n          b_empty_int <= 0;\n        end\n      end else begin\n        // Reading from B (writing to A)\n        if (b_read_ptr == b_write_ptr_a) b_empty_int <= 1;\n        else if (b_read_ptr == b_write_ptr_a - 1) b_full_int <= 1;\n        else begin\n          b_full_int <= 0;\n          b_empty_int <= 0;\n        end\n      end\n    end\n  end\n\n  // Synchronize Full/Empty signals across clock domains\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_full_sync <= 0;\n      a_empty_sync <= 1;\n    end else begin\n      a_full_sync <= b_full_int;\n      a_empty_sync <= b_empty_int;\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_full_sync <= 0;\n      b_empty_sync <= 1;\n    end else begin\n      b_full_sync <= a_full_int;\n      b_empty_sync <= a_empty_int;\n    end\n  end\n\n  // Output assignments\n  assign a_full = a_full_sync;\n  assign a_empty = a_empty_sync;\n  assign b_full = b_full_sync;\n  assign b_empty = b_empty_sync;\n\n  assign a_afull = a_full_int;\n  assign a_aempty = a_empty_int;\n  assign b_afull = b_full_int;\n  assign b_aempty = b_empty_int;\n\n  // Read Data Outputs\n  assign a_rdata = (a_dir_reg) ? i_ram_a_rdata : 0;\n  assign b_rdata = (b_dir_reg) ? i_ram_b_rdata : 0;\n\n  // Write Data and Address Generation\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      ram_addr_a <= 0;\n      ram_wdata_a <= 0;\n      ram_winc_a <= 0;\n      ram_rinc_a <= 0;\n    end else begin\n      if (a_dir_reg) begin\n        // Writing to A (reading from B)\n        if (a_winc) begin\n          ram_addr_a <= a_write_ptr;\n          ram_wdata_a <= a_wdata;\n          ram_winc_a <= 1;\n          ram_rinc_a <= 0;\n        end else begin\n          ram_addr_a <= a_write_ptr;\n          ram_wdata_a <= 0;\n          ram_winc_a <= 0;\n          ram_rinc_a <= 0;\n        end\n      end else begin\n        // Reading from A (writing to B)\n        if (a_rinc) begin\n          ram_addr_a <= a_read_ptr;\n          ram_wdata_a <= 0;\n          ram_winc_a <= 0;\n          ram_rinc_a <= 1;\n        end else begin\n          ram_addr_a <= a_read_ptr;\n          ram_wdata_a <= 0;\n          ram_winc_a <= 0;\n          ram_rinc_a <= 0;\n        end\n      end\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      ram_addr_b <= 0;\n      ram_wdata_b <= 0;\n      ram_winc_b <= 0;\n      ram_rinc_b <= 0;\n    end else begin\n      if (b_dir_reg) begin\n        // Writing to B (reading from A)\n        if (b_winc) begin\n          ram_addr_b <= b_write_ptr;\n          ram_wdata_b <= b_wdata;\n          ram_winc_b <= 1;\n          ram_rinc_b <= 0;\n        end else begin\n          ram_addr_b <= b_write_ptr;\n          ram_wdata_b <= 0;\n          ram_winc_b <= 0;\n          ram_rinc_b <= 0;\n        end\n      end else begin\n        // Reading from B (writing to A)\n        if (b_rinc) begin\n          ram_addr_b <= b_read_ptr;\n          ram_wdata_b <= 0;\n          ram_winc_b <= 0;\n          ram_rinc_b <= 1;\n        end else begin\n          ram_addr_b <= b_read_ptr;\n          ram_wdata_b <= 0;\n          ram_winc_b <= 0;\n          ram_rinc_b <= 0;\n        end\n      end\n    end\n  end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
