  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  // Internal pointers and counters\n  reg [ASIZE-1:0] a_wptr, a_rptr;\n  reg [ASIZE-1:0] b_wptr, b_rptr;\n  \n  // Cross-domain pointers (snapshots)\n  reg [ASIZE-1:0] a_wptr_b, a_rptr_b;\n  reg [ASIZE-1:0] b_wptr_a, b_rptr_a;\n  \n  // Full/Empty flags (internal logic)\n  reg a_full_int, a_empty_int;\n  reg b_full_int, b_empty_int;\n  \n  // Cross-domain status flags (for full/empty indication)\n  reg a_full_b, a_empty_b;\n  reg b_full_a, b_empty_a;\n  \n  // Write enables for RAM\n  reg o_ram_a_winc, o_ram_b_winc;\n  reg o_ram_a_rinc, o_ram_b_rinc;\n  \n  // Write data muxing\n  reg [DSIZE-1:0] o_ram_a_wdata, o_ram_b_wdata;\n  \n  // Direction control\n  reg a_dir, b_dir;\n  \n  // Clock signals to RAM\n  reg o_ram_a_clk, o_ram_b_clk;\n\n  // Generate clock signals for RAM\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      o_ram_a_clk <= 1'b0;\n    else\n      o_ram_a_clk <= ~o_ram_a_clk;\n  end\n  \n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      o_ram_b_clk <= 1'b0;\n    else\n      o_ram_b_clk <= ~o_ram_b_clk;\n  end\n\n  // Direction registers\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_dir <= 1'b0;\n    else\n      a_dir <= a_dir; // Hold direction\n  end\n  \n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_dir <= 1'b0;\n    else\n      b_dir <= b_dir; // Hold direction\n  end\n\n  // Write pointer updates (local clocks)\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_wptr <= 4'd0;\n    else if (a_winc)\n      a_wptr <= a_wptr + 1;\n  end\n  \n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_wptr <= 4'd0;\n    else if (b_winc)\n      b_wptr <= b_wptr + 1;\n  end\n\n  // Read pointer updates (local clocks)\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_rptr <= 4'd0;\n    else if (a_rinc)\n      a_rptr <= a_rptr + 1;\n  end\n  \n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_rptr <= 4'd0;\n    else if (b_rinc)\n      b_rptr <= b_rptr + 1;\n  end\n\n  // Cross-domain pointer updates (on opposite clocks)\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      a_wptr_b <= 4'd0;\n    else\n      a_wptr_b <= a_wptr;\n  end\n  \n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      b_wptr_a <= 4'd0;\n    else\n      b_wptr_a <= b_wptr;\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      a_rptr_b <= 4'd0;\n    else\n      a_rptr_b <= a_rptr;\n  end\n  \n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      b_rptr_a <= 4'd0;\n    else\n      b_rptr_a <= b_rptr;\n  end\n\n  // Full/Empty logic (internal)\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_full_int <= 1'b0;\n      a_empty_int <= 1'b1;\n    end else begin\n      a_full_int <= (a_wptr == a_rptr) && (a_wptr != 4'd0);\n      a_empty_int <= (a_wptr == a_rptr);\n    end\n  end\n  \n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_full_int <= 1'b0;\n      b_empty_int <= 1'b1;\n    end else begin\n      b_full_int <= (b_wptr == b_rptr) && (b_wptr != 4'd0);\n      b_empty_int <= (b_wptr == b_rptr);\n    end\n  end\n\n  // Cross-domain full/empty flags (lagging)\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      a_full_b <= 1'b0;\n      a_empty_b <= 1'b1;\n    end else begin\n      a_full_b <= a_full_int;\n      a_empty_b <= a_empty_int;\n    end\n  end\n  \n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      b_full_a <= 1'b0;\n      b_empty_a <= 1'b1;\n    end else begin\n      b_full_a <= b_full_int;\n      b_empty_a <= b_empty_int;\n    end\n  end\n\n  // RAM Write Enable Logic\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      o_ram_a_winc <= 1'b0;\n      o_ram_a_rinc <= 1'b0;\n      o_ram_a_wdata <= 8'd0;\n    end else begin\n      // A side writes to RAM when a_winc is high\n      if (a_winc) begin\n        o_ram_a_winc <= 1'b1;\n        o_ram_a_rinc <= 1'b0;\n        o_ram_a_wdata <= a_wdata;\n      end else begin\n        o_ram_a_winc <= 1'b0;\n        o_ram_a_rinc <= 1'b0;\n        o_ram_a_wdata <= 8'd0;\n      end\n    end\n  end\n  \n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      o_ram_b_winc <= 1'b0;\n      o_ram_b_rinc <= 1'b0;\n      o_ram_b_wdata <= 8'd0;\n    end else begin\n      // B side writes to RAM when b_winc is high\n      if (b_winc) begin\n        o_ram_b_winc <= 1'b1;\n        o_ram_b_rinc <= 1'b0;\n        o_ram_b_wdata <= b_wdata;\n      end else begin\n        o_ram_b_winc <= 1'b0;\n        o_ram_b_rinc <= 1'b0;\n        o_ram_b_wdata <= 8'd0;\n      end\n    end\n  end\n\n  // RAM Read Enable Logic\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      o_ram_a_rinc <= 1'b0;\n    end else begin\n      // A side reads from RAM when a_rinc is high\n      if (a_rinc) begin\n        o_ram_a_rinc <= 1'b1;\n      end else begin\n        o_ram_a_rinc <= 1'b0;\n      end\n    end\n  end\n  \n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      o_ram_b_rinc <= 1'b0;\n    end else begin\n      // B side reads from RAM when b_rinc is high\n      if (b_rinc) begin\n        o_ram_b_rinc <= 1'b1;\n      end else begin\n        o_ram_b_rinc <= 1'b0;\n      end\n    end\n  end\n\n  // Address Generation\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      o_ram_a_addr <= 4'd0;\n    else if (a_winc)\n      o_ram_a_addr <= a_wptr;\n    else if (a_rinc)\n      o_ram_a_addr <= a_rptr;\n    else\n      o_ram_a_addr <= o_ram_a_addr;\n  end\n  \n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      o_ram_b_addr <= 4'd0;\n    else if (b_winc)\n      o_ram_b_addr <= b_wptr;\n    else if (b_rinc)\n      o_ram_b_addr <= b_rptr;\n    else\n      o_ram_b_addr <= o_ram_b_addr;\n  end\n\n  // Output Data Assignment\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_rdata <= 8'd0;\n    else\n      a_rdata <= i_ram_a_rdata;\n  end\n  \n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_rdata <= 8'd0;\n    else\n      b_rdata <= i_ram_b_rdata;\n  end\n\n  // Full/Empty Outputs\n  assign a_full = a_full_int;\n  assign a_afull = a_full_b;\n  assign a_empty = a_empty_int;\n  assign a_aempty = a_empty_b;\n  \n  assign b_full = b_full_int;\n  assign b_afull = b_full_a;\n  assign b_empty = b_empty_int;\n  assign b_aempty = b_empty_a;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
