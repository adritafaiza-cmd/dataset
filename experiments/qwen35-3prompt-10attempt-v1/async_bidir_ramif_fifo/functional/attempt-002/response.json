  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule async_bidir_ramif_fifo\n  #(\n    parameter DSIZE         = 8,\n    parameter ASIZE         = 4,\n    parameter FALLTHROUGH   = \"FALSE\"\n    ) (\n       input wire              a_clk,\n       input wire              a_rst_n,\n       input wire              a_winc,\n       input wire [DSIZE-1:0]  a_wdata,\n       input wire              a_rinc,\n       output wire [DSIZE-1:0] a_rdata,\n       output wire             a_full,\n       output wire             a_afull,\n       output wire             a_empty,\n       output wire             a_aempty,\n       input wire              a_dir,\n       input wire              b_clk,\n       input wire              b_rst_n,\n       input wire              b_winc,\n       input wire [DSIZE-1:0]  b_wdata,\n       input wire              b_rinc,\n       output wire [DSIZE-1:0] b_rdata,\n       output wire             b_full,\n       output wire             b_afull,\n       output wire             b_empty,\n       output wire             b_aempty,\n       input wire              b_dir,\n       output wire             o_ram_a_clk,\n       output wire [DSIZE-1:0] o_ram_a_wdata,\n       input wire [DSIZE-1:0]  i_ram_a_rdata,\n       output wire [ASIZE-1:0] o_ram_a_addr,\n       output wire             o_ram_a_rinc,\n       output wire             o_ram_a_winc,\n       output wire             o_ram_b_clk,\n       output wire [DSIZE-1:0] o_ram_b_wdata,\n       input wire [DSIZE-1:0]  i_ram_b_rdata,\n       output wire [ASIZE-1:0] o_ram_b_addr,\n       output wire             o_ram_b_rinc,\n       output wire             o_ram_b_winc\n       );\n\n  localparam LOG2_ASIZE = ASIZE;\n  localparam NUM_ENTRIES = 1 << ASIZE;\n\n  // Cross-clock pointers and counters\n  // Side A pointers (driven by a_clk)\n  reg [ASIZE-1:0] a_write_ptr;\n  reg [ASIZE-1:0] a_read_ptr;\n  reg [ASIZE-1:0] a_write_ptr_next;\n  reg [ASIZE-1:0] a_read_ptr_next;\n  reg [ASIZE-1:0] a_write_cnt;\n  reg [ASIZE-1:0] a_read_cnt;\n  reg [ASIZE-1:0] a_write_cnt_next;\n  reg [ASIZE-1:0] a_read_cnt_next;\n\n  // Side B pointers (driven by b_clk)\n  reg [ASIZE-1:0] b_write_ptr;\n  reg [ASIZE-1:0] b_read_ptr;\n  reg [ASIZE-1:0] b_write_ptr_next;\n  reg [ASIZE-1:0] b_read_ptr_next;\n  reg [ASIZE-1:0] b_write_cnt;\n  reg [ASIZE-1:0] b_read_cnt;\n  reg [ASIZE-1:0] b_write_cnt_next;\n  reg [ASIZE-1:0] b_read_cnt_next;\n\n  // Flags for full/empty detection (asynchronous)\n  reg a_full_flag;\n  reg a_empty_flag;\n  reg b_full_flag;\n  reg b_empty_flag;\n\n  // Internal state for fall-through logic\n  reg a_fallthrough;\n  reg b_fallthrough;\n\n  // --- Side A Logic (Clock: a_clk) ---\n\n  // Write Pointer Logic\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_write_ptr <= '0;\n    else if (a_winc)\n      a_write_ptr <= a_write_ptr + 1'b1;\n  end\n\n  // Read Pointer Logic\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_read_ptr <= '0;\n    else if (a_rinc)\n      a_read_ptr <= a_read_ptr + 1'b1;\n  end\n\n  // Write Count Logic (for full detection)\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_write_cnt <= '0;\n    else if (a_winc)\n      a_write_cnt <= a_write_cnt + 1'b1;\n    else if (a_rinc)\n      a_write_cnt <= a_write_cnt - 1'b1;\n  end\n\n  // Read Count Logic (for empty detection)\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_read_cnt <= '0;\n    else if (a_winc)\n      a_read_cnt <= a_read_cnt + 1'b1;\n    else if (a_rinc)\n      a_read_cnt <= a_read_cnt - 1'b1;\n  end\n\n  // Full Detection (Asynchronous)\n  // Full if write_cnt == NUM_ENTRIES - 1 (assuming no fallthrough)\n  // With fallthrough, full is when write_ptr == read_ptr and write_cnt == NUM_ENTRIES - 1\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_full_flag <= 1'b0;\n    else begin\n      if (FALLTHROUGH)\n        a_full_flag <= (a_write_ptr == a_read_ptr) && (a_write_cnt == (NUM_ENTRIES - 1));\n      else\n        a_full_flag <= (a_write_cnt == (NUM_ENTRIES - 1));\n    end\n  end\n\n  // Empty Detection (Asynchronous)\n  // Empty if read_cnt == 0\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_empty_flag <= 1'b1;\n    else\n      a_empty_flag <= (a_read_cnt == '0);\n  end\n\n  // Fall-through logic for Side A\n  // If full and we try to write, we fall through to the next slot (read_ptr)\n  // This is handled by the write pointer increment logic implicitly if we consider the physical RAM access\n  // However, the requirement says \"First-word fall-through\". \n  // In a standard async FIFO, if full, write is blocked. With fall-through, we write to (read_ptr + 1).\n  // We need to track if we are in fall-through mode.\n  // Actually, the standard way to implement fall-through in pointers is:\n  // If full and write enabled, write_ptr becomes read_ptr + 1.\n  // Let's refine the pointer logic to support fall-through explicitly.\n\n  // Re-evaluating Pointer Logic with Fall-through\n  // We need to know the current physical write address.\n  // If not full, write_addr = write_ptr.\n  // If full and fallthrough enabled, write_addr = read_ptr + 1.\n  \n  // Let's adjust the logic to generate the correct write address and handle the pointer updates correctly.\n  // The pointers a_write_ptr and a_read_ptr track the logical head and tail.\n  // The counters track the depth.\n  \n  // To implement fall-through correctly:\n  // When writing:\n  //   If not full: write_addr = a_write_ptr. Next write_ptr = a_write_ptr + 1.\n  //   If full: write_addr = a_read_ptr + 1. Next write_ptr = a_read_ptr + 1.\n  //   Note: In fall-through, the write pointer effectively jumps to the read pointer.\n  \n  // Let's restructure the A-side write pointer update to handle fall-through.\n  // We need a temporary variable for the next write address.\n  \n  reg [ASIZE-1:0] a_next_write_addr;\n  reg a_is_full_for_write;\n\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_next_write_addr <= '0;\n      a_is_full_for_write <= 1'b0;\n    end\n    else begin\n      // Determine if we are full\n      if (FALLTHROUGH)\n        a_is_full_for_write <= (a_write_ptr == a_read_ptr) && (a_write_cnt == (NUM_ENTRIES - 1));\n      else\n        a_is_full_for_write <= (a_write_cnt == (NUM_ENTRIES - 1));\n\n      if (a_is_full_for_write) begin\n        // Fall through: write to the slot after read_ptr\n        a_next_write_addr <= a_read_ptr + 1'b1;\n      end\n      else begin\n        // Normal write\n        a_next_write_addr <= a_write_ptr + 1'b1;\n      end\n    end\n  end\n\n  // Update a_write_ptr only if we are not in fall-through mode OR if we are in fall-through mode but the FIFO was not full before the write?\n  // Actually, in fall-through mode, the write pointer should advance to the new location.\n  // If we fall through, the new write_ptr becomes the old read_ptr + 1.\n  // If we don't fall through, the new write_ptr becomes old write_ptr + 1.\n  // The counter logic handles the depth correctly regardless.\n  \n  // Let's simplify: The physical write address is determined by the logic above.\n  // The logical write pointer (a_write_ptr) is updated as follows:\n  // If not full: a_write_ptr = a_write_ptr + 1.\n  // If full (and fallthrough): a_write_ptr = a_read_ptr + 1.\n  // If full (and no fallthrough): write is blocked (a_winc ignored).\n  \n  // Wait, the requirement says \"Drive o_ram_*...\". If write is blocked, we don't drive the RAM.\n  // So we need to know if the write is valid.\n  \n  reg a_write_valid;\n  \n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n)\n      a_write_valid <= 1'b0;\n    else begin\n      if (FALLTHROUGH)\n        a_write_valid <= (a_write_cnt < (NUM_ENTRIES - 1)) || (a_write_cnt == (NUM_ENTRIES - 1) && a_winc);\n      else\n        a_write_valid <= (a_write_cnt < (NUM_ENTRIES - 1));\n    end\n  end\n\n  // Update pointers based on validity\n  always @(posedge a_clk or negedge a_rst_n) begin\n    if (!a_rst_n) begin\n      a_write_ptr <= '0;\n      a_read_ptr <= '0;\n    end\n    else begin\n      if (a_winc) begin\n        if (FALLTHROUGH) begin\n          if (a_write_cnt == (NUM_ENTRIES - 1))\n            a_write_ptr <= a_read_ptr + 1'b1;\n          else\n            a_write_ptr <= a_write_ptr + 1'b1;\n        end\n        else begin\n          if (a_write_cnt < (NUM_ENTRIES - 1))\n            a_write_ptr <= a_write_ptr + 1'b1;\n          // else blocked\n        end\n      end\n      if (a_rinc)\n        a_read_ptr <= a_read_ptr + 1'b1;\n    end\n  end\n\n  // --- Side B Logic (Clock: b_clk) ---\n  // Mirror of Side A\n\n  reg [ASIZE-1:0] b_next_write_addr;\n  reg b_is_full_for_write_b;\n  reg b_write_valid_b;\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_next_write_addr <= '0;\n      b_is_full_for_write_b <= 1'b0;\n    end\n    else begin\n      if (FALLTHROUGH)\n        b_is_full_for_write_b <= (b_write_ptr == b_read_ptr) && (b_write_cnt == (NUM_ENTRIES - 1));\n      else\n        b_is_full_for_write_b <= (b_write_cnt == (NUM_ENTRIES - 1));\n\n      if (b_is_full_for_write_b) begin\n        b_next_write_addr <= b_read_ptr + 1'b1;\n      end\n      else begin\n        b_next_write_addr <= b_write_ptr + 1'b1;\n      end\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_write_valid_b <= 1'b0;\n    else begin\n      if (FALLTHROUGH)\n        b_write_valid_b <= (b_write_cnt < (NUM_ENTRIES - 1)) || (b_write_cnt == (NUM_ENTRIES - 1) && b_winc);\n      else\n        b_write_valid_b <= (b_write_cnt < (NUM_ENTRIES - 1));\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n) begin\n      b_write_ptr <= '0;\n      b_read_ptr <= '0;\n    end\n    else begin\n      if (b_winc) begin\n        if (FALLTHROUGH) begin\n          if (b_write_cnt == (NUM_ENTRIES - 1))\n            b_write_ptr <= b_read_ptr + 1'b1;\n          else\n            b_write_ptr <= b_write_ptr + 1'b1;\n        end\n        else begin\n          if (b_write_cnt < (NUM_ENTRIES - 1))\n            b_write_ptr <= b_write_ptr + 1'b1;\n        end\n      end\n      if (b_rinc)\n        b_read_ptr <= b_read_ptr + 1'b1;\n    end\n  end\n\n  // Full/Empty Flags for Side B\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_full_flag <= 1'b0;\n    else begin\n      if (FALLTHROUGH)\n        b_full_flag <= (b_write_ptr == b_read_ptr) && (b_write_cnt == (NUM_ENTRIES - 1));\n      else\n        b_full_flag <= (b_write_cnt == (NUM_ENTRIES - 1));\n    end\n  end\n\n  always @(posedge b_clk or negedge b_rst_n) begin\n    if (!b_rst_n)\n      b_empty_flag <= 1'b1;\n    else\n      b_empty_flag <= (b_read_cnt == '0);\n  end\n\n  // --- Output Generation ---\n\n  // Side A Outputs\n  o_ram_a_clk <= a_clk;\n  o_ram_a_wdata <= a_wdata;\n  o_ram_a_addr <= a_next_write_addr;\n  o_ram_a_winc <= a_winc && a_write_valid;\n  o_ram_a_rinc <= a_rinc;\n  \n  // Read data for Side A comes from the external RAM input\n  a_rdata <= i_ram_a_rdata;\n  \n  a_full <= a_full_flag;\n  a_afull <= a_full_flag; // Asynchronous full flag is the same as the internal flag derived from cross-clock pointers\n  a_empty <= a_empty_flag;\n  a_aempty <= a_empty_flag;\n\n  // Side B Outputs\n  o_ram_b_clk <= b_clk;\n  o_ram_b_wdata <= b_wdata;\n  o_ram_b_addr <= b_next_write_addr;\n  o_ram_b_winc <= b_winc && b_write_valid_b;\n  o_ram_b_rinc <= b_rinc;\n\n  // Read data for Side B comes from the external RAM input\n  b_rdata <= i_ram_b_rdata;\n\n  b_full <= b_full_flag;\n  b_afull <= b_full_flag;\n  b_empty <= b_empty_flag;\n  b_aempty <= b_empty_flag;\n\n  // Note: The problem statement mentions \"Pointers in both directions cross as acknowledged binary snapshots\".\n  // This implies that the full/empty flags are generated based on the pointers seen by the respective clock domains.\n  // Since we are generating the flags inside the respective clock domains using the counters which are updated in those domains,\n  // the flags are inherently asynchronous to the other domain's view of the data, but synchronous to the generating domain.\n  // The \"lag\" mentioned in the prompt is a characteristic of asynchronous FIFOs where the flag is valid only when the pointer is stable.\n  // Our implementation follows standard async FIFO flag generation logic.\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
