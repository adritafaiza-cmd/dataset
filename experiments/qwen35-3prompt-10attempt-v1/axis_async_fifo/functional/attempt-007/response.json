  "text": "```verilog\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam LOG2_DEPTH = $clog2(DEPTH);\n    localparam KEEP_WIDTH_LOG = $clog2(KEEP_WIDTH);\n    localparam ID_WIDTH_LOG = $clog2(ID_WIDTH);\n    localparam DEST_WIDTH_LOG = $clog2(DEST_WIDTH);\n    localparam USER_WIDTH_LOG = $clog2(USER_WIDTH);\n\n    // Internal data width including sidebands\n    localparam AXIS_TDATA_WIDTH = DATA_WIDTH + (KEEP_ENABLE ? KEEP_WIDTH : 0) + \n                                  (LAST_ENABLE ? 1 : 0) + \n                                  (ID_ENABLE ? ID_WIDTH : 0) + \n                                  (DEST_ENABLE ? DEST_WIDTH : 0) + \n                                  (USER_ENABLE ? USER_WIDTH : 0);\n\n    // Calculate actual depth based on pipeline stages\n    localparam ACTUAL_DEPTH = (RAM_PIPELINE == 1) ? DEPTH : (DEPTH >> 1);\n    localparam LOG2_ACTUAL_DEPTH = $clog2(ACTUAL_DEPTH);\n\n    // Internal registers for pointers\n    reg [LOG2_ACTUAL_DEPTH-1:0] s_write_ptr;\n    reg [LOG2_ACTUAL_DEPTH-1:0] s_read_ptr;\n    reg [LOG2_ACTUAL_DEPTH-1:0] m_write_ptr;\n    reg [LOG2_ACTUAL_DEPTH-1:0] m_read_ptr;\n\n    // Internal status registers\n    reg s_status_empty;\n    reg s_status_full;\n    reg s_status_overflow;\n    reg s_status_bad_frame;\n    reg s_status_good_frame;\n    reg m_status_empty;\n    reg m_status_full;\n    reg m_status_overflow;\n    reg m_status_bad_frame;\n    reg m_status_good_frame;\n\n    // Internal data storage\n    reg [AXIS_TDATA_WIDTH-1:0] s_fifo_data [0:ACTUAL_DEPTH-1];\n    reg [AXIS_TDATA_WIDTH-1:0] m_fifo_data [0:ACTUAL_DEPTH-1];\n\n    // Control signals\n    wire s_fifo_empty;\n    wire s_fifo_full;\n    wire m_fifo_empty;\n    wire m_fifo_full;\n\n    // Generate empty/full signals\n    assign s_fifo_empty = (s_write_ptr == s_read_ptr);\n    assign s_fifo_full = (s_write_ptr == (s_read_ptr + LOG2_ACTUAL_DEPTH)) || \n                         (s_write_ptr == (s_read_ptr + LOG2_ACTUAL_DEPTH - 1) && DROP_WHEN_FULL);\n    assign m_fifo_empty = (m_write_ptr == m_read_ptr);\n    assign m_fifo_full = (m_write_ptr == (m_read_ptr + LOG2_ACTUAL_DEPTH)) || \n                         (m_write_ptr == (m_read_ptr + LOG2_ACTUAL_DEPTH - 1) && DROP_WHEN_FULL);\n\n    // Clock domain crossing logic for pointers\n    // S-domain to M-domain pointer crossing\n    wire s_ptr_valid;\n    wire s_ptr_data;\n    wire s_ptr_ack;\n    \n    // M-domain to S-domain pointer crossing\n    wire m_ptr_valid;\n    wire m_ptr_data;\n    wire m_ptr_ack;\n\n    // Simple pointer crossing logic\n    // S-domain writes to M-domain when s_write_ptr changes\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_write_ptr <= '0;\n            s_status_empty <= 1;\n            s_status_full <= 0;\n            s_status_overflow <= 0;\n            s_status_bad_frame <= 0;\n            s_status_good_frame <= 0;\n        end else begin\n            s_write_ptr <= s_write_ptr;\n            s_status_empty <= s_fifo_empty;\n            s_status_full <= s_fifo_full;\n            s_status_overflow <= 0;\n            s_status_bad_frame <= 0;\n            s_status_good_frame <= 0;\n        end\n    end\n\n    // M-domain writes to S-domain when m_write_ptr changes\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_write_ptr <= '0;\n            m_status_empty <= 1;\n            m_status_full <= 0;\n            m_status_overflow <= 0;\n            m_status_bad_frame <= 0;\n            m_status_good_frame <= 0;\n        end else begin\n            m_write_ptr <= m_write_ptr;\n            m_status_empty <= m_fifo_empty;\n            m_status_full <= m_fifo_full;\n            m_status_overflow <= 0;\n            m_status_bad_frame <= 0;\n            m_status_good_frame <= 0;\n        end\n    end\n\n    // S-domain logic\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_fifo_data <= '0;\n            s_axis_tready <= 0;\n            s_pause_ack <= 0;\n        end else begin\n            if (s_axis_tvalid && m_axis_tready && !s_fifo_full) begin\n                s_fifo_data[s_write_ptr] <= {s_axis_tdata, s_axis_tkeep, s_axis_tlast, \n                                             s_axis_tid, s_axis_tdest, s_axis_tuser};\n                s_write_ptr <= s_write_ptr + 1;\n                s_axis_tready <= 1;\n                s_pause_ack <= 0;\n            end else if (s_axis_tvalid && m_axis_tready && s_fifo_full) begin\n                if (DROP_WHEN_FULL) begin\n                    s_axis_tready <= 1;\n                    s_pause_ack <= 0;\n                end else begin\n                    s_axis_tready <= 0;\n                    s_pause_ack <= 0;\n                end\n            end else begin\n                s_axis_tready <= 0;\n                s_pause_ack <= 0;\n            end\n        end\n    end\n\n    // M-domain logic\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_fifo_data <= '0;\n            m_axis_tvalid <= 0;\n            m_axis_tlast <= 0;\n            m_axis_tid <= '0;\n            m_axis_tdest <= '0;\n            m_axis_tuser <= '0;\n            m_axis_tkeep <= '0;\n            m_axis_tdata <= '0;\n            m_pause_ack <= 0;\n        end else begin\n            if (m_fifo_empty && m_axis_tready) begin\n                m_axis_tvalid <= 1;\n                m_axis_tdata <= m_fifo_data[m_read_ptr][DATA_WIDTH-1:0];\n                m_axis_tkeep <= m_fifo_data[m_read_ptr][DATA_WIDTH+KEEP_WIDTH-1:DATA_WIDTH];\n                m_axis_tlast <= m_fifo_data[m_read_ptr][DATA_WIDTH+KEEP_WIDTH];\n                m_axis_tid <= m_fifo_data[m_read_ptr][DATA_WIDTH+KEEP_WIDTH+1:DATA_WIDTH+KEEP_WIDTH+ID_WIDTH];\n                m_axis_tdest <= m_fifo_data[m_read_ptr][DATA_WIDTH+KEEP_WIDTH+ID_WIDTH+1:DATA_WIDTH+KEEP_WIDTH+ID_WIDTH+DEST_WIDTH];\n                m_axis_tuser <= m_fifo_data[m_read_ptr][DATA_WIDTH+KEEP_WIDTH+ID_WIDTH+DEST_WIDTH+1:DATA_WIDTH+KEEP_WIDTH+ID_WIDTH+DEST_WIDTH+USER_WIDTH];\n                m_read_ptr <= m_read_ptr + 1;\n                m_pause_ack <= 0;\n            end else if (m_fifo_empty && !m_axis_tready) begin\n                m_axis_tvalid <= 0;\n                m_axis_tlast <= 0;\n                m_axis_tid <= '0;\n                m_axis_tdest <= '0;\n                m_axis_tuser <= '0;\n                m_axis_tkeep <= '0;\n                m_axis_tdata <= '0;\n                m_pause_ack <= 0;\n            end else begin\n                m_axis_tvalid <= 0;\n                m_axis_tlast <= 0;\n                m_axis_tid <= '0;\n                m_axis_tdest <= '0;\n                m_axis_tuser <= '0;\n                m_axis_tkeep <= '0;\n                m_axis_tdata <= '0;\n                m_pause_ack <= 0;\n            end\n        end\n    end\n\n    // Status outputs\n    assign s_status_depth = s_write_ptr;\n    assign s_status_depth_commit = s_read_ptr;\n    assign s_status_overflow = 0;\n    assign s_status_bad_frame = 0;\n    assign s_status_good_frame = 0;\n\n    assign m_status_depth = m_write_ptr;\n    assign m_status_depth_commit = m_read_ptr;\n    assign m_status_overflow = 0;\n    assign m_status_bad_frame = 0;\n    assign m_status_good_frame = 0;\n\n    // Pause logic\n    assign s_pause_ack = 0;\n    assign m_pause_ack = 0;\n\nendmodule\n```<|im_end|>\n<|endoftext|