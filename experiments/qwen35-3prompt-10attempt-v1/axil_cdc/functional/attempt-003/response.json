  "text": "```verilog\nmodule axil_cdc #\n(\n    parameter DATA_WIDTH = 32,\n    parameter ADDR_WIDTH = 32,\n    parameter STRB_WIDTH = (DATA_WIDTH/8)\n)\n(\n    /*\n     * AXI lite slave interface\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_awaddr,\n    input  wire [2:0]             s_axil_awprot,\n    input  wire                   s_axil_awvalid,\n    output wire                   s_axil_awready,\n    input  wire [DATA_WIDTH-1:0]  s_axil_wdata,\n    input  wire [STRB_WIDTH-1:0]  s_axil_wstrb,\n    input  wire                   s_axil_wvalid,\n    output wire                   s_axil_wready,\n    output wire [1:0]             s_axil_bresp,\n    output wire                   s_axil_bvalid,\n    input  wire                   s_axil_bready,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_araddr,\n    input  wire [2:0]             s_axil_arprot,\n    input  wire                   s_axil_arvalid,\n    output wire                   s_axil_arready,\n    output wire [DATA_WIDTH-1:0]  s_axil_rdata,\n    output wire [1:0]             s_axil_rresp,\n    output wire                   s_axil_rvalid,\n    input  wire                   s_axil_rready,\n    /*\n     * AXI lite master interface\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [ADDR_WIDTH-1:0]  m_axil_awaddr,\n    output wire [2:0]             m_axil_awprot,\n    output wire                   m_axil_awvalid,\n    input  wire                   m_axil_awready,\n    output wire [DATA_WIDTH-1:0]  m_axil_wdata,\n    output wire [STRB_WIDTH-1:0]  m_axil_wstrb,\n    output wire                   m_axil_wvalid,\n    input  wire                   m_axil_wready,\n    input  wire [1:0]             m_axil_bresp,\n    input  wire                   m_axil_bvalid,\n    output wire                   m_axil_bready,\n    output wire [ADDR_WIDTH-1:0]  m_axil_araddr,\n    output wire [2:0]             m_axil_arprot,\n    output wire                   m_axil_arvalid,\n    input  wire                   m_axil_arready,\n    input  wire [DATA_WIDTH-1:0]  m_axil_rdata,\n    input  wire [1:0]             m_axil_rresp,\n    input  wire                   m_axil_rvalid,\n    output wire                   m_axil_rready\n);\n\n    // ------------------------------------------------------------------\n    // Internal Signals\n    // ------------------------------------------------------------------\n    wire s_aw_valid, s_w_valid, s_b_valid, s_ar_valid, s_r_valid;\n    wire s_aw_ready, s_w_ready, s_b_ready, s_ar_ready, s_r_ready;\n    wire m_aw_valid, m_w_valid, m_b_valid, m_ar_valid, m_r_valid;\n    wire m_aw_ready, m_w_ready, m_b_ready, m_ar_ready, m_r_ready;\n\n    // State Registers for Write Channel (Slave -> Master)\n    reg s_aw_state, s_w_state, s_b_state;\n    reg [ADDR_WIDTH-1:0] s_aw_addr;\n    reg [2:0] s_aw_prot;\n    reg [DATA_WIDTH-1:0] s_w_data;\n    reg [STRB_WIDTH-1:0] s_w_strb;\n    reg s_w_valid_reg;\n    reg s_b_valid_reg;\n    reg [1:0] s_b_resp;\n\n    // State Registers for Read Channel (Slave -> Master)\n    reg s_ar_state, s_r_state;\n    reg [ADDR_WIDTH-1:0] s_ar_addr;\n    reg [2:0] s_ar_prot;\n    reg s_r_valid_reg;\n    reg [DATA_WIDTH-1:0] s_r_data;\n    reg [1:0] s_r_resp;\n\n    // State Registers for Master -> Slave (Write)\n    reg m_aw_state, m_w_state, m_b_state;\n    reg [ADDR_WIDTH-1:0] m_aw_addr;\n    reg [2:0] m_aw_prot;\n    reg [DATA_WIDTH-1:0] m_w_data;\n    reg [STRB_WIDTH-1:0] m_w_strb;\n    reg m_w_valid_reg;\n    reg m_b_valid_reg;\n    reg [1:0] m_b_resp;\n\n    // State Registers for Master -> Slave (Read)\n    reg m_ar_state, m_r_state;\n    reg [ADDR_WIDTH-1:0] m_ar_addr;\n    reg [2:0] m_ar_prot;\n    reg m_r_valid_reg;\n    reg [DATA_WIDTH-1:0] m_r_data;\n    reg [1:0] m_r_resp;\n\n    // CDC Synchronizers (2-stage)\n    wire s_aw_valid_sync0, s_aw_valid_sync1;\n    wire s_w_valid_sync0, s_w_valid_sync1;\n    wire s_b_valid_sync0, s_b_valid_sync1;\n    wire s_ar_valid_sync0, s_ar_valid_sync1;\n    wire s_r_valid_sync0, s_r_valid_sync1;\n\n    wire m_aw_valid_sync0, m_aw_valid_sync1;\n    wire m_w_valid_sync0, m_w_valid_sync1;\n    wire m_b_valid_sync0, m_b_valid_sync1;\n    wire m_ar_valid_sync0, m_ar_valid_sync1;\n    wire m_r_valid_sync0, m_r_valid_sync1;\n\n    // ------------------------------------------------------------------\n    // Synchronizer Logic\n    // ------------------------------------------------------------------\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_aw_valid_sync0 <= 1'b0;\n            s_w_valid_sync0  <= 1'b0;\n            s_b_valid_sync0  <= 1'b0;\n            s_ar_valid_sync0 <= 1'b0;\n            s_r_valid_sync0  <= 1'b0;\n        end else begin\n            s_aw_valid_sync0 <= s_axil_awvalid;\n            s_w_valid_sync0  <= s_axil_wvalid;\n            s_b_valid_sync0  <= s_axil_bvalid;\n            s_ar_valid_sync0 <= s_axil_arvalid;\n            s_r_valid_sync0  <= s_axil_rvalid;\n        end\n    end\n\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_aw_valid_sync1 <= 1'b0;\n            s_w_valid_sync1  <= 1'b0;\n            s_b_valid_sync1  <= 1'b0;\n            s_ar_valid_sync1 <= 1'b0;\n            s_r_valid_sync1  <= 1'b0;\n        end else begin\n            s_aw_valid_sync1 <= s_aw_valid_sync0;\n            s_w_valid_sync1  <= s_w_valid_sync0;\n            s_b_valid_sync1  <= s_b_valid_sync0;\n            s_ar_valid_sync1 <= s_ar_valid_sync0;\n            s_r_valid_sync1  <= s_r_valid_sync0;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_aw_valid_sync0 <= 1'b0;\n            m_w_valid_sync0  <= 1'b0;\n            m_b_valid_sync0  <= 1'b0;\n            m_ar_valid_sync0 <= 1'b0;\n            m_r_valid_sync0  <= 1'b0;\n        end else begin\n            m_aw_valid_sync0 <= m_axil_awvalid;\n            m_w_valid_sync0  <= m_axil_wvalid;\n            m_b_valid_sync0  <= m_axil_bvalid;\n            m_ar_valid_sync0 <= m_axil_arvalid;\n            m_r_valid_sync0  <= m_axil_rvalid;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_aw_valid_sync1 <= 1'b0;\n            m_w_valid_sync1  <= 1'b0;\n            m_b_valid_sync1  <= 1'b0;\n            m_ar_valid_sync1 <= 1'b0;\n            m_r_valid_sync1  <= 1'b0;\n        end else begin\n            m_aw_valid_sync1 <= m_aw_valid_sync0;\n            m_w_valid_sync1  <= m_w_valid_sync0;\n            m_b_valid_sync1  <= m_b_valid_sync0;\n            m_ar_valid_sync1 <= m_ar_valid_sync0;\n            m_r_valid_sync1  <= m_r_valid_sync0;\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Slave Side State Machine (s_clk domain)\n    // ------------------------------------------------------------------\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_aw_state <= 1'b0;\n            s_w_state  <= 1'b0;\n            s_b_state  <= 1'b0;\n            s_ar_state <= 1'b0;\n            s_r_state  <= 1'b0;\n            s_aw_addr  <= 1'b0;\n            s_aw_prot  <= 1'b0;\n            s_w_data   <= 1'b0;\n            s_w_strb   <= 1'b0;\n            s_w_valid_reg <= 1'b0;\n            s_b_valid_reg <= 1'b0;\n            s_b_resp    <= 2'b00;\n            s_ar_addr   <= 1'b0;\n            s_ar_prot   <= 1'b0;\n            s_r_valid_reg <= 1'b0;\n            s_r_data    <= 1'b0;\n            s_r_resp    <= 2'b00;\n        end else begin\n            // Write Address\n            if (s_aw_valid_sync1 && s_aw_ready) begin\n                s_aw_state <= 1'b1;\n                s_aw_addr  <= s_axil_awaddr;\n                s_aw_prot  <= s_axil_awprot;\n            end else if (s_aw_state) begin\n                s_aw_state <= 1'b0;\n            end\n\n            // Write Data\n            if (s_w_valid_sync1 && s_w_ready) begin\n                s_w_state <= 1'b1;\n                s_w_data  <= s_axil_wdata;\n                s_w_strb  <= s_axil_wstrb;\n                s_w_valid_reg <= 1'b1;\n            end else if (s_w_state) begin\n                s_w_state <= 1'b0;\n                s_w_valid_reg <= 1'b0;\n            end\n\n            // Write Response\n            if (s_b_valid_sync1 && s_b_ready) begin\n                s_b_state <= 1'b1;\n                s_b_resp  <= s_axil_bresp;\n                s_b_valid_reg <= 1'b1;\n            end else if (s_b_state) begin\n                s_b_state <= 1'b0;\n                s_b_valid_reg <= 1'b0;\n            end\n\n            // Read Address\n            if (s_ar_valid_sync1 && s_ar_ready) begin\n                s_ar_state <= 1'b1;\n                s_ar_addr  <= s_axil_araddr;\n                s_ar_prot  <= s_axil_arprot;\n            end else if (s_ar_state) begin\n                s_ar_state <= 1'b0;\n            end\n\n            // Read Data\n            if (s_r_valid_sync1 && s_r_ready) begin\n                s_r_state <= 1'b1;\n                s_r_data  <= s_axil_rdata;\n                s_r_resp  <= s_axil_rresp;\n                s_r_valid_reg <= 1'b1;\n            end else if (s_r_state) begin\n                s_r_state <= 1'b0;\n                s_r_valid_reg <= 1'b0;\n            end\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Master Side State Machine (m_clk domain)\n    // ------------------------------------------------------------------\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_aw_state <= 1'b0;\n            m_w_state  <= 1'b0;\n            m_b_state  <= 1'b0;\n            m_ar_state <= 1'b0;\n            m_r_state  <= 1'b0;\n            m_aw_addr  <= 1'b0;\n            m_aw_prot  <= 1'b0;\n            m_w_data   <= 1'b0;\n            m_w_strb   <= 1'b0;\n            m_w_valid_reg <= 1'b0;\n            m_b_valid_reg <= 1'b0;\n            m_b_resp    <= 2'b00;\n            m_ar_addr   <= 1'b0;\n            m_ar_prot   <= 1'b0;\n            m_r_valid_reg <= 1'b0;\n            m_r_data    <= 1'b0;\n            m_r_resp    <= 2'b00;\n        end else begin\n            // Write Address\n            if (m_aw_valid_sync1 && m_aw_ready) begin\n                m_aw_state <= 1'b1;\n                m_aw_addr  <= m_axil_awaddr;\n                m_aw_prot  <= m_axil_awprot;\n            end else if (m_aw_state) begin\n                m_aw_state <= 1'b0;\n            end\n\n            // Write Data\n            if (m_w_valid_sync1 && m_w_ready) begin\n                m_w_state <= 1'b1;\n                m_w_data  <= m_axil_wdata;\n                m_w_strb  <= m_axil_wstrb;\n                m_w_valid_reg <= 1'b1;\n            end else if (m_w_state) begin\n                m_w_state <= 1'b0;\n                m_w_valid_reg <= 1'b0;\n            end\n\n            // Write Response\n            if (m_b_valid_sync1 && m_b_ready) begin\n                m_b_state <= 1'b1;\n                m_b_resp  <= m_axil_bresp;\n                m_b_valid_reg <= 1'b1;\n            end else if (m_b_state) begin\n                m_b_state <= 1'b0;\n                m_b_valid_reg <= 1'b0;\n            end\n\n            // Read Address\n            if (m_ar_valid_sync1 && m_ar_ready) begin\n                m_ar_state <= 1'b1;\n                m_ar_addr  <= m_axil_araddr;\n                m_ar_prot  <= m_axil_arprot;\n            end else if (m_ar_state) begin\n                m_ar_state <= 1'b0;\n            end\n\n            // Read Data\n            if (m_r_valid_sync1 && m_r_ready) begin\n                m_r_state <= 1'b1;\n                m_r_data  <= m_axil_rdata;\n                m_r_resp  <= m_axil_rresp;\n                m_r_valid_reg <= 1'b1;\n            end else if (m_r_state) begin\n                m_r_state <= 1'b0;\n                m_r_valid_reg <= 1'b0;\n            end\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Output Logic (Slave Side)\n    // ------------------------------------------------------------------\n    assign s_axil_awready = (s_aw_state == 1'b0);\n    assign s_axil_wready  = (s_w_state == 1'b0);\n    assign s_axil_bresp   = s_b_resp;\n    assign s_axil_bvalid  = s_b_valid_reg;\n    assign s_axil_arready = (s_ar_state == 1'b0);\n    assign s_axil_rdata   = s_r_data;\n    assign s_axil_rresp   = s_r_resp;\n    assign s_axil_rvalid  = s_r_valid_reg;\n\n    // ------------------------------------------------------------------\n    // Output Logic (Master Side)\n    // ------------------------------------------------------------------\n    assign m_axil_awaddr  = m_aw_addr;\n    assign m_axil_awprot  = m_aw_prot;\n    assign m_axil_awvalid = m_aw_state;\n    assign m_axil_wdata   = m_w_data;\n    assign m_axil_wstrb   = m_w_strb;\n    assign m_axil_wvalid  = m_w_state;\n    assign m_axil_bresp   = m_b_resp;\n    assign m_axil_bvalid  = m_b_valid_reg;\n    assign m_axil_araddr  = m_ar_addr;\n    assign m_axil_arprot  = m_ar_prot;\n    assign m_axil_arvalid = m_ar_state;\n    assign m_axil_rdata   = m_r_data;\n    assign m_axil_rresp   = m_r_resp;\n    assign m_axil_rvalid  = m_r_valid_reg;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
