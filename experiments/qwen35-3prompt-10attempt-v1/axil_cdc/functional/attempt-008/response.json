  "text": "```verilog\nmodule axil_cdc #\n(\n    parameter DATA_WIDTH = 32,\n    parameter ADDR_WIDTH = 32,\n    parameter STRB_WIDTH = (DATA_WIDTH/8)\n)\n(\n    /*\n     * AXI lite slave interface\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_awaddr,\n    input  wire [2:0]             s_axil_awprot,\n    input  wire                   s_axil_awvalid,\n    output wire                   s_axil_awready,\n    input  wire [DATA_WIDTH-1:0]  s_axil_wdata,\n    input  wire [STRB_WIDTH-1:0]  s_axil_wstrb,\n    input  wire                   s_axil_wvalid,\n    output wire                   s_axil_wready,\n    output wire [1:0]             s_axil_bresp,\n    output wire                   s_axil_bvalid,\n    input  wire                   s_axil_bready,\n    input  wire [ADDR_WIDTH-1:0]  s_axil_araddr,\n    input  wire [2:0]             s_axil_arprot,\n    input  wire                   s_axil_arvalid,\n    output wire                   s_axil_arready,\n    output wire [DATA_WIDTH-1:0]  s_axil_rdata,\n    output wire [1:0]             s_axil_rresp,\n    output wire                   s_axil_rvalid,\n    input  wire                   s_axil_rready,\n    /*\n     * AXI lite master interface\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [ADDR_WIDTH-1:0]  m_axil_awaddr,\n    output wire [2:0]             m_axil_awprot,\n    output wire                   m_axil_awvalid,\n    input  wire                   m_axil_awready,\n    output wire [DATA_WIDTH-1:0]  m_axil_wdata,\n    output wire [STRB_WIDTH-1:0]  m_axil_wstrb,\n    output wire                   m_axil_wvalid,\n    input  wire                   m_axil_wready,\n    input  wire [1:0]             m_axil_bresp,\n    input  wire                   m_axil_bvalid,\n    output wire                   m_axil_bready,\n    output wire [ADDR_WIDTH-1:0]  m_axil_araddr,\n    output wire [2:0]             m_axil_arprot,\n    output wire                   m_axil_arvalid,\n    input  wire                   m_axil_arready,\n    input  wire [DATA_WIDTH-1:0]  m_axil_rdata,\n    input  wire [1:0]             m_axil_rresp,\n    input  wire                   m_axil_rvalid,\n    output wire                   m_axil_rready\n);\n\n    // ------------------------------------------------------------------\n    // Internal Signals\n    // ------------------------------------------------------------------\n    wire s_aw_valid, s_w_valid, s_b_valid, s_ar_valid, s_r_valid;\n    wire s_aw_ready, s_w_ready, s_b_ready, s_ar_ready, s_r_ready;\n    wire m_aw_valid, m_w_valid, m_b_valid, m_ar_valid, m_r_valid;\n    wire m_aw_ready, m_w_ready, m_b_ready, m_ar_ready, m_r_ready;\n\n    wire s_aw_addr, s_aw_prot, s_w_data, s_w_strb, s_ar_addr, s_ar_prot;\n    wire m_aw_addr, m_aw_prot, m_w_data, m_w_strb, m_ar_addr, m_ar_prot;\n    wire m_b_resp, m_r_data, m_r_resp;\n    wire s_b_resp, s_r_data, s_r_resp;\n\n    reg s_aw_addr_reg, s_aw_prot_reg, s_w_data_reg, s_w_strb_reg;\n    reg s_ar_addr_reg, s_ar_prot_reg;\n    reg m_aw_addr_reg, m_aw_prot_reg, m_w_data_reg, m_w_strb_reg;\n    reg m_ar_addr_reg, m_ar_prot_reg;\n    reg m_b_resp_reg, m_r_data_reg, m_r_resp_reg;\n\n    reg s_aw_valid_reg, s_w_valid_reg, s_b_valid_reg;\n    reg s_ar_valid_reg, s_r_valid_reg;\n    reg m_aw_valid_reg, m_w_valid_reg, m_b_valid_reg;\n    reg m_ar_valid_reg, m_r_valid_reg;\n\n    reg s_aw_ready_reg, s_w_ready_reg, s_b_ready_reg;\n    reg s_ar_ready_reg, s_r_ready_reg;\n    reg m_aw_ready_reg, m_w_ready_reg, m_b_ready_reg;\n    reg m_ar_ready_reg, m_r_ready_reg;\n\n    // ------------------------------------------------------------------\n    // CDC Logic: Write Address Channel (AW)\n    // ------------------------------------------------------------------\n    // Capture valid from s, drive ready to s, capture ready from m, drive valid to m\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_aw_valid_reg <= 1'b0;\n            s_aw_ready_reg <= 1'b1;\n            s_aw_addr_reg  <= 1'b0;\n            s_aw_prot_reg  <= 1'b0;\n        end else begin\n            s_aw_valid_reg <= s_axil_awvalid & s_aw_ready_reg;\n            s_aw_ready_reg <= m_axil_awready;\n            s_aw_addr_reg  <= s_axil_awaddr;\n            s_aw_prot_reg  <= s_axil_awprot;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_aw_valid_reg <= 1'b0;\n            m_aw_ready_reg <= 1'b1;\n            m_aw_addr_reg  <= 1'b0;\n            m_aw_prot_reg  <= 1'b0;\n        end else begin\n            m_aw_valid_reg <= s_axil_awvalid & s_aw_ready_reg;\n            m_aw_ready_reg <= s_axil_awready;\n            m_aw_addr_reg  <= s_axil_awaddr;\n            m_aw_prot_reg  <= s_axil_awprot;\n        end\n    end\n\n    assign s_axil_awready = s_aw_ready_reg;\n    assign m_axil_awvalid = m_aw_valid_reg;\n    assign s_axil_awaddr  = s_aw_addr_reg;\n    assign s_axil_awprot  = s_aw_prot_reg;\n    assign m_axil_awaddr  = m_aw_addr_reg;\n    assign m_axil_awprot  = m_aw_prot_reg;\n\n    // ------------------------------------------------------------------\n    // CDC Logic: Write Data Channel (W)\n    // ------------------------------------------------------------------\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_w_valid_reg <= 1'b0;\n            s_w_ready_reg <= 1'b1;\n            s_w_data_reg  <= 1'b0;\n            s_w_strb_reg  <= 1'b0;\n        end else begin\n            s_w_valid_reg <= s_axil_wvalid & s_w_ready_reg;\n            s_w_ready_reg <= m_axil_wready;\n            s_w_data_reg  <= s_axil_wdata;\n            s_w_strb_reg  <= s_axil_wstrb;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_w_valid_reg <= 1'b0;\n            m_w_ready_reg <= 1'b1;\n            m_w_data_reg  <= 1'b0;\n            m_w_strb_reg  <= 1'b0;\n        end else begin\n            m_w_valid_reg <= s_axil_wvalid & s_w_ready_reg;\n            m_w_ready_reg <= s_axil_wready;\n            m_w_data_reg  <= s_axil_wdata;\n            m_w_strb_reg  <= s_axil_wstrb;\n        end\n    end\n\n    assign s_axil_wready = s_w_ready_reg;\n    assign m_axil_wvalid = m_w_valid_reg;\n    assign s_axil_wdata  = s_w_data_reg;\n    assign s_axil_wstrb  = s_w_strb_reg;\n    assign m_axil_wdata  = m_w_data_reg;\n    assign m_axil_wstrb  = m_w_strb_reg;\n\n    // ------------------------------------------------------------------\n    // CDC Logic: Write Response Channel (B)\n    // ------------------------------------------------------------------\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_b_valid_reg <= 1'b0;\n            s_b_ready_reg <= 1'b1;\n            s_b_resp_reg  <= 1'b0;\n        end else begin\n            s_b_valid_reg <= m_axil_bvalid & s_b_ready_reg;\n            s_b_ready_reg <= s_axil_bready;\n            s_b_resp_reg  <= m_axil_bresp;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_b_valid_reg <= 1'b0;\n            m_b_ready_reg <= 1'b1;\n            m_b_resp_reg  <= 1'b0;\n        end else begin\n            m_b_valid_reg <= s_axil_bvalid & s_b_ready_reg;\n            m_b_ready_reg <= s_axil_bready;\n            m_b_resp_reg  <= s_axil_bresp;\n        end\n    end\n\n    assign s_axil_bvalid = s_b_valid_reg;\n    assign m_axil_bready = m_b_ready_reg;\n    assign s_axil_bresp  = s_b_resp_reg;\n    assign m_axil_bresp  = m_b_resp_reg;\n\n    // ------------------------------------------------------------------\n    // CDC Logic: Read Address Channel (AR)\n    // ------------------------------------------------------------------\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_ar_valid_reg <= 1'b0;\n            s_ar_ready_reg <= 1'b1;\n            s_ar_addr_reg  <= 1'b0;\n            s_ar_prot_reg  <= 1'b0;\n        end else begin\n            s_ar_valid_reg <= s_axil_arvalid & s_ar_ready_reg;\n            s_ar_ready_reg <= m_axil_arready;\n            s_ar_addr_reg  <= s_axil_araddr;\n            s_ar_prot_reg  <= s_axil_arprot;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_ar_valid_reg <= 1'b0;\n            m_ar_ready_reg <= 1'b1;\n            m_ar_addr_reg  <= 1'b0;\n            m_ar_prot_reg  <= 1'b0;\n        end else begin\n            m_ar_valid_reg <= s_axil_arvalid & s_ar_ready_reg;\n            m_ar_ready_reg <= s_axil_arready;\n            m_ar_addr_reg  <= s_axil_araddr;\n            m_ar_prot_reg  <= s_axil_arprot;\n        end\n    end\n\n    assign s_axil_arready = s_ar_ready_reg;\n    assign m_axil_arvalid = m_ar_valid_reg;\n    assign s_axil_araddr  = s_ar_addr_reg;\n    assign s_axil_arprot  = s_ar_prot_reg;\n    assign m_axil_araddr  = m_ar_addr_reg;\n    assign m_axil_arprot  = m_ar_prot_reg;\n\n    // ------------------------------------------------------------------\n    // CDC Logic: Read Data Channel (R)\n    // ------------------------------------------------------------------\n    always @(posedge s_clk or posedge s_rst) begin\n        if (s_rst) begin\n            s_r_valid_reg <= 1'b0;\n            s_r_ready_reg <= 1'b1;\n            s_r_data_reg  <= 1'b0;\n            s_r_resp_reg  <= 1'b0;\n        end else begin\n            s_r_valid_reg <= m_axil_rvalid & s_r_ready_reg;\n            s_r_ready_reg <= s_axil_rready;\n            s_r_data_reg  <= m_axil_rdata;\n            s_r_resp_reg  <= m_axil_rresp;\n        end\n    end\n\n    always @(posedge m_clk or posedge m_rst) begin\n        if (m_rst) begin\n            m_r_valid_reg <= 1'b0;\n            m_r_ready_reg <= 1'b1;\n            m_r_data_reg  <= 1'b0;\n            m_r_resp_reg  <= 1'b0;\n        end else begin\n            m_r_valid_reg <= s_axil_rvalid & s_r_ready_reg;\n            m_r_ready_reg <= s_axil_rready;\n            m_r_data_reg  <= s_axil_rdata;\n            m_r_resp_reg  <= s_axil_rresp;\n        end\n    end\n\n    assign s_axil_rvalid = s_r_valid_reg;\n    assign m_axil_rready = m_r_ready_reg;\n    assign s_axil_rdata  = s_r_data_reg;\n    assign s_axil_rresp  = s_r_resp_reg;\n    assign m_axil_rdata  = m_r_data_reg;\n    assign m_axil_rresp  = m_r_resp_reg;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
