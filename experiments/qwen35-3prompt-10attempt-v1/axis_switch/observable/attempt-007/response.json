  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule axis_switch #\n(\n    parameter S_COUNT = 4,\n    parameter M_COUNT = 4,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter S_ID_WIDTH = 8,\n    parameter M_ID_WIDTH = S_ID_WIDTH+$clog2(S_COUNT),\n    parameter M_DEST_WIDTH = 1,\n    parameter S_DEST_WIDTH = M_DEST_WIDTH+$clog2(M_COUNT),\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter M_BASE = 0,\n    parameter M_TOP = 0,\n    parameter M_CONNECT = {M_COUNT{{S_COUNT{1'b1}}}},\n    parameter UPDATE_TID = 0,\n    parameter S_REG_TYPE = 0,\n    parameter M_REG_TYPE = 2,\n    parameter ARB_TYPE_ROUND_ROBIN = 1,\n    parameter ARB_LSB_HIGH_PRIORITY = 1\n)\n(\n    input  wire                             clk,\n    input  wire                             rst,\n    input  wire [S_COUNT*DATA_WIDTH-1:0]    s_axis_tdata,\n    input  wire [S_COUNT*KEEP_WIDTH-1:0]    s_axis_tkeep,\n    input  wire [S_COUNT-1:0]               s_axis_tvalid,\n    output wire [S_COUNT-1:0]               s_axis_tready,\n    input  wire [S_COUNT-1:0]               s_axis_tlast,\n    input  wire [S_COUNT*S_ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [S_COUNT*S_DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [S_COUNT*USER_WIDTH-1:0]    s_axis_tuser,\n    output wire [M_COUNT*DATA_WIDTH-1:0]    m_axis_tdata,\n    output wire [M_COUNT*KEEP_WIDTH-1:0]    m_axis_tkeep,\n    output wire [M_COUNT-1:0]               m_axis_tvalid,\n    input  wire [M_COUNT-1:0]               m_axis_tready,\n    output wire [M_COUNT-1:0]               m_axis_tlast,\n    output wire [M_COUNT*M_ID_WIDTH-1:0]    m_axis_tid,\n    output wire [M_COUNT*M_DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [M_COUNT*USER_WIDTH-1:0]    m_axis_tuser\n);\n\n    localparam LOG_S_COUNT = $clog2(S_COUNT);\n    localparam LOG_M_COUNT = $clog2(M_COUNT);\n\n    // State for Round Robin Arbiter\n    reg [LOG_S_COUNT-1:0] arb_rr_index;\n    reg [LOG_S_COUNT-1:0] arb_rr_mask;\n    reg [LOG_S_COUNT-1:0] arb_rr_counter;\n\n    // Internal signals\n    wire [S_COUNT-1:0] s_valid;\n    wire [S_COUNT-1:0] s_ready;\n    wire [S_COUNT-1:0] s_last;\n    wire [S_COUNT-1:0] s_tid;\n    wire [S_COUNT-1:0] s_dest;\n    wire [S_COUNT-1:0] s_user;\n    wire [S_COUNT-1:0] s_keep;\n    wire [S_COUNT-1:0] s_data;\n\n    // Output registers\n    reg [M_COUNT-1:0] m_valid;\n    reg [M_COUNT-1:0] m_last;\n    reg [M_COUNT-1:0] m_tid;\n    reg [M_COUNT-1:0] m_dest;\n    reg [M_COUNT-1:0] m_user;\n    reg [M_COUNT-1:0] m_keep;\n    reg [M_COUNT-1:0] m_data;\n\n    // Arbitration Logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            arb_rr_index <= '0;\n            arb_rr_mask  <= '0;\n            arb_rr_counter <= '0;\n        end else begin\n            // Update mask based on valid inputs\n            arb_rr_mask <= s_valid;\n            \n            // Round Robin Selection\n            if (|s_valid) begin\n                // Find first set bit in mask starting from current index\n                arb_rr_index <= arb_rr_counter;\n                while (!arb_rr_mask[arb_rr_index]) begin\n                    arb_rr_index <= arb_rr_index + 1'b1;\n                    if (arb_rr_index >= S_COUNT)\n                        arb_rr_index <= '0;\n                end\n                // Increment counter for next time\n                arb_rr_counter <= arb_rr_index + 1'b1;\n                if (arb_rr_counter >= S_COUNT)\n                    arb_rr_counter <= '0;\n            end else begin\n                arb_rr_counter <= '0;\n            end\n        end\n    end\n\n    // Select Input Signals\n    assign s_valid = s_axis_tvalid[arb_rr_index];\n    assign s_ready = m_axis_tready[arb_rr_index];\n    assign s_last = s_axis_tlast[arb_rr_index];\n    assign s_tid = s_axis_tid[arb_rr_index];\n    assign s_dest = s_axis_tdest[arb_rr_index];\n    assign s_user = s_axis_tuser[arb_rr_index];\n    assign s_keep = s_axis_tkeep[arb_rr_index];\n    assign s_data = s_axis_tdata[arb_rr_index];\n\n    // Output Data Assignment\n    assign m_axis_tdata = m_data;\n    assign m_axis_tkeep = m_keep;\n    assign m_axis_tvalid = m_valid;\n    assign m_axis_tlast = m_last;\n    assign m_axis_tid = m_tid;\n    assign m_axis_tdest = m_dest;\n    assign m_axis_tuser = m_user;\n\n    // Output Logic\n    always @(posedge clk or posedge rst) begin\n        if (rst) begin\n            m_valid <= '0;\n            m_last  <= '0;\n            m_tid   <= '0;\n            m_dest  <= '0;\n            m_user  <= '0;\n            m_keep  <= '0;\n            m_data  <= '0;\n        end else begin\n            // Update output registers if valid and ready\n            if (s_valid && s_ready) begin\n                m_valid[arb_rr_index] <= 1'b1;\n                m_last[arb_rr_index]  <= s_last;\n                m_tid[arb_rr_index]   <= s_tid;\n                m_dest[arb_rr_index]  <= s_dest;\n                m_user[arb_rr_index]  <= s_user;\n                m_keep[arb_rr_index]  <= s_keep;\n                m_data[arb_rr_index]  <= s_data;\n            end else begin\n                // Reset output if not valid or not ready\n                m_valid[arb_rr_index] <= 1'b0;\n                m_last[arb_rr_index]  <= 1'b0;\n                m_tid[arb_rr_index]   <= '0;\n                m_dest[arb_rr_index]  <= '0;\n                m_user[arb_rr_index]  <= '0;\n                m_keep[arb_rr_index]  <= '0;\n                m_data[arb_rr_index]  <= '0;\n            end\n        end\n    end\n\n    // Input Ready Logic\n    assign s_axis_tready = m_axis_tready;\n\n    // Output Valid Logic\n    assign m_axis_tvalid = m_valid;\n\n    // Output Last Logic\n    assign m_axis_tlast = m_last;\n\n    // Output TID Logic\n    assign m_axis_tid = m_tid;\n\n    // Output TDEST Logic\n    assign m_axis_tdest = m_dest;\n\n    // Output TUSER Logic\n    assign m_axis_tuser = m_user;\n\n    // Output TKEEP Logic\n    assign m_axis_tkeep = m_keep;\n\n    // Output TDATA Logic\n    assign m_axis_tdata = m_data;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
