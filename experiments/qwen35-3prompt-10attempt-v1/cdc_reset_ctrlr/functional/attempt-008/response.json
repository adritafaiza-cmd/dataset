  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  wire a_clk_i,\n    input  wire a_rst_ni,\n    input  wire a_clear_i,\n    output wire a_clear_o,\n    input  wire a_clear_ack_i,\n    output wire a_isolate_o,\n    input  wire a_isolate_ack_i,\n    input  wire b_clk_i,\n    input  wire b_rst_ni,\n    input  wire b_clear_i,\n    output wire b_clear_o,\n    input  wire b_clear_ack_i,\n    output wire b_isolate_o,\n    input  wire b_isolate_ack_i\n);\n\n    localparam [3:0] IDLE = 4'b0000;\n    localparam [3:0] REQ_A = 4'b0001;\n    localparam [3:0] REQ_B = 4'b0010;\n    localparam [3:0] ISOLATING = 4'b0011;\n    localparam [3:0] ISOLATED = 4'b0100;\n    localparam [3:0] CLEARING = 4'b0101;\n    localparam [3:0] CLEARED = 4'b0110;\n    localparam [3:0] DONE = 4'b0111;\n\n    // State machine for the control logic\n    // State encoding:\n    // 0000: IDLE - Normal operation\n    // 0001: REQ_A - A requested clear, waiting for B to see it\n    // 0010: REQ_B - B requested clear, waiting for A to see it\n    // 0011: ISOLATING - Both requested, isolating both domains\n    // 0100: ISOLATED - Isolation complete, waiting for clear request to propagate\n    // 0101: CLEARING - Clear active, waiting for acks\n    // 0110: CLEARED - Clear acks received, waiting for peer completion\n    // 0111: DONE - All clear, releasing isolation\n\n    reg [3:0] state, next_state;\n    reg [3:0] peer_req; // 1 if peer requested clear\n    reg [3:0] peer_done; // 1 if peer completed the clear sequence\n\n    // Synchronizers for peer signals\n    reg [SYNC_STAGES-1:0] a_clear_sync;\n    reg [SYNC_STAGES-1:0] a_isolate_sync;\n    reg [SYNC_STAGES-1:0] b_clear_sync;\n    reg [SYNC_STAGES-1:0] b_isolate_sync;\n\n    // Internal flags for handshake completion\n    reg a_clear_req_seen;\n    reg b_clear_req_seen;\n    reg a_isolate_req_seen;\n    reg b_isolate_req_seen;\n\n    // Output registers\n    reg a_clear_o_reg;\n    reg a_isolate_o_reg;\n    reg b_clear_o_reg;\n    reg b_isolate_o_reg;\n\n    // Synchronizers for peer acks\n    reg [SYNC_STAGES-1:0] a_clear_ack_sync;\n    reg [SYNC_STAGES-1:0] a_isolate_ack_sync;\n    reg [SYNC_STAGES-1:0] b_clear_ack_sync;\n    reg [SYNC_STAGES-1:0] b_isolate_ack_sync;\n\n    // Synchronizers for peer clear outputs (to detect peer completion)\n    reg [SYNC_STAGES-1:0] b_clear_o_sync;\n    reg [SYNC_STAGES-1:0] b_isolate_o_sync;\n\n    // Synchronizers for peer isolate outputs (to detect peer completion)\n    reg [SYNC_STAGES-1:0] a_clear_o_sync;\n    reg [SYNC_STAGES-1:0] a_isolate_o_sync;\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            state <= IDLE;\n            peer_req <= 4'b0000;\n            peer_done <= 4'b0000;\n            a_clear_o_reg <= 1'b0;\n            a_isolate_o_reg <= 1'b0;\n            b_clear_o_reg <= 1'b0;\n            b_isolate_o_reg <= 1'b0;\n            a_clear_req_seen <= 1'b0;\n            b_clear_req_seen <= 1'b0;\n            a_isolate_req_seen <= 1'b0;\n            b_isolate_req_seen <= 1'b0;\n        end else begin\n            state <= next_state;\n            peer_req <= b_clear_sync[0];\n            peer_done <= b_isolate_o_sync[0] | b_clear_o_sync[0];\n            a_clear_o_reg <= a_clear_o;\n            a_isolate_o_reg <= a_isolate_o;\n            b_clear_o_reg <= b_clear_o;\n            b_isolate_o_reg <= b_isolate_o;\n        end\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            state <= IDLE;\n            peer_req <= 4'b0000;\n            peer_done <= 4'b0000;\n            b_clear_o_reg <= 1'b0;\n            b_isolate_o_reg <= 1'b0;\n            a_clear_req_seen <= 1'b0;\n            b_clear_req_seen <= 1'b0;\n            a_isolate_req_seen <= 1'b0;\n            b_isolate_req_seen <= 1'b0;\n        end else begin\n            state <= next_state;\n            peer_req <= a_clear_sync[0];\n            peer_done <= a_isolate_o_sync[0] | a_clear_o_sync[0];\n            b_clear_o_reg <= b_clear_o;\n            b_isolate_o_reg <= b_isolate_o;\n            a_clear_req_seen <= a_clear_i;\n            b_clear_req_seen <= b_clear_i;\n            a_isolate_req_seen <= a_isolate_o;\n            b_isolate_req_seen <= b_isolate_o;\n        end\n    end\n\n    // Synchronizer logic for A domain\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            a_clear_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_clear_sync <= {a_clear_sync[SYNC_STAGES-2:0], a_clear_i};\n    end\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            a_isolate_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_isolate_sync <= {a_isolate_sync[SYNC_STAGES-2:0], a_isolate_o};\n    end\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            a_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_clear_ack_sync <= {a_clear_ack_sync[SYNC_STAGES-2:0], a_clear_ack_i};\n    end\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            a_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_isolate_ack_sync <= {a_isolate_ack_sync[SYNC_STAGES-2:0], a_isolate_ack_i};\n    end\n\n    // Synchronizer logic for B domain\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            b_clear_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_clear_sync <= {b_clear_sync[SYNC_STAGES-2:0], b_clear_i};\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            b_isolate_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_isolate_sync <= {b_isolate_sync[SYNC_STAGES-2:0], b_isolate_o};\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            b_clear_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_clear_ack_sync <= {b_clear_ack_sync[SYNC_STAGES-2:0], b_clear_ack_i};\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            b_isolate_ack_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_isolate_ack_sync <= {b_isolate_ack_sync[SYNC_STAGES-2:0], b_isolate_ack_i};\n    end\n\n    // Synchronizers for peer outputs (to detect completion)\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_clear_o_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_clear_o_sync <= {b_clear_o_sync[SYNC_STAGES-2:0], b_clear_o};\n    end\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            b_isolate_o_sync <= {SYNC_STAGES{1'b0}};\n        else\n            b_isolate_o_sync <= {b_isolate_o_sync[SYNC_STAGES-2:0], b_isolate_o};\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_clear_o_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_clear_o_sync <= {a_clear_o_sync[SYNC_STAGES-2:0], a_clear_o};\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            a_isolate_o_sync <= {SYNC_STAGES{1'b0}};\n        else\n            a_isolate_o_sync <= {a_isolate_o_sync[SYNC_STAGES-2:0], a_isolate_o};\n    end\n\n    // Next state logic\n    always @(*) begin\n        next_state = state;\n        case (state)\n            IDLE: begin\n                if (a_clear_req_seen && b_clear_req_seen)\n                    next_state = ISOLATING;\n                else if (a_clear_req_seen)\n                    next_state = REQ_A;\n                else if (b_clear_req_seen)\n                    next_state = REQ_B;\n                else\n                    next_state = IDLE;\n            end\n\n            REQ_A: begin\n                if (b_clear_req_seen)\n                    next_state = ISOLATING;\n                else if (a_isolate_ack_sync[0] && a_clear_ack_sync[0])\n                    next_state = CLEARED;\n                else\n                    next_state = REQ_A;\n            end\n\n            REQ_B: begin\n                if (a_clear_req_seen)\n                    next_state = ISOLATING;\n                else if (b_isolate_ack_sync[0] && b_clear_ack_sync[0])\n                    next_state = CLEARED;\n                else\n                    next_state = REQ_B;\n            end\n\n            ISOLATING: begin\n                if (a_isolate_ack_sync[0] && b_isolate_ack_sync[0])\n                    next_state = ISOLATED;\n                else\n                    next_state = ISOLATING;\n            end\n\n            ISOLATED: begin\n                if (a_clear_req_seen && b_clear_req_seen)\n                    next_state = CLEARING;\n                else\n                    next_state = ISOLATED;\n            end\n\n            CLEARING: begin\n                if (a_clear_ack_sync[0] && b_clear_ack_sync[0])\n                    next_state = CLEARED;\n                else\n                    next_state = CLEARING;\n            end\n\n            CLEARED: begin\n                // Wait for peer to complete its clear sequence (peer_done)\n                if (peer_done)\n                    next_state = DONE;\n                else\n                    next_state = CLEARED;\n            end\n\n            DONE: begin\n                if (a_clear_req_seen && b_clear_req_seen)\n                    next_state = IDLE;\n                else\n                    next_state = DONE;\n            end\n\n            default: next_state = IDLE;\n        endcase\n    end\n\n    // Output logic\n    always @(*) begin\n        a_clear_o = 1'b0;\n        a_isolate_o = 1'b0;\n        b_clear_o = 1'b0;\n        b_isolate_o = 1'b0;\n\n        case (state)\n            IDLE: begin\n                a_clear_o = 1'b0;\n                a_isolate_o = 1'b0;\n                b_clear_o = 1'b0;\n                b_isolate_o = 1'b0;\n            end\n\n            REQ_A: begin\n                a_clear_o = 1'b0;\n                a_isolate_o = 1'b0;\n                b_clear_o = 1'b0;\n                b_isolate_o = 1'b0;\n            end\n\n            REQ_B: begin\n                a_clear_o = 1'b0;\n                a_isolate_o = 1'b0;\n                b_clear_o = 1'b0;\n                b_isolate_o = 1'b0;\n            end\n\n            ISOLATING: begin\n                a_clear_o = 1'b0;\n                a_isolate_o = 1'b1;\n                b_clear_o = 1'b0;\n                b_isolate_o = 1'b1;\n            end\n\n            ISOLATED: begin\n                a_clear_o = 1'b1;\n                a_isolate_o = 1'b1;\n                b_clear_o = 1'b1;\n                b_isolate_o = 1'b1;\n            end\n\n            CLEARING: begin\n                a_clear_o = 1'b1;\n                a_isolate_o = 1'b1;\n                b_clear_o = 1'b1;\n                b_isolate_o = 1'b1;\n            end\n\n            CLEARED: begin\n                a_clear_o = 1'b1;\n                a_isolate_o = 1'b1;\n                b_clear_o = 1'b1;\n                b_isolate_o = 1'b1;\n            end\n\n            DONE: begin\n                a_clear_o = 1'b0;\n                a_isolate_o = 1'b0;\n                b_clear_o = 1'b0;\n                b_isolate_o = 1'b0;\n            end\n\n            default: begin\n                a_clear_o = 1'b0;\n                a_isolate_o = 1'b0;\n                b_clear_o = 1'b0;\n                b_isolate_o = 1'b0;\n            end\n        endcase\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
