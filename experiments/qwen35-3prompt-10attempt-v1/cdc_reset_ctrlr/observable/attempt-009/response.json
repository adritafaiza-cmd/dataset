  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  a_clk_i,\n    input  a_rst_ni,\n    input  a_clear_i,\n    output a_clear_o,\n    input  a_clear_ack_i,\n    output a_isolate_o,\n    input  a_isolate_ack_i,\n    input  b_clk_i,\n    input  b_rst_ni,\n    input  b_clear_i,\n    output b_clear_o,\n    input  b_clear_ack_i,\n    output b_isolate_o,\n    input  b_isolate_ack_i\n);\n\n    // ------------------------------------------------------------------\n    // CDC Registers for Domain A signals observed in Domain B\n    // ------------------------------------------------------------------\n    reg [SYNC_STAGES-1:0] b_clear_req_cdc;\n    reg [SYNC_STAGES-1:0] b_isolate_req_cdc;\n    reg [SYNC_STAGES-1:0] b_clear_ack_cdc;\n    reg [SYNC_STAGES-1:0] b_isolate_ack_cdc;\n\n    // ------------------------------------------------------------------\n    // CDC Registers for Domain B signals observed in Domain A\n    // ------------------------------------------------------------------\n    reg [SYNC_STAGES-1:0] a_clear_req_cdc;\n    reg [SYNC_STAGES-1:0] a_isolate_req_cdc;\n    reg [SYNC_STAGES-1:0] a_clear_ack_cdc;\n    reg [SYNC_STAGES-1:0] a_isolate_ack_cdc;\n\n    // ------------------------------------------------------------------\n    // State Machine State Encoding\n    // IDLE: Initial state, waiting for requests\n    // REQ_A: Domain A requested clear, waiting for isolation\n    // REQ_B: Domain B requested clear, waiting for isolation\n    // ISOLATING: Both sides isolated, waiting for clear acks\n    // CLEARING_A: Clearing A, waiting for ack\n    // CLEARING_B: Clearing B, waiting for ack\n    // DONE: Both cleared, returning to idle\n    // ------------------------------------------------------------------\n    localparam IDLE = 3'b000;\n    localparam REQ_A = 3'b001;\n    localparam REQ_B = 3'b010;\n    localparam ISOLATING = 3'b011;\n    localparam CLEARING_A = 3'b100;\n    localparam CLEARING_B = 3'b101;\n    localparam DONE = 3'b110;\n\n    reg [2:0] state, next_state;\n\n    // ------------------------------------------------------------------\n    // CDC Logic: Domain A to Domain B\n    // ------------------------------------------------------------------\n    always @(posedge b_clk_i or posedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_clear_req_cdc <= {SYNC_STAGES{1'b0}};\n            b_isolate_req_cdc <= {SYNC_STAGES{1'b0}};\n            b_clear_ack_cdc <= {SYNC_STAGES{1'b0}};\n            b_isolate_ack_cdc <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_clear_req_cdc <= {b_clear_req_cdc[SYNC_STAGES-2:0], a_clear_i};\n            b_isolate_req_cdc <= {b_isolate_req_cdc[SYNC_STAGES-2:0], a_isolate_o};\n            b_clear_ack_cdc <= {b_clear_ack_cdc[SYNC_STAGES-2:0], a_clear_ack_i};\n            b_isolate_ack_cdc <= {b_isolate_ack_cdc[SYNC_STAGES-2:0], a_isolate_ack_i};\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // CDC Logic: Domain B to Domain A\n    // ------------------------------------------------------------------\n    always @(posedge a_clk_i or posedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_clear_req_cdc <= {SYNC_STAGES{1'b0}};\n            a_isolate_req_cdc <= {SYNC_STAGES{1'b0}};\n            a_clear_ack_cdc <= {SYNC_STAGES{1'b0}};\n            a_isolate_ack_cdc <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_clear_req_cdc <= {a_clear_req_cdc[SYNC_STAGES-2:0], b_clear_i};\n            a_isolate_req_cdc <= {a_isolate_req_cdc[SYNC_STAGES-2:0], b_isolate_o};\n            a_clear_ack_cdc <= {a_clear_ack_cdc[SYNC_STAGES-2:0], b_clear_ack_i};\n            a_isolate_ack_cdc <= {a_isolate_ack_cdc[SYNC_STAGES-2:0], b_isolate_ack_i};\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // State Machine Logic\n    // ------------------------------------------------------------------\n    always @(posedge a_clk_i or posedge a_rst_ni) begin\n        if (!a_rst_ni)\n            state <= IDLE;\n        else\n            state <= next_state;\n    end\n\n    always @(*) begin\n        case (state)\n            IDLE: begin\n                // Check if either side has requested a clear\n                if (a_clear_req_cdc[SYNC_STAGES-1] || b_clear_req_cdc[SYNC_STAGES-1]) begin\n                    // Request isolation on both sides first\n                    next_state = ISOLATING;\n                end else begin\n                    next_state = IDLE;\n                end\n            end\n\n            REQ_A: begin\n                // Should not happen in this specific flow if we go straight to ISOLATING\n                // but kept for completeness if logic changes\n                next_state = IDLE;\n            end\n\n            REQ_B: begin\n                next_state = IDLE;\n            end\n\n            ISOLATING: begin\n                // Wait for both isolation acknowledgments\n                if (a_isolate_ack_cdc[SYNC_STAGES-1] && b_isolate_ack_cdc[SYNC_STAGES-1]) begin\n                    // Both isolated, now wait for clear requests to be stable\n                    // The protocol says: \"wait for both acknowledgments at each step before releasing them\"\n                    // Here, the \"step\" is the isolation. Now we move to clearing.\n                    // We need to ensure the clear request is still valid.\n                    if (a_clear_req_cdc[SYNC_STAGES-1] || b_clear_req_cdc[SYNC_STAGES-1]) begin\n                        next_state = CLEARING_A; // Arbitrarily start with A, or could be B\n                    end else begin\n                        next_state = IDLE;\n                    end\n                end else begin\n                    next_state = ISOLATING;\n                end\n            end\n\n            CLEARING_A: begin\n                // Clearing Domain A. Wait for A's clear ack.\n                // Also need to ensure B is not requesting a new clear that conflicts,\n                // but the protocol implies a sequence: Isolate -> Clear A -> Clear B.\n                // We assume the initial request is the only one active.\n                if (a_clear_ack_cdc[SYNC_STAGES-1]) begin\n                    next_state = CLEARING_B;\n                end else begin\n                    next_state = CLEARING_A;\n                end\n            end\n\n            CLEARING_B: begin\n                // Clearing Domain B. Wait for B's clear ack.\n                if (b_clear_ack_cdc[SYNC_STAGES-1]) begin\n                    next_state = DONE;\n                end else begin\n                    next_state = CLEARING_B;\n                end\n            end\n\n            DONE: begin\n                // Return to idle\n                next_state = IDLE;\n            end\n\n            default: begin\n                next_state = IDLE;\n            end\n        endcase\n    end\n\n    // ------------------------------------------------------------------\n    // Output Logic\n    // ------------------------------------------------------------------\n    // Active Low Outputs\n    assign a_clear_o = (state == CLEARING_A || state == CLEARING_B || state == DONE) ? 1'b0 : 1'b1;\n    assign b_clear_o = (state == CLEARING_A || state == CLEARING_B || state == DONE) ? 1'b0 : 1'b1;\n\n    assign a_isolate_o = (state == ISOLATING || state == CLEARING_A || state == CLEARING_B || state == DONE) ? 1'b0 : 1'b1;\n    assign b_isolate_o = (state == ISOLATING || state == CLEARING_A || state == CLEARING_B || state == DONE) ? 1'b0 : 1'b1;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
