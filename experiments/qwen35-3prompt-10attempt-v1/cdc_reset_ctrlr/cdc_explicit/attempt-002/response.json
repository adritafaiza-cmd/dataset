  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  wire a_clk_i,\n    input  wire a_rst_ni,\n    input  wire a_clear_i,\n    output reg  a_clear_o,\n    input  wire a_clear_ack_i,\n    output reg  a_isolate_o,\n    input  wire a_isolate_ack_i,\n    input  wire b_clk_i,\n    input  wire b_rst_ni,\n    input  wire b_clear_i,\n    output reg  b_clear_o,\n    input  wire b_clear_ack_i,\n    output reg  b_isolate_o,\n    input  wire b_isolate_ack_i\n);\n\n    localparam STATE_IDLE = 2'b00;\n    localparam STATE_ISOLATING = 2'b01;\n    localparam STATE_CLEARING = 2'b10;\n    localparam STATE_DONE = 2'b11;\n\n    // State machine for the control logic (runs on a_clk_i)\n    // State encodes the global progress of the reset sequence.\n    // We use a single state machine to coordinate both domains to ensure\n    // atomicity of the \"Isolate then Clear\" sequence.\n    \n    reg [1:0] state_a;\n    reg [1:0] next_state_a;\n    \n    // Signals to track peer status in domain A\n    // These are sampled from domain B via CDC flip-flops\n    reg [1:0] b_status_a; // 00:Idle, 01:Isolating, 10:Clearing, 11:Done\n    reg [1:0] b_clear_req_a; // 1 if b requested clear\n    reg [1:0] b_isolate_req_a; // 1 if b requested isolate (internal flag)\n    \n    // Signals to track peer status in domain B\n    // These are sampled from domain A via CDC flip-flops\n    reg [1:0] a_status_b; // 00:Idle, 01:Isolating, 10:Clearing, 11:Done\n    reg [1:0] a_clear_req_b; // 1 if a requested clear\n    reg [1:0] a_isolate_req_b; // 1 if a requested isolate (internal flag)\n\n    // CDC Flip-Flops for Domain B -> A (Crossing b_clk to a_clk)\n    // We need to capture b's state and requests safely.\n    // Using a simple 2-stage synchronizer for the status/request signals.\n    wire [1:0] b_status_a_sync1;\n    wire [1:0] b_status_a_sync2;\n    wire [1:0] b_clear_req_a_sync1;\n    wire [1:0] b_clear_req_a_sync2;\n    wire [1:0] b_isolate_req_a_sync1;\n    wire [1:0] b_isolate_req_a_sync2;\n\n    // CDC Flip-Flops for Domain A -> B (Crossing a_clk to b_clk)\n    wire [1:0] a_status_b_sync1;\n    wire [1:0] a_status_b_sync2;\n    wire [1:0] a_clear_req_b_sync1;\n    wire [1:0] a_clear_req_b_sync2;\n    wire [1:0] a_isolate_req_b_sync1;\n    wire [1:0] a_isolate_req_b_sync2;\n\n    // ------------------------------------------------------------------\n    // CDC Synchronizers: b -> a\n    // ------------------------------------------------------------------\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_status_a_sync1 <= 2'b00;\n            b_clear_req_a_sync1 <= 2'b00;\n            b_isolate_req_a_sync1 <= 2'b00;\n        end else begin\n            b_status_a_sync1 <= {b_status_a[1], b_status_a[0]};\n            b_clear_req_a_sync1 <= {b_clear_req_a[1], b_clear_req_a[0]};\n            b_isolate_req_a_sync1 <= {b_isolate_req_a[1], b_isolate_req_a[0]};\n        end\n    end\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_status_a_sync2 <= 2'b00;\n            b_clear_req_a_sync2 <= 2'b00;\n            b_isolate_req_a_sync2 <= 2'b00;\n        end else begin\n            b_status_a_sync2 <= b_status_a_sync1;\n            b_clear_req_a_sync2 <= b_clear_req_a_sync1;\n            b_isolate_req_a_sync2 <= b_isolate_req_a_sync1;\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // CDC Synchronizers: a -> b\n    // ------------------------------------------------------------------\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_status_b_sync1 <= 2'b00;\n            a_clear_req_b_sync1 <= 2'b00;\n            a_isolate_req_b_sync1 <= 2'b00;\n        end else begin\n            a_status_b_sync1 <= {a_status_b[1], a_status_b[0]};\n            a_clear_req_b_sync1 <= {a_clear_req_b[1], a_clear_req_b[0]};\n            a_isolate_req_b_sync1 <= {a_isolate_req_b[1], a_isolate_req_b[0]};\n        end\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_status_b_sync2 <= 2'b00;\n            a_clear_req_b_sync2 <= 2'b00;\n            a_isolate_req_b_sync2 <= 2'b00;\n        end else begin\n            a_status_b_sync2 <= a_status_b_sync1;\n            a_clear_req_b_sync2 <= a_clear_req_b_sync1;\n            a_isolate_req_b_sync2 <= a_isolate_req_b_sync1;\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Internal State Logic (Domain A)\n    // ------------------------------------------------------------------\n    // State encoding:\n    // 00: IDLE - Waiting for request\n    // 01: ISOLATING - Isolate outputs high, waiting for peer isolate ack\n    // 10: CLEARING - Clear outputs high, waiting for peer clear ack\n    // 11: DONE - Reset released, returning to idle\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            state_a <= STATE_IDLE;\n        else\n            state_a <= next_state_a;\n    end\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_status_a <= 2'b00;\n            b_clear_req_a <= 2'b00;\n            b_isolate_req_a <= 2'b00;\n        end else begin\n            // Update local view of B's state\n            b_status_a <= b_status_a_sync2;\n            b_clear_req_a <= b_clear_req_a_sync2;\n            b_isolate_req_a <= b_isolate_req_a_sync2;\n        end\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_status_b <= 2'b00;\n            a_clear_req_b <= 2'b00;\n            a_isolate_req_b <= 2'b00;\n        end else begin\n            // Update local view of A's state\n            a_status_b <= a_status_b_sync2;\n            a_clear_req_b <= a_clear_req_b_sync2;\n            a_isolate_req_b <= a_isolate_req_b_sync2;\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Next State Logic\n    // ------------------------------------------------------------------\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            next_state_a <= STATE_IDLE;\n        else\n            next_state_a = next_state_a_calc;\n    end\n\n    reg [1:0] next_state_a_calc;\n\n    always @(*) begin\n        next_state_a_calc = STATE_IDLE;\n        \n        case (state_a)\n            STATE_IDLE: begin\n                // Check if either domain requested clear\n                if (a_clear_i || b_clear_req_a) begin\n                    // Transition to Isolating\n                    next_state_a_calc = STATE_ISOLATING;\n                end\n            end\n\n            STATE_ISOLATING: begin\n                // Wait for both isolate acks\n                if (a_isolate_ack_i && b_isolate_ack_i) begin\n                    // Transition to Clearing\n                    next_state_a_calc = STATE_CLEARING;\n                end\n            end\n\n            STATE_CLEARING: begin\n                // Wait for both clear acks\n                if (a_clear_ack_i && b_clear_ack_i) begin\n                    // Transition to Done\n                    next_state_a_calc = STATE_DONE;\n                end\n            end\n\n            STATE_DONE: begin\n                // Wait for both clear inputs to go inactive (release)\n                // AND peer status indicates it is done/idle\n                if (!a_clear_i && !b_clear_req_a && \n                   a_status_b == 2'b00 && b_status_a == 2'b00) begin\n                    next_state_a_calc = STATE_IDLE;\n                end\n            end\n        endcase\n    end\n\n    // ------------------------------------------------------------------\n    // Output Logic\n    // ------------------------------------------------------------------\n    // Drive outputs based on state and peer acknowledgments\n    \n    // Isolate Outputs: High during ISOLATING state\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            a_isolate_o <= 1'b0;\n        else\n            a_isolate_o <= (state_a == STATE_ISOLATING) ? 1'b1 : 1'b0;\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            b_isolate_o <= 1'b0;\n        else\n            b_isolate_o <= (state_a == STATE_ISOLATING) ? 1'b1 : 1'b0;\n    end\n\n    // Clear Outputs: High during CLEARING state\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni)\n            a_clear_o <= 1'b0;\n        else\n            a_clear_o <= (state_a == STATE_CLEARING) ? 1'b1 : 1'b0;\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni)\n            b_clear_o <= 1'b0;\n        else\n            b_clear_o <= (state_a == STATE_CLEARING) ? 1'b1 : 1'b0;\n    end\n\n    // ------------------------------------------------------------------\n    // Internal Request/Status Registers (Domain A)\n    // ------------------------------------------------------------------\n    // These hold the request status for the duration of the handshake\n    // to ensure the state machine sees the request even if the input toggles.\n    \n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_clear_req_b <= 2'b00;\n            a_isolate_req_b <= 2'b00;\n        end else begin\n            a_clear_req_b <= a_clear_req_b_sync2;\n            a_isolate_req_b <= a_isolate_req_b_sync2;\n        end\n    end\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_clear_req_a <= 2'b00;\n            b_isolate_req_a <= 2'b00;\n        end else begin\n            b_clear_req_a <= b_clear_req_a_sync2;\n            b_isolate_req_a <= b_isolate_req_a_sync2;\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
