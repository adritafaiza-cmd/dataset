  "text": "```verilog\nmodule cdc_reset_ctrlr #(\n    parameter SYNC_STAGES = 2\n)(\n    input  wire a_clk_i,\n    input  wire a_rst_ni,\n    input  wire a_clear_i,\n    output reg  a_clear_o,\n    input  wire a_clear_ack_i,\n    output reg  a_isolate_o,\n    input  wire a_isolate_ack_i,\n    input  wire b_clk_i,\n    input  wire b_rst_ni,\n    input  wire b_clear_i,\n    output reg  b_clear_o,\n    input  wire b_clear_ack_i,\n    output reg  b_isolate_o,\n    input  wire b_isolate_ack_i\n);\n\n    localparam STATE_IDLE = 2'b00;\n    localparam STATE_ISOLATING = 2'b01;\n    localparam STATE_CLEARING = 2'b10;\n    localparam STATE_DONE = 2'b11;\n\n    // State machine for the control logic (synchronous to a_clk_i)\n    reg [1:0] state_a;\n    reg [1:0] state_b;\n    \n    // Handshake signals for the state machine\n    reg a_req_clear;\n    reg a_req_isolate;\n    reg a_req_clear_ack;\n    reg a_req_isolate_ack;\n    \n    reg b_req_clear;\n    reg b_req_isolate;\n    reg b_req_clear_ack;\n    reg b_req_isolate_ack;\n\n    // Synchronizers for inputs crossing from b to a\n    reg [SYNC_STAGES-1:0] b_sync_clear;\n    reg [SYNC_STAGES-1:0] b_sync_isolate;\n    reg [SYNC_STAGES-1:0] b_sync_clear_ack;\n    reg [SYNC_STAGES-1:0] b_sync_isolate_ack;\n\n    // Synchronizers for inputs crossing from a to b\n    reg [SYNC_STAGES-1:0] a_sync_clear;\n    reg [SYNC_STAGES-1:0] a_sync_isolate;\n    reg [SYNC_STAGES-1:0] a_sync_clear_ack;\n    reg [SYNC_STAGES-1:0] a_sync_isolate_ack;\n\n    // State machine logic for Domain A\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            state_a <= STATE_IDLE;\n            a_clear_o <= 1'b0;\n            a_isolate_o <= 1'b0;\n        end else begin\n            case (state_a)\n                STATE_IDLE: begin\n                    if (a_clear_i) begin\n                        // Request isolation first\n                        a_req_isolate <= 1'b1;\n                        a_req_clear <= 1'b0;\n                    end\n                end\n                STATE_ISOLATING: begin\n                    // Wait for peer isolation ack and local isolation ack\n                    if (a_req_isolate && a_isolate_ack_i && b_sync_isolate_ack[0]) begin\n                        // Move to clearing state\n                        a_req_isolate <= 1'b0;\n                        a_req_clear <= 1'b1;\n                    end\n                end\n                STATE_CLEARING: begin\n                    // Wait for peer clear ack and local clear ack\n                    if (a_req_clear && a_clear_ack_i && b_sync_clear_ack[0]) begin\n                        // Move to done state\n                        a_req_clear <= 1'b0;\n                        a_req_isolate <= 1'b0;\n                        a_clear_o <= 1'b0;\n                        a_isolate_o <= 1'b0;\n                        state_a <= STATE_IDLE;\n                    end\n                end\n                STATE_DONE: begin\n                    // Stay idle\n                end\n            endcase\n        end\n    end\n\n    // State machine logic for Domain B\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            state_b <= STATE_IDLE;\n            b_clear_o <= 1'b0;\n            b_isolate_o <= 1'b0;\n        end else begin\n            case (state_b)\n                STATE_IDLE: begin\n                    if (b_clear_i) begin\n                        // Request isolation first\n                        b_req_isolate <= 1'b1;\n                        b_req_clear <= 1'b0;\n                    end\n                end\n                STATE_ISOLATING: begin\n                    // Wait for peer isolation ack and local isolation ack\n                    if (b_req_isolate && b_isolate_ack_i && a_sync_isolate_ack[0]) begin\n                        // Move to clearing state\n                        b_req_isolate <= 1'b0;\n                        b_req_clear <= 1'b1;\n                    end\n                end\n                STATE_CLEARING: begin\n                    // Wait for peer clear ack and local clear ack\n                    if (b_req_clear && b_clear_ack_i && a_sync_clear_ack[0]) begin\n                        // Move to done state\n                        b_req_clear <= 1'b0;\n                        b_req_isolate <= 1'b0;\n                        b_clear_o <= 1'b0;\n                        b_isolate_o <= 1'b0;\n                        state_b <= STATE_IDLE;\n                    end\n                end\n                STATE_DONE: begin\n                    // Stay idle\n                end\n            endcase\n        end\n    end\n\n    // Output logic for Domain A\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            a_clear_o <= 1'b0;\n            a_isolate_o <= 1'b0;\n        end else begin\n            if (state_a == STATE_ISOLATING) begin\n                a_isolate_o <= 1'b1;\n            end else if (state_a == STATE_CLEARING) begin\n                a_clear_o <= 1'b1;\n                a_isolate_o <= 1'b1;\n            end else begin\n                a_clear_o <= 1'b0;\n                a_isolate_o <= 1'b0;\n            end\n        end\n    end\n\n    // Output logic for Domain B\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            b_clear_o <= 1'b0;\n            b_isolate_o <= 1'b0;\n        end else begin\n            if (state_b == STATE_ISOLATING) begin\n                b_isolate_o <= 1'b1;\n            end else if (state_b == STATE_CLEARING) begin\n                b_clear_o <= 1'b1;\n                b_isolate_o <= 1'b1;\n            end else begin\n                b_clear_o <= 1'b0;\n                b_isolate_o <= 1'b0;\n            end\n        end\n    end\n\n    // Synchronizers: b -> a\n    genvar i;\n    generate\n        for (i = 0; i < SYNC_STAGES; i = i + 1) begin : sync_b_to_a\n            reg sync_reg;\n            if (i == 0)\n                sync_reg = b_clear_i;\n            else\n                sync_reg = sync_reg_prev[i-1];\n            \n            always @(posedge a_clk_i or negedge a_rst_ni) begin\n                if (!a_rst_ni)\n                    sync_reg <= 1'b0;\n                else\n                    sync_reg <= sync_reg_prev[i-1];\n            end\n        end\n    endgenerate\n\n    // Re-implementing the sync chain properly with registers\n    reg [SYNC_STAGES-1:0] b_sync_clear_reg;\n    reg [SYNC_STAGES-1:0] b_sync_isolate_reg;\n    reg [SYNC_STAGES-1:0] b_sync_clear_ack_reg;\n    reg [SYNC_STAGES-1:0] b_sync_isolate_ack_reg;\n\n    always @(posedge a_clk_i or negedge a_rst_ni) begin\n        if (!a_rst_ni) begin\n            b_sync_clear_reg <= {SYNC_STAGES{1'b0}};\n            b_sync_isolate_reg <= {SYNC_STAGES{1'b0}};\n            b_sync_clear_ack_reg <= {SYNC_STAGES{1'b0}};\n            b_sync_isolate_ack_reg <= {SYNC_STAGES{1'b0}};\n        end else begin\n            b_sync_clear_reg <= {b_sync_clear_reg[SYNC_STAGES-1:1], b_clear_i};\n            b_sync_isolate_reg <= {b_sync_isolate_reg[SYNC_STAGES-1:1], b_isolate_o}; // Wait for output\n            b_sync_clear_ack_reg <= {b_sync_clear_ack_reg[SYNC_STAGES-1:1], b_clear_ack_i};\n            b_sync_isolate_ack_reg <= {b_sync_isolate_ack_reg[SYNC_STAGES-1:1], b_isolate_ack_i};\n        end\n    end\n\n    // Synchronizers: a -> b\n    reg [SYNC_STAGES-1:0] a_sync_clear_reg;\n    reg [SYNC_STAGES-1:0] a_sync_isolate_reg;\n    reg [SYNC_STAGES-1:0] a_sync_clear_ack_reg;\n    reg [SYNC_STAGES-1:0] a_sync_isolate_ack_reg;\n\n    always @(posedge b_clk_i or negedge b_rst_ni) begin\n        if (!b_rst_ni) begin\n            a_sync_clear_reg <= {SYNC_STAGES{1'b0}};\n            a_sync_isolate_reg <= {SYNC_STAGES{1'b0}};\n            a_sync_clear_ack_reg <= {SYNC_STAGES{1'b0}};\n            a_sync_isolate_ack_reg <= {SYNC_STAGES{1'b0}};\n        end else begin\n            a_sync_clear_reg <= {a_sync_clear_reg[SYNC_STAGES-1:1], a_clear_i};\n            a_sync_isolate_reg <= {a_sync_isolate_reg[SYNC_STAGES-1:1], a_isolate_o}; // Wait for output\n            a_sync_clear_ack_reg <= {a_sync_clear_ack_reg[SYNC_STAGES-1:1], a_clear_ack_i};\n            a_sync_isolate_ack_reg <= {a_sync_isolate_ack_reg[SYNC_STAGES-1:1], a_isolate_ack_i};\n        end\n    end\n\n    // Note: The state machines use the last stage of the synchronizer to detect the signal\n    // from the other domain.\n    // b_sync_clear[0] is the first stage, b_sync_clear[SYNC_STAGES-1] is the last.\n    // We use the last stage for the handshake condition.\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
