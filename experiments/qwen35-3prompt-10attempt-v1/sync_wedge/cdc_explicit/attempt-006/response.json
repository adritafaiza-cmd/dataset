{
  "text": "module sync_wedge #(\n    parameter STAGES = 2\n)(\n    input  wire clk_i,\n    input  wire rst_ni,\n    input  wire en_i,\n    input  wire serial_i,\n    output wire r_edge_o,\n    output wire f_edge_o,\n    output wire serial_o\n);\n\n    // Synchronize the asynchronous input bit\n    wire [STAGES-1:0] sync_serial;\n    genvar i;\n    generate\n        for (i = 0; i < STAGES; i = i + 1) begin : sync_stage\n            if (i == 0) begin : first_sync\n                always @(posedge clk_i or negedge rst_ni) begin\n                    if (!rst_ni)\n                        sync_serial[i] <= 1'b0;\n                    else\n                        sync_serial[i] <= serial_i;\n                end\n            end else begin : subsequent_sync\n                always @(posedge clk_i or negedge rst_ni) begin\n                    if (!rst_ni)\n                        sync_serial[i] <= 1'b0;\n                    else\n                        sync_serial[i] <= sync_serial[i-1];\n                end\n            end\n        end\n    endgenerate\n\n    // Detect edges on the synchronized signal\n    wire sync_rising;\n    wire sync_falling;\n\n    assign sync_rising = sync_serial[STAGES-1] & ~sync_serial[STAGES-2];\n    assign sync_falling = ~sync_serial[STAGES-1] & sync_serial[STAGES-2];\n\n    // Generate single-cycle edge pulses\n    reg r_edge_pulse;\n    reg f_edge_pulse;\n\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            r_edge_pulse <= 1'b0;\n            f_edge_pulse <= 1'b0;\n        end else begin\n            r_edge_pulse <= sync_rising;\n            f_edge_pulse <= sync_falling;\n        end\n    end\n\n    // Assign outputs\n    assign r_edge_o = r_edge_pulse;\n    assign f_edge_o = f_edge_pulse;\n    assign serial_o = sync_serial[STAGES-1];\n\nendmodule<|im_end|>\n<|endoftext|>",
