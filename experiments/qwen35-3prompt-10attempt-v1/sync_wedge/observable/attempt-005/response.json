{
  "text": "```verilog\nmodule sync_wedge #(\n    parameter STAGES = 2\n)(\n    input  clk_i,\n    input  rst_ni,\n    input  en_i,\n    input  serial_i,\n    output r_edge_o,\n    output f_edge_o,\n    output serial_o\n);\n\n    // Synchronous register array for the FIFO-like structure\n    // We use a shift register approach to synchronize the bit\n    reg [STAGES-1:0] sync_reg;\n    \n    // Edge detection registers in the destination clock domain\n    reg r_edge_det;\n    reg f_edge_det;\n    \n    // Output registers for the edge flags\n    reg r_edge_o_reg;\n    reg f_edge_o_reg;\n    \n    // Internal signal for the synchronized bit before edge detection logic\n    wire sync_bit;\n\n    // Synchronize the input bit through STAGES flip-flops\n    // First stage captures the input on the first clock edge\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            sync_reg <= {STAGES{1'b0}};\n        end else begin\n            sync_reg <= {sync_reg[STAGES-2:0], serial_i};\n        end\n    end\n\n    // The last stage of the shift register holds the synchronized bit\n    assign sync_bit = sync_reg[STAGES-1];\n\n    // Edge detection logic in the destination clock domain\n    // Rising edge: current bit is 1, previous bit was 0\n    // Falling edge: current bit is 0, previous bit was 1\n    // We use the second-to-last stage to represent the \"previous\" bit relative to the current sync_bit\n    assign r_edge_det = (sync_bit == 1'b1) && (sync_reg[STAGES-2] == 1'b0);\n    assign f_edge_det = (sync_bit == 1'b0) && (sync_reg[STAGES-2] == 1'b1);\n\n    // Output registers for edge detection\n    // These are gated by en_i to ensure outputs only change when enabled\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            r_edge_o_reg <= 1'b0;\n            f_edge_o_reg <= 1'b0;\n        end else if (en_i) begin\n            r_edge_o_reg <= r_edge_det;\n            f_edge_o_reg <= f_edge_det;\n        end\n    end\n\n    // Assign outputs\n    assign r_edge_o = r_edge_o_reg;\n    assign f_edge_o = f_edge_o_reg;\n    // The synchronized bit is the output\n    assign serial_o = sync_bit;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
