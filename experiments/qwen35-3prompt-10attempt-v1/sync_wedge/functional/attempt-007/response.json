{
  "text": "module sync_wedge #(\n    parameter STAGES = 2\n)(\n    input  wire clk_i,\n    input  wire rst_ni,\n    input  wire en_i,\n    input  wire serial_i,\n    output reg  r_edge_o,\n    output reg  f_edge_o,\n    output reg  serial_o\n);\n\n    // Synchronized data register\n    reg [STAGES-1:0] sync_data;\n\n    // Edge detection registers\n    reg [STAGES-1:0] prev_data;\n    reg [STAGES-1:0] curr_data;\n\n    // Synchronize serial_i to clk_i\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            sync_data <= '{default: 1'b0};\n            prev_data <= '{default: 1'b0};\n            curr_data <= '{default: 1'b0};\n            r_edge_o   <= 1'b0;\n            f_edge_o   <= 1'b0;\n            serial_o   <= 1'b0;\n        end else begin\n            sync_data <= serial_i;\n            serial_o  <= sync_data[STAGES-1];\n        end\n    end\n\n    // Detect rising edge (0 -> 1)\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            r_edge_o <= 1'b0;\n        end else begin\n            // Check if previous stage was 0 and current stage is 1\n            if (sync_data[STAGES-1] && !sync_data[STAGES-2]) begin\n                r_edge_o <= 1'b1;\n            end else begin\n                r_edge_o <= 1'b0;\n            end\n        end\n    end\n\n    // Detect falling edge (1 -> 0)\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            f_edge_o <= 1'b0;\n        end else begin\n            // Check if previous stage was 1 and current stage is 0\n            if (!sync_data[STAGES-1] && sync_data[STAGES-2]) begin\n                f_edge_o <= 1'b1;\n            end else begin\n                f_edge_o <= 1'b0;\n            end\n        end\n    end\n\nendmodule<|im_end|>\n<|endoftext|>",
