{
  "text": "```verilog\nmodule sync_wedge #(\n    parameter STAGES = 2\n)(\n    input  wire clk_i,\n    input  wire rst_ni,\n    input  wire en_i,\n    input  wire serial_i,\n    output wire r_edge_o,\n    output wire f_edge_o,\n    output wire serial_o\n);\n\n    // Synchronized data output\n    reg serial_o;\n    // Internal state for edge detection\n    reg sync_data;\n    reg prev_sync_data;\n\n    // Synchronizer chain\n    genvar i;\n    generate\n        for (i = 0; i < STAGES; i = i + 1) begin : sync_chain\n            reg sync_reg;\n            if (i == 0)\n                assign sync_reg = serial_i;\n            else\n                assign sync_reg = sync_data;\n\n            always @(posedge clk_i or negedge rst_ni) begin\n                if (!rst_ni)\n                    sync_reg <= 1'b0;\n                else\n                    sync_reg <= sync_data;\n            end\n\n            if (i == STAGES - 1) begin\n                assign serial_o = sync_reg;\n                assign sync_data = sync_reg;\n            end\n        end\n    endgenerate\n\n    // Edge detection logic\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            r_edge_o <= 1'b0;\n            f_edge_o <= 1'b0;\n        end else begin\n            // Rising edge detection\n            if (en_i && (sync_data && !prev_sync_data))\n                r_edge_o <= 1'b1;\n            else\n                r_edge_o <= 1'b0;\n\n            // Falling edge detection\n            if (en_i && (!sync_data && prev_sync_data))\n                f_edge_o <= 1'b1;\n            else\n                f_edge_o <= 1'b0;\n\n            // Update previous state\n            prev_sync_data <= sync_data;\n        end\n    end\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
