{
  "text": "module sync_wedge #(\n    parameter STAGES = 2\n)(\n    input  wire clk_i,\n    input  wire rst_ni,\n    input  wire en_i,\n    input  wire serial_i,\n    output wire r_edge_o,\n    output wire f_edge_o,\n    output wire serial_o\n);\n\n    // Synchronized data output\n    reg serial_sync;\n\n    // Edge detection flags\n    reg r_edge_flag;\n    reg f_edge_flag;\n\n    // Synchronizer chain for serial_i\n    genvar i;\n    reg [STAGES-1:0] sync_chain;\n\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni)\n            sync_chain <= {STAGES{1'b0}};\n        else begin\n            sync_chain <= {sync_chain[STAGES-2:0], serial_i};\n        end\n    end\n\n    // Assign synchronized output\n    assign serial_o = sync_chain[STAGES-1];\n\n    // Edge detection logic on synchronized data\n    // Rising edge: current is 1, previous was 0\n    // Falling edge: current is 0, previous was 1\n    always @(posedge clk_i or negedge rst_ni) begin\n        if (!rst_ni) begin\n            r_edge_flag <= 1'b0;\n            f_edge_flag <= 1'b0;\n        end else begin\n            // Detect rising edge\n            if (sync_chain[STAGES-1] && !sync_chain[STAGES-2])\n                r_edge_flag <= 1'b1;\n            else\n                r_edge_flag <= 1'b0;\n\n            // Detect falling edge\n            if (!sync_chain[STAGES-1] && sync_chain[STAGES-2])\n                f_edge_flag <= 1'b1;\n            else\n                f_edge_flag <= 1'b0;\n        end\n    end\n\n    // Output edge pulses gated by enable\n    assign r_edge_o = en_i ? r_edge_flag : 1'b0;\n    assign f_edge_o = en_i ? f_edge_flag : 1'b0;\n\nendmodule<|im_end|>\n<|endoftext|>",
