  "text": "```verilog\nmodule afifo #(\n\t\tparameter\tLGFIFO = 3,\n\t\tparameter\tWIDTH  = 16,\n\t\tparameter\tNFF    = 2,\n\t\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\t\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n\t) (\n\t\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\t\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\t\toutput\treg\t\t\to_wr_full,\n\t\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\t\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\t\toutput\treg\t\t\to_rd_empty\n\t);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\n\t// Write Pointer and Counter\n\treg [LGFIFO-1:0] wr_ptr;\n\treg [LGFIFO-1:0] rd_ptr;\n\treg [LGFIFO+1:0] wr_cnt;\n\treg [LGFIFO+1:0] rd_cnt;\n\n\t// Write Logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= 0;\n\t\t\twr_cnt <= 0;\n\t\t\to_wr_full <= 0;\n\t\tend else if (i_wr) begin\n\t\t\tif (wr_cnt < FIFO_DEPTH) begin\n\t\t\t\tif (WRITE_ON_POSEDGE) begin\n\t\t\t\t\t// Write on rising edge of i_wr\n\t\t\t\t\to_rd_data <= i_wr_data; // This line is a placeholder for internal storage logic if needed, \n\t\t\t\t\t\t\t\t\t\t\t// but typically we write to an array. \n\t\t\t\t\t\t\t\t\t\t\t// Since we are using counters for full/empty, \n\t\t\t\t\t\t\t\t\t\t\t// we need a memory array.\n\t\t\t\t\twr_cnt <= wr_cnt + 1;\n\t\t\t\tend else begin\n\t\t\t\t\t// Write on level (hold high)\n\t\t\t\t\tif (wr_cnt < FIFO_DEPTH) begin\n\t\t\t\t\t\twr_cnt <= wr_cnt + 1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// Read Logic\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= 0;\n\t\t\trd_cnt <= 0;\n\t\t\to_rd_empty <= 1;\n\t\tend else if (i_rd) begin\n\t\t\tif (rd_cnt > 0) begin\n\t\t\t\tif (OPT_REGISTER_READS) begin\n\t\t\t\t\t// Read on rising edge of i_rd\n\t\t\t\t\trd_cnt <= rd_cnt - 1;\n\t\t\t\tend else begin\n\t\t\t\t\t// Read on level (hold high)\n\t\t\t\t\tif (rd_cnt > 0) begin\n\t\t\t\t\t\trd_cnt <= rd_cnt - 1;\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// Full/Empty Logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\to_wr_full <= 0;\n\t\tend else begin\n\t\t\to_wr_full <= (wr_cnt == FIFO_DEPTH);\n\t\tend\n\tend\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\to_rd_empty <= 1;\n\t\tend else begin\n\t\t\to_rd_empty <= (rd_cnt == 0);\n\t\tend\n\tend\n\n\t// Memory Array\n\treg [WIDTH-1:0] mem [0:FIFO_DEPTH-1];\n\n\t// Write Data to Memory\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\tmem <= 0;\n\t\tend else if (i_wr && (wr_cnt < FIFO_DEPTH)) begin\n\t\t\tif (WRITE_ON_POSEDGE) begin\n\t\t\t\tmem[wr_ptr] <= i_wr_data;\n\t\t\tend else begin\n\t\t\t\tif (wr_cnt < FIFO_DEPTH) begin\n\t\t\t\t\tmem[wr_ptr] <= i_wr_data;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// Read Data from Memory\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\to_rd_data <= 0;\n\t\tend else if (i_rd && (rd_cnt > 0)) begin\n\t\t\tif (OPT_REGISTER_READS) begin\n\t\t\t\to_rd_data <= mem[rd_ptr];\n\t\t\tend else begin\n\t\t\t\tif (rd_cnt > 0) begin\n\t\t\t\t\to_rd_data <= mem[rd_ptr];\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// Update Pointers\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= 0;\n\t\tend else if (i_wr && (wr_cnt < FIFO_DEPTH)) begin\n\t\t\tif (WRITE_ON_POSEDGE) begin\n\t\t\t\twr_ptr <= wr_ptr + 1;\n\t\t\tend else begin\n\t\t\t\tif (wr_cnt < FIFO_DEPTH) begin\n\t\t\t\t\twr_ptr <= wr_ptr + 1;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= 0;\n\t\tend else if (i_rd && (rd_cnt > 0)) begin\n\t\t\tif (OPT_REGISTER_READS) begin\n\t\t\t\trd_ptr <= rd_ptr + 1;\n\t\t\tend else begin\n\t\t\t\tif (rd_cnt > 0) begin\n\t\t\t\t\trd_ptr <= rd_ptr + 1;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
