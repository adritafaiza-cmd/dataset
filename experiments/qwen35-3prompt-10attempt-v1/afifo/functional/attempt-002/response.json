  "text": "```verilog\n`timescale 1ns/1ps\n\nmodule afifo #(\n\tparameter LGFIFO = 3,\n\tparameter WIDTH  = 16,\n\tparameter NFF    = 2,\n\tparameter [0:0] WRITE_ON_POSEDGE = 1'b1,\n\tparameter [0:0] OPT_REGISTER_READS = 1'b1\n) (\n\tinput  wire i_wclk, i_wr_reset_n, i_wr,\n\tinput  wire [WIDTH-1:0] i_wr_data,\n\toutput reg o_wr_full,\n\tinput  wire i_rclk, i_rd_reset_n, i_rd,\n\toutput reg [WIDTH-1:0] o_rd_data,\n\toutput reg o_rd_empty\n);\n\n\tlocalparam FIFO_DEPTH = 1 << LGFIFO;\n\tlocalparam GRAY_WIDTH = LGFIFO;\n\n\t// Gray code generator for address\n\treg [GRAY_WIDTH-1:0] gray_addr_w, gray_addr_r;\n\treg [GRAY_WIDTH-1:0] next_gray_addr;\n\n\t// Write pointer logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\tgray_addr_w <= 0;\n\t\telse if (i_wr && !o_wr_full) begin\n\t\t\tif (WRITE_ON_POSEDGE)\n\t\t\t\tgray_addr_w <= next_gray_addr;\n\t\t\telse\n\t\t\t\tgray_addr_w <= next_gray_addr;\n\t\tend\n\tend\n\n\t// Read pointer logic\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\tgray_addr_r <= 0;\n\t\telse if (i_rd && !o_rd_empty) begin\n\t\t\tgray_addr_r <= next_gray_addr;\n\t\tend\n\tend\n\n\t// Generate next Gray code\n\talways @(*) begin\n\t\tnext_gray_addr = gray_addr_w;\n\t\tif (WRITE_ON_POSEDGE)\n\t\t\tnext_gray_addr = gray_addr_w;\n\t\telse\n\t\t\tnext_gray_addr = gray_addr_w;\n\tend\n\n\t// Gray to binary conversion\n\tfunction [GRAY_WIDTH-1:0] gray2bin;\n\t\tinput [GRAY_WIDTH-1:0] gray;\n\t\treg [GRAY_WIDTH-1:0] bin;\n\t\treg [GRAY_WIDTH-1:0] mask;\n\t\treg carry;\n\t\tbegin\n\t\t\tbin = 0;\n\t\t\tcarry = 1'b1;\n\t\t\tmask = 1;\n\t\t\tfor (integer i = GRAY_WIDTH-1; i >= 0; i = i - 1) begin\n\t\t\t\tbin[i] = gray[i] ^ carry;\n\t\t\t\tcarry = carry ^ gray[i];\n\t\t\t\tmask = mask << 1;\n\t\t\tend\n\t\t\tgray2bin = bin;\n\t\tend\n\tendfunction\n\n\t// Binary to Gray conversion\n\tfunction [GRAY_WIDTH-1:0] bin2gray;\n\t\tinput [GRAY_WIDTH-1:0] bin;\n\t\treg [GRAY_WIDTH-1:0] gray;\n\t\treg [GRAY_WIDTH-1:0] mask;\n\t\treg carry;\n\t\tbegin\n\t\t\tgray = 0;\n\t\t\tcarry = 1'b1;\n\t\t\tmask = 1;\n\t\t\tfor (integer i = GRAY_WIDTH-1; i >= 0; i = i - 1) begin\n\t\t\t\tgray[i] = bin[i] ^ carry;\n\t\t\t\tcarry = carry ^ bin[i];\n\t\t\t\tmask = mask << 1;\n\t\t\tend\n\t\t\tbin2gray = gray;\n\t\tendfunction\n\n\t// Write pointer (binary)\n\treg [LGFIFO-1:0] wr_ptr;\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\twr_ptr <= 0;\n\t\telse if (i_wr && !o_wr_full)\n\t\t\twr_ptr <= wr_ptr + 1;\n\tend\n\n\t// Read pointer (binary)\n\treg [LGFIFO-1:0] rd_ptr;\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\trd_ptr <= 0;\n\t\telse if (i_rd && !o_rd_empty)\n\t\t\trd_ptr <= rd_ptr + 1;\n\tend\n\n\t// Full flag\n\tassign o_wr_full = (wr_ptr == (FIFO_DEPTH - 1)) && (rd_ptr == 0);\n\n\t// Empty flag\n\tassign o_rd_empty = (rd_ptr == 0) && (wr_ptr == 0);\n\n\t// FIFO memory\n\treg [WIDTH-1:0] mem [0:FIFO_DEPTH-1];\n\treg [LGFIFO-1:0] wr_ptr_gray, rd_ptr_gray;\n\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\tmem <= 0;\n\t\t\twr_ptr_gray <= 0;\n\t\tend\n\t\telse if (i_wr && !o_wr_full) begin\n\t\t\tmem[wr_ptr_gray] <= i_wr_data;\n\t\t\twr_ptr_gray <= next_gray_addr;\n\t\tend\n\tend\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\to_rd_data <= 0;\n\t\t\trd_ptr_gray <= 0;\n\t\tend\n\t\telse if (i_rd && !o_rd_empty) begin\n\t\t\tif (OPT_REGISTER_READS)\n\t\t\t\to_rd_data <= mem[rd_ptr_gray];\n\t\t\telse\n\t\t\t\to_rd_data <= mem[rd_ptr_gray];\n\t\t\trd_ptr_gray <= next_gray_addr;\n\t\tend\n\tend\n\n\t// Full flag logic for write enable\n\tassign o_wr_full = (wr_ptr_gray == bin2gray(FIFO_DEPTH - 1)) && (rd_ptr_gray == 0);\n\n\t// Empty flag logic for read enable\n\tassign o_rd_empty = (rd_ptr_gray == 0) && (wr_ptr_gray == 0);\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
