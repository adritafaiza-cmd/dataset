  "text": "```verilog\nmodule afifo #(\n\tparameter\tLGFIFO = 3,\n\tparameter\tWIDTH  = 16,\n\tparameter\tNFF    = 2,\n\tparameter [0:0]\tWRITE_ON_POSEDGE = 1'b1,\n\tparameter [0:0]\tOPT_REGISTER_READS = 1'b1\n) (\n\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\toutput\treg\t\t\to_wr_full,\n\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\toutput\treg\t\t\to_rd_empty\n);\n\n\tlocalparam\tFIFO_DEPTH = 1 << LGFIFO;\n\n\t// Write pointer and counter\n\treg [LGFIFO-1:0]\tw_ptr;\n\treg [LGFIFO-1:0]\tw_cnt;\n\n\t// Read pointer and counter\n\treg [LGFIFO-1:0]\tr_ptr;\n\treg [LGFIFO-1:0]\tr_cnt;\n\n\t// Data memory\n\treg [WIDTH-1:0]\tmem [FIFO_DEPTH-1:0];\n\n\t// Full flag logic\n\treg\t\t\tfull_flag;\n\n\t// Empty flag logic (internal)\n\treg\t\t\tempty_flag;\n\n\t// Write stage registers\n\treg [WIDTH-1:0]\tw_reg;\n\treg\t\t\tw_reg_valid;\n\n\t// Read stage registers\n\treg [WIDTH-1:0]\tr_reg;\n\treg\t\t\tr_reg_valid;\n\n\t// ---------------------------------------------------------\n\t// Write Logic\n\t// ---------------------------------------------------------\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\tw_ptr     <= 0;\n\t\t\tw_cnt     <= 0;\n\t\t\tw_reg     <= 0;\n\t\t\tw_reg_valid <= 0;\n\t\t\tfull_flag <= 0;\n\t\tend else begin\n\t\t\t// Check for full condition\n\t\t\tif (w_cnt == (FIFO_DEPTH - 1)) begin\n\t\t\t\tfull_flag <= 1;\n\t\t\tend else begin\n\t\t\t\tfull_flag <= 0;\n\t\t\tend\n\n\t\t\t// Write enable logic\n\t\t\tif (i_wr && !full_flag) begin\n\t\t\t\tif (WRITE_ON_POSEDGE) begin\n\t\t\t\t\t// Sample on rising edge of i_wr\n\t\t\t\t\tif (i_wr) begin\n\t\t\t\t\t\tw_reg <= i_wr_data;\n\t\t\t\t\t\tw_reg_valid <= 1;\n\t\t\t\t\tend\n\t\t\t\tend else begin\n\t\t\t\t\t// Level sensitive\n\t\t\t\t\tw_reg <= i_wr_data;\n\t\t\t\t\tw_reg_valid <= 1;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// Update write pointer and memory\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\tw_ptr <= 0;\n\t\tend else begin\n\t\t\tif (w_reg_valid && !full_flag) begin\n\t\t\t\tmem[w_ptr] <= w_reg;\n\t\t\t\tw_ptr <= w_ptr + 1;\n\t\t\t\tw_reg_valid <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// ---------------------------------------------------------\n\t// Read Logic\n\t// ---------------------------------------------------------\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\tr_ptr     <= 0;\n\t\t\tr_cnt     <= 0;\n\t\t\tr_reg     <= 0;\n\t\t\tr_reg_valid <= 0;\n\t\t\tempty_flag <= 1;\n\t\tend else begin\n\t\t\t// Check for empty condition\n\t\t\tif (r_cnt == 0) begin\n\t\t\t\tempty_flag <= 1;\n\t\t\tend else begin\n\t\t\t\tempty_flag <= 0;\n\t\t\tend\n\n\t\t\t// Read enable logic\n\t\t\tif (i_rd && !empty_flag) begin\n\t\t\t\tif (OPT_REGISTER_READS) begin\n\t\t\t\t\t// Sample on rising edge of i_rd\n\t\t\t\t\tif (i_rd) begin\n\t\t\t\t\t\tr_reg <= mem[r_ptr];\n\t\t\t\t\t\tr_reg_valid <= 1;\n\t\t\t\t\tend\n\t\t\t\tend else begin\n\t\t\t\t\t// Level sensitive\n\t\t\t\t\tr_reg <= mem[r_ptr];\n\t\t\t\t\tr_reg_valid <= 1;\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\t// Update read pointer and memory\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\tr_ptr <= 0;\n\t\tend else begin\n\t\t\tif (r_reg_valid && !empty_flag) begin\n\t\t\t\tmem[r_ptr] <= mem[r_ptr]; // No-op to keep data stable if needed, but pointer moves\n\t\t\t\tr_ptr <= r_ptr + 1;\n\t\t\t\tr_reg_valid <= 0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// ---------------------------------------------------------\n\t// Output Logic\n\t// ---------------------------------------------------------\n\t// o_wr_full is driven by full_flag\n\tassign o_wr_full = full_flag;\n\n\t// o_rd_data is driven by r_reg\n\tassign o_rd_data = r_reg;\n\n\t// o_rd_empty is driven by empty_flag\n\tassign o_rd_empty = empty_flag;\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
