  "text": "```verilog\nmodule afifo #(\n\tparameter LGFIFO = 3,\n\tparameter WIDTH  = 16,\n\tparameter NFF    = 2,\n\tparameter [0:0] WRITE_ON_POSEDGE = 1'b1,\n\tparameter [0:0] OPT_REGISTER_READS = 1'b1\n) (\n\tinput\twire\t\t\ti_wclk, i_wr_reset_n, i_wr,\n\tinput\twire\t[WIDTH-1:0]\ti_wr_data,\n\toutput\treg\t\t\to_wr_full,\n\tinput\twire\t\t\ti_rclk, i_rd_reset_n, i_rd,\n\toutput\treg\t[WIDTH-1:0]\to_rd_data,\n\toutput\treg\t\t\to_rd_empty\n);\n\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam MASK  = DEPTH - 1;\n\n\t// Write pointer and counter\n\treg [LGFIFO-1:0] wr_ptr;\n\treg [LGFIFO-1:0] wr_cnt;\n\n\t// Read pointer and counter\n\treg [LGFIFO-1:0] rd_ptr;\n\treg [LGFIFO-1:0] rd_cnt;\n\n\t// Gray code pointers for cross-clock domain signaling\n\treg [LGFIFO-1:0] wr_gray;\n\treg [LGFIFO-1:0] rd_gray;\n\n\t// Internal pointers for data access\n\treg [LGFIFO-1:0] wr_ptr_int;\n\treg [LGFIFO-1:0] rd_ptr_int;\n\n\t// FIFO Memory\n\treg [WIDTH-1:0] mem [DEPTH-1:0];\n\n\t// Write side logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= '0;\n\t\t\twr_cnt <= '0;\n\t\t\twr_gray <= '0;\n\t\t\to_wr_full <= 1'b0;\n\t\tend else begin\n\t\t\tif (i_wr) begin\n\t\t\t\t// Calculate write index\n\t\t\t\twr_ptr_int <= wr_ptr;\n\t\t\t\t\n\t\t\t\t// Update counter\n\t\t\t\tif (wr_cnt == MASK) begin\n\t\t\t\t\twr_cnt <= '0;\n\t\t\t\tend else begin\n\t\t\t\t\twr_cnt <= wr_cnt + 1'b1;\n\t\t\t\tend\n\t\t\t\t\n\t\t\t\t// Update Gray code pointer\n\t\t\t\twr_gray <= wr_ptr ^ (wr_ptr >> 1);\n\t\t\t\t\n\t\t\t\t// Write data to memory\n\t\t\t\tmem[wr_ptr_int] <= i_wr_data;\n\t\t\t\t\n\t\t\t\t// Update full flag\n\t\t\t\tif (wr_cnt == MASK) begin\n\t\t\t\t\to_wr_full <= 1'b1;\n\t\t\t\tend else begin\n\t\t\t\t\to_wr_full <= 1'b0;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\t// Idle state: maintain current state\n\t\t\t\twr_ptr <= wr_ptr;\n\t\t\t\twr_cnt <= wr_cnt;\n\t\t\t\twr_gray <= wr_gray;\n\t\t\t\to_wr_full <= 1'b0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Read side logic\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= '0;\n\t\t\trd_cnt <= '0;\n\t\t\trd_gray <= '0;\n\t\t\to_rd_empty <= 1'b1;\n\t\t\to_rd_data <= '0;\n\t\tend else begin\n\t\t\tif (i_rd) begin\n\t\t\t\t// Calculate read index\n\t\t\t\trd_ptr_int <= rd_ptr;\n\t\t\t\t\n\t\t\t\t// Update counter\n\t\t\t\tif (rd_cnt == '0) begin\n\t\t\t\t\trd_cnt <= '0;\n\t\t\t\tend else begin\n\t\t\t\t\trd_cnt <= rd_cnt - 1'b1;\n\t\t\t\tend\n\t\t\t\t\n\t\t\t\t// Update Gray code pointer\n\t\t\t\trd_gray <= rd_ptr ^ (rd_ptr >> 1);\n\t\t\t\t\n\t\t\t\t// Read data from memory\n\t\t\t\to_rd_data <= mem[rd_ptr_int];\n\t\t\t\t\n\t\t\t\t// Update empty flag\n\t\t\t\tif (rd_cnt == '0) begin\n\t\t\t\t\to_rd_empty <= 1'b1;\n\t\t\t\tend else begin\n\t\t\t\t\to_rd_empty <= 1'b0;\n\t\t\t\tend\n\t\t\tend else begin\n\t\t\t\t// Idle state: maintain current state\n\t\t\t\trd_ptr <= rd_ptr;\n\t\t\t\trd_cnt <= rd_cnt;\n\t\t\t\trd_gray <= rd_gray;\n\t\t\t\to_rd_empty <= 1'b1;\n\t\t\t\to_rd_data <= '0;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Cross-clock domain synchronization for pointers\n\t// Write side: synchronize read gray code to write domain\n\treg [LGFIFO-1:0] rd_gray_sync;\n\treg [LGFIFO-1:0] rd_gray_sync_d1;\n\treg [LGFIFO-1:0] rd_gray_sync_d2;\n\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\trd_gray_sync <= '0;\n\t\t\trd_gray_sync_d1 <= '0;\n\t\t\trd_gray_sync_d2 <= '0;\n\t\tend else begin\n\t\t\trd_gray_sync <= rd_gray;\n\t\t\trd_gray_sync_d1 <= rd_gray_sync;\n\t\t\trd_gray_sync_d2 <= rd_gray_sync_d1;\n\t\tend\n\tend\n\n\t// Read side: synchronize write gray code to read domain\n\treg [LGFIFO-1:0] wr_gray_sync;\n\treg [LGFIFO-1:0] wr_gray_sync_d1;\n\treg [LGFIFO-1:0] wr_gray_sync_d2;\n\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\twr_gray_sync <= '0;\n\t\t\twr_gray_sync_d1 <= '0;\n\t\t\twr_gray_sync_d2 <= '0;\n\t\tend else begin\n\t\t\twr_gray_sync <= wr_gray;\n\t\t\twr_gray_sync_d1 <= wr_gray_sync;\n\t\t\twr_gray_sync_d2 <= wr_gray_sync_d1;\n\t\tend\n\tend\n\n\t// Calculate actual pointers from synchronized Gray codes\n\t// Convert Gray code back to binary\n\tfunction [LGFIFO-1:0] gray_to_bin;\n\t\tinput [LGFIFO-1:0] gray;\n\t\treg [LGFIFO-1:0] bin;\n\t\treg [LGFIFO-1:0] temp;\n\t\treg [LGFIFO-1:0] carry;\n\t\t\n\t\tbin = gray;\n\t\ttemp = gray;\n\t\tcarry = 1'b0;\n\t\t\n\t\tfor (integer i = LGFIFO-1; i >= 0; i = i - 1) begin\n\t\t\tbin[i] = temp[i] ^ carry;\n\t\t\tcarry = temp[i];\n\t\tend\n\t\t\n\t\treturn bin;\n\tendfunction\n\n\t// Synchronized write pointer for read side\n\twire [LGFIFO-1:0] wr_ptr_sync = gray_to_bin(wr_gray_sync_d2);\n\t\n\t// Synchronized read pointer for write side\n\twire [LGFIFO-1:0] rd_ptr_sync = gray_to_bin(rd_gray_sync_d2);\n\n\t// Calculate full and empty flags based on synchronized pointers\n\t// Full: write pointer == read pointer + depth (wr_ptr_sync == rd_ptr_sync + DEPTH)\n\t// Empty: write pointer == read pointer (wr_ptr_sync == rd_ptr_sync)\n\t\n\t// Since we are using counters, we can simplify the logic:\n\t// Full: wr_cnt == MASK && wr_ptr_sync == rd_ptr_sync\n\t// Empty: rd_cnt == '0 && wr_ptr_sync == rd_ptr_sync\n\t\n\t// However, the problem states: \"o_rd_empty can be high while words remain stored\"\n\t// This is a specific requirement for the empty flag behavior.\n\t// Standard behavior: empty when wr_ptr == rd_ptr\n\t// Modified behavior: empty when rd_cnt == 0 AND wr_ptr_sync == rd_ptr_sync\n\t\n\t// For full flag:\n\t// Full when wr_cnt == MASK AND wr_ptr_sync == rd_ptr_sync\n\t\n\t// Let's implement the flags based on the synchronized pointers and counters\n\t\n\t// Write full flag\n\tassign o_wr_full = (wr_cnt == MASK) && (wr_ptr_sync == rd_ptr_sync);\n\t\n\t// Read empty flag\n\t// The requirement says: \"o_rd_empty can be high while words remain stored\"\n\t// This implies that if rd_cnt is 0, we check if there are actually words.\n\t// If wr_ptr_sync == rd_ptr_sync, then the FIFO is empty.\n\t// If wr_ptr_sync != rd_ptr_sync, then there are words, but rd_cnt is 0.\n\t// So o_rd_empty should be high only when rd_cnt == 0 AND wr_ptr_sync == rd_ptr_sync.\n\t\n\tassign o_rd_empty = (rd_cnt == '0) && (wr_ptr_sync == rd_ptr_sync);\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
