{
  "text": "```verilog\nmodule afifo #(\n\tparameter LGFIFO = 3,\n\tparameter WIDTH  = 16,\n\tparameter NFF    = 2,\n\tparameter [0:0]  WRITE_ON_POSEDGE = 1'b1,\n\tparameter [0:0]  OPT_REGISTER_READS = 1'b1\n) (\n\tinput  wire            i_wclk, i_wr_reset_n, i_wr,\n\tinput  wire [WIDTH-1:0] i_wr_data,\n\toutput reg             o_wr_full,\n\tinput  wire            i_rclk, i_rd_reset_n, i_rd,\n\toutput reg [WIDTH-1:0] o_rd_data,\n\toutput reg             o_rd_empty\n);\n\n\tlocalparam DEPTH = 1 << LGFIFO;\n\tlocalparam FULL_THRESHOLD = DEPTH - NFF;\n\tlocalparam EMPTY_THRESHOLD = NFF;\n\n\t// Write side logic\n\treg [DEPTH-1:0] wr_ptr, wr_gray;\n\treg [DEPTH-1:0] rd_ptr, rd_gray;\n\treg [WIDTH-1:0] mem [DEPTH-1:0];\n\treg [LGFIFO-1:0] wr_cnt, rd_cnt;\n\n\t// Write pointer update\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n) begin\n\t\t\twr_ptr <= '0;\n\t\t\twr_gray <= '0;\n\t\t\twr_cnt <= '0;\n\t\tend else if (i_wr) begin\n\t\t\tif (wr_cnt < FULL_THRESHOLD) begin\n\t\t\t\twr_cnt <= wr_cnt + 1'b1;\n\t\t\t\twr_ptr <= wr_ptr + 1'b1;\n\t\t\t\tmem[wr_ptr] <= i_wr_data;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Write pointer to Gray code\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\twr_gray <= '0;\n\t\telse\n\t\t\twr_gray <= wr_ptr ^ (wr_ptr >> (LGFIFO-1));\n\tend\n\n\t// Read pointer update\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\trd_ptr <= '0;\n\t\t\trd_gray <= '0;\n\t\t\trd_cnt <= '0;\n\t\tend else if (i_rd) begin\n\t\t\tif (rd_cnt < EMPTY_THRESHOLD) begin\n\t\t\t\trd_cnt <= rd_cnt + 1'b1;\n\t\t\t\trd_ptr <= rd_ptr + 1'b1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Read pointer to Gray code\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\trd_gray <= '0;\n\t\telse\n\t\t\trd_gray <= rd_ptr ^ (rd_ptr >> (LGFIFO-1));\n\tend\n\n\t// Output data selection\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n) begin\n\t\t\to_rd_data <= '0;\n\t\t\to_rd_empty <= 1'b1;\n\t\tend else if (i_rd) begin\n\t\t\tif (rd_cnt < EMPTY_THRESHOLD) begin\n\t\t\t\to_rd_data <= mem[rd_ptr];\n\t\t\t\to_rd_empty <= 1'b0;\n\t\t\tend else begin\n\t\t\t\to_rd_data <= '0;\n\t\t\t\to_rd_empty <= 1'b1;\n\t\t\tend\n\t\tend\n\tend\n\n\t// Full flag logic\n\talways @(posedge i_wclk or negedge i_wr_reset_n) begin\n\t\tif (!i_wr_reset_n)\n\t\t\to_wr_full <= 1'b0;\n\t\telse if (wr_cnt >= FULL_THRESHOLD)\n\t\t\to_wr_full <= 1'b1;\n\t\telse\n\t\t\to_wr_full <= 1'b0;\n\tend\n\n\t// Empty flag logic (asynchronous comparison with Gray codes)\n\talways @(posedge i_rclk or negedge i_rd_reset_n) begin\n\t\tif (!i_rd_reset_n)\n\t\t\to_rd_empty <= 1'b1;\n\t\telse if (rd_gray == wr_gray)\n\t\t\to_rd_empty <= 1'b1;\n\t\telse if (rd_gray > wr_gray)\n\t\t\to_rd_empty <= 1'b1;\n\t\telse\n\t\t\to_rd_empty <= 1'b0;\n\tend\n\nendmodule\n```<|im_end|>\n<|endoftext|>",
