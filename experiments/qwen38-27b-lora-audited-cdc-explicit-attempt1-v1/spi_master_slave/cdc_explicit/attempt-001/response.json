  "text": "// =============================================================================\n// SPI Master with Parallel-Side Word Interface\n// =============================================================================\n//\n// This module implements an SPI master that transfers N-bit words. It\n// features a parallel-side interface for data input/output and a handshake\n// mechanism for flow control.\n//\n// SPI Mode:\n//   - Mode 0: CPOL=0, CPHA=0 (SCK idle low, data sampled on rising edge)\n//   - MSB first\n//\n// Parallel Interface:\n//   - di_i: Input data (N bits)\n//   - wren_i: Write enable (active high)\n//   - wr_ack_o: Write acknowledge (active high, one cycle)\n//   - do_o: Output data (N bits)\n//   - do_valid_o: Output data valid (active high, one cycle)\n//   - di_req_o: Data input request (active high, one cycle)\n//\n// Clock Domains:\n//   - sclk_i: SPI clock domain (for SPI signal generation)\n//   - pclk_i: Parallel interface clock domain (for handshake)\n//\n// =============================================================================\n\n`timescale 1ns / 1ps\n\nmodule spi_master #(\n    parameter N = 8,\n    parameter SPI_2X_CLK_DIV = 2\n)(\n    input              sclk_i,\n    input              pclk_i,\n    input              rst_i,\n\n    // SPI outputs\n    output reg         spi_ssel_o,\n    output reg         spi_sck_o,\n    output             spi_mosi_o,\n\n    // SPI input\n    input              spi_miso_i,\n\n    // Parallel interface\n    output reg         di_req_o,\n    input  [N-1:0]     di_i,\n    input              wren_i,\n    output reg         wr_ack_o,\n\n    output reg         do_valid_o,\n    output reg [N-1:0] do_o\n);\n\n    // =========================================================================\n    // Reset Synchronization (for safe reset deassertion)\n    // =========================================================================\n\n    // Synchronize reset for sclk domain\n    reg [1:0] rst_sync_sclk;\n    always @(posedge sclk_i or posedge rst_i) begin\n        if (rst_i)\n            rst_sync_sclk <= 2'b11;\n        else\n            rst_sync_sclk <= {rst_sync_sclk[0], 1'b0};\n    end\n    wire rst_sclk = rst_sync_sclk[1];\n\n    // Synchronize reset for pclk domain\n    reg [1:0] rst_sync_pclk;\n    always @(posedge pclk_i or posedge rst_i) begin\n        if (rst_i)\n            rst_sync_pclk <= 2'b11;\n        else\n            rst_sync_pclk <= {rst_sync_pclk[0], 1'b0};\n    end\n    wire rst_pclk = rst_sync_pclk[1];\n\n    // =========================================================================\n    // SPI State Machine (sclk domain)\n    // =========================================================================\n\n    localparam S_IDLE    = 2'd0;\n    localparam S_START   = 2'd1;\n    localparam S_SHIFT   = 2'd2;\n    localparam S_FINISH  = 2'd3;\n\n    reg [1:0]  state;\n    reg [N-1:0] tx_shift;\n    reg [N-1:0] rx_shift;\n    reg [N-1:0] bit_count;\n\n    // Data transfer signals\n    reg         tx_data_valid;\n    reg [N-1:0] tx_data;\n    reg         rx_data_valid;\n    reg [N-1:0] rx_data;\n\n    // =========================================================================\n    // SPI Clock Generation (sclk domain)\n    // =========================================================================\n\n    reg [SPI_2X_CLK_DIV-1:0] clk_div;\n    reg clk_phase;\n\n    always @(posedge sclk_i or posedge rst_sclk) begin\n        if (rst_sclk) begin\n            clk_div   <= {SPI_2X_CLK_DIV{1'b0}};\n            clk_phase <= 1'b0;\n        end else begin\n            if (clk_div == SPI_2X_CLK_DIV - 1) begin\n                clk_div   <= {SPI_2X_CLK_DIV{1'b0}};\n                clk_phase <= ~clk_phase;\n            end else begin\n                clk_div <= clk_div + 1'b1;\n            end\n        end\n    end\n\n    // =========================================================================\n    // SPI State Machine (sclk domain)\n    // =========================================================================\n\n    always @(posedge sclk_i or posedge rst_sclk) begin\n        if (rst_sclk) begin\n            state         <= S_IDLE;\n            spi_ssel_o    <= 1'b1;  // Deselected (active low)\n            spi_sck_o     <= 1'b0;\n            tx_shift      <= {N{1'b0}};\n            rx_shift      <= {N{1'b0}};\n            bit_count     <= {N{1'b0}};\n            tx_data_valid <= 1'b0;\n            tx_data       <= {N{1'b0}};\n            rx_data_valid <= 1'b0;\n            rx_data       <= {N{1'b0}};\n        end else begin\n            case (state)\n                S_IDLE: begin\n                    spi_ssel_o <= 1'b1;\n                    spi_sck_o  <= 1'b0;\n                    if (tx_data_valid) begin\n                        state      <= S_START;\n                        tx_shift   <= tx_data;\n                        rx_shift   <= {N{1'b0}};\n                        bit_count  <= {N{1'b0}};\n                        tx_data_valid <= 1'b0;\n                    end\n                end\n\n                S_START: begin\n                    spi_ssel_o <= 1'b0;  // Select slave\n                    spi_sck_o  <= 1'b0;\n                    state      <= S_SHIFT;\n                end\n\n                S_SHIFT: begin\n                    if (clk_phase) begin\n                        // On rising edge: shift out MSB, shift in MISO\n                        spi_sck_o  <= 1'b1;\n                        tx_shift   <= {tx_shift[N-2:0], 1'b0};\n                        rx_shift   <= {spi_miso_i, rx_shift[N-1:1]};\n                        bit_count  <= bit_count + 1'b1;\n\n                        if (bit_count == N - 1) begin\n                            state <= S_FINISH;\n                        end\n                    end else begin\n                        // On falling edge: prepare next bit\n                        spi_sck_o <= 1'b0;\n                        tx_shift  <= {tx_shift[N-2:0], 1'b0};\n                    end\n                end\n\n                S_FINISH: begin\n                    spi_ssel_o <= 1'b1;  // Deselect slave\n                    spi_sck_o  <= 1'b0;\n                    rx_data       <= rx_shift;\n                    rx_data_valid <= 1'b1;\n                    state         <= S_IDLE;\n                end\n\n                default: state <= S_IDLE;\n            endcase\n        end\n    end\n\n    // MOSI output (MSB of shift register)\n    assign spi_mosi_o = tx_shift[N-1];\n\n    // =========================================================================\n    // Parallel Interface (pclk domain)\n    // =========================================================================\n\n    // Handshake signals\n    reg         di_req_int;\n    reg         wr_ack_int;\n    reg         do_valid_int;\n    reg [N-1:0] do_int;\n\n    // Data transfer to SPI (pclk -> sclk)\n    reg         tx_req;\n    reg [N-1:0] tx_data_pclk;\n\n    // Data from SPI (sclk -> pclk)\n    reg         rx_valid_pclk;\n    reg [N-1:0] rx_data_pclk;\n\n    // =========================================================================\n    // CDC: pclk -> sclk (Data transfer request)\n    // =========================================================================\n\n    // Use a simple handshake protocol for CDC\n    reg         tx_req_sync;\n    reg [N-1:0] tx_data_sync;\n\n    // In pclk domain: send data\n    always @(posedge pclk_i or posedge rst_pclk) begin\n        if (rst_pclk) begin\n            tx_req       <= 1'b0;\n            tx_data_pclk <= {N{1'b0}};\n            di_req_int   <= 1'b0;\n            wr_ack_int   <= 1'b0;\n            do_valid_int <= 1'b0;\n            do_int       <= {N{1'b0}};\n        end else begin\n            // Request data when SPI is ready\n            if (tx_req_sync == 1'b0 && tx_data_valid == 1'b0) begin\n                di_req_int <= 1'b1;\n            end else begin\n                di_req_int <= 1'b0;\n            end\n\n            // Accept data when requested\n            if (di_req_int && wren_i) begin\n                tx_req       <= 1'b1;\n                tx_data_pclk <= di_i;\n                wr_ack_int   <= 1'b1;\n            end else begin\n                wr_ack_int <= 1'b0;\n            end\n\n            // Present received data\n            if (rx_valid_pclk) begin\n                do_valid_int <= 1'b1;\n                do_int       <= rx_data_pclk;\n            end else begin\n                do_valid_int <= 1'b0;\n            end\n        end\n    end\n\n    // In sclk domain: receive data\n    always @(posedge sclk_i or posedge rst_sclk) begin\n        if (rst_sclk) begin\n            tx_req_sync  <= 1'b0;\n            tx_data_sync <= {N{1'b0}};\n        end else begin\n            if (tx_req && tx_req_sync == 1'b0) begin\n                tx_req_sync  <= 1'b1;\n                tx_data_sync <= tx_data_pclk;\n                tx_data      <= tx_data_pclk;\n                tx_data_valid <= 1'b1;\n            end else if (tx_data_valid == 1'b0) begin\n                tx_req_sync <= 1'b0;\n            end\n        end\n    end\n\n    // =========================================================================\n    // CDC: sclk -> pclk (Data received)\n    // =========================================================================\n\n    // Use a simple handshake protocol for CDC\n    reg         rx_valid_sync;\n    reg [N-1:0] rx_data_sync;\n\n    // In sclk domain: send data\n    always @(posedge sclk_i or posedge rst_sclk) begin\n        if (rst_sclk) begin\n            rx_valid_sync <= 1'b0;\n            rx_data_sync  <= {N{1'b0}};\n        end else begin\n            if (rx_data_valid && rx_valid_sync == 1'b0) begin\n                rx_valid_sync <= 1'b1;\n                rx_data_sync  <= rx_data;\n                rx_data_valid <= 1'b0;\n            end else if (rx_valid_pclk == 1'b0) begin\n                rx_valid_sync <= 1'b0;\n            end\n        end\n    end\n\n    // In pclk domain: receive data\n    always @(posedge pclk_i or posedge rst_pclk) begin\n        if (rst_pclk) begin\n            rx_valid_pclk <= 1'b0;\n            rx_data_pclk  <= {N{1'b0}};\n        end else begin\n            if (rx_valid_sync && rx_valid_pclk == 1'b0) begin\n                rx_valid_pclk <= 1'b1;\n                rx_data_pclk  <= rx_data_sync;\n            end else if (do_valid_int == 1'b0) begin\n                rx_valid_pclk <= 1'b0;\n            end\n        end\n    end\n\n    // =========================================================================\n    // Output assignments\n    // =========================================================================\n\n    assign di_req_o   = di_req_int;\n    assign wr_ack_o   = wr_ack_int;\n    assign do_valid_o = do_valid_int;\n    assign do_o       = do_int;\n\nendmodule<|im_end|>",
