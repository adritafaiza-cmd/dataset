  "text": "// =============================================================================\n// axis_async_fifo\n// =============================================================================\n//\n// Asynchronous AXI-Stream FIFO with frame-based flow control, pause, and\n// status reporting.\n//\n// =============================================================================\n\n`include \"axis_async_fifo.vh\"\n\nmodule axis_async_fifo #\n(\n    parameter DEPTH = 4096,\n    parameter DATA_WIDTH = 8,\n    parameter KEEP_ENABLE = (DATA_WIDTH>8),\n    parameter KEEP_WIDTH = ((DATA_WIDTH+7)/8),\n    parameter LAST_ENABLE = 1,\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                   s_clk,\n    input  wire                   s_rst,\n    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                   s_axis_tvalid,\n    output wire                   s_axis_tready,\n    input  wire                   s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]    s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]  s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]  s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                   m_clk,\n    input  wire                   m_rst,\n    output wire [DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                   m_axis_tvalid,\n    input  wire                   m_axis_tready,\n    output wire                   m_axis_tlast,\n    output wire [ID_WIDTH-1:0]    m_axis_tid,\n    output wire [DEST_WIDTH-1:0]  m_axis_tdest,\n    output wire [USER_WIDTH-1:0]  m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                   s_pause_req,\n    output wire                   s_pause_ack,\n    input  wire                   m_pause_req,\n    output wire                   m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0] s_status_depth,\n    output wire [$clog2(DEPTH):0] s_status_depth_commit,\n    output wire                   s_status_overflow,\n    output wire                   s_status_bad_frame,\n    output wire                   s_status_good_frame,\n    output wire [$clog2(DEPTH):0] m_status_depth,\n    output wire [$clog2(DEPTH):0] m_status_depth_commit,\n    output wire                   m_status_overflow,\n    output wire                   m_status_bad_frame,\n    output wire                   m_status_good_frame\n);\n\n    localparam integer DEPTH_LOG2 = $clog2(DEPTH);\n    localparam integer DEPTH_MASK = DEPTH-1;\n\n    localparam integer DATA_FIFO_DEPTH = DEPTH;\n    localparam integer DATA_FIFO_DEPTH_LOG2 = $clog2(DATA_FIFO_DEPTH);\n    localparam integer DATA_FIFO_DEPTH_MASK = DATA_FIFO_DEPTH-1;\n\n    localparam integer OUTPUT_FIFO_DEPTH = OUTPUT_FIFO_ENABLE ? 2 : 1;\n    localparam integer OUTPUT_FIFO_DEPTH_LOG2 = $clog2(OUTPUT_FIFO_DEPTH);\n    localparam integer OUTPUT_FIFO_DEPTH_MASK = OUTPUT_FIFO_DEPTH-1;\n\n    localparam integer FRAME_FIFO_DEPTH = FRAME_FIFO ? 2 : 1;\n    localparam integer FRAME_FIFO_DEPTH_LOG2 = $clog2(FRAME_FIFO_DEPTH);\n    localparam integer FRAME_FIFO_DEPTH_MASK = FRAME_FIFO_DEPTH-1;\n\n    localparam integer FRAME_FIFO_DEPTH_LOG2_PLUS_1 = FRAME_FIFO_DEPTH_LOG2+1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1 = FRAME_FIFO_DEPTH+1;\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MASK = FRAME_FIFO_DEPTH_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1 = FRAME_FIFO_DEPTH_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1_MINUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_MASK = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1 = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1+1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MASK = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1 = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_MASK = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1 = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1+1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MASK = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1 = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_MASK = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1 = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1+1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MASK = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1 = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_MASK = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1 = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1+1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MASK = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1 = FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1-1;\n\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_LOG2 = $clog2(FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1);\n    localparam integer FRAME_FIFO_DEPTH_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_PLUS_1_MINUS_1_MASK<|im_end|>",
