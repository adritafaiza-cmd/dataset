  "text": "// SPDX-License-Identifier: MIT\n// Copyright (c) 2025, The Regents of the University of California,\n// through Lawrence Berkeley National Laboratory (subject to receipt of any\n// required government license).\n\n// Four-phase valid/ready channel that transfers WIDTH-bit data between\n// asynchronous clocks.\n//\n// The source and destination handshakes are fully decoupled: the source may\n// accept a new item before the previous destination handshake has returned.\n//\n// When SEND_RESET_MSG is set, the module emits RESET_MSG after reset instead\n// of staying idle.\n\n`include \"cdc_assertions.svh\"\n\nmodule cdc_4phase #(\n  parameter WIDTH = 1,\n  parameter DECOUPLED = 1,\n  parameter SEND_RESET_MSG = 0,\n  parameter [WIDTH-1:0] RESET_MSG = {WIDTH{1'b0}}\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // ---------------------------------------------------------------------------\n  // Source domain\n  // ---------------------------------------------------------------------------\n\n  // Four-phase handshake state.\n  //\n  //   0: idle, waiting for src_valid_i\n  //   1: data latched, waiting for ack\n  //   2: ack received, waiting for src_valid_i to deassert\n  //   3: src_valid_i deasserted, waiting for req to deassert\n  //\n  // In DECOUPLED mode, the source may accept a new item in state 2 before the\n  // previous destination handshake has fully returned.\n\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE\" *)\n  (* ASYNC_REG = \"TRUE