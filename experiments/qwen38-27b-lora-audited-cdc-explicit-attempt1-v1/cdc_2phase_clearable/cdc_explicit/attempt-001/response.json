  "text": "// =============================================================================\n// cdc_2phase_clearable\n// =============================================================================\n// A clearable two-phase valid/ready channel between asynchronous clocks.\n//\n// Architecture:\n//   - Two-phase handshake (req/ack) with a single outstanding item.\n//   - Multi-bit data is held in a source-domain register and sampled by the\n//     destination only when the synchronized request is observed to rise.\n//     This guarantees coherent data transfer without a Gray-coded FIFO.\n//   - Clear is coordinated: both sides must acknowledge before the channel\n//     returns to idle.  In-flight data is dropped.\n//   - Reset and clear must not create a destination beat.\n// =============================================================================\n\n`default_nettype none\n\nmodule cdc_2phase_clearable #(\n  parameter WIDTH = 1,\n  parameter SYNC_STAGES = 3,\n  parameter CLEAR_ON_ASYNC_RESET = 1\n)(\n  input  src_rst_ni,\n  input  src_clk_i,\n  input  src_clear_i,\n  output src_clear_pending_o,\n  input  [WIDTH-1:0] src_data_i,\n  input  src_valid_i,\n  output src_ready_o,\n\n  input  dst_rst_ni,\n  input  dst_clk_i,\n  input  dst_clear_i,\n  output dst_clear_pending_o,\n  output [WIDTH-1:0] dst_data_o,\n  output dst_valid_o,\n  input  dst_ready_i\n);\n\n  // ===========================================================================\n  // Source domain\n  // ===========================================================================\n\n  // Handshake state\n  reg req;\n  reg ack_s;\n\n  // Data register (held stable while req is high)\n  reg [WIDTH-1:0] data_s;\n\n  // Clear coordination\n  reg clear_pending_s;\n  reg clear_ack_s;\n\n  // Synchronized destination signals\n  wire ack_d;\n  wire clear_ack_d;\n\n  // ===========================================================================\n  // Destination domain\n  // ===========================================================================\n\n  // Handshake state\n  reg ack_d;\n  reg req_s;\n\n  // Data register (sampled on req rising edge)\n  reg [WIDTH-1:0] data_d;\n\n  // Clear coordination\n  reg clear_pending_d;\n  reg clear_ack_d;\n\n  // Synchronized source signals\n  wire req_s_sync;\n  wire clear_ack_s;\n\n  // ===========================================================================\n  // Source domain logic\n  // ===========================================================================\n\n  // Synchronize destination ack and clear_ack into source domain\n  (* ASYNC_REG = \"TRUE\" *)\n  reg [SYNC_STAGES-1:0] ack_d_sync;\n  (* ASYNC_REG = \"TRUE\" *)\n  reg [SYNC_STAGES-1:0] clear_ack_d_sync;\n\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      ack_d_sync <= {SYNC_STAGES{1'b0}};\n      clear_ack_d_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      ack_d_sync <= {ack_d_sync[SYNC_STAGES-2:0], ack_d};\n      clear_ack_d_sync <= {clear_ack_d_sync[SYNC_STAGES-2:0], clear_ack_d};\n    end\n  end\n\n  assign ack_d = ack_d_sync[SYNC_STAGES-1];\n  assign clear_ack_d = clear_ack_d_sync[SYNC_STAGES-1];\n\n  // Source ready: channel is idle (no outstanding item) and not in clear\n  assign src_ready_o = !req && !clear_pending_s;\n\n  // Source clear pending: high until both sides have acknowledged the clear\n  assign src_clear_pending_o = clear_pending_s;\n\n  // Source domain state machine\n  always @(posedge src_clk_i or negedge src_rst_ni) begin\n    if (!src_rst_ni) begin\n      req <= 1'b0;\n      ack_s <= 1'b0;\n      data_s <= {WIDTH{1'b0}};\n      clear_pending_s <= 1'b0;\n      clear_ack_s <= 1'b0;\n    end else begin\n      // Handle clear request\n      if (src_clear_i && !clear_pending_s) begin\n        clear_pending_s <= 1'b1;\n        clear_ack_s <= 1'b0;\n        req <= 1'b0;\n        ack_s <= 1'b0;\n      end else if (clear_pending_s) begin\n        // Wait for destination to acknowledge the clear\n        if (clear_ack_d) begin\n          clear_pending_s <= 1'b0;\n          clear_ack_s <= 1'b0;\n        end else if (clear_ack_s) begin\n          clear_ack_s <= 1'b0;\n        end\n      end else begin\n        // Normal operation\n        if (!req && src_valid_i) begin\n          req <= 1'b1;\n          data_s <= src_data_i;\n        end else if (req && ack_d) begin\n          req <= 1'b0;\n          ack_s <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // ===========================================================================\n  // Destination domain logic\n  // ===========================================================================\n\n  // Synchronize source req and clear_ack into destination domain\n  (* ASYNC_REG = \"TRUE\" *)\n  reg [SYNC_STAGES-1:0] req_s_sync;\n  (* ASYNC_REG = \"TRUE\" *)\n  reg [SYNC_STAGES-1:0] clear_ack_s_sync;\n\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      req_s_sync <= {SYNC_STAGES{1'b0}};\n      clear_ack_s_sync <= {SYNC_STAGES{1'b0}};\n    end else begin\n      req_s_sync <= {req_s_sync[SYNC_STAGES-2:0], req};\n      clear_ack_s_sync <= {clear_ack_s_sync[SYNC_STAGES-2:0], clear_ack_s};\n    end\n  end\n\n  assign req_s = req_s_sync[SYNC_STAGES-1];\n  assign clear_ack_s = clear_ack_s_sync[SYNC_STAGES-1];\n\n  // Destination valid: data is available and not in clear\n  assign dst_valid_o = req_s && !clear_pending_d;\n\n  // Destination data\n  assign dst_data_o = data_d;\n\n  // Destination clear pending: high until both sides have acknowledged the clear\n  assign dst_clear_pending_o = clear_pending_d;\n\n  // Destination domain state machine\n  always @(posedge dst_clk_i or negedge dst_rst_ni) begin\n    if (!dst_rst_ni) begin\n      ack_d <= 1'b0;\n      req_s <= 1'b0;\n      data_d <= {WIDTH{1'b0}};\n      clear_pending_d <= 1'b0;\n      clear_ack_d <= 1'b0;\n    end else begin\n      // Handle clear request\n      if (dst_clear_i && !clear_pending_d) begin\n        clear_pending_d <= 1'b1;\n        clear_ack_d <= 1'b0;\n        ack_d <= 1'b0;\n        req_s <= 1'b0;\n      end else if (clear_pending_d) begin\n        // Wait for source to acknowledge the clear\n        if (clear_ack_s) begin\n          clear_pending_d <= 1'b0;\n          clear_ack_d <= 1'b0;\n        end else if (clear_ack_d) begin\n          clear_ack_d <= 1'b0;\n        end\n      end else begin\n        // Normal operation\n        if (!req_s && req_s_sync[SYNC_STAGES-2]) begin\n          // Detect rising edge of req to sample data\n          req_s <= 1'b1;\n          data_d <= data_s;\n          ack_d <= 1'b1;\n        end else if (req_s && dst_ready_i) begin\n          req_s <= 1'b0;\n          ack_d <= 1'b0;\n        end\n      end\n    end\n  end\n\nendmodule\n\n`default_nettype wire<|im_end|>",
