  "text": "// =============================================================================\n// Async FIFO (Gray-coded CDC, dual-port RAM)\n// =============================================================================\n//\n// Architecture:\n//   * Dual-port RAM: one write port (wclk), one read port (rclk).\n//   * Binary write/read pointers with Gray-coded copies for CDC.\n//   * Each pointer is synchronized into the opposite domain with a\n//     SYNC_STAGES-deep shift register.\n//   * Full/empty flags are computed in their own domain by comparing the\n//     local binary pointer with the synchronized remote Gray pointer.\n//\n// CDC safety:\n//   * Only Gray-coded pointers cross domains (single-bit change per step).\n//   * Multi-bit data is never sampled across domains; it is read from RAM\n//     in the read domain using the read-domain pointer.\n//   * Reset release is safe: each domain's pointer and sync registers are\n//     reset to zero in their own clock domain.\n// =============================================================================\n\nmodule async_fifo #(\n    parameter DATA_WIDTH  = 8,\n    parameter ADDR_WIDTH  = 4,\n    parameter SYNC_STAGES = 2\n)(\n    input  wire                    wclk,\n    input  wire                    wrst_n,\n    input  wire                    winc,\n    input  wire [DATA_WIDTH-1:0]   wdata,\n\n    output wire                    wfull,\n    output wire [ADDR_WIDTH:0]     waddr,\n\n    input  wire                    rclk,\n    input  wire                    rrst_n,\n    input  wire                    rinc,\n\n    output wire [DATA_WIDTH-1:0]   rdata,\n    output wire                    rempty,\n    output wire [ADDR_WIDTH:0]     raddr\n);\n\n    localparam DEPTH = 1 << ADDR_WIDTH;\n\n    // ------------------------------------------------------------------\n    // Write-domain state\n    // ------------------------------------------------------------------\n    reg [ADDR_WIDTH:0] wptr_bin;\n    reg [ADDR_WIDTH:0] wptr_gray;\n\n    wire winc_eff = winc & ~wfull;\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            wptr_bin  <= {(ADDR_WIDTH+1){1'b0}};\n            wptr_gray <= {(ADDR_WIDTH+1){1'b0}};\n        end else if (winc_eff) begin\n            wptr_bin  <= wptr_bin + 1'b1;\n            wptr_gray <= (wptr_bin + 1'b1) ^ wptr_bin;\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Read-domain state\n    // ------------------------------------------------------------------\n    reg [ADDR_WIDTH:0] rptr_bin;\n    reg [ADDR_WIDTH:0] rptr_gray;\n\n    wire rinc_eff = rinc & ~rempty;\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            rptr_bin  <= {(ADDR_WIDTH+1){1'b0}};\n            rptr_gray <= {(ADDR_WIDTH+1){1'b0}};\n        end else if (rinc_eff) begin\n            rptr_bin  <= rptr_bin + 1'b1;\n            rptr_gray <= (rptr_bin + 1'b1) ^ rptr_bin;\n        end\n    end\n\n    // ------------------------------------------------------------------\n    // Synchronize write pointer into read domain\n    // ------------------------------------------------------------------\n    reg [ADDR_WIDTH:0] wptr_gray_r [0:SYNC_STAGES-1];\n\n    always @(posedge rclk or negedge rrst_n) begin\n        if (!rrst_n) begin\n            for (integer i = 0; i < SYNC_STAGES; i = i + 1)\n                wptr_gray_r[i] <= {(ADDR_WIDTH+1){1'b0}};\n        end else begin\n            wptr_gray_r[0] <= wptr_gray;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1)\n                wptr_gray_r[i] <= wptr_gray_r[i-1];\n        end\n    end\n\n    wire [ADDR_WIDTH:0] wptr_gray_r_sync = wptr_gray_r[SYNC_STAGES-1];\n    wire [ADDR_WIDTH:0] wptr_bin_r_sync  = gray_to_bin(wptr_gray_r_sync);\n\n    // ------------------------------------------------------------------\n    // Synchronize read pointer into write domain\n    // ------------------------------------------------------------------\n    reg [ADDR_WIDTH:0] rptr_gray_w [0:SYNC_STAGES-1];\n\n    always @(posedge wclk or negedge wrst_n) begin\n        if (!wrst_n) begin\n            for (integer i = 0; i < SYNC_STAGES; i = i + 1)\n                rptr_gray_w[i] <= {(ADDR_WIDTH+1){1'b0}};\n        end else begin\n            rptr_gray_w[0] <= rptr_gray;\n            for (integer i = 1; i < SYNC_STAGES; i = i + 1)\n                rptr_gray_w[i] <= rptr_gray_w[i-1];\n        end\n    end\n\n    wire [ADDR_WIDTH:0] rptr_gray_w_sync = rptr_gray_w[SYNC_STAGES-1];\n    wire [ADDR_WIDTH:0] rptr_bin_w_sync  = gray_to_bin(rptr_gray_w_sync);\n\n    // ------------------------------------------------------------------\n    // Full / Empty flags\n    // ------------------------------------------------------------------\n    // Full: write pointer has lapped the read pointer by exactly DEPTH.\n    //   In Gray code this means the top two bits differ and the rest match.\n    assign wfull = (wptr_gray == {~rptr_gray_w_sync[ADDR_WIDTH:ADDR_WIDTH-1],\n                                   rptr_gray_w_sync[ADDR_WIDTH-2:0]});\n\n    // Empty: read pointer equals write pointer.\n    assign rempty = (rptr_gray == wptr_gray_r_sync);\n\n    // ------------------------------------------------------------------\n    // RAM\n    // ------------------------------------------------------------------\n    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n\n    always @(posedge wclk) begin\n        if (winc_eff)\n            mem[wptr_bin[ADDR_WIDTH-1:0]] <= wdata;\n    end\n\n    always @(posedge rclk) begin\n        if (rinc_eff)\n            rdata <= mem[rptr_bin[ADDR_WIDTH-1:0]];\n    end\n\n    // ------------------------------------------------------------------\n    // Debug pointer outputs\n    // ------------------------------------------------------------------\n    assign waddr = wptr_bin;\n    assign raddr = rptr_bin;\n\n    // ------------------------------------------------------------------\n    // Gray-to-binary converter\n    // ------------------------------------------------------------------\n    function [ADDR_WIDTH:0] gray_to_bin;\n        input [ADDR_WIDTH:0] gray;\n        integer i;\n        begin\n            gray_to_bin[ADDR_WIDTH] = gray[ADDR_WIDTH];\n            for (i = ADDR_WIDTH-1; i >= 0; i = i - 1)\n                gray_to_bin[i] = gray_to_bin[i+1] ^ gray[i];\n        end\n    endfunction\n\nendmodule<|im_end|>",
