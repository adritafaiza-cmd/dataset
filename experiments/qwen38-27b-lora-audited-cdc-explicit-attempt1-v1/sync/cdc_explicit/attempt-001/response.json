  "text": "// SPDX-License-Identifier: MIT\n// Copyright (C) 2018-2025 lowRISC contributors.\n\n// Single-bit destination-clock synchronizer.\nmodule sync #(\n    parameter int unsigned STAGES = 2,\n    parameter bit ResetValue = 1'b0\n) (\n    input  logic clk_i,\n    input  logic rst_ni,\n\n    input  logic serial_i,\n\n    output logic serial_o\n);\n\n    (* ASYNC_REG = \"TRUE\" *) logic [STAGES-1:0] sync_ff;\n\n    always_ff @(posedge clk_i, negedge rst_ni) begin\n        if (!rst_ni) begin\n            sync_ff <= {STAGES{ResetValue}};\n        end else begin\n            sync_ff <= {sync_ff[STAGES-2:0], serial_i};\n        end\n    end\n\n    assign serial_o = sync_ff[STAGES-1];\n\nendmodule<|im_end|>",
