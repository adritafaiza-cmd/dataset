  "text": "// SPDX-License-Identifier: MIT\n// Copyright (C) 2018-2025 lowRISC contributors.\n\n// =============================================================================\n//\n// Reset Generator\n//\n// =============================================================================\n\n`include \"prim_assert.svh\"\n\nmodule rstgen (\n    input  logic clk_i,\n\n    input  logic rst_ni,\n    input  logic test_mode_i,\n\n    output logic rst_no,\n    output logic init_no\n);\n\n  logic rst_ni_q0, rst_ni_q1, rst_ni_q2;\n\n  // Synchronize reset\n  always_ff @(posedge clk_i) begin\n    rst_ni_q0 <= rst_ni;\n    rst_ni_q1 <= rst_ni_q0;\n    rst_ni_q2 <= rst_ni_q1;\n  end\n\n  assign rst_no = test_mode_i ? rst_ni : rst_ni_q2;\n\n  // init_no is high for 2 cycles after reset release\n  always_ff @(posedge clk_i) begin\n    if (!rst_no) begin\n      init_no <= 1'b0;\n    end else begin\n      init_no <= rst_ni_q1;\n    end\n  end\n\nendmodule<|im_end|>",
