  "text": "// =============================================================================\n// axis_async_fifo_adapter\n// =============================================================================\n//\n// An asynchronous AXI-Stream FIFO with a width adapter.\n//\n// =============================================================================\n\n`include \"axis_async_fifo_adapter.vh\"\n\nmodule axis_async_fifo_adapter #\n(\n    parameter DEPTH = 4096,\n    parameter S_DATA_WIDTH = 8,\n    parameter S_KEEP_ENABLE = (S_DATA_WIDTH>8),\n    parameter S_KEEP_WIDTH = ((S_DATA_WIDTH+7)/8),\n    parameter M_DATA_WIDTH = 8,\n    parameter M_KEEP_ENABLE = (M_DATA_WIDTH>8),\n    parameter M_KEEP_WIDTH = ((M_DATA_WIDTH+7)/8),\n    parameter ID_ENABLE = 0,\n    parameter ID_WIDTH = 8,\n    parameter DEST_ENABLE = 0,\n    parameter DEST_WIDTH = 8,\n    parameter USER_ENABLE = 1,\n    parameter USER_WIDTH = 1,\n    parameter RAM_PIPELINE = 1,\n    parameter OUTPUT_FIFO_ENABLE = 0,\n    parameter FRAME_FIFO = 0,\n    parameter USER_BAD_FRAME_VALUE = 1'b1,\n    parameter USER_BAD_FRAME_MASK = 1'b1,\n    parameter DROP_OVERSIZE_FRAME = FRAME_FIFO,\n    parameter DROP_BAD_FRAME = 0,\n    parameter DROP_WHEN_FULL = 0,\n    parameter MARK_WHEN_FULL = 0,\n    parameter PAUSE_ENABLE = 0,\n    parameter FRAME_PAUSE = FRAME_FIFO\n)\n(\n    /*\n     * AXI input\n     */\n    input  wire                     s_clk,\n    input  wire                     s_rst,\n    input  wire [S_DATA_WIDTH-1:0]  s_axis_tdata,\n    input  wire [S_KEEP_WIDTH-1:0]  s_axis_tkeep,\n    input  wire                     s_axis_tvalid,\n    output wire                     s_axis_tready,\n    input  wire                     s_axis_tlast,\n    input  wire [ID_WIDTH-1:0]      s_axis_tid,\n    input  wire [DEST_WIDTH-1:0]    s_axis_tdest,\n    input  wire [USER_WIDTH-1:0]    s_axis_tuser,\n    /*\n     * AXI output\n     */\n    input  wire                     m_clk,\n    input  wire                     m_rst,\n    output wire [M_DATA_WIDTH-1:0]  m_axis_tdata,\n    output wire [M_KEEP_WIDTH-1:0]  m_axis_tkeep,\n    output wire                     m_axis_tvalid,\n    input  wire                     m_axis_tready,\n    output wire                     m_axis_tlast,\n    output wire [ID_WIDTH-1:0]      m_axis_tid,\n    output wire [DEST_WIDTH-1:0]    m_axis_tdest,\n    output wire [USER_WIDTH-1:0]    m_axis_tuser,\n    /*\n     * Pause\n     */\n    input  wire                     s_pause_req,\n    output wire                     s_pause_ack,\n    input  wire                     m_pause_req,\n    output wire                     m_pause_ack,\n    /*\n     * Status\n     */\n    output wire [$clog2(DEPTH):0]   s_status_depth,\n    output wire [$clog2(DEPTH):0]   s_status_depth_commit,\n    output wire                     s_status_overflow,\n    output wire                     s_status_bad_frame,\n    output wire                     s_status_good_frame,\n    output wire [$clog2(DEPTH):0]   m_status_depth,\n    output wire [$clog2(DEPTH):0]   m_status_depth_commit,\n    output wire                     m_status_overflow,\n    output wire                     m_status_bad_frame,\n    output wire                     m_status_good_frame\n);\n\n    localparam S_DATA_BYTES = (S_DATA_WIDTH+7)/8;\n    localparam M_DATA_BYTES = (M_DATA_WIDTH+7)/8;\n\n    localparam S_KEEP_WIDTH_ = (S_KEEP_ENABLE ? S_KEEP_WIDTH : 1);\n    localparam M_KEEP_WIDTH_ = (M_KEEP_ENABLE ? M_KEEP_WIDTH : 1);\n\n    localparam ID_WIDTH_ = (ID_ENABLE ? ID_WIDTH : 1);\n    localparam DEST_WIDTH_ = (DEST_ENABLE ? DEST_WIDTH : 1);\n    localparam USER_WIDTH_ = (USER_ENABLE ? USER_WIDTH : 1);\n\n    localparam S_DATA_WIDTH_ = (S_DATA_WIDTH>0 ? S_DATA_WIDTH : 1);\n    localparam M_DATA_WIDTH_ = (M_DATA_WIDTH>0 ? M_DATA_WIDTH : 1);\n\n    localparam S_DATA_BYTES_ = (S_DATA_WIDTH_>0 ? (S_DATA_WIDTH_+7)/8 : 1);\n    localparam M_DATA_BYTES_ = (M_DATA_WIDTH_>0 ? (M_DATA_WIDTH_+7)/8 : 1);\n\n    localparam S_DATA_BYTES_MASK = (S_DATA_BYTES_==1 ? 1'b0 : (S_DATA_BYTES_-1));\n    localparam M_DATA_BYTES_MASK = (M_DATA_BYTES_==1 ? 1'b0 : (M_DATA_BYTES_-1));\n\n    localparam S_DATA_BYTES_LOG2 = $clog2(S_DATA_BYTES_);\n    localparam M_DATA_BYTES_LOG2 = $clog2(M_DATA_BYTES_);\n\n    localparam S_DATA_BYTES_LOG2_ = (S_DATA_BYTES_LOG2>0 ? S_DATA_BYTES_LOG2 : 1);\n    localparam M_DATA_BYTES_LOG2_ = (M_DATA_BYTES_LOG2>0 ? M_DATA_BYTES_LOG2 : 1);\n\n    localparam S_DATA_BYTES_MASK_ = (S_DATA_BYTES_LOG2_>0 ? (2**S_DATA_BYTES_LOG2_)-1 : 1'b0);\n    localparam M_DATA_BYTES_MASK_ = (M_DATA_BYTES_LOG2_>0 ? (2**M_DATA_BYTES_LOG2_)-1 : 1'b0);\n\n    localparam S_DATA_BYTES_MASK__ = (S_DATA_BYTES_MASK_>0 ? S_DATA_BYTES_MASK_ : 1'b0);\n    localparam M_DATA_BYTES_MASK__ = (M_DATA_BYTES_MASK_>0 ? M_DATA_BYTES_MASK_ : 1'b0);\n\n    localparam S_DATA_BYTES_MASK___ = (S_DATA_BYTES_MASK__>0 ? S_DATA_BYTES_MASK__ : 1'b0);\n    localparam M_DATA_BYTES_MASK___ = (M_DATA_BYTES_MASK__>0 ? M_DATA_BYTES_MASK__ : 1'b0);\n\n    localparam S_DATA_BYTES_MASK____ = (S_DATA_BYTES_MASK___>0 ? S_DATA_BYTES_MASK___ : 1'b0);\n    localparam M_DATA_BYTES_MASK____ = (M_DATA_BYTES_MASK___>0 ? M_DATA_BYTES_MASK___ : 1'b0);\n\n    localparam S_DATA_BYTES_MASK_____ = (S_DATA_BYTES_MASK____>0 ? S_DATA_BYTES_MASK____ : 1'b0);\n    localparam M_DATA_BYTES_MASK_____ = (M_DATA_BYTES_MASK____>0 ? M_DATA_BYTES_MASK____ : 1'b0);\n\n    localparam S_DATA_BYTES_MASK______ = (S_DATA_BYTES_MASK_____>0 ? S_DATA_BYTES_MASK_____ : 1'b0);\n    localparam M_DATA_BYTES_MASK______ = (M_DATA_BYTES_MASK_____>0 ? M_DATA_BYTES_MASK_____ : 1'b0);\n\n    localparam S_DATA_BYTES_MASK_______ = (S_DATA_BYTES_MASK______>0 ? S_DATA_BYTES_MASK______ : 1'b0);\n    localparam M_DATA_BYTES_MASK_______ = (M_DATA_BYTES_MASK______>0 ? M_DATA_BYTES_MASK______ : 1'b0);\n\n    localparam S_DATA_BYTES_MASK________ = (S_DATA_BYTES_MASK_______><|im_end|>",
